package pages

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Contributors(data view.ContributorsData) {
	@layout.Base(data.BasePage, "Contributors · "+data.Repo.OwnerName+"/"+data.Repo.Name) {
		<div class="space-y-6">

			<section aria-labelledby="contrib-title">
				<h1 id="contrib-title" class="text-2xl font-semibold tracking-tight">Contributors</h1>
				<p class="mt-1 text-[13px] text-muted-foreground max-w-2xl">Aggregated by author across all branches, sorted by total commits.</p>
			</section>

			if len(data.Rows) > 0 {
				<section class="rounded-md border border-border bg-card overflow-hidden" aria-labelledby="contrib-table">
					<h2 id="contrib-table" class="sr-only">All contributors</h2>
					@components.Table(nil) {
						@components.TableHeader() {
							@components.TableRow(false) {
								@components.TableHead(templ.Attributes{"scope": "col"}) {
									Contributor
								}
								@components.TableHead(templ.Attributes{"scope": "col", "class": "text-right"}) {
									Commits
								}
								@components.TableHead(templ.Attributes{"scope": "col", "class": "text-right hidden sm:table-cell"}) {
									+ / –
								}
								@components.TableHead(templ.Attributes{"scope": "col", "class": "hidden md:table-cell"}) {
									<span class="sr-only">Activity</span>
								}
							}
						}
						@components.TableBody() {
							for _, row := range data.Rows {
								@components.TableRow(true) {
									@components.TableRowHead(nil) {
										<div class="flex items-center gap-2">
											@components.Avatar(row.Username, components.AvatarSizeSM, row.Username)
											<span class="text-[13px] font-medium">{ row.Username }</span>
										</div>
									}
									@components.TableCell(templ.Attributes{"class": "text-right font-semibold font-mono"}) {
										{ strconv.Itoa(row.Commits) }
									}
									@components.TableCell(templ.Attributes{"class": "text-right hidden sm:table-cell font-mono text-[12px]"}) {
										<span class="text-success">+{ strconv.Itoa(row.Additions) }</span>
										<span class="text-destructive">−{ strconv.Itoa(row.Deletions) }</span>
									}
									@components.TableCell(templ.Attributes{"class": "hidden md:table-cell text-muted-foreground"}) {
										@components.Sparkline(row.Timeline, 80, 24)
									}
								}
							}
						}
					}
				</section>
			} else {
				@components.EmptyState("No commits yet.")
			}
		</div>
	}
}
