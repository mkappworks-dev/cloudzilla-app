package pages

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Contributors(data view.ContributorsData) {
	@layout.Base(data.BasePage, "Contributors · "+data.Owner+"/"+data.RepoName) {
		<div class="space-y-6">
			<div class="flex items-center gap-2 text-sm text-muted-foreground">
				<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="text-foreground hover:underline font-medium">{ data.Owner }/{ data.RepoName }</a>
				<span aria-hidden="true">/</span>
				<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/pulse") } class="text-foreground hover:underline">Pulse</a>
				<span aria-hidden="true">/</span>
				<span class="font-medium text-foreground">Contributors</span>
			</div>
			<h1 class="text-2xl font-bold">Contributors</h1>
			if len(data.Contributors) > 0 {
				<div class="rounded-md border border-border bg-card overflow-hidden">
					<table class="w-full text-sm">
						<thead class="bg-muted/40 border-b border-border">
							<tr>
								<th scope="col" class="text-left px-4 py-2 font-medium text-muted-foreground">Contributor</th>
								<th scope="col" class="text-left px-4 py-2 font-medium text-muted-foreground hidden sm:table-cell">Email</th>
								<th scope="col" class="text-right px-4 py-2 font-medium text-muted-foreground">Commits</th>
								<th scope="col" class="text-right px-4 py-2 font-medium text-muted-foreground hidden sm:table-cell">Additions</th>
								<th scope="col" class="text-right px-4 py-2 font-medium text-muted-foreground hidden sm:table-cell">Deletions</th>
								<th scope="col" class="px-4 py-2 w-48 hidden md:table-cell"><span class="sr-only">Activity bar</span></th>
							</tr>
						</thead>
						<tbody class="divide-y divide-border">
							for _, c := range data.Contributors {
								<tr class="hover:bg-muted/50">
									<td class="px-4 py-2 font-medium text-foreground">
										<div class="flex items-center gap-2">
											@components.Avatar(c.Name, components.AvatarSizeSM, c.Name)
											<span>{ c.Name }</span>
										</div>
									</td>
									<td class="px-4 py-2 text-muted-foreground hidden sm:table-cell text-xs">{ c.Email }</td>
									<td class="px-4 py-2 text-right font-semibold text-foreground">{ strconv.Itoa(c.Commits) }</td>
									<td class="px-4 py-2 text-right text-success hidden sm:table-cell">+{ strconv.Itoa(c.Additions) }</td>
									<td class="px-4 py-2 text-right text-destructive hidden sm:table-cell">-{ strconv.Itoa(c.Deletions) }</td>
									<td class="px-4 py-2 hidden md:table-cell">
										<div class="bg-muted rounded-full h-2 w-full overflow-hidden" role="progressbar" aria-label={ c.Name + " commit activity" } aria-valuenow={ strconv.Itoa(c.Commits) } aria-valuemin="0" aria-valuemax={ strconv.Itoa(data.MaxCommits) }>
											<div class="bg-success h-2 rounded-full" style={ "width: " + pct(c.Commits, data.MaxCommits) + "%" }></div>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			} else {
				@components.EmptyState("No commits yet.")
			}
		</div>
	}
}
