package pages

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/fragments"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

func discussionReplyCountText(n int) string {
	if n == 1 {
		return "1 reply"
	}
	return strconv.Itoa(n) + " replies"
}

func discussionAnswerAuthor(replies []view.RenderedDiscussionReply) string {
	for _, r := range replies {
		if r.IsAnswer {
			return r.AuthorName
		}
	}
	return ""
}

func discussionAnswerAnchor(replies []view.RenderedDiscussionReply) string {
	for _, r := range replies {
		if r.IsAnswer {
			return "#reply-" + strconv.FormatInt(r.ID, 10)
		}
	}
	return "#"
}

templ DiscussionDetail(data view.DiscussionDetailData) {
	@layout.Base(data.BasePage, data.Discussion.Title+" · "+data.Owner+"/"+data.RepoName) {
		<div>
			{{ patchURL := "/api/repos/" + data.Owner + "/" + data.RepoName + "/discussions/" + strconv.Itoa(data.Discussion.Number) }}
			<section class="mb-6 border-b border-border pb-6">
				<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="hover:underline">{ data.RepoName }</a>
					<span aria-hidden="true">·</span>
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/discussions") } class="hover:underline">Discussions</a>
					<span aria-hidden="true">·</span>
					<span aria-current="page">#{ strconv.Itoa(data.Discussion.Number) }</span>
				</p>
				<div class="mb-3" x-data="{ editingTitle: false }">
					<div class="flex items-start justify-between gap-3" x-show="!editingTitle">
						<h1 class="text-2xl font-semibold tracking-tight min-w-0">
							{ data.Discussion.Title }
							<span class="text-muted-foreground font-normal font-mono">#{ strconv.Itoa(data.Discussion.Number) }</span>
						</h1>
						if data.CanWrite {
							<button type="button" x-on:click="editingTitle = true" class="shrink-0 inline-flex items-center h-8 px-3 text-[13px] rounded-md border border-border text-muted-foreground hover:bg-muted hover:text-foreground">Edit</button>
						}
					</div>
					if data.CanWrite {
						<div x-show="editingTitle" x-cloak class="flex items-center gap-2">
							<input id="dd-title-input" type="text" value={ data.Discussion.Title } class="flex-1 min-w-0 h-9 rounded-md border border-border bg-transparent px-3 text-sm"/>
							<button type="button" hx-patch={ patchURL } hx-vals="js:{title: document.getElementById('dd-title-input').value}" hx-on::after-request="window.location.reload()" class="inline-flex items-center h-9 px-4 text-[13px] rounded-md font-medium bg-foreground text-background">Save</button>
							<button type="button" x-on:click="editingTitle = false" class="inline-flex items-center h-9 px-3 text-[13px] rounded-md text-muted-foreground hover:underline">Cancel</button>
						</div>
					}
				</div>
				<div class="flex flex-wrap items-center gap-1.5 text-[13px] text-muted-foreground">
					@components.Avatar(data.Discussion.AuthorName, components.AvatarSizeXS, "")
					<span><strong class="text-foreground">{ data.Discussion.AuthorName }</strong> started this discussion</span>
					<time datetime={ data.Discussion.CreatedAt.UTC().Format(time.RFC3339) }>{ data.Discussion.CreatedAt.Format("Jan 2, 2006") }</time>
					<span class="opacity-50 mx-1" aria-hidden="true">·</span>
					<span>{ discussionReplyCountText(len(data.Replies)) }</span>
					<span class="opacity-50 mx-1" aria-hidden="true">·</span>
					<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium border border-border bg-muted text-muted-foreground">{ data.Category.Name }</span>
					for _, lbl := range data.Labels {
						<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium border" style={ "background-color: " + lbl.Color + "33; color: " + lbl.Color + "; border-color: " + lbl.Color + "55" }>{ lbl.Name }</span>
					}
					if data.Discussion.IsLocked {
						@components.Badge(components.BadgeSecondary) {
							Locked
						}
					}
				</div>
			</section>
			<div class="grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-8">
				<div class="space-y-5 min-w-0">
					if data.Discussion.IsAnswered {
						<div class="rounded-md border border-success/40 bg-success/10 p-3 flex items-center gap-2.5 text-[13px]">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-success shrink-0" aria-hidden="true"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
							<span><strong class="text-foreground">Answered</strong> — <a href={ templ.SafeURL(discussionAnswerAnchor(data.Replies)) } class="text-foreground hover:underline">{ discussionAnswerAuthor(data.Replies) }'s reply</a> was marked as the answer.</span>
						</div>
					}
					<article class="rounded-md border border-border bg-card overflow-hidden">
						<header class="px-4 py-2.5 border-b border-border bg-muted flex items-center gap-2 text-[12.5px]">
							@components.Avatar(data.Discussion.AuthorName, components.AvatarSizeSM, data.Discussion.AuthorName)
							<strong class="text-foreground">{ data.Discussion.AuthorName }</strong>
							<span class="text-muted-foreground">started the discussion</span>
							<time class="text-muted-foreground ml-auto" datetime={ data.Discussion.CreatedAt.UTC().Format(time.RFC3339) }>{ data.Discussion.CreatedAt.Format("Jan 2, 2006") }</time>
						</header>
						<div class="px-4 py-4" x-data="{ editingBody: false }">
							<div x-show="!editingBody">
								@components.MarkdownBody(data.BodyHTML)
								if data.CanWrite {
									<button type="button" x-on:click="editingBody = true" class="mt-3 inline-flex items-center h-8 px-3 text-[13px] rounded-md border border-border text-muted-foreground hover:bg-muted hover:text-foreground">Edit</button>
								}
							</div>
							if data.CanWrite {
								<div x-show="editingBody" x-cloak class="space-y-3">
									<textarea id="dd-body-input" rows="10" class="w-full rounded-md border border-border bg-transparent px-3 py-2 text-sm font-mono">{ data.Discussion.Body }</textarea>
									<div class="flex items-center gap-2">
										<button type="button" hx-patch={ patchURL } hx-vals="js:{body: document.getElementById('dd-body-input').value}" hx-on::after-request="window.location.reload()" class="inline-flex items-center h-8 px-3 text-[13px] rounded-md font-medium bg-foreground text-background">Save</button>
										<button type="button" x-on:click="editingBody = false" class="inline-flex items-center h-8 px-3 text-[13px] rounded-md text-muted-foreground hover:underline">Cancel</button>
									</div>
								</div>
							}
						</div>
						<footer class="px-4 py-2 border-t border-border">
							@fragments.ReactionBar("/api/repos/"+data.Owner+"/"+data.RepoName+"/discussions/"+strconv.Itoa(data.Discussion.Number)+"/reactions", "reactions-discussion-"+strconv.Itoa(data.Discussion.Number), data.OPReactions, data.BasePage.CurrentUser != nil)
						</footer>
					</article>
					<h2 class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider pt-1">{ discussionReplyCountText(len(data.Replies)) }</h2>
					for _, reply := range data.Replies {
						<article
							id={ "reply-" + strconv.FormatInt(reply.ID, 10) }
							class={ "rounded-md border bg-card overflow-hidden", templ.KV("border-success/40", reply.IsAnswer), templ.KV("border-border", !reply.IsAnswer) }
						>
							<header class={ "px-4 py-2.5 border-b flex items-center gap-2 text-[12.5px]", templ.KV("border-success/30 bg-success/10", reply.IsAnswer), templ.KV("border-border bg-muted", !reply.IsAnswer) }>
								@components.Avatar(reply.AuthorName, components.AvatarSizeSM, reply.AuthorName)
								<strong class="text-foreground">{ reply.AuthorName }</strong>
								if reply.IsAnswer {
									<span class="inline-flex items-center gap-1 text-success font-medium">
										<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
										Answer
									</span>
								}
								<span class="text-muted-foreground">replied</span>
								<time class="text-muted-foreground ml-auto" datetime={ reply.CreatedAt.UTC().Format(time.RFC3339) }>{ reply.CreatedAt.Format("Jan 2, 2006 at 15:04") }</time>
							</header>
							<div class="px-4 py-4">
								@components.MarkdownBody(reply.BodyHTML)
							</div>
							<footer class="px-4 py-2 border-t border-border flex items-center gap-2">
								@fragments.ReactionBar("/api/repos/"+data.Owner+"/"+data.RepoName+"/discussions/"+strconv.Itoa(data.Discussion.Number)+"/replies/"+strconv.FormatInt(reply.ID, 10)+"/reactions", "reactions-reply-"+strconv.FormatInt(reply.ID, 10), reply.Reactions, data.BasePage.CurrentUser != nil)
								if data.CanWrite {
									if reply.IsAnswer {
										@components.Button(components.ButtonSecondary, components.ButtonSizeSM, templ.Attributes{
											"hx-patch":             "/api/repos/" + data.Owner + "/" + data.RepoName + "/discussions/" + strconv.Itoa(data.Discussion.Number),
											"hx-vals":              `{"answer_id": null}`,
											"hx-on::after-request": "window.location.reload()",
											"class":                "ml-auto",
											"type":                 "button",
										}) {
											Unmark answer
										}
									} else {
										@components.Button(components.ButtonSuccess, components.ButtonSizeSM, templ.Attributes{
											"hx-patch":             "/api/repos/" + data.Owner + "/" + data.RepoName + "/discussions/" + strconv.Itoa(data.Discussion.Number),
											"hx-vals":              `{"answer_id": ` + strconv.FormatInt(reply.ID, 10) + `}`,
											"hx-on::after-request": "window.location.reload()",
											"class":                "ml-auto",
											"type":                 "button",
										}) {
											Mark as answer
										}
									}
									@components.Button(components.ButtonDestructive, components.ButtonSizeSM, templ.Attributes{
										"hx-delete":  "/api/repos/" + data.Owner + "/" + data.RepoName + "/discussions/" + strconv.Itoa(data.Discussion.Number) + "/replies/" + strconv.FormatInt(reply.ID, 10),
										"hx-confirm": "Delete this reply?",
										"hx-target":  "#reply-" + strconv.FormatInt(reply.ID, 10),
										"hx-swap":    "outerHTML",
										"type":       "button",
									}) {
										Delete
									}
								}
							</footer>
						</article>
					}
					if data.BasePage.CurrentUser != nil {
						if !data.Discussion.IsLocked {
							<div class="rounded-md border border-border bg-card p-4 space-y-3">
								<label for="reply-body" class="sr-only">Reply body</label>
								@components.Textarea(templ.Attributes{
									"id":          "reply-body",
									"rows":        "5",
									"class":       "font-mono",
									"placeholder": "Add to the discussion…",
								})
								<div class="flex items-center gap-2">
									if data.CanWrite {
										@components.Button(components.ButtonGhost, components.ButtonSizeSM, templ.Attributes{
											"hx-patch":             "/api/repos/" + data.Owner + "/" + data.RepoName + "/discussions/" + strconv.Itoa(data.Discussion.Number),
											"hx-vals":              `{"locked": true}`,
											"hx-on::after-request": "window.location.reload()",
											"type":                 "button",
										}) {
											Lock discussion
										}
									}
									@components.Button(components.ButtonDefault, components.ButtonSizeSM, templ.Attributes{
										"hx-post":              "/api/repos/" + data.Owner + "/" + data.RepoName + "/discussions/" + strconv.Itoa(data.Discussion.Number) + "/replies",
										"hx-vals":              `js:{body: document.getElementById("reply-body").value}`,
										"hx-on::after-request": "window.location.reload()",
										"class":                "ml-auto",
										"type":                 "button",
									}) {
										Comment
									}
								</div>
							</div>
						} else {
							<div class="rounded-md border border-border bg-muted p-4 text-[13px] text-muted-foreground flex items-center justify-between gap-3">
								<span>This discussion is locked. No new replies can be added.</span>
								if data.CanWrite {
									@components.Button(components.ButtonGhost, components.ButtonSizeSM, templ.Attributes{
										"hx-patch":             "/api/repos/" + data.Owner + "/" + data.RepoName + "/discussions/" + strconv.Itoa(data.Discussion.Number),
										"hx-vals":              `{"locked": false}`,
										"hx-on::after-request": "window.location.reload()",
										"type":                 "button",
									}) {
										Unlock discussion
									}
								}
							</div>
						}
					} else {
						<div class="rounded-md border border-border bg-muted p-4 text-[13px] text-muted-foreground text-center">
							<a href="/login" class="text-foreground hover:underline">Sign in</a> to reply.
						</div>
					}
				</div>
				<aside class="space-y-6" aria-label="Discussion metadata" x-data="{ open: null }" x-on:keydown.escape.window="open = null">
					<section aria-labelledby="dd-category-heading">
						<div class="flex items-center justify-between mb-2">
							<h2 id="dd-category-heading" class="text-[12px] font-medium text-muted-foreground">Category</h2>
							if data.CanWrite {
								<div class="relative" x-on:click.outside="open === 'category' && (open = null)">
									<button type="button" x-on:click="open = (open === 'category' ? null : 'category')" :aria-expanded="open === 'category' ? 'true' : 'false'" aria-haspopup="menu" aria-label="Change category" class="text-muted-foreground hover:text-foreground">
										<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 113 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
									</button>
									<div x-show="open === 'category'" x-cloak x-transition.opacity.duration.100ms role="menu" aria-label="Move to category" class="absolute right-0 top-full mt-1.5 z-50 w-56 rounded-md border border-border bg-popover text-popover-foreground shadow-md p-1">
										<div class="px-2 pt-1 pb-0.5 text-[10px] font-medium uppercase tracking-wider text-muted-foreground">Move to category</div>
										for _, cat := range data.AllCategories {
											<button type="button" hx-patch={ patchURL } hx-vals={ `{"category_id":` + strconv.FormatInt(cat.ID, 10) + `}` } hx-on::after-request="window.location.reload()" role="menuitemradio" aria-checked={ strconv.FormatBool(cat.ID == data.Category.ID) } class="flex w-full items-center gap-2 px-2.5 py-1.5 rounded-md text-left text-[13px] text-muted-foreground hover:bg-accent hover:text-foreground">
												<span class="flex-1 truncate">{ cat.Name }</span>
												if cat.ID == data.Category.ID {
													<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="shrink-0 text-success" aria-hidden="true" focusable="false"><polyline points="20 6 9 17 4 12"></polyline></svg>
												}
											</button>
										}
									</div>
								</div>
							}
						</div>
						<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[12px] font-medium border border-border bg-muted text-foreground">{ data.Category.Name }</span>
					</section>
					@components.LabelSidebar(data.Owner, data.RepoName, data.Discussion.Number, "discussions", data.Labels, data.AllLabels, data.CanWrite)
					<section aria-labelledby="dd-participants-heading">
						<h2 id="dd-participants-heading" class="text-[12px] font-medium text-muted-foreground mb-2">
							if len(data.Participants) == 1 {
								1 participant
							} else {
								{ strconv.Itoa(len(data.Participants)) } participants
							}
						</h2>
						<ul class="flex flex-wrap gap-1.5">
							for _, p := range data.Participants {
								<li>
									@components.Avatar(p, components.AvatarSizeDefault, p)
								</li>
							}
						</ul>
					</section>
				</aside>
			</div>
		</div>
	}
}
