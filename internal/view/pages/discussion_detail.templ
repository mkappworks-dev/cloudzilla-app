package pages

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ DiscussionDetail(data view.DiscussionDetailData) {
	@layout.Base(data.BasePage, data.Discussion.Title+" · "+data.Owner+"/"+data.RepoName) {
		<div class="max-w-4xl mx-auto space-y-6">
			<!-- Header -->
			<div>
				<div class="text-sm text-muted-foreground mb-1">
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/discussions") } class="text-foreground hover:underline">Discussions</a>
					<span class="mx-1" aria-hidden="true">/</span>
					<span>#{ strconv.Itoa(data.Discussion.Number) }</span>
				</div>
				<h1 class="text-2xl font-bold text-foreground flex items-center gap-2">
					if data.Discussion.IsAnswered {
						<span class="inline-flex items-center justify-center w-6 h-6 bg-success text-success-foreground text-sm rounded-full" aria-label="Answered">✓</span>
					}
					{ data.Discussion.Title }
				</h1>
				<div class="flex items-center gap-3 mt-2 text-sm text-muted-foreground">
					<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium border bg-[hsl(270_70%_50%/0.15)] text-[hsl(270_70%_70%)] border-[hsl(270_70%_50%/0.30)]">{ data.Category.Emoji } { data.Category.Name }</span>
					<span>By <a href={ templ.SafeURL("/" + data.Discussion.AuthorName) } class="text-foreground hover:underline">{ data.Discussion.AuthorName }</a></span>
					<time datetime={ data.Discussion.CreatedAt.UTC().Format(time.RFC3339) }>{ data.Discussion.CreatedAt.Format("Jan 2, 2006") }</time>
					if data.Discussion.IsLocked {
						@components.Badge(components.BadgeSecondary) {
							Locked
						}
					}
				</div>
			</div>
			<!-- Body -->
			<div class="rounded-md border border-border bg-card p-6">
				@components.MarkdownBody(data.BodyHTML)
				if data.CanWrite {
					<div class="mt-4 pt-4 border-t border-border flex items-center gap-3 text-sm">
						if data.Discussion.IsLocked {
							@components.Button(components.ButtonGhost, components.ButtonSizeSM, templ.Attributes{
								"hx-patch":             "/api/repos/" + data.Owner + "/" + data.RepoName + "/discussions/" + strconv.Itoa(data.Discussion.Number),
								"hx-vals":              `{"locked": false}`,
								"hx-on::after-request": "window.location.reload()",
								"type":                 "button",
							}) {
								Unlock
							}
						} else {
							@components.Button(components.ButtonGhost, components.ButtonSizeSM, templ.Attributes{
								"hx-patch":             "/api/repos/" + data.Owner + "/" + data.RepoName + "/discussions/" + strconv.Itoa(data.Discussion.Number),
								"hx-vals":              `{"locked": true}`,
								"hx-on::after-request": "window.location.reload()",
								"type":                 "button",
							}) {
								Lock
							}
						}
					</div>
				}
			</div>
			<!-- Replies -->
			<div class="space-y-4">
				if len(data.Replies) == 1 {
					<h2 class="text-lg font-semibold text-foreground">1 reply</h2>
				} else {
					<h2 class="text-lg font-semibold text-foreground">{ strconv.Itoa(len(data.Replies)) } replies</h2>
				}
				for _, reply := range data.Replies {
					<div
						id={ "reply-" + strconv.FormatInt(reply.ID, 10) }
						class={ "rounded-md bg-card p-5", templ.KV("border border-success/40", reply.IsAnswer), templ.KV("border border-border", !reply.IsAnswer) }
					>
						if reply.IsAnswer {
							<div class="flex items-center gap-2 mb-3 text-success text-sm font-medium">
								<span aria-hidden="true">✓</span>
								<span>Accepted Answer</span>
							</div>
						}
						<div class="flex items-start gap-3">
							@components.Avatar(reply.AuthorName, components.AvatarSizeSM, reply.AuthorName)
							<div class="flex-1 min-w-0">
								<div class="flex items-center gap-2 mb-2">
									<a href={ templ.SafeURL("/" + reply.AuthorName) } class="text-foreground hover:underline font-medium text-sm">{ reply.AuthorName }</a>
									<time class="text-xs text-muted-foreground" datetime={ reply.CreatedAt.UTC().Format(time.RFC3339) }>{ reply.CreatedAt.Format("Jan 2, 2006 at 15:04") }</time>
								</div>
								@components.MarkdownBody(reply.BodyHTML)
							</div>
							if data.CanWrite {
								<div class="flex-shrink-0 flex flex-col gap-1">
									if !reply.IsAnswer {
										@components.Button(components.ButtonSuccess, components.ButtonSizeSM, templ.Attributes{
											"hx-patch":             "/api/repos/" + data.Owner + "/" + data.RepoName + "/discussions/" + strconv.Itoa(data.Discussion.Number),
											"hx-vals":              `{"answer_id": ` + strconv.FormatInt(reply.ID, 10) + `}`,
											"hx-on::after-request": "window.location.reload()",
											"type":                 "button",
										}) {
											Mark Answer
										}
									} else {
										@components.Button(components.ButtonSecondary, components.ButtonSizeSM, templ.Attributes{
											"hx-patch":             "/api/repos/" + data.Owner + "/" + data.RepoName + "/discussions/" + strconv.Itoa(data.Discussion.Number),
											"hx-vals":              `{"answer_id": null}`,
											"hx-on::after-request": "window.location.reload()",
											"type":                 "button",
										}) {
											Unmark
										}
									}
									@components.Button(components.ButtonDestructive, components.ButtonSizeSM, templ.Attributes{
										"hx-delete":  "/api/repos/" + data.Owner + "/" + data.RepoName + "/discussions/" + strconv.Itoa(data.Discussion.Number) + "/replies/" + strconv.FormatInt(reply.ID, 10),
										"hx-confirm": "Delete this reply?",
										"hx-target":  "#reply-" + strconv.FormatInt(reply.ID, 10),
										"hx-swap":    "outerHTML",
										"type":       "button",
									}) {
										Delete
									}
								</div>
							}
						</div>
					</div>
				}
			</div>
			<!-- Reply form -->
			if data.BasePage.CurrentUser != nil {
				if !data.Discussion.IsLocked {
					<div class="rounded-md border border-border bg-card p-6 space-y-4">
						<h3 class="text-base font-semibold text-foreground">Add a reply</h3>
						<label for="reply-body" class="sr-only">Reply body</label>
						@components.Textarea(templ.Attributes{
							"id":          "reply-body",
							"rows":        "5",
							"class":       "font-mono",
							"placeholder": "Write a reply (Markdown supported)...",
						})
						@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{
							"hx-post":              "/api/repos/" + data.Owner + "/" + data.RepoName + "/discussions/" + strconv.Itoa(data.Discussion.Number) + "/replies",
							"hx-vals":              `js:{body: document.getElementById("reply-body").value}`,
							"hx-on::after-request": "window.location.reload()",
							"type":                 "button",
						}) {
							Reply
						}
					</div>
				} else {
					<div class="rounded-md border border-border bg-muted p-4 text-sm text-muted-foreground text-center">
						This discussion is locked. No new replies can be added.
					</div>
				}
			} else {
				<div class="rounded-md border border-border bg-muted p-4 text-sm text-muted-foreground text-center">
					<a href="/login" class="text-foreground hover:underline">Sign in</a> to reply.
				</div>
			}
		</div>
	}
}
