package pages

import (
	"fmt"
	"strconv"

	"github.com/mkappworks/cloudzilla/internal/model"
	"github.com/mkappworks/cloudzilla/internal/view"
	"github.com/mkappworks/cloudzilla/internal/view/layout"
)

templ PullDetail(data view.PullDetailData) {
	@layout.Base(data.BasePage, data.Pull.Title+" · PR #"+strconv.Itoa(data.Pull.Number)+" · "+data.Owner+"/"+data.RepoName) {
		<div class="space-y-6">
			<div class="mb-4">
				<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/pulls") } class="text-blue-600 hover:underline text-sm">&larr; Back to Pull Requests</a>
			</div>
			<div class="flex gap-6">
				<!-- Main content -->
				<div class="flex-1 min-w-0 space-y-6">
					<div id="pull-detail" class="bg-white border border-gray-200 rounded-lg p-6">
						<div class="flex justify-between items-start mb-4">
							<div>
								<div class="flex items-center gap-2 flex-wrap">
									<h1 class="text-3xl font-bold">{ data.Pull.Title }</h1>
									if data.Pull.IsDraft {
										<span class="px-2 py-0.5 rounded text-sm font-medium bg-yellow-100 text-yellow-800">Draft</span>
									}
								</div>
								<p class="text-gray-600 text-sm mt-2">
									#{ strconv.Itoa(data.Pull.Number) } by { data.Pull.AuthorName } on { data.Pull.CreatedAt.Format("Jan 2, 2006") }
									· { data.Pull.HeadBranch } &rarr; { data.Pull.BaseBranch }
								</p>
							</div>
							<span class={ "px-3 py-1 rounded-full text-sm font-medium", templ.KV("bg-green-100 text-green-700", data.Pull.State == "open"), templ.KV("bg-purple-100 text-purple-700", data.Pull.State == "merged"), templ.KV("bg-red-100 text-red-700", data.Pull.State != "open" && data.Pull.State != "merged") }>
								{ string(data.Pull.State) }
							</span>
						</div>
						if data.Pull.State == "open" && data.Pull.IsDraft {
							<div class="mb-4 px-4 py-3 bg-yellow-50 border border-yellow-200 rounded-lg flex items-center justify-between gap-4">
								<p class="text-sm text-yellow-800">&#9998; This pull request is still a work in progress. Merge is blocked until it is marked ready for review.</p>
								if data.CanWrite {
									<button hx-patch={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/pulls/" + strconv.Itoa(data.Pull.Number) } hx-vals='{"is_draft":"false"}' hx-target="#pull-detail" hx-swap="outerHTML" class="shrink-0 px-4 py-1.5 bg-green-600 text-white rounded text-sm font-medium hover:bg-green-700 transition-colors">
										Ready for review
									</button>
								}
							</div>
						}
						if len(data.Labels) > 0 {
							<div class="flex flex-wrap gap-1 mb-3">
								for _, l := range data.Labels {
									<span class="px-2 py-0.5 rounded-full text-xs font-medium" style={ "background-color: " + l.Color }>{ l.Name }</span>
								}
							</div>
						}
						<div class="prose prose-sm max-w-none bg-gray-50 p-4 rounded border border-gray-200 my-4">
							@templ.Raw(data.BodyHTML)
						</div>
						if len(data.HeadStatuses) > 0 {
							<div class="mt-4 p-3 bg-gray-50 border border-gray-200 rounded space-y-1">
								<p class="text-xs font-semibold text-gray-600 mb-2">Checks on { data.Pull.HeadBranch }</p>
								for _, s := range data.HeadStatuses {
									<div class="flex items-center gap-2 text-sm">
										if s.State == model.CommitStatusSuccess {
											<span class="text-green-600">&#10003;</span>
										} else if s.State == model.CommitStatusFailure {
											<span class="text-red-600">&#10007;</span>
										} else if s.State == model.CommitStatusError {
											<span class="text-red-600">&#9888;</span>
										} else {
											<span class="text-yellow-500">&#9679;</span>
										}
										<span class="font-medium text-gray-800">{ s.Context }</span>
										if s.Description != "" {
											<span class="text-gray-500">— { s.Description }</span>
										}
										if s.TargetURL != "" {
											<a href={ templ.SafeURL(s.TargetURL) } class="text-blue-600 hover:underline ml-auto text-xs">Details</a>
										}
									</div>
								}
							</div>
						}
						if data.Pull.State == "open" {
							<div class="flex flex-wrap gap-2 items-center mt-4">
								if !data.Pull.IsDraft {
									if !data.CanMerge {
										<div class="w-full px-4 py-2 bg-red-50 border border-red-200 rounded text-sm text-red-800">
											&#128683; Merge blocked: { data.MergeBlockReason }
										</div>
									}
									if data.CanMerge && data.Diff != nil {
										if data.Diff.CanFastForward {
											<button hx-patch={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/pulls/" + strconv.Itoa(data.Pull.Number) } hx-vals='{"state":"merged","merge_strategy":"ff"}' hx-target="#pull-detail" hx-swap="outerHTML" hx-on--response-error="alert('Merge failed. Please refresh and try again.')" class="px-4 py-2 bg-purple-600 text-white rounded font-medium hover:bg-purple-700 transition-colors">
												Merge (fast-forward)
											</button>
										}
										if data.Diff.CanFastForward || data.Diff.CanThreeWayMerge {
											<button hx-patch={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/pulls/" + strconv.Itoa(data.Pull.Number) } hx-vals='{"state":"merged","merge_strategy":"merge"}' hx-target="#pull-detail" hx-swap="outerHTML" hx-on--response-error="alert('Merge failed. Please refresh and try again.')" class="px-4 py-2 bg-indigo-600 text-white rounded font-medium hover:bg-indigo-700 transition-colors">
												Create merge commit
											</button>
											<button hx-patch={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/pulls/" + strconv.Itoa(data.Pull.Number) } hx-vals='{"state":"merged","merge_strategy":"squash"}' hx-target="#pull-detail" hx-swap="outerHTML" hx-on--response-error="alert('Merge failed. Please refresh and try again.')" class="px-4 py-2 bg-blue-600 text-white rounded font-medium hover:bg-blue-700 transition-colors">
												Squash and merge
											</button>
										} else {
											<div class="px-4 py-2 bg-yellow-50 border border-yellow-200 rounded text-sm text-yellow-800">
												Cannot merge automatically — conflicting changes in both branches. Rebase the head branch onto
												<code class="font-mono">{ data.Pull.BaseBranch }</code> and push to enable merge.
											</div>
										}
									}
								}
								<button hx-patch={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/pulls/" + strconv.Itoa(data.Pull.Number) } hx-vals='{"state":"closed"}' hx-target="#pull-detail" hx-swap="outerHTML" class="px-4 py-2 bg-red-600 text-white rounded font-medium hover:bg-red-700 transition-colors">
									Close PR
								</button>
							</div>
						}
						if data.Diff != nil {
							<div class="mt-6 border-t border-gray-200 pt-4 space-y-4">
								<div class="flex items-center justify-between">
									<h2 class="font-semibold text-gray-900">Changed files ({ strconv.Itoa(len(data.Diff.Files)) })</h2>
									<span class="text-sm">
										<span class="text-green-600">+{ strconv.Itoa(data.Diff.TotalAdded) }</span>
										<span class="text-red-500 ml-2">-{ strconv.Itoa(data.Diff.TotalDeleted) }</span>
									</span>
								</div>
								for _, f := range data.Diff.Files {
									{{ filePath := f.NewPath }}
									if filePath == "" {
										{{ filePath = f.OldPath }}
									}
									<div class="border border-gray-200 rounded-lg overflow-hidden">
										<div class="bg-gray-50 px-4 py-2 text-sm font-mono border-b border-gray-200 flex items-center gap-2">
											if f.IsNew {
												<span class="text-green-600 text-xs">added</span>
											} else if f.IsDelete {
												<span class="text-red-600 text-xs">deleted</span>
											}
											<span>{ filePath }</span>
											<span class="ml-auto text-xs text-green-600">+{ strconv.Itoa(f.Added) }</span>
											<span class="text-xs text-red-500 ml-1">-{ strconv.Itoa(f.Deleted) }</span>
										</div>
										if f.IsBinary {
											<div class="px-4 py-3 text-sm text-gray-500">Binary file</div>
										} else {
											<table class="w-full border-collapse">
												for _, hunk := range f.Hunks {
													<tr><td colspan="2" class="text-xs font-mono bg-gray-100 px-4 py-1 text-gray-500 border-b border-gray-200">{ hunk.Header }</td></tr>
													for _, line := range hunk.Lines {
														{{ lineNum := line.NewNum }}
														if line.Type == "del" {
															{{ lineNum = line.OldNum }}
														} else if line.Type == "ctx" {
															{{ lineNum = line.OldNum }}
														}
														<tr class={ templ.KV("bg-green-50", line.Type == "add"), templ.KV("bg-red-50", line.Type == "del") }>
															<td class="w-10 text-right pr-2 text-gray-400 select-none border-r border-gray-200 py-0.5 text-xs font-mono align-top">
																if line.Type == "add" {
																	{ strconv.Itoa(line.NewNum) }
																} else if line.Type == "del" {
																	{ strconv.Itoa(line.OldNum) }
																} else {
																	{ strconv.Itoa(line.OldNum) }
																}
																if data.CanWrite && data.Pull.State == "open" && line.Type != "del" {
																	<span hx-get={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/pulls/" + strconv.Itoa(data.Pull.Number) + "/line_comments/form?path=" + filePath + "&line=" + strconv.Itoa(lineNum) } hx-target={ "#lc-form-" + filePath + "-" + strconv.Itoa(lineNum) } hx-swap="innerHTML" class="cursor-pointer text-gray-300 hover:text-blue-500 select-none pl-0.5">+</span>
																}
															</td>
															<td class={ "pl-3 py-0.5 whitespace-pre text-xs font-mono", templ.KV("text-green-800", line.Type == "add"), templ.KV("text-red-800", line.Type == "del"), templ.KV("text-gray-700", line.Type != "add" && line.Type != "del") }>
																if line.Type == "add" {
																	+{ line.Content }
																} else if line.Type == "del" {
																	-{ line.Content }
																} else {
																	{ " " }{ line.Content }
																}
															</td>
														</tr>
														if line.Type != "del" {
															{{ key := fmt.Sprintf("%s:%d", filePath, lineNum) }}
															if comments, ok := data.LineComments[key]; ok && len(comments) > 0 {
																<tr id={ "lc-" + filePath + "-" + strconv.Itoa(lineNum) } class="bg-blue-50 border-t border-blue-100">
																	<td colspan="2" class="px-4 py-0">
																		for _, lc := range comments {
																			<div class="flex items-start gap-2 py-2 border-b border-blue-100 last:border-0">
																				<div class="w-6 h-6 rounded-full bg-blue-400 flex items-center justify-center text-white text-xs font-bold shrink-0 mt-0.5">
																					if len(lc.AuthorName) > 0 {
																						{ string(lc.AuthorName[0]) }
																					}
																				</div>
																				<div class="flex-1 min-w-0">
																					<div class="flex items-center gap-2">
																						<a href={ templ.SafeURL("/" + lc.AuthorName) } class="text-xs font-semibold hover:underline">{ lc.AuthorName }</a>
																						<span class="text-xs text-gray-400">{ lc.CreatedAt.Format("Jan 2, 2006") }</span>
																					</div>
																					<div class="text-xs text-gray-700 mt-0.5">@templ.Raw(lc.BodyHTML)</div>
																					if lc.IsSuggestion {
																						<div class="mt-2 rounded border border-green-300 bg-green-50 text-xs font-mono overflow-x-auto">
																							<div class="px-3 py-1 text-green-700 font-medium border-b border-green-200">Suggested change</div>
																							<pre class="px-3 py-2 whitespace-pre-wrap">{ lc.SuggestionBody }</pre>
																							if data.CanWrite && data.Pull.State == "open" {
																								<form hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/pulls/" + strconv.Itoa(data.Pull.Number) + "/line_comments/" + strconv.FormatInt(lc.ID, 10) + "/apply" } hx-on--after-request="window.location.reload()" class="px-3 py-2 border-t border-green-200">
																									<button type="submit" class="px-3 py-1 bg-green-600 text-white rounded text-xs hover:bg-green-700">Apply suggestion</button>
																								</form>
																							}
																						</div>
																					}
																				</div>
																				if data.CanWrite {
																					<button hx-delete={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/pulls/" + strconv.Itoa(data.Pull.Number) + "/line_comments/" + strconv.FormatInt(lc.ID, 10) } hx-target={ "#lc-" + filePath + "-" + strconv.Itoa(lineNum) } hx-swap="outerHTML" class="text-gray-300 hover:text-red-400 text-xs shrink-0">&times;</button>
																				}
																			</div>
																		}
																		<div id={ "lc-form-" + filePath + "-" + strconv.Itoa(lineNum) }></div>
																	</td>
																</tr>
															} else {
																<tr><td colspan="2"><div id={ "lc-form-" + filePath + "-" + strconv.Itoa(lineNum) }></div></td></tr>
															}
														}
													}
												}
											</table>
										}
									</div>
								}
							</div>
						}
					</div>
					<!-- PR Reviews section -->
					<div id="pr-reviews" class="bg-white border border-gray-200 rounded-lg p-6">
						<h2 class="text-lg font-semibold mb-4">Reviews</h2>
						if len(data.Reviews) > 0 {
							for _, rev := range data.Reviews {
								<div class="flex items-start gap-3 mb-4 pb-4 border-b border-gray-100 last:border-0 last:mb-0 last:pb-0">
									<div class={ "w-8 h-8 rounded-full flex items-center justify-center text-white text-sm font-bold shrink-0", templ.KV("bg-green-500", rev.State == "approved"), templ.KV("bg-red-500", rev.State == "changes_requested"), templ.KV("bg-gray-400", rev.State != "approved" && rev.State != "changes_requested") }>
										if len(rev.AuthorName) > 0 {
											{ string(rev.AuthorName[0]) }
										}
									</div>
									<div class="flex-1 min-w-0">
										<div class="flex items-center gap-2 flex-wrap">
											<a href={ templ.SafeURL("/" + rev.AuthorName) } class="text-sm font-semibold hover:underline">{ rev.AuthorName }</a>
											<span class={ "px-2 py-0.5 rounded-full text-xs font-medium", templ.KV("bg-green-100 text-green-700", rev.State == "approved"), templ.KV("bg-red-100 text-red-700", rev.State == "changes_requested"), templ.KV("bg-gray-100 text-gray-600", rev.State != "approved" && rev.State != "changes_requested") }>
												if rev.State == "approved" {
													&#10003; Approved
												} else if rev.State == "changes_requested" {
													&#10007; Changes requested
												} else {
													Commented
												}
											</span>
										</div>
										if rev.Body != "" {
											<p class="text-sm text-gray-700 mt-1">{ rev.Body }</p>
										}
									</div>
								</div>
							}
						} else {
							<p class="text-sm text-gray-400">No reviews yet.</p>
						}
						if data.CanWrite && data.Pull.State == "open" && !data.Pull.IsDraft {
							<form hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/pulls/" + strconv.Itoa(data.Pull.Number) + "/reviews" } hx-target="#pr-reviews" hx-swap="outerHTML" class="mt-4 border-t border-gray-100 pt-4 space-y-3">
								<h3 class="text-sm font-medium text-gray-700">Submit a review</h3>
								<textarea name="body" rows="3" placeholder="Leave a comment (optional)" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-blue-400 resize-none"></textarea>
								<div class="flex flex-wrap gap-4 text-sm">
									<label class="flex items-center gap-2 cursor-pointer">
										<input type="radio" name="state" value="commented" checked class="accent-gray-500"/>
										<span>Comment</span>
									</label>
									<label class="flex items-center gap-2 cursor-pointer">
										<input type="radio" name="state" value="approved" class="accent-green-600"/>
										<span class="text-green-700">Approve</span>
									</label>
									<label class="flex items-center gap-2 cursor-pointer">
										<input type="radio" name="state" value="changes_requested" class="accent-red-600"/>
										<span class="text-red-700">Request changes</span>
									</label>
								</div>
								<button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded text-sm font-medium hover:bg-blue-700 transition-colors">
									Submit review
								</button>
							</form>
						}
					</div>
				</div>
				<!-- Sidebar -->
				<div class="w-56 shrink-0 space-y-4">
					<div class="bg-white border border-gray-200 rounded-lg p-4">
						<div id="pull-labels">
							<h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Labels</h3>
							<div class="flex flex-wrap gap-1">
								if len(data.Labels) > 0 {
									for _, l := range data.Labels {
										<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium" style={ "background-color: " + l.Color }>
											{ l.Name }
											if data.CanWrite {
												<button hx-delete={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/pulls/" + strconv.Itoa(data.Pull.Number) + "/labels/" + strconv.FormatInt(l.ID, 10) } hx-target="#pull-labels" hx-swap="outerHTML" class="ml-0.5 hover:opacity-70 font-bold leading-none">&times;</button>
											}
										</span>
									}
								} else {
									<span class="text-xs text-gray-400">None yet</span>
								}
							</div>
							if data.CanWrite && len(data.AllLabels) > 0 {
								<details class="mt-2">
									<summary class="text-xs text-blue-600 cursor-pointer hover:underline">Add label</summary>
									<div class="mt-1 space-y-1 max-h-40 overflow-y-auto border border-gray-100 rounded">
										for _, l := range data.AllLabels {
											<button hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/pulls/" + strconv.Itoa(data.Pull.Number) + "/labels/" + strconv.FormatInt(l.ID, 10) } hx-target="#pull-labels" hx-swap="outerHTML" class="w-full text-left flex items-center gap-2 px-2 py-1 hover:bg-gray-50 text-xs">
												<span class="w-3 h-3 rounded-full inline-block shrink-0" style={ "background-color: " + l.Color }></span>
												{ l.Name }
											</button>
										}
									</div>
								</details>
							}
						</div>
					</div>
					<div class="bg-white border border-gray-200 rounded-lg p-4">
						<div id="issue-milestone">
							<h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Milestone</h3>
							if data.Milestone != nil {
								<div class="text-sm">
									<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/milestones") } class="font-medium text-gray-800 hover:underline">{ data.Milestone.Title }</a>
									if (data.Milestone.OpenCount + data.Milestone.ClosedCount) > 0 {
										<div class="mt-1">
											<div class="w-full bg-gray-200 rounded-full h-1">
												<div class="bg-green-500 h-1 rounded-full" style={ "width: " + strconv.Itoa(func() int { total := data.Milestone.OpenCount + data.Milestone.ClosedCount; if total == 0 { return 0 }; return data.Milestone.ClosedCount * 100 / total }()) + "%" }></div>
											</div>
											<p class="text-xs text-gray-400 mt-0.5">{ strconv.Itoa(data.Milestone.ClosedCount) }/{ strconv.Itoa(data.Milestone.OpenCount + data.Milestone.ClosedCount) } closed</p>
										</div>
									}
								</div>
							} else {
								<span class="text-xs text-gray-400">No milestone</span>
							}
							if data.CanWrite && len(data.AllMilestones) > 0 {
								<details class="mt-2">
									<summary class="text-xs text-blue-600 cursor-pointer hover:underline">
										if data.Milestone != nil {
											Change
										} else {
											Set milestone
										}
									</summary>
									<div class="mt-1 space-y-1 max-h-40 overflow-y-auto border border-gray-100 rounded">
										<form hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/pulls/" + strconv.Itoa(data.Pull.Number) + "/milestone" } hx-target="#issue-milestone" hx-swap="outerHTML" class="p-1">
											<button type="submit" name="milestone_id" value="" class="w-full text-left px-2 py-1 hover:bg-gray-50 text-xs text-gray-500">
												No milestone
											</button>
											for _, m := range data.AllMilestones {
												<button type="submit" name="milestone_id" value={ strconv.FormatInt(m.ID, 10) } class={ "w-full text-left flex items-center gap-2 px-2 py-1 hover:bg-gray-50 text-xs", templ.KV("font-semibold text-blue-600", data.Milestone != nil && data.Milestone.ID == m.ID) }>
													<span class={ "w-2 h-2 rounded-full inline-block shrink-0", templ.KV("bg-gray-400", m.State == "closed"), templ.KV("bg-green-500", m.State != "closed") }></span>
													{ m.Title }
												</button>
											}
										</form>
									</div>
								</details>
							}
						</div>
					</div>
					<div class="bg-white border border-gray-200 rounded-lg p-4">
						<div id="pull-assignees">
							<h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Assignees</h3>
							<div class="space-y-1">
								if len(data.Assignees) > 0 {
									for _, u := range data.Assignees {
										<div class="flex items-center justify-between">
											<a href={ templ.SafeURL("/" + u.Username) } class="text-xs font-medium hover:underline">{ u.Username }</a>
											if data.CanWrite {
												<button hx-delete={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/pulls/" + strconv.Itoa(data.Pull.Number) + "/assignees?username=" + u.Username } hx-target="#pull-assignees" hx-swap="outerHTML" class="text-xs text-red-500 hover:underline ml-2">&times;</button>
											}
										</div>
									}
								} else {
									<span class="text-xs text-gray-400">No one assigned</span>
								}
							</div>
							if data.CanWrite {
								<form hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/pulls/" + strconv.Itoa(data.Pull.Number) + "/assignees" } hx-target="#pull-assignees" hx-swap="outerHTML" class="mt-2 flex gap-1">
									<input type="text" name="username" placeholder="Username" required class="flex-1 border border-gray-300 rounded px-2 py-1 text-xs focus:outline-none focus:ring-1 focus:ring-blue-400 min-w-0"/>
									<button type="submit" class="px-2 py-1 bg-blue-600 text-white rounded text-xs hover:bg-blue-700 shrink-0">+</button>
								</form>
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	}
}
