package pages

import (
	"fmt"
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/model"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ PullDetail(data view.PullDetailData) {
	@layout.Base(data.BasePage, data.Pull.Title+" · PR #"+strconv.Itoa(data.Pull.Number)+" · "+data.Owner+"/"+data.RepoName) {
		<div class="space-y-6">
			<div>
				<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/pulls") } class="text-sm text-muted-foreground hover:text-foreground inline-flex items-center gap-1">
					<span aria-hidden="true">←</span> Back to pull requests
				</a>
			</div>

			<div class="flex gap-6">

				<!-- Main column -->
				<div class="flex-1 min-w-0 space-y-6">

					<!-- PR header / body / actions / diff -->
					<article id="pull-detail" class="rounded-md border border-border bg-card overflow-hidden" aria-labelledby="pull-title">
						<div class="p-6">
							<!-- Title + state row -->
							<div class="flex justify-between items-start gap-4 mb-3">
								<div class="flex-1 min-w-0">
									<h1 id="pull-title" class="text-2xl font-semibold tracking-tight flex items-center gap-2 flex-wrap">
										{ data.Pull.Title }
										<span class="text-muted-foreground font-normal">#{ strconv.Itoa(data.Pull.Number) }</span>
										if data.Pull.IsDraft {
											@components.Badge(components.BadgeDraft) {
												Draft
											}
										}
									</h1>
									<p class="text-sm text-muted-foreground mt-2">
										by <a href={ templ.SafeURL("/" + data.Pull.AuthorName) } class="hover:underline text-foreground">{ data.Pull.AuthorName }</a>
										<span aria-hidden="true">·</span>
										<time datetime={ data.Pull.CreatedAt.UTC().Format("2006-01-02T15:04:05Z") }>{ data.Pull.CreatedAt.Format("Jan 2, 2006") }</time>
										<span aria-hidden="true">·</span>
										<span class="font-mono text-xs px-1.5 py-0.5 bg-muted border border-border rounded">{ data.Pull.HeadBranch }</span>
										<span aria-hidden="true">→</span>
										<span class="font-mono text-xs px-1.5 py-0.5 bg-muted border border-border rounded">{ data.Pull.BaseBranch }</span>
									</p>
								</div>
								@pullStateBadge(string(data.Pull.State))
							</div>

							<!-- Draft warning -->
							if data.Pull.State == "open" && data.Pull.IsDraft {
								<div role="status" class="mb-4 px-4 py-3 rounded-md border border-warning/40 bg-warning/10 flex items-center justify-between gap-4">
									<p class="text-sm text-warning">This pull request is still a work in progress. Merge is blocked until it is marked ready for review.</p>
									if data.CanWrite {
										@components.Button(components.ButtonSuccess, components.ButtonSizeSM, templ.Attributes{
											"hx-patch":  "/api/repos/" + data.Owner + "/" + data.RepoName + "/pulls/" + strconv.Itoa(data.Pull.Number),
											"hx-vals":   `{"is_draft":"false"}`,
											"hx-target": "#pull-detail",
											"hx-swap":   "outerHTML",
											"type":      "button",
										}) {
											Ready for review
										}
									}
								</div>
							}

							<!-- Labels -->
							if len(data.Labels) > 0 {
								<div class="flex flex-wrap gap-1.5 mb-4" aria-label="Labels">
									for _, l := range data.Labels {
										<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium border" style={ "background-color: " + l.Color + "33; color: " + l.Color + "; border-color: " + l.Color + "55" }>{ l.Name }</span>
									}
								</div>
							}

							<!-- Body markdown -->
							@components.MarkdownBody(data.BodyHTML)

							<!-- CI checks -->
							if len(data.HeadStatuses) > 0 {
								<section aria-labelledby="checks-heading" class="mt-4 rounded-md border border-border bg-muted/40 p-3 space-y-1.5">
									<h2 id="checks-heading" class="text-xs font-medium text-muted-foreground mb-1">Checks on <span class="font-mono">{ data.Pull.HeadBranch }</span></h2>
									for _, s := range data.HeadStatuses {
										<div class="flex items-center gap-2 text-sm">
											@checkStatusIcon(s.State)
											<span class="font-medium">{ s.Context }</span>
											if s.Description != "" {
												<span class="text-muted-foreground">— { s.Description }</span>
											}
											if s.TargetURL != "" {
												<a href={ templ.SafeURL(s.TargetURL) } class="ml-auto text-xs text-muted-foreground hover:text-foreground hover:underline">Details</a>
											}
										</div>
									}
								</section>
							}

							<!-- Action buttons -->
							if data.Pull.State == "open" {
								<div class="flex flex-wrap gap-2 items-center mt-5">
									if !data.Pull.IsDraft {
										if !data.CanMerge {
											<div role="status" class="w-full px-4 py-2 rounded-md border border-destructive/40 bg-destructive/10 text-sm text-destructive">
												Merge blocked: { data.MergeBlockReason }
											</div>
										}
										if data.CanMerge && data.Diff != nil {
											if data.Diff.CanFastForward {
												@components.Button(components.ButtonOutline, components.ButtonSizeDefault, templ.Attributes{
													"hx-patch":              "/api/repos/" + data.Owner + "/" + data.RepoName + "/pulls/" + strconv.Itoa(data.Pull.Number),
													"hx-vals":               `{"state":"merged","merge_strategy":"ff"}`,
													"hx-target":             "#pull-detail",
													"hx-swap":               "outerHTML",
													"hx-on--response-error": "alert('Merge failed. Please refresh and try again.')",
													"type":                  "button",
												}) {
													Merge (fast-forward)
												}
											}
											if data.Diff.CanFastForward || data.Diff.CanThreeWayMerge {
												@components.Button(components.ButtonOutline, components.ButtonSizeDefault, templ.Attributes{
													"hx-patch":              "/api/repos/" + data.Owner + "/" + data.RepoName + "/pulls/" + strconv.Itoa(data.Pull.Number),
													"hx-vals":               `{"state":"merged","merge_strategy":"merge"}`,
													"hx-target":             "#pull-detail",
													"hx-swap":               "outerHTML",
													"hx-on--response-error": "alert('Merge failed. Please refresh and try again.')",
													"type":                  "button",
												}) {
													Create merge commit
												}
												@components.Button(components.ButtonSuccess, components.ButtonSizeDefault, templ.Attributes{
													"hx-patch":              "/api/repos/" + data.Owner + "/" + data.RepoName + "/pulls/" + strconv.Itoa(data.Pull.Number),
													"hx-vals":               `{"state":"merged","merge_strategy":"squash"}`,
													"hx-target":             "#pull-detail",
													"hx-swap":               "outerHTML",
													"hx-on--response-error": "alert('Merge failed. Please refresh and try again.')",
													"type":                  "button",
												}) {
													Squash and merge
												}
											} else {
												<div role="status" class="w-full px-4 py-2 rounded-md border border-warning/40 bg-warning/10 text-sm text-warning">
													Cannot merge automatically — conflicting changes. Rebase the head branch onto
													<code class="font-mono text-xs mx-1">{ data.Pull.BaseBranch }</code> and push to enable merge.
												</div>
											}
										}
									}
									@components.Button(components.ButtonDestructive, components.ButtonSizeDefault, templ.Attributes{
										"hx-patch":  "/api/repos/" + data.Owner + "/" + data.RepoName + "/pulls/" + strconv.Itoa(data.Pull.Number),
										"hx-vals":   `{"state":"closed"}`,
										"hx-target": "#pull-detail",
										"hx-swap":   "outerHTML",
										"type":      "button",
									}) {
										Close PR
									}
								</div>
							}

							<!-- Diff -->
							if data.Diff != nil {
								<section aria-labelledby="diff-heading" class="mt-6 border-t border-border pt-5 space-y-4">
									<div class="flex items-center justify-between">
										<h2 id="diff-heading" class="text-sm font-medium">Changed files <span class="text-muted-foreground font-mono ml-1">({ strconv.Itoa(len(data.Diff.Files)) })</span></h2>
										<span class="text-xs font-mono">
											<span class="text-success">+{ strconv.Itoa(data.Diff.TotalAdded) }</span>
											<span class="text-destructive ml-2">−{ strconv.Itoa(data.Diff.TotalDeleted) }</span>
										</span>
									</div>
									for _, f := range data.Diff.Files {
										{{ filePath := f.NewPath }}
										if filePath == "" {
											{{ filePath = f.OldPath }}
										}
										<div class="rounded-md border border-border overflow-hidden">
											<div class="bg-muted/60 px-4 py-2 text-sm font-mono border-b border-border flex items-center gap-2">
												if f.IsNew {
													@components.Badge(components.BadgeSuccess) {
														added
													}
												} else if f.IsDelete {
													@components.Badge(components.BadgeDestructive) {
														deleted
													}
												}
												<span class="truncate">{ filePath }</span>
												<span class="ml-auto text-xs text-success">+{ strconv.Itoa(f.Added) }</span>
												<span class="text-xs text-destructive ml-1">−{ strconv.Itoa(f.Deleted) }</span>
											</div>
											if f.IsBinary {
												<div class="px-4 py-3 text-sm text-muted-foreground">Binary file</div>
											} else {
												<table class="w-full border-collapse">
													for _, hunk := range f.Hunks {
														<tr><td colspan="2" class="text-xs font-mono bg-muted px-4 py-1 text-muted-foreground border-b border-border">{ hunk.Header }</td></tr>
														for _, line := range hunk.Lines {
															{{ lineNum := line.NewNum }}
															if line.Type == "del" {
																{{ lineNum = line.OldNum }}
															} else if line.Type == "ctx" {
																{{ lineNum = line.OldNum }}
															}
															<tr class={ templ.KV("bg-success/10", line.Type == "add"), templ.KV("bg-destructive/10", line.Type == "del") }>
																<td class="w-10 text-right pr-2 text-muted-foreground select-none border-r border-border py-0.5 text-xs font-mono align-top">
																	if line.Type == "add" {
																		{ strconv.Itoa(line.NewNum) }
																	} else if line.Type == "del" {
																		{ strconv.Itoa(line.OldNum) }
																	} else {
																		{ strconv.Itoa(line.OldNum) }
																	}
																	if data.CanWrite && data.Pull.State == "open" && line.Type != "del" {
																		<span hx-get={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/pulls/" + strconv.Itoa(data.Pull.Number) + "/line_comments/form?path=" + filePath + "&line=" + strconv.Itoa(lineNum) } hx-target={ "#lc-form-" + filePath + "-" + strconv.Itoa(lineNum) } hx-swap="innerHTML" class="cursor-pointer text-muted-foreground/50 hover:text-ring select-none pl-0.5">+</span>
																	}
																</td>
																<td class={ "pl-3 py-0.5 whitespace-pre text-xs font-mono", templ.KV("text-success", line.Type == "add"), templ.KV("text-destructive", line.Type == "del"), templ.KV("text-foreground/85", line.Type != "add" && line.Type != "del") }>
																	if line.Type == "add" {
																		+{ line.Content }
																	} else if line.Type == "del" {
																		-{ line.Content }
																	} else {
																		{ " " }{ line.Content }
																	}
																</td>
															</tr>
															if line.Type != "del" {
																{{ key := fmt.Sprintf("%s:%d", filePath, lineNum) }}
																if comments, ok := data.LineComments[key]; ok && len(comments) > 0 {
																	<tr id={ "lc-" + filePath + "-" + strconv.Itoa(lineNum) } class="bg-muted/40 border-t border-border">
																		<td colspan="2" class="px-4 py-0">
																			for _, lc := range comments {
																				<div class="flex items-start gap-2 py-2 border-b border-border last:border-0">
																					@components.Avatar(lc.AuthorName, components.AvatarSizeSM, lc.AuthorName)
																					<div class="flex-1 min-w-0">
																						<div class="flex items-center gap-2">
																							<a href={ templ.SafeURL("/" + lc.AuthorName) } class="text-xs font-semibold hover:underline">{ lc.AuthorName }</a>
																							<time class="text-xs text-muted-foreground" datetime={ lc.CreatedAt.UTC().Format("2006-01-02T15:04:05Z") }>{ lc.CreatedAt.Format("Jan 2, 2006") }</time>
																						</div>
																						<div class="text-xs text-foreground/85 mt-0.5">@templ.Raw(lc.BodyHTML)</div>
																						if lc.IsSuggestion {
																							<div class="mt-2 rounded-md border border-success/30 bg-success/10 text-xs font-mono overflow-x-auto">
																								<div class="px-3 py-1 text-success font-medium border-b border-success/20">Suggested change</div>
																								<pre class="px-3 py-2 whitespace-pre-wrap">{ lc.SuggestionBody }</pre>
																								if data.CanWrite && data.Pull.State == "open" {
																									<form hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/pulls/" + strconv.Itoa(data.Pull.Number) + "/line_comments/" + strconv.FormatInt(lc.ID, 10) + "/apply" } hx-on--after-request="window.location.reload()" class="px-3 py-2 border-t border-success/20">
																										@components.Button(components.ButtonSuccess, components.ButtonSizeSM, templ.Attributes{"type": "submit"}) {
																											Apply suggestion
																										}
																									</form>
																								}
																							</div>
																						}
																					</div>
																					if data.CanWrite {
																						<button type="button" hx-delete={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/pulls/" + strconv.Itoa(data.Pull.Number) + "/line_comments/" + strconv.FormatInt(lc.ID, 10) } hx-target={ "#lc-" + filePath + "-" + strconv.Itoa(lineNum) } hx-swap="outerHTML" class="text-muted-foreground/50 hover:text-destructive text-xs shrink-0" aria-label="Delete comment">×</button>
																					}
																				</div>
																			}
																			<div id={ "lc-form-" + filePath + "-" + strconv.Itoa(lineNum) }></div>
																		</td>
																	</tr>
																} else {
																	<tr><td colspan="2"><div id={ "lc-form-" + filePath + "-" + strconv.Itoa(lineNum) }></div></td></tr>
																}
															}
														}
													}
												</table>
											}
										</div>
									}
								</section>
							}
						</div>
					</article>

					<!-- Reviews -->
					<section id="pr-reviews" class="rounded-md border border-border bg-card p-6" aria-labelledby="reviews-heading">
						<h2 id="reviews-heading" class="text-lg font-semibold mb-4">Reviews</h2>
						if len(data.Reviews) > 0 {
							for _, rev := range data.Reviews {
								<div class="flex items-start gap-3 mb-4 pb-4 border-b border-border last:border-0 last:mb-0 last:pb-0">
									@components.Avatar(rev.AuthorName, components.AvatarSizeDefault, rev.AuthorName)
									<div class="flex-1 min-w-0">
										<div class="flex items-center gap-2 flex-wrap">
											<a href={ templ.SafeURL("/" + rev.AuthorName) } class="text-sm font-semibold hover:underline">{ rev.AuthorName }</a>
											@reviewStateBadge(string(rev.State))
										</div>
										if rev.Body != "" {
											<p class="text-sm text-foreground/85 mt-1">{ rev.Body }</p>
										}
									</div>
								</div>
							}
						} else {
							<p class="text-sm text-muted-foreground">No reviews yet.</p>
						}
						if data.CanWrite && data.Pull.State == "open" && !data.Pull.IsDraft {
							<form hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/pulls/" + strconv.Itoa(data.Pull.Number) + "/reviews" } hx-target="#pr-reviews" hx-swap="outerHTML" class="mt-4 border-t border-border pt-4 space-y-3">
								<h3 class="text-sm font-medium">Submit a review</h3>
								<label for="review-body" class="sr-only">Review body</label>
								@components.Textarea(templ.Attributes{
									"id":          "review-body",
									"name":        "body",
									"rows":        "3",
									"placeholder": "Leave a comment (optional)",
								})
								<fieldset class="flex flex-wrap gap-4 text-sm">
									<legend class="sr-only">Review type</legend>
									<label class="flex items-center gap-2 cursor-pointer">
										<input type="radio" name="state" value="commented" checked class="accent-muted-foreground"/>
										<span>Comment</span>
									</label>
									<label class="flex items-center gap-2 cursor-pointer">
										<input type="radio" name="state" value="approved" class="accent-success"/>
										<span class="text-success">Approve</span>
									</label>
									<label class="flex items-center gap-2 cursor-pointer">
										<input type="radio" name="state" value="changes_requested" class="accent-destructive"/>
										<span class="text-destructive">Request changes</span>
									</label>
								</fieldset>
								@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
									Submit review
								}
							</form>
						}
					</section>
				</div>

				<!-- Sidebar -->
				<aside class="w-64 shrink-0 space-y-4" aria-label="Pull request metadata">
					<div class="rounded-md border border-border bg-card p-4">
						@components.LabelSidebar(data.Owner, data.RepoName, data.Pull.Number, "pulls", data.Labels, data.AllLabels, data.CanWrite)
					</div>
					<div class="rounded-md border border-border bg-card p-4">
						<div id="issue-milestone">
							<h3 class="text-xs font-semibold text-muted-foreground uppercase tracking-wide mb-2">Milestone</h3>
							if data.Milestone != nil {
								<div class="text-sm">
									<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/milestones") } class="font-medium hover:underline">{ data.Milestone.Title }</a>
									if (data.Milestone.OpenCount + data.Milestone.ClosedCount) > 0 {
										{{ total := data.Milestone.OpenCount + data.Milestone.ClosedCount }}
										{{ pct := 0 }}
										if total > 0 {
											{{ pct = data.Milestone.ClosedCount * 100 / total }}
										}
										<div class="mt-1.5" role="progressbar" aria-valuenow={ strconv.Itoa(pct) } aria-valuemin="0" aria-valuemax="100" aria-label={ "Milestone progress: " + strconv.Itoa(pct) + "%" }>
											<div class="w-full bg-muted h-1.5 rounded-full overflow-hidden">
												<div class="bg-success h-full" style={ "width: " + strconv.Itoa(pct) + "%" }></div>
											</div>
											<p class="text-xs text-muted-foreground mt-1 font-mono">{ strconv.Itoa(data.Milestone.ClosedCount) }/{ strconv.Itoa(total) } closed</p>
										</div>
									}
								</div>
							} else {
								<span class="text-xs text-muted-foreground">No milestone</span>
							}
							if data.CanWrite && len(data.AllMilestones) > 0 {
								<details class="mt-2">
									<summary class="text-xs text-muted-foreground hover:text-foreground cursor-pointer">
										if data.Milestone != nil {
											Change
										} else {
											Set milestone
										}
									</summary>
									<div class="mt-1 space-y-1 max-h-40 overflow-y-auto border border-border rounded-md">
										<form hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/pulls/" + strconv.Itoa(data.Pull.Number) + "/milestone" } hx-target="#issue-milestone" hx-swap="outerHTML" class="p-1">
											<button type="submit" name="milestone_id" value="" class="w-full text-left px-2 py-1 hover:bg-accent rounded text-xs text-muted-foreground">
												No milestone
											</button>
											for _, m := range data.AllMilestones {
												<button type="submit" name="milestone_id" value={ strconv.FormatInt(m.ID, 10) } class={ "w-full text-left flex items-center gap-2 px-2 py-1 hover:bg-accent rounded text-xs", templ.KV("font-semibold text-foreground", data.Milestone != nil && data.Milestone.ID == m.ID) }>
													<span class={ "w-2 h-2 rounded-full inline-block shrink-0", templ.KV("bg-muted-foreground", m.State == "closed"), templ.KV("bg-success", m.State != "closed") }></span>
													{ m.Title }
												</button>
											}
										</form>
									</div>
								</details>
							}
						</div>
					</div>
					<div class="rounded-md border border-border bg-card p-4">
						@components.AssigneeSidebar(data.Owner, data.RepoName, data.Pull.Number, "pulls", data.Assignees, data.CanWrite)
					</div>
				</aside>
			</div>
		</div>
	}
}

// pullStateBadge renders the open/merged/closed status with the right Badge variant.
templ pullStateBadge(state string) {
	switch state {
	case "open":
		@components.Badge(components.BadgeSuccess) {
			Open
		}
	case "merged":
		@components.Badge(components.BadgeMerged) {
			Merged
		}
	default:
		@components.Badge(components.BadgeDestructive) {
			Closed
		}
	}
}

// reviewStateBadge renders the review state with the right Badge variant + label.
templ reviewStateBadge(state string) {
	switch state {
	case "approved":
		@components.Badge(components.BadgeSuccess) {
			Approved
		}
	case "changes_requested":
		@components.Badge(components.BadgeDestructive) {
			Changes requested
		}
	default:
		@components.Badge(components.BadgeSecondary) {
			Commented
		}
	}
}

// checkStatusIcon renders a small status indicator for a CI check.
templ checkStatusIcon(state model.CommitStatusState) {
	switch state {
	case model.CommitStatusSuccess:
		<span class="text-success" aria-label="Success">✓</span>
	case model.CommitStatusFailure:
		<span class="text-destructive" aria-label="Failure">✗</span>
	case model.CommitStatusError:
		<span class="text-destructive" aria-label="Error">⚠</span>
	default:
		<span class="text-warning" aria-label="Pending">●</span>
	}
}
