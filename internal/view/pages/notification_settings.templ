package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ NotificationSettings(data view.NotificationSettingsData) {
	@layout.Base(data.BasePage, "Notification Settings — Cloudzilla") {
		<div class="max-w-2xl mx-auto py-8 px-4">
			<h1 class="text-2xl font-semibold tracking-tight mb-6">Notification Settings</h1>
			@components.Card(nil) {
				@components.CardContent() {
					<form method="POST" action="/settings/notifications" class="space-y-6">
						<div class="flex items-center gap-3">
							if data.EmailNotifications {
								<input type="checkbox" id="email_notifications" name="email_notifications" checked class="h-4 w-4 rounded border-input accent-foreground"/>
							} else {
								<input type="checkbox" id="email_notifications" name="email_notifications" class="h-4 w-4 rounded border-input accent-foreground"/>
							}
							<label for="email_notifications" class="text-sm font-medium text-foreground">Enable email notifications</label>
						</div>
						<div class="space-y-1.5">
							<label for="email_digest" class="block text-sm font-medium text-foreground">Email digest frequency</label>
							<select id="email_digest" name="email_digest" class="flex h-9 w-48 rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm">
								if data.EmailDigest == "immediate" {
									<option value="immediate" selected>Immediate</option>
								} else {
									<option value="immediate">Immediate</option>
								}
								if data.EmailDigest == "daily" {
									<option value="daily" selected>Daily digest</option>
								} else {
									<option value="daily">Daily digest</option>
								}
								if data.EmailDigest == "weekly" {
									<option value="weekly" selected>Weekly digest</option>
								} else {
									<option value="weekly">Weekly digest</option>
								}
								if data.EmailDigest == "never" {
									<option value="never" selected>Never</option>
								} else {
									<option value="never">Never</option>
								}
							</select>
						</div>
						@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
							Save preferences
						}
					</form>
				}
			}
		</div>
	}
}
