package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ NotificationSettings(data view.NotificationSettingsData) {
	@layout.Base(data.BasePage, "Notification settings — Cloudzilla") {
		<div class="max-w-2xl mx-auto space-y-6">

			<section aria-labelledby="ns-title">
				<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">
					<a href="/settings" class="hover:underline">Settings</a>
					<span aria-hidden="true">·</span>
					Notifications
				</p>
				<h1 id="ns-title" class="text-2xl font-semibold tracking-tight">Notification preferences</h1>
				<p class="mt-1 text-[13px] text-muted-foreground">Choose how Cloudzilla reaches you about issues, pull requests, and other repo activity.</p>
			</section>

			<form method="POST" action="/settings/notifications" class="space-y-5 rounded-md border border-border bg-card p-6">
				<label class="flex items-center gap-3 cursor-pointer">
					if data.EmailNotifications {
						@components.Checkbox(templ.Attributes{"id": "email_notifications", "name": "email_notifications", "checked": "checked"})
					} else {
						@components.Checkbox(templ.Attributes{"id": "email_notifications", "name": "email_notifications"})
					}
					<span class="text-sm">
						<span class="font-medium block">Email notifications</span>
						<span class="text-muted-foreground text-[12px]">Send email when something happens that needs your attention.</span>
					</span>
				</label>

				<div class="space-y-1.5">
					<label for="email_digest" class="block text-sm font-medium">Email digest frequency</label>
					<select id="email_digest" name="email_digest" class="flex h-9 w-56 rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm">
						<option value="immediate" selected?={ data.EmailDigest == "immediate" }>Immediate</option>
						<option value="daily" selected?={ data.EmailDigest == "daily" }>Daily digest</option>
						<option value="weekly" selected?={ data.EmailDigest == "weekly" }>Weekly digest</option>
						<option value="never" selected?={ data.EmailDigest == "never" }>Never</option>
					</select>
					<p class="text-[11px] text-muted-foreground">Digests batch notifications into a single email at the chosen cadence.</p>
				</div>

				<div class="pt-2">
					@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
						Save preferences
					}
				</div>
			</form>
		</div>
	}
}
