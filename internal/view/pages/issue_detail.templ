package pages

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/model"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/fragments"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ IssueDetail(data view.IssueDetailData) {
	@layout.Base(data.BasePage, data.Issue.Title+" · Issue #"+strconv.Itoa(data.Issue.Number)+" · "+data.Owner+"/"+data.RepoName) {
		<div class="space-y-6">

			<section aria-labelledby="issue-heading">
				<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="hover:underline">{ data.RepoName }</a>
					<span aria-hidden="true">·</span>
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/issues") } class="hover:underline">Issues</a>
				</p>
				<div class="flex flex-wrap items-start justify-between gap-3 mb-3">
					<h1 id="issue-heading" class="text-2xl font-semibold tracking-tight flex items-center gap-2 flex-wrap min-w-0">
						{ data.Issue.Title }
						<span class="text-muted-foreground font-normal" aria-label={ "Issue number " + strconv.Itoa(data.Issue.Number) }>#{ strconv.Itoa(data.Issue.Number) }</span>
						if data.Issue.Visibility == "private" {
							@components.Badge(components.BadgeDestructive) {
								Private
							}
						}
					</h1>
					if data.BasePage.CurrentUser != nil {
						<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/issues/new") } class="h-8 px-3 text-[13px] rounded-md border border-border bg-card hover:bg-muted/50 inline-flex items-center shrink-0">New issue</a>
					}
				</div>
				<div class="flex flex-wrap items-center gap-3">
					@components.IssueStateBadge(string(data.Issue.State))
					if data.Issue.IsLocked {
						@components.Badge(components.BadgeSecondary) {
							Locked
						}
					}
					<p class="text-[13px] text-muted-foreground">
						<a href={ templ.SafeURL("/" + data.Issue.AuthorName) } class="font-medium text-foreground hover:underline">{ data.Issue.AuthorName }</a>
						{ " opened this issue " }
						<time datetime={ data.Issue.CreatedAt.UTC().Format(time.RFC3339) }>{ data.Issue.CreatedAt.Format("Jan 2, 2006") }</time>
						{ " · " + strconv.Itoa(len(data.Comments)) }
						if len(data.Comments) == 1 {
							{ " comment" }
						} else {
							{ " comments" }
						}
					</p>
				</div>
			</section>

			<div class="grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-8">

				<article class="space-y-5 min-w-0">

					<section id="issue-detail" class="rounded-md border border-border bg-card overflow-hidden" aria-label="Issue body">
						<header class="px-4 py-2.5 border-b border-border bg-muted/40 flex items-center gap-2 text-[12.5px]">
							@components.Avatar(data.Issue.AuthorName, components.AvatarSizeSM, data.Issue.AuthorName)
							<strong class="text-foreground">{ data.Issue.AuthorName }</strong>
							<span class="text-muted-foreground">opened</span>
							<time class="text-muted-foreground ml-auto text-xs" datetime={ data.Issue.CreatedAt.UTC().Format(time.RFC3339) }>{ data.Issue.CreatedAt.Format("Jan 2, 2006") }</time>
						</header>
						if len(data.Labels) > 0 {
							<div class="flex flex-wrap gap-1.5 px-4 pt-3" aria-label="Labels">
								for _, l := range data.Labels {
									<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium border" style={ "background-color: " + l.Color + "33; color: " + l.Color + "; border-color: " + l.Color + "55" }>{ l.Name }</span>
								}
							</div>
						}
						<div class="px-4 py-4">
							@components.MarkdownBody(data.BodyHTML)
						</div>
						<div class="px-4 pb-4 flex flex-wrap gap-2">
							if data.Issue.State == "open" {
								@components.Button(components.ButtonDestructive, components.ButtonSizeDefault, templ.Attributes{
									"hx-patch":  "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number),
									"hx-vals":   `{"state":"closed"}`,
									"hx-target": "#issue-detail",
									"hx-swap":   "outerHTML",
									"type":      "button",
								}) {
									Close issue
								}
							} else {
								@components.Button(components.ButtonSuccess, components.ButtonSizeDefault, templ.Attributes{
									"hx-patch":  "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number),
									"hx-vals":   `{"state":"open"}`,
									"hx-target": "#issue-detail",
									"hx-swap":   "outerHTML",
									"type":      "button",
								}) {
									Reopen issue
								}
							}
							if data.CanManage {
								if data.Issue.IsPinned {
									@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{
										"hx-patch": "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number) + "/pin",
										"hx-vals":  `{"action":"unpin"}`,
										"hx-swap":  "none",
										"type":     "button",
									}) {
										Unpin
									}
								} else {
									@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{
										"hx-patch": "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number) + "/pin",
										"hx-vals":  `{"action":"pin"}`,
										"hx-swap":  "none",
										"type":     "button",
									}) {
										Pin
									}
								}
								if data.Issue.IsLocked {
									@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{
										"hx-patch": "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number) + "/lock",
										"hx-vals":  `{"action":"unlock"}`,
										"hx-swap":  "none",
										"type":     "button",
									}) {
										Unlock
									}
								} else {
									@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{
										"hx-patch": "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number) + "/lock",
										"hx-vals":  `{"action":"lock"}`,
										"hx-swap":  "none",
										"type":     "button",
									}) {
										Lock
									}
								}
							}
						</div>
					</section>

					<ol id="comments" class="cz-timeline space-y-4" aria-label="Issue activity">
						for _, c := range data.Comments {
							@components.TimelineEntry(components.TimelineEntryComment, c.AuthorName, c.CreatedAt.Format("Jan 2, 2006 at 3:04 PM")) {
								<div class="rounded-md border border-border bg-card overflow-hidden">
									<header class="px-4 py-2 border-b border-border bg-muted/40 flex items-center gap-2 text-xs text-muted-foreground">
										<time datetime={ c.CreatedAt.UTC().Format(time.RFC3339) }>{ c.CreatedAt.Format("Jan 2, 2006 at 3:04 PM") }</time>
									</header>
									<div class="px-4 py-3">
										@components.MarkdownBody(c.BodyHTML)
									</div>
									<div id={ "reactions-" + strconv.FormatInt(c.ID, 10) } hx-get={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/comments/" + strconv.FormatInt(c.ID, 10) + "/reactions" } hx-trigger="load" hx-swap="outerHTML" class="px-4 pb-2"></div>
								</div>
							}
						}
					</ol>

					<div>
						if !data.Issue.IsLocked || data.CanManage {
							if data.BasePage.CurrentUser != nil {
								<form class="rounded-md border border-border bg-card p-4 space-y-3">
									<div class="flex justify-end">
										@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{
											"type":      "button",
											"hx-get":    "/api/user/replies",
											"hx-target": "#saved-replies-picker-container",
											"hx-swap":   "outerHTML",
										}) {
											Saved replies
										}
									</div>
									<div id="saved-replies-picker-container"></div>
									<label for="comment-body" class="sr-only">Add a comment</label>
									@components.Textarea(templ.Attributes{
										"id":          "comment-body",
										"name":        "body",
										"rows":        "6",
										"placeholder": "Add a comment…",
										"class":       "w-full min-h-28 font-mono",
									})
									<div class="flex justify-end gap-2">
										if data.Issue.State == "open" {
											@components.Button(components.ButtonOutline, components.ButtonSizeDefault, templ.Attributes{
												"hx-patch":  "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number),
												"hx-vals":   `{"state":"closed"}`,
												"hx-target": "#issue-detail",
												"hx-swap":   "outerHTML",
												"type":      "button",
											}) {
												Close issue
											}
										}
										@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{
											"hx-post":    "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number) + "/comments",
											"hx-include": "#comment-body",
											"hx-swap":    "beforeend",
											"hx-target":  "#comments",
											"type":       "button",
										}) {
											Comment
										}
									</div>
								</form>
								<script>
								document.addEventListener('click', function(e) {
								  var btn = e.target.closest('[data-saved-reply-body]');
								  if (btn) {
								    var ta = document.getElementById('comment-body');
								    if (ta) { ta.value = btn.dataset.savedReplyBody; }
								    var container = document.getElementById('saved-replies-picker-container');
								    if (container) { container.replaceChildren(); }
								  }
								});
								</script>
							}
						}
						if data.Issue.IsLocked && !data.CanManage {
							<div class="rounded-md border border-border bg-muted p-4 text-center text-sm text-muted-foreground">
								This issue is locked. Only maintainers can comment.
							</div>
						}
					</div>

				</article>

				<aside class="space-y-6 text-[12.5px]" aria-label="Issue metadata" x-data="{ open: null }" x-on:keydown.escape.window="open = null">

					<section class="rounded-md border border-border bg-card p-4">
						@components.AssigneeSidebar(data.Owner, data.RepoName, data.Issue.Number, "issues", data.Assignees, data.Collaborators, data.CanWrite)
					</section>

					<section class="rounded-md border border-border bg-card p-4">
						@components.LabelSidebar(data.Owner, data.RepoName, data.Issue.Number, "issues", data.Labels, data.AllLabels, data.CanWrite)
					</section>

					<section class="rounded-md border border-border bg-card p-4">
						@fragments.MilestoneSidebar(view.MilestoneSidebarFragData{
							Owner:         data.Owner,
							RepoName:      data.RepoName,
							ItemNumber:    data.Issue.Number,
							IsPull:        false,
							Current:       data.Milestone,
							AllMilestones: data.AllMilestones,
							CanWrite:      data.CanWrite,
						})
					</section>

					<section class="rounded-md border border-border bg-card p-4">
						<h3 class="font-mono text-[10px] text-muted-foreground uppercase tracking-wider mb-2">Linked pull requests</h3>
						if len(data.LinkedPRs) > 0 {
							<div class="space-y-1.5">
								for _, pr := range data.LinkedPRs {
									<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/pulls/" + strconv.Itoa(pr.Number)) } class="flex items-center gap-2 text-muted-foreground hover:text-foreground group">
										@linkedPRIcon(pr.State)
										<span class="font-mono text-[11px] shrink-0">#{ strconv.Itoa(pr.Number) }</span>
										<span class="truncate text-[12.5px]">{ pr.Title }</span>
									</a>
								}
							</div>
						} else {
							<p class="text-xs text-muted-foreground">No linked PRs yet.</p>
						}
					</section>

				</aside>

			</div>
		</div>
	}
}

templ linkedPRIcon(state model.PRState) {
	switch state {
	case model.PRStateMerged:
		<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-[hsl(270_70%_70%)]" aria-hidden="true"><circle cx="18" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><path d="M6 21V9a9 9 0 009 9"></path></svg>
	case model.PRStateClosed:
		<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-destructive" aria-hidden="true"><circle cx="18" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><path d="M6 21V9a9 9 0 009 9"></path></svg>
	default:
		<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-success" aria-hidden="true"><circle cx="18" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><path d="M6 21V9a9 9 0 009 9"></path></svg>
	}
}
