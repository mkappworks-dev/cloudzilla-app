package pages

import (
	"strconv"

	"github.com/mkappworks/cloudzilla/internal/view"
	"github.com/mkappworks/cloudzilla/internal/view/layout"
)

templ IssueDetail(data view.IssueDetailData) {
	@layout.Base(data.BasePage, data.Issue.Title+" · Issue #"+strconv.Itoa(data.Issue.Number)+" · "+data.Owner+"/"+data.RepoName) {
		<div class="space-y-6">
			<div class="mb-4">
				<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/issues") } class="text-blue-600 hover:underline text-sm">&larr; Back to Issues</a>
			</div>
			<div class="flex gap-6">
				<!-- Main content -->
				<div class="flex-1 min-w-0 space-y-6">
					<div id="issue-detail" class="bg-white border border-gray-200 rounded-lg p-6">
						<div class="flex justify-between items-start mb-4">
							<div>
								<h1 class="text-3xl font-bold">{ data.Issue.Title }</h1>
								<p class="text-gray-600 text-sm mt-2">#{ strconv.Itoa(data.Issue.Number) } opened by { data.Issue.AuthorName } on { data.Issue.CreatedAt.Format("Jan 2, 2006") }</p>
							</div>
							<div class="flex items-center gap-2">
								<span class={ "px-3 py-1 rounded-full text-sm font-medium", templ.KV("bg-green-100 text-green-700", data.Issue.State == "open"), templ.KV("bg-red-100 text-red-700", data.Issue.State != "open") }>
									{ string(data.Issue.State) }
								</span>
								if data.Issue.IsLocked {
									<span class="px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-600">Locked</span>
								}
							</div>
						</div>
						if len(data.Labels) > 0 {
							<div class="flex flex-wrap gap-1 mb-3">
								for _, l := range data.Labels {
									<span class="px-2 py-0.5 rounded-full text-xs font-medium" style={ "background-color: " + l.Color }>{ l.Name }</span>
								}
							</div>
						}
						<div class="prose prose-sm max-w-none bg-gray-50 p-4 rounded border border-gray-200 my-4">
							@templ.Raw(data.BodyHTML)
						</div>
						if data.Issue.State == "open" {
							<button hx-patch={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number) } hx-vals='{"state":"closed"}' hx-target="#issue-detail" hx-swap="outerHTML" class="px-4 py-2 bg-red-600 text-white rounded font-medium hover:bg-red-700 transition-colors">
								Close Issue
							</button>
						} else {
							<button hx-patch={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number) } hx-vals='{"state":"open"}' hx-target="#issue-detail" hx-swap="outerHTML" class="px-4 py-2 bg-green-600 text-white rounded font-medium hover:bg-green-700 transition-colors">
								Re-open Issue
							</button>
						}
						if data.CanManage {
							<div class="flex gap-2 mt-3">
								if data.Issue.IsPinned {
									<button hx-patch={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number) + "/pin" } hx-vals='{"action":"unpin"}' hx-swap="none" class="px-3 py-1.5 text-sm bg-yellow-100 text-yellow-800 border border-yellow-300 rounded hover:bg-yellow-200 transition-colors">
										Unpin
									</button>
								} else {
									<button hx-patch={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number) + "/pin" } hx-vals='{"action":"pin"}' hx-swap="none" class="px-3 py-1.5 text-sm bg-gray-100 text-gray-700 border border-gray-300 rounded hover:bg-gray-200 transition-colors">
										Pin
									</button>
								}
								if data.Issue.IsLocked {
									<button hx-patch={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number) + "/lock" } hx-vals='{"action":"unlock"}' hx-swap="none" class="px-3 py-1.5 text-sm bg-gray-100 text-gray-700 border border-gray-300 rounded hover:bg-gray-200 transition-colors">
										Unlock
									</button>
								} else {
									<button hx-patch={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number) + "/lock" } hx-vals='{"action":"lock"}' hx-swap="none" class="px-3 py-1.5 text-sm bg-gray-100 text-gray-700 border border-gray-300 rounded hover:bg-gray-200 transition-colors">
										Lock
									</button>
								}
							</div>
						}
					</div>
					<div class="mt-8">
						<h2 class="text-2xl font-bold mb-4">Comments</h2>
						<div id="comments" class="space-y-3 mb-6">
							for _, c := range data.Comments {
								<div class="bg-white border border-gray-200 rounded-lg p-4">
									<div class="font-semibold text-sm text-gray-700">{ c.AuthorName }</div>
									<div class="text-xs text-gray-500 mb-2">{ c.CreatedAt.Format("Jan 2, 2006 at 3:04 PM") }</div>
									<div class="prose prose-sm max-w-none text-gray-800">@templ.Raw(c.BodyHTML)</div>
									<div id={ "reactions-" + strconv.FormatInt(c.ID, 10) } hx-get={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/comments/" + strconv.FormatInt(c.ID, 10) + "/reactions" } hx-trigger="load" hx-swap="outerHTML" class="mt-2"></div>
								</div>
							}
						</div>
						if !data.Issue.IsLocked || data.CanManage {
							if data.BasePage.CurrentUser != nil {
								<form class="bg-white border border-gray-200 rounded-lg p-4">
									<textarea name="body" placeholder="Add a comment..." class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 resize-vertical min-h-24"></textarea>
									<button hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number) + "/comments" } hx-swap="beforeend" hx-target="#comments" class="mt-2 px-4 py-2 bg-blue-600 text-white rounded font-medium hover:bg-blue-700 transition-colors">
										Comment
									</button>
								</form>
							}
						}
						if data.Issue.IsLocked && !data.CanManage {
							<div class="bg-gray-50 border border-gray-200 rounded-lg p-4 text-center text-sm text-gray-500">
								This issue is locked. Only maintainers can comment.
							</div>
						}
					</div>
				</div>
				<!-- Sidebar -->
				<div class="w-56 shrink-0 space-y-4">
					<div class="bg-white border border-gray-200 rounded-lg p-4">
						<div id="issue-labels">
							<h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Labels</h3>
							<div class="flex flex-wrap gap-1">
								if len(data.Labels) > 0 {
									for _, l := range data.Labels {
										<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium" style={ "background-color: " + l.Color }>
											{ l.Name }
											if data.CanWrite {
												<button hx-delete={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number) + "/labels/" + strconv.FormatInt(l.ID, 10) } hx-target="#issue-labels" hx-swap="outerHTML" class="ml-0.5 hover:opacity-70 font-bold leading-none">&times;</button>
											}
										</span>
									}
								} else {
									<span class="text-xs text-gray-400">None yet</span>
								}
							</div>
							if data.CanWrite && len(data.AllLabels) > 0 {
								<details class="mt-2">
									<summary class="text-xs text-blue-600 cursor-pointer hover:underline">Add label</summary>
									<div class="mt-1 space-y-1 max-h-40 overflow-y-auto border border-gray-100 rounded">
										for _, l := range data.AllLabels {
											<button hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number) + "/labels/" + strconv.FormatInt(l.ID, 10) } hx-target="#issue-labels" hx-swap="outerHTML" class="w-full text-left flex items-center gap-2 px-2 py-1 hover:bg-gray-50 text-xs">
												<span class="w-3 h-3 rounded-full inline-block shrink-0" style={ "background-color: " + l.Color }></span>
												{ l.Name }
											</button>
										}
									</div>
								</details>
							}
						</div>
					</div>
					<div class="bg-white border border-gray-200 rounded-lg p-4">
						<div id="issue-assignees">
							<h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Assignees</h3>
							<div class="space-y-1">
								if len(data.Assignees) > 0 {
									for _, u := range data.Assignees {
										<div class="flex items-center justify-between">
											<a href={ templ.SafeURL("/" + u.Username) } class="text-xs font-medium hover:underline">{ u.Username }</a>
											if data.CanWrite {
												<button hx-delete={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number) + "/assignees?username=" + u.Username } hx-target="#issue-assignees" hx-swap="outerHTML" class="text-xs text-red-500 hover:underline ml-2">&times;</button>
											}
										</div>
									}
								} else {
									<span class="text-xs text-gray-400">No one assigned</span>
								}
							</div>
							if data.CanWrite {
								<form hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number) + "/assignees" } hx-target="#issue-assignees" hx-swap="outerHTML" class="mt-2 flex gap-1">
									<input type="text" name="username" placeholder="Username" required class="flex-1 border border-gray-300 rounded px-2 py-1 text-xs focus:outline-none focus:ring-1 focus:ring-blue-400 min-w-0"/>
									<button type="submit" class="px-2 py-1 bg-blue-600 text-white rounded text-xs hover:bg-blue-700 shrink-0">+</button>
								</form>
							}
						</div>
					</div>
					<div class="bg-white border border-gray-200 rounded-lg p-4">
						<div id="issue-milestone">
							<h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Milestone</h3>
							if data.Milestone != nil {
								<div class="text-sm">
									<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/milestones") } class="font-medium text-gray-800 hover:underline">{ data.Milestone.Title }</a>
									if (data.Milestone.OpenCount + data.Milestone.ClosedCount) > 0 {
										<div class="mt-1">
											<div class="w-full bg-gray-200 rounded-full h-1">
												<div class="bg-green-500 h-1 rounded-full" style={ "width: " + strconv.Itoa(func() int { total := data.Milestone.OpenCount + data.Milestone.ClosedCount; if total == 0 { return 0 }; return data.Milestone.ClosedCount * 100 / total }()) + "%" }></div>
											</div>
											<p class="text-xs text-gray-400 mt-0.5">{ strconv.Itoa(data.Milestone.ClosedCount) }/{ strconv.Itoa(data.Milestone.OpenCount + data.Milestone.ClosedCount) } closed</p>
										</div>
									}
								</div>
							} else {
								<span class="text-xs text-gray-400">No milestone</span>
							}
							if data.CanWrite && len(data.AllMilestones) > 0 {
								<details class="mt-2">
									<summary class="text-xs text-blue-600 cursor-pointer hover:underline">
										if data.Milestone != nil {
											Change
										} else {
											Set milestone
										}
									</summary>
									<div class="mt-1 space-y-1 max-h-40 overflow-y-auto border border-gray-100 rounded">
										<form hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number) + "/milestone" } hx-target="#issue-milestone" hx-swap="outerHTML" class="p-1">
											<button type="submit" name="milestone_id" value="" class="w-full text-left px-2 py-1 hover:bg-gray-50 text-xs text-gray-500">
												No milestone
											</button>
											for _, m := range data.AllMilestones {
												<button type="submit" name="milestone_id" value={ strconv.FormatInt(m.ID, 10) } class={ "w-full text-left flex items-center gap-2 px-2 py-1 hover:bg-gray-50 text-xs", templ.KV("font-semibold text-blue-600", data.Milestone != nil && data.Milestone.ID == m.ID) }>
													<span class={ "w-2 h-2 rounded-full inline-block shrink-0", templ.KV("bg-gray-400", m.State == "closed"), templ.KV("bg-green-500", m.State != "closed") }></span>
													{ m.Title }
												</button>
											}
										</form>
									</div>
								</details>
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	}
}
