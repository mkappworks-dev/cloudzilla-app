package pages

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/fragments"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ IssueDetail(data view.IssueDetailData) {
	@layout.Base(data.BasePage, data.Issue.Title+" · Issue #"+strconv.Itoa(data.Issue.Number)+" · "+data.Owner+"/"+data.RepoName) {
		<div class="space-y-6">

			<section aria-labelledby="issue-heading" class="border-b border-border pb-6">
				<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="hover:underline">{ data.RepoName }</a>
					<span aria-hidden="true">·</span>
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/issues") } class="hover:underline">Issues</a>
					<span aria-hidden="true">·</span>
					<span aria-current="page">#{ strconv.Itoa(data.Issue.Number) }</span>
				</p>
				<div class="mb-3">
					@fragments.IssueTitleSection(data.Owner, data.RepoName, data.Issue.Number, data.Issue.Title, data.CanWrite, false)
				</div>
				<div class="flex flex-wrap items-center gap-3">
					@components.IssueStateBadge(string(data.Issue.State))
					@issueLockedBadge(data.Issue.IsLocked, false)
					if data.Issue.Visibility == "private" {
						@components.Badge(components.BadgeDestructive) {
							Private
						}
					}
					<p class="text-[13px] text-muted-foreground">
						<a href={ templ.SafeURL("/" + data.Issue.AuthorName) } class="font-medium text-foreground hover:underline">{ data.Issue.AuthorName }</a>
						{ " opened this issue " }
						<time datetime={ data.Issue.CreatedAt.UTC().Format(time.RFC3339) }>{ data.Issue.CreatedAt.Format("Jan 2, 2006") }</time>
						<span id="issue-comment-count" data-count={ strconv.Itoa(len(data.Comments)) }>
							{ " · " + strconv.Itoa(len(data.Comments)) }
							if len(data.Comments) == 1 {
								{ " comment" }
							} else {
								{ " comments" }
							}
						</span>
					</p>
				</div>
			</section>

			<div class="grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-8">

				<article class="space-y-5 min-w-0">

					@fragments.IssueBodyCard(view.IssueBodyCardData{
						Owner:       data.Owner,
						RepoName:    data.RepoName,
						IssueNumber: data.Issue.Number,
						AuthorName:  data.Issue.AuthorName,
						CreatedAt:   data.Issue.CreatedAt,
						Body:        data.Issue.Body,
						BodyHTML:    data.BodyHTML,
						CanWrite:    data.CanWrite,
						Editing:     false,
					})

					<ol id="comments" class="space-y-4" aria-label="Issue activity">
						for _, c := range data.Comments {
							<li class="rounded-md border border-border bg-card overflow-hidden">
								<header class="px-4 py-2.5 border-b border-border bg-muted/40 flex items-center gap-2 text-[12.5px]">
									@components.Avatar(c.AuthorName, components.AvatarSizeSM, c.AuthorName)
									<strong class="text-foreground">{ c.AuthorName }</strong>
									<span class="text-muted-foreground">commented</span>
									<time class="text-muted-foreground ml-auto text-xs" datetime={ c.CreatedAt.UTC().Format(time.RFC3339) }>{ c.CreatedAt.Format("Jan 2, 2006 at 3:04 PM") }</time>
								</header>
								<div class="px-4 py-3 prose prose-sm dark:prose-invert max-w-none">
									@templ.Raw(c.BodyHTML)
								</div>
								<div id={ "reactions-" + strconv.FormatInt(c.ID, 10) } hx-get={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/comments/" + strconv.FormatInt(c.ID, 10) + "/reactions" } hx-trigger="load" hx-swap="outerHTML" class="px-4 pb-2"></div>
							</li>
						}
					</ol>

					if !data.Issue.IsLocked || data.CanManage {
						if data.BasePage.CurrentUser != nil {
							<section class="rounded-md border border-border bg-card p-4 space-y-3" aria-label="Add a comment">
								<div class="rounded-md border border-border overflow-hidden">
									@components.MarkdownEditor("comment-body", "body", "", "Add a comment…", 6)
								</div>
								<div class="flex flex-wrap justify-end gap-2">
									if data.Issue.State == "open" {
										<button
											type="button"
											onclick="document.getElementById('close-issue-dialog').showModal()"
											class="inline-flex items-center gap-1.5 h-9 px-3 text-[13px] rounded-md font-medium border border-destructive/30 bg-destructive/10 text-destructive hover:bg-destructive/20"
										>
											<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M9 12l2 2 4-4"></path></svg>
											Close issue
										</button>
									} else {
										@components.Button(components.ButtonSuccess, components.ButtonSizeDefault, templ.Attributes{
											"hx-patch": "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number),
											"hx-vals":  `{"state":"open"}`,
											"hx-swap":  "none",
											"hx-on::after-request": "if(event.detail.successful)window.location.reload()",
											"type":     "button",
										}) {
											Reopen issue
										}
									}
									@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{
										"hx-post":    "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number) + "/comments",
										"hx-include": "#comment-body",
										"hx-swap":    "beforeend",
										"hx-target":  "#comments",
										"hx-on::after-request": "if(event.detail.successful){var el=document.getElementById('issue-comment-count');var n=parseInt(el.dataset.count||'0',10)+1;el.dataset.count=n;el.textContent=' · '+n+(n===1?' comment':' comments');var ta=document.getElementById('comment-body');if(ta)ta.value='';var pv=document.getElementById('comment-body-preview');if(pv)pv.replaceChildren();}",
										"type":       "button",
									}) {
										Comment
									}
								</div>
							</section>
						}
					}
					if data.Issue.IsLocked && !data.CanManage {
						<div class="rounded-md border border-border bg-muted p-4 text-center text-sm text-muted-foreground">
							This issue is locked. Only maintainers can comment.
						</div>
					}

				</article>

				<aside class="space-y-6 text-[12.5px]" aria-label="Issue metadata" x-data="{ open: null }" x-on:keydown.escape.window="open = null">

					<section>
						@components.AssigneeSidebar(data.Owner, data.RepoName, data.Issue.Number, "issues", data.Assignees, data.Collaborators, data.CanWrite)
					</section>

					<section class="border-t border-border pt-6">
						@components.LabelSidebar(data.Owner, data.RepoName, data.Issue.Number, "issues", data.Labels, data.AllLabels, data.CanWrite)
					</section>

					<section class="border-t border-border pt-6">
						@fragments.IssuePrioritySidebar(view.IssuePrioritySidebarData{
							Owner:       data.Owner,
							RepoName:    data.RepoName,
							IssueNumber: data.Issue.Number,
							Priority:    data.Issue.Priority,
							CanWrite:    data.CanWrite,
						})
					</section>

					<section class="border-t border-border pt-6">
						@fragments.MilestoneSidebar(view.MilestoneSidebarFragData{
							Owner:         data.Owner,
							RepoName:      data.RepoName,
							ItemNumber:    data.Issue.Number,
							IsPull:        false,
							Current:       data.Milestone,
							AllMilestones: data.AllMilestones,
							CanWrite:      data.CanWrite,
						})
					</section>

					<section class="border-t border-border pt-6">
						@fragments.IssueLinkedPullsSidebar(view.IssueLinkedPullsSidebarData{
							Owner:       data.Owner,
							RepoName:    data.RepoName,
							IssueNumber: data.Issue.Number,
							Linked:      linkedPullsView(data.LinkedPRs),
							AllPulls:    linkedPullsView(data.RepoPulls),
							CanWrite:    data.CanWrite,
						})
					</section>

					if data.CanManage {
						@MaintainerSection(data.Owner, data.RepoName, data.Issue.Number, data.Issue.IsPinned, data.Issue.IsLocked)
					}

				</aside>

			</div>
		</div>

		@components.Dialog("close-issue-dialog") {
			@components.DialogHeader() {
				@components.DialogTitle("close-issue-dialog") {
					Close this issue?
				}
				@components.DialogDescription() {
					Close issue <strong class="text-foreground">#{ strconv.Itoa(data.Issue.Number) }</strong> — <strong class="text-foreground">{ data.Issue.Title }</strong>. You can reopen it later if needed.
				}
			}
			@components.DialogFooter() {
				@components.DialogClose() {
					Cancel
				}
				<button
					type="button"
					hx-patch={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number) }
					hx-vals={ `{"state":"closed"}` }
					hx-swap="none"
					hx-on:htmx:after-request="if(event.detail.successful)window.location.reload()"
					class="inline-flex items-center justify-center rounded-md text-sm font-medium h-9 px-4 bg-destructive text-destructive-foreground hover:bg-destructive/90"
				>
					Close issue
				</button>
			}
		}
	}
}

// MaintainerSection renders the pin/lock controls. The pin/lock handlers
// re-render and swap it in place (no page reload).
templ MaintainerSection(owner, repoName string, number int, pinned, locked bool) {
	{{ pinURL := "/api/repos/" + owner + "/" + repoName + "/issues/" + strconv.Itoa(number) + "/pin" }}
	{{ lockURL := "/api/repos/" + owner + "/" + repoName + "/issues/" + strconv.Itoa(number) + "/lock" }}
	<section id="maintainer-section" class="border-t border-border pt-6">
		<h3 class="text-[12px] font-medium text-muted-foreground mb-2">Maintainer</h3>
		<div class="space-y-1.5">
			if pinned {
				@maintainerToggle(pinURL, "unpin", "Unpin issue") {
					@pinIcon()
				}
			} else {
				@maintainerToggle(pinURL, "pin", "Pin issue") {
					@pinIcon()
				}
			}
			if locked {
				@maintainerToggle(lockURL, "unlock", "Unlock conversation") {
					@lockIcon()
				}
			} else {
				@maintainerToggle(lockURL, "lock", "Lock conversation") {
					@lockIcon()
				}
			}
		</div>
	</section>
}

// MaintainerFragment is the pin/lock toggle response: the re-rendered section
// plus an out-of-band swap that keeps the header "Locked" badge in sync.
templ MaintainerFragment(owner, repoName string, number int, pinned, locked bool) {
	@MaintainerSection(owner, repoName, number, pinned, locked)
	@issueLockedBadge(locked, true)
}

// issueLockedBadge renders the header "Locked" pill in a stable wrapper so the
// lock toggle can refresh it via an out-of-band swap (oob=true).
templ issueLockedBadge(locked, oob bool) {
	<span id="issue-locked-badge" if oob { hx-swap-oob="true" }>
		if locked {
			@components.Badge(components.BadgeSecondary) {
				Locked
			}
		}
	</span>
}

// maintainerToggle is a full-width sidebar button for a maintainer-only issue
// action (pin/lock). On success the handler swaps #maintainer-section in place.
templ maintainerToggle(endpoint, action, label string) {
	<button
		type="button"
		hx-patch={ endpoint }
		hx-vals={ `{"action":"` + action + `"}` }
		hx-target="#maintainer-section"
		hx-swap="outerHTML"
		class="flex w-full items-center gap-2 px-2.5 py-1.5 rounded-md border border-border text-[13px] text-muted-foreground hover:bg-accent hover:text-foreground"
	>
		{ children... }
		{ label }
	</button>
}

templ pinIcon() {
	<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="shrink-0" aria-hidden="true" focusable="false"><line x1="12" y1="17" x2="12" y2="22"></line><path d="M9 4h6l-1 7 3 3H7l3-3-1-7z"></path></svg>
}

templ lockIcon() {
	<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="shrink-0" aria-hidden="true" focusable="false"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 018 0v4"></path></svg>
}
