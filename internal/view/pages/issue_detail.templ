package pages

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ IssueDetail(data view.IssueDetailData) {
	@layout.Base(data.BasePage, data.Issue.Title+" · Issue #"+strconv.Itoa(data.Issue.Number)+" · "+data.Owner+"/"+data.RepoName) {
		<div class="space-y-6">
			<div>
				<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/issues") } class="text-sm text-muted-foreground hover:text-foreground inline-flex items-center gap-1">
					<span aria-hidden="true">←</span> Back to Issues
				</a>
			</div>
			<div class="flex gap-6">
				<!-- Main content -->
				<div class="flex-1 min-w-0 space-y-6">
					<div id="issue-detail" class="rounded-md border border-border bg-card p-6">
						<div class="flex justify-between items-start gap-4 mb-4">
							<div class="flex-1 min-w-0">
								<h1 class="text-2xl font-semibold tracking-tight flex items-center gap-2 flex-wrap">
									{ data.Issue.Title }
									<span class="text-muted-foreground font-normal">#{ strconv.Itoa(data.Issue.Number) }</span>
									if data.Issue.Visibility == "private" {
										@components.Badge(components.BadgeDestructive) {
											Private
										}
									}
								</h1>
								<p class="text-sm text-muted-foreground mt-2">
									opened by <a href={ templ.SafeURL("/" + data.Issue.AuthorName) } class="hover:underline text-foreground">{ data.Issue.AuthorName }</a>
									<span aria-hidden="true">·</span>
									<time datetime={ data.Issue.CreatedAt.UTC().Format(time.RFC3339) }>{ data.Issue.CreatedAt.Format("Jan 2, 2006") }</time>
								</p>
							</div>
							<div class="flex items-center gap-2 shrink-0">
								@components.IssueStateBadge(string(data.Issue.State))
								if data.Issue.IsLocked {
									@components.Badge(components.BadgeSecondary) {
										Locked
									}
								}
							</div>
						</div>
						if len(data.Labels) > 0 {
							<div class="flex flex-wrap gap-1.5 mb-4" aria-label="Labels">
								for _, l := range data.Labels {
									<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium border" style={ "background-color: " + l.Color + "33; color: " + l.Color + "; border-color: " + l.Color + "55" }>{ l.Name }</span>
								}
							</div>
						}
						@components.MarkdownBody(data.BodyHTML)
						<div class="mt-5 flex flex-wrap gap-2">
							if data.Issue.State == "open" {
								@components.Button(components.ButtonDestructive, components.ButtonSizeDefault, templ.Attributes{
									"hx-patch":  "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number),
									"hx-vals":   `{"state":"closed"}`,
									"hx-target": "#issue-detail",
									"hx-swap":   "outerHTML",
									"type":      "button",
								}) {
									Close Issue
								}
							} else {
								@components.Button(components.ButtonSuccess, components.ButtonSizeDefault, templ.Attributes{
									"hx-patch":  "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number),
									"hx-vals":   `{"state":"open"}`,
									"hx-target": "#issue-detail",
									"hx-swap":   "outerHTML",
									"type":      "button",
								}) {
									Re-open Issue
								}
							}
							if data.CanManage {
								if data.Issue.IsPinned {
									@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{
										"hx-patch": "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number) + "/pin",
										"hx-vals":  `{"action":"unpin"}`,
										"hx-swap":  "none",
										"type":     "button",
									}) {
										Unpin
									}
								} else {
									@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{
										"hx-patch": "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number) + "/pin",
										"hx-vals":  `{"action":"pin"}`,
										"hx-swap":  "none",
										"type":     "button",
									}) {
										Pin
									}
								}
								if data.Issue.IsLocked {
									@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{
										"hx-patch": "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number) + "/lock",
										"hx-vals":  `{"action":"unlock"}`,
										"hx-swap":  "none",
										"type":     "button",
									}) {
										Unlock
									}
								} else {
									@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{
										"hx-patch": "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number) + "/lock",
										"hx-vals":  `{"action":"lock"}`,
										"hx-swap":  "none",
										"type":     "button",
									}) {
										Lock
									}
								}
							}
						</div>
					</div>
					<div class="mt-8">
						<h2 class="text-lg font-semibold mb-4">Comments</h2>
						<div id="comments" class="space-y-3 mb-6">
							for _, c := range data.Comments {
								<div class="rounded-md border border-border bg-card p-4">
									<div class="flex items-center gap-2">
										@components.Avatar(c.AuthorName, components.AvatarSizeSM, c.AuthorName)
										<div class="font-semibold text-sm text-foreground">{ c.AuthorName }</div>
										<time class="text-xs text-muted-foreground" datetime={ c.CreatedAt.UTC().Format(time.RFC3339) }>{ c.CreatedAt.Format("Jan 2, 2006 at 3:04 PM") }</time>
									</div>
									<div class="mt-2">
										@components.MarkdownBody(c.BodyHTML)
									</div>
									<div id={ "reactions-" + strconv.FormatInt(c.ID, 10) } hx-get={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/comments/" + strconv.FormatInt(c.ID, 10) + "/reactions" } hx-trigger="load" hx-swap="outerHTML" class="mt-2"></div>
								</div>
							}
						</div>
						if !data.Issue.IsLocked || data.CanManage {
							if data.BasePage.CurrentUser != nil {
								<form class="rounded-md border border-border bg-card p-4">
									<div class="relative">
										<div class="flex justify-end mb-1">
											@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{
												"type":      "button",
												"hx-get":    "/api/user/replies",
												"hx-target": "#saved-replies-picker-container",
												"hx-swap":   "outerHTML",
											}) {
												Saved replies
											}
										</div>
										<div id="saved-replies-picker-container"></div>
										<label for="comment-body" class="sr-only">Add a comment</label>
										@components.Textarea(templ.Attributes{
											"id":          "comment-body",
											"name":        "body",
											"rows":        "4",
											"placeholder": "Add a comment...",
											"class":       "w-full min-h-24",
										})
									</div>
									<div class="mt-2">
										@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{
											"hx-post":    "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number) + "/comments",
											"hx-include": "#comment-body",
											"hx-swap":    "beforeend",
											"hx-target":  "#comments",
											"type":       "button",
										}) {
											Comment
										}
									</div>
								</form>
								<script>
								document.addEventListener('click', function(e) {
								  var btn = e.target.closest('[data-saved-reply-body]');
								  if (btn) {
								    var ta = document.getElementById('comment-body');
								    if (ta) { ta.value = btn.dataset.savedReplyBody; }
								    var container = document.getElementById('saved-replies-picker-container');
								    if (container) { container.replaceChildren(); }
								  }
								});
								</script>
							}
						}
						if data.Issue.IsLocked && !data.CanManage {
							<div class="rounded-md border border-border bg-muted p-4 text-center text-sm text-muted-foreground">
								This issue is locked. Only maintainers can comment.
							</div>
						}
					</div>
				</div>
				<!-- Sidebar -->
				<aside class="w-64 shrink-0 space-y-4" aria-label="Issue metadata">
					<div class="rounded-md border border-border bg-card p-4">
						@components.LabelSidebar(data.Owner, data.RepoName, data.Issue.Number, "issues", data.Labels, data.AllLabels, data.CanWrite)
					</div>
					<div class="rounded-md border border-border bg-card p-4">
						@components.AssigneeSidebar(data.Owner, data.RepoName, data.Issue.Number, "issues", data.Assignees, data.CanWrite)
					</div>
					<div class="rounded-md border border-border bg-card p-4">
						<div id="issue-milestone">
							<h3 class="text-xs font-semibold text-muted-foreground uppercase tracking-wide mb-2">Milestone</h3>
							if data.Milestone != nil {
								<div class="text-sm">
									<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/milestones") } class="font-medium hover:underline">{ data.Milestone.Title }</a>
									if (data.Milestone.OpenCount + data.Milestone.ClosedCount) > 0 {
										{{ total := data.Milestone.OpenCount + data.Milestone.ClosedCount }}
										{{ pct := 0 }}
										if total > 0 {
											{{ pct = data.Milestone.ClosedCount * 100 / total }}
										}
										<div class="mt-1.5" role="progressbar" aria-valuenow={ strconv.Itoa(pct) } aria-valuemin="0" aria-valuemax="100" aria-label={ "Milestone progress: " + strconv.Itoa(pct) + "%" }>
											<div class="w-full bg-muted h-1.5 rounded-full overflow-hidden">
												<div class="bg-success h-full" style={ "width: " + strconv.Itoa(pct) + "%" }></div>
											</div>
											<p class="text-xs text-muted-foreground mt-1 font-mono">{ strconv.Itoa(data.Milestone.ClosedCount) }/{ strconv.Itoa(total) } closed</p>
										</div>
									}
								</div>
							} else {
								<span class="text-xs text-muted-foreground">No milestone</span>
							}
							if data.CanWrite && len(data.AllMilestones) > 0 {
								<details class="mt-2">
									<summary class="text-xs text-muted-foreground hover:text-foreground cursor-pointer">
										if data.Milestone != nil {
											Change
										} else {
											Set milestone
										}
									</summary>
									<div class="mt-1 space-y-1 max-h-40 overflow-y-auto border border-border rounded-md">
										<form hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.Issue.Number) + "/milestone" } hx-target="#issue-milestone" hx-swap="outerHTML" class="p-1">
											<button type="submit" name="milestone_id" value="" class="w-full text-left px-2 py-1 hover:bg-accent rounded text-xs text-muted-foreground">
												No milestone
											</button>
											for _, m := range data.AllMilestones {
												<button type="submit" name="milestone_id" value={ strconv.FormatInt(m.ID, 10) } class={ "w-full text-left flex items-center gap-2 px-2 py-1 hover:bg-accent rounded text-xs", templ.KV("font-semibold text-foreground", data.Milestone != nil && data.Milestone.ID == m.ID) }>
													<span class={ "w-2 h-2 rounded-full inline-block shrink-0", templ.KV("bg-muted-foreground", m.State == "closed"), templ.KV("bg-success", m.State != "closed") }></span>
													{ m.Title }
												</button>
											}
										</form>
									</div>
								</details>
							}
						</div>
					</div>
				</aside>
			</div>
		</div>
	}
}
