package pages

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/model"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Org(data view.OrgData) {
	@layout.Base(data.BasePage, data.Org.Name) {
		<div class="space-y-8">

			<!-- Org header -->
			<section class="flex flex-wrap items-start gap-6 pb-6 border-b border-border" aria-labelledby="org-name">
				@components.Avatar(data.Org.Name, components.AvatarSizeLG, data.Org.Name)
				<div class="min-w-0 flex-1">
					<p class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground mb-1 inline-flex items-center gap-2">
						<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M3 21h18M3 7h18M5 21V7l7-4 7 4v14"></path></svg>
						Organization
						if data.ViewerRole != nil {
							@components.Badge(components.BadgeOutline) {
								{ orgRoleDisplay(*data.ViewerRole) }
							}
						}
					</p>
					<h1 id="org-name" class="text-2xl font-semibold tracking-tight">
						if data.Org.DisplayName != "" {
							{ data.Org.DisplayName }
						} else {
							{ data.Org.Name }
						}
					</h1>
					<p class="font-mono text-[13px] text-muted-foreground">{ "@" + data.Org.Name }</p>
					if data.Org.Description != "" {
						<p class="mt-3 text-sm text-muted-foreground max-w-2xl">{ data.Org.Description }</p>
					}
					<div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-[13px] text-muted-foreground">
						if data.Org.Location != "" {
							<span class="inline-flex items-center gap-1.5">
								<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="text-muted-foreground" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
								{ data.Org.Location }
							</span>
						}
						if data.Org.Website != "" {
							<a href={ templ.SafeURL(data.Org.Website) } class="inline-flex items-center gap-1.5 text-primary hover:underline" rel="noopener noreferrer">
								<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"></path></svg>
								{ displayHost(data.Org.Website) }
							</a>
						}
						if data.Org.ContactEmail != "" {
							<a href={ templ.SafeURL("mailto:" + data.Org.ContactEmail) } class="inline-flex items-center gap-1.5 hover:text-foreground">
								<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="text-muted-foreground" aria-hidden="true"><path d="M4 4h16a2 2 0 012 2v12a2 2 0 01-2 2H4a2 2 0 01-2-2V6a2 2 0 012-2z"></path><polyline points="22 6 12 13 2 6"></polyline></svg>
								{ data.Org.ContactEmail }
							</a>
						}
						<span class="inline-flex items-center gap-1.5">
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="text-muted-foreground" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
							Founded <time datetime={ data.Org.CreatedAt.UTC().Format(time.RFC3339) }>{ data.Org.CreatedAt.Format("Jan 2006") }</time>
						</span>
					</div>
					<div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-[12.5px] text-muted-foreground">
						<a href={ templ.SafeURL("/" + data.Org.Name + "?tab=repositories") } class="hover:text-foreground">
							<strong class="text-foreground">{ strconv.Itoa(len(data.Repos)) }</strong>
							if len(data.Repos) == 1 {
								repository
							} else {
								repositories
							}
						</a>
						<span class="opacity-50" aria-hidden="true">·</span>
						<a href="#org-people-heading" class="hover:text-foreground">
							<strong class="text-foreground">{ strconv.Itoa(data.MemberCount) }</strong>
							if data.MemberCount == 1 {
								member
							} else {
								members
							}
						</a>
					</div>
				</div>
				<div class="flex-shrink-0 flex items-center gap-2">
					if data.CanManage {
						@components.LinkButton("/repos/new?owner="+data.Org.Name, components.ButtonDefault, components.ButtonSizeSM, nil) {
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"></path></svg>
							New repository
						}
						@components.LinkButton("/orgs/"+data.Org.Name+"/settings", components.ButtonOutline, components.ButtonSizeSM, nil) {
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 01-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"></path></svg>
							Manage
						}
					}
				</div>
			</section>

			<!-- Main grid: README + Pinned + Recent on the left, sidebar on the right -->
			<div class="grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-8">

				<div class="space-y-8 min-w-0">

					if data.ProfileReadme != "" {
						<article class="rounded-md border border-border bg-card overflow-hidden" aria-labelledby="org-readme-heading">
							<header class="px-5 py-3 border-b border-border bg-muted flex items-center gap-2">
								<svg class="text-muted-foreground" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
								<h2 id="org-readme-heading" class="text-[13px] font-medium">{ data.Org.Name }/README.md</h2>
							</header>
							<div class="prose prose-sm max-w-none dark:prose-invert px-7 py-6">
								@templ.Raw(string(data.ProfileReadme))
							</div>
						</article>
					}

					if len(data.PinnedRepos) > 0 {
						<section aria-labelledby="pinned-heading">
							<div class="flex items-baseline justify-between mb-3">
								<h2 id="pinned-heading" class="text-sm font-semibold tracking-tight">Pinned repositories</h2>
								<a href={ templ.SafeURL("/" + data.Org.Name + "?tab=repositories") } class="text-[12px] text-primary hover:underline">View all { strconv.Itoa(len(data.Repos)) } →</a>
							</div>
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
								for _, p := range data.PinnedRepos {
									@components.PinnedRepo(p)
								}
							</div>
						</section>
					}

					if len(data.RecentRepos) > 0 {
						<section aria-labelledby="recent-heading">
							<div class="flex items-baseline justify-between mb-3">
								if data.ShowAllRepos {
									<h2 id="recent-heading" class="text-sm font-semibold tracking-tight">Repositories</h2>
									<a href={ templ.SafeURL("/" + data.Org.Name) } class="text-[12px] text-primary hover:underline">← Overview</a>
								} else {
									<h2 id="recent-heading" class="text-sm font-semibold tracking-tight">Recently updated</h2>
									<a href={ templ.SafeURL("/" + data.Org.Name + "?tab=repositories") } class="text-[12px] text-primary hover:underline">All repositories →</a>
								}
							</div>
							<ul class="divide-y divide-border rounded-md border border-border bg-card overflow-hidden">
								for _, repo := range data.RecentRepos {
									<li>
										<a href={ templ.SafeURL("/" + repo.OwnerName + "/" + repo.Name) } class="flex items-start gap-3 px-4 py-3.5 hover:bg-accent/50 transition-colors">
											<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="text-muted-foreground mt-1 shrink-0" aria-hidden="true"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"></path><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"></path></svg>
											<div class="min-w-0 flex-1">
												<div class="flex items-center gap-2">
													<span class="text-[13.5px] font-medium">{ repo.OwnerName }/{ repo.Name }</span>
												</div>
												if repo.Description != "" {
													<p class="text-xs text-muted-foreground line-clamp-1 mt-0.5">{ repo.Description }</p>
												}
												<div class="mt-1.5 flex items-center gap-3 text-[11.5px] text-muted-foreground">
													if repo.Language != "" {
														<span class="inline-flex items-center gap-1">
															<span class="w-2 h-2 rounded-full" style={ "background:" + repo.LanguageColor }></span>
															{ repo.Language }
														</span>
													}
													if repo.Stars > 0 {
														<span class="inline-flex items-center gap-1">
															<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
															{ strconv.Itoa(repo.Stars) }
														</span>
													}
												</div>
											</div>
										</a>
									</li>
								}
							</ul>
						</section>
					}

					if data.ProfileReadme == "" && len(data.PinnedRepos) == 0 && len(data.RecentRepos) == 0 {
						@components.EmptyStateWithHint("No public repositories yet.", "Once members push their first repo, it'll show up here.")
					}

				</div>

				<aside class="space-y-7">
					<section id="org-people-heading" aria-labelledby="people-heading">
						<div class="flex items-baseline justify-between mb-2">
							<h2 id="people-heading" class="font-mono uppercase tracking-wider text-[10px] text-muted-foreground">
								People <span class="text-muted-foreground/70">· { strconv.Itoa(data.MemberCount) }</span>
							</h2>
							if data.MemberCount > 12 {
								<a href={ templ.SafeURL("/orgs/" + data.Org.Name + "/people") } class="text-[11px] text-primary hover:underline">View all</a>
							}
						</div>
						if len(data.Members) > 0 {
							<div class="flex flex-wrap gap-1.5">
								for i, m := range data.Members {
									if i < 12 {
										<a href={ templ.SafeURL("/" + m.Username) } title={ m.Username } class="hover:opacity-80">
											@components.Avatar(m.Username, components.AvatarSizeDefault, m.Username)
										</a>
									}
								}
								if data.MemberCount > 12 {
									<span class="inline-grid place-items-center h-7 w-7 rounded bg-accent border border-border text-[10px] text-muted-foreground">
										+{ strconv.Itoa(data.MemberCount - 12) }
									</span>
								}
							</div>
						} else {
							<p class="text-[12px] text-muted-foreground">No members yet.</p>
						}
					</section>

					if len(data.TopLangs) > 0 {
						<section aria-labelledby="org-langs-heading">
							<h2 id="org-langs-heading" class="font-mono uppercase tracking-wider text-[10px] text-muted-foreground mb-2">Top languages</h2>
							@components.LanguagesBar(data.TopLangs)
						</section>
					}

					<section aria-labelledby="org-created-heading">
						<h2 id="org-created-heading" class="font-mono uppercase tracking-wider text-[10px] text-muted-foreground mb-2">Created</h2>
						<p class="text-[12.5px]"><time datetime={ data.Org.CreatedAt.UTC().Format(time.RFC3339) }>{ data.Org.CreatedAt.Format("Jan 2006") }</time></p>
					</section>

					if data.ViewerRole != nil {
						<section aria-labelledby="viewer-role-heading">
							<h2 id="viewer-role-heading" class="font-mono uppercase tracking-wider text-[10px] text-muted-foreground mb-2">Your role</h2>
							<p class="inline-flex items-center gap-2 text-[12.5px]">
								@components.Badge(components.BadgeOutline) {
									{ orgRoleDisplay(*data.ViewerRole) }
								}
							</p>
							if data.ViewerJoined != nil {
								<p class="mt-1.5 text-[11.5px] text-muted-foreground">
									Joined <time datetime={ data.ViewerJoined.UTC().Format(time.RFC3339) }>{ data.ViewerJoined.Format("Jan 2 2006") }</time>
								</p>
							}
						</section>
					}
				</aside>

			</div>
		</div>
	}
}

// orgRoleDisplay returns a human label for the OrgRole shown in badges.
func orgRoleDisplay(role model.OrgRole) string {
	switch role {
	case model.OrgRoleOwner:
		return "Owner"
	case model.OrgRoleMember:
		return "Member"
	}
	return string(role)
}

// displayHost strips the scheme + trailing slash from a URL so the link
// label reads as a plain hostname (e.g. "stitch.dev" instead of "https://stitch.dev/").
func displayHost(raw string) string {
	s := raw
	for _, prefix := range []string{"https://", "http://"} {
		if len(s) > len(prefix) && s[:len(prefix)] == prefix {
			s = s[len(prefix):]
			break
		}
	}
	for len(s) > 0 && s[len(s)-1] == '/' {
		s = s[:len(s)-1]
	}
	return s
}
