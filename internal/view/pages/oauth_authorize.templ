package pages

import (
	"strings"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ OAuthAuthorize(data view.OAuthAuthorizeData) {
	@layout.Base(data.BasePage, "Authorize " + data.App.Name + " — Cloudzilla") {
		<div class="max-w-md mx-auto py-12 px-4">
			@components.Card(nil) {
				@components.CardContent() {
					<div class="space-y-5">
						<h1 class="text-xl font-semibold tracking-tight">Authorize { data.App.Name }</h1>
						if data.App.Description != "" {
							<p class="text-sm text-muted-foreground">{ data.App.Description }</p>
						}
						if len(data.Scopes) > 0 {
							<div>
								<p class="text-sm font-medium mb-2">This application is requesting access to:</p>
								<ul class="list-disc list-inside text-sm text-foreground space-y-1">
									for _, s := range data.Scopes {
										<li>{ s }</li>
									}
								</ul>
							</div>
						}
						<form method="POST" action="/oauth/authorize" class="flex gap-3">
							<input type="hidden" name="client_id" value={ data.App.ClientID }/>
							<input type="hidden" name="redirect_uri" value={ data.RedirectURI }/>
							<input type="hidden" name="scope" value={ strings.Join(data.Scopes, " ") }/>
							<input type="hidden" name="state" value={ data.State }/>
							@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"name": "action", "value": "approve", "type": "submit"}) {
								Authorize
							}
							@components.Button(components.ButtonSecondary, components.ButtonSizeDefault, templ.Attributes{"name": "action", "value": "deny", "type": "submit"}) {
								Deny
							}
						</form>
					</div>
				}
			}
		</div>
	}
}
