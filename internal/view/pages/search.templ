package pages

import (
	"net/url"
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/model"
	"github.com/mkappworks-dev/cloudzilla-app/internal/service"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Search(data view.SearchData) {
	@layout.Base(data.BasePage, searchTitle(data)) {
		<div class="space-y-6">
			@components.Card(nil) {
				@components.CardContent() {
					<h1 class="text-2xl font-bold mb-4">Search</h1>
					<form action="/search" method="GET" class="flex gap-2">
						<label for="search-query" class="sr-only">Search query</label>
						<div class="relative flex-1" x-data={ "{ q: " + strconv.Quote(data.Query) + " }" }>
							@components.Input(templ.Attributes{
								"id":          "search-query",
								"type":        "search",
								"name":        "q",
								"x-ref":       "q",
								"x-model":     "q",
								"placeholder": "Search repos, issues, PRs, users...",
								"class":       "pr-9",
							})
							<button type="button" x-cloak x-show="q" x-on:click="q = ''; $refs.q.focus()" class="absolute right-2 top-1/2 -translate-y-1/2 h-6 w-6 grid place-items-center rounded-full text-muted-foreground hover:text-foreground hover:bg-accent" aria-label="Clear search">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M18 6L6 18M6 6l12 12"/></svg>
							</button>
						</div>
						if data.Type != "" {
							<input type="hidden" name="type" value={ data.Type }/>
						}
						@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
							Search
						}
					</form>
				}
			}
			if data.Query != "" {
				@components.TabBar(searchTabs(data))
				if data.Results != nil {
					if searchShows(data, "repos") && len(data.Results.Repos) > 0 {
						@searchGroup(data, "Repositories") {
							for _, repo := range data.Results.Repos {
								@components.RepoListRow(components.RepoListRowData{
									Owner:       repo.OwnerName,
									Name:        repo.Name,
									Description: repo.Description,
									Private:     repo.Private,
								})
							}
						}
					}
					if searchShows(data, "orgs") && len(data.Results.Orgs) > 0 {
						@searchGroup(data, "Organizations") {
							for _, o := range data.Results.Orgs {
								@components.PersonListRow(o.Name, orgSubtitle(o))
							}
						}
					}
					if searchShows(data, "issues") && len(data.Results.Issues) > 0 {
						@searchGroup(data, "Issues") {
							for _, issue := range data.Results.Issues {
								@components.IssueListRow(components.IssueListRowData{
									Href:      "/" + issue.RepoOwner + "/" + issue.RepoName + "/issues/" + strconv.Itoa(issue.Number),
									Repo:      issue.RepoOwner + "/" + issue.RepoName,
									Number:    issue.Number,
									Title:     issue.Title,
									Author:    issue.AuthorName,
									State:     string(issue.State),
									Private:   issue.Visibility == "private",
									OpenedAt:  formatRelative(issue.CreatedAt),
									OpenedISO: issue.CreatedAt.UTC().Format(time.RFC3339),
								})
							}
						}
					}
					if searchShows(data, "pulls") && len(data.Results.Pulls) > 0 {
						@searchGroup(data, "Pull Requests") {
							for _, pr := range data.Results.Pulls {
								@components.PRListRow(components.PRListRowData{
									OwnerName: pr.RepoOwner,
									RepoName:  pr.RepoName,
									ShowRepo:  true,
									Number:    pr.Number,
									Title:     pr.Title,
									Author:    pr.AuthorName,
									State:     pullRowState(pr),
									OpenedAt:  formatRelative(pr.CreatedAt),
								})
							}
						}
					}
					if searchShows(data, "users") && len(data.Results.Users) > 0 {
						@searchGroup(data, "Users") {
							for _, u := range data.Results.Users {
								@components.PersonListRow(u.Username, u.Bio)
							}
						}
					}
					if data.Results.Empty() {
						@components.EmptyStateWithHint("No results found for " + data.Query + ".", "Try different keywords or broaden your search.")
					}
				} else {
					@components.EmptyState("Enter a search query above to get started.")
				}
			} else {
				@components.EmptyState("Enter a search query above to get started.")
			}
		</div>
	}
}

templ searchGroup(data view.SearchData, title string) {
	<section class="rounded-md border border-border bg-card overflow-hidden">
		if searchIsAll(data) {
			<h2 class="px-6 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wide bg-muted">{ title }</h2>
		}
		<ul class="divide-y divide-border">
			{ children... }
		</ul>
	</section>
}

func searchIsAll(data view.SearchData) bool { return data.Type == "all" || data.Type == "" }

func searchShows(data view.SearchData, kind string) bool {
	return searchIsAll(data) || data.Type == kind
}

func searchTabs(data view.SearchData) []components.Tab {
	count := func(n int) int {
		if n == 0 {
			return -1
		}
		return n
	}
	r := data.Results
	if r == nil {
		r = &service.SearchResults{}
	}
	href := func(t string) string { return "/search?q=" + url.QueryEscape(data.Query) + "&type=" + t }
	return []components.Tab{
		{Label: "All", URL: href("all"), IsActive: searchIsAll(data), Count: -1},
		{Label: "Repositories", URL: href("repos"), IsActive: data.Type == "repos", Count: count(len(r.Repos))},
		{Label: "Organizations", URL: href("orgs"), IsActive: data.Type == "orgs", Count: count(len(r.Orgs))},
		{Label: "Issues", URL: href("issues"), IsActive: data.Type == "issues", Count: count(len(r.Issues))},
		{Label: "Pull Requests", URL: href("pulls"), IsActive: data.Type == "pulls", Count: count(len(r.Pulls))},
		{Label: "Users", URL: href("users"), IsActive: data.Type == "users", Count: count(len(r.Users))},
	}
}

func orgSubtitle(o model.Organization) string {
	if o.DisplayName != "" && o.DisplayName != o.Name {
		return o.DisplayName
	}
	return o.Description
}

func pullRowState(pr model.PullRequest) string {
	if pr.State == model.PRStateOpen && pr.IsDraft {
		return "draft"
	}
	return string(pr.State)
}

func searchTitle(data view.SearchData) string {
	if data.Query != "" {
		return "Search: " + data.Query
	}
	return "Search"
}
