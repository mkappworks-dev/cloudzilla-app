package pages

import (
	"strconv"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Search(data view.SearchData) {
	@layout.Base(data.BasePage, searchTitle(data)) {
		<div class="space-y-6">
			@components.Card(nil) {
				@components.CardContent() {
					<h1 class="text-2xl font-bold mb-4">Search</h1>
					<form action="/search" method="GET" class="flex gap-2">
						<label for="search-query" class="sr-only">Search query</label>
						@components.Input(templ.Attributes{
							"id":          "search-query",
							"type":        "text",
							"name":        "q",
							"value":       data.Query,
							"placeholder": "Search repos, issues, PRs, users...",
							"class":       "flex-1",
						})
						if data.Type != "" {
							<input type="hidden" name="type" value={ data.Type }/>
						}
						@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
							Search
						}
					</form>
				}
			}
			if data.Query != "" {
			{{ repoCount := -1 }}
				if data.Results != nil && len(data.Results.Repos) > 0 {
					{{ repoCount = len(data.Results.Repos) }}
				}
				{{ issueCount := -1 }}
				if data.Results != nil && len(data.Results.Issues) > 0 {
					{{ issueCount = len(data.Results.Issues) }}
				}
				{{ pullCount := -1 }}
				if data.Results != nil && len(data.Results.Pulls) > 0 {
					{{ pullCount = len(data.Results.Pulls) }}
				}
				{{ userCount := -1 }}
				if data.Results != nil && len(data.Results.Users) > 0 {
					{{ userCount = len(data.Results.Users) }}
				}
				@components.TabBar([]components.Tab{
					{Label: "All", URL: "/search?q=" + data.Query + "&type=all", IsActive: data.Type == "all" || data.Type == "", Count: -1},
					{Label: "Repositories", URL: "/search?q=" + data.Query + "&type=repos", IsActive: data.Type == "repos", Count: repoCount},
					{Label: "Issues", URL: "/search?q=" + data.Query + "&type=issues", IsActive: data.Type == "issues", Count: issueCount},
					{Label: "Pull Requests", URL: "/search?q=" + data.Query + "&type=pulls", IsActive: data.Type == "pulls", Count: pullCount},
					{Label: "Users", URL: "/search?q=" + data.Query + "&type=users", IsActive: data.Type == "users", Count: userCount},
				})
				if data.Results != nil {
					if (data.Type == "all" || data.Type == "" || data.Type == "repos") && len(data.Results.Repos) > 0 {
						<div class="rounded-md border border-border bg-card divide-y divide-border">
							if data.Type == "all" || data.Type == "" {
								<div class="px-6 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wide bg-muted rounded-t-md">Repositories</div>
							}
							for _, repo := range data.Results.Repos {
								<div class="px-6 py-4">
									<div class="flex items-start justify-between gap-4">
										<div class="min-w-0">
											<a href={ templ.SafeURL("/" + repo.OwnerName + "/" + repo.Name) } class="text-foreground font-semibold hover:underline">{ repo.OwnerName }/{ repo.Name }</a>
											if repo.Description != "" {
												<p class="text-sm text-muted-foreground mt-0.5 truncate">{ repo.Description }</p>
											}
										</div>
										if repo.Private {
											@components.Badge(components.BadgeWarning) {
												Private
											}
										} else {
											@components.Badge(components.BadgeOutline) {
												Public
											}
										}
									</div>
								</div>
							}
						</div>
					}
					if (data.Type == "all" || data.Type == "" || data.Type == "issues") && len(data.Results.Issues) > 0 {
						<div class="rounded-md border border-border bg-card divide-y divide-border">
							if data.Type == "all" || data.Type == "" {
								<div class="px-6 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wide bg-muted rounded-t-md">Issues</div>
							}
							for _, issue := range data.Results.Issues {
								<div class="px-6 py-4 flex items-start gap-3">
									<span class="shrink-0 mt-0.5">
										@components.IssueStateBadge(string(issue.State))
									</span>
									<div class="min-w-0">
										<a href={ templ.SafeURL("/issues/" + strconv.Itoa(issue.Number)) } class="text-foreground font-medium hover:underline">{ issue.Title }</a>
										<p class="text-xs text-muted-foreground mt-0.5">#{ strconv.Itoa(issue.Number) } by { issue.AuthorName }</p>
									</div>
								</div>
							}
						</div>
					}
					if (data.Type == "all" || data.Type == "" || data.Type == "pulls") && len(data.Results.Pulls) > 0 {
						<div class="rounded-md border border-border bg-card divide-y divide-border">
							if data.Type == "all" || data.Type == "" {
								<div class="px-6 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wide bg-muted rounded-t-md">Pull Requests</div>
							}
							for _, pr := range data.Results.Pulls {
								<div class="px-6 py-4 flex items-start gap-3">
									<span class="shrink-0 mt-0.5">
										@components.PullStateBadge(pr.State, false)
									</span>
									<div class="min-w-0">
										<span class="text-foreground font-medium">{ pr.Title }</span>
										<p class="text-xs text-muted-foreground mt-0.5">#{ strconv.Itoa(pr.Number) } by { pr.AuthorName } · { pr.HeadBranch } → { pr.BaseBranch }</p>
									</div>
								</div>
							}
						</div>
					}
					if (data.Type == "all" || data.Type == "" || data.Type == "users") && len(data.Results.Users) > 0 {
						<div class="rounded-md border border-border bg-card divide-y divide-border">
							if data.Type == "all" || data.Type == "" {
								<div class="px-6 py-3 text-xs font-semibold text-muted-foreground uppercase tracking-wide bg-muted rounded-t-md">Users</div>
							}
							for _, u := range data.Results.Users {
								<div class="px-6 py-4 flex items-center gap-3">
									@components.Avatar(u.Username, components.AvatarSizeDefault, u.Username)
									<div>
										<a href={ templ.SafeURL("/" + u.Username) } class="text-foreground font-semibold hover:underline">{ u.Username }</a>
										if u.Bio != "" {
											<p class="text-xs text-muted-foreground">{ u.Bio }</p>
										}
									</div>
								</div>
							}
						</div>
					}
					if data.Results != nil && len(data.Results.Repos) == 0 && len(data.Results.Issues) == 0 && len(data.Results.Pulls) == 0 && len(data.Results.Users) == 0 {
						@components.EmptyStateWithHint("No results found for " + data.Query + ".", "Try different keywords or broaden your search.")
					}
				} else {
					@components.EmptyState("Enter a search query above to get started.")
				}
			} else {
				@components.EmptyState("Enter a search query above to get started.")
			}
		</div>
	}
}

func searchTitle(data view.SearchData) string {
	if data.Query != "" {
		return "Search: " + data.Query
	}
	return "Search"
}
