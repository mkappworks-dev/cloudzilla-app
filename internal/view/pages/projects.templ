package pages

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Projects(data view.ProjectsData) {
	@layout.Base(data.BasePage, "Projects · "+data.Owner+"/"+data.RepoName) {
		<div class="max-w-4xl mx-auto px-4 py-8">
			<div class="flex items-center justify-between mb-6">
				<h1 class="text-2xl font-bold">
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="text-blue-600 hover:underline">{ data.RepoName }</a>
					<span class="text-gray-400 mx-1">/</span>
					Projects
				</h1>
				if data.CanWrite {
					<button
						class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 text-sm font-medium"
						x-data
						x-on:click="document.getElementById('new-project-form').classList.toggle('hidden')">
						New board
					</button>
				}
			</div>
			if data.CanWrite {
				<div id="new-project-form" class="hidden mb-6 border border-gray-200 rounded p-4 bg-gray-50">
					<h2 class="text-lg font-semibold mb-3">Create a new project board</h2>
					<form
						hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/projects" }
						hx-ext="json-enc"
						hx-on:after-request="window.location.reload()"
						class="space-y-3">
						<div>
							<label class="block text-sm font-medium text-gray-700 mb-1">Name</label>
							<input type="text" name="name" required class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400" placeholder="Board name"/>
						</div>
						<div>
							<label class="block text-sm font-medium text-gray-700 mb-1">Description (optional)</label>
							<input type="text" name="description" class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400" placeholder="Short description"/>
						</div>
						<div class="flex gap-2">
							<button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded text-sm hover:bg-blue-700">Create</button>
							<button type="button" onclick="document.getElementById('new-project-form').classList.add('hidden')" class="px-4 py-2 border border-gray-300 rounded text-sm hover:bg-gray-100">Cancel</button>
						</div>
					</form>
				</div>
			}
			if len(data.Projects) == 0 {
				<p class="text-gray-500 text-sm">No project boards yet.</p>
			} else {
				<ul class="space-y-3">
					for _, p := range data.Projects {
						<li class="border border-gray-200 rounded p-4 flex items-center justify-between hover:bg-gray-50">
							<div>
								<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/projects/" + strconv.FormatInt(p.ID, 10)) } class="font-medium text-blue-600 hover:underline">{ p.Name }</a>
								if p.Description != "" {
									<p class="text-sm text-gray-500 mt-0.5">{ p.Description }</p>
								}
							</div>
							if data.CanWrite {
								<button
									hx-delete={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/projects/" + strconv.FormatInt(p.ID, 10) }
									hx-confirm="Delete this project board and all its columns and cards?"
									hx-on:after-request="window.location.reload()"
									class="text-red-500 hover:text-red-700 text-sm px-2 py-1 rounded hover:bg-red-50">
									Delete
								</button>
							}
						</li>
					}
				</ul>
			}
		</div>
	}
}
