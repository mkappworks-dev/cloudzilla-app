package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Invite(data view.InviteData) {
	@layout.Base(data.BasePage, "Accept invitation") {
		<div class="max-w-md mx-auto mt-16 rounded-md border border-border bg-card p-6">
			@authCardHero("You've been invited", "Join Cloudzilla", "Finish setting up your account to start collaborating.")
			if data.Error != "" {
				<div class="mb-4 p-3 rounded-md border border-destructive/40 bg-destructive/10 text-destructive text-sm" role="alert">{ data.Error }</div>
			}
			if data.Invitation != nil {
				<form method="POST" class="space-y-4">
					<div class="space-y-1.5">
						<label for="invite-email" class="block text-sm font-medium">Email</label>
						@components.Input(templ.Attributes{
							"type":     "email",
							"id":       "invite-email",
							"name":     "email",
							"value":    data.Invitation.Email,
							"readonly": "readonly",
							"class":    "bg-muted text-muted-foreground cursor-not-allowed",
						})
					</div>
					<div class="space-y-1.5">
						<label for="invite-username" class="block text-sm font-medium">Username</label>
						@components.Input(templ.Attributes{
							"type":      "text",
							"id":        "invite-username",
							"name":      "username",
							"required":  "required",
							"autofocus": "autofocus",
						})
					</div>
					<div class="space-y-1.5">
						<label for="invite-password" class="block text-sm font-medium">Password</label>
						@components.Input(templ.Attributes{
							"type":     "password",
							"id":       "invite-password",
							"name":     "password",
							"required": "required",
						})
					</div>
					@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit", "class": "w-full"}) {
						Create account
					}
				</form>
			}
		</div>
	}
}
