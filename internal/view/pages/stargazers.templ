package pages

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Stargazers(data view.StargazersData) {
	@layout.Base(data.BasePage, "Stargazers · "+data.Owner+"/"+data.RepoName) {
		<div class="space-y-6">
			<div class="mb-2">
				<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="text-foreground hover:underline text-sm">&#8592; Back to { data.Owner }/{ data.RepoName }</a>
			</div>
			<div class="flex items-center gap-3">
				<h1 class="text-2xl font-bold">
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="text-foreground hover:underline">{ data.Owner }/{ data.RepoName }</a>
				</h1>
				<span class="text-muted-foreground">
					<span aria-hidden="true">&#9733;</span> { strconv.Itoa(data.StarCount) }
					if data.StarCount == 1 {
						star
					} else {
						stars
					}
				</span>
			</div>
			if len(data.Stargazers) > 0 {
				<div class="rounded-md border border-border bg-card divide-y divide-border">
					for _, u := range data.Stargazers {
						<div class="px-4 py-3 flex items-center gap-3">
							<a href={ templ.SafeURL("/" + u.Username) } class="font-medium text-foreground hover:underline">{ u.Username }</a>
							if u.Bio != "" {
								<span class="text-sm text-muted-foreground">{ u.Bio }</span>
							}
						</div>
					}
				</div>
			} else {
				@components.EmptyState("No stargazers yet. Be the first to star this repository!")
			}
		</div>
	}
}
