package pages

import (
	"strconv"

	"github.com/mkappworks/cloudzilla/internal/view"
	"github.com/mkappworks/cloudzilla/internal/view/layout"
)

templ Stargazers(data view.StargazersData) {
	@layout.Base(data.BasePage, "Stargazers · "+data.Owner+"/"+data.RepoName) {
		<div class="space-y-6">
			<div class="mb-2">
				<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="text-blue-600 hover:underline text-sm">&#8592; Back to { data.Owner }/{ data.RepoName }</a>
			</div>
			<div class="flex items-center gap-3">
				<h1 class="text-2xl font-bold">
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="text-blue-600 hover:underline">{ data.Owner }/{ data.RepoName }</a>
				</h1>
				<span class="text-gray-500">
					&#9733; { strconv.Itoa(data.StarCount) }
					if data.StarCount == 1 {
						star
					} else {
						stars
					}
				</span>
			</div>
			if len(data.Stargazers) > 0 {
				<div class="bg-white border border-gray-200 rounded-lg divide-y divide-gray-100">
					for _, u := range data.Stargazers {
						<div class="px-4 py-3 flex items-center gap-3">
							<a href={ templ.SafeURL("/" + u.Username) } class="font-medium text-blue-600 hover:underline">{ u.Username }</a>
							if u.Bio != "" {
								<span class="text-sm text-gray-500">{ u.Bio }</span>
							}
						</div>
					}
				</div>
			} else {
				<div class="bg-white border border-gray-200 rounded-lg p-8 text-center">
					<p class="text-gray-500">No stargazers yet. Be the first to star this repository!</p>
				</div>
			}
		</div>
	}
}
