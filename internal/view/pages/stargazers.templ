package pages

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Stargazers(data view.StargazersData) {
	@layout.Base(data.BasePage, "Stargazers · "+data.Owner+"/"+data.RepoName) {
		<div class="max-w-4xl mx-auto space-y-6">

			<section aria-labelledby="sg-title">
				<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="hover:underline">{ data.RepoName }</a>
					<span aria-hidden="true">·</span>
					Stargazers
				</p>
				<h1 id="sg-title" class="text-2xl font-semibold tracking-tight inline-flex items-center gap-3">
					Stargazers
					<span class="font-mono text-base text-muted-foreground">
						<span aria-hidden="true">★</span> { strconv.Itoa(data.StarCount) }
					</span>
				</h1>
			</section>

			if len(data.Stargazers) > 0 {
				<section class="rounded-md border border-border bg-card overflow-hidden" aria-labelledby="sg-list">
					<h2 id="sg-list" class="sr-only">Users who starred { data.Owner }/{ data.RepoName }</h2>
					<ul class="divide-y divide-border">
						for _, u := range data.Stargazers {
							<li class="flex items-center gap-3 px-4 py-3 hover:bg-muted/50">
								@components.Avatar(u.Username, components.AvatarSizeDefault, u.Username)
								<a href={ templ.SafeURL("/" + u.Username) } class="text-[13px] font-medium hover:underline">{ u.Username }</a>
								if u.Bio != "" {
									<span class="text-[12px] text-muted-foreground truncate">{ u.Bio }</span>
								}
							</li>
						}
					</ul>
				</section>
			} else {
				@components.EmptyState("No stargazers yet. Be the first to star this repository!")
			}
		</div>
	}
}
