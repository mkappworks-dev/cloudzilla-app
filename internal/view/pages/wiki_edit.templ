package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ WikiEdit(data view.WikiEditData) {
	@layout.Base(data.BasePage, "Edit "+data.Slug+" — Wiki — "+data.RepoName+" — Cloudzilla") {
		<div class="max-w-4xl mx-auto space-y-6">

			<section aria-labelledby="edit-title">
				<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="hover:underline">{ data.RepoName }</a>
					<span aria-hidden="true">·</span>
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/wiki") } class="hover:underline">Wiki</a>
					<span aria-hidden="true">·</span>
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/wiki/" + data.Slug) } class="hover:underline">{ data.Slug }</a>
					<span aria-hidden="true">·</span>
					Edit
				</p>
				<h1 id="edit-title" class="text-2xl font-semibold tracking-tight">Editing: { data.Slug }</h1>
			</section>

			<form
				id="wiki-edit-form"
				data-owner={ data.Owner }
				data-repo={ data.RepoName }
				data-slug={ data.Slug }
				class="space-y-5 rounded-md border border-border bg-card p-6"
			>
				<div class="space-y-1.5">
					<label for="wiki-content" class="block text-sm font-medium">Content <span class="text-muted-foreground font-normal">(Markdown)</span></label>
					<textarea
						id="wiki-content"
						name="content"
						rows="24"
						class="min-h-[280px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm font-mono shadow-sm placeholder:text-muted-foreground resize-vertical"
					>{ data.Content }</textarea>
				</div>

				<div class="space-y-1.5">
					<label for="wiki-message" class="block text-sm font-medium">
						Commit message <span class="text-muted-foreground font-normal">(optional)</span>
					</label>
					@components.Input(templ.Attributes{
						"id":          "wiki-message",
						"type":        "text",
						"name":        "message",
						"placeholder": "Update " + data.Slug,
					})
				</div>

				<div id="wiki-edit-error" role="alert" class="hidden text-sm text-destructive bg-destructive/10 border border-destructive/40 rounded-md px-3 py-2"></div>

				<div class="flex items-center gap-3 pt-1">
					@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
						Save page
					}
					@components.LinkButton("/"+data.Owner+"/"+data.RepoName+"/wiki/"+data.Slug, components.ButtonGhost, components.ButtonSizeDefault, nil) {
						Cancel
					}
				</div>
			</form>

			<script>
				(function() {
					const form = document.getElementById('wiki-edit-form');
					const errBox = document.getElementById('wiki-edit-error');
					form.addEventListener('submit', async function(e) {
						e.preventDefault();
						errBox.classList.add('hidden');
						const owner = form.dataset.owner;
						const repo = form.dataset.repo;
						const slug = form.dataset.slug;
						const content = form.querySelector('[name=content]').value;
						const message = form.querySelector('[name=message]').value;
						const csrf = (document.cookie.match(/csrf_token=([^;]+)/) || [])[1] || '';
						const body = new URLSearchParams();
						body.set('content', content);
						body.set('message', message);
						const res = await fetch('/api/repos/' + owner + '/' + repo + '/wiki/' + slug, {
							method: 'POST',
							headers: {
								'Content-Type': 'application/x-www-form-urlencoded',
								'X-CSRF-Token': csrf,
							},
							body: body.toString(),
						});
						if (res.ok || res.redirected) {
							window.location.href = '/' + owner + '/' + repo + '/wiki/' + slug;
							return;
						}
						const text = await res.text();
						let msg = text;
						try { msg = JSON.parse(text).error || text; } catch (_) {}
						errBox.textContent = msg || ('Failed to save page (HTTP ' + res.status + ')');
						errBox.classList.remove('hidden');
					});
				})();
			</script>
		</div>
	}
}
