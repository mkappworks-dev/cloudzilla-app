package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ WikiEdit(data view.WikiEditData) {
	@layout.Base(data.BasePage, data.RepoName+" · Wiki · "+data.Slug+" · Edit — Cloudzilla") {
		<div class="space-y-6">

			<section class="mb-6" aria-labelledby="edit-title">
				<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="hover:underline">{ data.RepoName }</a>
					<span aria-hidden="true">·</span>
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/wiki") } class="hover:underline">Wiki</a>
					<span aria-hidden="true">·</span>
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/wiki/" + data.Slug) } class="hover:underline">{ data.Slug }</a>
					<span aria-hidden="true">·</span>
					Edit
				</p>
				<h1 id="edit-title" class="text-2xl font-semibold tracking-tight">Edit: { data.Slug }</h1>
			</section>

			<div class="grid lg:grid-cols-[220px_1fr] gap-8">
				@wikiSidebar(data.Owner, data.RepoName, data.Slug, data.PageList, true, false)

				<article
					id="wiki-edit-form"
					data-owner={ data.Owner }
					data-repo={ data.RepoName }
					data-slug={ data.Slug }
					class="border border-border rounded-md bg-card p-6"
				>
					<form class="space-y-5">
						<div>
							<label for="wiki-page-title" class="block text-sm font-medium mb-1.5">Page title</label>
							@components.Input(templ.Attributes{
								"id":      "wiki-page-title",
								"name":    "new_slug",
								"type":    "text",
								"value":   data.Slug,
								"pattern": "[A-Za-z0-9_-]{1,100}",
								"required": true,
							})
							<p class="mt-1 text-[12px] text-muted-foreground">Letters, numbers, hyphens and underscores only. Changing this renames the page.</p>
						</div>

						<div class="space-y-1.5">
							<label for="wiki-content" class="block text-sm font-medium">Content (Markdown)</label>
							<div class="border border-border rounded-md overflow-hidden">
								@components.MarkdownEditor("wiki-content", "content", data.Content, "Write your page in Markdown…", 18)
							</div>
						</div>

						<div>
							<label for="wiki-message" class="block text-sm font-medium mb-1.5">Commit message <span class="text-muted-foreground font-normal">(optional)</span></label>
							@components.Input(templ.Attributes{
								"id":          "wiki-message",
								"type":        "text",
								"name":        "message",
								"placeholder": "Update " + data.Slug,
							})
						</div>

						<div id="wiki-edit-error" role="alert" class="hidden text-sm text-destructive bg-destructive/10 border border-destructive/40 rounded-md px-3 py-2"></div>

						<div class="flex items-center gap-3 pt-1">
							@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
								Save page
							}
							@components.LinkButton("/"+data.Owner+"/"+data.RepoName+"/wiki/"+data.Slug, components.ButtonGhost, components.ButtonSizeDefault, nil) {
								Cancel
							}
						</div>
					</form>
				</article>
			</div>

		</div>

		<script>
			(function() {
				var wrap = document.getElementById('wiki-edit-form');
				var form = wrap && wrap.querySelector('form');
				var errBox = document.getElementById('wiki-edit-error');
				if (!form) return;
				var owner = wrap.dataset.owner;
				var repo  = wrap.dataset.repo;
				var slug  = wrap.dataset.slug;
				form.addEventListener('submit', async function(e) {
					e.preventDefault();
					errBox.classList.add('hidden');
					var content = form.querySelector('[name=content]').value;
					var message = form.querySelector('[name=message]').value;
					var newSlug = form.querySelector('[name=new_slug]').value;
					var csrf = (document.cookie.match(/csrf_token=([^;]+)/) || [])[1] || '';
					var body = new URLSearchParams();
					body.set('content', content);
					body.set('message', message);
					body.set('new_slug', newSlug);
					var res = await fetch('/api/repos/' + owner + '/' + repo + '/wiki/' + slug, {
						method: 'POST',
						headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': csrf },
						body: body.toString(),
					});
					if (res.ok || res.redirected) {
						sessionStorage.setItem('cz-toast', JSON.stringify({type: 'success', message: 'Wiki page saved'}));
						if (res.redirected) { window.location.href = res.url; return; }
						window.location.href = '/' + owner + '/' + repo + '/wiki/' + slug;
						return;
					}
					var text = await res.text();
					var msg = text;
					try { msg = JSON.parse(text).error || text; } catch (_) {}
					errBox.textContent = msg || ('Failed to save page (HTTP ' + res.status + ')');
					errBox.classList.remove('hidden');
				});
			})();
		</script>
	}
}
