package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ WikiEdit(data view.WikiEditData) {
	@layout.Base(data.BasePage, "Edit "+data.Slug+" — Wiki — "+data.RepoName+" — Cloudzilla") {
		<div class="max-w-4xl mx-auto px-4 py-8">
			<div class="mb-4">
				<nav class="text-sm text-muted-foreground mb-2" aria-label="Breadcrumb">
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="hover:underline">{ data.RepoName }</a>
					<span class="mx-1" aria-hidden="true">/</span>
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/wiki") } class="hover:underline">Wiki</a>
					<span class="mx-1" aria-hidden="true">/</span>
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/wiki/" + data.Slug) } class="hover:underline">{ data.Slug }</a>
				</nav>
				<h1 class="text-2xl font-bold">Editing: { data.Slug }</h1>
			</div>
			<form method="POST" action={ templ.SafeURL("/api/repos/" + data.Owner + "/" + data.RepoName + "/wiki/" + data.Slug) } class="space-y-4">
				<div>
					<label for="wiki-content" class="block text-sm font-medium text-foreground mb-1">Content (Markdown)</label>
					<textarea
						id="wiki-content"
						name="content"
						rows="24"
						class="flex min-h-[80px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm placeholder:text-muted-foreground font-mono"
					>{ data.Content }</textarea>
				</div>
				<div>
					<label for="wiki-message" class="block text-sm font-medium text-foreground mb-1">Commit message (optional)</label>
					@components.Input(templ.Attributes{
						"id":          "wiki-message",
						"type":        "text",
						"name":        "message",
						"placeholder": "Update " + data.Slug,
					})
				</div>
				<div class="flex gap-3">
					@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
						Save page
					}
					@components.LinkButton("/"+data.Owner+"/"+data.RepoName+"/wiki/"+data.Slug, components.ButtonOutline, components.ButtonSizeDefault, nil) {
						Cancel
					}
				</div>
			</form>
		</div>
	}
}
