package pages

import (
	"github.com/mkappworks/cloudzilla/internal/view"
	"github.com/mkappworks/cloudzilla/internal/view/layout"
)

templ WikiEdit(data view.WikiEditData) {
	@layout.Base(data.BasePage, "Edit "+data.Slug+" — Wiki — "+data.RepoName+" — Cloudzilla") {
		<div class="max-w-4xl mx-auto px-4 py-8">
			<div class="mb-4">
				<nav class="text-sm text-gray-500 mb-2">
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="hover:underline">{ data.RepoName }</a>
					<span class="mx-1">/</span>
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/wiki") } class="hover:underline">Wiki</a>
					<span class="mx-1">/</span>
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/wiki/" + data.Slug) } class="hover:underline">{ data.Slug }</a>
				</nav>
				<h1 class="text-2xl font-bold">Editing: { data.Slug }</h1>
			</div>
			<form method="POST" action={ templ.SafeURL("/api/repos/" + data.Owner + "/" + data.RepoName + "/wiki/" + data.Slug) } class="space-y-4">
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Content (Markdown)</label>
					<textarea name="content" rows="24" class="w-full border border-gray-300 rounded px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-400">{ data.Content }</textarea>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700 mb-1">Commit message (optional)</label>
					<input type="text" name="message" placeholder={ "Update " + data.Slug } class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400"/>
				</div>
				<div class="flex gap-3">
					<button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded text-sm hover:bg-blue-700">Save page</button>
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/wiki/" + data.Slug) } class="px-4 py-2 border border-gray-300 rounded text-sm hover:bg-gray-100">Cancel</a>
				</div>
			</form>
		</div>
	}
}
