package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/fragments"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ SavedReplies(data view.SavedRepliesData) {
	@layout.Base(data.BasePage, "Saved Replies — Cloudzilla") {
		<div class="space-y-8 max-w-2xl">
			<div>
				<h1 class="text-3xl font-bold mb-2">Saved Replies</h1>
				<p class="text-gray-600">Create reusable snippets to quickly insert into issue and pull request comments.</p>
			</div>
			<!-- Create form -->
			<div class="bg-white border border-gray-200 rounded-lg p-6">
				<h2 class="text-xl font-bold mb-4">New Saved Reply</h2>
				<form hx-post="/api/user/replies" hx-target="#saved-replies-list" hx-swap="outerHTML" class="space-y-4">
					<div>
						<label for="reply-title" class="block text-sm font-medium text-gray-700 mb-1">Title</label>
						<input type="text" id="reply-title" name="title" placeholder="e.g., Thank you for your report" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" required/>
					</div>
					<div>
						<label for="reply-body" class="block text-sm font-medium text-gray-700 mb-1">Content</label>
						<textarea id="reply-body" name="body" rows="4" placeholder="Your reusable comment text..." class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" required></textarea>
					</div>
					<button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">Add saved reply</button>
				</form>
			</div>
			<!-- Existing replies list (HTMX swap target) -->
			@fragments.SavedRepliesList(view.SavedRepliesFragData{Replies: data.Replies})
		</div>
	}
}
