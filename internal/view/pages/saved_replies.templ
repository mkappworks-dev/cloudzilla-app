package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/fragments"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ SavedReplies(data view.SavedRepliesData) {
	@layout.Base(data.BasePage, "Saved Replies — Cloudzilla") {
		<div class="space-y-8 max-w-2xl">
			<div>
				<h1 class="text-3xl font-semibold tracking-tight mb-2">Saved Replies</h1>
				<p class="text-muted-foreground">Create reusable snippets to quickly insert into issue and pull request comments.</p>
			</div>
			<!-- Create form -->
			@components.Card(nil) {
				@components.CardHeader() {
					@components.CardTitle(2) {
						New Saved Reply
					}
				}
				@components.CardContent() {
					<form hx-post="/api/user/replies" hx-target="#saved-replies-list" hx-swap="outerHTML" class="space-y-4">
						<div class="space-y-1.5">
							<label for="reply-title" class="block text-sm font-medium text-foreground">Title</label>
							@components.Input(templ.Attributes{
								"id":          "reply-title",
								"type":        "text",
								"name":        "title",
								"placeholder": "e.g., Thank you for your report",
								"required":    "required",
							})
						</div>
						<div class="space-y-1.5">
							<label for="reply-body" class="block text-sm font-medium text-foreground">Content</label>
							@components.Textarea(templ.Attributes{
								"id":          "reply-body",
								"name":        "body",
								"rows":        "4",
								"placeholder": "Your reusable comment text...",
								"required":    "required",
							})
						</div>
						@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
							Add saved reply
						}
					</form>
				}
			}
			<!-- Existing replies list (HTMX swap target) -->
			@fragments.SavedRepliesList(view.SavedRepliesFragData{Replies: data.Replies})
		</div>
	}
}
