package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ GistDetail(data view.GistDetailData) {
	@layout.Base(data.BasePage, gistDetailTitle(data)) {
		<div class="max-w-4xl mx-auto py-8 px-4">
			<div class="flex items-center justify-between mb-4">
				<div>
					<h1 class="text-xl font-bold">
						if data.Gist.Description != "" {
							{ data.Gist.Description }
						} else {
							<span class="text-gray-400 italic">No description</span>
						}
					</h1>
					<div class="text-sm text-gray-500 mt-1">
						by <a href={ templ.SafeURL("/" + data.Gist.OwnerName) } class="hover:underline">{ data.Gist.OwnerName }</a>
						&middot; { data.Gist.CreatedAt.Format("Jan 2, 2006") } &middot;
						if data.Gist.Public {
							<span class="text-green-600">Public</span>
						} else {
							<span class="text-yellow-600">Secret</span>
						}
					</div>
				</div>
				if data.IsOwner {
					<div class="flex gap-2">
						<a href={ templ.SafeURL("/gists/" + data.Gist.ID + "/edit") } class="px-3 py-1 border rounded text-sm hover:bg-gray-50">Edit</a>
						<button
							hx-delete={ "/api/gists/" + data.Gist.ID }
							hx-confirm="Delete this gist?"
							hx-on::after-request="window.location.href='/gists'"
							class="px-3 py-1 border border-red-300 text-red-600 rounded text-sm hover:bg-red-50"
						>Delete</button>
					</div>
				}
			</div>
			for _, f := range data.Files {
				<div class="border border-gray-200 rounded mb-4">
					<div class="bg-gray-50 border-b border-gray-200 px-4 py-2 text-sm font-mono font-medium">{ f.Filename }</div>
					<pre class="p-4 text-sm overflow-x-auto font-mono whitespace-pre-wrap"><code>{ f.Content }</code></pre>
				</div>
			}
		</div>
	}
}

func gistDetailTitle(data view.GistDetailData) string {
	if data.Gist.Description != "" {
		return data.Gist.Description
	}
	return "Gist " + data.Gist.ID
}
