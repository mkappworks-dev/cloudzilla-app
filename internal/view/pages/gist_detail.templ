package pages

import (
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ GistDetail(data view.GistDetailData) {
	@layout.Base(data.BasePage, gistDetailTitle(data)) {
		<div class="max-w-4xl mx-auto py-8 px-4">
			<div class="flex items-center justify-between mb-4">
				<div>
					<h1 class="text-xl font-bold">
						if data.Gist.Description != "" {
							{ data.Gist.Description }
						} else {
							<span class="text-muted-foreground italic">No description</span>
						}
					</h1>
					<div class="text-sm text-muted-foreground mt-1">
						by <a href={ templ.SafeURL("/" + data.Gist.OwnerName) } class="hover:underline">{ data.Gist.OwnerName }</a>
						&middot; <time datetime={ data.Gist.CreatedAt.UTC().Format(time.RFC3339) }>{ data.Gist.CreatedAt.Format("Jan 2, 2006") }</time> &middot;
						if data.Gist.Public {
							<span class="text-success">Public</span>
						} else {
							<span class="text-warning">Secret</span>
						}
					</div>
				</div>
				if data.IsOwner {
					<div class="flex gap-2">
						@components.LinkButton("/gists/"+data.Gist.ID+"/edit", components.ButtonOutline, components.ButtonSizeSM, nil) {
							Edit
						}
						@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{
							"hx-delete":             "/api/gists/" + data.Gist.ID,
							"hx-confirm":            "Delete this gist?",
							"hx-on::after-request":  "window.location.href='/gists'",
							"class":                 "text-destructive border-destructive/40 hover:bg-destructive/10",
						}) {
							Delete
						}
					</div>
				}
			</div>
			for _, f := range data.Files {
				<div class="rounded-md border border-border bg-card mb-4">
					<div class="bg-muted border-b border-border px-4 py-2 text-sm font-mono font-medium">{ f.Filename }</div>
					<pre class="p-4 text-sm overflow-x-auto font-mono whitespace-pre-wrap"><code>{ f.Content }</code></pre>
				</div>
			}
		</div>
	}
}

func gistDetailTitle(data view.GistDetailData) string {
	if data.Gist.Description != "" {
		return data.Gist.Description
	}
	return "Gist " + data.Gist.ID
}
