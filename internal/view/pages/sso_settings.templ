package pages

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/model"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ SSOSettings(data view.SSOSettingsData) {
	@layout.Base(data.BasePage, "SSO Settings — Cloudzilla") {
		<div class="space-y-6">
			if data.Confirm.Any() {
				@components.ConfirmIdentityDialog(data.Confirm)
			}
			@adminTabs("/admin/sso")
			<div>
				<h1 class="text-2xl font-semibold tracking-tight">Single Sign-On</h1>
				<p class="text-muted-foreground text-sm mt-1">Configure LDAP and SAML authentication providers.</p>
			</div>
			if data.Success != "" {
				<div class="p-4 border border-success/40 bg-success/10 rounded-md text-success text-sm">{ data.Success }</div>
			}
			if data.Error != "" {
				<div class="p-4 border border-destructive/40 bg-destructive/10 rounded-md text-destructive text-sm">{ data.Error }</div>
			}
			<!-- LDAP Configuration -->
			@components.Card(nil) {
				@components.CardHeader() {
					<div class="flex items-center justify-between">
						<div class="flex flex-col space-y-1.5">
							@components.CardTitle(2) {
								LDAP
							}
							@components.CardDescription() {
								Authenticate users via LDAP simple bind.
							}
						</div>
						@ssoSwitch("ldap", "LDAP", data.LDAPConfig, "Needs a host and bind DN template")
					</div>
				}
				@components.CardContent() {
					<form id="sso-ldap-form" method="POST" action="/admin/sso" data-toast="LDAP settings saved" data-confirm-identity="Save LDAP Settings" class="space-y-4">
						<input type="hidden" name="provider" value="ldap"/>
						<div class="grid grid-cols-2 gap-4">
							<div class="space-y-1.5">
								<label for="ldap_host" class="block text-sm font-medium text-foreground">Host</label>
								if data.LDAPConfig != nil {
									@components.Input(templ.Attributes{
										"id":    "ldap_host",
										"type":  "text",
										"name":  "ldap_host",
										"value": data.LDAPConfig.Config["host"],
									})
								} else {
									@components.Input(templ.Attributes{
										"id":   "ldap_host",
										"type": "text",
										"name": "ldap_host",
									})
								}
							</div>
							<div class="space-y-1.5">
								<label for="ldap_port" class="block text-sm font-medium text-foreground">Port</label>
								if data.LDAPConfig != nil {
									@components.Input(templ.Attributes{
										"id":          "ldap_port",
										"type":        "text",
										"name":        "ldap_port",
										"value":       data.LDAPConfig.Config["port"],
										"placeholder": "389",
									})
								} else {
									@components.Input(templ.Attributes{
										"id":          "ldap_port",
										"type":        "text",
										"name":        "ldap_port",
										"placeholder": "389",
									})
								}
							</div>
						</div>
						<div class="space-y-1.5">
							<label for="ldap_base_dn" class="block text-sm font-medium text-foreground">Base DN</label>
							if data.LDAPConfig != nil {
								@components.Input(templ.Attributes{
									"id":          "ldap_base_dn",
									"type":        "text",
									"name":        "ldap_base_dn",
									"value":       data.LDAPConfig.Config["base_dn"],
									"placeholder": "dc=example,dc=com",
								})
							} else {
								@components.Input(templ.Attributes{
									"id":          "ldap_base_dn",
									"type":        "text",
									"name":        "ldap_base_dn",
									"placeholder": "dc=example,dc=com",
								})
							}
						</div>
						<div class="space-y-1.5">
							<label for="ldap_bind_dn_tmpl" class="block text-sm font-medium text-foreground">Bind DN Template</label>
							if data.LDAPConfig != nil {
								@components.Input(templ.Attributes{
									"id":          "ldap_bind_dn_tmpl",
									"type":        "text",
									"name":        "ldap_bind_dn_tmpl",
									"value":       data.LDAPConfig.Config["bind_dn_tmpl"],
									"placeholder": "uid=%s,ou=people,dc=example,dc=com",
								})
							} else {
								@components.Input(templ.Attributes{
									"id":          "ldap_bind_dn_tmpl",
									"type":        "text",
									"name":        "ldap_bind_dn_tmpl",
									"placeholder": "uid=%s,ou=people,dc=example,dc=com",
								})
							}
						</div>
						<label class="flex w-fit items-center gap-2 text-sm text-foreground cursor-pointer">
							@components.Checkbox(templ.Attributes{
								"id":      "ldap_use_tls",
								"name":    "ldap_use_tls",
								"value":   "true",
								"checked": data.LDAPConfig != nil && data.LDAPConfig.Config["use_tls"] == "true",
							})
							<span>Use TLS</span>
						</label>
						if data.LDAPConfig != nil && data.LDAPConfig.Enabled && data.LDAPConfig.Config["use_tls"] != "true" {
							<p class="text-xs text-warning border border-warning/40 bg-warning/10 rounded-sm px-3 py-2">
								Warning: TLS is disabled. LDAP credentials will be transmitted in plaintext. Enable TLS or use an ldaps:// host for production use.
							</p>
						}
					</form>
				}
				@components.CardFooter() {
					<div class="ml-auto">
						@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit", "form": "sso-ldap-form"}) {
							Save LDAP Settings
						}
					</div>
				}
			}
			<!-- SAML Configuration -->
			@components.Card(nil) {
				@components.CardHeader() {
					<div class="flex items-center justify-between">
						<div class="flex flex-col space-y-1.5">
							@components.CardTitle(2) {
								SAML 2.0
							}
							@components.CardDescription() {
								Authenticate users via SAML 2.0 HTTP-POST binding.
							}
						</div>
						@ssoSwitch("saml", "SAML", data.SAMLConfig, "Needs an entity ID, IdP SSO URL, ACS URL and certificate")
					</div>
				}
				@components.CardContent() {
					<form id="sso-saml-form" method="POST" action="/admin/sso" data-toast="SAML settings saved" data-confirm-identity="Save SAML Settings" class="space-y-4">
						<input type="hidden" name="provider" value="saml"/>
						<div class="space-y-1.5">
							<label for="saml_entity_id" class="block text-sm font-medium text-foreground">Entity ID</label>
							if data.SAMLConfig != nil {
								@components.Input(templ.Attributes{
									"id":    "saml_entity_id",
									"type":  "text",
									"name":  "saml_entity_id",
									"value": data.SAMLConfig.Config["entity_id"],
								})
							} else {
								@components.Input(templ.Attributes{
									"id":   "saml_entity_id",
									"type": "text",
									"name": "saml_entity_id",
								})
							}
						</div>
						<div class="space-y-1.5">
							<label for="saml_sso_url" class="block text-sm font-medium text-foreground">IdP SSO URL</label>
							@components.Input(templ.Attributes{
								"id":    "saml_sso_url",
								"type":  "text",
								"name":  "saml_sso_url",
								"value": samlSSOURL(data.SAMLConfig),
							})
						</div>
						<div class="space-y-1.5">
							<label for="saml_acs_url" class="block text-sm font-medium text-foreground">Assertion Consumer Service URL</label>
							if data.SAMLConfig != nil {
								@components.Input(templ.Attributes{
									"id":          "saml_acs_url",
									"type":        "text",
									"name":        "saml_acs_url",
									"value":       data.SAMLConfig.Config["acs_url"],
									"placeholder": "https://yourdomain/auth/saml/callback",
								})
							} else {
								@components.Input(templ.Attributes{
									"id":          "saml_acs_url",
									"type":        "text",
									"name":        "saml_acs_url",
									"placeholder": "https://yourdomain/auth/saml/callback",
								})
							}
						</div>
						<div class="space-y-1.5">
							<label for="saml_idp_cert" class="block text-sm font-medium text-foreground">IdP Certificate (base64, no headers)</label>
							if data.SAMLConfig != nil {
								<textarea id="saml_idp_cert" name="saml_idp_cert" rows="4" class="flex min-h-[80px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm font-mono shadow-xs placeholder:text-muted-foreground">{ data.SAMLConfig.Config["idp_cert"] }</textarea>
							} else {
								@components.Textarea(templ.Attributes{
									"id":    "saml_idp_cert",
									"name":  "saml_idp_cert",
									"rows":  "4",
									"class": "font-mono",
								})
							}
						</div>
					</form>
				}
				@components.CardFooter() {
					<div class="ml-auto flex items-center gap-2">
						if data.SAMLConfig != nil && data.SAMLConfig.Enabled {
							@components.LinkButton("/auth/saml/metadata", components.ButtonOutline, components.ButtonSizeDefault, templ.Attributes{"target": "_blank"}) {
								View SP Metadata
							}
						}
						@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit", "form": "sso-saml-form"}) {
							Save SAML Settings
						}
					</div>
				}
			}
		</div>
	}
}

// ssoSwitch turns a provider on or off by itself, confirmed like the settings.
// It can't turn on until cfg is Ready, but a provider that's on can always go off.
templ ssoSwitch(provider, name string, cfg *model.SSOConfig, needs string) {
	<div class="flex items-center gap-3">
		if !cfg.Ready() {
			<span id={ provider + "-switch-needs" } class="text-[12px] text-muted-foreground">{ needs }</span>
		}
		if cfg.Ready() || (cfg != nil && cfg.Enabled) {
			<form
				hx-post={ "/api/admin/sso/" + provider + "/enabled" }
				hx-swap="none"
				hx-on::after:request="if(event.target===this&&ctx.response.status>=400){this.reset();}"
				data-toast={ ssoSwitchToast(name, cfg.Enabled) }
				data-confirm-identity={ ssoSwitchAction(name, cfg.Enabled) }
				data-confirm-reset
			>
				<input type="hidden" name="enabled" value={ strconv.FormatBool(!cfg.Enabled) }/>
				<label class="flex items-center cursor-pointer">
					<span class="sr-only">{ "Enable " + name + " authentication" }</span>
					@components.Switch(ssoSwitchAttrs(provider, cfg))
				</label>
			</form>
		} else {
			<label class="flex items-center">
				<span class="sr-only">{ "Enable " + name + " authentication" }</span>
				@components.Switch(templ.Attributes{
					"id":               provider + "_enabled",
					"disabled":         true,
					"aria-describedby": provider + "-switch-needs",
				})
			</label>
		}
	</div>
}

func ssoSwitchAction(name string, on bool) string {
	if on {
		return "Turn off " + name
	}
	return "Turn on " + name
}

func ssoSwitchToast(name string, on bool) string {
	if on {
		return name + " turned off"
	}
	return name + " turned on"
}

func ssoSwitchAttrs(provider string, cfg *model.SSOConfig) templ.Attributes {
	attrs := templ.Attributes{"id": provider + "_enabled", "checked": cfg.Enabled, "onchange": "this.form.requestSubmit()"}
	if !cfg.Ready() {
		attrs["aria-describedby"] = provider + "-switch-needs"
	}
	return attrs
}

// samlSSOURL falls back to metadata_url, where this field saved the URL before.
func samlSSOURL(cfg *model.SSOConfig) string {
	if cfg == nil {
		return ""
	}
	if u := cfg.Config[model.SAMLKeySSOURL]; u != "" {
		return u
	}
	return cfg.Config[model.SAMLKeyMetadataURL]
}
