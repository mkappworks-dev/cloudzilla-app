package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ SSOSettings(data view.SSOSettingsData) {
	@layout.Base(data.BasePage, "SSO Settings — Cloudzilla") {
		<div class="space-y-8 max-w-3xl">
			<div class="flex items-center justify-between">
				<div>
					<h1 class="text-3xl font-bold">Single Sign-On</h1>
					<p class="text-gray-600 text-sm mt-1">Configure LDAP and SAML authentication providers.</p>
				</div>
				<a href="/admin/settings" class="text-sm text-blue-600 hover:underline">Back to Admin</a>
			</div>
			if data.Success != "" {
				<div class="p-4 bg-green-50 border border-green-200 rounded-lg text-green-800 text-sm">{ data.Success }</div>
			}
			if data.Error != "" {
				<div class="p-4 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm">{ data.Error }</div>
			}
			<!-- LDAP Configuration -->
			<div class="bg-white border border-gray-200 rounded-lg p-6">
				<div class="flex items-center justify-between mb-6">
					<div>
						<h2 class="text-xl font-bold">LDAP</h2>
						<p class="text-gray-600 text-sm mt-1">Authenticate users via LDAP simple bind.</p>
					</div>
					if data.LDAPConfig != nil && data.LDAPConfig.Enabled {
						<span class="px-3 py-1 bg-green-100 text-green-800 text-sm font-medium rounded-full">Enabled</span>
					} else {
						<span class="px-3 py-1 bg-gray-100 text-gray-600 text-sm font-medium rounded-full">Disabled</span>
					}
				</div>
				<form method="POST" action="/admin/sso" class="space-y-4">
					<input type="hidden" name="provider" value="ldap"/>
					<div class="grid grid-cols-2 gap-4">
						<div>
							<label for="ldap_host" class="block text-sm font-medium text-gray-700 mb-1">Host</label>
							if data.LDAPConfig != nil {
								<input type="text" id="ldap_host" name="ldap_host" value={ data.LDAPConfig.Config["host"] } class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
							} else {
								<input type="text" id="ldap_host" name="ldap_host" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
							}
						</div>
						<div>
							<label for="ldap_port" class="block text-sm font-medium text-gray-700 mb-1">Port</label>
							if data.LDAPConfig != nil {
								<input type="text" id="ldap_port" name="ldap_port" value={ data.LDAPConfig.Config["port"] } placeholder="389" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
							} else {
								<input type="text" id="ldap_port" name="ldap_port" placeholder="389" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
							}
						</div>
					</div>
					<div>
						<label for="ldap_base_dn" class="block text-sm font-medium text-gray-700 mb-1">Base DN</label>
						if data.LDAPConfig != nil {
							<input type="text" id="ldap_base_dn" name="ldap_base_dn" value={ data.LDAPConfig.Config["base_dn"] } placeholder="dc=example,dc=com" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						} else {
							<input type="text" id="ldap_base_dn" name="ldap_base_dn" placeholder="dc=example,dc=com" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						}
					</div>
					<div>
						<label for="ldap_bind_dn_tmpl" class="block text-sm font-medium text-gray-700 mb-1">Bind DN Template</label>
						if data.LDAPConfig != nil {
							<input type="text" id="ldap_bind_dn_tmpl" name="ldap_bind_dn_tmpl" value={ data.LDAPConfig.Config["bind_dn_tmpl"] } placeholder="uid=%s,ou=people,dc=example,dc=com" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						} else {
							<input type="text" id="ldap_bind_dn_tmpl" name="ldap_bind_dn_tmpl" placeholder="uid=%s,ou=people,dc=example,dc=com" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						}
					</div>
					<div class="flex items-center gap-2">
						if data.LDAPConfig != nil && data.LDAPConfig.Config["use_tls"] == "true" {
							<input type="checkbox" id="ldap_use_tls" name="ldap_use_tls" value="true" checked class="h-4 w-4 text-blue-600 border-gray-300 rounded"/>
						} else {
							<input type="checkbox" id="ldap_use_tls" name="ldap_use_tls" value="true" class="h-4 w-4 text-blue-600 border-gray-300 rounded"/>
						}
						<label for="ldap_use_tls" class="text-sm text-gray-700">Use TLS</label>
					</div>
					if data.LDAPConfig != nil && data.LDAPConfig.Enabled && data.LDAPConfig.Config["use_tls"] != "true" {
						<p class="text-xs text-amber-700 bg-amber-50 border border-amber-200 rounded px-3 py-2">
							Warning: TLS is disabled. LDAP credentials will be transmitted in plaintext. Enable TLS or use an ldaps:// host for production use.
						</p>
					}
					<div class="flex items-center gap-2">
						if data.LDAPConfig != nil && data.LDAPConfig.Enabled {
							<input type="checkbox" id="ldap_enabled" name="enabled" value="true" checked class="h-4 w-4 text-blue-600 border-gray-300 rounded"/>
						} else {
							<input type="checkbox" id="ldap_enabled" name="enabled" value="true" class="h-4 w-4 text-blue-600 border-gray-300 rounded"/>
						}
						<label for="ldap_enabled" class="text-sm text-gray-700">Enable LDAP authentication</label>
					</div>
					<button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-md text-sm hover:bg-blue-700 transition-colors font-medium">
						Save LDAP Settings
					</button>
				</form>
			</div>
			<!-- SAML Configuration -->
			<div class="bg-white border border-gray-200 rounded-lg p-6">
				<div class="flex items-center justify-between mb-6">
					<div>
						<h2 class="text-xl font-bold">SAML 2.0</h2>
						<p class="text-gray-600 text-sm mt-1">Authenticate users via SAML 2.0 HTTP-POST binding.</p>
					</div>
					if data.SAMLConfig != nil && data.SAMLConfig.Enabled {
						<span class="px-3 py-1 bg-green-100 text-green-800 text-sm font-medium rounded-full">Enabled</span>
					} else {
						<span class="px-3 py-1 bg-gray-100 text-gray-600 text-sm font-medium rounded-full">Disabled</span>
					}
				</div>
				<form method="POST" action="/admin/sso" class="space-y-4">
					<input type="hidden" name="provider" value="saml"/>
					<div>
						<label for="saml_entity_id" class="block text-sm font-medium text-gray-700 mb-1">Entity ID</label>
						if data.SAMLConfig != nil {
							<input type="text" id="saml_entity_id" name="saml_entity_id" value={ data.SAMLConfig.Config["entity_id"] } class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						} else {
							<input type="text" id="saml_entity_id" name="saml_entity_id" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						}
					</div>
					<div>
						<label for="saml_metadata_url" class="block text-sm font-medium text-gray-700 mb-1">IdP SSO URL / Metadata URL</label>
						if data.SAMLConfig != nil {
							<input type="text" id="saml_metadata_url" name="saml_metadata_url" value={ data.SAMLConfig.Config["metadata_url"] } class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						} else {
							<input type="text" id="saml_metadata_url" name="saml_metadata_url" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						}
					</div>
					<div>
						<label for="saml_acs_url" class="block text-sm font-medium text-gray-700 mb-1">Assertion Consumer Service URL</label>
						if data.SAMLConfig != nil {
							<input type="text" id="saml_acs_url" name="saml_acs_url" value={ data.SAMLConfig.Config["acs_url"] } placeholder="https://yourdomain/auth/saml/callback" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						} else {
							<input type="text" id="saml_acs_url" name="saml_acs_url" placeholder="https://yourdomain/auth/saml/callback" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						}
					</div>
					<div>
						<label for="saml_idp_cert" class="block text-sm font-medium text-gray-700 mb-1">IdP Certificate (base64, no headers)</label>
						if data.SAMLConfig != nil {
							<textarea id="saml_idp_cert" name="saml_idp_cert" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-500">{ data.SAMLConfig.Config["idp_cert"] }</textarea>
						} else {
							<textarea id="saml_idp_cert" name="saml_idp_cert" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
						}
					</div>
					<div class="flex items-center gap-2">
						if data.SAMLConfig != nil && data.SAMLConfig.Enabled {
							<input type="checkbox" id="saml_enabled" name="enabled" value="true" checked class="h-4 w-4 text-blue-600 border-gray-300 rounded"/>
						} else {
							<input type="checkbox" id="saml_enabled" name="enabled" value="true" class="h-4 w-4 text-blue-600 border-gray-300 rounded"/>
						}
						<label for="saml_enabled" class="text-sm text-gray-700">Enable SAML authentication</label>
					</div>
					<div class="flex gap-3">
						<button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-md text-sm hover:bg-blue-700 transition-colors font-medium">
							Save SAML Settings
						</button>
						if data.SAMLConfig != nil && data.SAMLConfig.Enabled {
							<a href="/auth/saml/metadata" target="_blank" class="px-4 py-2 border border-gray-300 text-gray-700 rounded-md text-sm hover:bg-gray-50 transition-colors">
								View SP Metadata
							</a>
						}
					</div>
				</form>
			</div>
		</div>
	}
}
