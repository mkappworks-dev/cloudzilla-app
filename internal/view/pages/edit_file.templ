package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/codeurl"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/fragments"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ EditFile(data view.EditFileData) {
	@layout.Base(data.BasePage, "Editing "+data.Path+" · "+data.Owner+"/"+data.RepoName) {
		<div class="space-y-6 max-w-5xl">
			<section aria-labelledby="editfile-title">
				<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="hover:underline">{ data.RepoName }</a>
					<span aria-hidden="true">·</span>
					Edit file
				</p>
				<h1 id="editfile-title" class="text-2xl font-semibold tracking-tight break-all">Editing { data.Path }</h1>
				<p class="text-[13px] text-muted-foreground mt-1">
					Committing to
					<span class="font-mono text-foreground">{ data.Ref }</span>
				</p>
			</section>

			if data.Error != "" {
				<div role="alert" class="text-sm text-destructive bg-destructive/10 border border-destructive/40 rounded-md px-3 py-2">
					<p>{ data.Error }</p>
				</div>
			}
			if data.Notice != "" {
				<div role="status" class="text-sm bg-muted/50 border border-border rounded-md px-3 py-2">
					<p>{ data.Notice }</p>
				</div>
			}
			if data.Upstream != nil {
				<section aria-labelledby="editfile-upstream" class="space-y-2">
					<h2 id="editfile-upstream" class="text-[13px] font-medium">
						Changed on <span class="font-mono">{ data.Ref }</span> since you opened this file
					</h2>
					@fragments.FileDiff(*data.Upstream)
				</section>
			}

			<form
				id="editfile-form"
				method="POST"
				action={ templ.SafeURL(codeurl.Path(data.Owner, data.RepoName, "edit", data.Ref, data.Path)) }
				enctype="multipart/form-data"
				data-validate
				x-data={ editTargetState(data) }
				class="space-y-5"
			>
				<input type="hidden" name="blob_sha" value={ data.BlobSHA }/>
				if data.UpstreamSHA != "" {
					<input type="hidden" name="upstream_sha" value={ data.UpstreamSHA }/>
				}
				<div class="rounded-md border border-border bg-card" x-data="{ tab: 'edit', failed(e) { const r = e.detail.ctx.response; if (!r || r.status >= 400) this.$refs.result.textContent = 'Couldn\u2019t load the preview.' } }">
					<div class="flex items-center border-b border-border px-3">
						<div
							role="tablist"
							aria-label="Edit mode"
							class="flex"
							@keydown.arrow-right.prevent="$refs[tab === 'edit' ? 'preview' : 'edit'].focus(); $refs[tab === 'edit' ? 'preview' : 'edit'].click()"
							@keydown.arrow-left.prevent="$refs[tab === 'edit' ? 'preview' : 'edit'].focus(); $refs[tab === 'edit' ? 'preview' : 'edit'].click()"
							@keydown.home.prevent="$refs.edit.focus(); $refs.edit.click()"
							@keydown.end.prevent="$refs.preview.focus(); $refs.preview.click()"
						>
							<button
								type="button"
								role="tab"
								id="ef-tab-edit"
								x-ref="edit"
								aria-selected="true"
								aria-controls="ef-pane-edit"
								:aria-selected="tab === 'edit'"
								:tabindex="tab === 'edit' ? 0 : -1"
								@click="tab = 'edit'"
								:class="tab === 'edit' ? 'border-foreground text-foreground font-medium' : 'border-transparent text-muted-foreground hover:text-foreground'"
								class="px-3 py-2 text-[13px] border-b-2 -mb-px"
							>Edit</button>
							<button
								type="button"
								role="tab"
								id="ef-tab-preview"
								x-ref="preview"
								aria-selected="false"
								aria-controls="ef-pane-preview"
								:aria-selected="tab === 'preview'"
								:tabindex="tab === 'preview' ? 0 : -1"
								hx-post={ codeurl.Path(data.Owner, data.RepoName, "edit-preview", data.Ref, data.Path) }
								hx-target="#ef-preview"
								hx-swap="innerHTML"
								@click="tab = 'preview'"
								@htmx:after:request="failed($event)"
								:class="tab === 'preview' ? 'border-foreground text-foreground font-medium' : 'border-transparent text-muted-foreground hover:text-foreground'"
								class="px-3 py-2 text-[13px] border-b-2 -mb-px"
							>Preview changes</button>
						</div>
					</div>
					<div id="ef-pane-edit" role="tabpanel" aria-labelledby="ef-tab-edit" x-show="tab === 'edit'" class="p-5 space-y-4">
						<div>
							<label for="ef-path" class="block text-[12px] font-medium mb-1.5">File path</label>
							<input
								id="ef-path"
								name="path"
								type="text"
								value={ data.NewPath }
								required
								class="w-full h-9 px-3 text-[13px] font-mono bg-background border border-input rounded-md focus:outline-hidden focus:ring-2 focus:ring-ring"
							/>
							<p class="text-[11px] text-muted-foreground mt-1">Change the path to rename or move the file.</p>
						</div>
						<div data-field>
							<label for="ef-content" class="block text-[12px] font-medium mb-1.5">Contents</label>
							<textarea
								id="ef-content"
								name="content"
								rows="24"
								spellcheck="false"
								class="w-full px-3 py-2 text-[13px] font-mono bg-background border border-input rounded-md focus:outline-hidden focus:ring-2 focus:ring-ring resize-y aria-invalid:border-destructive"
								{ components.Invalid(templ.Attributes{}, "ef-content", data.ContentError)... }
							>{ textareaValue(data.Content) }</textarea>
							@components.FieldError("ef-content", data.ContentError)
						</div>
					</div>
					<div id="ef-pane-preview" role="tabpanel" aria-labelledby="ef-tab-preview" x-show="tab === 'preview'" style="display: none" class="p-5">
						<div id="ef-preview" x-ref="result" aria-live="polite" class="text-sm text-muted-foreground">Loading preview…</div>
					</div>
				</div>

				<div class="rounded-md border border-border bg-card p-5 flex flex-col gap-5">
					<div>
						<label for="ef-message" class="block text-[12px] font-medium mb-1.5">Commit message</label>
						<input
							id="ef-message"
							name="message"
							type="text"
							value={ data.Message }
							placeholder={ "Update " + data.Path }
							class="w-full h-9 px-3 text-[13px] bg-background border border-input rounded-md placeholder:text-muted-foreground focus:outline-hidden focus:ring-2 focus:ring-ring"
						/>
					</div>
					<fieldset class="flex flex-col gap-3">
						<legend class="block text-[12px] font-medium mb-1.5">Commit to</legend>
						<label class={ "flex items-start gap-2.5 text-[13px]", templ.KV("opacity-60", data.DirectRefusal != "") }>
							<input
								type="radio"
								name="target"
								value="direct"
								x-model="target"
								checked?={ !data.NewBranchSelected() }
								disabled?={ data.DirectRefusal != "" }
								class="mt-0.5"
							/>
							<span>
								Commit directly to the <span class="font-mono">{ data.Ref }</span> branch
								if data.DirectRefusal != "" {
									<span class="block text-[12px] text-muted-foreground mt-0.5">{ data.DirectRefusal }</span>
								}
							</span>
						</label>
						<label class="flex items-start gap-2.5 text-[13px]">
							<input
								type="radio"
								name="target"
								value="branch"
								x-model="target"
								checked?={ data.NewBranchSelected() }
								class="mt-0.5"
							/>
							<span>Create a <strong class="font-medium">new branch</strong>{ " for this commit and open a pull request" }</span>
						</label>
						<div data-field x-show="target === 'branch'" class="ml-6">
							<label for="ef-branch" class="block text-[12px] font-medium mb-1.5">New branch name</label>
							<input type="hidden" name="suggested_branch" value={ data.SuggestedBranch }/>
							<input
								id="ef-branch"
								name="new_branch"
								type="text"
								value={ data.NewBranch }
								spellcheck="false"
								autocomplete="off"
								class="w-full max-w-sm h-9 px-3 text-[13px] font-mono bg-background border border-input rounded-md focus:outline-hidden focus:ring-2 focus:ring-ring aria-invalid:border-destructive"
								{ components.Invalid(templ.Attributes{}, "ef-branch", data.BranchError)... }
							/>
							@components.FieldError("ef-branch", data.BranchError)
						</div>
					</fieldset>
				</div>

				<div class="flex items-center justify-end gap-2">
					<a href={ templ.SafeURL(codeurl.Path(data.Owner, data.RepoName, "blob", data.Ref, data.Path)) } class="h-9 px-3 inline-flex items-center text-[13px] border border-border rounded-md hover:bg-accent">Cancel</a>
					<button type="submit" class="h-9 px-4 inline-flex items-center text-[13px] bg-primary text-primary-foreground rounded-md hover:bg-primary/90 font-medium" x-text="target === 'branch' ? 'Propose changes' : 'Commit changes'">Commit changes</button>
				</div>
			</form>
		</div>
	}
}

// textareaValue leads with a newline because the HTML parser drops one right
// after <textarea>, which would otherwise eat a file's leading blank line.
func textareaValue(content string) string {
	return "\n" + content
}

func editTargetState(data view.EditFileData) string {
	if data.NewBranchSelected() {
		return "{ target: 'branch' }"
	}
	return "{ target: 'direct' }"
}
