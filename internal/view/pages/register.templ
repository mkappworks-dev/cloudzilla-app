package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Register(data view.RegisterData) {
	@layout.Base(data.BasePage, "Register") {
		<div class="max-w-md mx-auto mt-12">
			<div class="bg-white border border-gray-200 rounded-lg shadow-md p-8">
				<h1 class="text-2xl font-bold mb-6">Create Account</h1>
				if data.Error != "" {
					<div class="mb-4 p-3 bg-red-50 border border-red-200 rounded text-red-700 text-sm">
						{ data.Error }
					</div>
				}
				<form method="POST" action="/register" class="space-y-4">
					<div>
						<label for="username" class="block text-sm font-medium text-gray-700 mb-1">Username</label>
						<input type="text" id="username" name="username" required value={ data.Username } class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"/>
					</div>
					<div>
						<label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
						<input type="email" id="email" name="email" required value={ data.Email } class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"/>
					</div>
					<div>
						<label for="password" class="block text-sm font-medium text-gray-700 mb-1">Password</label>
						<input type="password" id="password" name="password" required minlength="8" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"/>
					</div>
					<button type="submit" class="w-full px-4 py-2 bg-blue-600 text-white rounded-md font-medium hover:bg-blue-700 transition-colors">
						Create Account
					</button>
				</form>
				<p class="mt-6 text-center text-sm text-gray-500">
					Already have an account?
					<a href="/login" class="text-blue-600 hover:underline">Sign in</a>
				</p>
			</div>
		</div>
	}
}
