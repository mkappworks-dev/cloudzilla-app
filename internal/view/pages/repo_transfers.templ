package pages

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/service"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

func incomingTransfersLabel(n int) string {
	if n == 1 {
		return "1 repository is waiting for you to accept it"
	}
	return strconv.Itoa(n) + " repositories are waiting for you to accept them"
}

func transferExpiry(t time.Time) string {
	return "Expires " + t.UTC().Format("Jan 2, 2006 15:04 UTC")
}

func transferTTLDays() string {
	return strconv.Itoa(int(service.RepoTransferTTL.Hours() / 24))
}

// Form errors come back as 200 swaps, so the HX-Redirect or HX-Refresh header
// marks success. The target check skips requests that bubble up from inner
// controls, like the email-code button in ConfirmFields.
func stashToast(message string) string {
	return "if(event.target===this&&ctx.response.status<400&&(ctx.hx.redirect||ctx.hx.refresh==='true')){sessionStorage.setItem('cz-toast',JSON.stringify({type:'success',message:" + components.JSLiteral(message) + "}));}"
}

templ RepoTransfers(data view.RepoTransfersData) {
	@layout.Base(data.BasePage, "Repository transfers") {
		<section class="mb-6" aria-labelledby="transfers-title">
			<h1 id="transfers-title" class="text-2xl font-semibold tracking-tight">Repository transfers</h1>
			<p class="mt-1 text-[13px] text-muted-foreground">
				Repositories other users have offered you. Nothing moves until you accept, and an offer expires after { transferTTLDays() } days.
			</p>
		</section>
		if len(data.Transfers) == 0 {
			@components.EmptyState("No repositories are waiting for you.")
		} else {
			<ol class="space-y-4">
				for _, t := range data.Transfers {
					<li id={ "transfer-" + strconv.FormatInt(t.ID, 10) }>
						@repoTransferCard(t)
					</li>
				}
			</ol>
		}
	}
}

templ repoTransferCard(t view.IncomingRepoTransfer) {
	@components.Card(nil) {
		@components.CardHeader() {
			<h2 class="text-base font-semibold tracking-tight flex flex-wrap items-center gap-2">
				<span class="font-mono break-all">{ t.FullName() }</span>
				if t.Private {
					@components.Badge(components.BadgeOutline) {
						Private
					}
				} else {
					@components.Badge(components.BadgeSecondary) {
						Public
					}
				}
			</h2>
			@components.CardDescription() {
				<span class="font-mono">{ "@" + t.RequesterName }</span> wants to transfer this repository to you. It would become <span class="font-mono break-all">{ t.RecipientName + "/" + t.RepoName }</span>.
			}
		}
		@components.CardContent() {
			if t.Description != "" {
				<p class="text-[13px] mb-3">{ t.Description }</p>
			}
			if len(t.Collaborators) > 0 {
				<p class="text-[13px] font-medium">These collaborators keep their access if you accept:</p>
				<ul class="mt-1.5 flex flex-wrap gap-1.5">
					for _, c := range t.Collaborators {
						<li class="inline-flex items-center gap-1.5 rounded-md border border-border px-2 py-0.5 text-[12px]">
							<span class="font-mono">{ "@" + c.Username }</span>
							<span class="text-muted-foreground">{ string(c.Role) }</span>
						</li>
					}
				</ul>
				<p class="mt-1.5 text-[12px] text-muted-foreground">You can remove them from the repository's settings afterwards.</p>
			} else {
				<p class="text-[13px] text-muted-foreground">No one else has access to it.</p>
			}
			<p class="mt-3 text-[12px] text-muted-foreground">
				<time datetime={ t.ExpiresAt.UTC().Format(time.RFC3339) }>{ transferExpiry(t.ExpiresAt) }</time>
			</p>
		}
		@components.CardFooter() {
			<div class="flex flex-wrap items-center gap-2">
				<form
					hx-post={ "/api/user/transfers/" + strconv.FormatInt(t.ID, 10) + "/accept" }
					hx-swap="none"
					hx-confirm={ t.FullName() + " will move to your account as " + t.RecipientName + "/" + t.RepoName + "." }
					data-confirm-title="Accept this repository?"
					data-confirm-label="Accept"
					{ templ.Attributes{"hx-on::after:request": stashToast("Repository transferred to you")}... }
				>
					<input type="hidden" name="repo" value={ t.FullName() }/>
					@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
						Accept
					}
				</form>
				<form
					hx-post={ "/api/user/transfers/" + strconv.FormatInt(t.ID, 10) + "/decline" }
					hx-swap="none"
					{ templ.Attributes{"hx-on::after:request": stashToast("Transfer declined")}... }
				>
					@components.Button(components.ButtonOutline, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
						Decline
					}
				</form>
			</div>
		}
	}
}
