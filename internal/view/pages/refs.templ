package pages

import (
	"github.com/mkappworks/cloudzilla/internal/view"
	"github.com/mkappworks/cloudzilla/internal/view/layout"
)

templ Refs(data view.RefsData) {
	@layout.Base(data.BasePage, data.Owner+"/"+data.RepoName+" · Branches & Tags") {
		<div class="space-y-6">
			<div class="bg-white border border-gray-200 rounded-lg p-4">
				<div class="flex items-center gap-2 text-sm text-gray-600">
					<a href={ templ.SafeURL("/"+data.Owner) } class="hover:text-blue-600 hover:underline font-medium">{ data.Owner }</a>
					<span class="text-gray-400">/</span>
					<a href={ templ.SafeURL("/"+data.Owner+"/"+data.RepoName) } class="hover:text-blue-600 hover:underline font-medium">{ data.RepoName }</a>
					<span class="text-gray-400">/</span>
					<span class="font-medium text-gray-900">Branches &amp; Tags</span>
				</div>
			</div>
			<!-- Branches -->
			<div class="bg-white border border-gray-200 rounded-lg">
				<div class="px-4 py-3 border-b border-gray-200">
					<h2 class="font-semibold text-gray-900">Branches</h2>
				</div>
				<div id="branches-list">
					if len(data.Branches) > 0 {
						for _, b := range data.Branches {
							<div class="flex items-center justify-between px-4 py-3 hover:bg-gray-50 border-b border-gray-100 last:border-b-0">
								<div class="flex items-center gap-2 min-w-0">
									<a href={ templ.SafeURL("/"+data.Owner+"/"+data.RepoName+"/tree/"+b.Name) } class="font-mono text-sm text-blue-600 hover:underline truncate">{ b.Name }</a>
									if b.IsDefault {
										<span class="text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded shrink-0">default</span>
									}
									<span class="text-xs text-gray-400 font-mono shrink-0">{ b.Hash }</span>
								</div>
								<div class="flex items-center gap-3 ml-4 shrink-0">
									<a href={ templ.SafeURL("/"+data.Owner+"/"+data.RepoName+"/commits/"+b.Name) } class="text-xs text-gray-500 hover:text-blue-600">commits</a>
									if data.CanWrite && !b.IsDefault {
										<button hx-delete={ "/api/repos/"+data.Owner+"/"+data.RepoName+"/branches?name="+b.Name } hx-target="#branches-list" hx-swap="outerHTML" hx-confirm={ "Delete branch '"+b.Name+"'?" } class="text-xs text-red-600 hover:text-red-800 border border-red-200 px-2 py-1 rounded hover:bg-red-50">Delete</button>
									}
								</div>
							</div>
						}
					} else {
						<div class="px-4 py-8 text-center text-gray-500 text-sm">No branches yet.</div>
					}
				</div>
				if data.CanWrite {
					<div class="px-4 py-4 border-t border-gray-200 bg-gray-50">
						<form hx-post={ "/api/repos/"+data.Owner+"/"+data.RepoName+"/branches" } hx-target="#branches-list" hx-swap="outerHTML" class="flex flex-wrap gap-2 items-end">
							<div>
								<label class="block text-xs font-medium text-gray-600 mb-1">Branch name</label>
								<input name="name" placeholder="new-branch-name" required class="border border-gray-300 rounded px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"/>
							</div>
							<div>
								<label class="block text-xs font-medium text-gray-600 mb-1">From ref</label>
								<input name="from" value={ data.Repo.DefaultBranch } placeholder="branch, tag, or SHA" class="border border-gray-300 rounded px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"/>
							</div>
							<button type="submit" class="px-3 py-1.5 bg-blue-600 text-white rounded text-sm hover:bg-blue-700 transition-colors">
								Create Branch
							</button>
						</form>
					</div>
				}
			</div>
			<!-- Tags -->
			<div class="bg-white border border-gray-200 rounded-lg">
				<div class="px-4 py-3 border-b border-gray-200">
					<h2 class="font-semibold text-gray-900">Tags</h2>
				</div>
				<div id="tags-list">
					if len(data.Tags) > 0 {
						for _, t := range data.Tags {
							<div class="flex items-center justify-between px-4 py-3 hover:bg-gray-50 border-b border-gray-100 last:border-b-0">
								<div class="flex items-center gap-2 min-w-0">
									<a href={ templ.SafeURL("/"+data.Owner+"/"+data.RepoName+"/tree/"+t.Name) } class="font-mono text-sm text-blue-600 hover:underline truncate">{ t.Name }</a>
									<span class="text-xs text-gray-400 font-mono shrink-0">{ t.Hash }</span>
								</div>
								<div class="flex items-center gap-3 ml-4 shrink-0">
									<a href={ templ.SafeURL("/"+data.Owner+"/"+data.RepoName+"/commits/"+t.Name) } class="text-xs text-gray-500 hover:text-blue-600">commits</a>
									if data.CanWrite {
										<button hx-delete={ "/api/repos/"+data.Owner+"/"+data.RepoName+"/tags?name="+t.Name } hx-target="#tags-list" hx-swap="outerHTML" hx-confirm={ "Delete tag '"+t.Name+"'?" } class="text-xs text-red-600 hover:text-red-800 border border-red-200 px-2 py-1 rounded hover:bg-red-50">Delete</button>
									}
								</div>
							</div>
						}
					} else {
						<div class="px-4 py-8 text-center text-gray-500 text-sm">No tags yet.</div>
					}
				</div>
				if data.CanWrite {
					<div class="px-4 py-4 border-t border-gray-200 bg-gray-50">
						<form hx-post={ "/api/repos/"+data.Owner+"/"+data.RepoName+"/tags" } hx-target="#tags-list" hx-swap="outerHTML" class="flex flex-wrap gap-2 items-end">
							<div>
								<label class="block text-xs font-medium text-gray-600 mb-1">Tag name</label>
								<input name="name" placeholder="v1.0.0" required class="border border-gray-300 rounded px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"/>
							</div>
							<div>
								<label class="block text-xs font-medium text-gray-600 mb-1">From ref</label>
								<input name="from" value={ data.Repo.DefaultBranch } placeholder="branch, tag, or SHA" class="border border-gray-300 rounded px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"/>
							</div>
							<button type="submit" class="px-3 py-1.5 bg-blue-600 text-white rounded text-sm hover:bg-blue-700 transition-colors">
								Create Tag
							</button>
						</form>
					</div>
				}
			</div>
		</div>
	}
}
