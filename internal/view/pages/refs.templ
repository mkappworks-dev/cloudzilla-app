package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/fragments"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Refs(data view.RefsData) {
	@layout.Base(data.BasePage, data.Owner+"/"+data.RepoName+" · Branches & Tags") {
		<div class="space-y-6">
			<section aria-labelledby="refs-title">
				<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="hover:underline">{ data.RepoName }</a>
					<span aria-hidden="true">·</span>
					Branches
				</p>
				<h1 id="refs-title" class="text-2xl font-semibold tracking-tight">Branches &amp; tags</h1>
			</section>
			<div class="rounded-md border border-border bg-card">
				<div class="px-4 py-3 border-b border-border">
					<h2 class="font-semibold text-foreground">Branches</h2>
				</div>
				@fragments.BranchesList(view.BranchesFragData{Owner: data.Owner, RepoName: data.RepoName, Branches: data.Branches, CanWrite: data.CanWrite, DefaultBranch: data.Repo.DefaultBranch})
				if data.CanWrite {
					<div class="px-4 py-4 border-t border-border bg-muted/40">
						<form hx-post={ "/api/repos/"+data.Owner+"/"+data.RepoName+"/branches" } hx-target="#branches-list" hx-swap="outerHTML" class="flex flex-wrap gap-2 items-end">
							<div>
								<label for="new-branch-name" class="block text-xs font-medium text-muted-foreground mb-1">Branch name</label>
								@components.Input(templ.Attributes{
									"id":          "new-branch-name",
									"name":        "name",
									"placeholder": "new-branch-name",
									"required":    "required",
								})
							</div>
							<div>
								<label for="new-branch-from" class="block text-xs font-medium text-muted-foreground mb-1">From ref</label>
								@components.Input(templ.Attributes{
									"id":          "new-branch-from",
									"name":        "from",
									"value":       data.Repo.DefaultBranch,
									"placeholder": "branch, tag, or SHA",
								})
							</div>
							@components.Button(components.ButtonDefault, components.ButtonSizeSM, templ.Attributes{"type": "submit"}) {
								Create Branch
							}
						</form>
					</div>
				}
			</div>
			<div class="rounded-md border border-border bg-card">
				<div class="px-4 py-3 border-b border-border">
					<h2 class="font-semibold text-foreground">Tags</h2>
				</div>
				@fragments.TagsList(view.TagsFragData{Owner: data.Owner, RepoName: data.RepoName, Tags: data.Tags, CanWrite: data.CanWrite})
				if data.CanWrite {
					<div class="px-4 py-4 border-t border-border bg-muted/40">
						<form hx-post={ "/api/repos/"+data.Owner+"/"+data.RepoName+"/tags" } hx-target="#tags-list" hx-swap="outerHTML" class="flex flex-wrap gap-2 items-end">
							<div>
								<label for="new-tag-name" class="block text-xs font-medium text-muted-foreground mb-1">Tag name</label>
								@components.Input(templ.Attributes{
									"id":          "new-tag-name",
									"name":        "name",
									"placeholder": "v1.0.0",
									"required":    "required",
								})
							</div>
							<div>
								<label for="new-tag-from" class="block text-xs font-medium text-muted-foreground mb-1">From ref</label>
								@components.Input(templ.Attributes{
									"id":          "new-tag-from",
									"name":        "from",
									"value":       data.Repo.DefaultBranch,
									"placeholder": "branch, tag, or SHA",
								})
							</div>
							@components.Button(components.ButtonDefault, components.ButtonSizeSM, templ.Attributes{"type": "submit"}) {
								Create Tag
							}
						</form>
					</div>
				}
			</div>
		</div>
	}
}
