package pages

import (
	"strconv"
	"strings"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/model"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/fragments"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Settings(data view.SettingsData) {
	@layout.Base(data.BasePage, "Account settings") {
		<section class="mb-8" aria-labelledby="settings-title">
			<h1 id="settings-title" class="text-2xl font-semibold tracking-tight">Account settings</h1>
			<p class="mt-1 text-[13px] text-muted-foreground">Profile, security, access tokens, OAuth apps, notifications, and saved replies.</p>
		</section>
		if data.ProfileError != "" {
			<div class="mb-6 border border-destructive/40 bg-destructive/10 text-destructive rounded-md px-4 py-2 text-[13px]">{ SettingsErrorMessage(data.ProfileError) }</div>
		}
		<div class="grid grid-cols-12 gap-8">
			<aside class="col-span-12 lg:col-span-3" aria-label="Settings sections">
				<nav class="lg:sticky lg:top-4 flex flex-col gap-0.5 text-[13px]">
					@settingsNavLink("#profile", "Profile", true)
					@settingsNavLink("#security", "Security", false)
					@settingsNavLink("#ssh-keys", "SSH keys", false)
					@settingsNavLink("#tokens", "Access tokens", false)
					@settingsNavLink("#oauth-apps", "OAuth apps", false)
					@settingsNavLink("#notifications", "Notifications", false)
					@settingsNavLink("#saved-replies", "Saved replies", false)
					@settingsNavLink("#sessions", "Sessions", false)
					@settingsNavLink("#email", "Email", false)
					<p class="font-mono text-[10px] uppercase tracking-wider mt-4 mb-1 px-2.5 text-muted-foreground">Danger zone</p>
					<a href="#delete" class="block px-3 py-1.5 rounded-sm text-[13px] text-destructive hover:bg-destructive/10">Delete account</a>
				</nav>
			</aside>
			<div class="col-span-12 lg:col-span-9 space-y-8">
				@settingsProfileSection(data)
				@settingsSecuritySection(data)
				@settingsSSHKeysSection(data)
				@settingsTokensSection(data)
				@settingsOAuthAppsSection(data)
				@settingsNotificationsSection(data)
				@settingsSavedRepliesSection(data)
				@settingsSessionsSection(data)
				@settingsEmailsSection(data)
				@settingsDangerSection(data)
			</div>
		</div>
		<script>
			(function () {
				var links = Array.prototype.slice.call(
					document.querySelectorAll('aside[aria-label="Settings sections"] a[href^="#"]')
				);
				var pairs = links.map(function (l) {
					return { link: l, el: document.getElementById(l.getAttribute('href').slice(1)) };
				}).filter(function (p) { return p.el; });
				if (!pairs.length) return;
				function setActive(active) {
					links.forEach(function (l) {
						var on = l === active.link;
						l.classList.toggle('bg-accent', on);
						l.classList.toggle('text-foreground', on);
						l.classList.toggle('font-medium', on);
						l.classList.toggle('text-muted-foreground', !on && !l.classList.contains('text-destructive'));
					});
				}
				function spy() {
					var y = window.scrollY + 80;
					var best = pairs[0];
					for (var i = 0; i < pairs.length; i++) {
						if (pairs[i].el.offsetTop <= y) best = pairs[i];
					}
					setActive(best);
				}
				spy();
				window.addEventListener('scroll', spy, { passive: true });
			})();
		</script>
	}
}

templ settingsNavLink(href, label string, active bool) {
	if active {
		<a href={ templ.SafeURL(href) } class="block px-3 py-1.5 rounded-sm bg-accent text-foreground font-medium">{ label }</a>
	} else {
		<a href={ templ.SafeURL(href) } class="block px-3 py-1.5 rounded-sm text-muted-foreground hover:text-foreground hover:bg-accent">{ label }</a>
	}
}

templ settingsProfileSection(data view.SettingsData) {
	<section id="profile" class="border border-border rounded-lg bg-card p-6 scroll-mt-6">
		<h2 class="text-base font-semibold tracking-tight mb-1">Profile</h2>
		<p class="text-[12.5px] text-muted-foreground mb-6">How others see you across Cloudzilla.</p>
		<form method="POST" action="/settings/profile" data-toast="Profile saved" class="space-y-5" x-data={ "{ original: " + components.JSLiteral(data.User.Email) + ", email: " + components.JSLiteral(data.User.Email) + " }" }>
			<div class="flex items-start gap-4">
				<div class="h-16 w-16 rounded-full grid place-items-center text-base font-semibold shrink-0 bg-muted border border-border">
					{ avatarInitials(data.User.Name, data.User.Username) }
				</div>
				<div class="space-y-2">
					<button type="button" disabled class="h-8 px-3 text-[13px] rounded-md border border-border bg-card text-muted-foreground cursor-not-allowed">Upload new picture</button>
					<p class="text-[11.5px] text-muted-foreground">PNG or JPG, max 2 MB. (Coming soon.)</p>
				</div>
			</div>
			<div>
				<label for="acct-name" class="block text-[12px] font-medium text-muted-foreground mb-1.5">Name</label>
				<input id="acct-name" name="name" type="text" value={ data.User.Name } class="w-full bg-background border border-border rounded-md px-3 py-2 text-[13px] text-foreground focus:outline-hidden focus:border-ring"/>
			</div>
			<div>
				<label for="acct-username" class="block text-[12px] font-medium text-muted-foreground mb-1.5">Username</label>
				<input id="acct-username" type="text" value={ data.User.Username } readonly class="w-full bg-muted/50 border border-border rounded-md px-3 py-2 text-[13px] font-mono text-muted-foreground focus:outline-hidden"/>
				<p class="mt-1 text-[11.5px] text-muted-foreground">Usernames can't be changed.</p>
			</div>
			<div>
				<label for="acct-email" class="block text-[12px] font-medium text-muted-foreground mb-1.5">Email</label>
				<input id="acct-email" name="email" type="email" value={ data.User.Email } x-model="email" required class="w-full bg-background border border-border rounded-md px-3 py-2 text-[13px] font-mono text-foreground focus:outline-hidden focus:border-ring"/>
				<p class="mt-1 text-[11.5px] text-muted-foreground">Used for sign-in and notifications. A new address has to be verified again.</p>
				if data.Confirm.Any() {
					<div x-show="email !== original" x-cloak class="mt-3 flex flex-wrap items-end gap-3">
						@components.ConfirmFields("email-change", data.Confirm, false)
						<p class="basis-full text-[11.5px] text-muted-foreground">Changing your email needs { data.Confirm.Needs() }.</p>
					</div>
				}
			</div>
			<div>
				<label for="acct-bio" class="block text-[12px] font-medium text-muted-foreground mb-1.5">Bio</label>
				<textarea id="acct-bio" name="bio" rows="3" placeholder="A short description of yourself" class="w-full bg-background border border-border rounded-md px-3 py-2 text-[13px] text-foreground focus:outline-hidden focus:border-ring">{ data.User.Bio }</textarea>
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
				<div>
					<label for="acct-company" class="block text-[12px] font-medium text-muted-foreground mb-1.5">Company</label>
					<input id="acct-company" name="company" type="text" value={ data.User.Company } placeholder="Company or @organization" class="w-full bg-background border border-border rounded-md px-3 py-2 text-[13px] text-foreground focus:outline-hidden focus:border-ring"/>
				</div>
				<div>
					<label for="acct-location" class="block text-[12px] font-medium text-muted-foreground mb-1.5">Location</label>
					<input id="acct-location" name="location" type="text" value={ data.User.Location } placeholder="City, Country" class="w-full bg-background border border-border rounded-md px-3 py-2 text-[13px] text-foreground focus:outline-hidden focus:border-ring"/>
				</div>
			</div>
			<div class="flex items-center justify-end gap-2">
				<button type="reset" class="h-9 px-4 text-sm rounded-md border border-border hover:bg-muted text-foreground">Cancel</button>
				<button type="submit" class="h-9 px-4 text-sm rounded-md font-medium bg-primary text-primary-foreground hover:bg-primary/90">Save profile</button>
			</div>
		</form>
	</section>
}

templ settingsSecuritySection(data view.SettingsData) {
	<section id="security" class="border border-border rounded-lg bg-card p-6 scroll-mt-6">
		<h2 class="text-base font-semibold tracking-tight mb-1">Security</h2>
		<p class="text-[12.5px] text-muted-foreground mb-6">Password, two-factor authentication, and connected accounts.</p>
		if len(data.BackupCodes) > 0 {
			<div class="mb-6 border border-warning/40 bg-warning/10 rounded-md p-4">
				<p class="text-[13.5px] font-medium text-warning mb-2">Save your backup codes</p>
				<p class="text-[12px] text-warning mb-3">Each code can be used once if you lose access to your authenticator. They will not be shown again.</p>
				<div class="grid grid-cols-2 gap-2 font-mono text-[12.5px]">
					for _, code := range data.BackupCodes {
						<div class="bg-background border border-warning/40 rounded-sm px-3 py-1.5 text-center tracking-widest text-foreground">{ code }</div>
					}
				</div>
			</div>
		}
		<ul class="divide-y divide-border">
			<li id="password" class="py-4 scroll-mt-6">
				<div class="flex items-start justify-between gap-4">
					<div class="min-w-0">
						<p class="text-[13.5px] font-medium">Password</p>
						if data.HasPassword {
							<p class="mt-0.5 text-[12.5px] text-muted-foreground">Changing it signs out every session, so anyone else who knows the old one is signed out too.</p>
						} else {
							<p class="mt-0.5 text-[12.5px] text-muted-foreground">This account signs in with Google and has no password.</p>
						}
					</div>
					if data.HasPassword {
						<button type="button" onclick="document.getElementById('change-password-dialog').showModal()" class="h-8 px-3 text-[13px] rounded-md border border-border hover:bg-muted text-foreground shrink-0">Change password</button>
					}
				</div>
				if data.PasswordError != "" {
					<div role="alert" class="mt-3 border border-destructive/40 bg-destructive/10 text-destructive rounded-md px-3 py-2 text-[12.5px]">{ SettingsErrorMessage(data.PasswordError) }</div>
				}
				if data.PasswordChanged {
					<div role="status" class="mt-3 border border-success/40 bg-success/10 text-success rounded-md px-3 py-2 text-[12.5px]">Password changed. Every other session is signed out.</div>
				}
			</li>
			<li class="py-4">
				<div class="flex items-start justify-between gap-4">
					<div class="min-w-0">
						<p class="text-[13.5px] font-medium inline-flex items-center gap-2">
							Two-factor authentication
							if data.TOTPEnabled {
								<span class="text-[10px] px-1.5 py-0.5 rounded-full border border-success/30 bg-success/15 text-success">Enabled</span>
							} else {
								<span class="text-[10px] px-1.5 py-0.5 rounded-full border border-border bg-muted text-muted-foreground">Disabled</span>
							}
						</p>
						<p class="mt-0.5 text-[12.5px] text-muted-foreground">TOTP via authenticator app (Google Authenticator, 1Password, Authy).</p>
					</div>
				</div>
				if data.TOTPEnabled {
					<form method="POST" action="/api/user/totp/disable" data-toast="Two-factor authentication disabled" class="mt-4 flex flex-wrap items-end gap-3">
						@components.ConfirmFields("totp-disable", components.ConfirmFactors{Password: data.Confirm.Password}, true)
						<div>
							<label for="totp-disable-code" class="block text-[12px] font-medium text-muted-foreground mb-1.5">Verification code</label>
							<input id="totp-disable-code" name="code" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="6" required autocomplete="one-time-code" placeholder="000000" class="w-32 font-mono text-center text-base bg-background border border-border rounded-md px-3 py-2 text-foreground focus:outline-hidden focus:border-ring"/>
						</div>
						<button type="submit" class="h-9 px-4 text-sm rounded-md border border-destructive/40 text-destructive hover:bg-destructive/10">Disable 2FA</button>
					</form>
				} else if data.TOTPPendingSecret != "" {
					<div class="mt-4 space-y-4">
						<div class="flex gap-6 items-start">
							if data.TOTPQRCode != "" {
								<img src={ data.TOTPQRCode } width="160" height="160" alt="TOTP QR Code" class="shrink-0 border border-border rounded-md"/>
							}
							<div class="flex-1 min-w-0">
								<p class="text-[12.5px] font-medium mb-1">Or enter this key manually</p>
								<code class="block bg-muted border border-border rounded-sm px-3 py-2 text-[12.5px] font-mono tracking-widest break-all text-foreground">{ data.TOTPPendingSecret }</code>
							</div>
						</div>
						<form method="POST" action="/api/user/totp/enable" data-toast="Two-factor authentication enabled" class="flex flex-wrap items-end gap-3">
							<input type="hidden" name="secret" value={ data.TOTPPendingSecret }/>
							@components.ConfirmFields("totp-enable", data.Confirm, true)
							<div>
								<label for="totp-enable-code" class="block text-[12px] font-medium text-muted-foreground mb-1.5">Enter the 6-digit code from your app</label>
								<input id="totp-enable-code" name="code" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="6" required autocomplete="one-time-code" placeholder="000000" class="w-32 font-mono text-center text-base bg-background border border-border rounded-md px-3 py-2 text-foreground focus:outline-hidden focus:border-ring"/>
							</div>
							<button type="submit" class="h-9 px-4 text-sm rounded-md font-medium bg-primary text-primary-foreground hover:bg-primary/90">Verify &amp; enable</button>
						</form>
					</div>
				} else {
					<form method="POST" action="/settings/security/setup" class="mt-3">
						<button type="submit" class="h-8 px-3 text-[13px] rounded-md border border-border hover:bg-muted text-foreground">Set up 2FA</button>
					</form>
				}
			</li>
		</ul>
		if data.HasPassword {
			@settingsChangePasswordDialog(data.TOTPEnabled)
		}
		@settingsConnectedAccounts(data)
	</section>
}

templ settingsChangePasswordDialog(withCode bool) {
	@components.Dialog("change-password-dialog") {
		<form method="POST" action="/settings/password">
			@components.DialogHeader() {
				@components.DialogTitle("change-password-dialog") {
					Change password
				}
				@components.DialogDescription() {
					Every session signed in to your account is signed out. This browser stays signed in.
				}
			}
			@components.DialogBody() {
				<div class="space-y-4">
					@components.ConfirmFields("password-change", components.ConfirmFactors{Password: true, Code: withCode}, true)
					<div>
						<label for="new-password" class="block text-[12px] font-medium text-muted-foreground mb-1.5">New password</label>
						<input id="new-password" name="new_password" type="password" required minlength="8" autocomplete="new-password" aria-describedby="new-password-help" class="h-9 w-56 max-w-full bg-background border border-border rounded-md px-3 text-[13px] text-foreground focus:outline-hidden focus:border-ring"/>
						<p id="new-password-help" class="mt-1 text-[11.5px] text-muted-foreground">At least 8 characters.</p>
					</div>
					<div>
						<label for="new-password-confirm" class="block text-[12px] font-medium text-muted-foreground mb-1.5">Confirm new password</label>
						<input id="new-password-confirm" name="new_password_confirm" type="password" required minlength="8" autocomplete="new-password" class="h-9 w-56 max-w-full bg-background border border-border rounded-md px-3 text-[13px] text-foreground focus:outline-hidden focus:border-ring"/>
					</div>
				</div>
			}
			@components.DialogFooter() {
				<button type="button" onclick="this.closest('dialog').close()" class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-transparent hover:bg-accent hover:text-accent-foreground h-9 px-4">Cancel</button>
				<button type="submit" class="inline-flex items-center justify-center rounded-md text-sm font-medium h-9 px-4 bg-primary text-primary-foreground hover:bg-primary/90">Change password</button>
			}
		</form>
	}
}

templ settingsConnectedAccounts(data view.SettingsData) {
	<div id="connected-accounts" class="mt-2 pt-6 border-t border-border scroll-mt-6">
		<h3 class="text-[13.5px] font-semibold tracking-tight mb-1">Connected accounts</h3>
		<p class="text-[12.5px] text-muted-foreground mb-4">Sign in with an account you have elsewhere. Connect it here, or sign in with a Google account whose verified address matches this account's verified email.</p>
		if data.ConnectedAccountsError != "" {
			<div role="alert" class="mb-4 border border-destructive/40 bg-destructive/10 text-destructive rounded-md px-3 py-2 text-[12.5px]">{ SettingsErrorMessage(data.ConnectedAccountsError) }</div>
		}
		if settingsNoticeMessage(data.ConnectedAccountsNotice) != "" {
			<div role="status" class="mb-4 border border-success/40 bg-success/10 text-success rounded-md px-3 py-2 text-[12.5px]">{ settingsNoticeMessage(data.ConnectedAccountsNotice) }</div>
		}
		<div class="flex items-start gap-3">
			<span class="h-8 w-8 shrink-0 grid place-items-center rounded-md border border-border bg-background">
				@components.GoogleLogo("h-4 w-4")
			</span>
			<div class="min-w-0 flex-1">
				<p class="text-[13.5px] font-medium inline-flex items-center gap-2">
					Google
					if data.GoogleConnected {
						<span class="text-[10px] px-1.5 py-0.5 rounded-full border border-success/30 bg-success/15 text-success">Connected</span>
					} else {
						<span class="text-[10px] px-1.5 py-0.5 rounded-full border border-border bg-muted text-muted-foreground">Not connected</span>
					}
				</p>
				if data.GoogleConnected && data.HasPassword {
					<p class="mt-0.5 text-[12.5px] text-muted-foreground">You can sign in with Google or with your password.</p>
					<form method="POST" action="/settings/connected-accounts/google/disconnect" class="mt-3 flex flex-wrap items-end gap-3">
						@settingsReauthFields("google-disconnect", data.TOTPEnabled)
						<button type="submit" class="h-9 px-4 text-sm rounded-md border border-destructive/40 text-destructive hover:bg-destructive/10">Disconnect</button>
					</form>
				} else if data.GoogleConnected {
					<p id="google-disconnect-help" class="mt-0.5 text-[12.5px] text-muted-foreground">Google is the only way to sign in to this account, which has no password. Disconnecting it would lock you out.</p>
					<button type="button" disabled aria-describedby="google-disconnect-help" class="mt-3 h-8 px-3 text-[13px] rounded-md border border-border bg-card text-muted-foreground cursor-not-allowed">Disconnect</button>
				} else if !data.GoogleConfigured {
					<p class="mt-0.5 text-[12.5px] text-muted-foreground">Google sign-in isn't set up on this instance.</p>
				} else if data.HasPassword {
					<p class="mt-0.5 text-[12.5px] text-muted-foreground">Confirm it's you, then choose the Google account to connect.</p>
					<form method="POST" action="/settings/connected-accounts/google" class="mt-3 flex flex-wrap items-end gap-3">
						@settingsReauthFields("google-connect", data.TOTPEnabled)
						<button type="submit" class="h-9 px-4 text-sm rounded-md font-medium bg-primary text-primary-foreground hover:bg-primary/90">Connect Google</button>
					</form>
				} else {
					<p id="google-connect-help" class="mt-0.5 text-[12.5px] text-muted-foreground">Connecting needs your password to confirm it's you, and this account doesn't have one.</p>
					<button type="button" disabled aria-describedby="google-connect-help" class="mt-3 h-8 px-3 text-[13px] rounded-md border border-border bg-card text-muted-foreground cursor-not-allowed">Connect Google</button>
				}
			</div>
		</div>
	</div>
}

// settingsReauthFields asks for the password, which the Google connect flow requires.
templ settingsReauthFields(idPrefix string, withCode bool) {
	@components.ConfirmFields(idPrefix, components.ConfirmFactors{Password: true, Code: withCode}, true)
}

templ settingsSSHKeysSection(data view.SettingsData) {
	<section id="ssh-keys" class="border border-border rounded-lg bg-card p-6 scroll-mt-6">
		<div class="flex items-start justify-between gap-4 mb-6">
			<div class="min-w-0">
				<h2 class="text-base font-semibold tracking-tight mb-1">SSH keys</h2>
				<p class="text-[12.5px] text-muted-foreground">Used for git push/pull over SSH.</p>
			</div>
			<button
				type="button"
				onclick="document.getElementById('add-ssh-key-dialog').showModal()"
				class="h-9 px-4 text-sm rounded-md font-medium bg-primary text-primary-foreground hover:bg-primary/90 inline-flex items-center gap-1.5 shrink-0"
			>
				<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
				Add SSH key
			</button>
		</div>
		<div id="ssh-keys-list" class="space-y-2 mb-4">
			if len(data.SSHKeys) > 0 {
				for _, k := range data.SSHKeys {
					<div class="flex items-center gap-3 border border-border rounded-md p-3" data-key-id={ strconv.FormatInt(k.ID, 10) }>
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="text-muted-foreground shrink-0" aria-hidden="true"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg>
						<div class="min-w-0 flex-1">
							<p class="text-[13.5px] font-medium">{ k.Title }</p>
							<p class="text-[11.5px] text-muted-foreground font-mono break-all">{ k.Fingerprint }</p>
							<p class="text-[11.5px] text-muted-foreground mt-0.5">
								Added <time datetime={ k.CreatedAt.UTC().Format(time.RFC3339) }>{ k.CreatedAt.Format("Jan 2, 2006") }</time>
							</p>
						</div>
						<button
							type="button"
							hx-delete={ "/api/user/keys/" + strconv.FormatInt(k.ID, 10) }
							hx-target="#ssh-keys-list"
							hx-swap="outerHTML"
							hx-confirm={ "The " + k.Title + " key will immediately lose access. Any system using it for git operations will stop working." }
							data-confirm-title="Remove this SSH key?"
							data-confirm-label="Remove"
							data-confirm-danger="true"
							data-toast="SSH key removed"
							class="h-8 px-3 text-[13px] rounded-md border border-border hover:bg-muted text-destructive shrink-0"
						>Remove</button>
					</div>
				}
			} else {
				<div class="text-center py-6 border border-dashed border-border rounded-md text-[13px] text-muted-foreground">No SSH keys yet.</div>
			}
		</div>
		@settingsAddSSHKeyDialog(data)
	</section>
}

templ settingsAddSSHKeyDialog(data view.SettingsData) {
	@components.Dialog("add-ssh-key-dialog") {
		<form
			id="add-ssh-key-form"
			hx-post="/api/user/keys"
			hx-target="#ssh-keys-list"
			hx-swap="outerHTML"
			data-toast="SSH key added"
			hx-on::after-request="if(event.detail.successful){this.closest('dialog').close(); this.reset();}"
		>
			@components.DialogHeader() {
				@components.DialogTitle("add-ssh-key-dialog") {
					Add SSH key
				}
				@components.DialogDescription() {
					A key gives any system holding the private half full git access to your repos.
				}
			}
			@components.DialogBody() {
				<div class="space-y-4">
					<div>
						<label for="key-title" class="block text-[12px] font-medium text-muted-foreground mb-1.5">Title</label>
						<input id="key-title" name="title" type="text" required placeholder="e.g. laptop" class="w-full bg-background border border-border rounded-md px-3 py-2 text-[13px] text-foreground focus:outline-hidden focus:border-ring"/>
					</div>
					<div>
						<label for="public-key" class="block text-[12px] font-medium text-muted-foreground mb-1.5">Public key</label>
						<textarea id="public-key" name="public_key" rows="5" required placeholder="ssh-ed25519 AAAA…" class="w-full bg-background border border-border rounded-md px-3 py-2 text-[12px] font-mono text-foreground focus:outline-hidden focus:border-ring"></textarea>
					</div>
					<div class="flex flex-wrap items-end gap-3">
						@components.ConfirmFields("ssh-key", data.Confirm, true)
					</div>
				</div>
			}
			@components.DialogFooter() {
				<button type="button" onclick="this.closest('dialog').close()" class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-transparent hover:bg-accent hover:text-accent-foreground h-9 px-4">Cancel</button>
				<button type="submit" class="inline-flex items-center justify-center rounded-md text-sm font-medium h-9 px-4 bg-primary text-primary-foreground hover:bg-primary/90">Add key</button>
			}
		</form>
	}
}

templ settingsTokensSection(data view.SettingsData) {
	<section id="tokens" class="border border-border rounded-lg bg-card p-6 scroll-mt-6">
		<div class="flex items-start justify-between gap-4 mb-6">
			<div class="min-w-0">
				<h2 class="text-base font-semibold tracking-tight mb-1">Personal access tokens</h2>
				<p class="text-[12.5px] text-muted-foreground">For scripts and integrations that need to act on your behalf.</p>
			</div>
			<button
				type="button"
				onclick="document.getElementById('generate-token-dialog').showModal()"
				class="h-9 px-4 text-sm rounded-md font-medium bg-primary text-primary-foreground hover:bg-primary/90 inline-flex items-center gap-1.5 shrink-0"
			>
				<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
				Generate token
			</button>
		</div>
		if data.NewToken != "" {
			<div class="mb-6 border border-success/40 bg-success/10 rounded-md p-4">
				<p class="font-semibold text-success mb-2 text-[13px]">Your new token — copy it now, it won't be shown again:</p>
				<code class="block bg-background border border-success/40 rounded-sm px-3 py-2 text-[12.5px] font-mono break-all select-all text-foreground">{ data.NewToken }</code>
			</div>
		}
		<div id="tokens-list" class="space-y-2 mb-4">
			if len(data.Tokens) > 0 {
				for _, t := range data.Tokens {
					<div class="flex items-center gap-3 border border-border rounded-md p-3">
						<span class="h-2 w-2 rounded-full bg-success shrink-0" aria-label="Active"></span>
						<div class="min-w-0 flex-1">
							<p class="text-[13.5px] font-medium">{ t.Name }</p>
							<p class="text-[12px] text-muted-foreground">
								scopes:
								if len(t.Scopes) > 0 {
									for i, s := range t.Scopes {
										if i > 0 {
											{ ", " }
										}
										<span class="font-mono">{ s }</span>
									}
								} else {
									<span class="font-mono">none</span>
								}
								if t.SigningKey != "" {
									{ " · signed requests only" }
								}
								if len(t.Targets) > 0 {
									{ " · only " + strings.Join(t.Targets, ", ") }
								}
								if t.ExpiresAt != nil {
									{ " · expires " }
									<time datetime={ t.ExpiresAt.UTC().Format(time.RFC3339) }>{ t.ExpiresAt.Format("Jan 2, 2006") }</time>
								} else {
									{ " · no expiry" }
								}
							</p>
						</div>
						<span class="text-[11px] text-muted-foreground font-mono">…{ t.LastEight }</span>
						<button
							type="button"
							hx-delete={ "/api/user/tokens/" + strconv.FormatInt(t.ID, 10) }
							hx-target="#tokens-list"
							hx-swap="outerHTML"
							hx-confirm={ "The " + t.Name + " token will immediately lose access. Any script or integration using it will stop working." }
							data-confirm-title="Revoke this token?"
							data-confirm-label="Revoke"
							data-confirm-danger="true"
							data-toast="Token revoked"
							class="h-8 px-3 text-[13px] rounded-md border border-border hover:bg-muted text-destructive shrink-0"
						>Revoke</button>
					</div>
				}
			} else {
				<div class="text-center py-6 border border-dashed border-border rounded-md text-[13px] text-muted-foreground">No tokens yet.</div>
			}
		</div>
		@settingsGenerateTokenDialog(data)
	</section>
}

templ settingsGenerateTokenDialog(data view.SettingsData) {
	@components.Dialog("generate-token-dialog") {
		<form method="POST" action="/api/user/tokens" data-toast="Token generated" x-data="{ picked: 0 }" @change="picked = $el.querySelectorAll('input[name=scopes]:checked').length">
			@components.DialogHeader() {
				@components.DialogTitle("generate-token-dialog") {
					Generate personal access token
				}
				@components.DialogDescription() {
					Treat tokens like passwords — they grant API and git access on your behalf.
				}
			}
			@components.DialogBody() {
				<div class="space-y-4">
					<div>
						<label for="token-name" class="block text-[12px] font-medium text-muted-foreground mb-1.5">Name</label>
						<input id="token-name" name="name" type="text" required placeholder="e.g. CI deploy" class="w-full bg-background border border-border rounded-md px-3 py-2 text-[13px] text-foreground focus:outline-hidden focus:border-ring"/>
					</div>
					<fieldset>
						<legend class="block text-[12px] font-medium text-muted-foreground mb-1.5">Scopes</legend>
						<div class="space-y-1.5 text-[13px]">
							for _, s := range model.Scopes {
								<label class="flex items-center gap-2"><input type="checkbox" name="scopes" value={ s }/> <span><strong class="font-mono">{ s }</strong> — { model.ScopeDescription(s) }</span></label>
							}
							<label class="flex items-start gap-2"><input type="checkbox" name="scopes" value="repo:admin" class="mt-0.5"/> <span><strong class="font-mono">repo:admin</strong> — manage collaborators, deploy keys, webhooks, org owners, transfers and deletion without a password prompt. Needs a signing key and an expiry within 90 days, and each use is emailed to you.</span></label>
						</div>
						<p class="text-[11px] text-muted-foreground mt-1">Choose at least one. Tokens can't manage your account, SSH keys or other tokens, nor repository and organization settings without repo:admin.</p>
					</fieldset>
					<div>
						<label for="token-targets" class="block text-[12px] font-medium text-muted-foreground mb-1.5">Repositories and organizations (required with repo:admin)</label>
						<textarea id="token-targets" name="targets" rows="2" placeholder="acme/app" aria-describedby="token-targets-help" class="w-full bg-background border border-border rounded-md px-3 py-2 text-[12px] font-mono text-foreground focus:outline-hidden focus:border-ring"></textarea>
						<p id="token-targets-help" class="text-[11px] text-muted-foreground mt-1">One per line: a repository you manage as <span class="font-mono">owner/repo</span>, or an organization you own, which covers its settings and all its repositories. The token can't touch anything else.</p>
					</div>
					<div>
						<label for="token-signing-key" class="block text-[12px] font-medium text-muted-foreground mb-1.5">Signing key (required with repo:admin)</label>
						<textarea id="token-signing-key" name="signing_key" rows="2" placeholder="ssh-ed25519 AAAA…" aria-describedby="token-signing-key-help" class="w-full bg-background border border-border rounded-md px-3 py-2 text-[12px] font-mono text-foreground focus:outline-hidden focus:border-ring"></textarea>
						<p id="token-signing-key-help" class="text-[11px] text-muted-foreground mt-1">An SSH public key, which can live on a hardware key (sk-). Every request with this token must then be signed with its private key (<span class="font-mono">ssh-keygen -Y sign</span>), so the token alone is useless to anyone who copies it. Such a token can't be used for git.</p>
					</div>
					<div>
						<label for="token-expires" class="block text-[12px] font-medium text-muted-foreground mb-1.5">Expiration (optional)</label>
						<input id="token-expires" name="expires_at" type="date" class="bg-background border border-border rounded-md px-3 py-2 text-[13px] text-foreground focus:outline-hidden focus:border-ring"/>
						<p class="text-[11px] text-muted-foreground mt-1">Leave blank for a non-expiring token.</p>
					</div>
					<div class="flex flex-wrap items-end gap-3">
						@components.ConfirmFields("token", data.Confirm, true)
					</div>
				</div>
			}
			@components.DialogFooter() {
				<button type="button" onclick="this.closest('dialog').close()" class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-transparent hover:bg-accent hover:text-accent-foreground h-9 px-4">Cancel</button>
				<button type="submit" class="inline-flex items-center justify-center rounded-md text-sm font-medium h-9 px-4 bg-primary text-primary-foreground hover:bg-primary/90 disabled:opacity-50 disabled:pointer-events-none" :disabled="picked === 0">Generate token</button>
			}
		</form>
	}
}

templ settingsOAuthAppsSection(data view.SettingsData) {
	<section id="oauth-apps" class="border border-border rounded-lg bg-card p-6 scroll-mt-6">
		<div class="flex items-start justify-between gap-4 mb-6">
			<div class="min-w-0">
				<h2 class="text-base font-semibold tracking-tight mb-1">OAuth applications</h2>
				<p class="text-[12.5px] text-muted-foreground">Applications you've registered to call the Cloudzilla API on behalf of other users.</p>
			</div>
			<button
				type="button"
				onclick="document.getElementById('register-oauth-app-dialog').showModal()"
				class="h-9 px-4 text-sm rounded-md font-medium bg-primary text-primary-foreground hover:bg-primary/90 inline-flex items-center gap-1.5 shrink-0"
			>
				<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
				Register app
			</button>
		</div>
		<div class="mb-6">
			@fragments.OAuthAppsList(view.OAuthAppsFragData{Apps: data.OAuthApps})
		</div>
		<h3 class="text-[13.5px] font-medium mb-1">Authorized applications</h3>
		<p class="text-[12.5px] text-muted-foreground mb-3">Applications you've allowed to access your account.</p>
		@fragments.OAuthAuthorizationsList(view.OAuthAuthorizationsFragData{Authorizations: data.OAuthAuthorizations})
		@settingsRegisterOAuthAppDialog()
	</section>
}

templ settingsRegisterOAuthAppDialog() {
	@components.Dialog("register-oauth-app-dialog") {
		<form
			hx-post="/api/oauth/apps"
			hx-target="#oauth-apps-list"
			hx-swap="outerHTML"
			data-toast="Application registered"
			hx-on::after-request="if(event.detail.successful){this.closest('dialog').close(); this.reset();}"
		>
			@components.DialogHeader() {
				@components.DialogTitle("register-oauth-app-dialog") {
					Register OAuth application
				}
				@components.DialogDescription() {
					You'll get a client ID and a client secret. The secret is shown once.
				}
			}
			@components.DialogBody() {
				<div class="space-y-4">
					<div>
						<label for="oauth-app-name" class="block text-[12px] font-medium text-muted-foreground mb-1.5">Application name</label>
						<input id="oauth-app-name" name="name" type="text" required class="w-full bg-background border border-border rounded-md px-3 py-2 text-[13px] text-foreground focus:outline-hidden focus:border-ring"/>
					</div>
					<div>
						<label for="oauth-app-homepage" class="block text-[12px] font-medium text-muted-foreground mb-1.5">Homepage URL</label>
						<input id="oauth-app-homepage" name="homepage_url" type="url" placeholder="https://example.com" class="w-full bg-background border border-border rounded-md px-3 py-2 text-[13px] text-foreground focus:outline-hidden focus:border-ring"/>
					</div>
					<div>
						<label for="oauth-app-redirect" class="block text-[12px] font-medium text-muted-foreground mb-1.5">Redirect URI</label>
						<input id="oauth-app-redirect" name="redirect_uri" type="url" placeholder="https://example.com/callback" class="w-full bg-background border border-border rounded-md px-3 py-2 text-[13px] font-mono text-foreground focus:outline-hidden focus:border-ring"/>
						<p class="text-[11px] text-muted-foreground mt-1">Leave blank to accept any redirect URI.</p>
					</div>
					<div>
						<label for="oauth-app-desc" class="block text-[12px] font-medium text-muted-foreground mb-1.5">Description (optional)</label>
						<textarea id="oauth-app-desc" name="description" rows="3" class="w-full bg-background border border-border rounded-md px-3 py-2 text-[13px] text-foreground focus:outline-hidden focus:border-ring"></textarea>
					</div>
				</div>
			}
			@components.DialogFooter() {
				<button type="button" onclick="this.closest('dialog').close()" class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-transparent hover:bg-accent hover:text-accent-foreground h-9 px-4">Cancel</button>
				<button type="submit" class="inline-flex items-center justify-center rounded-md text-sm font-medium h-9 px-4 bg-primary text-primary-foreground hover:bg-primary/90">Register app</button>
			}
		</form>
	}
}

templ settingsNotificationsSection(data view.SettingsData) {
	<section id="notifications" class="border border-border rounded-lg bg-card p-6 scroll-mt-6">
		<h2 class="text-base font-semibold tracking-tight mb-1">Notifications</h2>
		<p class="text-[12.5px] text-muted-foreground mb-6">How and when you hear about activity. Changes save automatically.</p>
		<form
			hx-post="/settings/notifications"
			hx-trigger="change"
			hx-swap="none"
			data-toast="Notification preferences saved"
		>
			@settingsToggle("email_notifications", "Email notifications", "Send email when something happens that needs your attention.", data.User.EmailNotifications)
			<div class="flex items-start justify-between gap-4 py-3 border-b border-border last:border-b-0">
				<span class="min-w-0">
					<label for="email_digest" class="block text-sm font-medium text-foreground">Delivery</label>
					<span class="block text-xs text-muted-foreground mt-0.5">Send each email right away, or a digest of your unread notifications, watched repositories included, at 08:00 UTC (weekly on Mondays).</span>
				</span>
				<div class="w-40 shrink-0">
					@components.Select(templ.Attributes{"id": "email_digest", "name": "email_digest"}) {
						for _, mode := range model.EmailDigestModes {
							<option value={ mode } selected?={ data.User.EmailDigest == mode }>{ emailDigestLabels[mode] }</option>
						}
					}
				</div>
			</div>
			@settingsToggle("notify_pr_review", "Reviews on my pull requests", "Email me when someone reviews a pull request I opened.", data.User.NotifyPRReview)
			@settingsToggle("notify_mention", "Mentions in comments", "Email me when someone @-mentions me in an issue or pull request comment.", data.User.NotifyMention)
		</form>
	</section>
}

templ settingsSavedRepliesSection(data view.SettingsData) {
	<section id="saved-replies" class="border border-border rounded-lg bg-card p-6 scroll-mt-6">
		<div class="flex items-start justify-between gap-4 mb-6">
			<div class="min-w-0">
				<h2 class="text-base font-semibold tracking-tight mb-1">Saved replies</h2>
				<p class="text-[12.5px] text-muted-foreground">Reusable snippets you can insert into issue and pull request comments.</p>
			</div>
			<button
				type="button"
				onclick="document.getElementById('new-saved-reply-dialog').showModal()"
				class="h-9 px-4 text-sm rounded-md font-medium bg-primary text-primary-foreground hover:bg-primary/90 inline-flex items-center gap-1.5 shrink-0"
			>
				<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
				New reply
			</button>
		</div>
		@fragments.SavedRepliesList(view.SavedRepliesFragData{Replies: data.SavedReplies})
		@settingsNewSavedReplyDialog()
	</section>
}

templ settingsNewSavedReplyDialog() {
	@components.Dialog("new-saved-reply-dialog") {
		<form
			hx-post="/api/user/replies"
			hx-target="#saved-replies-list"
			hx-swap="outerHTML"
			data-toast="Saved reply added"
			hx-on::after-request="if(event.detail.successful){this.closest('dialog').close(); this.reset();}"
		>
			@components.DialogHeader() {
				@components.DialogTitle("new-saved-reply-dialog") {
					New saved reply
				}
				@components.DialogDescription() {
					Pick it from the saved replies menu when writing a comment.
				}
			}
			@components.DialogBody() {
				<div class="space-y-4">
					<div>
						<label for="reply-title" class="block text-[12px] font-medium text-muted-foreground mb-1.5">Title</label>
						<input id="reply-title" name="title" type="text" required placeholder="e.g. Thanks for the report" class="w-full bg-background border border-border rounded-md px-3 py-2 text-[13px] text-foreground focus:outline-hidden focus:border-ring"/>
					</div>
					<div>
						<label for="reply-body" class="block text-[12px] font-medium text-muted-foreground mb-1.5">Content</label>
						<textarea id="reply-body" name="body" rows="5" required placeholder="Your reusable comment text…" class="w-full bg-background border border-border rounded-md px-3 py-2 text-[13px] text-foreground focus:outline-hidden focus:border-ring"></textarea>
					</div>
				</div>
			}
			@components.DialogFooter() {
				<button type="button" onclick="this.closest('dialog').close()" class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-transparent hover:bg-accent hover:text-accent-foreground h-9 px-4">Cancel</button>
				<button type="submit" class="inline-flex items-center justify-center rounded-md text-sm font-medium h-9 px-4 bg-primary text-primary-foreground hover:bg-primary/90">Add reply</button>
			}
		</form>
	}
}

templ settingsSessionsSection(data view.SettingsData) {
	<section id="sessions" class="border border-border rounded-lg bg-card p-6 scroll-mt-6">
		<div class="flex items-start justify-between gap-4 mb-6">
			<div class="min-w-0">
				<h2 class="text-base font-semibold tracking-tight mb-1">Sessions</h2>
				<p class="text-[12.5px] text-muted-foreground">Browsers signed in to your account. Access tokens, SSH keys and authorized apps are revoked in their own sections.</p>
			</div>
			<form method="POST" action="/settings/sessions/revoke" class="shrink-0">
				<button type="submit" class="h-8 px-3 text-[13px] rounded-md border border-border hover:bg-muted text-foreground">Sign out other sessions</button>
			</form>
		</div>
		if data.SessionsRevoked {
			<div role="status" class="mb-4 border border-success/40 bg-success/10 text-success rounded-md px-3 py-2 text-[12.5px]">Every other session is signed out. This browser stays signed in.</div>
		}
		<ul class="divide-y divide-border">
			<li class="py-3 flex items-center gap-3">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="text-muted-foreground" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg>
				<div class="min-w-0 flex-1">
					<p class="text-[13.5px] font-medium">This browser <span class="ml-2 text-[10px] px-1.5 py-0.5 rounded-full border border-success/30 bg-success/15 text-success">Current</span></p>
					<p class="text-[12px] text-muted-foreground">Sign out to end this session. Other sessions can't be listed, only signed out together.</p>
				</div>
			</li>
		</ul>
	</section>
}

templ settingsEmailsSection(data view.SettingsData) {
	<section id="email" class="border border-border rounded-lg bg-card p-6 scroll-mt-6">
		<div class="flex items-start justify-between gap-4 mb-6">
			<div class="min-w-0">
				<h2 class="text-base font-semibold tracking-tight mb-1">Email</h2>
				<p class="text-[12.5px] text-muted-foreground">Your address, and the author email on commits you make in the web UI.</p>
			</div>
			<span class="inline-flex items-center gap-2 shrink-0">
				@comingSoonBadge()
				@comingSoonButton("Add email")
			</span>
		</div>
		<ul class="divide-y divide-border mb-4">
			<li class="py-3 flex items-center gap-3">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="text-muted-foreground" aria-hidden="true"><path d="M4 4h16v16H4z"></path><path d="M22 6l-10 7L2 6"></path></svg>
				<div class="min-w-0 flex-1">
					<p class="text-[13.5px] font-medium font-mono">{ data.User.Email }</p>
					<p class="text-[12px] text-muted-foreground">Used for sign-in and notifications.</p>
				</div>
				if data.User.EmailVerified() {
					<span class="text-[10px] px-1.5 py-0.5 rounded-full border border-success/30 bg-success/15 text-success">Verified</span>
				} else {
					<span class="text-[10px] px-1.5 py-0.5 rounded-full border border-warning/40 bg-warning/10 text-warning">Unverified</span>
				}
				<span class="text-[10px] px-1.5 py-0.5 rounded-full border border-success/30 bg-success/15 text-success">Primary</span>
			</li>
		</ul>
		if !data.User.EmailVerified() {
			if data.EmailVerificationAvailable {
				<form
					method="POST"
					action="/settings/email/resend-verification"
					hx-post="/settings/email/resend-verification"
					hx-swap="none"
					data-toast="Verification email sent"
					class="flex items-center justify-between gap-4 mb-4"
				>
					<p class="text-[12px] text-muted-foreground">
						if data.VerificationLinkSent {
							We emailed a verification link to this address. It works once and expires 24 hours after it was sent.
						} else {
							Verify this address with a link sent to it. The link works once and expires after 24 hours.
						}
					</p>
					@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{"type": "submit", "class": "shrink-0"}) {
						Resend verification email
					}
				</form>
			} else {
				<p class="text-[12px] text-muted-foreground mb-4">Verifying your email needs outgoing email, which the administrator hasn't configured.</p>
			}
		}
		<form
			id="email-settings-form"
			method="POST"
			action="/settings/email"
			hx-post="/settings/email"
			hx-trigger="change"
			hx-swap="none"
			data-toast="Email preference saved"
		>
			<label class="flex items-start justify-between gap-4 py-3 border-t border-border cursor-pointer">
				<span class="min-w-0">
					<span class="block text-sm font-medium text-foreground">Keep my email address private</span>
					<span id="keep-email-private-help" class="block text-xs text-muted-foreground mt-0.5">
						File edits, wiki changes, merges, applied suggestions, and profile README edits are authored as
						<code class="text-[11px] bg-muted border border-border rounded-sm px-1.5 py-0.5 font-mono break-words">{ data.NoreplyEmail }</code>
						instead of your account email. Commit authors are visible to anyone who can read the repository.
					</span>
				</span>
				<span class="relative inline-flex h-5 w-9 shrink-0 items-center mt-0.5">
					<input id="keep_email_private" type="checkbox" name="keep_email_private" checked?={ data.User.KeepEmailPrivate } aria-describedby="keep-email-private-help" class="peer sr-only"/>
					<span class="absolute inset-0 rounded-full border border-border bg-muted transition-colors peer-checked:bg-success peer-checked:border-success"></span>
					<span class="absolute left-0.5 h-3.5 w-3.5 rounded-full bg-muted-foreground transition-transform peer-checked:bg-background peer-checked:translate-x-4"></span>
				</span>
			</label>
			<noscript>
				@components.Button(components.ButtonDefault, components.ButtonSizeSM, templ.Attributes{"type": "submit"}) {
					Save
				}
			</noscript>
		</form>
		<p class="text-[12px] text-muted-foreground mt-3">
			Commits you push keep the email your git client sets. To keep those private too, run
			<code class="mt-1.5 block w-fit max-w-full text-[11px] bg-muted border border-border rounded-sm px-1.5 py-0.5 font-mono break-words">git config --global user.email { data.NoreplyEmail }</code>
		</p>
	</section>
}

templ settingsDangerSection(data view.SettingsData) {
	<section id="danger" class="border border-destructive/40 rounded-lg bg-card p-6 scroll-mt-6">
		<h2 class="text-base font-semibold tracking-tight mb-1 text-destructive">Danger zone</h2>
		<p class="text-[12.5px] text-muted-foreground mb-6">Irreversible. Clone any repositories you want to keep first.</p>
		<ul class="divide-y divide-border">
			<li id="export" class="py-4 flex items-start justify-between gap-4">
				<div class="min-w-0">
					<p class="text-[13.5px] font-medium inline-flex items-center gap-2">
						Export your data
						@comingSoonBadge()
					</p>
					<p class="mt-0.5 text-[12.5px] text-muted-foreground">Download everything you've created on Cloudzilla as a zip.</p>
				</div>
				@comingSoonButton("Request export")
			</li>
			<li id="delete" class="py-4 flex items-start justify-between gap-4">
				<div class="min-w-0">
					<p class="text-[13.5px] font-medium">Delete account</p>
					<p class="mt-0.5 text-[12.5px] text-muted-foreground">Permanently remove your account, your repositories and their wikis, gists, and activity. Issues, comments and reviews you left in other people's repositories stay, credited to ghost. Organization repositories stay with their organization. If you are an organization's only owner, add another owner or delete the organization first.</p>
				</div>
				<form
					method="POST"
					action="/settings/delete-account"
					class="shrink-0 flex flex-wrap items-end gap-2"
					onsubmit={ confirmDeleteAccount(data.User.Username) }
				>
					@components.ConfirmFields("delete-account", data.Confirm, true)
					<input
						type="text"
						name="confirm_username"
						placeholder="type your username"
						required
						autocomplete="off"
						class="h-8 w-44 bg-background border border-border rounded-md px-3 text-[12.5px] font-mono text-foreground focus:outline-hidden focus:border-ring"
					/>
					<button type="submit" class="h-8 px-3 text-[13px] rounded-md font-medium bg-destructive text-destructive-foreground hover:bg-destructive/90">Delete account</button>
				</form>
			</li>
		</ul>
	</section>
}

templ comingSoonBadge() {
	<span class="text-[10px] font-normal px-1.5 py-0.5 rounded-full border border-border bg-muted text-muted-foreground">Coming soon</span>
}

templ comingSoonButton(label string) {
	<button type="button" disabled class="h-8 px-3 text-[13px] rounded-md border border-border bg-card text-muted-foreground cursor-not-allowed shrink-0">{ label }</button>
}

script confirmDeleteAccount(username string) {
	return confirm("Permanently delete @" + username + "? This cannot be undone.");
}
