package pages

import (
	"fmt"
	"strings"

	"github.com/mkappworks-dev/cloudzilla-app/internal/model"
	"github.com/mkappworks-dev/cloudzilla-app/internal/service"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ AccountPulls(data view.AccountPullsData) {
	@layout.Base(data.BasePage, "Pull requests") {
		<div class="space-y-5" x-data="{ q: '', openMenu: null }">
			<section class="mb-6">
				<h1 class="text-2xl font-semibold tracking-tight">Pull requests</h1>
				<p class="mt-1 text-[13px] text-muted-foreground">Across every repository you own or collaborate on.</p>
			</section>
			@components.Tabs("PR filter") {
				@components.TabLink("/pulls?filter=created&state="+data.State, data.Filter == "created") {
					Created by you
					@tabCountBadge(data.Counts["created:"+data.State])
				}
				@components.TabLink("/pulls?filter=assigned&state="+data.State, data.Filter == "assigned") {
					Assigned
					@tabCountBadge(data.Counts["assigned:"+data.State])
				}
				@components.TabLink("/pulls?filter=review_requested&state="+data.State, data.Filter == "review_requested") {
					Review requests
					@tabCountBadge(data.Counts["review_requested:"+data.State])
				}
				@components.TabLink("/pulls?filter=mentioned&state="+data.State, data.Filter == "mentioned") {
					Mentioned
					@tabCountBadge(data.Counts["mentioned:"+data.State])
				}
				<span class="ml-auto inline-flex items-center">
					@components.TabLink("/pulls?filter="+data.Filter+"&state=open", data.State == "open") {
						Open
						@tabCountBadge(data.Counts[data.Filter+":open"])
					}
					@components.TabLink("/pulls?filter="+data.Filter+"&state=closed", data.State == "closed") {
						Closed
						@tabCountBadge(data.Counts[data.Filter+":closed"])
					}
				</span>
			}
			<div class="flex items-center gap-2 flex-wrap">
				<div class="relative flex-1 min-w-[240px]">
					<label for="pr-filter" class="sr-only">Filter pull requests</label>
					<input id="pr-filter" type="search" placeholder="Filter pull requests…" autocomplete="off" x-model="q" class="w-full h-9 pl-8 pr-3 text-[13px] bg-card border border-border rounded-md text-foreground placeholder:text-muted-foreground"/>
					<svg class="absolute left-2.5 top-2.5 text-muted-foreground" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
						<circle cx="11" cy="11" r="7"></circle>
						<path d="M21 21l-4.3-4.3"></path>
					</svg>
				</div>
				@repoFilterMenu("sort", pullsSortLabel(data.Sort), "Sort pull requests", "Sort by", pullsSortMenu(data))
			</div>
			if len(data.Pulls) > 0 {
				<section class="rounded-md border border-border bg-card overflow-hidden" aria-labelledby="mypr-list">
					<h2 id="mypr-list" class="sr-only">Your pull requests</h2>
					<ol class="divide-y divide-border">
						for _, pr := range data.Pulls {
							<li data-name={ pr.RepoFullName + " " + pr.Title } x-show="!q || $el.dataset.name.toLowerCase().includes(q.toLowerCase())">
								<a
									href={ templ.SafeURL(fmt.Sprintf("/%s/pulls/%d", pr.RepoFullName, pr.Number)) }
									class="group relative block px-4 py-3 transition-[padding] hover:bg-accent hover:pl-[18px] before:content-[''] before:absolute before:left-0 before:top-2 before:bottom-2 before:w-0.5 before:rounded-full before:bg-foreground before:opacity-0 before:transition-opacity hover:before:opacity-100"
								>
									<div class="flex items-start gap-3 mb-1.5">
										@pullStateIcon(pr.State)
										<div class="min-w-0 flex-1 flex items-center gap-2 flex-wrap">
											<span class="font-mono text-[12px] text-muted-foreground">{ pr.RepoFullName }</span>
											<span class="opacity-50" aria-hidden="true">·</span>
											<p class="text-[13.5px] font-medium leading-snug group-hover:underline">{ pr.Title }</p>
											@pullStateBadge(pr.State)
										</div>
									</div>
									<div class="flex items-center justify-between gap-3 pl-[27px]">
										<div class="flex items-center gap-1.5 text-[12px] text-muted-foreground min-w-0 flex-wrap">
											<span class="font-mono">{ fmt.Sprintf("#%d", pr.Number) }</span>
											<span class="opacity-50" aria-hidden="true">·</span>
											<time>{ relativeTime(pr.UpdatedAt) }</time>
											if len(data.PullLabels[pr.ID]) > 0 {
												<span class="opacity-50 mx-0.5" aria-hidden="true">·</span>
												for _, lbl := range data.PullLabels[pr.ID] {
													@pullLabelPill(lbl)
												}
											}
										</div>
										<div class="flex items-center gap-2 shrink-0">
											if ci, ok := data.PullCI[pr.ID]; ok && ci.Required > 0 {
												@pullCIBadge(ci)
											}
											if len(data.PullReviewers[pr.ID]) > 0 {
												@pullReviewerStack(data.PullReviewers[pr.ID])
											}
											if data.PullComments[pr.ID] > 0 {
												<span class="text-muted-foreground inline-flex items-center gap-1 text-[12px]">
													<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"></path></svg>
													{ fmt.Sprintf("%d", data.PullComments[pr.ID]) }
												</span>
											}
										</div>
									</div>
								</a>
							</li>
						}
					</ol>
				</section>
			} else {
				@components.EmptyState("No " + data.State + " pull requests.")
			}
		</div>
	}
}

func pullsSortURL(filter, state, sortBy string) string {
	u := "/pulls?filter=" + filter + "&state=" + state
	if sortBy != "" && sortBy != "newest" {
		u += "&sort=" + sortBy
	}
	return u
}

func pullsSortOptions() []repoDropdownOption {
	return []repoDropdownOption{
		{"newest", "Sort: newest"},
		{"oldest", "Oldest"},
		{"updated", "Recently updated"},
		{"comments", "Most commented"},
	}
}

func pullsSortLabel(sortBy string) string {
	for _, o := range pullsSortOptions() {
		if o.Value == sortBy {
			return o.Label
		}
	}
	return "Sort: newest"
}

func pullsSortMenu(data view.AccountPullsData) []repoMenuItem {
	items := make([]repoMenuItem, 0, 3)
	for _, o := range pullsSortOptions() {
		items = append(items, repoMenuItem{
			Label:  o.Label,
			URL:    pullsSortURL(data.Filter, data.State, o.Value),
			Active: data.Sort == o.Value,
		})
	}
	return items
}

templ pullLabelPill(lbl model.Label) {
	if lbl.Color != "" && !strings.EqualFold(lbl.Color, "none") {
		<span
			class="inline-flex items-center text-[10px] px-1.5 py-0.5 rounded-full border whitespace-nowrap"
			style={ fmt.Sprintf("background:%s22;color:%s;border-color:%s55", lbl.Color, lbl.Color, lbl.Color) }
		>{ lbl.Name }</span>
	} else {
		<span class="inline-flex items-center text-[10px] px-1.5 py-0.5 rounded-full border border-border bg-accent text-muted-foreground whitespace-nowrap">{ lbl.Name }</span>
	}
}

templ pullStateIcon(state string) {
	switch state {
	case "merged":
		<svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" class="shrink-0 mt-0.5 text-[hsl(270_70%_70%)]" aria-hidden="true">
			<path d="M5 3.254V3.25v.005a.75.75 0 110-.005v.004zm.45 1.9a2.25 2.25 0 10-1.95.218v5.256a2.25 2.25 0 101.5 0V7.123A5.735 5.735 0 009.25 9h1.378a2.251 2.251 0 100-1.5H9.25a4.25 4.25 0 01-3.8-2.346zM12.75 9a.75.75 0 100-1.5.75.75 0 000 1.5zm-8.5 4.5a.75.75 0 100-1.5.75.75 0 000 1.5z"></path>
		</svg>
	case "closed":
		<svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" class="shrink-0 mt-0.5 text-destructive" aria-hidden="true">
			<path d="M3.25 1A2.25 2.25 0 014 5.372v5.256a2.251 2.251 0 11-1.5 0V5.372A2.251 2.251 0 013.25 1zm9.5 14a2.25 2.25 0 110-4.5 2.25 2.25 0 010 4.5zM2.5 3.25a.75.75 0 101.5 0 .75.75 0 00-1.5 0zM3.25 12a.75.75 0 100 1.5.75.75 0 000-1.5zm9.5 0a.75.75 0 100 1.5.75.75 0 000-1.5zm1.28-9.53a.75.75 0 010 1.06l-1.97 1.97 1.97 1.97a.75.75 0 11-1.06 1.06l-1.97-1.97-1.97 1.97a.75.75 0 01-1.06-1.06l1.97-1.97-1.97-1.97a.75.75 0 011.06-1.06l1.97 1.97 1.97-1.97a.75.75 0 011.06 0z"></path>
		</svg>
	default:
		<svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" class="shrink-0 mt-0.5 text-success" aria-hidden="true">
			<path d="M1.5 3.25a2.25 2.25 0 113 2.122v5.256a2.251 2.251 0 11-1.5 0V5.372A2.25 2.25 0 011.5 3.25zm5.677-.177L9.573.677A.25.25 0 0110 .854V2.5h1A2.5 2.5 0 0113.5 5v5.628a2.251 2.251 0 11-1.5 0V5a1 1 0 00-1-1h-1v1.646a.25.25 0 01-.427.177L7.177 3.427a.25.25 0 010-.354zM3.75 2.5a.75.75 0 100 1.5.75.75 0 000-1.5zm0 9.5a.75.75 0 100 1.5.75.75 0 000-1.5zm8.25.75a.75.75 0 101.5 0 .75.75 0 00-1.5 0z"></path>
		</svg>
	}
}

templ pullStateBadge(state string) {
	switch state {
	case "merged":
		@components.Badge(components.BadgeMerged) {
			Merged
		}
	case "closed":
		@components.Badge(components.BadgeDestructive) {
			Closed
		}
	default:
		@components.Badge(components.BadgeSuccess) {
			Open
		}
	}
}

func pullInitials(name string) string {
	if name == "" {
		return "?"
	}
	parts := strings.Fields(name)
	if len(parts) == 1 {
		r := []rune(parts[0])
		if len(r) >= 2 {
			return strings.ToUpper(string(r[:2]))
		}
		return strings.ToUpper(string(r[:1]))
	}
	return strings.ToUpper(string([]rune(parts[0])[0:1]) + string([]rune(parts[1])[0:1]))
}

templ pullCIBadge(ci service.CIChecks) {
	<span
		class={ "inline-flex items-center gap-1 text-[11px] font-medium px-1.5 py-0.5 rounded-full border",
			templ.KV("text-success border-success/30 bg-success/10", ci.Passing == ci.Required),
			templ.KV("text-muted-foreground border-border bg-accent", ci.Passing != ci.Required) }
		title="CI checks"
	>
		if ci.Passing == ci.Required {
			<svg width="10" height="10" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"></path></svg>
		} else {
			<svg width="10" height="10" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0a8 8 0 110 16A8 8 0 010 8zm0 1.5a6.5 6.5 0 100 13 6.5 6.5 0 000-13zM7 4a1 1 0 012 0v4a1 1 0 01-2 0V4zm1 8a1 1 0 110-2 1 1 0 010 2z"></path></svg>
		}
		{ fmt.Sprintf("%d/%d", ci.Passing, ci.Required) }
	</span>
}

templ pullReviewerStack(reviewers []model.PullReview) {
	<span class="inline-flex items-center -space-x-1.5" aria-label="Reviewers">
		for i, r := range reviewers {
			if i < 3 {
				<span
					class="inline-flex items-center justify-center w-5 h-5 rounded-full border border-background bg-muted text-[9px] font-semibold text-muted-foreground uppercase select-none"
					title={ r.AuthorName }
				>
					{ pullInitials(r.AuthorName) }
				</span>
			}
		}
		if len(reviewers) > 3 {
			<span class="inline-flex items-center justify-center w-5 h-5 rounded-full border border-background bg-muted text-[9px] font-semibold text-muted-foreground select-none">
				{ fmt.Sprintf("+%d", len(reviewers)-3) }
			</span>
		}
	</span>
}
