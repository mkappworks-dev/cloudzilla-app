package pages

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/model"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

func issueLabelChips(labels []model.Label) []components.LabelChipData {
	chips := make([]components.LabelChipData, len(labels))
	for i, l := range labels {
		chips[i] = components.LabelChipData{Name: l.Name, Color: l.Color}
	}
	return chips
}

templ Issues(data view.IssuesData) {
	@layout.Base(data.BasePage, "Issues · "+data.Owner+"/"+data.RepoName) {
		<div class="space-y-6">

			<section class="flex flex-wrap items-start justify-between gap-4" aria-labelledby="issues-title">
				<div class="min-w-0">
					<h1 id="issues-title" class="text-2xl font-semibold tracking-tight">Issues</h1>
				</div>
				@components.LinkButton("/"+data.Owner+"/"+data.RepoName+"/issues/new", components.ButtonSuccess, components.ButtonSizeDefault, nil) {
					<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" focusable="false">
						<path d="M12 5v14M5 12h14"></path>
					</svg>
					New issue
				}
			</section>

			if data.OpenCount+data.ClosedCount > 0 {
				<nav class="flex items-center gap-1 border-b border-border text-sm" aria-label="Issue state">
					@components.TabLink(data.OpenTabURL, data.StateFilter == "open") {
						Open
						<span class="ml-0.5 font-mono text-[11px] text-muted-foreground" aria-label={ strconv.Itoa(data.OpenCount) + " open" }>{ strconv.Itoa(data.OpenCount) }</span>
					}
					@components.TabLink(data.ClosedTabURL, data.StateFilter == "closed") {
						Closed
						<span class="ml-0.5 font-mono text-[11px] text-muted-foreground" aria-label={ strconv.Itoa(data.ClosedCount) + " closed" }>{ strconv.Itoa(data.ClosedCount) }</span>
					}
				</nav>
				@components.ListFilterBar(data.Filter)
			}

			if len(data.PinnedIssues) > 0 {
				<section aria-labelledby="pinned-heading">
					<h2 id="pinned-heading" class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">
						Pinned
						<span class="ml-1">{ strconv.Itoa(len(data.PinnedIssues)) }</span>
					</h2>
					<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
						for _, pinned := range data.PinnedIssues {
							<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(pinned.Number)) } class="block rounded-md border border-border bg-card p-4 hover:bg-accent/40 transition">
								<div class="flex items-start gap-2">
									<svg class="w-4 h-4 text-warning shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
										<path d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.27l-4.77 2.51.91-5.32L2.27 6.62l5.34-.78L10 1z"></path>
									</svg>
									<div class="min-w-0">
										<p class="text-[13px] font-semibold truncate">{ pinned.Title }</p>
										<p class="mt-1 font-mono text-[11px] text-muted-foreground">#{ strconv.Itoa(pinned.Number) } · { string(pinned.State) }</p>
									</div>
								</div>
							</a>
						}
					</div>
				</section>
			}

			if len(data.Issues) > 0 {
				<section class="rounded-md border border-border bg-card overflow-hidden" aria-labelledby="issue-list">
					<h2 id="issue-list" class="sr-only">{ data.StateFilter } issues</h2>
					<ol class="divide-y divide-border">
						for _, issue := range data.Issues {
							@components.IssueListRow(components.IssueListRowData{
								Href:     "/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(issue.Number),
								Number:   issue.Number,
								Title:    issue.Title,
								Author:   issue.AuthorName,
								State:    string(issue.State),
								Private:  issue.Visibility == "private",
								Time:     formatRelative(issue.CreatedAt),
								Labels:   issueLabelChips(data.IssueLabels[issue.ID]),
								Priority: issuePriority(issue.Priority),
								Comments: data.CommentCounts[issue.ID],
							})
						}
					</ol>
				</section>
				@components.PaginationWithCount(data.PrevURL, data.NextURL, data.Page, data.TotalPages)
			} else if data.Filter.HasFilters {
				<div class="bg-background border border-border rounded-lg p-8 text-center">
					<p class="text-muted-foreground">{ "No " + data.StateFilter + " issues match these filters." }</p>
					<a href={ templ.SafeURL(data.ClearURL) } class="mt-2 inline-block text-sm text-primary hover:underline">Clear filters</a>
				</div>
			} else if data.OpenCount+data.ClosedCount == 0 {
				@components.EmptyStateWithHint("No issues yet.", "Issues track bugs, tasks and ideas for this repository.")
			} else {
				@components.EmptyState("No " + data.StateFilter + " issues.")
			}

		</div>
	}
}
