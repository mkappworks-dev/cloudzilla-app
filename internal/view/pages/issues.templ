package pages

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Issues(data view.IssuesData) {
	@layout.Base(data.BasePage, "Issues · "+data.Owner+"/"+data.RepoName) {
		<div class="space-y-6">
			<div class="flex justify-between items-center">
				<h1 class="text-2xl font-bold">
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="text-blue-600 hover:underline">{ data.Owner }/{ data.RepoName }</a> Issues
				</h1>
			</div>
			if len(data.PinnedIssues) > 0 {
				<div class="mb-4">
					<h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">Pinned</h2>
					<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mb-6">
						for _, pinned := range data.PinnedIssues {
							<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(pinned.Number)) } class="block bg-yellow-50 border border-yellow-200 rounded-lg p-4 hover:border-yellow-400 hover:shadow-md transition-all">
								<div class="flex items-start gap-2">
									<svg class="w-4 h-4 text-yellow-500 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.27l-4.77 2.51.91-5.32L2.27 6.62l5.34-.78L10 1z"></path></svg>
									<div class="min-w-0">
										<p class="font-semibold text-sm truncate">{ pinned.Title }</p>
										<p class="text-xs text-gray-500 mt-1">#{ strconv.Itoa(pinned.Number) } · { string(pinned.State) }</p>
									</div>
								</div>
							</a>
						}
					</div>
				</div>
			}
			if len(data.Issues) > 0 {
				<div class="space-y-3">
					for _, issue := range data.Issues {
						<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(issue.Number)) } class="block bg-white border border-gray-200 rounded-lg p-4 hover:border-blue-300 hover:shadow-md transition-all">
							<div class="flex justify-between items-start">
								<div class="min-w-0 flex-1">
									<h3 class="text-lg font-semibold">
									if issue.Visibility == "private" {
										<span class="inline-flex items-center mr-1 text-yellow-600" title="Private">&#128274;</span>
									}
									{ issue.Title }
								</h3>
									<p class="text-gray-600 text-sm mt-1">#{ strconv.Itoa(issue.Number) } opened by { issue.AuthorName }</p>
									if labels, ok := data.IssueLabels[issue.ID]; ok && len(labels) > 0 {
										<div class="flex flex-wrap gap-1 mt-2">
											for _, l := range labels {
												<span class="px-2 py-0.5 rounded-full text-xs font-medium" style={ "background-color: " + l.Color }>{ l.Name }</span>
											}
										</div>
									}
								</div>
								<div class="ml-3 shrink-0">
									@components.IssueStateBadge(string(issue.State))
								</div>
							</div>
						</a>
					}
				</div>
			} else {
				@components.EmptyState("No issues yet.")
			}
		</div>
	}
}
