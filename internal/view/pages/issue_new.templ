package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ IssueNew(data view.IssueNewData) {
	@layout.Base(data.BasePage, "New Issue · "+data.Owner+"/"+data.RepoName) {
		<div class="max-w-2xl mx-auto space-y-6">
			<div>
				<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/issues") } class="text-foreground hover:underline text-sm">&larr; Back to Issues</a>
			</div>
			<h1 class="text-2xl font-semibold tracking-tight">New Issue</h1>
			if data.Error != "" {
				<div class="px-4 py-3 rounded-md border border-destructive/40 bg-destructive/10 text-destructive text-sm" role="alert">{ data.Error }</div>
			}
			if data.ShowForm {
				<form method="POST" action={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/issues/new") } class="space-y-4 rounded-md border border-border bg-card p-6">
					<div class="space-y-1.5">
						<label class="block text-sm font-medium" for="title">Title</label>
						@components.Input(templ.Attributes{
							"id":          "title",
							"name":        "title",
							"type":        "text",
							"required":    "required",
							"autofocus":   "autofocus",
							"placeholder": "Short summary of the issue",
						})
					</div>
					<div class="space-y-1.5">
						<label class="block text-sm font-medium" for="body">Description</label>
						<textarea id="body" name="body" rows="12" class="flex min-h-[80px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm placeholder:text-muted-foreground resize-vertical font-mono">{ data.Selected }</textarea>
					</div>
					if data.CanWrite {
						<div class="mt-3 flex items-center gap-2">
							<input type="checkbox" id="visibility_private" name="visibility" value="private" class="rounded border-input"/>
							<label for="visibility_private" class="text-sm text-foreground">Private issue (visible only to collaborators with write access)</label>
						</div>
					}
					<div class="flex items-center gap-3">
						@components.Button(components.ButtonSuccess, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
							Submit new issue
						}
						<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/issues") } class="text-sm text-muted-foreground hover:underline">Cancel</a>
					</div>
				</form>
			} else {
				<p class="text-muted-foreground text-sm">Choose a template or open a blank issue.</p>
				<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
					for _, t := range data.Templates {
						<a href={ templ.SafeURL("?template=" + t.Slug) } class="block rounded-md border border-border bg-card p-4 hover:border-foreground/40 hover:shadow-sm transition-all">
							<div class="font-medium text-foreground">{ t.Name }</div>
						</a>
					}
					<a href="?blank=1" class="block rounded-md border border-border bg-card p-4 hover:border-foreground/40 hover:shadow-sm transition-all">
						<div class="font-medium text-muted-foreground">Blank issue</div>
					</a>
				</div>
			}
		</div>
	}
}
