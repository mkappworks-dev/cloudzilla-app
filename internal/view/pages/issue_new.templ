package pages

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ IssueNew(data view.IssueNewData) {
	@layout.Base(data.BasePage, "New Issue · "+data.Owner+"/"+data.RepoName) {
		<div class="space-y-6">

			<section aria-labelledby="new-title">
				<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="hover:underline">{ data.RepoName }</a>
					<span aria-hidden="true">·</span>
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/issues") } class="hover:underline">Issues</a>
					<span aria-hidden="true">·</span>
					New
				</p>
				<h1 id="new-title" class="text-2xl font-semibold tracking-tight">Open a new issue</h1>
				if data.ShowForm {
					<p class="mt-1 text-[13px] text-muted-foreground">Describe the bug, request, or task — the more context, the faster it gets triaged.</p>
				} else {
					<p class="mt-1 text-[13px] text-muted-foreground">Pick a template to pre-fill the form, or start from a blank issue.</p>
				}
			</section>

			if data.Error != "" {
				@components.Alert(components.AlertDestructive) {
					@components.AlertDescription() {
						{ data.Error }
					}
				}
			}

			if data.ShowForm {
				if len(data.Templates) > 0 {
					<div class="flex flex-wrap gap-2" role="group" aria-label="Issue templates">
						for _, t := range data.Templates {
							<a href={ templ.SafeURL("?template=" + t.Slug) } class="inline-flex items-center px-3 h-8 rounded-md border border-border bg-card text-[13px] font-medium hover:bg-muted/50 transition">{ t.Name }</a>
						}
						<a href="?blank=1" class="inline-flex items-center px-3 h-8 rounded-md border border-border bg-card text-[13px] text-muted-foreground hover:bg-muted/50 transition">Blank issue</a>
					</div>
				}

				<div class="grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-8">
					<section aria-labelledby="composer" class="rounded-md border border-border bg-card p-6">
						<h2 id="composer" class="text-[13px] font-medium mb-4">Compose</h2>
						<form id="issue-new-form" method="POST" action={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/issues/new") } class="space-y-5">
							<div class="space-y-1.5">
								<label for="title" class="block text-sm font-medium">Title</label>
								@components.Input(templ.Attributes{
									"id":          "title",
									"name":        "title",
									"type":        "text",
									"required":    "required",
									"autofocus":   "autofocus",
									"placeholder": "Short summary of the issue",
								})
							</div>

							<div class="space-y-1.5">
								<label for="body" class="block text-sm font-medium">Description</label>
								<div class="rounded-md border border-border bg-card overflow-hidden">
									@components.MarkdownEditor("body", "body", data.Selected, "Describe the issue. Markdown supported.", 12)
								</div>
								<p class="text-[11px] text-muted-foreground">Markdown is supported. <kbd class="font-mono text-[10px] px-1 py-0.5 bg-muted border border-border rounded">{ "@" }</kbd> mentions notify users; <kbd class="font-mono text-[10px] px-1 py-0.5 bg-muted border border-border rounded">#</kbd> links issues/PRs.</p>
							</div>

							if data.CanWrite {
								<div class="flex items-center gap-2">
									@components.Checkbox(templ.Attributes{"id": "visibility_private", "name": "visibility", "value": "private"})
									<label for="visibility_private" class="text-sm cursor-pointer">Private issue <span class="text-muted-foreground">(visible only to collaborators with write access)</span></label>
								</div>
							}

							<div class="flex items-center gap-3 pt-2">
								@components.Button(components.ButtonSuccess, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
									Submit new issue
								}
								<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/issues") } class="text-sm text-muted-foreground hover:underline">Cancel</a>
							</div>
						</form>
					</section>

					<aside
						class="space-y-6 text-[12.5px]"
						aria-label="Issue metadata"
						x-data="{ open: null, assignees: [], labels: [], priority: '', milestone: '', linkedPulls: [], toggle(a, v) { const i = a.indexOf(v); i < 0 ? a.push(v) : a.splice(i, 1) } }"
						x-on:keydown.escape.window="open = null"
					>
						if data.CanWrite {
							<section>
								@issueNewAssignees(data)
							</section>
							<section class="border-t border-border pt-6">
								@issueNewLabels(data)
							</section>
							<section class="border-t border-border pt-6">
								@issueNewPriority()
							</section>
							<section class="border-t border-border pt-6">
								@issueNewMilestone(data)
							</section>
							<section class="border-t border-border pt-6">
								@issueNewLinkedPulls(data)
							</section>
						} else {
							@issueNewMetaSection("Assignees", "No one assigned yet.", false)
							@issueNewMetaSection("Labels", "No labels yet.", true)
							@issueNewMetaSection("Priority", "No priority set.", true)
							@issueNewMetaSection("Milestone", "No milestone.", true)
							@issueNewMetaSection("Linked pull requests", "No linked pull requests.", true)
						}
					</aside>
				</div>
			} else {
				<section aria-labelledby="templates">
					<h2 id="templates" class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-3">Templates</h2>
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
						for _, t := range data.Templates {
							<a href={ templ.SafeURL("?template=" + t.Slug) } class="rounded-md border border-border bg-card p-4 hover:bg-muted/50 transition">
								<p class="text-[13px] font-medium">{ t.Name }</p>
							</a>
						}
						<a href="?blank=1" class="rounded-md border border-border bg-card p-4 hover:bg-muted/50 transition">
							<p class="text-[13px] font-medium text-muted-foreground">Blank issue</p>
							<p class="mt-1 text-[12px] text-muted-foreground/60">Start from an empty body.</p>
						</a>
					</div>
				</section>
			}
		</div>
	}
}

// issueNewMetaSection renders one placeholder section of the new-issue metadata
// sidebar, shown to reporters without write access who cannot set metadata.
templ issueNewMetaSection(title, emptyText string, divided bool) {
	<section class={ "space-y-2", templ.KV("border-t border-border pt-6", divided) } aria-label={ title }>
		<h3 class="text-[12px] font-medium text-muted-foreground">{ title }</h3>
		<p class="text-[13px] text-muted-foreground">{ emptyText }</p>
	</section>
}

// issueNewPicker renders the heading row and dropdown-panel chrome shared by
// every new-issue metadata picker. Children are the menu items. The dropdown is
// driven by the ancestor `open` Alpine scope, so only one picker is open at a time.
templ issueNewPicker(section, heading, menuHeading, triggerLabel string, plus bool) {
	<div class="flex items-center justify-between">
		<h3 class="text-[12px] font-medium text-muted-foreground">{ heading }</h3>
		<div class="relative" x-on:click.outside={ "open === '" + section + "' && (open = null)" }>
			<button
				type="button"
				x-on:click={ "open = (open === '" + section + "' ? null : '" + section + "')" }
				:aria-expanded={ "open === '" + section + "' ? 'true' : 'false'" }
				aria-haspopup="menu"
				aria-label={ triggerLabel }
				class="text-muted-foreground hover:text-foreground"
			>
				if plus {
					@issueNewPlusIcon()
				} else {
					@issueNewEditIcon()
				}
			</button>
			<div
				x-show={ "open === '" + section + "'" }
				x-cloak
				x-transition.opacity.duration.100ms
				role="menu"
				aria-label={ menuHeading }
				class="absolute right-0 top-full mt-1.5 z-50 w-56 rounded-md border border-border bg-popover text-popover-foreground shadow-md p-1 max-h-72 overflow-y-auto"
			>
				<div class="px-2 pt-1 pb-0.5 text-[10px] font-medium uppercase tracking-wider text-muted-foreground">{ menuHeading }</div>
				{ children... }
			</div>
		</div>
	</div>
}

// issueNewMenuLink is an anchor-style row at the foot of a picker dropdown.
templ issueNewMenuLink(href string) {
	<a
		href={ templ.SafeURL(href) }
		role="menuitem"
		class="flex w-full items-center gap-2 px-2.5 py-1.5 rounded-md text-left text-[13px] text-muted-foreground hover:bg-accent hover:text-foreground"
	>
		{ children... }
	</a>
}

templ issueNewAssignees(data view.IssueNewData) {
	<div class="space-y-2">
		if len(data.Collaborators) > 0 {
			@issueNewPicker("assignees", "Assignees", "Assign people", "Edit assignees", false) {
				for _, c := range data.Collaborators {
					<button
						type="button"
						role="menuitemcheckbox"
						x-on:click={ "toggle(assignees, '" + c + "')" }
						:aria-checked={ "assignees.includes('" + c + "') ? 'true' : 'false'" }
						class="flex w-full items-center gap-2 px-2.5 py-1.5 rounded-md text-left text-[13px] text-muted-foreground hover:bg-accent hover:text-foreground"
					>
						@components.Avatar(c, components.AvatarSizeSM, c)
						<span class="flex-1 truncate">{ c }</span>
						<span x-show={ "assignees.includes('" + c + "')" } x-cloak>
							@issueNewCheckIcon()
						</span>
					</button>
				}
				<div role="separator" class="my-1 h-px bg-border"></div>
				@issueNewMenuLink("/" + data.Owner + "/" + data.RepoName + "/settings#collaborators") {
					@issueNewInviteIcon()
					Invite a collaborator
				}
			}
		} else {
			<h3 class="text-[12px] font-medium text-muted-foreground">Assignees</h3>
		}
		<div class="space-y-1">
			for _, c := range data.Collaborators {
				<div x-show={ "assignees.includes('" + c + "')" } x-cloak class="flex items-center gap-2 text-[13px]">
					@components.Avatar(c, components.AvatarSizeSM, c)
					<a href={ templ.SafeURL("/" + c) } class="font-medium hover:underline truncate">{ c }</a>
				</div>
			}
			<span x-show="assignees.length === 0" class="text-xs text-muted-foreground">No one assigned</span>
		</div>
		for _, c := range data.Collaborators {
			<input type="hidden" name="assignees" value={ c } form="issue-new-form" :disabled={ "!assignees.includes('" + c + "')" }/>
		}
	</div>
}

templ issueNewLabels(data view.IssueNewData) {
	<div class="space-y-2">
		if len(data.Labels) > 0 {
			@issueNewPicker("labels", "Labels", "Apply labels", "Edit labels", false) {
				for _, lbl := range data.Labels {
					{{ id := strconv.FormatInt(lbl.ID, 10) }}
					<button
						type="button"
						role="menuitemcheckbox"
						x-on:click={ "toggle(labels, '" + id + "')" }
						:aria-checked={ "labels.includes('" + id + "') ? 'true' : 'false'" }
						class="flex w-full items-center gap-2 px-2.5 py-1.5 rounded-md text-left text-[13px] text-muted-foreground hover:bg-accent hover:text-foreground"
					>
						<span class="h-2.5 w-2.5 rounded-full inline-block shrink-0" style={ "background-color: " + lbl.Color }></span>
						<span class="flex-1 truncate">{ lbl.Name }</span>
						<span x-show={ "labels.includes('" + id + "')" } x-cloak>
							@issueNewCheckIcon()
						</span>
					</button>
				}
				<div role="separator" class="my-1 h-px bg-border"></div>
				@issueNewMenuLink("/" + data.Owner + "/" + data.RepoName + "/settings#labels") {
					@issueNewTagIcon()
					Create a new label
				}
			}
		} else {
			<h3 class="text-[12px] font-medium text-muted-foreground">Labels</h3>
		}
		<div class="flex flex-wrap gap-1">
			for _, lbl := range data.Labels {
				{{ id := strconv.FormatInt(lbl.ID, 10) }}
				<span
					x-show={ "labels.includes('" + id + "')" }
					x-cloak
					class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium border"
					style={ "background-color: " + lbl.Color + "33; color: " + lbl.Color + "; border-color: " + lbl.Color + "55" }
				>
					{ lbl.Name }
				</span>
			}
			<span x-show="labels.length === 0" class="text-xs text-muted-foreground">None yet</span>
		</div>
		for _, lbl := range data.Labels {
			{{ id := strconv.FormatInt(lbl.ID, 10) }}
			<input type="hidden" name="labels" value={ id } form="issue-new-form" :disabled={ "!labels.includes('" + id + "')" }/>
		}
	</div>
}

templ issueNewPriority() {
	<div class="space-y-2">
		@issueNewPicker("priority", "Priority", "Set priority", "Set priority", false) {
			@issueNewPriorityItem("P0", "P0 · Critical", "bg-destructive")
			@issueNewPriorityItem("P1", "P1 · High", "bg-blue-500")
			@issueNewPriorityItem("P2", "P2 · Medium", "bg-warning")
			@issueNewPriorityItem("P3", "P3 · Low", "bg-muted-foreground")
			<div role="separator" class="my-1 h-px bg-border"></div>
			<button
				type="button"
				role="menuitemradio"
				x-on:click="priority = ''"
				:aria-checked="priority === '' ? 'true' : 'false'"
				class="flex w-full items-center px-2.5 py-1.5 rounded-md text-left text-[13px] text-muted-foreground hover:bg-accent hover:text-foreground"
			>
				No priority
			</button>
		}
		<div>
			@issueNewPriorityBadge("P0", "bg-destructive/10 text-destructive border-destructive/30")
			@issueNewPriorityBadge("P1", "bg-blue-500/10 text-blue-500 border-blue-500/30")
			@issueNewPriorityBadge("P2", "bg-warning/10 text-warning border-warning/30")
			@issueNewPriorityBadge("P3", "bg-muted text-muted-foreground border-border")
			<span x-show="priority === ''" class="text-xs text-muted-foreground">No priority</span>
		</div>
		<input type="hidden" name="priority" form="issue-new-form" :value="priority"/>
	</div>
}

templ issueNewPriorityItem(value, label, dotClass string) {
	<button
		type="button"
		role="menuitemradio"
		x-on:click={ "priority = '" + value + "'" }
		:aria-checked={ "priority === '" + value + "' ? 'true' : 'false'" }
		class="flex w-full items-center gap-2 px-2.5 py-1.5 rounded-md text-left text-[13px] text-muted-foreground hover:bg-accent hover:text-foreground"
	>
		<span class={ "h-2 w-2 rounded-full inline-block shrink-0", dotClass }></span>
		<span class="flex-1 truncate">{ label }</span>
		<span x-show={ "priority === '" + value + "'" } x-cloak>
			@issueNewCheckIcon()
		</span>
	</button>
}

templ issueNewPriorityBadge(value, classes string) {
	<span x-show={ "priority === '" + value + "'" } x-cloak class={ "inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium border", classes }>{ value }</span>
}

templ issueNewMilestone(data view.IssueNewData) {
	<div class="space-y-2">
		if len(data.Milestones) > 0 {
			@issueNewPicker("milestone", "Milestone", "Set milestone", "Set milestone", false) {
				for _, m := range data.Milestones {
					{{ id := strconv.FormatInt(m.ID, 10) }}
					<button
						type="button"
						role="menuitemradio"
						x-on:click={ "milestone = '" + id + "'" }
						:aria-checked={ "milestone === '" + id + "' ? 'true' : 'false'" }
						class="flex w-full items-center gap-2 px-2.5 py-1.5 rounded-md text-left text-[13px] text-muted-foreground hover:bg-accent hover:text-foreground"
					>
						<span class={ "h-2 w-2 rounded-full inline-block shrink-0", templ.KV("bg-muted-foreground", m.State == "closed"), templ.KV("bg-success", m.State != "closed") }></span>
						<span class="flex-1 truncate">{ m.Title }</span>
						<span x-show={ "milestone === '" + id + "'" } x-cloak>
							@issueNewCheckIcon()
						</span>
					</button>
				}
				<div role="separator" class="my-1 h-px bg-border"></div>
				<button
					type="button"
					role="menuitemradio"
					x-on:click="milestone = ''"
					:aria-checked="milestone === '' ? 'true' : 'false'"
					class="flex w-full items-center px-2.5 py-1.5 rounded-md text-left text-[13px] text-muted-foreground hover:bg-accent hover:text-foreground"
				>
					No milestone
				</button>
				@issueNewMenuLink("/" + data.Owner + "/" + data.RepoName + "/milestones/new") {
					@issueNewFlagIcon()
					New milestone
				}
			}
		} else {
			<h3 class="text-[12px] font-medium text-muted-foreground">Milestone</h3>
		}
		<div>
			for _, m := range data.Milestones {
				{{ id := strconv.FormatInt(m.ID, 10) }}
				<div x-show={ "milestone === '" + id + "'" } x-cloak class="text-sm">
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/milestones") } class="font-medium text-foreground hover:underline">{ m.Title }</a>
					if m.OpenCount+m.ClosedCount > 0 {
						@components.ProgressBarSmall(m.ClosedCount, m.OpenCount+m.ClosedCount)
					}
				</div>
			}
			<span x-show="milestone === ''" class="text-xs text-muted-foreground">No milestone</span>
		</div>
		<input type="hidden" name="milestone" form="issue-new-form" :value="milestone"/>
	</div>
}

templ issueNewLinkedPulls(data view.IssueNewData) {
	<div class="space-y-2">
		if len(data.RepoPulls) > 0 {
			@issueNewPicker("linked-pulls", "Linked pull requests", "Link a pull request", "Link a pull request", true) {
				for _, pr := range data.RepoPulls {
					{{ num := strconv.Itoa(pr.Number) }}
					<button
						type="button"
						role="menuitemcheckbox"
						x-on:click={ "toggle(linkedPulls, '" + num + "')" }
						:aria-checked={ "linkedPulls.includes('" + num + "') ? 'true' : 'false'" }
						class="flex w-full items-center gap-2 px-2.5 py-1.5 rounded-md text-left text-[13px] text-muted-foreground hover:bg-accent hover:text-foreground"
					>
						@issueNewBranchIcon()
						<span class="flex-1 truncate"><span class="font-mono text-muted-foreground">#{ num }</span> { pr.Title }</span>
						<span x-show={ "linkedPulls.includes('" + num + "')" } x-cloak>
							@issueNewCheckIcon()
						</span>
					</button>
				}
				<div role="separator" class="my-1 h-px bg-border"></div>
				@issueNewMenuLink("/" + data.Owner + "/" + data.RepoName + "/pulls") {
					@issueNewBranchIcon()
					Browse pull requests
				}
			}
		} else {
			<h3 class="text-[12px] font-medium text-muted-foreground">Linked pull requests</h3>
		}
		<ul class="space-y-1.5 text-[13px]">
			for _, pr := range data.RepoPulls {
				{{ num := strconv.Itoa(pr.Number) }}
				<li x-show={ "linkedPulls.includes('" + num + "')" } x-cloak class="flex items-center gap-2">
					@issueNewBranchIcon()
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/pulls/" + num) } class="hover:underline truncate"><span class="font-mono text-muted-foreground">#{ num }</span> { pr.Title }</a>
				</li>
			}
		</ul>
		<p x-show="linkedPulls.length === 0" class="text-xs text-muted-foreground">No linked PRs yet.</p>
		for _, pr := range data.RepoPulls {
			{{ num := strconv.Itoa(pr.Number) }}
			<input type="hidden" name="linked_pulls" value={ num } form="issue-new-form" :disabled={ "!linkedPulls.includes('" + num + "')" }/>
		}
	</div>
}

templ issueNewEditIcon() {
	<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 113 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
}

templ issueNewPlusIcon() {
	<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v8M8 12h8"></path></svg>
}

templ issueNewCheckIcon() {
	<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="shrink-0 text-success" aria-hidden="true" focusable="false"><polyline points="20 6 9 17 4 12"></polyline></svg>
}

templ issueNewBranchIcon() {
	<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-muted-foreground" aria-hidden="true" focusable="false"><line x1="6" y1="3" x2="6" y2="15"></line><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 9a9 9 0 01-9 9"></path></svg>
}

templ issueNewInviteIcon() {
	<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="shrink-0" aria-hidden="true" focusable="false"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"></path><circle cx="11" cy="7" r="4"></circle><line x1="19" y1="8" x2="19" y2="14"></line><line x1="22" y1="11" x2="16" y2="11"></line></svg>
}

templ issueNewTagIcon() {
	<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="shrink-0" aria-hidden="true" focusable="false"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
}

templ issueNewFlagIcon() {
