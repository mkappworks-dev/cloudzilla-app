package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ OrgSettings(data view.OrgSettingsData) {
	@layout.Base(data.BasePage, data.Org.Name+" — Settings") {
		<div class="space-y-6">
			<div class="flex justify-between items-center">
				<h1 class="text-2xl font-semibold tracking-tight">
					<a href={ templ.SafeURL("/" + data.Org.Name) } class="text-foreground hover:underline">{ data.Org.Name }</a>
					<span class="text-muted-foreground"> / Settings</span>
				</h1>
			</div>
			@components.Card(nil) {
				@components.CardHeader() {
					@components.CardTitle(2) {
						Members
					}
					@components.CardDescription() {
						Manage organization membership and roles.
					}
				}
				@components.CardContent() {
					<form hx-post={ "/api/orgs/" + data.Org.Name + "/members" } hx-target="#org-members-list" hx-swap="outerHTML" data-toast="Member added" class="flex gap-2 mb-4">
						<label for="org-member-username" class="sr-only">Username</label>
						@components.Input(templ.Attributes{
							"id":          "org-member-username",
							"type":        "text",
							"name":        "username",
							"placeholder": "Username",
							"required":    "required",
							"class":       "flex-1",
						})
						<label for="org-member-role" class="sr-only">Role</label>
						<select id="org-member-role" name="role" class="flex h-9 rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm">
							<option value="member">Member</option>
							<option value="owner">Owner</option>
						</select>
						@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
							Add Member
						}
					</form>
					<div id="org-members-list" class="divide-y divide-border border border-border rounded-md">
						if len(data.Members) == 0 {
							<div class="px-4 py-3 text-muted-foreground text-sm">No members yet.</div>
						}
						for _, m := range data.Members {
							<div class="px-4 py-3 flex justify-between items-center">
								<div>
									<a href={ templ.SafeURL("/" + m.Username) } class="text-foreground hover:underline font-medium">{ m.Username }</a>
									<span class="ml-2 text-xs text-muted-foreground capitalize">{ m.Role }</span>
								</div>
								@components.Button(components.ButtonDestructive, components.ButtonSizeSM, templ.Attributes{
									"hx-delete":           "/api/orgs/" + data.Org.Name + "/members/" + m.Username,
									"hx-target":           "#org-members-list",
									"hx-swap":             "outerHTML",
									"hx-confirm":          m.Username + " will lose access to " + data.Org.Name + ". You can add them back later.",
									"data-confirm-title":  "Remove " + m.Username + " from this organization?",
									"data-confirm-label":  "Remove",
									"data-confirm-danger": "true",
									"data-toast":          "Member removed",
									"type":                "button",
								}) {
									Remove
								}
							</div>
						}
					</div>
				}
			}
			@components.Card(templ.Attributes{"class": "border-destructive/40"}) {
				@components.CardHeader() {
					@components.CardTitle(2) {
						<span class="text-destructive">Transfer Ownership</span>
					}
					@components.CardDescription() {
						Transfer ownership of this organization to another member. You will be demoted to member.
					}
				}
				@components.CardContent() {
					<form method="POST" action={ templ.SafeURL("/api/orgs/" + data.Org.Name + "/transfer") } data-toast="Organization transferred">
						<div class="flex gap-3">
							<label for="org-transfer-new-owner" class="sr-only">New owner username</label>
							@components.Input(templ.Attributes{
								"id":          "org-transfer-new-owner",
								"type":        "text",
								"name":        "new_owner",
								"placeholder": "New owner username",
								"required":    "required",
								"class":       "flex-1",
							})
							@components.Button(components.ButtonDestructive, components.ButtonSizeDefault, templ.Attributes{
								"type":                "submit",
								"data-confirm-action":  "true",
								"data-confirm-title":   "Transfer this organization?",
								"data-confirm-msg":     data.Org.Name + " will be transferred to another user. You will be demoted to member and lose owner access.",
								"data-confirm-label":   "Transfer",
								"data-confirm-danger":  "true",
							}) {
								Transfer
							}
						</div>
					</form>
				}
			}
		</div>
	}
}
