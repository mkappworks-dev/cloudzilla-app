package pages

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Discussions(data view.DiscussionsData) {
	@layout.Base(data.BasePage, "Discussions · "+data.Owner+"/"+data.RepoName) {
		<div class="space-y-4">
			<div class="flex items-center justify-between">
				<h1 class="text-2xl font-bold">
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="text-foreground hover:underline">{ data.Owner }/{ data.RepoName }</a>
					<span class="text-muted-foreground font-normal"> / Discussions</span>
				</h1>
				if data.CanWrite {
					@components.Button(components.ButtonSuccess, components.ButtonSizeDefault, templ.Attributes{
						"x-data":    "",
						"x-on:click": "document.getElementById('new-discussion-form').classList.toggle('hidden')",
						"type":      "button",
					}) {
						New Discussion
					}
				}
			</div>
			if data.CanWrite {
				<div id="new-discussion-form" class="hidden rounded-md border border-border bg-card p-6 space-y-4">
					<h2 class="text-lg font-semibold">Start a Discussion</h2>
					<div>
						<label for="new-discussion-category" class="block text-sm font-medium text-foreground mb-1">Category</label>
						<select id="new-discussion-category" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm">
							for _, cat := range data.Categories {
								<option value={ strconv.FormatInt(cat.ID, 10) }>{ cat.Emoji } { cat.Name }</option>
							}
						</select>
					</div>
					<div>
						<label for="new-discussion-title" class="block text-sm font-medium text-foreground mb-1">Title</label>
						@components.Input(templ.Attributes{
							"id":          "new-discussion-title",
							"type":        "text",
							"placeholder": "Discussion title",
						})
					</div>
					<div>
						<label for="new-discussion-body" class="block text-sm font-medium text-foreground mb-1">Body (Markdown)</label>
						@components.Textarea(templ.Attributes{
							"id":   "new-discussion-body",
							"rows": "6",
							"class": "font-mono",
						})
					</div>
					@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{
						"hx-post":             "/api/repos/" + data.Owner + "/" + data.RepoName + "/discussions",
						"hx-vals":             `js:{category_id: parseInt(document.getElementById("new-discussion-category").value), title: document.getElementById("new-discussion-title").value, body: document.getElementById("new-discussion-body").value}`,
						"hx-on::after-request": "window.location.reload()",
						"type":                "button",
					}) {
						Submit
					}
				</div>
			}
			<div class="flex gap-6">
				<!-- Category sidebar -->
				<aside class="w-48 flex-shrink-0 space-y-1" aria-label="Categories">
					<a
						href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/discussions") }
						class={ "block px-3 py-2 rounded-md text-sm", templ.KV("bg-accent text-foreground font-medium", data.ActiveCategoryID == 0), templ.KV("text-muted-foreground hover:bg-muted hover:text-foreground", data.ActiveCategoryID != 0) }
					>
						All discussions
					</a>
					for _, cat := range data.Categories {
						<a
							href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/discussions?category=" + strconv.FormatInt(cat.ID, 10)) }
							class={ "block px-3 py-2 rounded-md text-sm", templ.KV("bg-accent text-foreground font-medium", cat.ID == data.ActiveCategoryID), templ.KV("text-muted-foreground hover:bg-muted hover:text-foreground", cat.ID != data.ActiveCategoryID) }
						>
							{ cat.Emoji } { cat.Name }
						</a>
					}
				</aside>
				<!-- Discussion list -->
				<div class="flex-1 space-y-2">
					if len(data.Discussions) == 0 {
						<div class="rounded-md border border-border bg-card p-8 text-center text-muted-foreground">
							<p>No discussions yet.</p>
							if data.CanWrite {
								<p class="text-sm mt-1">Be the first to start one.</p>
							}
						</div>
					} else {
						for _, d := range data.Discussions {
							<div class="rounded-md border border-border bg-card px-5 py-4 hover:border-ring/40 transition-colors">
								<div class="flex items-start gap-3">
									<div class="flex-1 min-w-0">
										<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/discussions/" + strconv.Itoa(d.Number)) } class="text-base font-semibold text-foreground hover:underline inline-flex items-center gap-1.5">
											if d.IsAnswered {
												<span class="inline-flex items-center justify-center w-4 h-4 bg-success text-success-foreground text-xs rounded-full" aria-label="Answered">✓</span>
											}
											{ d.Title }
										</a>
										<div class="text-xs text-muted-foreground mt-1">
											#{ strconv.Itoa(d.Number) } opened by <a href={ templ.SafeURL("/" + d.AuthorName) } class="text-foreground hover:underline">{ d.AuthorName }</a>
											on <time datetime={ d.CreatedAt.UTC().Format(time.RFC3339) }>{ d.CreatedAt.Format("Jan 2, 2006") }</time>
											if d.IsLocked {
												<span class="ml-2 inline-flex">
													@components.Badge(components.BadgeSecondary) {
														Locked
													}
												</span>
											}
										</div>
									</div>
								</div>
							</div>
						}
					}
				</div>
			</div>
		</div>
	}
}
