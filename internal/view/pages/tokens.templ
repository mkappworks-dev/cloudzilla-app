package pages

import (
	"strconv"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Tokens(data view.TokensData) {
	@layout.Base(data.BasePage, "Personal Access Tokens") {
		<div class="space-y-8 max-w-2xl">
			<div>
				<h1 class="text-3xl font-bold mb-2">Personal Access Tokens</h1>
				<p class="text-gray-600">Use tokens to authenticate API requests and git operations instead of your password.</p>
			</div>
			if data.NewToken != "" {
				<div class="bg-green-50 border border-green-400 rounded-lg p-4">
					<p class="font-semibold text-green-900 mb-2">Your new token (copy it now — it won't be shown again):</p>
					<code class="block bg-white border border-green-300 rounded px-3 py-2 text-sm font-mono break-all select-all">{ data.NewToken }</code>
					<p class="text-green-700 text-xs mt-2">Use this token in the <code class="bg-white px-1 rounded">Authorization: Bearer &lt;token&gt;</code> header, or as the password in HTTP Basic Auth for git operations.</p>
				</div>
			}
			<div class="bg-white border border-gray-200 rounded-lg p-6">
				<h2 class="text-xl font-bold mb-4">New Token</h2>
				<form method="POST" action="/api/user/tokens" class="space-y-4">
					<div>
						<label for="token-name" class="block text-sm font-medium text-gray-700 mb-1">Token name</label>
						<input type="text" id="token-name" name="name" placeholder="e.g., CI pipeline, laptop" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" required/>
					</div>
					<div>
						<label class="block text-sm font-medium text-gray-700 mb-2">Scopes</label>
						<div class="space-y-2">
							<label class="flex items-center gap-2 text-sm">
								<input type="checkbox" name="scopes" value="repo:read" class="rounded"/>
								<span><strong>repo:read</strong> — Read repositories, code, issues, PRs</span>
							</label>
							<label class="flex items-center gap-2 text-sm">
								<input type="checkbox" name="scopes" value="repo:write" class="rounded"/>
								<span><strong>repo:write</strong> — Push to repositories, create branches</span>
							</label>
							<label class="flex items-center gap-2 text-sm">
								<input type="checkbox" name="scopes" value="issues:write" class="rounded"/>
								<span><strong>issues:write</strong> — Create and update issues</span>
							</label>
							<label class="flex items-center gap-2 text-sm">
								<input type="checkbox" name="scopes" value="pulls:write" class="rounded"/>
								<span><strong>pulls:write</strong> — Create and update pull requests</span>
							</label>
						</div>
					</div>
					<div>
						<label for="expires-at" class="block text-sm font-medium text-gray-700 mb-1">Expiration (optional)</label>
						<input type="date" id="expires-at" name="expires_at" class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"/>
						<p class="text-gray-500 text-xs mt-1">Leave blank for a non-expiring token.</p>
					</div>
					<button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">
						Generate token
					</button>
				</form>
			</div>
			<div class="bg-white border border-gray-200 rounded-lg p-6">
				<h2 class="text-xl font-bold mb-4">Active Tokens</h2>
				<div id="tokens-list">
					if len(data.Tokens) > 0 {
						<table class="w-full text-sm">
							<thead>
								<tr class="text-left text-gray-500 border-b border-gray-200">
									<th class="pb-2 font-medium">Name</th>
									<th class="pb-2 font-medium">Scopes</th>
									<th class="pb-2 font-medium">Last used</th>
									<th class="pb-2 font-medium">Expires</th>
									<th class="pb-2 font-medium">Suffix</th>
									<th class="pb-2"></th>
								</tr>
							</thead>
							<tbody class="divide-y divide-gray-100">
								for _, t := range data.Tokens {
									<tr>
										<td class="py-3 font-medium text-gray-900">{ t.Name }</td>
										<td class="py-3 text-gray-600">
											if len(t.Scopes) > 0 {
												for _, s := range t.Scopes {
													<span class="inline-block bg-gray-100 text-gray-700 text-xs px-2 py-0.5 rounded mr-1">{ s }</span>
												}
											} else {
												<span class="text-gray-400">none</span>
											}
										</td>
										<td class="py-3 text-gray-500">
											if t.LastUsedAt != nil {
												{ t.LastUsedAt.Format("Jan 2, 2006") }
											} else {
												Never
											}
										</td>
										<td class="py-3 text-gray-500">
											if t.ExpiresAt != nil {
												{ t.ExpiresAt.Format("Jan 2, 2006") }
											} else {
												Never
											}
										</td>
										<td class="py-3 font-mono text-gray-500 text-xs">...{ t.LastEight }</td>
										<td class="py-3">
											<button
												hx-delete={ "/api/user/tokens/" + strconv.FormatInt(t.ID, 10) }
												hx-target="#tokens-list"
												hx-swap="outerHTML"
												hx-confirm="Revoke this token?"
												class="px-3 py-1 text-red-600 border border-red-200 rounded hover:bg-red-50 transition-colors text-xs">
												Revoke
											</button>
										</td>
									</tr>
								}
							</tbody>
						</table>
					} else {
						<div class="text-center py-8 border border-gray-200 border-dashed rounded-lg bg-gray-50">
							<p class="text-gray-500">No active tokens. Create one above.</p>
						</div>
					}
				</div>
			</div>
		</div>
	}
}
