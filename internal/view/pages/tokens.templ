package pages

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Tokens(data view.TokensData) {
	@layout.Base(data.BasePage, "Personal Access Tokens") {
		<div class="space-y-8 max-w-2xl">
			<div>
				<h1 class="text-3xl font-semibold tracking-tight mb-2">Personal Access Tokens</h1>
				<p class="text-muted-foreground">Use tokens to authenticate API requests and git operations instead of your password.</p>
			</div>
			if data.NewToken != "" {
				<div class="border border-success/40 bg-success/10 rounded-md p-4">
					<p class="font-semibold text-success mb-2">Your new token (copy it now — it won't be shown again):</p>
					<code class="block bg-background border border-success/40 rounded px-3 py-2 text-sm font-mono break-all select-all text-foreground">{ data.NewToken }</code>
					<p class="text-success text-xs mt-2">Use this token in the <code class="bg-background px-1 rounded">Authorization: Bearer &lt;token&gt;</code> header, or as the password in HTTP Basic Auth for git operations.</p>
				</div>
			}
			@components.Card(nil) {
				@components.CardHeader() {
					@components.CardTitle(2) {
						New Token
					}
				}
				@components.CardContent() {
					<form method="POST" action="/api/user/tokens" class="space-y-4">
						<div class="space-y-1.5">
							<label for="token-name" class="block text-sm font-medium text-foreground">Token name</label>
							@components.Input(templ.Attributes{
								"id":          "token-name",
								"type":        "text",
								"name":        "name",
								"placeholder": "e.g., CI pipeline, laptop",
								"required":    "required",
							})
						</div>
						<div>
							<label class="block text-sm font-medium text-foreground mb-2">Scopes</label>
							<div class="space-y-2">
								<label class="flex items-center gap-2 text-sm text-foreground">
									<input type="checkbox" name="scopes" value="repo:read" class="rounded border-input accent-foreground"/>
									<span><strong>repo:read</strong> — Read repositories, code, issues, PRs</span>
								</label>
								<label class="flex items-center gap-2 text-sm text-foreground">
									<input type="checkbox" name="scopes" value="repo:write" class="rounded border-input accent-foreground"/>
									<span><strong>repo:write</strong> — Push to repositories, create branches</span>
								</label>
								<label class="flex items-center gap-2 text-sm text-foreground">
									<input type="checkbox" name="scopes" value="issues:write" class="rounded border-input accent-foreground"/>
									<span><strong>issues:write</strong> — Create and update issues</span>
								</label>
								<label class="flex items-center gap-2 text-sm text-foreground">
									<input type="checkbox" name="scopes" value="pulls:write" class="rounded border-input accent-foreground"/>
									<span><strong>pulls:write</strong> — Create and update pull requests</span>
								</label>
							</div>
						</div>
						<div class="space-y-1.5">
							<label for="expires-at" class="block text-sm font-medium text-foreground">Expiration (optional)</label>
							@components.Input(templ.Attributes{
								"id":    "expires-at",
								"type":  "date",
								"name":  "expires_at",
								"class": "w-auto",
							})
							<p class="text-muted-foreground text-xs mt-1">Leave blank for a non-expiring token.</p>
						</div>
						@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
							Generate token
						}
					</form>
				}
			}
			@components.Card(nil) {
				@components.CardHeader() {
					@components.CardTitle(2) {
						Active Tokens
					}
				}
				@components.CardContent() {
					<div id="tokens-list">
						if len(data.Tokens) > 0 {
							<table class="w-full text-sm">
								<thead>
									<tr class="text-left text-muted-foreground border-b border-border">
										<th class="pb-2 font-medium">Name</th>
										<th class="pb-2 font-medium">Scopes</th>
										<th class="pb-2 font-medium">Last used</th>
										<th class="pb-2 font-medium">Expires</th>
										<th class="pb-2 font-medium">Suffix</th>
										<th class="pb-2"></th>
									</tr>
								</thead>
								<tbody class="divide-y divide-border">
									for _, t := range data.Tokens {
										<tr>
											<td class="py-3 font-medium text-foreground">{ t.Name }</td>
											<td class="py-3 text-foreground">
												if len(t.Scopes) > 0 {
													for _, s := range t.Scopes {
														<span class="inline-block bg-muted text-foreground text-xs px-2 py-0.5 rounded mr-1">{ s }</span>
													}
												} else {
													<span class="text-muted-foreground">none</span>
												}
											</td>
											<td class="py-3 text-muted-foreground">
												if t.LastUsedAt != nil {
													<time datetime={ t.LastUsedAt.UTC().Format(time.RFC3339) }>{ t.LastUsedAt.Format("Jan 2, 2006") }</time>
												} else {
													Never
												}
											</td>
											<td class="py-3 text-muted-foreground">
												if t.ExpiresAt != nil {
													<time datetime={ t.ExpiresAt.UTC().Format(time.RFC3339) }>{ t.ExpiresAt.Format("Jan 2, 2006") }</time>
												} else {
													Never
												}
											</td>
											<td class="py-3 font-mono text-muted-foreground text-xs">...{ t.LastEight }</td>
											<td class="py-3">
												@components.Button(components.ButtonDestructive, components.ButtonSizeSM, templ.Attributes{
													"hx-delete":  "/api/user/tokens/" + strconv.FormatInt(t.ID, 10),
													"hx-target":  "#tokens-list",
													"hx-swap":    "outerHTML",
													"hx-confirm": "Revoke this token?",
													"type":       "button",
												}) {
													Revoke
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						} else {
							<div class="text-center py-8 border border-dashed border-border rounded-md bg-muted/30">
								<p class="text-muted-foreground">No active tokens. Create one above.</p>
							</div>
						}
					</div>
				}
			}
		</div>
	}
}
