package pages

import (
	"fmt"
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/timefmt"
)

templ AccountIssues(data view.AccountIssuesData) {
	@layout.Base(data.BasePage, "Issues") {
		<div class="space-y-5">
			<section class="mb-6">
				<h1 class="text-2xl font-semibold tracking-tight">Issues</h1>
				<p class="mt-1 text-[13px] text-muted-foreground">Issues that involve you across every repository.</p>
			</section>
			@accountListTabs("Issue filter", data.AccountListNav)
			@components.ListFilterBar(data.Filter)
			if len(data.Issues) > 0 {
				<section class="rounded-md border border-border bg-card overflow-hidden" aria-labelledby="myissue-list">
					<h2 id="myissue-list" class="sr-only">Your issues</h2>
					<ol class="divide-y divide-border">
						for _, is := range data.Issues {
							@components.IssueListRow(components.IssueListRowData{
								Href:     fmt.Sprintf("/%s/issues/%d", is.RepoFullName, is.Number),
								Repo:     is.RepoFullName,
								Number:   is.Number,
								Title:    is.Title,
								Author:   is.AuthorName,
								State:    is.State,
								Private:  is.Visibility == "private",
								Time:     timefmt.Relative(is.UpdatedAt),
								Labels:   issueLabelChips(data.IssueLabels[is.ID]),
								Priority: issuePriority(is.Priority),
								Comments: data.IssueComments[is.ID],
							})
						}
					</ol>
				</section>
				@components.PaginationWithCount(data.PrevURL, data.NextURL, data.Page, data.TotalPages)
			} else if data.Filter.HasFilters {
				@accountListNoMatch("issues", data.StateFilter, data.ClearURL)
			} else {
				@components.EmptyState("No " + data.StateFilter + " issues.")
			}
		</div>
	}
}

// Scope tabs on the left set one @me qualifier; the state tabs on the right set is:.
templ accountListTabs(label string, nav view.AccountListNav) {
	@components.Tabs(label) {
		for _, tab := range nav.ScopeTabs {
			@components.TabLink(tab.URL, tab.Active) {
				{ tab.Label }
				@tabCountBadge(nav.Counts, tab.CountKey)
			}
		}
		<span class="ml-auto inline-flex items-center">
			@components.TabLink(nav.OpenURL, nav.StateFilter == "open") {
				Open
				if nav.ActiveScope != "" {
					@tabCountBadge(nav.Counts, nav.ActiveScope+":open")
				}
			}
			@components.TabLink(nav.ClosedURL, nav.StateFilter == "closed") {
				Closed
				if nav.ActiveScope != "" {
					@tabCountBadge(nav.Counts, nav.ActiveScope+":closed")
				}
			}
		</span>
	}
}

templ accountListNoMatch(noun, state, clearURL string) {
	<div class="bg-background border border-border rounded-lg p-8 text-center">
		<p class="text-muted-foreground">{ "No " + state + " " + noun + " match these filters." }</p>
		<a href={ templ.SafeURL(clearURL) } class="mt-2 inline-block text-sm text-primary hover:underline">Clear filters</a>
	</div>
}

// A nil counts map means the count query failed; render no badge rather than 0.
templ tabCountBadge(counts map[string]int, key string) {
	if counts != nil {
		<span class="ml-0.5 text-[11px] text-muted-foreground font-mono" aria-label={ components.Count(counts[key], "item", "items") }>{ strconv.Itoa(counts[key]) }</span>
	}
}

func issuePriority(p *string) string {
	if p == nil {
		return ""
	}
	return *p
}
