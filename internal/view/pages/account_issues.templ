package pages

import (
	"fmt"
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ AccountIssues(data view.AccountIssuesData) {
	@layout.Base(data.BasePage, "Issues") {
		<div class="space-y-5" x-data="{ q: '', openMenu: null }">
			<section class="mb-6">
				<h1 class="text-2xl font-semibold tracking-tight">Issues</h1>
				<p class="mt-1 text-[13px] text-muted-foreground">Issues that involve you across every repository.</p>
			</section>
			@components.Tabs("Issue filter") {
				@components.TabLink("/issues?filter=assigned&state="+data.State, data.Filter == "assigned") {
					Assigned
					@tabCountBadge(data.Counts, "assigned:"+data.State)
				}
				@components.TabLink("/issues?filter=created&state="+data.State, data.Filter == "created") {
					Created by you
					@tabCountBadge(data.Counts, "created:"+data.State)
				}
				@components.TabLink("/issues?filter=mentioned&state="+data.State, data.Filter == "mentioned") {
					Mentioned
					@tabCountBadge(data.Counts, "mentioned:"+data.State)
				}
				<span class="ml-auto inline-flex items-center">
					@components.TabLink("/issues?filter="+data.Filter+"&state=open", data.State == "open") {
						Open
						@tabCountBadge(data.Counts, data.Filter+":open")
					}
					@components.TabLink("/issues?filter="+data.Filter+"&state=closed", data.State == "closed") {
						Closed
						@tabCountBadge(data.Counts, data.Filter+":closed")
					}
				</span>
			}
			<div class="flex items-center gap-2 flex-wrap">
				<div class="relative flex-1 min-w-[240px]">
					<label for="issue-filter" class="sr-only">Filter issues</label>
					<input id="issue-filter" type="search" placeholder="Filter issues…" autocomplete="off" x-model="q" class="w-full h-9 pl-8 pr-3 text-[13px] bg-card border border-border rounded-md text-foreground placeholder:text-muted-foreground"/>
					<svg class="absolute left-2.5 top-2.5 text-muted-foreground" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
						<circle cx="11" cy="11" r="7"></circle>
						<path d="M21 21l-4.3-4.3"></path>
					</svg>
				</div>
				@repoFilterMenu("sort", issuesSortLabel(data.Sort), "Sort issues", "Sort by", issuesSortMenu(data))
			</div>
			if len(data.Issues) > 0 {
				<section class="rounded-md border border-border bg-card overflow-hidden" aria-labelledby="myissue-list">
					<h2 id="myissue-list" class="sr-only">Your issues</h2>
					<ol class="divide-y divide-border">
						for _, is := range data.Issues {
							@components.IssueListRow(components.IssueListRowData{
								Href:     fmt.Sprintf("/%s/issues/%d", is.RepoFullName, is.Number),
								Repo:     is.RepoFullName,
								Number:   is.Number,
								Title:    is.Title,
								Author:   is.AuthorName,
								State:    is.State,
								Time:     relativeTime(is.UpdatedAt),
								Labels:   issueLabelChips(data.IssueLabels[is.ID]),
								Priority: issuePriority(is.Priority),
								Comments: data.IssueComments[is.ID],
								LiAttrs: templ.Attributes{
									"data-name": is.RepoFullName + " " + is.Title,
									"x-show":    "!q || $el.dataset.name.toLowerCase().includes(q.toLowerCase())",
								},
							})
						}
					</ol>
				</section>
			} else {
				@components.EmptyState("No " + data.State + " issues.")
			}
		</div>
	}
}

func issuesSortURL(filter, state, sortBy string) string {
	u := "/issues?filter=" + filter + "&state=" + state
	if sortBy != "" && sortBy != "newest" {
		u += "&sort=" + sortBy
	}
	return u
}

func issuesSortOptions() []repoDropdownOption {
	return []repoDropdownOption{
		{"newest", "Sort: newest"},
		{"oldest", "Oldest"},
		{"updated", "Recently updated"},
		{"comments", "Most commented"},
	}
}

func issuesSortLabel(sortBy string) string {
	for _, o := range issuesSortOptions() {
		if o.Value == sortBy {
			return o.Label
		}
	}
	return "Sort: newest"
}

func issuesSortMenu(data view.AccountIssuesData) []repoMenuItem {
	items := make([]repoMenuItem, 0, 3)
	for _, o := range issuesSortOptions() {
		items = append(items, repoMenuItem{
			Label:  o.Label,
			URL:    issuesSortURL(data.Filter, data.State, o.Value),
			Active: data.Sort == o.Value,
		})
	}
	return items
}

// A nil counts map means the count query failed; render no badge rather than 0.
templ tabCountBadge(counts map[string]int, key string) {
	if counts != nil {
		<span class="ml-0.5 text-[11px] text-muted-foreground font-mono" aria-label={ strconv.Itoa(counts[key]) + " items" }>{ strconv.Itoa(counts[key]) }</span>
	}
}

func issuePriority(p *string) string {
	if p == nil {
		return ""
	}
	return *p
}
