package pages

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ AccountIssues(data view.AccountIssuesData) {
	@layout.Base(data.BasePage, "Issues") {
		<div class="space-y-5">
			<h1 id="issues-title" class="text-2xl font-semibold tracking-tight">Issues</h1>
			@components.Tabs("Issue filter") {
				@components.TabLink("/issues?filter=assigned&state="+data.State, data.Filter == "assigned") {
					Assigned
				}
				@components.TabLink("/issues?filter=created&state="+data.State, data.Filter == "created") {
					Created
				}
				@components.TabLink("/issues?filter=mentioned&state="+data.State, data.Filter == "mentioned") {
					Mentioned
				}
				<span class="ml-auto inline-flex items-center">
					@components.TabLink("/issues?filter="+data.Filter+"&state=open", data.State == "open") {
						Open
					}
					@components.TabLink("/issues?filter="+data.Filter+"&state=closed", data.State == "closed") {
						Closed
					}
				</span>
			}
			if len(data.Issues) > 0 {
				<ol class="rounded-md border border-border bg-card divide-y divide-border overflow-hidden">
					for _, is := range data.Issues {
						<li>
							<a href={ templ.SafeURL("/" + is.RepoFullName + "/issues/" + strconv.Itoa(is.Number)) } class="block px-4 py-3 hover:bg-muted/50">
								<div class="text-[13px] font-medium hover:underline">{ is.Title }</div>
								<div class="mt-1 flex flex-wrap items-center gap-1.5 text-[12px] text-muted-foreground">
									<span class="font-mono">{ is.RepoFullName }#{ strconv.Itoa(is.Number) }</span>
								</div>
							</a>
						</li>
					}
				</ol>
			} else {
				@components.EmptyState("No " + data.State + " issues.")
			}
		</div>
	}
}
