package pages

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Dependencies(data view.DependenciesData) {
	@layout.Base(data.BasePage, data.Owner+"/"+data.RepoName+" — Dependencies") {
		<div class="space-y-6">

			<section aria-labelledby="deps-title">
				<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="hover:underline">{ data.RepoName }</a>
					<span aria-hidden="true">·</span>
					Dependency graph
				</p>
				<h1 id="deps-title" class="text-2xl font-semibold tracking-tight">Dependencies</h1>
				if len(data.Dependencies) > 0 {
					<p class="mt-1 text-[13px] text-muted-foreground">
						<strong class="text-foreground font-medium">{ strconv.Itoa(len(data.Dependencies)) }</strong>
						if len(data.Dependencies) == 1 {
							package
						} else {
							packages
						}
						across
						<strong class="text-foreground font-medium">{ strconv.Itoa(len(data.ByManager)) }</strong>
						if len(data.ByManager) == 1 {
							manager.
						} else {
							managers.
						}
					</p>
				}
			</section>

			if len(data.Dependencies) > 0 {
				<section class="space-y-6">
					for mgr, deps := range data.ByManager {
						<article class="rounded-md border border-border bg-card overflow-hidden" aria-labelledby={ "dep-" + mgr }>
							<header class="px-4 py-2.5 border-b border-border bg-muted/50 flex items-center justify-between">
								<h2 id={ "dep-" + mgr } class="text-[13px] font-medium capitalize">{ mgr }</h2>
								<span class="font-mono text-[11px] text-muted-foreground">
									{ strconv.Itoa(len(deps)) }
									if len(deps) == 1 {
										package
									} else {
										packages
									}
								</span>
							</header>
							@components.Table(nil) {
								<thead class="sr-only">
									<tr>
										<th scope="col">Package</th>
										<th scope="col">Version</th>
										<th scope="col">Type</th>
									</tr>
								</thead>
								@components.TableBody() {
									for _, dep := range deps {
										@components.TableRow(true) {
											@components.TableCell(templ.Attributes{"class": "font-mono"}) {
												{ dep.Package }
											}
											@components.TableCell(templ.Attributes{"class": "text-muted-foreground font-mono text-[12px]"}) {
												if dep.Version != "" {
													{ dep.Version }
												} else {
													<span class="text-muted-foreground/50" aria-hidden="true">—</span>
												}
											}
											@components.TableCell(nil) {
												if dep.IsDev {
													@components.Badge(components.BadgeSecondary) {
														dev
													}
												} else {
													@components.Badge(components.BadgeOutline) {
														prod
													}
												}
											}
										}
									}
								}
							}
						</article>
					}
				</section>
			} else {
				<div class="rounded-md border border-border bg-card p-12 text-center">
					<p class="text-muted-foreground">No dependencies detected.</p>
					<p class="mt-2 text-sm text-muted-foreground">
						Push a commit containing
						<code class="font-mono text-[12px] px-1 py-0.5 bg-muted border border-border rounded">go.mod</code>,
						<code class="font-mono text-[12px] px-1 py-0.5 bg-muted border border-border rounded">package.json</code>,
						<code class="font-mono text-[12px] px-1 py-0.5 bg-muted border border-border rounded">requirements.txt</code>,
						or <code class="font-mono text-[12px] px-1 py-0.5 bg-muted border border-border rounded">Cargo.toml</code>
						to populate this graph.
					</p>
				</div>
			}
		</div>
	}
}
