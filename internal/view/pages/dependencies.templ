package pages

import (
	"fmt"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Dependencies(data view.DependenciesData) {
	@layout.Base(data.BasePage, data.Owner+"/"+data.RepoName+" — Dependencies") {
		<div class="space-y-6">
			<!-- Repo sub-nav -->
			<div class="rounded-md border border-border bg-card px-6 py-4 flex items-center gap-4">
				<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="text-foreground font-semibold hover:underline">{ data.Owner }/{ data.RepoName }</a>
				<span class="text-muted-foreground" aria-hidden="true">/</span>
				<span class="font-medium text-foreground">Dependency Graph</span>
			</div>
			if len(data.Dependencies) > 0 {
				<div class="text-sm text-muted-foreground px-1">
					{ fmt.Sprintf("%d", len(data.Dependencies)) }
					if len(data.Dependencies) == 1 {
						dependency
					} else {
						dependencies
					}
					detected across
					{ fmt.Sprintf("%d", len(data.ByManager)) }
					if len(data.ByManager) == 1 {
						package manager.
					} else {
						package managers.
					}
				</div>
				for mgr, deps := range data.ByManager {
					<div class="rounded-md border border-border bg-card overflow-hidden">
						<div class="px-6 py-3 bg-muted/40 border-b border-border flex items-center justify-between">
							<span class="font-semibold text-foreground capitalize">{ mgr }</span>
							<span class="text-xs text-muted-foreground">
								{ fmt.Sprintf("%d", len(deps)) }
								if len(deps) == 1 {
									package
								} else {
									packages
								}
							</span>
						</div>
						<table class="w-full text-sm">
							<thead>
								<tr class="text-left text-xs text-muted-foreground border-b border-border">
									<th scope="col" class="px-6 py-2 font-medium">Package</th>
									<th scope="col" class="px-6 py-2 font-medium">Version</th>
									<th scope="col" class="px-6 py-2 font-medium">Type</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-border">
								for _, dep := range deps {
									<tr class="hover:bg-muted/50">
										<td class="px-6 py-2 font-mono text-foreground">{ dep.Package }</td>
										<td class="px-6 py-2 text-muted-foreground">
											if dep.Version != "" {
												{ dep.Version }
											} else {
												<span class="text-muted-foreground/50" aria-hidden="true">—</span>
											}
										</td>
										<td class="px-6 py-2">
											if dep.IsDev {
												@components.Badge(components.BadgeSecondary) {
													dev
												}
											} else {
												@components.Badge(components.BadgeOutline) {
													prod
												}
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			} else {
				<div class="rounded-md border border-border bg-card p-12 text-center">
					<p class="text-muted-foreground">No dependencies detected.</p>
					<p class="text-sm text-muted-foreground mt-2">
						Push a commit containing
						<code class="bg-muted px-1 rounded border border-border">go.mod</code>,
						<code class="bg-muted px-1 rounded border border-border">package.json</code>,
						<code class="bg-muted px-1 rounded border border-border">requirements.txt</code>,
						or <code class="bg-muted px-1 rounded border border-border">Cargo.toml</code>
						to populate this graph.
					</p>
				</div>
			}
		</div>
	}
}
