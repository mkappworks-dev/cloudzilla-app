package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Dependencies(data view.DependenciesData) {
	@layout.Base(data.BasePage, data.Owner+"/"+data.RepoName+" — Dependencies") {
		<div class="space-y-6">
			<section aria-labelledby="deps-title">
				<h1 id="deps-title" class="text-2xl font-semibold tracking-tight">Dependencies</h1>
			</section>
			if len(data.Groups) == 0 {
				@components.EmptyState("No dependencies found. Cloudzilla scans the default branch root for: go.mod, package.json, requirements.txt, pyproject.toml, Pipfile, Cargo.toml.")
			} else {
				for _, g := range data.Groups {
					@components.DependencyGroup(g)
				}
			}
		</div>
	}
}
