package pages

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ pulseStatCard(label, opened, openedLabel, closed, closedLabel string, chart []int, accentOpen, accentClosed string) {
	<div class="rounded-md border border-border bg-card p-4 flex flex-col gap-3">
		<p class="font-mono text-[10px] text-muted-foreground uppercase tracking-wider">{ label }</p>
		<div class="flex items-end justify-between gap-4">
			<div class="space-y-1">
				<div class="flex items-baseline gap-2">
					<span class={ "text-2xl font-semibold tabular-nums", accentOpen }>{ opened }</span>
					<span class="text-[11px] text-muted-foreground">{ openedLabel }</span>
				</div>
				<div class="flex items-baseline gap-2">
					<span class={ "text-2xl font-semibold tabular-nums", accentClosed }>{ closed }</span>
					<span class="text-[11px] text-muted-foreground">{ closedLabel }</span>
				</div>
			</div>
			<div class="text-muted-foreground/50 shrink-0">
				@components.MiniChart(chart, 80, 32)
			</div>
		</div>
	</div>
}

templ Pulse(data view.PulseData) {
	@layout.Base(data.BasePage, "Pulse · "+data.Owner+"/"+data.RepoName) {
		<div class="space-y-8">

			<section aria-labelledby="pulse-title">
				<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="hover:underline">{ data.RepoName }</a>
					<span aria-hidden="true">·</span>
					Pulse
				</p>
				<h1 id="pulse-title" class="text-2xl font-semibold tracking-tight">
					Repository pulse
					<span class="text-muted-foreground font-normal text-base font-mono">last 30 days</span>
				</h1>
			</section>

			<section aria-labelledby="stats-heading">
				<h2 id="stats-heading" class="sr-only">Activity counts</h2>
				<div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
					@pulseStatCard(
						"Issues",
						strconv.Itoa(data.IssuesOpened), "opened",
						strconv.Itoa(data.IssuesClosed), "closed",
						data.IssuesLast30,
						"text-success", "text-destructive",
					)
					@pulseStatCard(
						"Pull requests",
						strconv.Itoa(data.PullsOpened), "opened",
						strconv.Itoa(data.PullsMerged), "merged",
						data.PullsLast30,
						"", "text-[hsl(270_70%_70%)]",
					)
					@pulseStatCard(
						"Commits",
						strconv.Itoa(data.RecentCommits), "total",
						"", "",
						data.CommitsLast30,
						"", "",
					)
				</div>
			</section>

			if len(data.Contributors) > 0 {
				<section class="rounded-md border border-border bg-card" aria-labelledby="top-contrib">
					<header class="px-4 py-3 border-b border-border flex items-center justify-between">
						<h2 id="top-contrib" class="text-[13px] font-medium">Top contributors</h2>
						<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/graphs/contributors") } class="text-[12px] text-muted-foreground hover:text-foreground">View all →</a>
					</header>
					<ul class="divide-y divide-border">
						for _, c := range data.Contributors {
							<li class="flex items-center gap-3 px-4 py-2.5">
								@components.Avatar(c.Name, components.AvatarSizeSM, c.Name)
								<span class="flex-1 font-medium text-[13px] truncate">{ c.Name }</span>
								<span class="text-[12px] text-muted-foreground truncate hidden sm:inline">{ c.Email }</span>
								<span class="font-mono text-[12px] font-semibold w-24 text-right">{ strconv.Itoa(c.Commits) } commits</span>
							</li>
						}
					</ul>
				</section>
			} else {
				@components.EmptyState("No commits yet.")
			}
		</div>
	}
}
