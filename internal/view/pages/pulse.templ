package pages

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Pulse(data view.PulseData) {
	@layout.Base(data.BasePage, "Pulse · "+data.Owner+"/"+data.RepoName) {
		<div class="space-y-6">
			<div class="flex items-center gap-2 text-sm text-muted-foreground">
				<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="text-foreground hover:underline font-medium">{ data.Owner }/{ data.RepoName }</a>
				<span aria-hidden="true">/</span>
				<span class="font-medium text-foreground">Pulse</span>
			</div>
			<h1 class="text-2xl font-bold">Repository Pulse <span class="text-muted-foreground font-normal text-base">(last 30 days)</span></h1>
			<div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
				<div class="rounded-md border border-border bg-card p-4 text-center">
					<div class="text-3xl font-bold text-success">{ strconv.Itoa(data.NewIssues) }</div>
					<div class="text-xs text-muted-foreground mt-1">New Issues</div>
				</div>
				<div class="rounded-md border border-border bg-card p-4 text-center">
					<div class="text-3xl font-bold text-destructive">{ strconv.Itoa(data.ClosedIssues) }</div>
					<div class="text-xs text-muted-foreground mt-1">Closed Issues</div>
				</div>
				<div class="rounded-md border border-border bg-card p-4 text-center">
					<div class="text-3xl font-bold text-foreground">{ strconv.Itoa(data.NewPRs) }</div>
					<div class="text-xs text-muted-foreground mt-1">New PRs</div>
				</div>
				<div class="rounded-md border border-border bg-card p-4 text-center">
					<div class="text-3xl font-bold text-[hsl(270_70%_70%)]">{ strconv.Itoa(data.MergedPRs) }</div>
					<div class="text-xs text-muted-foreground mt-1">Merged PRs</div>
				</div>
				<div class="rounded-md border border-border bg-card p-4 text-center">
					<div class="text-3xl font-bold text-foreground">{ strconv.Itoa(data.RecentCommits) }</div>
					<div class="text-xs text-muted-foreground mt-1">Commits</div>
				</div>
			</div>
			if len(data.Contributors) > 0 {
				<div class="rounded-md border border-border bg-card">
					<div class="flex items-center justify-between px-4 py-3 border-b border-border">
						<h2 class="font-semibold text-foreground">Top Contributors</h2>
						<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/graphs/contributors") } class="text-xs text-foreground hover:underline">View all</a>
					</div>
					<ul class="divide-y divide-border">
						for _, c := range data.Contributors {
							<li class="flex items-center gap-3 px-4 py-2">
								@components.Avatar(c.Name, components.AvatarSizeSM, c.Name)
								<span class="flex-1 font-medium text-foreground truncate">{ c.Name }</span>
								<span class="text-xs text-muted-foreground truncate">{ c.Email }</span>
								<span class="text-xs font-semibold text-foreground w-20 text-right font-mono">{ strconv.Itoa(c.Commits) } commits</span>
							</li>
						}
					</ul>
				</div>
			} else {
				@components.EmptyState("No commits yet.")
			}
		</div>
	}
}
