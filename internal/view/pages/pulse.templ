package pages

import (
	"strconv"

	"github.com/mkappworks/cloudzilla/internal/view"
	"github.com/mkappworks/cloudzilla/internal/view/layout"
)

templ Pulse(data view.PulseData) {
	@layout.Base(data.BasePage, "Pulse · "+data.Owner+"/"+data.RepoName) {
		<div class="space-y-6">
			<div class="flex items-center gap-2 text-sm text-gray-500">
				<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="text-blue-600 hover:underline font-medium">{ data.Owner }/{ data.RepoName }</a>
				<span>/</span>
				<span class="font-medium text-gray-700">Pulse</span>
			</div>
			<h1 class="text-2xl font-bold">Repository Pulse <span class="text-gray-400 font-normal text-base">(last 30 days)</span></h1>
			<div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
				<div class="bg-white border border-gray-200 rounded-lg p-4 text-center">
					<div class="text-3xl font-bold text-green-600">{ strconv.Itoa(data.NewIssues) }</div>
					<div class="text-xs text-gray-500 mt-1">New Issues</div>
				</div>
				<div class="bg-white border border-gray-200 rounded-lg p-4 text-center">
					<div class="text-3xl font-bold text-red-600">{ strconv.Itoa(data.ClosedIssues) }</div>
					<div class="text-xs text-gray-500 mt-1">Closed Issues</div>
				</div>
				<div class="bg-white border border-gray-200 rounded-lg p-4 text-center">
					<div class="text-3xl font-bold text-blue-600">{ strconv.Itoa(data.NewPRs) }</div>
					<div class="text-xs text-gray-500 mt-1">New PRs</div>
				</div>
				<div class="bg-white border border-gray-200 rounded-lg p-4 text-center">
					<div class="text-3xl font-bold text-purple-600">{ strconv.Itoa(data.MergedPRs) }</div>
					<div class="text-xs text-gray-500 mt-1">Merged PRs</div>
				</div>
				<div class="bg-white border border-gray-200 rounded-lg p-4 text-center">
					<div class="text-3xl font-bold text-gray-700">{ strconv.Itoa(data.RecentCommits) }</div>
					<div class="text-xs text-gray-500 mt-1">Commits</div>
				</div>
			</div>
			if len(data.Contributors) > 0 {
				<div class="bg-white border border-gray-200 rounded-lg">
					<div class="flex items-center justify-between px-4 py-3 border-b border-gray-100">
						<h2 class="font-semibold text-gray-700">Top Contributors</h2>
						<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/graphs/contributors") } class="text-xs text-blue-600 hover:underline">View all</a>
					</div>
					<ul class="divide-y divide-gray-50">
						for _, c := range data.Contributors {
							<li class="flex items-center gap-3 px-4 py-2">
								<span class="flex-1 font-medium text-gray-800 truncate">{ c.Name }</span>
								<span class="text-xs text-gray-500 truncate">{ c.Email }</span>
								<span class="text-xs font-semibold text-gray-700 w-16 text-right">{ strconv.Itoa(c.Commits) } commits</span>
							</li>
						}
					</ul>
				</div>
			} else {
				<div class="bg-white border border-gray-200 rounded-lg p-8 text-center">
					<p class="text-gray-500">No commits yet.</p>
				</div>
			}
		</div>
	}
}
