package pages

import (
	"strings"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
)

templ adminTabs(currentPath string) {
	@components.Tabs("Admin sections") {
		@components.TabLink("/admin/settings", currentPath == "/admin/settings") {
			Settings
		}
		@components.TabLink("/admin/users", strings.HasPrefix(currentPath, "/admin/users")) {
			Users
		}
		@components.TabLink("/admin/audit-log", currentPath == "/admin/audit-log") {
			Audit log
		}
		@components.TabLink("/admin/sso", currentPath == "/admin/sso") {
			Single sign-on
		}
	}
}
