package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Security(data view.SecurityPageData) {
	@layout.Base(data.BasePage, "Security Settings") {
		<div class="space-y-8 max-w-2xl">
			<div>
				<h1 class="text-3xl font-semibold tracking-tight mb-2">Security Settings</h1>
				<p class="text-muted-foreground">Manage two-factor authentication and account security.</p>
			</div>
			if data.Success != "" {
				<div class="p-4 border border-success/40 bg-success/10 rounded-md text-success text-sm">
					{ data.Success }
				</div>
			}
			if data.Error != "" {
				<div class="p-4 border border-destructive/40 bg-destructive/10 rounded-md text-destructive text-sm">
					{ data.Error }
				</div>
			}
			if len(data.BackupCodes) > 0 {
				<div class="border border-warning/40 bg-warning/10 rounded-md p-6">
					<h2 class="text-xl font-semibold tracking-tight text-warning mb-2">Save Your Backup Codes</h2>
					<p class="text-warning text-sm mb-4">
						Store these codes somewhere safe. Each code can only be used once to log in if you lose access to your authenticator app.
					</p>
					<div class="grid grid-cols-2 gap-2 font-mono text-sm">
						for _, code := range data.BackupCodes {
							<div class="bg-background border border-warning/40 rounded px-3 py-2 text-center tracking-widest text-foreground">{ code }</div>
						}
					</div>
				</div>
			}
			@components.Card(nil) {
				@components.CardHeader() {
					<div class="flex items-center justify-between">
						<div class="flex flex-col space-y-1.5">
							@components.CardTitle(2) {
								Two-Factor Authentication
							}
							@components.CardDescription() {
								Add an extra layer of security to your account using an authenticator app.
							}
						</div>
						if data.TOTPEnabled {
							@components.Badge(components.BadgeSuccess) {
								Enabled
							}
						} else {
							@components.Badge(components.BadgeSecondary) {
								Disabled
							}
						}
					</div>
				}
				@components.CardContent() {
					if data.TOTPEnabled {
						<form method="POST" action="/api/user/totp/disable" class="space-y-4">
							<p class="text-sm text-foreground">Enter your current authenticator code to disable 2FA.</p>
							<div class="space-y-1.5">
								<label for="disable-code" class="block text-sm font-medium text-foreground">Verification Code</label>
								@components.Input(templ.Attributes{
									"id":           "disable-code",
									"type":         "text",
									"name":         "code",
									"placeholder":  "000000",
									"maxlength":    "6",
									"required":     "required",
									"autocomplete": "one-time-code",
									"class":        "w-40 font-mono text-center text-lg",
								})
							</div>
							@components.Button(components.ButtonDestructive, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
								Disable Two-Factor Authentication
							}
						</form>
					} else if data.TOTPSecret != "" {
						<div class="space-y-6">
							<div>
								<h3 class="font-semibold mb-2 text-foreground">Step 1: Scan QR Code</h3>
								<p class="text-sm text-muted-foreground mb-4">Open your authenticator app (e.g., Google Authenticator, Authy) and scan this QR code:</p>
								<div class="flex gap-8 items-start">
									<img src={ "https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=" + data.OTPAuthURL } alt="TOTP QR Code" class="border border-border rounded-md"/>
									<div>
										<p class="text-sm font-medium text-foreground mb-1">Or enter this key manually:</p>
										<code class="block bg-muted border border-border rounded px-3 py-2 text-sm font-mono tracking-widest break-all text-foreground">{ data.TOTPSecret }</code>
									</div>
								</div>
							</div>
							<div>
								<h3 class="font-semibold mb-2 text-foreground">Step 2: Verify Code</h3>
								<form method="POST" action="/api/user/totp/enable" class="space-y-4">
									<input type="hidden" name="secret" value={ data.TOTPSecret }/>
									<div class="space-y-1.5">
										<label for="totp-code" class="block text-sm font-medium text-foreground">Enter the 6-digit code from your app</label>
										@components.Input(templ.Attributes{
											"id":           "totp-code",
											"type":         "text",
											"name":         "code",
											"placeholder":  "000000",
											"maxlength":    "6",
											"required":     "required",
											"autocomplete": "one-time-code",
											"class":        "w-40 font-mono text-center text-lg",
										})
									</div>
									@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
										Verify and Enable 2FA
									}
								</form>
							</div>
						</div>
					} else {
						<form method="POST" action="/settings/security/setup">
							<p class="text-sm text-foreground mb-4">
								Use an authenticator app like Google Authenticator, Authy, or 1Password to generate time-based codes.
							</p>
							@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
								Set Up Two-Factor Authentication
							}
						</form>
					}
				}
			}
		</div>
	}
}
