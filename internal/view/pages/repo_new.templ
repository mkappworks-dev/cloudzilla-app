package pages

import (
	"encoding/json"
	"github.com/mkappworks-dev/cloudzilla-app/internal/model"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

type repoNewSelectOption struct {
	Value      string
	Label      string
	Visibility string // owner options only: the owner's default repo visibility
}

templ RepoNew(data view.RepoNewData) {
	{{ var me string }}
	if data.CurrentUser != nil {
		{{ me = data.CurrentUser.Username }}
	}
	{{ ownerOpts := repoOwnerOpts(me, data.OwnedOrgs) }}
	{{ initialOwner := data.DefaultOwner }}
	{{ if initialOwner == "" {
	initialOwner = me
} }}
	{{ giOpts := repoNewGitignoreOpts(data.GitignoreTemplates) }}
	{{ licOpts := repoNewLicenseOpts(data) }}
	@layout.Base(data.BasePage, "New repository") {
		<section class="mb-6">
			<h1 class="text-2xl font-semibold tracking-tight">New repository</h1>
			<p class="mt-1 text-[13px] text-muted-foreground">A repository contains all of your project's files, revision history, and collaborators.</p>
		</section>
		<div class="grid lg:grid-cols-[1fr_280px] gap-8">
			<div class="min-w-0">
				<form id="repo-form" data-validate class="border border-border rounded-lg bg-card p-6 space-y-6" data-username={ me }>
					<div class="grid grid-cols-[1fr_auto_2fr] gap-3 items-start">
						<div>
							<label for="repo-owner-btn" class="block text-[12px] font-medium text-muted-foreground mb-1.5">Owner <span class="text-destructive" aria-hidden="true">*</span></label>
							@repoNewCustomSelect("repo-owner", "owner", ownerOpts, repoNewSelectOption{Value: initialOwner, Label: initialOwner})
						</div>
						<span class="text-muted-foreground pt-8" aria-hidden="true">/</span>
						<div data-field>
							<label for="repo-name" class="block text-[12px] font-medium text-muted-foreground mb-1.5">Repository name <span class="text-destructive" aria-hidden="true">*</span></label>
							<input id="repo-name" name="name" type="text" required pattern="[A-Za-z0-9._\-]+" data-pattern-message="Use letters, numbers, . - and _ only." placeholder="my-new-repo" autofocus value={ data.DefaultName } class="w-full bg-background border border-input rounded-md px-2.5 py-2 text-[13px] text-foreground font-mono placeholder:text-muted-foreground focus:outline-hidden focus:border-ring aria-invalid:border-destructive aria-invalid:focus:border-destructive"/>
						</div>
					</div>
					<p class="text-[12px] text-muted-foreground">Great repository names are short and memorable. Need inspiration? <span class="font-mono">turbo-octo-meme</span>.</p>
					<div>
						<label for="repo-description" class="block text-[12px] font-medium text-muted-foreground mb-1.5">
							Description <span class="text-muted-foreground font-normal">(optional)</span>
						</label>
						<textarea id="repo-description" name="description" rows="2" placeholder="A short description of your project" class="w-full bg-background border border-input rounded-md px-2.5 py-2 text-[13px] text-foreground placeholder:text-muted-foreground focus:outline-hidden focus:border-ring"></textarea>
					</div>
					@repoVisibilityFieldset(data.DefaultPrivate)
					<div class="space-y-3">
						<p class="text-[12px] font-medium text-muted-foreground">Initialize this repository with</p>
						<label class="flex items-start gap-2 text-[13px]">
							<input type="checkbox" id="repo-readme" checked?={ data.DefaultName == "" || data.DefaultInitReadme } class="mt-0.5 accent-[hsl(var(--ring))]"/>
							<span>Add a README — describes your project at a glance.</span>
						</label>
						<div>
							<label for="repo-gitignore-btn" class="block text-[12px] font-medium text-muted-foreground mb-1.5">
								Add .gitignore <span class="text-muted-foreground font-normal">(optional)</span>
							</label>
							@repoNewCustomSelect("repo-gitignore", "gitignore", giOpts, repoNewSelectOption{Value: "", Label: "None"})
							<p class="mt-1 text-[12px] text-muted-foreground">Choose which files Git should ignore, from a template.</p>
						</div>
						<div>
							<label for="repo-license-btn" class="block text-[12px] font-medium text-muted-foreground mb-1.5">
								Choose a license <span class="text-muted-foreground font-normal">(optional)</span>
							</label>
							@repoNewCustomSelect("repo-license", "license", licOpts, repoNewSelectOption{Value: "", Label: "None"})
							<p class="mt-1 text-[12px] text-muted-foreground">Sets the terms under which others may reuse your code.</p>
						</div>
					</div>
					<div id="repo-form-error" role="alert" class="hidden text-sm text-destructive bg-destructive/10 border border-destructive/40 rounded-md px-3 py-2"></div>
					<div class="flex items-center justify-end gap-2 pt-2 border-t border-border">
						@components.LinkButton("/", components.ButtonOutline, components.ButtonSizeDefault, nil) {
							Cancel
						}
						@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
							Create repository
						}
					</div>
				</form>
			</div>
			<aside class="space-y-6" aria-label="About repositories">
				<section aria-labelledby="rn-about">
					<h2 id="rn-about" class="text-[12px] font-medium text-muted-foreground mb-2">About repositories</h2>
					<p class="text-[13px] text-muted-foreground leading-relaxed">A repository is the home for one project — its code, full revision history, issues, and pull requests. Start it empty, or seed it with a README, .gitignore, and license below.</p>
				</section>
				<section aria-labelledby="rn-tips" class="border-t border-border pt-5">
					<h2 id="rn-tips" class="text-[12px] font-medium text-muted-foreground mb-2">Good to know</h2>
					<ul class="space-y-2 text-[13px] text-muted-foreground leading-relaxed">
						<li>Repository names must be unique within the owner account or organization.</li>
						<li>Visibility can be switched between public and private later in repository settings.</li>
						<li>Adding a README lets you clone a working copy right away — an empty repo only shows setup instructions.</li>
						<li>A license sets the terms for how others may reuse your code; you can add one later too.</li>
					</ul>
				</section>
			</aside>
		</div>
		<p class="mt-6 text-[12.5px] text-muted-foreground text-center">Want to import an existing repository instead? <a href="/repos/import" class="text-primary underline">Import a repository →</a></p>
		<script>
			(function() {
				const form = document.getElementById('repo-form');
				const errBox = document.getElementById('repo-form-error');
				form.addEventListener('submit', async function(e) {
					e.preventDefault();
					errBox.classList.add('hidden');
					const ownerSel = form.querySelector('[name=owner]');
					const owner = ownerSel ? ownerSel.value : '';
					const name = form.querySelector('[name=name]').value.trim();
					const description = form.querySelector('[name=description]').value;
					const isPrivate = form.querySelector('[name=visibility]:checked').value === 'private';
					const addReadme = document.getElementById('repo-readme').checked;
					const gitignore = document.getElementById('repo-gitignore').value;
					const license = document.getElementById('repo-license').value;
					const csrf = (document.cookie.match(/csrf_token=([^;]+)/) || [])[1] || '';
					const me = form.dataset.username;
					const isOrg = owner && owner !== me;
					const url = isOrg ? ('/api/orgs/' + encodeURIComponent(owner) + '/repos') : '/api/repos/';
					const res = await fetch(url, {
						method: 'POST',
						headers: {'Content-Type': 'application/json', 'X-CSRF-Token': csrf},
						body: JSON.stringify({
							name: name,
							description: description,
							private: isPrivate,
							add_readme: addReadme,
							gitignore: gitignore,
							license: license
						})
					});
					if (res.ok) {
						window.location.href = '/' + owner + '/' + name;
						return;
					}
					const text = await res.text();
					let msg = text;
					let field = '';
					try {
						const body = JSON.parse(text);
						msg = body.error || text;
						field = body.field || '';
					} catch (_) {}
					const target = field && form.elements[field];
					if (target && target.id) {
						CzFields.show(target, msg.charAt(0).toUpperCase() + msg.slice(1));
						target.focus();
						return;
					}
					errBox.textContent = msg || ('Failed to create repository (HTTP ' + res.status + ')');
					errBox.classList.remove('hidden');
				});
			})();
		</script>
	}
}

// repoVisibilityFieldset is the public/private choice shared by the new and import forms.
templ repoVisibilityFieldset(private bool) {
	<fieldset>
		<legend class="text-[12px] font-medium text-muted-foreground mb-2">Visibility</legend>
		<label class="border border-border rounded-md p-3 flex items-start gap-3 mb-2 cursor-pointer hover:bg-accent">
			<input type="radio" name="visibility" value="public" checked?={ !private } class="mt-0.5 accent-[hsl(var(--ring))]"/>
			<div>
				<p class="text-[13.5px] font-medium inline-flex items-center gap-2">
					<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="text-muted-foreground" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
					Public
				</p>
				<p class="mt-0.5 text-[12.5px] text-muted-foreground">Anyone on the internet can see this repository. You choose who can commit.</p>
			</div>
		</label>
		<label class="border border-border rounded-md p-3 flex items-start gap-3 cursor-pointer hover:bg-accent">
			<input type="radio" name="visibility" value="private" checked?={ private } class="mt-0.5 accent-[hsl(var(--ring))]"/>
			<div>
				<p class="text-[13.5px] font-medium inline-flex items-center gap-2">
					<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="text-muted-foreground" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0110 0v4"></path></svg>
					Private
				</p>
				<p class="mt-0.5 text-[12.5px] text-muted-foreground">You choose who can see and commit to this repository.</p>
			</div>
		</label>
	</fieldset>
}

// repoNewCustomSelect is a custom Alpine-driven dropdown matching the app's
// popup chrome (vs. browser-native <select> chrome). The hidden input keeps
// the value submittable by the form's JS handler (which reads .value by id).
templ repoNewCustomSelect(id, name string, options []repoNewSelectOption, initial repoNewSelectOption) {
	{{ menuOptions := make([]components.SelectMenuOption, 0, len(options)) }}
	for _, opt := range options {
		{{ menuOptions = append(menuOptions, components.SelectMenuOption{Value: opt.Value, Label: opt.Label}) }}
	}
	@components.SelectMenu(id+"-btn", name, name, menuOptions, initial.Value, templ.Attributes{"id": id, "data-visibility": repoOwnerVisibility(options)})
	if name == "owner" {
		<script>
		(function () {
			var input = document.getElementById('repo-owner');
			input.addEventListener('change', function () {
				var values = JSON.parse(input.dataset.visibility || '{}');
				var radio = Array.from(input.form.querySelectorAll('input[name=visibility]')).find(function (item) { return item.value === values[input.value]; });
				if (radio) radio.checked = true;
			});
		})();
		</script>
	}
}

func repoOwnerOpts(me string, orgs []model.Organization) []repoNewSelectOption {
	var opts []repoNewSelectOption
	if me != "" {
		opts = append(opts, repoNewSelectOption{Value: me, Label: me, Visibility: "public"})
	}
	for _, o := range orgs {
		vis := "private"
		if o.DefaultRepoVisibility == "public" {
			vis = "public"
		}
		opts = append(opts, repoNewSelectOption{Value: o.Name, Label: o.Name, Visibility: vis})
	}
	return opts
}

func repoNewGitignoreOpts(templates []string) []repoNewSelectOption {
	opts := []repoNewSelectOption{{Value: "", Label: "None"}}
	for _, g := range templates {
		opts = append(opts, repoNewSelectOption{Value: g, Label: g})
	}
	return opts
}

func repoNewLicenseOpts(data view.RepoNewData) []repoNewSelectOption {
	opts := []repoNewSelectOption{{Value: "", Label: "None"}}
	for _, l := range data.LicenseTemplates {
		opts = append(opts, repoNewSelectOption{Value: l.Key, Label: l.Name})
	}
	return opts
}

func repoOwnerVisibility(options []repoNewSelectOption) string {
	values := make(map[string]string)
	for _, opt := range options {
		if opt.Visibility != "" {
			values[opt.Value] = opt.Visibility
		}
	}
	b, _ := json.Marshal(values)
	return string(b)
}
