package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ RepoNew(data view.RepoNewData) {
	{{ var me string }}
	if data.CurrentUser != nil {
		{{ me = data.CurrentUser.Username }}
	}
	@layout.Base(data.BasePage, "New Repository") {
		<div class="max-w-2xl mx-auto space-y-6">

			<section aria-labelledby="rn-title">
				<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">Cloudzilla · New</p>
				<h1 id="rn-title" class="text-2xl font-semibold tracking-tight">Create a new repository</h1>
				<p class="mt-1 text-[13px] text-muted-foreground">A repository contains all project files, including the revision history.</p>
			</section>

			<form id="repo-form" class="space-y-5 rounded-md border border-border bg-card p-6" data-username={ me }>
				<div class="flex items-end gap-2">
					<div class="space-y-1.5">
						<label for="repo-owner" class="block text-sm font-medium">Owner</label>
						<select id="repo-owner" name="owner" class="flex h-9 rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm">
							if data.CurrentUser != nil {
								<option value={ data.CurrentUser.Username }>{ data.CurrentUser.Username }</option>
							}
							for _, o := range data.OwnedOrgs {
								<option value={ o.Name }>{ o.Name }</option>
							}
						</select>
					</div>
					<span class="text-muted-foreground pb-2 text-lg" aria-hidden="true">/</span>
					<div class="flex-1 space-y-1.5">
						<label for="repo-name" class="block text-sm font-medium">
							Repository name <span class="text-destructive" aria-hidden="true">*</span>
						</label>
						@components.Input(templ.Attributes{
							"type":        "text",
							"id":          "repo-name",
							"name":        "name",
							"required":    "required",
							"pattern":     "[A-Za-z0-9._-]+",
							"placeholder": "my-awesome-project",
							"class":       "font-mono",
						})
					</div>
				</div>
				<p class="text-[11px] text-muted-foreground -mt-3">Great repository names are short and memorable. Letters, numbers, dots, dashes, and underscores only.</p>

				<div class="space-y-1.5">
					<label for="repo-description" class="block text-sm font-medium">
						Description <span class="text-muted-foreground font-normal">(optional)</span>
					</label>
					@components.Input(templ.Attributes{
						"type":        "text",
						"id":          "repo-description",
						"name":        "description",
						"placeholder": "Short description of the project",
					})
				</div>

				<fieldset class="space-y-3 border-t border-border pt-5">
					<legend class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider px-2 -ml-2">Visibility</legend>
					<label class="flex items-start gap-3 cursor-pointer">
						@components.Radio(templ.Attributes{"name": "visibility", "value": "public", "checked": "checked", "class": "mt-0.5"})
						<span class="text-sm">
							<span class="font-medium block">Public</span>
							<span class="text-muted-foreground text-[12px]">Anyone on the internet can see this repository. You choose who can commit.</span>
						</span>
					</label>
					<label class="flex items-start gap-3 cursor-pointer">
						@components.Radio(templ.Attributes{"name": "visibility", "value": "private", "class": "mt-0.5"})
						<span class="text-sm">
							<span class="font-medium block">Private</span>
							<span class="text-muted-foreground text-[12px]">You choose who can see and commit to this repository.</span>
						</span>
					</label>
				</fieldset>

				<fieldset class="space-y-4 border-t border-border pt-5">
					<legend class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider px-2 -ml-2">Initialize this repository</legend>
					<label class="flex items-start gap-3 cursor-pointer">
						<input type="checkbox" id="repo-readme" class="mt-0.5 size-4 rounded border-input accent-foreground"/>
						<span class="text-sm">
							<span class="font-medium block">Add a README file</span>
							<span class="text-muted-foreground text-[12px]">This is where you can write a long description for your project.</span>
						</span>
					</label>
					<div class="flex flex-col gap-4 sm:flex-row">
						<div class="flex-1 space-y-1.5">
							<label for="repo-gitignore" class="block text-sm font-medium">Add .gitignore</label>
							<select id="repo-gitignore" name="gitignore" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm">
								<option value="">None</option>
								for _, g := range data.GitignoreTemplates {
									<option value={ g }>{ g }</option>
								}
							</select>
							<p class="text-[11px] text-muted-foreground">Choose which files not to track from a list of templates.</p>
						</div>
						<div class="flex-1 space-y-1.5">
							<label for="repo-license" class="block text-sm font-medium">Choose a license</label>
							<select id="repo-license" name="license" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm">
								<option value="">None</option>
								for _, l := range data.LicenseTemplates {
									<option value={ l.Key }>{ l.Name }</option>
								}
							</select>
							<p class="text-[11px] text-muted-foreground">A license tells others what they can and can't do with your code.</p>
						</div>
					</div>
				</fieldset>

				<div id="repo-form-error" role="alert" class="hidden text-sm text-destructive bg-destructive/10 border border-destructive/40 rounded-md px-3 py-2"></div>

				<div class="flex items-center gap-3 pt-2">
					@components.Button(components.ButtonSuccess, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
						Create repository
					}
					@components.LinkButton("/", components.ButtonGhost, components.ButtonSizeDefault, nil) {
						Cancel
					}
				</div>
			</form>

			<script>
				(function() {
					const form = document.getElementById('repo-form');
					const errBox = document.getElementById('repo-form-error');
					form.addEventListener('submit', async function(e) {
						e.preventDefault();
						errBox.classList.add('hidden');
						const ownerSel = form.querySelector('[name=owner]');
						const owner = ownerSel ? ownerSel.value : '';
						const name = form.querySelector('[name=name]').value.trim();
						const description = form.querySelector('[name=description]').value;
						const isPrivate = form.querySelector('[name=visibility]:checked').value === 'private';
						const addReadme = document.getElementById('repo-readme').checked;
						const gitignore = document.getElementById('repo-gitignore').value;
						const license = document.getElementById('repo-license').value;
						const csrf = (document.cookie.match(/csrf_token=([^;]+)/) || [])[1] || '';
						const me = form.dataset.username;
						const isOrg = owner && owner !== me;
						const url = isOrg ? ('/api/orgs/' + encodeURIComponent(owner) + '/repos') : '/api/repos/';
						const res = await fetch(url, {
							method: 'POST',
							headers: {'Content-Type': 'application/json', 'X-CSRF-Token': csrf},
							body: JSON.stringify({
								name: name,
								description: description,
								private: isPrivate,
								add_readme: addReadme,
								gitignore: gitignore,
								license: license
							})
						});
						if (res.ok) {
							window.location.href = '/' + owner + '/' + name;
							return;
						}
						const text = await res.text();
						let msg = text;
						try { msg = JSON.parse(text).error || text; } catch (_) {}
						errBox.textContent = msg || ('Failed to create repository (HTTP ' + res.status + ')');
						errBox.classList.remove('hidden');
					});
				})();
			</script>
		</div>
	}
}
