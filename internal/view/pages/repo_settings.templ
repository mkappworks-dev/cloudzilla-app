package pages

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/fragments"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

func settingsNavItems(d view.RepoSettingsData) []components.SettingsSidebarItem {
	items := []components.SettingsSidebarItem{
		{Label: "General", Href: "#general", Key: "general"},
	}
	if d.Mirror != nil {
		items = append(items, components.SettingsSidebarItem{Label: "Mirror", Href: "#mirror", Key: "mirror"})
	}
	items = append(items, []components.SettingsSidebarItem{
		{Label: "Access", Href: "#access", Key: "access"},
		{Label: "Collaborators", Href: "#collaborators", Key: "collaborators"},
		{Label: "Deploy keys", Href: "#deploy-keys", Key: "deploy-keys"},
		{Label: "Labels", Href: "#labels", Key: "labels"},
		{Label: "Branch protection", Href: "#branches", Key: "branches"},
		{Label: "Webhooks", Href: "#webhooks", Key: "webhooks"},
	}...)
	if d.CI != nil {
		items = append(items, components.SettingsSidebarItem{Label: "CI/CD", Href: "#ci", Key: "ci"})
	}
	if d.IsOwner {
		items = append(items, components.SettingsSidebarItem{Label: "Template", Href: "#template", Key: "template"})
	}
	dangerGroup := "Danger zone"
	if d.CanManage {
		items = append(items, components.SettingsSidebarItem{Label: "Visibility", Href: "#visibility", Key: "visibility", Danger: true, GroupLabel: dangerGroup})
		dangerGroup = ""
	}
	if d.IsOwner {
		items = append(items, components.SettingsSidebarItem{Label: "Archive", Href: "#archive", Key: "archive", Danger: true, GroupLabel: dangerGroup})
		items = append(items, components.SettingsSidebarItem{Label: "Transfer ownership", Href: "#transfer", Key: "transfer", Danger: true})
		items = append(items, components.SettingsSidebarItem{Label: "Delete repository", Href: "#delete", Key: "delete", Danger: true})
	}
	return items
}

templ visibilitySection(owner, repoName string, private bool, confirm components.ConfirmFactors) {
	<div id="visibility" class="scroll-mt-6"></div>
	@components.Card(templ.Attributes{"class": "border-destructive/40"}) {
		@components.CardHeader() {
			<h2 class="text-base font-semibold tracking-tight text-destructive">Change repository visibility</h2>
			@components.CardDescription() {
				if private {
					This repository is private, so only collaborators can see it. Making it public gives its code and history to everyone.
				} else {
					This repository is public, so anyone can view and clone it. Making it private hides it from everyone but collaborators.
				}
			}
		}
		@components.CardContent() {
			<div class="flex items-center justify-between gap-3">
				if private {
					@components.Badge(components.BadgeSecondary) {
						Private
					}
				} else {
					@components.Badge(components.BadgeSuccess) {
						Public
					}
				}
				@components.Button(components.ButtonDestructiveOutline, components.ButtonSizeSM, templ.Attributes{"type": "button", "onclick": templ.JSUnsafeFuncCall("document.getElementById('visibility-dialog').showModal()")}) {
					if private {
						Make public
					} else {
						Make private
					}
				}
			</div>
		}
	}
	@visibilityDialog(owner, repoName, private, confirm)
}

// Making a private repository public gives its code to everyone, for good, so
// it also takes the account's own confirmation.
templ visibilityDialog(owner, repoName string, private bool, confirm components.ConfirmFactors) {
	@components.Dialog("visibility-dialog") {
		<form hx-post={ "/" + owner + "/" + repoName + "/settings/visibility" } hx-swap="none" { templ.Attributes{"hx-on::after:request": stashToast("Visibility changed")}... }>
			<input type="hidden" name="private" value={ strconv.FormatBool(!private) }/>
			@components.DialogHeader() {
				@components.DialogTitle("visibility-dialog") {
					if private {
						Make this repository public?
					} else {
						Make this repository private?
					}
				}
				@components.DialogDescription() {
					if private {
						{ "Anyone on the internet will be able to view and clone " + repoName + ", including its history." }
					} else {
						{ "Only collaborators with access will be able to view " + repoName + ". Stars and forks by others stay." }
					}
				}
			}
			@components.DialogBody() {
				<div class="space-y-4">
					<div id="visibility-form-error"></div>
					@components.ConfirmNameField("visibility", repoName)
					if private {
						<div class="flex flex-wrap items-end gap-3">
							@components.ConfirmFields("visibility", confirm, true)
						</div>
					}
				</div>
			}
			@components.DialogFooter() {
				<button type="button" onclick="this.closest('dialog').close()" class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-transparent hover:bg-accent hover:text-accent-foreground h-9 px-4">Cancel</button>
				<button type="submit" class="inline-flex items-center justify-center rounded-md text-sm font-medium h-9 px-4 bg-destructive-fill text-destructive-fill-foreground hover:bg-destructive-fill/90">
					if private {
						Make public
					} else {
						Make private
					}
				</button>
			}
		</form>
	}
}

// settingsToggle renders a labelled pill-switch row for a repo feature flag.
// The toggle is green when ON, matching the design-system success colour.
templ settingsToggle(name, label, desc string, on bool) {
	<label class="flex items-start justify-between gap-4 py-3 border-b border-border last:border-b-0 cursor-pointer">
		<span class="min-w-0">
			<span class="block text-sm font-medium text-foreground">{ label }</span>
			<span class="block text-xs text-muted-foreground mt-0.5">{ desc }</span>
		</span>
		<span class="relative inline-flex h-5 w-9 shrink-0 items-center mt-0.5">
			<input type="checkbox" name={ name } checked?={ on } class="peer sr-only"/>
			<span class="absolute inset-0 rounded-full border border-border bg-muted transition-colors peer-checked:bg-success peer-checked:border-success"></span>
			<span class="absolute left-0.5 h-3.5 w-3.5 rounded-full bg-muted-foreground transition-transform peer-checked:bg-background peer-checked:translate-x-4"></span>
		</span>
	</label>
}

templ RepoSettings(data view.RepoSettingsData) {
	@layout.Base(data.BasePage, data.Owner+"/"+data.RepoName+" — Settings") {
		<div class="space-y-6">
			<section aria-labelledby="settings-title">
				<h1 id="settings-title" class="text-2xl font-semibold tracking-tight">Repository settings</h1>
			</section>
			<div class="grid grid-cols-12 gap-8">
				<aside class="col-span-12 lg:col-span-3" aria-label="Settings sections">
					<div class="lg:sticky lg:top-4">
						@components.SettingsSidebar(components.SettingsSidebarData{Items: settingsNavItems(data), Active: "general"})
					</div>
				</aside>
				<div class="col-span-12 lg:col-span-9 space-y-8">
					<!-- General -->
					<section id="general" class="scroll-mt-6">
						@components.Card(nil) {
							@components.CardHeader() {
								<h2 class="text-base font-semibold tracking-tight">General</h2>
								@components.CardDescription() {
									Basic information visible across the repository.
								}
							}
							@components.CardContent() {
								<div class="space-y-5">
									if data.CanManage {
										<form
											hx-post={ "/" + data.Owner + "/" + data.RepoName + "/settings/rename" }
											hx-swap="none"
											data-toast="Repository renamed"
											x-data={ templ.JSONString(map[string]string{"owner": data.Owner, "current": data.RepoName, "name": data.RepoName}) }
											class="space-y-1.5"
										>
											<label for="repo-name" class="block text-sm font-medium">Repository name</label>
											<div id="repo-rename-form-error" class="empty:hidden"></div>
											<div class="flex flex-wrap items-end gap-3">
												<input id="repo-name" type="text" name="name" x-model="name" required autocomplete="off" spellcheck="false" class="h-9 min-w-0 flex-1 rounded-md border border-input bg-transparent px-3 py-1 text-sm font-mono shadow-xs focus:outline-hidden focus:ring-2 focus:ring-ring"/>
												@components.ConfirmFields("rename-repo", data.Confirm, true)
												@components.Button(components.ButtonOutline, components.ButtonSizeDefault, templ.Attributes{
													"type":                "submit",
													"x-bind:disabled":     "name === current",
													"data-confirm-action": "true",
													"data-confirm-title":  "Rename this repository?",
													":data-confirm-msg":   "'It will move to /' + owner + '/' + name + '. Old links and git remotes keep redirecting until another repository takes the old name.'",
													"data-confirm-label":  "Rename",
													"data-confirm-danger": "true",
												}) {
													Rename
												}
											</div>
										</form>
									} else {
										<div class="space-y-1.5">
											<label for="repo-name" class="block text-sm font-medium">Repository name</label>
											<input id="repo-name" type="text" value={ data.RepoName } readonly class="h-9 w-full rounded-md border border-input bg-muted/50 px-3 py-1 text-sm font-mono text-muted-foreground"/>
										</div>
									}
									<form hx-post={ "/" + data.Owner + "/" + data.RepoName + "/settings/general" } hx-swap="none" hx-on::after:request="if(event.target===this&&!ctx.hx.retarget)this.querySelector('#repo-general-form-error').textContent=''" data-toast="Repository settings saved" class="space-y-5">
										<div id="repo-general-form-error" class="empty:hidden"></div>
										<div class="space-y-1.5">
											<label for="repo-description" class="block text-sm font-medium">Description</label>
											<textarea id="repo-description" name="description" rows="2" placeholder="Short description of this repository" class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-xs focus:outline-hidden focus:ring-2 focus:ring-ring">{ data.Repo.Description }</textarea>
										</div>
										<div class="space-y-1.5">
											<label for="repo-website" class="block text-sm font-medium">Homepage URL</label>
											<input id="repo-website" type="url" name="website" value={ data.Repo.Website } placeholder="https://example.com" class="h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs focus:outline-hidden focus:ring-2 focus:ring-ring"/>
										</div>
										<div class="space-y-1.5">
											<label for="repo-default-branch" class="block text-sm font-medium">Default branch</label>
											if len(data.Branches) > 0 {
												<select id="repo-default-branch" name="default_branch" disabled?={ data.Repo.ContentReadOnly() } class="h-9 w-full max-w-xs rounded-md border border-input bg-transparent px-3 py-1 text-sm font-mono shadow-xs focus:outline-hidden focus:ring-2 focus:ring-ring disabled:text-muted-foreground">
													for _, b := range data.Branches {
														if b == data.Repo.DefaultBranch {
															<option value={ b } selected>{ b }</option>
														} else {
															<option value={ b }>{ b }</option>
														}
													}
												</select>
											} else {
												<input id="repo-default-branch" type="text" name="default_branch" value={ data.Repo.DefaultBranch } disabled?={ data.Repo.ContentReadOnly() } class="h-9 w-full max-w-xs rounded-md border border-input bg-transparent px-3 py-1 text-sm font-mono shadow-xs focus:outline-hidden focus:ring-2 focus:ring-ring disabled:text-muted-foreground"/>
												<p class="text-xs text-muted-foreground">This repository has no branches yet; the first push creates this one.</p>
											}
											if data.Repo.ContentReadOnly() {
												<p class="text-xs text-muted-foreground">This repository is read-only, so its default branch can't change.</p>
											}
										</div>
										<div class="flex justify-end">
											@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
												Save changes
											}
										</div>
									</form>
								</div>
							}
						}
					</section>
					if data.Mirror != nil {
						@mirrorSettingsSection(*data.Mirror)
					}
					<!-- Access -->
					<section id="access" class="scroll-mt-6">
						@components.Card(nil) {
							@components.CardHeader() {
								<h2 class="text-base font-semibold tracking-tight">Access</h2>
								@components.CardDescription() {
									Control which features are enabled for this repository.
								}
							}
							@components.CardContent() {
								<form hx-post={ "/" + data.Owner + "/" + data.RepoName + "/settings/features" } hx-swap="none" data-toast="Feature settings saved">
									@settingsToggle("allow_issues", "Issues", "Let people open and track issues.", data.Repo.AllowIssues)
									@settingsToggle("allow_discussions", "Discussions", "Enable the Discussions tab for Q&A and announcements.", data.Repo.AllowDiscussions)
									@settingsToggle("allow_projects", "Projects", "Enable project boards for planning work.", data.Repo.AllowProjects)
									@settingsToggle("allow_wiki", "Wiki", "Enable the wiki for long-form documentation.", data.Repo.AllowWiki)
									<div class="flex justify-end pt-4">
										@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
											Save changes
										}
									</div>
								</form>
							}
						}
					</section>
					<div id="collaborators" class="scroll-mt-6"></div>
					<!-- Collaborators section -->
					@components.Card(nil) {
						@components.CardHeader() {
							<h2 class="text-base font-semibold tracking-tight">Collaborators</h2>
							@components.CardDescription() {
								People with access to this repository.
							}
						}
						@components.CardContent() {
							@fragments.RepoCollaborators(view.RepoCollaboratorsFragData{
								Owner:     data.Owner,
								RepoName:  data.RepoName,
								RepoID:    data.Repo.ID,
								Collabs:   data.Collabs,
								TeamGrants: data.TeamGrants,
								CanManage: data.CanManage,
								IsOwner:   data.IsOwner,
								Confirm:   data.Confirm,
							})
						}
					}
					<div id="deploy-keys" class="scroll-mt-6"></div>
					<!-- Deploy Keys section -->
					@components.Card(nil) {
						@components.CardHeader() {
							<div class="flex items-start justify-between gap-4">
								<div class="min-w-0">
									<h2 class="text-base font-semibold tracking-tight">Deploy keys</h2>
									@components.CardDescription() {
										SSH keys that grant CI/CD pipelines access to this repository.
									}
								</div>
								if data.CanManage {
									@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{"type": "button", "onclick": templ.JSUnsafeFuncCall("document.getElementById('deploy-key-dialog').showModal()")}) {
										Add deploy key
									}
								}
							</div>
						}
						@components.CardContent() {
							@fragments.DeployKeys(view.DeployKeysFragData{
								Owner:      data.Owner,
								RepoName:   data.RepoName,
								RepoID:     data.Repo.ID,
								DeployKeys: data.DeployKeys,
								CanManage:  data.CanManage,
							})
						}
					}
					if data.CanManage {
						@components.Dialog("deploy-key-dialog") {
							@components.DialogHeader() {
								@components.DialogTitle("deploy-key-dialog") {
									Add deploy key
								}
							}
							@components.DialogBody() {
								<form id="deploy-key-form" hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/keys" } hx-target="#deploy-keys-list" hx-swap="outerHTML" hx-on::after:request="if(event.target===this&&ctx.response.status<400&&!ctx.hx.retarget){this.closest('dialog').close();this.reset();this.querySelector('#deploy-key-form-error').textContent='';document.dispatchEvent(new CustomEvent('toast',{detail:{type:'success',message:'Deploy key added'}}));}" class="space-y-4">
									<div id="deploy-key-form-error"></div>
									<div class="space-y-1.5">
										<label for="deploy-key-title" class="block text-xs font-medium">Title</label>
										@components.Input(templ.Attributes{
											"id":          "deploy-key-title",
											"type":        "text",
											"name":        "title",
											"placeholder": "e.g., CI server",
											"required":    "required",
										})
									</div>
									<div class="space-y-1.5">
										<label for="deploy-key-public" class="block text-xs font-medium">Public key</label>
										@components.Textarea(templ.Attributes{
											"id":          "deploy-key-public",
											"name":        "public_key",
											"placeholder": "ssh-ed25519 AAAA...",
											"rows":        "3",
											"required":    "required",
											"class":       "font-mono text-xs",
										})
									</div>
									<label class="flex items-center gap-2 text-sm text-foreground cursor-pointer">
										<input type="checkbox" name="read_only" value="true" checked class="rounded-sm border-input accent-foreground"/>
										Read-only (uncheck to allow push access)
									</label>
									@components.ConfirmFields("deploy-key", data.Confirm, true)
								</form>
							}
							@components.DialogFooter() {
								@components.DialogClose() {
									Cancel
								}
								@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit", "form": "deploy-key-form"}) {
									Add deploy key
								}
							}
						}
					}
					<div id="labels" class="scroll-mt-6"></div>
					<!-- Labels section -->
					@components.Card(nil) {
						@components.CardHeader() {
							<div class="flex items-start justify-between gap-4">
								<div class="min-w-0">
									<h2 class="text-base font-semibold tracking-tight">Labels</h2>
									@components.CardDescription() {
										Categorize issues and pull requests.
									}
								</div>
								if data.CanManage {
									@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{"type": "button", "onclick": templ.JSUnsafeFuncCall("document.getElementById('label-dialog').showModal()")}) {
										New label
									}
								}
							</div>
						}
						@components.CardContent() {
							@fragments.RepoLabels(view.RepoLabelsFragData{
								Owner:    data.Owner,
								RepoName: data.RepoName,
								RepoID:   data.Repo.ID,
								Labels:   data.Labels,
								CanWrite: data.CanManage,
							})
						}
					}
					if data.CanManage {
						@components.Dialog("label-dialog") {
							@components.DialogHeader() {
								@components.DialogTitle("label-dialog") {
									New label
								}
							}
							@components.DialogBody() {
								<form id="label-form" hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/labels" } hx-target="#repo-labels" hx-swap="outerHTML" hx-on::after:request="if(ctx.response.status<400){this.closest('dialog').close();document.dispatchEvent(new CustomEvent('toast',{detail:{type:'success',message:'Label created'}}));}" class="space-y-4">
									<div class="space-y-1.5">
										<label for="label-name" class="block text-xs font-medium">Name</label>
										@components.Input(templ.Attributes{
											"id":          "label-name",
											"type":        "text",
											"name":        "name",
											"placeholder": "bug, enhancement…",
											"required":    "required",
										})
									</div>
									<div class="space-y-1.5">
										<label for="label-color" class="block text-xs font-medium">Color</label>
										<input id="label-color" type="color" name="color" value="#e5e5e5" class="w-12 h-9 rounded-md border border-input cursor-pointer bg-transparent"/>
									</div>
									<div class="space-y-1.5">
										<label for="label-description" class="block text-xs font-medium">Description (optional)</label>
										@components.Input(templ.Attributes{
											"id":          "label-description",
											"type":        "text",
											"name":        "description",
											"placeholder": "Short description",
										})
									</div>
								</form>
							}
							@components.DialogFooter() {
								@components.DialogClose() {
									Cancel
								}
								@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit", "form": "label-form"}) {
									Create label
								}
							}
						}
					}
					<div id="branches" class="scroll-mt-6"></div>
					<!-- Branch Protection section -->
					@components.Card(nil) {
						@components.CardHeader() {
							<div class="flex items-start justify-between gap-4">
								<div class="min-w-0">
									<h2 class="text-base font-semibold tracking-tight">Branch protection</h2>
									@components.CardDescription() {
										Protect branches by requiring reviews, status checks, or blocking force pushes.
									}
								</div>
								if data.CanManage {
									@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{"type": "button", "onclick": templ.JSUnsafeFuncCall("document.getElementById('protection-rule-dialog').showModal()")}) {
										Add rule
									}
								}
							</div>
						}
						@components.CardContent() {
							@fragments.BranchProtections(view.BranchProtectionsFragData{
								Owner:     data.Owner,
								RepoName:  data.RepoName,
								RepoID:    data.Repo.ID,
								Rules:     data.BranchProtections,
								CanManage: data.CanManage,
							})
						}
					}
					if data.CanManage {
						@components.Dialog("protection-rule-dialog") {
							@components.DialogHeader() {
								@components.DialogTitle("protection-rule-dialog") {
									Add rule
								}
							}
							@components.DialogBody() {
								<form id="protection-rule-form" hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/branches/protections" } hx-target="#branch-protections" hx-swap="outerHTML" hx-on::after:request="if(ctx.response.status<400){this.closest('dialog').close();document.dispatchEvent(new CustomEvent('toast',{detail:{type:'success',message:'Protection rule added'}}));}" class="space-y-4">
									<div class="space-y-1.5">
										<label for="bp-pattern" class="block text-xs font-medium">Branch pattern</label>
										@components.Input(templ.Attributes{
											"id":          "bp-pattern",
											"type":        "text",
											"name":        "pattern",
											"placeholder": "e.g., main or release/*",
											"required":    "required",
										})
									</div>
									<div class="space-y-1.5">
										<label for="bp-review-count" class="block text-xs font-medium">Required approvals</label>
										@components.Input(templ.Attributes{
											"id":    "bp-review-count",
											"type":  "number",
											"name":  "require_review_count",
											"value": "0",
											"min":   "0",
										})
									</div>
									<div class="space-y-1.5">
										<label for="bp-status-checks" class="block text-xs font-medium">Required status checks (comma-separated)</label>
										@components.Input(templ.Attributes{
											"id":          "bp-status-checks",
											"type":        "text",
											"name":        "require_status_checks",
											"placeholder": "e.g., ci/build,ci/test",
										})
									</div>
									<label class="flex items-center gap-2 text-sm text-foreground cursor-pointer">
										<input type="checkbox" name="block_force_push" value="true" checked class="rounded-sm border-input accent-foreground"/>
										Block force pushes
									</label>
									<label class="flex items-start gap-2 text-sm text-foreground cursor-pointer">
										<input type="checkbox" name="require_pull_request" value="true" class="mt-0.5 rounded-sm border-input accent-foreground"/>
										<span>
											Require a pull request
											<span class="block text-xs text-muted-foreground">Refuses pushes, branch deletes and edits made in the browser; changes land only by merging a pull request.</span>
										</span>
									</label>
								</form>
							}
							@components.DialogFooter() {
								@components.DialogClose() {
									Cancel
								}
								@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit", "form": "protection-rule-form"}) {
									Add rule
								}
							}
						}
					}
					@components.Dialog("webhook-dialog") {
						@components.DialogHeader() {
							@components.DialogTitle("webhook-dialog") {
								Add webhook
							}
						}
						@components.DialogBody() {
							<form id="webhook-form" hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/hooks" } hx-target="#webhooks-list" hx-swap="outerHTML" hx-on::after:request="if(event.target===this&&ctx.response.status<400&&!ctx.hx.retarget){this.closest('dialog').close();this.reset();this.querySelector('#webhook-form-error').textContent='';document.dispatchEvent(new CustomEvent('toast',{detail:{type:'success',message:'Webhook added'}}));}" class="space-y-4">
								<div id="webhook-form-error"></div>
								<div class="space-y-1.5">
									<label for="webhook-url" class="block text-xs font-medium">Payload URL</label>
									@components.Input(templ.Attributes{
										"id":          "webhook-url",
										"type":        "url",
										"name":        "url",
										"placeholder": "https://example.com/webhook",
										"required":    "required",
									})
								</div>
								<div class="space-y-1.5">
									<label for="webhook-secret" class="block text-xs font-medium">Secret</label>
									@components.Input(templ.Attributes{
										"id":          "webhook-secret",
										"type":        "text",
										"name":        "secret",
										"placeholder": "Optional HMAC secret",
									})
								</div>
								<div class="space-y-1.5">
									<label for="webhook-events" class="block text-xs font-medium">Events (comma-separated)</label>
									@components.Input(templ.Attributes{
										"id":    "webhook-events",
										"type":  "text",
										"name":  "events",
										"value": "push,issues,pull_request",
									})
								</div>
								@components.ConfirmFields("webhook", data.Confirm, true)
							</form>
						}
						@components.DialogFooter() {
							@components.DialogClose() {
								Cancel
							}
							@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit", "form": "webhook-form"}) {
								Add webhook
							}
						}
					}
					<div id="webhooks" class="scroll-mt-6"></div>
					<!-- Webhooks section -->
					@components.Card(nil) {
						@components.CardHeader() {
							<div class="flex items-start justify-between gap-4">
								<div class="min-w-0">
									<h2 class="text-base font-semibold tracking-tight">Webhooks</h2>
									@components.CardDescription() {
										Send HTTP requests to external services when events occur in this repository.
									}
								</div>
								@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{"type": "button", "onclick": templ.JSUnsafeFuncCall("document.getElementById('webhook-dialog').showModal()")}) {
									Add webhook
								}
							</div>
						}
						@components.CardContent() {
							if data.OrgWebhooks {
								<p class="mb-3 text-xs text-muted-foreground">An organization webhook also fires for this repository.</p>
							}
							@fragments.WebhooksList(view.WebhooksFragData{
								Owner:     data.Owner,
								RepoName:  data.RepoName,
								RepoID:    data.Repo.ID,
								Webhooks:  data.Webhooks,
								CanManage: data.CanManage,
							})
						}
					}
					if data.CI != nil {
						<div id="ci" class="scroll-mt-6"></div>
						@ciToggleCard(*data.CI)
						<div id="secrets" class="scroll-mt-6"></div>
						@fragments.CISecretsCard(*data.CI)
						@ciSecretDialog(data.CI.Base)
						if data.Runners != nil {
							<div id="runners" class="scroll-mt-6"></div>
							@fragments.RunnersCard(*data.Runners)
							@runnerDialog(view.RunnerDialogData{Base: data.Runners.Base, Title: "New runner"})
						}
					}
					if data.IsOwner {
						<div id="template" class="scroll-mt-6"></div>
						<!-- Template repository section -->
						@components.Card(nil) {
							@components.CardHeader() {
								<h2 class="text-base font-semibold tracking-tight">Template repository</h2>
							}
							@components.CardContent() {
								<div class="flex items-center justify-between">
									<div>
										<p class="text-sm font-medium text-foreground">Template repository</p>
										<p class="text-xs text-muted-foreground mt-0.5">Allow other users to create new repositories with the same directory structure and files.</p>
									</div>
									if data.Repo.IsTemplate {
										<input type="checkbox" aria-label="Template repository" checked hx-patch={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/template" } hx-vals='{"is_template": "false"}' hx-trigger="change" { templ.Attributes{"hx-on::after:request": stashToast("Repository is no longer a template")}... } class="rounded-sm border-input accent-foreground h-4 w-4"/>
									} else {
										<input
											type="checkbox"
											aria-label="Template repository"
											hx-patch={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/template" }
											hx-vals='{"is_template": "true"}'
											hx-trigger="change"
											hx-confirm={ "Anyone will be able to create new repositories with the same directory structure and files as " + data.RepoName + "." }
											data-confirm-title="Make this a template repository?"
											data-confirm-label="Make template"
											{ templ.Attributes{"hx-on::after:request": stashToast("Repository is now a template")}... }
											class="rounded-sm border-input accent-foreground h-4 w-4"
										/>
									}
								</div>
							}
						}
					}
					if data.CanManage {
						@visibilitySection(data.Owner, data.RepoName, data.Repo.Private, data.Confirm)
					}
					if data.IsOwner {
						<div id="archive" class="scroll-mt-6"></div>
						<!-- Archive / Unarchive section (owner-only) -->
						@components.Card(templ.Attributes{"class": "border-destructive/40"}) {
							@components.CardHeader() {
								if data.Repo.IsArchived {
									<h2 class="text-base font-semibold tracking-tight text-destructive">Unarchive this repository</h2>
									@components.CardDescription() {
										Restore push access and return the repository to active views.
									}
								} else {
									<h2 class="text-base font-semibold tracking-tight text-destructive">Archive this repository</h2>
									@components.CardDescription() {
										Make the repository read-only and hide it from active views. You can unarchive it later.
									}
								}
							}
							@components.CardContent() {
								<div class="flex justify-end">
									if data.Repo.IsArchived {
										@components.Button(components.ButtonSuccess, components.ButtonSizeSM, templ.Attributes{
											"hx-post":              "/api/repos/" + data.Owner + "/" + data.RepoName + "/unarchive",
											"hx-target":            "body",
											"hx-confirm":           "Push access will be restored and " + data.RepoName + " will return to active views.",
											"data-confirm-title":   "Unarchive this repository?",
											"data-confirm-label":   "Unarchive",
											"hx-on::after:request": stashToast("Repository unarchived"),
											"type":                 "button",
										}) {
											Unarchive
										}
									} else {
										@components.Button(components.ButtonDestructiveOutline, components.ButtonSizeSM, templ.Attributes{"type": "button", "onclick": templ.JSUnsafeFuncCall("document.getElementById('archive-dialog').showModal()")}) {
											Archive
										}
									}
								</div>
							}
						}
						if !data.Repo.IsArchived {
							@archiveDialog(data.Owner, data.RepoName)
						}
						<div id="transfer" class="scroll-mt-6"></div>
						@components.Card(templ.Attributes{"class": "border-destructive/40"}) {
							@components.CardHeader() {
								<h2 class="text-base font-semibold tracking-tight text-destructive">Transfer ownership</h2>
								@components.CardDescription() {
									Transfer this repository to another user, who has { transferTTLDays() } days to accept it, or at once to an organization you own. You keep owner access only if the new owner is you or an organization you own.
								}
							}
							@components.CardContent() {
								if data.PendingTransfer != nil {
									<div class="flex flex-wrap items-center justify-between gap-3">
										<p class="text-[13px]">
											Waiting for <span class="font-mono">{ "@" + data.PendingTransfer.RecipientName }</span> to accept.
											<span class="text-muted-foreground">
												<time datetime={ data.PendingTransfer.ExpiresAt.UTC().Format(time.RFC3339) }>{ transferExpiry(data.PendingTransfer.ExpiresAt) }</time>
											</span>
										</p>
										@components.Button(components.ButtonOutline, components.ButtonSizeDefault, templ.Attributes{
											"type":                 "button",
											"hx-delete":            "/api/repos/" + data.Owner + "/" + data.RepoName + "/transfer",
											"hx-swap":              "none",
											"hx-on::after:request": stashToast("Transfer cancelled"),
										}) {
											Cancel transfer
										}
									</div>
								} else {
									<form
										hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/transfer" }
										hx-swap="none"
										hx-on::after:request="if(event.target===this&&ctx.response.status<400){sessionStorage.setItem('cz-toast',JSON.stringify({type:'success',message:ctx.response.status===202?'Transfer requested':'Repository transferred'}));}"
									>
										<div class="flex flex-wrap items-end gap-3">
											<label for="transfer-new-owner" class="sr-only">New owner: user or organization name</label>
											@components.Input(templ.Attributes{
												"id":          "transfer-new-owner",
												"type":        "text",
												"name":        "new_owner",
												"placeholder": "User or organization name",
												"required":    "required",
												"class":       "flex-1",
											})
											@components.ConfirmFields("transfer-repo", data.Confirm, true)
											@components.Button(components.ButtonDestructive, components.ButtonSizeDefault, templ.Attributes{
												"type":                "submit",
												"data-confirm-action": "true",
												"data-confirm-title":  "Transfer ownership?",
												"data-confirm-msg":    "A user must accept " + data.RepoName + " before it moves; an organization you own gets it at once. You keep owner access only if the new owner is you or an organization you own.",
												"data-confirm-label":  "Transfer",
												"data-confirm-danger": "true",
											}) {
												Transfer
											}
										</div>
									</form>
								}
							}
						}
						<div id="delete" class="scroll-mt-6"></div>
						<!-- Delete repository (owner-only) -->
						@components.Card(templ.Attributes{"class": "border-destructive/40"}) {
							@components.CardHeader() {
								<h2 class="text-base font-semibold tracking-tight text-destructive">Delete this repository</h2>
								@components.CardDescription() {
									Permanently remove this repository and all its data. This cannot be undone.
								}
							}
							@components.CardContent() {
								<div class="flex justify-end">
									@components.Button(components.ButtonDestructiveOutline, components.ButtonSizeDefault, templ.Attributes{"type": "button", "onclick": templ.JSUnsafeFuncCall("document.getElementById('delete-repo-dialog').showModal()")}) {
										Delete repository
									}
								</div>
							}
						}
						@deleteRepoDialog(data.Owner, data.RepoName, data.Confirm)
					}
				</div>
			</div>
		</div>

		<script>
			(function () {
				var nav = document.querySelector('nav[aria-label="Settings sections"]');
				if (!nav) return;
				var links = Array.prototype.slice.call(nav.querySelectorAll('a[href^="#"]'));
				var targets = links
					.map(function (l) { return { link: l, el: document.getElementById(l.getAttribute('href').slice(1)) }; })
					.filter(function (t) { return t.el; });
				if (!targets.length) return;
				function update() {
					var active = targets[0];
					for (var i = 0; i < targets.length; i++) {
						if (targets[i].el.getBoundingClientRect().top <= 120) active = targets[i];
					}
					links.forEach(function (l) {
						var on = l === active.link;
						var isDanger = l.classList.contains('text-destructive');
						if (!isDanger) {
							l.classList.toggle('bg-accent', on);
							l.classList.toggle('text-foreground', on);
							l.classList.toggle('font-medium', on);
							l.classList.toggle('text-muted-foreground', !on);
						}
					});
				}
				update();
				window.addEventListener('scroll', update, { passive: true });
				window.addEventListener('resize', update, { passive: true });
			})();
		</script>
	}
}

templ archiveDialog(owner, repoName string) {
	@components.Dialog("archive-dialog") {
		<form hx-post={ "/api/repos/" + owner + "/" + repoName + "/archive" } hx-swap="none" { templ.Attributes{"hx-on::after:request": stashToast("Repository archived")}... }>
			@components.DialogHeader() {
				@components.DialogTitle("archive-dialog") {
					Archive this repository?
				}
				@components.DialogDescription() {
					{ repoName + " will become read-only and hidden from active views. You can unarchive it later." }
				}
			}
			@components.DialogBody() {
				<div class="space-y-4">
					<div id="archive-form-error"></div>
					@components.ConfirmNameField("archive", repoName)
				</div>
			}
			@components.DialogFooter() {
				<button type="button" onclick="this.closest('dialog').close()" class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-transparent hover:bg-accent hover:text-accent-foreground h-9 px-4">Cancel</button>
				<button type="submit" class="inline-flex items-center justify-center rounded-md text-sm font-medium h-9 px-4 bg-destructive-fill text-destructive-fill-foreground hover:bg-destructive-fill/90">Archive repository</button>
			}
		</form>
	}
}

templ deleteRepoDialog(owner, repoName string, confirm components.ConfirmFactors) {
	@components.Dialog("delete-repo-dialog") {
		<form hx-post={ "/api/repos/" + owner + "/" + repoName + "/delete" } hx-swap="none" { templ.Attributes{"hx-on::after:request": stashToast("Repository deleted")}... }>
			@components.DialogHeader() {
				@components.DialogTitle("delete-repo-dialog") {
					<span class="text-destructive">Delete this repository?</span>
				}
				@components.DialogDescription() {
					{ "This permanently removes " + repoName + " and all of its data — issues, pull requests, and history. This cannot be undone." }
				}
			}
			@components.DialogBody() {
				<div class="space-y-4">
					<div id="delete-repo-form-error"></div>
					@components.ConfirmNameField("delete-repo", repoName)
					<div class="flex flex-wrap items-end gap-3">
						@components.ConfirmFields("delete-repo", confirm, true)
					</div>
				</div>
			}
			@components.DialogFooter() {
				<button type="button" onclick="this.closest('dialog').close()" class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-transparent hover:bg-accent hover:text-accent-foreground h-9 px-4">Cancel</button>
				<button type="submit" class="inline-flex items-center justify-center rounded-md text-sm font-medium h-9 px-4 bg-destructive-fill text-destructive-fill-foreground hover:bg-destructive-fill/90">Delete repository</button>
			}
		</form>
	}
}

// mirrorSettingsSection is frame 2 of the mirror mockups. The token field is
// write-only: it is never filled in, and an empty one keeps the stored token.
templ mirrorSettingsSection(m view.MirrorSettings) {
	<section id="mirror" class="scroll-mt-6 flex flex-col gap-8">
		@components.Card(nil) {
			@components.CardHeader() {
				<h2 class="text-base font-semibold tracking-tight">Pull mirror</h2>
				@components.CardDescription() {
					Branches and tags follow the source. The repository is read-only until you stop mirroring.
				}
			}
			@components.CardContent() {
				<div class="flex flex-col gap-5">
					<div class="flex flex-wrap items-center justify-between gap-4 rounded-md border border-border bg-background px-3.5 py-3">
						<dl class="grid grid-cols-3 gap-6 text-[13px]">
							<div>
								<dt class="text-xs text-muted-foreground">Last synced</dt>
								<dd class="font-medium">{ m.LastSynced }</dd>
							</div>
							<div>
								<dt class="text-xs text-muted-foreground">Status</dt>
								if m.Failing {
									<dd class="font-medium text-destructive">Failing</dd>
								} else {
									<dd class="font-medium text-success">Up to date</dd>
								}
							</div>
							<div>
								<dt class="text-xs text-muted-foreground">Next sync</dt>
								<dd class="font-medium">{ m.NextSync }</dd>
							</div>
						</dl>
						if m.SyncURL != "" {
							@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{"type": "button", "hx-post": m.SyncURL, "hx-swap": "none"}) {
								Sync now
							}
						}
					</div>
					if m.Failing {
						<p role="alert" class="rounded-md border border-destructive/30 bg-destructive/10 text-destructive text-xs p-3">{ m.LastError }</p>
					}
					<form hx-patch={ m.APIURL } hx-swap="none" hx-on::after:request="if(event.target===this&&!ctx.hx.retarget)this.querySelector('#mirror-form-error').textContent=''" data-toast="Mirror settings saved" class="space-y-5">
						<div id="mirror-form-error" class="empty:hidden"></div>
						<div class="space-y-1.5">
							<label for="mirror-url" class="block text-sm font-medium">Source URL</label>
							<input id="mirror-url" type="url" name="remote_url" value={ m.RemoteURL } required class="h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm font-mono shadow-xs focus:outline-hidden focus:ring-2 focus:ring-ring"/>
						</div>
						<div class="grid sm:grid-cols-2 gap-4">
							<div class="space-y-1.5">
								<label for="mirror-username" class="block text-sm font-medium">Username</label>
								<input id="mirror-username" type="text" name="auth_username" value={ m.AuthUsername } autocomplete="off" spellcheck="false" class="h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs focus:outline-hidden focus:ring-2 focus:ring-ring"/>
							</div>
							<div class="space-y-1.5">
								<label for="mirror-token" class="block text-sm font-medium">Access token</label>
								if m.HasToken {
									<input id="mirror-token" type="password" name="auth_token" autocomplete="new-password" placeholder="Stored · enter a new one to replace it" class="h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs focus:outline-hidden focus:ring-2 focus:ring-ring"/>
								} else {
									<input id="mirror-token" type="password" name="auth_token" autocomplete="new-password" placeholder="None stored" class="h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs focus:outline-hidden focus:ring-2 focus:ring-ring"/>
								}
							</div>
						</div>
						if m.HasToken {
							<label class="flex items-center gap-2 text-[13px] text-muted-foreground">
								<input type="checkbox" name="clear_token" value="1" class="h-4 w-4 accent-[hsl(var(--ring))]"/>
								Remove the stored token (the source is public)
							</label>
						}
						<div class="space-y-1.5">
							<label for="mirror-interval" class="block text-sm font-medium">Sync every</label>
							<select id="mirror-interval" name="interval" class="h-9 w-full max-w-xs rounded-md border border-input bg-transparent px-2.5 text-sm shadow-xs focus:outline-hidden focus:ring-2 focus:ring-ring">
								for _, opt := range m.Intervals {
									<option value={ opt.Value } selected?={ opt.Selected }>{ opt.Label }</option>
								}
							</select>
							<p class="text-xs text-muted-foreground">The token is stored encrypted and never shown again.</p>
						</div>
						<div class="flex justify-end">
							@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
								Save changes
							}
						</div>
					</form>
				</div>
			}
		}
		@components.Card(templ.Attributes{"class": "border-destructive/40"}) {
			@components.CardHeader() {
				<h2 class="text-base font-semibold tracking-tight text-destructive">Stop mirroring</h2>
				@components.CardDescription() {
					Turn this into a regular, writable repository. Its branches stay as they are now, and the stored token is deleted. A repository can't be turned back into a mirror.
				}
			}
			@components.CardContent() {
				<div class="flex justify-end">
					@components.Button(components.ButtonDestructive, components.ButtonSizeSM, templ.Attributes{
						"hx-delete":            m.APIURL,
						"hx-swap":              "none",
						"hx-confirm":           "The repository becomes writable and stops following its source. This can't be undone.",
						"data-confirm-title":   "Stop mirroring?",
						"data-confirm-label":   "Stop mirroring",
						"data-confirm-danger":  "true",
						"hx-on::after:request": stashToast("Mirroring stopped"),
						"type":                 "button",
					}) {
						Stop mirroring
					}
				</div>
			}
		}
	</section>
}
