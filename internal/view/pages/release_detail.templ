package pages

import (
	"strconv"
	"github.com/mkappworks/cloudzilla/internal/view"
	"github.com/mkappworks/cloudzilla/internal/view/layout"
)

templ ReleaseDetail(data view.ReleaseDetailData) {
	@layout.Base(data.BasePage, releaseDetailTitle(data)+" · "+data.Owner+"/"+data.RepoName) {
		<div class="space-y-6">
			<div>
				<nav class="text-sm text-gray-500 mb-2">
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="hover:underline">{ data.Owner }/{ data.RepoName }</a>
					<span class="mx-1">/</span>
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/releases") } class="hover:underline">Releases</a>
					<span class="mx-1">/</span>
					<span class="font-mono">{ data.Release.TagName }</span>
				</nav>
			</div>
			<div class="bg-white border border-gray-200 rounded-lg p-6">
				<div class="flex items-start justify-between gap-4 mb-4">
					<div>
						<div class="flex items-center gap-2 flex-wrap mb-1">
							<h1 class="text-2xl font-bold">
								if data.Release.Name != "" {
									{ data.Release.Name }
								} else {
									{ data.Release.TagName }
								}
							</h1>
							<code class="px-2 py-0.5 bg-blue-50 text-blue-700 border border-blue-200 rounded text-sm font-mono">{ data.Release.TagName }</code>
							if data.Release.IsPrerelease {
								<span class="px-2 py-0.5 bg-yellow-100 text-yellow-700 border border-yellow-300 rounded text-xs font-medium">Pre-release</span>
							}
							if data.Release.IsDraft {
								<span class="px-2 py-0.5 bg-gray-100 text-gray-600 border border-gray-300 rounded text-xs font-medium">Draft</span>
							}
						</div>
						<p class="text-sm text-gray-500">
							if data.Release.PublishedAt != nil {
								Published { data.Release.PublishedAt.Format("January 2, 2006") }
							} else {
								Not yet published
							}
						</p>
					</div>
					if data.CanWrite {
						<div class="flex items-center gap-2 shrink-0">
							<button hx-delete={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/releases/" + strconv.FormatInt(data.Release.ID, 10) } hx-confirm="Delete this release?" class="px-3 py-1.5 text-red-600 border border-red-300 rounded text-sm font-medium hover:bg-red-50 transition-colors">
								Delete
							</button>
						</div>
					}
				</div>
				if data.BodyHTML != "" {
					<div class="prose prose-sm max-w-none border-t border-gray-100 pt-4 mt-4">
						@templ.Raw(data.BodyHTML)
					</div>
				} else {
					<p class="text-gray-500 text-sm border-t border-gray-100 pt-4 mt-4 italic">No description provided.</p>
				}
			</div>
			if data.CanWrite {
				<div class="bg-white border border-gray-200 rounded-lg p-6">
					<h2 class="text-lg font-semibold mb-4">Edit Release</h2>
					<form hx-patch={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/releases/" + strconv.FormatInt(data.Release.ID, 10) } hx-target="body" class="space-y-4">
						<div class="grid grid-cols-2 gap-4">
							<div>
								<label class="block text-sm font-medium text-gray-700 mb-1">Tag Name <span class="text-red-500">*</span></label>
								<input type="text" name="tag_name" required value={ data.Release.TagName } class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
							</div>
							<div>
								<label class="block text-sm font-medium text-gray-700 mb-1">Release Title</label>
								<input type="text" name="name" value={ data.Release.Name } class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
							</div>
						</div>
						<div>
							<label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
							<textarea name="body" rows="8" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-500">{ data.Release.Body }</textarea>
						</div>
						<div class="flex items-center gap-6">
							<label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
								<input type="checkbox" name="is_prerelease" value="true" checked?={ data.Release.IsPrerelease } class="rounded"/>
								Pre-release
							</label>
							<label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
								<input type="checkbox" name="is_draft" value="true" checked?={ data.Release.IsDraft } class="rounded"/>
								Draft
							</label>
						</div>
						<div class="flex justify-end">
							<button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-md text-sm font-medium hover:bg-blue-700 transition-colors">
								Save Changes
							</button>
						</div>
					</form>
				</div>
			}
		</div>
	}
}

func releaseDetailTitle(data view.ReleaseDetailData) string {
	if data.Release.Name != "" {
		return data.Release.Name
	}
	return data.Release.TagName
}
