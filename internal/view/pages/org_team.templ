package pages

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/fragments"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ OrgTeam(data view.OrgTeamData) {
	@layout.Base(data.BasePage, data.Team.Name+" — "+data.Org.Name) {
		<div class="space-y-8">

			<section class="flex flex-wrap items-start justify-between gap-4">
				<div class="min-w-0">
					<p class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground mb-1 inline-flex items-center gap-2">
						<a href={ templ.SafeURL("/" + data.Org.Name) } class="hover:text-foreground">{ data.Org.Name }</a>
						<span class="opacity-40" aria-hidden="true">/</span>
						if data.CanManage {
							<a href={ templ.SafeURL("/orgs/" + data.Org.Name + "/settings#teams") } class="hover:text-foreground">Teams</a>
						} else {
							<span>Teams</span>
						}
					</p>
					<h1 class="text-2xl font-semibold tracking-tight">{ data.Team.Name }</h1>
					if data.Team.Description != "" {
						<p class="mt-1 text-[13px] text-muted-foreground max-w-2xl">{ data.Team.Description }</p>
					}
				</div>
			</section>

			<div class="grid grid-cols-12 gap-8">

				<aside class="col-span-12 lg:col-span-3" aria-label="Teams">
					<nav class="lg:sticky lg:top-4 flex flex-col gap-0.5 text-[13px]">
						<p class="font-mono text-[10px] uppercase tracking-wider text-muted-foreground mb-1 px-2.5">Teams</p>
						for _, t := range data.Teams {
							if t.Slug == data.Team.Slug {
								<a href={ templ.SafeURL("/orgs/" + data.Org.Name + "/teams/" + t.Slug) } class="px-2.5 py-1.5 rounded-md bg-accent text-foreground font-medium" aria-current="page">{ t.Name }</a>
							} else {
								<a href={ templ.SafeURL("/orgs/" + data.Org.Name + "/teams/" + t.Slug) } class="px-2.5 py-1.5 rounded-md text-muted-foreground hover:text-foreground hover:bg-accent">{ t.Name }</a>
							}
						}
					</nav>
				</aside>

				<div class="col-span-12 lg:col-span-9 flex flex-col gap-10">

					<section id="members" class="rounded-md border border-border bg-card p-6">
						<h2 class="text-base font-semibold tracking-tight mb-1">Members</h2>
						<p class="text-[12.5px] text-muted-foreground mb-4">
							{ strconv.Itoa(len(data.Members.Members)) }
							if len(data.Members.Members) == 1 {
								person
							} else {
								people
							}
							on this team. A team doesn't change anyone's access to repositories yet.
						</p>
						@fragments.TeamMembers(data.Members)
					</section>

					if data.CanManage {
						<section id="edit" class="rounded-md border border-border bg-card p-6">
							<h2 class="text-base font-semibold tracking-tight mb-1">Team details</h2>
							<p class="text-[12.5px] text-muted-foreground mb-6">Renaming changes the team's address.</p>
							<form hx-post={ "/api/orgs/" + data.Org.Name + "/teams/" + data.Team.Slug } hx-swap="none" class="space-y-5">
								<div id="team-edit-form-error" class="empty:hidden"></div>
								<div>
									<label class="block text-[12px] font-medium text-muted-foreground mb-1.5" for="team-name">Name</label>
									@components.Input(templ.Attributes{"id": "team-name", "type": "text", "name": "name", "value": data.Team.Name, "required": true, "maxlength": "64"})
								</div>
								<div>
									<label class="block text-[12px] font-medium text-muted-foreground mb-1.5" for="team-description">Description</label>
									<textarea id="team-description" name="description" rows="3" maxlength="500" class="flex min-h-[80px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-xs">{ data.Team.Description }</textarea>
								</div>
								<div class="flex items-center justify-end gap-2">
									@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
										Save changes
									}
								</div>
							</form>
						</section>

						<section id="delete" class="rounded-md border border-destructive/30 bg-card p-6">
							<h2 class="text-base font-semibold tracking-tight mb-1 text-destructive">Delete team</h2>
							<p class="text-[12.5px] text-muted-foreground mb-4">Its members stay in the organization.</p>
							<button
								type="button"
								hx-delete={ "/api/orgs/" + data.Org.Name + "/teams/" + data.Team.Slug }
								hx-swap="none"
								hx-confirm={ "Members of " + data.Team.Name + " stay in " + data.Org.Name + "." }
								data-confirm-title={ "Delete " + data.Team.Name + "?" }
								data-confirm-label="Delete team"
								data-confirm-danger="true"
								class="h-9 px-4 text-sm rounded-md border border-destructive/40 text-destructive hover:bg-destructive/10"
							>
								Delete team
							</button>
						</section>
					}
				</div>
			</div>
		</div>
	}
}
