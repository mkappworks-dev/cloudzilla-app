package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ TOTPVerify(data view.TOTPVerifyPageData) {
	@layout.Base(data.BasePage, "Two-factor authentication") {
		<div class="max-w-md mx-auto mt-12 rounded-md border border-border bg-card p-6">
			<div class="text-center mb-6">
				<span class="inline-grid place-items-center w-12 h-12 rounded-full border border-border bg-success/10">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="text-success" aria-hidden="true" focusable="false">
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
					</svg>
				</span>
				<p class="mt-4 font-mono text-[11px] text-muted-foreground uppercase tracking-wider">Verify identity</p>
				<h1 class="mt-1 text-xl font-semibold tracking-tight">Two-factor authentication</h1>
				<p class="mt-2 text-[13px] text-muted-foreground">Enter the 6-digit code from your authenticator app.</p>
			</div>

			if data.Error != "" {
				<div class="mb-4 p-3 rounded-md border border-destructive/40 bg-destructive/10 text-destructive text-sm" role="alert">
					{ data.Error }
				</div>
			}

			<form method="POST" action="/auth/2fa/verify" class="space-y-4">
				<div class="space-y-1.5">
					<label for="code" class="block text-sm font-medium">Authentication code</label>
					@components.Input(templ.Attributes{
						"type":         "text",
						"id":           "code",
						"name":         "code",
						"placeholder":  "000000",
						"maxlength":    "6",
						"inputmode":    "numeric",
						"autocomplete": "one-time-code",
						"autofocus":    "autofocus",
						"class":        "font-mono text-center text-2xl tracking-[0.4em] h-12",
					})
				</div>
				@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit", "class": "w-full"}) {
					Verify
				}
			</form>

			<details class="mt-5 border-t border-border pt-4 text-sm">
				<summary class="cursor-pointer text-muted-foreground hover:text-foreground font-medium">Use a backup code instead</summary>
				<form method="POST" action="/auth/2fa/verify" class="mt-3 space-y-3">
					<div class="space-y-1.5">
						<label for="backup_code" class="block text-sm font-medium text-foreground">Backup code</label>
						@components.Input(templ.Attributes{
							"type":        "text",
							"id":          "backup_code",
							"name":        "backup_code",
							"placeholder": "xxxxxxxx",
							"class":       "font-mono text-center",
						})
					</div>
					@components.Button(components.ButtonOutline, components.ButtonSizeDefault, templ.Attributes{"type": "submit", "class": "w-full"}) {
						Use backup code
					}
				</form>
			</details>

			<p class="mt-5 text-center text-[12px]">
				<a href="/login" class="text-muted-foreground hover:text-foreground hover:underline">← Back to sign in</a>
			</p>
		</div>
	}
}
