package pages

import (
	"github.com/mkappworks/cloudzilla/internal/view"
	"github.com/mkappworks/cloudzilla/internal/view/layout"
)

templ TOTPVerify(data view.TOTPVerifyPageData) {
	@layout.Base(data.BasePage, "Two-Factor Authentication") {
		<div class="max-w-md mx-auto mt-12">
			<div class="bg-white border border-gray-200 rounded-lg shadow-md p-8">
				<div class="text-center mb-6">
					<div class="inline-flex items-center justify-center w-16 h-16 bg-blue-100 rounded-full mb-4">
						<svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
						</svg>
					</div>
					<h1 class="text-2xl font-bold">Two-Factor Authentication</h1>
					<p class="text-gray-600 text-sm mt-2">Enter the 6-digit code from your authenticator app.</p>
				</div>
				if data.Error != "" {
					<div class="mb-4 p-3 bg-red-50 border border-red-200 rounded text-red-700 text-sm">
						{ data.Error }
					</div>
				}
				<form method="POST" action="/auth/2fa/verify" class="space-y-4">
					<div>
						<label for="code" class="block text-sm font-medium text-gray-700 mb-1">Authentication Code</label>
						<input type="text" id="code" name="code" placeholder="000000" maxlength="6" class="w-full px-3 py-2 border border-gray-300 rounded-md font-mono text-center text-2xl tracking-widest focus:outline-none focus:ring-2 focus:ring-blue-500" autocomplete="one-time-code" autofocus/>
					</div>
					<button type="submit" class="w-full px-4 py-2 bg-blue-600 text-white rounded-md font-medium hover:bg-blue-700 transition-colors">
						Verify
					</button>
				</form>
				<div class="mt-6 border-t border-gray-200 pt-4">
					<details class="text-sm text-gray-600">
						<summary class="cursor-pointer font-medium hover:text-gray-900">Use a backup code instead</summary>
						<form method="POST" action="/auth/2fa/verify" class="mt-4 space-y-3">
							<div>
								<label for="backup_code" class="block text-sm font-medium text-gray-700 mb-1">Backup Code</label>
								<input type="text" id="backup_code" name="backup_code" placeholder="xxxxxxxx" class="w-full px-3 py-2 border border-gray-300 rounded-md font-mono text-center focus:outline-none focus:ring-2 focus:ring-blue-500"/>
							</div>
							<button type="submit" class="w-full px-4 py-2 border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50 transition-colors">
								Use Backup Code
							</button>
						</form>
					</details>
				</div>
				<div class="mt-4 text-center">
					<a href="/login" class="text-sm text-blue-600 hover:underline">Back to login</a>
				</div>
			</div>
		</div>
	}
}
