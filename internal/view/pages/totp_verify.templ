package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ TOTPVerify(data view.TOTPVerifyPageData) {
	@layout.Base(data.BasePage, "Two-Factor Authentication") {
		<div class="max-w-md mx-auto mt-12">
			@components.Card(nil) {
				@components.CardContent() {
					<div class="text-center mb-6">
						<div class="inline-flex items-center justify-center w-16 h-16 bg-primary/10 rounded-full mb-4">
							<svg class="w-8 h-8 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
							</svg>
						</div>
						<h1 class="text-2xl font-semibold tracking-tight">Two-Factor Authentication</h1>
						<p class="text-muted-foreground text-sm mt-2">Enter the 6-digit code from your authenticator app.</p>
					</div>
					if data.Error != "" {
						<div class="mb-4 p-3 rounded-md border border-destructive/40 bg-destructive/10 text-destructive text-sm" role="alert">
							{ data.Error }
						</div>
					}
					<form method="POST" action="/auth/2fa/verify" class="space-y-4">
						<div class="space-y-1.5">
							<label for="code" class="block text-sm font-medium">Authentication Code</label>
							@components.Input(templ.Attributes{
								"type":         "text",
								"id":           "code",
								"name":         "code",
								"placeholder":  "000000",
								"maxlength":    "6",
								"autocomplete": "one-time-code",
								"autofocus":    "autofocus",
								"class":        "font-mono text-center text-2xl tracking-widest h-12",
							})
						</div>
						@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit", "class": "w-full"}) {
							Verify
						}
					</form>
					<div class="mt-6 border-t border-border pt-4">
						<details class="text-sm text-muted-foreground">
							<summary class="cursor-pointer font-medium hover:text-foreground">Use a backup code instead</summary>
							<form method="POST" action="/auth/2fa/verify" class="mt-4 space-y-3">
								<div class="space-y-1.5">
									<label for="backup_code" class="block text-sm font-medium text-foreground">Backup Code</label>
									@components.Input(templ.Attributes{
										"type":        "text",
										"id":          "backup_code",
										"name":        "backup_code",
										"placeholder": "xxxxxxxx",
										"class":       "font-mono text-center",
									})
								</div>
								@components.Button(components.ButtonOutline, components.ButtonSizeDefault, templ.Attributes{"type": "submit", "class": "w-full"}) {
									Use Backup Code
								}
							</form>
						</details>
					</div>
					<div class="mt-4 text-center">
						<a href="/login" class="text-sm text-foreground hover:underline">Back to login</a>
					</div>
				}
			}
		</div>
	}
}
