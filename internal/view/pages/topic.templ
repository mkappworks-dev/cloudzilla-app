package pages

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Topic(data view.TopicData) {
	@layout.Base(data.BasePage, "Topic: "+data.TopicName) {
		<div class="max-w-4xl mx-auto space-y-6">

			<section aria-labelledby="topic-title">
				<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">Cloudzilla · Topic</p>
				<h1 id="topic-title" class="text-3xl font-semibold tracking-tight inline-flex items-center gap-3">
					<span class="px-3 py-1 rounded-full text-base font-medium border border-primary/30 bg-primary/10 text-primary">{ data.TopicName }</span>
				</h1>
				<p class="mt-3 text-[14px] text-muted-foreground max-w-2xl">
					Repositories tagged with
					<span class="font-mono">{ data.TopicName }</span>. Topics are crowd-sourced labels maintained by repo owners.
				</p>
			</section>

			if len(data.Repos) > 0 {
				<section class="rounded-md border border-border bg-card overflow-hidden" aria-labelledby="repos">
					<h2 id="repos" class="sr-only">Repositories tagged with { data.TopicName }</h2>
					<ol class="divide-y divide-border">
						for _, repo := range data.Repos {
							<li class="px-4 py-4 hover:bg-muted/50">
								<a href={ templ.SafeURL("/" + repo.OwnerName + "/" + repo.Name) } class="text-[14px] font-medium hover:underline">{ repo.OwnerName }/{ repo.Name }</a>
								if repo.Description != "" {
									<p class="mt-1 text-[13px] text-muted-foreground">{ repo.Description }</p>
								}
								<p class="mt-2 font-mono text-[11px] text-muted-foreground">
									Updated <time datetime={ repo.UpdatedAt.UTC().Format(time.RFC3339) }>{ repo.UpdatedAt.Format("Jan 2, 2006") }</time>
								</p>
							</li>
						}
					</ol>
				</section>

				<nav class="flex items-center justify-between text-[12px]" aria-label="Pagination">
					if data.Page > 1 {
						@components.LinkButton("?page="+strconv.Itoa(data.Page-1), components.ButtonOutline, components.ButtonSizeSM, nil) {
							← Previous
						}
					} else {
						<span></span>
					}
					<span class="text-muted-foreground font-mono">page { strconv.Itoa(data.Page) }</span>
					@components.LinkButton("?page="+strconv.Itoa(data.Page+1), components.ButtonOutline, components.ButtonSizeSM, nil) {
						Next →
					}
				</nav>
			} else {
				@components.EmptyState("No public repositories for this topic yet.")
			}
		</div>
	}
}
