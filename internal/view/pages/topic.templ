package pages

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Topic(data view.TopicData) {
	@layout.Base(data.BasePage, "Topic: "+data.TopicName) {
		<div class="max-w-4xl mx-auto py-8 px-4">
			<div class="flex items-center gap-3 mb-6">
				<span class="px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-sm font-medium">{ data.TopicName }</span>
				<h1 class="text-2xl font-bold">Repositories</h1>
			</div>
			if len(data.Repos) > 0 {
				<ul class="space-y-4">
					for _, repo := range data.Repos {
						<li class="border border-gray-200 rounded p-4">
							<div class="flex items-center gap-2 mb-1">
								<a href={ templ.SafeURL("/" + repo.OwnerName + "/" + repo.Name) } class="text-blue-600 hover:underline font-medium">{ repo.OwnerName }/{ repo.Name }</a>
							</div>
							if repo.Description != "" {
								<p class="text-sm text-gray-600">{ repo.Description }</p>
							}
							<div class="text-xs text-gray-400 mt-1">Updated { repo.UpdatedAt.Format("Jan 2, 2006") }</div>
						</li>
					}
				</ul>
				<div class="mt-6 flex gap-2">
					if data.Page > 1 {
						<a href={ templ.SafeURL("?page=" + strconv.Itoa(data.Page-1)) } class="px-3 py-1 border rounded text-sm">Previous</a>
					}
					<a href={ templ.SafeURL("?page=" + strconv.Itoa(data.Page+1)) } class="px-3 py-1 border rounded text-sm">Next</a>
				</div>
			} else {
				<p class="text-gray-500">No public repositories for this topic yet.</p>
			}
		</div>
	}
}
