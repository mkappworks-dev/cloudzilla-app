package pages

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/model"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/timefmt"
)

templ SecurityAlert(data view.SecretAlertData) {
	@layout.Base(data.BasePage, "Alert #"+strconv.Itoa(data.Number)+" · Security · "+data.Owner+"/"+data.RepoName) {
		<div class="flex flex-col gap-6">
			<section aria-labelledby="alert-title">
				<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="hover:underline">{ data.RepoName }</a>
					<span aria-hidden="true">·</span>
					<a href={ templ.SafeURL(data.ListURL) } class="hover:underline">Security</a>
					<span aria-hidden="true">·</span>
					<span aria-current="page">#{ strconv.Itoa(data.Number) }</span>
				</p>
				<div class="flex flex-wrap items-start justify-between gap-3">
					<div class="flex flex-wrap items-center gap-2 min-w-0">
						<h1 id="alert-title" class="text-2xl font-semibold tracking-tight min-w-0">{ data.TypeLabel }</h1>
						if data.Closed {
							@components.Badge(components.BadgeSecondary) {
								Closed · { data.ResolutionLabel }
							}
						} else {
							@components.Badge(components.BadgeDestructive) {
								Open
							}
						}
						if data.AutoRevoked {
							@components.Badge(components.BadgeOutline) {
								Auto-revoked
							}
						}
						if data.Blocked && !data.Closed {
							@components.Badge(components.BadgeWarning) {
								Blocked push
							}
						}
						if data.Incomplete {
							@components.Badge(components.BadgeOutline) {
								Scan incomplete
							}
						}
					</div>
					<div class="flex items-center gap-1.5 shrink-0">
						if data.Closed {
							<form method="POST" action={ templ.SafeURL(data.ActionURL + "/reopen") }>
								@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{"type": "submit"}) {
									Reopen
								}
							</form>
						} else {
							<form method="POST" action={ templ.SafeURL(data.ActionURL + "/close") }>
								@components.DropdownMenu() {
									@components.DropdownMenuTrigger(templ.Attributes{
										"class": "inline-flex items-center justify-center gap-1.5 rounded-md font-medium transition-colors border border-input bg-transparent hover:bg-accent hover:text-accent-foreground h-8 px-3 text-[13px]",
									}) {
										Close as
										<svg class="text-muted-foreground" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M7 10l5 5 5-5"></path></svg>
									}
									@components.DropdownMenuContent(components.DropdownAlignEnd) {
										<div class="w-72">
											@securityCloseItem(model.SecretResolutionRevoked, "Revoked", "The secret was rotated and no longer works.")
											@securityCloseItem(model.SecretResolutionFalsePositive, "False positive", "It isn't a secret.")
											@securityCloseItem(model.SecretResolutionUsedInTests, "Used in tests", "A fixture or example value that grants nothing.")
										</div>
									}
								}
							</form>
						}
					</div>
				</div>
				<p class="mt-2 text-[13px] text-muted-foreground flex flex-wrap items-center gap-x-1.5 gap-y-1">
					if data.CommitShort != "" {
						<span>Found in <a href={ templ.SafeURL(data.CommitURL) } class="font-mono hover:text-foreground hover:underline">{ data.CommitShort }</a>{ securityPushedBy(data.Pusher, data.Ref) }</span>
						if data.Ref != "" {
							<span class="font-mono px-1.5 py-0.5 bg-muted border border-border rounded-sm text-[12px]">{ data.Ref }</span>
						}
						<span aria-hidden="true">·</span>
					}
					<time datetime={ data.DetectedAt.UTC().Format("2006-01-02T15:04:05Z") }>{ timefmt.Relative(data.DetectedAt) }</time>
				</p>
			</section>
			<div class="grid lg:grid-cols-[1fr_280px] gap-6 items-start">
				<div class="flex flex-col gap-6 min-w-0">
					if data.Blocked && !data.Closed {
						@components.Alert(components.AlertWarning) {
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
							@components.AlertTitle() {
								This secret blocked a push
								if data.BlockedBy != "" {
									by { data.BlockedBy }
								}
								<time>{ timefmt.Relative(data.BlockedAt) }</time>
							}
							@components.AlertDescription() {
								if data.CanAllow {
									<p>Only the first and last four characters were kept. Allow it only if it isn't a live secret: the alert closes with the reason you pick, the pusher can push again, and this value is no longer blocked in this repository unless the alert is reopened.</p>
									<form method="POST" action={ templ.SafeURL(data.ActionURL + "/allow") } class="mt-3 flex flex-wrap items-center gap-2">
										@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{"type": "submit", "name": "resolution", "value": model.SecretResolutionUsedInTests, "class": "text-foreground"}) {
											Allow as used in tests
										}
										@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{"type": "submit", "name": "resolution", "value": model.SecretResolutionFalsePositive, "class": "text-foreground"}) {
											Allow as false positive
										}
									</form>
								} else {
									<p>A Cloudzilla token can't be allowed: it is revoked as soon as it is found.</p>
								}
							}
						}
					}
					<section class="rounded-md border border-border bg-card overflow-hidden" aria-labelledby="loc-heading">
						<div class="bg-muted/40 border-b border-border px-4 py-2 flex items-center justify-between gap-3">
							<h2 id="loc-heading" class="min-w-0"><code class="text-sm font-mono text-foreground break-all">{ data.Snippet.Path }</code></h2>
							if !data.Snippet.Gone {
								<a href={ templ.SafeURL(data.Snippet.FileURL) } class="text-xs text-muted-foreground hover:text-foreground shrink-0">View file at { data.Snippet.CommitShort }</a>
							}
						</div>
						if data.Snippet.Gone {
							<p class="px-4 py-6 text-center text-[13px] text-muted-foreground">Commit no longer available. The alert and the masked hint remain.</p>
						} else {
							<div class="overflow-x-auto bg-card">
								<table class="w-full font-mono text-[12.5px] leading-[1.6]">
									<caption class="sr-only">{ data.Snippet.Path }, secret on the highlighted line</caption>
									<tbody>
										for _, line := range data.Snippet.Lines {
											@securitySnippetRow(line)
										}
									</tbody>
								</table>
							</div>
						}
					</section>
					if !data.Closed {
						<section class="rounded-md border border-border bg-card overflow-hidden" aria-labelledby="fix-heading">
							<header class="px-5 py-3 border-b border-border bg-muted/50 flex items-center gap-2">
								<h2 id="fix-heading" class="text-[13px] font-medium">How to fix</h2>
							</header>
							<ol class="px-5 py-4 flex flex-col gap-2 text-[13px] list-decimal list-inside">
								for _, step := range data.HowToFix {
									<li>{ step }</li>
								}
							</ol>
						</section>
					}
					<section aria-labelledby="activity-heading" class="flex flex-col gap-3">
						<h2 id="activity-heading" class="text-[13px] font-medium">Activity</h2>
						@components.Timeline("Alert activity") {
							for _, ev := range data.Events {
								@securityEvent(ev)
							}
						}
					</section>
				</div>
				<aside class="flex flex-col gap-6" aria-label="Alert details">
					<section aria-labelledby="al-type-heading">
						<h2 id="al-type-heading" class="text-[12px] font-medium text-muted-foreground mb-2">Secret</h2>
						<p><code class="font-mono px-2 py-0.5 border border-border bg-muted rounded-sm text-[12px] break-all">{ data.Hint }</code></p>
						<p class="mt-2 text-[12px] text-muted-foreground">Only the first and last four characters are stored. The snippet is read from the commit and masked.</p>
					</section>
					<section aria-labelledby="al-pattern-heading" class="border-t border-border pt-5">
						<h2 id="al-pattern-heading" class="text-[12px] font-medium text-muted-foreground mb-2">Pattern</h2>
						<p class="font-mono text-[12px]">{ data.TypeID }</p>
					</section>
					<section aria-labelledby="al-loc-heading" class="border-t border-border pt-5">
						<h2 id="al-loc-heading" class="text-[12px] font-medium text-muted-foreground mb-2">Locations</h2>
						<ul class="flex flex-col gap-1 text-[12px]">
							for _, loc := range data.Locations {
								<li class="font-mono break-all">{ loc.Text } <a href={ templ.SafeURL(loc.CommitURL) } class="text-muted-foreground hover:text-foreground hover:underline">· { loc.CommitShort }</a></li>
							}
						</ul>
					</section>
					<section aria-labelledby="al-commit-heading" class="border-t border-border pt-5">
						<h2 id="al-commit-heading" class="text-[12px] font-medium text-muted-foreground mb-2">Still on the default branch</h2>
						if data.OnDefaultBranch {
							<p class="text-[13px]">Yes, in <a href={ templ.SafeURL(data.DefaultCommitURL) } class="font-mono text-[12px] text-muted-foreground hover:text-foreground hover:underline">{ data.DefaultCommit }</a> on <span class="font-mono text-[12px]">{ data.DefaultBranch }</span></p>
						} else {
							<p class="text-[13px]">No</p>
						}
					</section>
				</aside>
			</div>
		</div>
	}
}

func securityPushedBy(pusher, ref string) string {
	out := ""
	if pusher != "" {
		out = ", pushed by " + pusher
	}
	if ref != "" {
		out += " to"
	}
	return out
}

templ securityCloseItem(resolution, label, hint string) {
	@components.DropdownMenuItem(templ.Attributes{"type": "submit", "name": "resolution", "value": resolution, "class": "items-start"}) {
		<span class="min-w-0"><span class="block font-medium">{ label }</span><span class="block text-[12px] text-muted-foreground">{ hint }</span></span>
	}
}

templ securitySnippetRow(line view.SecretSnippetViewLine) {
	if line.Secret {
		<tr class="bg-destructive/10">
			<td class="select-none text-destructive pr-4 pl-4 py-0 text-right w-12 align-top border-r border-border">{ strconv.Itoa(line.Number) }</td>
			<td class="pl-4 pr-4 py-0 whitespace-pre">{ line.Before }<mark class="bg-destructive/15 text-destructive rounded-xs px-0.5">{ line.Mask }</mark>{ line.After }</td>
		</tr>
	} else {
		<tr class="hover:bg-muted/50">
			<td class="select-none text-muted-foreground pr-4 pl-4 py-0 text-right w-12 align-top border-r border-border">{ strconv.Itoa(line.Number) }</td>
			<td class="pl-4 pr-4 py-0 whitespace-pre">{ line.Before }{ line.Mask }{ line.After }</td>
		</tr>
	}
}

templ securityEvent(ev view.SecretEventView) {
	@components.TimelineItem() {
		switch ev.Kind {
			case model.SecretEventFound:
				@components.TimelineIcon(components.TimelineDestructive) {
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg>
				}
				<p>
					Secret scanning found this
					if ev.CommitShort != "" {
						in <a href={ templ.SafeURL(ev.CommitURL) } class="font-mono hover:text-foreground hover:underline">{ ev.CommitShort }</a>
					}
					if ev.Detail == "history scan" {
						when it scanned existing history
					} else if ev.Actor != "" {
						in a push by <a href={ templ.SafeURL(ev.ActorURL) } class="font-medium text-foreground hover:text-primary">{ ev.Actor }</a>
						if ev.Ref != "" {
							to <span class="font-mono">{ ev.Ref }</span>
						}
					}
					<time class="text-xs">{ timefmt.Relative(ev.When) }</time>
				</p>
			case model.SecretEventBlocked:
				@components.TimelineIcon(components.TimelineWarning) {
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M4.93 4.93l14.14 14.14"></path></svg>
				}
				<p>
					Push protection rejected a push
					if ev.Actor != "" {
						by <a href={ templ.SafeURL(ev.ActorURL) } class="font-medium text-foreground hover:text-primary">{ ev.Actor }</a>
					}
					if ev.Ref != "" {
						to <span class="font-mono">{ ev.Ref }</span>
					}
					<time class="text-xs">{ timefmt.Relative(ev.When) }</time>
				</p>
			case model.SecretEventReopened:
				@components.TimelineIcon(components.TimelineDefault) {
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 12a9 9 0 0115-6.7L21 8"></path><path d="M21 3v5h-5"></path></svg>
				}
				<p>
					<a href={ templ.SafeURL(ev.ActorURL) } class="font-medium text-foreground hover:text-primary">{ ev.Actor }</a> reopened this
					<time class="text-xs">{ timefmt.Relative(ev.When) }</time>
				</p>
			case model.SecretEventAutoRevoked:
				@components.TimelineIcon(components.TimelineDefault) {
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>
				}
				<p>
					Cloudzilla deleted this token and closed the alert as revoked
					<time class="text-xs">{ timefmt.Relative(ev.When) }</time>
				</p>
			default:
				@components.TimelineIcon(components.TimelineDefault) {
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>
				}
				<p>
					<a href={ templ.SafeURL(ev.ActorURL) } class="font-medium text-foreground hover:text-primary">{ ev.Actor }</a>
					if ev.Kind == model.SecretEventAllowed {
						allowed this as
					} else {
						closed this as
					}
					{ ev.Detail }
					<time class="text-xs">{ timefmt.Relative(ev.When) }</time>
				</p>
		}
	}
}
