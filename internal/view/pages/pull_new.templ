package pages

import (
	"github.com/mkappworks/cloudzilla/internal/view"
	"github.com/mkappworks/cloudzilla/internal/view/components"
	"github.com/mkappworks/cloudzilla/internal/view/layout"
)

templ PullNew(data view.PullNewData) {
	@layout.Base(data.BasePage, "New Pull Request · "+data.Owner+"/"+data.RepoName) {
		<div class="max-w-2xl mx-auto space-y-6">
			<div>
				<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/pulls") } class="text-blue-600 hover:underline text-sm">&larr; Back to Pull Requests</a>
			</div>
			<h1 class="text-2xl font-bold">New Pull Request</h1>
			if data.Error != "" {
				<div class="px-4 py-3 bg-red-50 border border-red-300 rounded text-sm text-red-700">{ data.Error }</div>
			}
			if len(data.Branches) == 0 {
				@components.EmptyState("This repository has no branches yet. Push at least one commit to create a pull request.")
			} else {
				<form method="POST" action={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/pulls/new") } class="space-y-4 bg-white border border-gray-200 rounded-lg p-6">
					<div class="flex gap-3 items-end">
						<div class="flex-1">
							<label class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Head branch</label>
							<select name="head_branch" required class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
								for _, b := range data.Branches {
									<option value={ b.Name }>{ b.Name }</option>
								}
							</select>
						</div>
						<div class="text-gray-400 pb-2">&rarr;</div>
						<div class="flex-1">
							<label class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Base branch</label>
							<select name="base_branch" required class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
								for _, b := range data.Branches {
									<option value={ b.Name } selected?={ b.IsDefault }>{ b.Name }</option>
								}
							</select>
						</div>
					</div>
					<div>
						<label class="block text-sm font-medium text-gray-700 mb-1" for="title">Title</label>
						<input id="title" name="title" type="text" required autofocus placeholder="Summary of changes" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
					</div>
					<div>
						<label class="block text-sm font-medium text-gray-700 mb-1" for="body">Description</label>
						<textarea id="body" name="body" rows="12" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 resize-vertical font-mono">{ data.TemplateBody }</textarea>
					</div>
					<div class="flex items-center gap-3">
						<button type="submit" class="px-5 py-2 bg-green-600 text-white text-sm font-medium rounded hover:bg-green-700 transition-colors">
							Create pull request
						</button>
						<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/pulls") } class="text-sm text-gray-500 hover:underline">Cancel</a>
					</div>
				</form>
			}
		</div>
	}
}
