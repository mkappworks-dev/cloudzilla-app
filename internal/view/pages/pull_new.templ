package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ PullNew(data view.PullNewData) {
	@layout.Base(data.BasePage, "New Pull Request · "+data.Owner+"/"+data.RepoName) {
		<div class="max-w-2xl mx-auto space-y-6">
			<div>
				<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/pulls") } class="text-foreground hover:underline text-sm">&larr; Back to Pull Requests</a>
			</div>
			<h1 class="text-2xl font-semibold tracking-tight">New Pull Request</h1>
			if data.Error != "" {
				<div class="px-4 py-3 rounded-md border border-destructive/40 bg-destructive/10 text-destructive text-sm" role="alert">{ data.Error }</div>
			}
			if len(data.Branches) == 0 {
				@components.EmptyState("This repository has no branches yet. Push at least one commit to create a pull request.")
			} else {
				<form method="POST" action={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/pulls/new") } class="space-y-4 rounded-md border border-border bg-card p-6">
					<div class="flex gap-3 items-end">
						<div class="flex-1 space-y-1.5">
							<label for="head_branch" class="block text-xs font-medium text-muted-foreground uppercase tracking-wide">Head branch</label>
							<select id="head_branch" name="head_branch" required class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm">
								for _, b := range data.Branches {
									<option value={ b.Name }>{ b.Name }</option>
								}
							</select>
						</div>
						<div class="text-muted-foreground pb-2" aria-hidden="true">&rarr;</div>
						<div class="flex-1 space-y-1.5">
							<label for="base_branch" class="block text-xs font-medium text-muted-foreground uppercase tracking-wide">Base branch</label>
							<select id="base_branch" name="base_branch" required class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm">
								for _, b := range data.Branches {
									<option value={ b.Name } selected?={ b.IsDefault }>{ b.Name }</option>
								}
							</select>
						</div>
					</div>
					<div class="space-y-1.5">
						<label class="block text-sm font-medium" for="title">Title</label>
						@components.Input(templ.Attributes{
							"id":          "title",
							"name":        "title",
							"type":        "text",
							"required":    "required",
							"autofocus":   "autofocus",
							"placeholder": "Summary of changes",
						})
					</div>
					<div class="space-y-1.5">
						<label class="block text-sm font-medium" for="body">Description</label>
						<textarea id="body" name="body" rows="12" class="flex min-h-[80px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm placeholder:text-muted-foreground resize-vertical font-mono">{ data.TemplateBody }</textarea>
					</div>
					<div class="flex items-center gap-3">
						@components.Button(components.ButtonSuccess, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
							Create pull request
						}
						<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/pulls") } class="text-sm text-muted-foreground hover:underline">Cancel</a>
					</div>
				</form>
			}
		</div>
	}
}
