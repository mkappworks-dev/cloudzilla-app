package pages

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Pulls(data view.PullsData) {
	@layout.Base(data.BasePage, "Pull Requests · "+data.Owner+"/"+data.RepoName) {
		<div class="space-y-6">

			<section class="flex flex-wrap items-start justify-between gap-4" aria-labelledby="pulls-title">
				<div class="min-w-0">
					<h1 id="pulls-title" class="text-2xl font-semibold tracking-tight">Pull requests</h1>
				</div>
				@components.LinkButton("/"+data.Owner+"/"+data.RepoName+"/pulls/new", components.ButtonSuccess, components.ButtonSizeDefault, nil) {
					<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" focusable="false">
						<path d="M12 5v14M5 12h14"></path>
					</svg>
					New pull request
				}
			</section>

			<nav class="flex items-center gap-1 border-b border-border text-sm" aria-label="Pull request state">
				@components.TabLink("/"+data.Owner+"/"+data.RepoName+"/pulls?state=open", data.StateFilter == "open") {
					Open
					<span class="ml-0.5 font-mono text-[11px] text-muted-foreground" aria-label={ strconv.Itoa(data.OpenCount) + " open" }>{ strconv.Itoa(data.OpenCount) }</span>
				}
				@components.TabLink("/"+data.Owner+"/"+data.RepoName+"/pulls?state=draft", data.StateFilter == "draft") {
					Draft
					<span class="ml-0.5 font-mono text-[11px] text-muted-foreground" aria-label={ strconv.Itoa(data.DraftCount) + " draft" }>{ strconv.Itoa(data.DraftCount) }</span>
				}
				@components.TabLink("/"+data.Owner+"/"+data.RepoName+"/pulls?state=merged", data.StateFilter == "merged") {
					Merged
					<span class="ml-0.5 font-mono text-[11px] text-muted-foreground" aria-label={ strconv.Itoa(data.MergedCount) + " merged" }>{ strconv.Itoa(data.MergedCount) }</span>
				}
				@components.TabLink("/"+data.Owner+"/"+data.RepoName+"/pulls?state=closed", data.StateFilter == "closed") {
					Closed
					<span class="ml-0.5 font-mono text-[11px] text-muted-foreground" aria-label={ strconv.Itoa(data.ClosedCount) + " closed" }>{ strconv.Itoa(data.ClosedCount) }</span>
				}
			</nav>

			if len(data.Rows) > 0 {
				<section class="rounded-md border border-border bg-card overflow-hidden" aria-labelledby="pull-list">
					<h2 id="pull-list" class="sr-only">Pull requests</h2>
					<ul>
						for _, row := range data.Rows {
							@components.PRListRow(row)
						}
					</ul>
				</section>
			} else {
				@components.EmptyState("No " + data.StateFilter + " pull requests.")
			}

		</div>
	}
}
