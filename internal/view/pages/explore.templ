package pages

import (
	"fmt"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Explore(data view.ExploreData) {
	@layout.Base(data.BasePage, "Explore") {
		<div class="space-y-6">
			@components.Card(nil) {
				@components.CardContent() {
					<h1 class="text-2xl font-bold">Explore Repositories</h1>
					<p class="text-sm text-muted-foreground mt-1">Discover public repositories on this instance.</p>
				}
			}
			<!-- Tab bar -->
			@components.Tabs("Explore views") {
				@components.TabLink("/explore?tab=trending&period="+data.Period, data.Tab == "trending") {
					Trending
				}
				@components.TabLink("/explore?tab=newest", data.Tab == "newest") {
					Newest
				}
				@components.TabLink("/explore?tab=forked", data.Tab == "forked") {
					Most Forked
				}
			}
			if data.Tab == "trending" {
				<!-- Period pills (only shown for Trending tab) -->
				<div class="flex gap-2">
					<a href="/explore?tab=trending&period=daily" class={ "px-3 py-1 rounded-full text-xs font-medium border", templ.KV("bg-primary text-primary-foreground border-primary", data.Period == "daily"), templ.KV("bg-card text-muted-foreground border-border hover:border-foreground/40", data.Period != "daily") }>
						Today
					</a>
					<a href="/explore?tab=trending&period=weekly" class={ "px-3 py-1 rounded-full text-xs font-medium border", templ.KV("bg-primary text-primary-foreground border-primary", data.Period == "weekly"), templ.KV("bg-card text-muted-foreground border-border hover:border-foreground/40", data.Period != "weekly") }>
						This week
					</a>
					<a href="/explore?tab=trending&period=monthly" class={ "px-3 py-1 rounded-full text-xs font-medium border", templ.KV("bg-primary text-primary-foreground border-primary", data.Period == "monthly"), templ.KV("bg-card text-muted-foreground border-border hover:border-foreground/40", data.Period != "monthly") }>
						This month
					</a>
				</div>
			}
			if len(data.Repos) > 0 {
				<div class="rounded-md border border-border bg-card divide-y divide-border">
					for _, repo := range data.Repos {
						<div class="px-6 py-4">
							<div class="flex items-start justify-between gap-4">
								<div class="min-w-0">
									<a href={ templ.SafeURL("/" + repo.OwnerName + "/" + repo.Name) } class="text-foreground font-semibold hover:underline">{ repo.OwnerName }/{ repo.Name }</a>
									if repo.Description != "" {
										<p class="text-sm text-muted-foreground mt-0.5 truncate">{ repo.Description }</p>
									}
									<p class="text-xs text-muted-foreground mt-1">
										Created <time datetime={ repo.CreatedAt.UTC().Format(time.RFC3339) }>{ repo.CreatedAt.Format("Jan 2, 2006") }</time>
									</p>
								</div>
								<div class="shrink-0 flex items-center gap-3 text-xs text-muted-foreground">
									<span title="Stars"><span aria-hidden="true">&#9733;</span> { fmt.Sprintf("%d", repo.StarCount) }</span>
									<span title="Forks"><span aria-hidden="true">&#8921;</span> { fmt.Sprintf("%d", repo.ForkCount) }</span>
								</div>
							</div>
						</div>
					}
				</div>
			} else {
				@components.EmptyState("No public repositories to show yet.")
			}
		</div>
	}
}
