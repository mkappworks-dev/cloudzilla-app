package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ AccountRepos(data view.AccountReposData) {
	@layout.Base(data.BasePage, "Repositories") {
		<div class="space-y-5">
			<div class="min-w-0">
				<h1 id="repos-title" class="text-2xl font-semibold tracking-tight">Repositories</h1>
			</div>
			<nav aria-label="Repository filter" class="flex items-center gap-1 text-sm border-b border-border">
				@accountFilterTab("/repos", "all", "All", data.Filter)
				@accountFilterTab("/repos", "owned", "Owned", data.Filter)
				@accountFilterTab("/repos", "collaborator", "Collaborator", data.Filter)
			</nav>
			if len(data.Repos) > 0 {
				<ol class="rounded-md border border-border bg-card divide-y divide-border overflow-hidden">
					for _, repo := range data.Repos {
						<li>
							<a href={ templ.SafeURL("/" + repo.OwnerName + "/" + repo.Name) } class="block px-4 py-3 hover:bg-muted/50">
								<div class="text-[13px] font-medium">
									<span class="text-muted-foreground">{ repo.OwnerName }/</span><span class="hover:underline">{ repo.Name }</span>
									if repo.Private {
										<span class="ml-1.5 text-[11px] text-muted-foreground">Private</span>
									}
								</div>
								if repo.Description != "" {
									<div class="mt-1 text-[12px] text-muted-foreground">{ repo.Description }</div>
								}
							</a>
						</li>
					}
				</ol>
			} else {
				@components.EmptyState("No repositories.")
			}
		</div>
	}
}

// accountFilterTab renders one filter-bar link; `current` is the active value.
templ accountFilterTab(basePath, value, label, current string) {
	if value == current {
		<a href={ templ.SafeURL(basePath + "?filter=" + value) } aria-current="page" class="px-3 py-2 border-b-2 border-foreground text-foreground font-medium -mb-px">{ label }</a>
	} else {
		<a href={ templ.SafeURL(basePath + "?filter=" + value) } class="px-3 py-2 border-b-2 border-transparent text-muted-foreground hover:text-foreground -mb-px">{ label }</a>
	}
}
