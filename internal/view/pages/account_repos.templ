package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ AccountRepos(data view.AccountReposData) {
	@layout.Base(data.BasePage, "Repositories") {
		<div class="space-y-5">
			<div class="min-w-0">
				<h1 id="repos-title" class="text-2xl font-semibold tracking-tight">Repositories</h1>
			</div>
			@components.Tabs("Repository filter") {
				@components.TabLink("/repos?filter=all", data.Filter == "all") {
					All
				}
				@components.TabLink("/repos?filter=owned", data.Filter == "owned") {
					Owned
				}
				@components.TabLink("/repos?filter=collaborator", data.Filter == "collaborator") {
					Collaborator
				}
			}
			if len(data.Repos) > 0 {
				<ol class="rounded-md border border-border bg-card divide-y divide-border overflow-hidden">
					for _, repo := range data.Repos {
						<li>
							<a href={ templ.SafeURL("/" + repo.OwnerName + "/" + repo.Name) } class="block px-4 py-3 hover:bg-muted/50">
								<div class="text-[13px] font-medium">
									<span class="text-muted-foreground">{ repo.OwnerName }/</span><span class="hover:underline">{ repo.Name }</span>
									if repo.Private {
										<span class="ml-1.5 text-[11px] text-muted-foreground">Private</span>
									}
								</div>
								if repo.Description != "" {
									<div class="mt-1 text-[12px] text-muted-foreground">{ repo.Description }</div>
								}
							</a>
						</li>
					}
				</ol>
			} else {
				@components.EmptyState("No repositories.")
			}
		</div>
	}
}
