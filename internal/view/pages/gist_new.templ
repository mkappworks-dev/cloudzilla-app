package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ GistNew(data view.GistNewData) {
	@layout.Base(data.BasePage, "New Gist") {
		<div class="max-w-4xl mx-auto space-y-6">

			<section aria-labelledby="new-title">
				<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">
					<a href="/gists" class="hover:underline">Gists</a>
					<span aria-hidden="true">·</span>
					New
				</p>
				<h1 id="new-title" class="text-2xl font-semibold tracking-tight">Create a new gist</h1>
				<p class="mt-1 text-[13px] text-muted-foreground">Add one or more files. Public gists are listed on the Explore page; secret gists are only reachable by direct link.</p>
			</section>

			<form id="gist-form" class="space-y-5 rounded-md border border-border bg-card p-6">
				<div class="space-y-1.5">
					<label for="gist-description" class="block text-sm font-medium">
						Description <span class="text-muted-foreground font-normal">(optional)</span>
					</label>
					@components.Input(templ.Attributes{
						"id":          "gist-description",
						"type":        "text",
						"name":        "description",
						"placeholder": "Short summary of what this gist contains",
					})
				</div>

				<label class="flex items-center gap-2 text-sm cursor-pointer">
					@components.Checkbox(templ.Attributes{"id": "public", "name": "public", "checked": "checked"})
					<span>Public gist <span class="text-muted-foreground">(listed in Explore)</span></span>
				</label>

				<div id="file-rows" class="space-y-4">
					<div class="rounded-md border border-border bg-muted/30 p-4 space-y-2">
						<label for="gist-filename-0" class="sr-only">Filename</label>
						@components.Input(templ.Attributes{
							"id":          "gist-filename-0",
							"type":        "text",
							"name":        "filename[]",
							"placeholder": "filename.ext",
							"required":    "required",
							"class":       "font-mono",
						})
						<label for="gist-content-0" class="sr-only">File contents</label>
						<textarea id="gist-content-0" name="content[]" rows="10" class="flex min-h-[160px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm font-mono shadow-sm placeholder:text-muted-foreground resize-vertical" placeholder="File contents…"></textarea>
					</div>
				</div>

				@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{
					"type":      "button",
					"hx-get":    "/api/gists/file-row",
					"hx-target": "#file-rows",
					"hx-swap":   "beforeend",
				}) {
					+ Add file
				}

				<div class="flex items-center gap-3 pt-2">
					@components.Button(components.ButtonSuccess, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
						Create gist
					}
					@components.LinkButton("/gists", components.ButtonGhost, components.ButtonSizeDefault, nil) {
						Cancel
					}
				</div>
			</form>

			<script>
				document.getElementById('gist-form').addEventListener('submit', async function(e) {
					e.preventDefault();
					const desc = this.querySelector('[name=description]').value;
					const pub = this.querySelector('[name=public]').checked;
					const filenames = [...this.querySelectorAll('[name="filename[]"]')].map(el => el.value);
					const contents = [...this.querySelectorAll('[name="content[]"]')].map(el => el.value);
					const files = filenames.map((fn, i) => ({ filename: fn, content: contents[i] }));
					const csrf = (document.cookie.match(/csrf_token=([^;]+)/) || [])[1] || '';
					const res = await fetch('/api/gists', {
						method: 'POST',
						headers: {'Content-Type': 'application/json', 'X-CSRF-Token': csrf},
						body: JSON.stringify({ description: desc, public: pub, files })
					});
					if (res.ok) {
						const g = await res.json();
						window.location.href = '/gists/' + g.id;
					} else {
						const text = await res.text();
						let msg = text;
						try { msg = JSON.parse(text).error || text; } catch (_) {}
						alert(msg || ('Failed to create gist (HTTP ' + res.status + ')'));
					}
				});
			</script>
		</div>
	}
}
