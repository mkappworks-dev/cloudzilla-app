package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ GistNew(data view.GistNewData) {
	@layout.Base(data.BasePage, "New Gist") {
		<div class="max-w-4xl mx-auto py-8 px-4">
			<h1 class="text-2xl font-bold mb-6">Create a New Gist</h1>
			<form id="gist-form">
				<div class="mb-4">
					<label for="gist-description" class="block text-sm font-medium text-foreground mb-1">Description <span class="text-muted-foreground">(optional)</span></label>
					@components.Input(templ.Attributes{
						"id":          "gist-description",
						"type":        "text",
						"name":        "description",
						"placeholder": "Gist description...",
					})
				</div>
				<div class="mb-4 flex items-center gap-2">
					<input type="checkbox" id="public" name="public" checked/>
					<label for="public" class="text-sm text-foreground">Public gist</label>
				</div>
				<div id="file-rows" class="space-y-4">
					<div class="rounded-md border border-border bg-card p-4">
						<label for="gist-filename-0" class="sr-only">Filename</label>
						<input id="gist-filename-0" type="text" name="filename[]" placeholder="Filename including extension" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors placeholder:text-muted-foreground mb-2" required/>
						<label for="gist-content-0" class="sr-only">File contents</label>
						<textarea id="gist-content-0" name="content[]" rows="8" class="flex min-h-[80px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm placeholder:text-muted-foreground font-mono" placeholder="File contents..."></textarea>
					</div>
				</div>
				<div class="mt-3">
					@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{
						"type":       "button",
						"hx-get":     "/api/gists/file-row",
						"hx-target":  "#file-rows",
						"hx-swap":    "beforeend",
					}) {
						Add file
					}
				</div>
				<div class="mt-6 flex gap-3">
					@components.Button(components.ButtonSuccess, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
						Create Gist
					}
					@components.LinkButton("/gists", components.ButtonOutline, components.ButtonSizeDefault, nil) {
						Cancel
					}
				</div>
			</form>
			<script>
				document.getElementById('gist-form').addEventListener('submit', async function(e) {
					e.preventDefault();
					const desc = this.querySelector('[name=description]').value;
					const pub = this.querySelector('[name=public]').checked;
					const filenames = [...this.querySelectorAll('[name="filename[]"]')].map(el => el.value);
					const contents = [...this.querySelectorAll('[name="content[]"]')].map(el => el.value);
					const files = filenames.map((fn, i) => ({ filename: fn, content: contents[i] }));
					const csrf = (document.cookie.match(/csrf_token=([^;]+)/) || [])[1] || '';
					const res = await fetch('/api/gists', {
						method: 'POST',
						headers: {'Content-Type': 'application/json', 'X-CSRF-Token': csrf},
						body: JSON.stringify({ description: desc, public: pub, files })
					});
					if (res.ok) {
						const g = await res.json();
						window.location.href = '/gists/' + g.id;
					} else {
						const text = await res.text();
						let msg = text;
						try { msg = JSON.parse(text).error || text; } catch (_) {}
						alert(msg || ('Failed to create gist (HTTP ' + res.status + ')'));
					}
				});
			</script>
		</div>
	}
}
