package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Forbidden(base view.BasePage) {
	@layout.Base(base, "Access denied") {
		<div class="max-w-md mx-auto mt-24 text-center">
			<p class="text-7xl font-bold text-muted-foreground/40">403</p>
			<h1 class="mt-4 text-2xl font-semibold tracking-tight text-foreground">Access denied</h1>
			<p class="mt-2 text-sm text-muted-foreground">You don't have permission to view this page.</p>
			<div class="mt-6">
				@components.LinkButton("/", components.ButtonDefault, components.ButtonSizeDefault, nil) {
					Go home
				}
			</div>
		</div>
	}
}
