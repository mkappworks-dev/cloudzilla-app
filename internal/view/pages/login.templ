package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Login(data view.LoginData) {
	@layout.Base(data.BasePage, "Sign In") {
		<div class="max-w-md mx-auto mt-12">
			@components.Card(nil) {
				@components.CardContent() {
					<h1 class="text-2xl font-semibold tracking-tight mb-6">Sign In to Cloudzilla</h1>
					if data.Error != "" {
						<div class="mb-4 p-3 rounded-md border border-destructive/40 bg-destructive/10 text-destructive text-sm" role="alert">
							{ data.Error }
						</div>
					}
					<form method="POST" action="/login" class="space-y-4">
						<div class="space-y-1.5">
							<label for="email" class="block text-sm font-medium">Email</label>
							@components.Input(templ.Attributes{
								"type":     "email",
								"id":       "email",
								"name":     "email",
								"required": "required",
							})
						</div>
						<div class="space-y-1.5">
							<label for="password" class="block text-sm font-medium">Password</label>
							@components.Input(templ.Attributes{
								"type":     "password",
								"id":       "password",
								"name":     "password",
								"required": "required",
							})
						</div>
						@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit", "class": "w-full"}) {
							Sign In
						}
					</form>
					if data.AllowRegistration {
						<p class="mt-4 text-center text-sm text-muted-foreground">
							Don't have an account?
							<a href="/register" class="text-foreground hover:underline">Create one</a>
						</p>
					}
					<div class="mt-6">
						<div class="relative">
							<div class="absolute inset-0 flex items-center" aria-hidden="true">
								<div class="w-full border-t border-border"></div>
							</div>
							<div class="relative flex justify-center text-sm">
								<span class="bg-card px-3 text-muted-foreground">or</span>
							</div>
						</div>
						<div class="mt-4">
							@components.LinkButton("/auth/google", components.ButtonOutline, components.ButtonSizeDefault, templ.Attributes{"class": "w-full gap-3"}) {
								<svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
									<path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"></path>
									<path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"></path>
									<path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"></path>
									<path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"></path>
								</svg>
								Sign in with Google
							}
						</div>
					</div>
					if data.LDAPEnabled || data.SAMLEnabled {
						<div class="mt-6">
							<div class="relative">
								<div class="absolute inset-0 flex items-center" aria-hidden="true">
									<div class="w-full border-t border-border"></div>
								</div>
								<div class="relative flex justify-center text-sm">
									<span class="bg-card px-3 text-muted-foreground">SSO</span>
								</div>
							</div>
							<div class="mt-4 space-y-3">
								if data.SAMLEnabled {
									@components.LinkButton("/auth/saml", components.ButtonOutline, components.ButtonSizeDefault, templ.Attributes{"class": "w-full gap-3"}) {
										Sign in with SAML SSO
									}
								}
								if data.LDAPEnabled {
									<details class="border border-border rounded-md">
										<summary class="px-4 py-2 text-sm font-medium cursor-pointer hover:bg-muted transition-colors">
											Sign in with LDAP
										</summary>
										<div class="p-4 border-t border-border">
											<form method="POST" action="/auth/ldap" class="space-y-3">
												<div class="space-y-1.5">
													<label for="ldap-username" class="block text-xs font-medium">Username</label>
													@components.Input(templ.Attributes{
														"type":     "text",
														"id":       "ldap-username",
														"name":     "username",
														"required": "required",
													})
												</div>
												<div class="space-y-1.5">
													<label for="ldap-password" class="block text-xs font-medium">Password</label>
													@components.Input(templ.Attributes{
														"type":     "password",
														"id":       "ldap-password",
														"name":     "password",
														"required": "required",
													})
												</div>
												@components.Button(components.ButtonSecondary, components.ButtonSizeDefault, templ.Attributes{"type": "submit", "class": "w-full"}) {
													Sign in with LDAP
												}
											</form>
										</div>
									</details>
								}
							</div>
						</div>
					}
				}
			}
		</div>
	}
}
