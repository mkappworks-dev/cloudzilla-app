package pages

import (
	"net/url"
	"strconv"
	"strings"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/model"
	"github.com/mkappworks-dev/cloudzilla-app/internal/service"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/fragments"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Repo(data view.RepoData) {
	@layout.Base(data.BasePage, data.Owner+"/"+data.RepoName) {
		@fragments.RepoSubnav(fragments.RepoSubnavData{
			OwnerName: data.Owner,
			RepoName:  data.RepoName,
			Active:    "code",
			CanManage: data.CanManage,
		})
		<div class="space-y-6 pt-6">

			if data.IsArchived {
				<div role="status" class="flex items-center gap-2 rounded-md border border-warning/40 bg-warning/10 px-4 py-3 text-sm">
					<svg class="h-4 w-4 flex-shrink-0 text-warning" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
						<path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path>
					</svg>
					<span class="text-warning">This repository has been archived and is read-only.</span>
				</div>
			}

			<!-- Repo header -->
			<section class="flex flex-wrap items-start justify-between gap-4 pb-6 border-b border-border" aria-labelledby="repo-title">
				<div class="min-w-0">
					<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">Repository · Overview</p>
					<h1 id="repo-title" class="text-xl tracking-tight font-medium mb-1.5 flex items-center gap-2.5 flex-wrap">
						<a href={ templ.SafeURL("/" + data.Owner) } class="text-muted-foreground hover:underline">{ data.Owner }</a>
						<span class="text-muted-foreground" aria-hidden="true">/</span>
						<span class="font-semibold">{ data.RepoName }</span>
						if data.Repo.Private {
							@components.Badge(components.BadgeOutline) {
								Private
							}
						} else {
							@components.Badge(components.BadgeOutline) {
								Public
							}
						}
						if data.IsArchived {
							@components.Badge(components.BadgeDraft) {
								Archived
							}
						}
					</h1>

					if data.IsFork {
						<p class="text-xs text-muted-foreground mt-2">
							Forked from
							<a href={ templ.SafeURL("/" + data.ForkOfPath) } class="hover:underline text-foreground font-mono">{ data.ForkOfPath }</a>
						</p>
					}
				</div>

				<!-- Action group: Watch / Star / Fork (each: button + count) -->
				<div class="flex items-center gap-1.5 flex-shrink-0" role="group" aria-label="Repository actions">
					<!-- Watch — HTMX loads stateful version -->
					<div
						id="watch-button"
						hx-get={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/watch" }
						hx-trigger="load"
						hx-swap="outerHTML"
						class="flex border border-border rounded-md overflow-hidden"
					>
						<span class="h-8 px-3 text-[13px] inline-flex items-center gap-1.5 text-muted-foreground">
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
							Watch
						</span>
						<span class="h-8 inline-flex items-center px-3 text-[13px] font-mono border-l border-border text-muted-foreground">…</span>
					</div>

					<!-- Star -->
					<div id="star-button" class="flex border border-border rounded-md overflow-hidden">
						if data.BasePage.CurrentUser != nil {
							if data.IsStarred {
								<button hx-delete={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/star" } hx-target="#star-button" hx-swap="outerHTML" type="button" aria-pressed="true" class="h-8 px-3 text-[13px] inline-flex items-center gap-1.5 bg-warning/10 text-warning hover:bg-warning/15">
									<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
									Starred
								</button>
							} else {
								<button hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/star" } hx-target="#star-button" hx-swap="outerHTML" type="button" aria-pressed="false" class="h-8 px-3 text-[13px] inline-flex items-center gap-1.5 hover:bg-accent">
									<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
									Star
								</button>
							}
						} else {
							<a href="/login" class="h-8 px-3 text-[13px] inline-flex items-center gap-1.5 hover:bg-accent">
								<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
								Star
							</a>
						}
						<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/stargazers") } class="h-8 inline-flex items-center px-3 text-[13px] font-mono border-l border-border hover:bg-accent" aria-label={ "View " + strconv.Itoa(data.StarCount) + " stargazers" }>{ strconv.Itoa(data.StarCount) }</a>
					</div>

					<!-- Fork -->
					<div id="fork-button" class="flex border border-border rounded-md overflow-hidden">
						if data.BasePage.CurrentUser != nil {
							<button hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/fork" } hx-target="#fork-button" hx-swap="outerHTML" type="button" class="h-8 px-3 text-[13px] inline-flex items-center gap-1.5 hover:bg-accent">
								<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><circle cx="6" cy="3" r="3"></circle><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="21" r="3"></circle><path d="M6 6v9a6 6 0 006 6v0M9 6h6a3 3 0 003-3"></path></svg>
								Fork
							</button>
						} else {
							<a href="/login" class="h-8 px-3 text-[13px] inline-flex items-center gap-1.5 hover:bg-accent">
								<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><circle cx="6" cy="3" r="3"></circle><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="21" r="3"></circle><path d="M6 6v9a6 6 0 006 6v0M9 6h6a3 3 0 003-3"></path></svg>
								Fork
							</a>
						}
						<span class="h-8 inline-flex items-center px-3 text-[13px] font-mono border-l border-border text-muted-foreground">{ strconv.Itoa(data.ForkCount) }</span>
					</div>
				</div>
			</section>

			<!-- Two-column layout: code/README on left, About sidebar on right -->
			<div class="grid lg:grid-cols-[1fr_320px] gap-8">

				<!-- LEFT — Code / README / Explore -->
				<div class="space-y-6 min-w-0">
					if len(data.Entries) > 0 {
						<section class="rounded-md border border-border bg-card overflow-hidden" aria-labelledby="files-heading">
							<h2 id="files-heading" class="sr-only">Files at { data.Repo.DefaultBranch }</h2>
							if data.LatestCommit.SHA != "" {
								<div class="px-4 py-2 border-b border-border flex items-center gap-3 text-[12px] bg-muted/40">
									<a href={ templ.SafeURL(data.LatestCommit.AuthorURL) } class="font-medium hover:underline truncate">{ data.LatestCommit.Author }</a>
									<a href={ templ.SafeURL(data.LatestCommit.CommitURL) } class="text-muted-foreground hover:underline truncate flex-1 min-w-0">{ data.LatestCommit.Message }</a>
									<a href={ templ.SafeURL(data.LatestCommit.CommitURL) } class="font-mono text-muted-foreground hover:underline flex-shrink-0">{ data.LatestCommit.SHA }</a>
									<span class="text-muted-foreground flex-shrink-0">
										<time datetime={ data.LatestCommit.Timestamp.Format(time.RFC3339) }>{ data.LatestCommit.Timestamp.Format(time.RFC822) }</time>
									</span>
								</div>
							}
							<table class="w-full text-left">
								<caption class="sr-only">Repository files at { data.Repo.DefaultBranch }, directories first</caption>
								<colgroup>
									<col style="width:28px"/>
									<col/>
									<col style="width:50%"/>
								</colgroup>
								<thead class="sr-only">
									<tr>
										<th scope="col">Type</th>
										<th scope="col">Name</th>
										<th scope="col">Last commit</th>
									</tr>
								</thead>
								<tbody>
									for _, entry := range data.Entries {
										<tr class="border-b border-border hover:bg-muted/30">
											<td class="px-4 py-2 w-8">
												if entry.IsDir {
													<svg style="color:#6ea8fe" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"></path></svg>
												} else {
													<svg class="text-muted-foreground" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
												}
											</td>
											<th scope="row" class="px-4 py-2 font-normal">
												if entry.IsDir {
													<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/tree/" + data.Repo.DefaultBranch + "/" + entry.Path) } class="text-[13px] hover:underline">{ entry.Name }</a>
												} else {
													<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/blob/" + data.Repo.DefaultBranch + "/" + entry.Path) } class="text-[13px] hover:underline">{ entry.Name }</a>
												}
											</th>
											<td class="px-4 py-2 text-[12px] text-muted-foreground">
												<div class="flex items-center justify-between gap-3">
													<span class="truncate">{ entry.LastCommit.Message }</span>
													if !entry.LastCommit.Timestamp.IsZero() {
														<time datetime={ entry.LastCommit.Timestamp.Format(time.RFC3339) } class="flex-shrink-0 font-mono">{ entry.LastCommit.Timestamp.Format("02 Jan") }</time>
													}
												</div>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</section>
					}

					<!-- Clone row -->
					<div class="flex flex-wrap items-center gap-3 text-[12px] text-muted-foreground">
						<span class="font-medium text-foreground text-[13px]">Clone:</span>
						<code class="font-mono bg-muted border border-border rounded px-2 py-1 text-[11px] truncate max-w-[260px]" title={ data.CloneHTTP }>{ data.CloneHTTP }</code>
						<code class="font-mono bg-muted border border-border rounded px-2 py-1 text-[11px] truncate max-w-[260px]" title={ data.CloneSSH }>{ data.CloneSSH }</code>
					</div>

					<!-- README -->
					if data.ReadmeHTML != "" {
						<article class="rounded-md border border-border bg-card overflow-hidden" aria-labelledby="readme-heading">
							<header class="px-5 py-3 border-b border-border bg-muted flex items-center gap-2">
								<svg class="text-muted-foreground" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
								<h2 id="readme-heading" class="text-[13px] font-medium">README</h2>
							</header>
							<div class="prose prose-sm max-w-none dark:prose-invert px-7 py-6">
								@templ.Raw(data.ReadmeHTML)
							</div>
						</article>
					}
				</div>

				<!-- RIGHT — About sidebar -->
				<aside class="space-y-8 min-w-0" aria-label="About this repository">
					<!-- About / description / topics -->
					<section aria-labelledby="about-heading">
						<h2 id="about-heading" class="text-[13px] font-medium mb-3">About</h2>
						if data.Repo.Description != "" {
							<p class="text-[13px] text-muted-foreground mb-4 leading-relaxed">{ data.Repo.Description }</p>
						} else {
							<p class="text-[13px] text-muted-foreground/70 italic mb-4">No description provided.</p>
						}

						<!-- Topics: SSR initial render, HTMX swaps in fresh list -->
						<div
							id="repo-topics"
							hx-get={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/topics" }
							hx-trigger="load"
							hx-swap="outerHTML"
							class="flex flex-wrap gap-1.5"
							aria-label="Topics"
						>
							for _, t := range data.Topics {
								<a href={ templ.SafeURL("/topic/" + t.Name) } class="text-[11px] px-2 py-0.5 rounded-full border border-border text-muted-foreground hover:border-foreground/30 hover:text-foreground">{ t.Name }</a>
							}
						</div>
					</section>

					<!-- Languages -->
					if len(data.Languages) > 0 {
						<section aria-labelledby="lang-heading">
							<h2 id="lang-heading" class="text-[13px] font-medium mb-3">Languages</h2>
							@components.LanguagesBar(data.Languages)
						</section>
					}

					<!-- Releases -->
					if len(data.Releases) > 0 {
						<section aria-labelledby="releases-heading">
							<h2 id="releases-heading" class="text-[13px] font-medium mb-3 flex items-center justify-between">
								<span>
									Releases
									<span class="font-mono text-muted-foreground/70 ml-0.5 text-[11px]" aria-label={ strconv.Itoa(len(data.Releases)) + " releases" }>{ strconv.Itoa(len(data.Releases)) }</span>
								</span>
								<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/releases") } class="text-[12px] text-muted-foreground hover:text-foreground">All</a>
							</h2>
							<ul class="space-y-3">
								for i, rel := range data.Releases {
									<li>
										<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/releases/tag/" + rel.TagName) } class="block group">
											<p class="text-[13px] font-medium flex items-center gap-2">
												<span class="truncate">
													if rel.Name != "" {
														{ rel.Name }
													} else {
														{ rel.TagName }
													}
												</span>
												if i == 0 && !rel.IsDraft && !rel.IsPrerelease {
													<span class="text-[10px] px-1.5 py-0.5 rounded border border-success/30 bg-success/10 text-success font-mono">Latest</span>
												}
												if rel.IsPrerelease {
													<span class="text-[10px] px-1.5 py-0.5 rounded border border-warning/30 bg-warning/10 text-warning font-mono">Pre-release</span>
												}
												if rel.IsDraft {
													<span class="text-[10px] px-1.5 py-0.5 rounded border border-border bg-muted text-muted-foreground font-mono">Draft</span>
												}
											</p>
											<p class="text-[12px] text-muted-foreground mt-0.5 font-mono">{ rel.TagName }</p>
											<p class="text-[11px] text-muted-foreground/80 mt-0.5">
												Released
												<time datetime={ releaseDisplayTime(rel).UTC().Format(time.RFC3339) }>{ formatRelative(releaseDisplayTime(rel)) }</time>
											</p>
										</a>
									</li>
								}
							</ul>
						</section>
					}

					<!-- Contributors -->
					if len(data.TopContribs) > 0 {
						<section aria-labelledby="contrib-heading">
							<h2 id="contrib-heading" class="text-[13px] font-medium mb-3 flex items-center justify-between">
								<span>
									Contributors
									<span class="font-mono text-muted-foreground/70 ml-0.5 text-[11px]" aria-label={ strconv.Itoa(len(data.TopContribs)) + " contributors" }>{ strconv.Itoa(len(data.TopContribs)) }</span>
								</span>
								<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/contributors") } class="text-[12px] text-muted-foreground hover:text-foreground">All</a>
							</h2>
							<ul class="flex flex-wrap gap-1.5">
								for _, c := range data.TopContribs {
									<li>
										<a
											href={ templ.SafeURL("/" + contributorSlug(c)) }
											class="bg-muted border border-border h-8 w-8 rounded-full grid place-items-center text-[11px] font-medium hover:border-border-strong"
											aria-label={ contributorAriaLabel(c) }
											title={ contributorTooltip(c) }
										>{ contributorInitial(c) }</a>
									</li>
								}
							</ul>
						</section>
					}

					<!-- Mini heatmap (90 days = 13 weeks) -->
					if len(data.Heatmap) > 0 {
						<section aria-labelledby="activity-heading">
							<h2 id="activity-heading" class="text-[13px] font-medium mb-3">Activity</h2>
							<div class="overflow-x-auto">
								@components.Heatmap(data.Heatmap, time.Now(), 13)
							</div>
							<p class="text-[11px] text-muted-foreground/80 mt-2">Past 90 days of commit activity</p>
						</section>
					}
				</aside>
			</div>
		</div>
	}
}

templ repoNavCard(href, title, caption string) {
	<a href={ templ.SafeURL(href) } class="block rounded-md border border-border bg-card p-4 hover:border-foreground/30 transition-colors group">
		<div class="flex items-center gap-2 text-muted-foreground group-hover:text-foreground mb-1">
			{ children... }
			<h3 class="text-sm font-medium text-foreground">{ title }</h3>
		</div>
		<p class="text-xs text-muted-foreground">{ caption }</p>
	</a>
}

func releaseDisplayTime(r model.Release) time.Time {
	if r.PublishedAt != nil {
		return *r.PublishedAt
	}
	return r.CreatedAt
}

// Falls back to email local-part, then "anonymous".
func contributorDisplayName(c service.ContributorStat) string {
	if name := strings.TrimSpace(c.Name); name != "" {
		return name
	}
	if email := strings.TrimSpace(c.Email); email != "" {
		if i := strings.IndexByte(email, '@'); i > 0 {
			return email[:i]
		}
		return email
	}
	return "anonymous"
}

func contributorInitial(c service.ContributorStat) string {
	name := contributorDisplayName(c)
	for _, r := range name {
		return strings.ToUpper(string(r))
	}
	return "?"
}

// URL-escaped so names containing spaces or "/" (from commit trailers) don't produce broken links.
func contributorSlug(c service.ContributorStat) string {
	return url.PathEscape(contributorDisplayName(c))
}

func contributorAriaLabel(c service.ContributorStat) string {
	return contributorDisplayName(c) + ", " + strconv.Itoa(c.Commits) + " commits"
}

func contributorTooltip(c service.ContributorStat) string {
	return contributorDisplayName(c) + " — " + strconv.Itoa(c.Commits) + " commits"
}
