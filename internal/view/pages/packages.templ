package pages

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/model"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/timefmt"
)

templ Packages(data view.PackagesData) {
	@layout.Base(data.BasePage, "Packages · "+data.Repo.OwnerName+"/"+data.Repo.Name) {
		<div class="flex flex-col gap-6">
			<section class="flex flex-wrap items-start justify-between gap-4" aria-labelledby="packages-title">
				<div class="min-w-0">
					<h1 id="packages-title" class="text-2xl font-semibold tracking-tight">Packages</h1>
					<p class="mt-1 text-[13px] text-muted-foreground">Container images and files published from this repository. They follow its visibility and access.</p>
				</div>
				if data.CanWrite && !data.Empty {
					<div class="relative" x-data="{ open: false, tab: 'container' }">
						<button type="button" x-on:click="open = !open" :aria-expanded="open ? 'true' : 'false'" aria-haspopup="dialog" class="inline-flex items-center justify-center gap-1.5 rounded-md font-medium transition-colors border border-input bg-transparent hover:bg-accent hover:text-accent-foreground h-9 px-4 text-sm">
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
							Publish
							<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M7 10l5 5 5-5"></path></svg>
						</button>
						<div x-show="open" x-cloak x-transition.opacity.duration.100ms x-on:click.outside="open = false" role="dialog" aria-label="Publish a package" class="absolute right-0 top-full mt-1.5 z-50 w-[420px] max-w-[calc(100vw-3rem)] rounded-md border border-border bg-popover text-popover-foreground shadow-md p-3">
							<div class="flex items-center gap-0.5 mb-2.5 p-0.5 bg-muted border border-border rounded-md" role="tablist" aria-label="Package type">
								<button type="button" role="tab" x-on:click="tab = 'container'" :aria-selected="tab === 'container'" :class="tab === 'container' ? 'bg-card text-foreground shadow-xs' : 'text-muted-foreground hover:text-foreground'" class="flex-1 px-2.5 py-1 rounded-sm text-[12px]">Container</button>
								<button type="button" role="tab" x-on:click="tab = 'generic'" :aria-selected="tab === 'generic'" :class="tab === 'generic' ? 'bg-card text-foreground shadow-xs' : 'text-muted-foreground hover:text-foreground'" class="flex-1 px-2.5 py-1 rounded-sm text-[12px]">Generic file</button>
							</div>
							<pre x-show="tab === 'container'" class="font-mono text-[11px] text-muted-foreground p-2 rounded-sm border border-border bg-muted overflow-x-auto whitespace-pre">{ packageDockerHowTo(data) }</pre>
							<pre x-show="tab === 'generic'" x-cloak class="font-mono text-[11px] text-muted-foreground p-2 rounded-sm border border-border bg-muted overflow-x-auto whitespace-pre">{ packageCurlHowTo(data) }</pre>
							<p class="text-[11px] text-muted-foreground mt-2">
								Sign in with a personal access token that has <span class="font-mono">packages:write</span> as the password.
								<a href="/settings/tokens" class="text-foreground hover:underline">Create a token</a>
							</p>
						</div>
					</div>
				}
			</section>
			if data.Empty {
				<section class="bg-background border border-border rounded-lg p-8">
					<p class="text-center text-muted-foreground">No packages published yet.</p>
					<p class="mt-2 text-center text-sm text-muted-foreground">Push a container image or upload a file with a personal access token that has <span class="font-mono">packages:write</span>.</p>
					<div class="mt-6 grid gap-6 lg:grid-cols-2">
						<div class="min-w-0">
							<h2 class="text-[13px] font-medium">Container image</h2>
							<p class="mt-1 text-[12px] text-muted-foreground">Use the token as the password. An image whose <span class="font-mono">org.opencontainers.image.source</span> label points here is linked to this repository.</p>
							<pre class="mt-3 text-xs text-foreground bg-muted rounded-sm p-3 overflow-x-auto font-mono">{ packageDockerHowTo(data) }</pre>
						</div>
						<div class="min-w-0">
							<h2 class="text-[13px] font-medium">Generic file</h2>
							<p class="mt-1 text-[12px] text-muted-foreground">One PUT per file. The URL names the package, its version and the file.</p>
							<pre class="mt-3 text-xs text-foreground bg-muted rounded-sm p-3 overflow-x-auto font-mono">{ packageCurlHowTo(data) }</pre>
						</div>
					</div>
					<p class="mt-6 text-center text-sm text-muted-foreground">
						Pulling from a private repository needs <span class="font-mono">packages:read</span>.
						<a href="/settings/tokens" class="text-foreground hover:underline">Create a token in Settings → Access tokens</a>
					</p>
				</section>
			} else {
				<div class="flex flex-col gap-4">
					<form method="get" action={ templ.SafeURL("/" + data.Repo.OwnerName + "/" + data.Repo.Name + "/packages") }>
						if data.Type != "" {
							<input type="hidden" name="type" value={ data.Type }/>
						}
						<nav class="flex flex-wrap items-center gap-1 border-b border-border text-sm" aria-label="Package type">
							@packageTypeTab(data, "", "All", data.Counts.All)
							@packageTypeTab(data, model.PackageTypeContainer, "Container", data.Counts.Container)
							@packageTypeTab(data, model.PackageTypeGeneric, "Generic", data.Counts.Generic)
							<div class="ml-auto pb-1.5 hidden sm:block">
								<label for="pkg-filter" class="sr-only">Filter packages by name</label>
								<div class="relative">
									<svg class="absolute left-2.5 top-1/2 -translate-y-1/2 text-muted-foreground" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
									<input id="pkg-filter" type="search" name="q" value={ data.Query } placeholder="Filter by name" class="w-56 h-8 pl-8 pr-3 text-[13px] bg-card border border-border rounded-md placeholder:text-muted-foreground focus:outline-hidden focus:ring-2 focus:ring-ring"/>
								</div>
							</div>
						</nav>
					</form>
					<section class="rounded-md border border-border bg-card overflow-hidden" aria-labelledby="pkg-table">
						<h2 id="pkg-table" class="sr-only">Packages in { data.Repo.OwnerName }/{ data.Repo.Name }</h2>
						if len(data.Packages) == 0 {
							<p class="p-8 text-center text-sm text-muted-foreground">No packages match.</p>
						} else {
							<table class="w-full caption-bottom text-sm">
								<thead class="[&_tr]:border-b [&_tr]:border-border">
									<tr class="border-b border-border">
										<th scope="col" class="h-10 px-4 text-left align-middle text-[11px] font-medium text-muted-foreground font-mono uppercase tracking-wider">Package</th>
										<th scope="col" class="h-10 px-4 text-left align-middle text-[11px] font-medium text-muted-foreground font-mono uppercase tracking-wider hidden md:table-cell">Type</th>
										<th scope="col" class="h-10 px-4 text-left align-middle text-[11px] font-medium text-muted-foreground font-mono uppercase tracking-wider">Latest</th>
										<th scope="col" class="h-10 px-4 text-right align-middle text-[11px] font-medium text-muted-foreground font-mono uppercase tracking-wider hidden sm:table-cell">Downloads</th>
										<th scope="col" class="h-10 px-4 text-right align-middle text-[11px] font-medium text-muted-foreground font-mono uppercase tracking-wider hidden sm:table-cell">Updated</th>
									</tr>
								</thead>
								<tbody class="[&_tr:last-child]:border-0">
									for _, p := range data.Packages {
										<tr class="border-b border-border transition-colors hover:bg-muted/50">
											<th scope="row" class="p-4 align-middle font-normal text-left">
												<div class="flex items-center gap-2.5 min-w-0">
													@packageTypeIcon(p.Type, 16)
													<a href={ templ.SafeURL(packageHref(data.Repo, p)) } class="text-[13px] font-medium hover:underline font-mono">{ p.Name }</a>
												</div>
											</th>
											<td class="p-4 align-middle hidden md:table-cell">
												@components.Badge(components.BadgeOutline) {
													{ packageTypeLabel(p.Type) }
												}
											</td>
											<td class="p-4 align-middle">
												if p.LatestVersion != "" {
													<code class="font-mono px-2 py-0.5 bg-muted text-foreground border border-border rounded-sm text-[12px]">{ p.LatestVersion }</code>
												} else {
													<span class="text-[12px] text-muted-foreground">—</span>
												}
											</td>
											<td class="p-4 align-middle text-right font-mono text-[12px] hidden sm:table-cell">
												if p.Type == model.PackageTypeContainer {
													{ strconv.FormatInt(p.Pulls, 10) }
												} else {
													<span class="text-muted-foreground">—</span>
												}
											</td>
											<td class="p-4 align-middle text-right text-[12px] text-muted-foreground hidden sm:table-cell"><time datetime={ p.UpdatedAt.UTC().Format(time.RFC3339) }>{ timefmt.Relative(p.UpdatedAt) }</time></td>
										</tr>
									}
								</tbody>
							</table>
						}
					</section>
				</div>
			}
		</div>
	}
}

templ packageTypeTab(data view.PackagesData, typ, label string, count int) {
	if data.Type == typ || typ == "" && data.Type != model.PackageTypeContainer && data.Type != model.PackageTypeGeneric {
		<a href={ templ.SafeURL(packageTabHref(data, typ)) } aria-current="page" class="px-3 py-2.5 border-b -mb-px border-foreground text-foreground font-medium inline-flex items-center gap-1.5">
			{ label }
			<span class="ml-0.5 text-[11px] text-muted-foreground font-mono" aria-label={ strconv.Itoa(count) + " items" }>{ strconv.Itoa(count) }</span>
		</a>
	} else {
		<a href={ templ.SafeURL(packageTabHref(data, typ)) } class="px-3 py-2.5 border-b -mb-px border-transparent text-muted-foreground hover:text-foreground inline-flex items-center gap-1.5">
			{ label }
			<span class="ml-0.5 text-[11px] text-muted-foreground font-mono" aria-label={ strconv.Itoa(count) + " items" }>{ strconv.Itoa(count) }</span>
		</a>
	}
}

templ packageTypeIcon(typ string, size int) {
	if typ == model.PackageTypeContainer {
		<svg class="text-muted-foreground shrink-0" width={ strconv.Itoa(size) } height={ strconv.Itoa(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" role="img" aria-label="Container image"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
	} else {
		<svg class="text-muted-foreground shrink-0" width={ strconv.Itoa(size) } height={ strconv.Itoa(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" role="img" aria-label="Generic package"><polyline points="21 8 21 21 3 21 3 8"></polyline><rect x="1" y="3" width="22" height="5"></rect><line x1="10" y1="12" x2="14" y2="12"></line></svg>
	}
}
