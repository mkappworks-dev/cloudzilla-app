package pages

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Notifications(data view.NotificationsData) {
	@layout.Base(data.BasePage, "Notifications") {
		<div class="space-y-4">
			<div class="flex justify-between items-center">
				<h1 class="text-2xl font-semibold tracking-tight">Notifications</h1>
				if data.UnreadCount > 0 {
					@components.Button(components.ButtonSecondary, components.ButtonSizeSM, templ.Attributes{
						"hx-post":   "/api/notifications/read-all",
						"hx-target": "#notifications-list",
						"hx-swap":   "outerHTML",
						"type":      "button",
					}) {
						Mark all as read
					}
				}
			</div>
			<div id="notifications-list" class="space-y-2">
				if len(data.Notifications) > 0 {
					for _, n := range data.Notifications {
						<div class={ "rounded-md border border-border bg-card p-4 flex justify-between items-start", templ.KV("border-l-4 border-l-primary", !n.Read) }>
							<div>
								<p class="text-sm text-foreground">
									<span class="font-medium">{ n.ActorName }</span>
									if n.Type == "issue_comment" {
										commented on issue
									} else if n.Type == "pr_comment" {
										commented on PR
									} else if n.Type == "issue_closed" {
										closed issue
									} else if n.Type == "issue_reopened" {
										reopened issue
									} else if n.Type == "pr_merged" {
										merged PR
									} else if n.Type == "pr_closed" {
										closed PR
									} else if n.Type == "pr_opened" {
										opened PR
									}
									in <a href={ templ.SafeURL("/" + n.OwnerName + "/" + n.RepoName) } class="text-foreground hover:underline">{ n.OwnerName }/{ n.RepoName }</a>
								</p>
								<a href={ templ.SafeURL(n.SubjectURL) } class="text-xs text-foreground hover:underline mt-1 block">View →</a>
								<p class="text-xs text-muted-foreground mt-1">
									<time datetime={ n.CreatedAt.UTC().Format(time.RFC3339) }>{ n.CreatedAt.Format("Jan 2, 2006 15:04") }</time>
								</p>
							</div>
							if !n.Read {
								@components.Button(components.ButtonGhost, components.ButtonSizeSM, templ.Attributes{
									"hx-patch":  "/api/notifications/" + strconv.FormatInt(n.ID, 10),
									"hx-target": "#notifications-list",
									"hx-swap":   "outerHTML",
									"type":      "button",
									"class":     "ml-4 shrink-0",
								}) {
									Mark read
								}
							}
						</div>
					}
				} else {
					@components.EmptyState("No notifications yet.")
				}
			</div>
		</div>
	}
}
