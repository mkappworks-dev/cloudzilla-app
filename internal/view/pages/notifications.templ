package pages

import (
	"net/url"
	"strconv"
	"strings"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/model"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

func notifIcon(t model.NotificationType) string {
	switch t {
	case model.NotifPRReview:
		return "review"
	case model.NotifMention:
		return "mention"
	case model.NotifPRMerged:
		return "merged"
	case model.NotifDiscussionReply:
		return "discussion"
	case model.NotifRepoTransfer:
		return "transfer"
	case model.NotifIssueClosed, model.NotifIssueReopened:
		return "issue"
	default:
		return "comment"
	}
}

func notifTitle(n model.Notification) string {
	switch n.Type {
	case model.NotifPRReview:
		return "@" + n.ActorName + " reviewed PR #" + strconv.FormatInt(n.SubjectID, 10)
	case model.NotifMention:
		return "@" + n.ActorName + " mentioned you"
	case model.NotifPRMerged:
		return "@" + n.ActorName + " merged PR #" + strconv.FormatInt(n.SubjectID, 10)
	case model.NotifPROpened:
		return "@" + n.ActorName + " opened PR #" + strconv.FormatInt(n.SubjectID, 10)
	case model.NotifPRClosed:
		return "@" + n.ActorName + " closed PR #" + strconv.FormatInt(n.SubjectID, 10)
	case model.NotifPRComment:
		return "@" + n.ActorName + " commented on PR #" + strconv.FormatInt(n.SubjectID, 10)
	case model.NotifIssueComment:
		return "@" + n.ActorName + " commented on issue #" + strconv.FormatInt(n.SubjectID, 10)
	case model.NotifIssueClosed:
		return "@" + n.ActorName + " closed issue #" + strconv.FormatInt(n.SubjectID, 10)
	case model.NotifIssueReopened:
		return "@" + n.ActorName + " reopened issue #" + strconv.FormatInt(n.SubjectID, 10)
	case model.NotifDiscussionReply:
		return "@" + n.ActorName + " replied in a discussion"
	case model.NotifRepoTransfer:
		return "@" + n.ActorName + " wants to transfer a repository to you"
	default:
		return "@" + n.ActorName + " in " + n.OwnerName + "/" + n.RepoName
	}
}

func notifRelTime(t time.Time) string {
	d := time.Since(t)
	switch {
	case d < time.Minute:
		return "just now"
	case d < time.Hour:
		return strconv.Itoa(int(d.Minutes())) + "m ago"
	case d < 24*time.Hour:
		return strconv.Itoa(int(d.Hours())) + "h ago"
	case d < 48*time.Hour:
		return "yesterday"
	default:
		return t.Format("Jan 2")
	}
}

templ notifTypeIcon(t model.NotificationType) {
	switch t {
	case model.NotifPRReview:
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
	case model.NotifMention:
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 006 0v-1a10 10 0 10-3.92 7.94"/></svg>
	case model.NotifPRMerged:
		<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M5 3.254V3.25v.005a.75.75 0 110-.005v.004zm.45 1.9a2.25 2.25 0 10-1.95.218v5.256a2.25 2.25 0 101.5 0V7.123A5.735 5.735 0 009.25 9h1.378a2.251 2.251 0 100-1.5H9.25a4.25 4.25 0 01-3.8-2.346zM12.75 9a.75.75 0 100-1.5.75.75 0 000 1.5zm-8.5 4.5a.75.75 0 100-1.5.75.75 0 000 1.5z"/></svg>
	case model.NotifDiscussionReply:
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
	case model.NotifIssueClosed:
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9 9l6 6M15 9l-6 6"/></svg>
	case model.NotifRepoTransfer:
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M4 8h14l-4-4M20 16H6l4 4"/></svg>
	default:
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
	}
}

templ notifIconClass(t model.NotificationType, read bool) {
	if read {
		<span class="shrink-0 w-7 h-7 rounded-[6px] grid place-items-center bg-accent border border-border opacity-65">
			@notifTypeIcon(t)
		</span>
	} else {
		switch t {
		case model.NotifPRReview:
			<span class="shrink-0 w-7 h-7 rounded-[6px] grid place-items-center bg-accent border border-border text-primary">
				@notifTypeIcon(t)
			</span>
		case model.NotifMention:
			<span class="shrink-0 w-7 h-7 rounded-[6px] grid place-items-center bg-accent border border-border text-warning">
				@notifTypeIcon(t)
			</span>
		case model.NotifPRMerged:
			<span class="shrink-0 w-7 h-7 rounded-[6px] grid place-items-center bg-accent border border-border text-[hsl(270_70%_70%)]">
				@notifTypeIcon(t)
			</span>
		case model.NotifDiscussionReply, model.NotifRepoTransfer:
			<span class="shrink-0 w-7 h-7 rounded-[6px] grid place-items-center bg-accent border border-border text-primary">
				@notifTypeIcon(t)
			</span>
		case model.NotifIssueClosed:
			<span class="shrink-0 w-7 h-7 rounded-[6px] grid place-items-center bg-accent border border-border text-destructive">
				@notifTypeIcon(t)
			</span>
		default:
			<span class="shrink-0 w-7 h-7 rounded-[6px] grid place-items-center bg-accent border border-border text-muted-foreground">
				@notifTypeIcon(t)
			</span>
		}
	}
}

type notifGroup struct {
	Repo  string
	Items []model.Notification
}

// notifGroups buckets a page's rows under their repo, repos in order of first appearance.
func notifGroups(items []model.Notification) []notifGroup {
	var groups []notifGroup
	idx := map[string]int{}
	for _, n := range items {
		repo := n.OwnerName + "/" + n.RepoName
		i, ok := idx[repo]
		if !ok {
			i = len(groups)
			idx[repo] = i
			groups = append(groups, notifGroup{Repo: repo})
		}
		groups[i].Items = append(groups[i].Items, n)
	}
	return groups
}

func notifURL(filter string, page int) string {
	q := url.Values{}
	if filter != "" && filter != "inbox" {
		q.Set("filter", filter)
	}
	if page > 1 {
		q.Set("page", strconv.Itoa(page))
	}
	if len(q) == 0 {
		return "/notifications"
	}
	return "/notifications?" + q.Encode()
}

// notifAPIQuery carries the current filter and page to the HTMX endpoints so the re-rendered view stays put.
func notifAPIQuery(filter string, page int) string {
	return strings.TrimPrefix(notifURL(filter, page), "/notifications")
}

// notifPageWindow lists the page numbers to show; 0 marks a gap.
func notifPageWindow(page, total int) []int {
	var out []int
	last := 0
	for p := 1; p <= total; p++ {
		if p != 1 && p != total && (p < page-1 || p > page+1) {
			continue
		}
		if last != 0 && p-last > 1 {
			out = append(out, 0)
		}
		out = append(out, p)
		last = p
	}
	return out
}

func notifRange(page, perPage, shown int) string {
	if shown == 0 {
		return "0"
	}
	first := (page-1)*perPage + 1
	return strconv.Itoa(first) + "–" + strconv.Itoa(first+shown-1)
}

const notifNavClass = "flex items-center justify-between px-2.5 py-1.5 rounded-md text-[13px] hover:bg-accent"

templ notifNavLink(label, filter, current string, count int) {
	<a
		href={ templ.SafeURL(notifURL(filter, 1)) }
		class={ notifNavClass, templ.KV("bg-accent font-semibold", filter == current) }
		if filter == current {
			aria-current="page"
		}
	>
		<span>{ label }</span>
		<span class="font-mono text-[12px] text-muted-foreground">{ strconv.Itoa(count) }</span>
	</a>
}

templ notifPageLink(filter string, page int, label string) {
	<a href={ templ.SafeURL(notifURL(filter, page)) } class="h-8 min-w-8 px-2 grid place-items-center rounded-md text-[13px] hover:bg-accent">{ label }</a>
}

templ notifPager(filter string, page, total int) {
	if total > 1 {
		<nav class="mt-5 flex items-center justify-center gap-1" aria-label="Pagination">
			if page > 1 {
				@notifPageLink(filter, page-1, "‹ Previous")
			} else {
				<span class="h-8 px-2 grid place-items-center text-[13px] text-muted-foreground opacity-50" aria-disabled="true">‹ Previous</span>
			}
			for _, p := range notifPageWindow(page, total) {
				if p == 0 {
					<span class="h-8 min-w-8 grid place-items-center text-[13px] text-muted-foreground" aria-hidden="true">…</span>
				} else if p == page {
					<span class="h-8 min-w-8 px-2 grid place-items-center rounded-md text-[13px] bg-primary text-primary-foreground" aria-current="page">{ strconv.Itoa(p) }</span>
				} else {
					@notifPageLink(filter, p, strconv.Itoa(p))
				}
			}
			if page < total {
				@notifPageLink(filter, page+1, "Next ›")
			} else {
				<span class="h-8 px-2 grid place-items-center text-[13px] text-muted-foreground opacity-50" aria-disabled="true">Next ›</span>
			}
		</nav>
	}
}

// notifSelectData is the Alpine state behind the bulk bar: how many rows are ticked, out of total on this page.
func notifSelectData(total int) string {
	return "{ n: 0, total: " + strconv.Itoa(total) + ", " +
		"count() { this.n = $root.querySelectorAll('input[name=ids]:checked').length }, " +
		"all(on) { $root.querySelectorAll('input[name=ids]').forEach(c => c.checked = on); this.count() } }"
}

const notifIconBtnClass = "size-7 grid place-items-center border border-border rounded-md bg-card text-muted-foreground hover:text-foreground hover:bg-accent"

templ notifRow(n model.Notification, filter string, page int, watched bool) {
	<li class="group border-b border-border last:border-b-0">
		<div class={ "flex items-center gap-3 px-4 py-2 min-h-[46px] hover:bg-accent transition-colors has-[:checked]:bg-primary/10", templ.KV("bg-primary/[0.03]", !n.Read) }>
			if !n.Read {
				<span class="shrink-0 w-[7px] h-[7px] rounded-full bg-primary" aria-label="Unread"></span>
			} else {
				<span class="shrink-0 w-[7px] h-[7px] rounded-full border border-border" aria-hidden="true"></span>
			}
			<input
				type="checkbox"
				name="ids"
				value={ strconv.FormatInt(n.ID, 10) }
				class="shrink-0 size-[15px] accent-primary cursor-pointer"
				aria-label="Select notification"
				@change="count()"
			/>
			@notifIconClass(n.Type, n.Read)
			<a href={ templ.SafeURL(n.SubjectURL) } class="min-w-0 flex-1 truncate">
				if n.SubjectTitle != "" {
					<span class={ "text-[13.5px]", templ.KV("font-semibold", !n.Read), templ.KV("text-muted-foreground", n.Read) }>{ n.SubjectTitle }</span>
					<span class="text-[12px] text-muted-foreground ml-2">{ notifTitle(n) }</span>
				} else {
					<span class={ "text-[13.5px]", templ.KV("font-semibold", !n.Read), templ.KV("text-muted-foreground", n.Read) }>{ notifTitle(n) }</span>
				}
			</a>
			<div class="group/right relative shrink-0 w-[150px] h-7 flex items-center justify-end gap-3">
				@components.Avatar(n.ActorName, components.AvatarSizeXS, "")
				<time class="w-16 text-right text-[12px] text-muted-foreground group-hover:invisible group-has-[:focus-visible]/right:invisible" datetime={ n.CreatedAt.UTC().Format(time.RFC3339) }>{ notifRelTime(n.CreatedAt) }</time>
				<div class="absolute right-0 top-0 h-7 flex items-center gap-1 opacity-0 group-hover:opacity-100 focus-within:opacity-100">
					if !n.Read {
						<button
							type="button"
							class={ notifIconBtnClass }
							aria-label="Done"
							title="Done"
							hx-patch={ "/api/notifications/" + strconv.FormatInt(n.ID, 10) + notifAPIQuery(filter, page) }
							hx-target="#notifications-view"
							hx-swap="outerHTML"
						>
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
						</button>
					}
					if watched {
						<button
							type="button"
							class={ notifIconBtnClass }
							aria-label={ "Unsubscribe from " + n.OwnerName + "/" + n.RepoName }
							title={ "Unsubscribe: stop watching " + n.OwnerName + "/" + n.RepoName }
							hx-post={ "/api/notifications/unsubscribe" + notifAPIQuery(filter, page) }
							hx-vals={ `{"ids":"` + strconv.FormatInt(n.ID, 10) + `"}` }
							hx-target="#notifications-view"
							hx-swap="outerHTML"
						>
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M13.7 21a2 2 0 01-3.4 0M18.6 13A17 17 0 0118 8M6.3 6.3A6 6 0 006 8c0 7-3 9-3 9h14M18 8a6 6 0 00-9.3-5M1 1l22 22"/></svg>
						</button>
					}
				</div>
			</div>
		</div>
	</li>
}

// NotificationsInbox is the HTMX swap target for the row and bulk actions: filter sidebar, list and pager.
templ NotificationsInbox(data view.NotificationsData) {
	<div id="notifications-view" class="grid gap-6 md:grid-cols-[210px_1fr]" x-data={ notifSelectData(len(data.Notifications)) }>
		<aside aria-label="Notification filters">
			<nav class="flex flex-col gap-0.5">
				@notifNavLink("Inbox", "inbox", data.Filter, data.InboxCount)
				@notifNavLink("Unread", "unread", data.Filter, data.UnreadCount)
				@notifNavLink("Read", "read", data.Filter, data.ReadCount)
			</nav>
			<a href="/settings#notifications" class="mt-3 flex items-center gap-2 px-2.5 py-1.5 rounded-md text-[13px] hover:bg-accent">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="text-muted-foreground" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 01-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
				<span>Notification settings</span>
			</a>
		</aside>
		<div class="min-w-0">
			if len(data.Notifications) > 0 {
				<form id="notifications-form" class="border border-border rounded-md bg-card overflow-hidden" aria-label="Notifications" @submit.prevent>
					<div x-show="n === 0" class="flex items-center gap-3 px-4 min-h-[45px] border-b border-border bg-muted/40 text-[12px] text-muted-foreground">
						<input type="checkbox" class="shrink-0 size-[15px] accent-primary cursor-pointer" aria-label="Select all notifications on this page" @change="all($el.checked)"/>
						<span><span class="font-mono">{ strconv.Itoa(data.UnreadCount) }</span> unread</span>
						<span class="flex-1"></span>
						if data.UnreadCount > 0 {
							<button
								type="button"
								class="h-7 px-2.5 text-[12px] text-foreground border border-border rounded-md bg-card hover:bg-accent inline-flex items-center gap-1.5"
								hx-post={ "/api/notifications/read-all" + notifAPIQuery(data.Filter, data.Page) }
								hx-target="#notifications-view"
								hx-swap="outerHTML"
							>
								<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
								Mark all as read
							</button>
						}
					</div>
					<div x-show="n > 0" x-cloak class="flex items-center gap-3 px-4 min-h-[45px] border-b border-border bg-muted/40 text-[13px]">
						<input type="checkbox" class="shrink-0 size-[15px] accent-primary cursor-pointer" aria-label="Select all notifications on this page" :checked="n === total" @change="all($el.checked)"/>
						<span class="font-semibold"><span x-text="n"></span> selected</span>
						<span class="flex-1"></span>
						<button
							type="button"
							class="h-7 px-2.5 text-[12px] border border-border rounded-md bg-card hover:bg-accent inline-flex items-center gap-1.5"
							hx-post={ "/api/notifications/done" + notifAPIQuery(data.Filter, data.Page) }
							hx-include="#notifications-form"
							hx-target="#notifications-view"
							hx-swap="outerHTML"
						>
							<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
							Done
						</button>
						<button
							type="button"
							class="h-7 px-2.5 text-[12px] border border-border rounded-md bg-card hover:bg-accent inline-flex items-center gap-1.5"
							title="Stop watching the repositories behind the selected notifications"
							hx-post={ "/api/notifications/unsubscribe" + notifAPIQuery(data.Filter, data.Page) }
							hx-include="#notifications-form"
							hx-target="#notifications-view"
							hx-swap="outerHTML"
						>
							<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M13.7 21a2 2 0 01-3.4 0M18.6 13A17 17 0 0118 8M6.3 6.3A6 6 0 006 8c0 7-3 9-3 9h14M18 8a6 6 0 00-9.3-5M1 1l22 22"/></svg>
							Unsubscribe
						</button>
					</div>
					for _, g := range notifGroups(data.Notifications) {
						<h2 class="px-4 py-2 text-[13px] font-semibold font-mono bg-muted/40 border-b border-border">{ g.Repo }</h2>
						<ol>
							for _, n := range g.Items {
								@notifRow(n, data.Filter, data.Page, data.WatchedRepos[n.RepoID] && n.Type != model.NotifRepoTransfer)
							}
						</ol>
					}
				</form>
				@notifPager(data.Filter, data.Page, data.TotalPages)
				<p class="mt-3 text-center text-[12px] text-muted-foreground">
					<span class="font-mono">{ notifRange(data.Page, data.PerPage, len(data.Notifications)) }</span> of <span class="font-mono">{ strconv.Itoa(data.Total) }</span>
				</p>
			} else {
				<section class="border border-border rounded-md bg-card overflow-hidden">
					<div class="px-4 py-16 text-center">
						if data.Filter == "read" {
							<p class="text-[13px] text-muted-foreground">No read notifications.</p>
						} else {
							<p class="text-[13px] text-muted-foreground">You&#39;re all caught up.</p>
						}
					</div>
				</section>
			}
		</div>
	</div>
}

templ Notifications(data view.NotificationsData) {
	@layout.Base(data.BasePage, "Notifications") {
		<h1 class="mb-5 text-2xl font-semibold tracking-tight">Notifications</h1>
		@NotificationsInbox(data)
	}
}
