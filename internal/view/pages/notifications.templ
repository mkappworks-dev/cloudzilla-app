package pages

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

// notifVerb returns the verb phrase that follows the actor name for a given notification type.
func notifVerb(t string) string {
	switch t {
	case "issue_comment":
		return "commented on issue"
	case "pr_comment":
		return "commented on PR"
	case "issue_closed":
		return "closed issue"
	case "issue_reopened":
		return "reopened issue"
	case "pr_merged":
		return "merged PR"
	case "pr_closed":
		return "closed PR"
	case "pr_opened":
		return "opened PR"
	default:
		return t
	}
}

templ Notifications(data view.NotificationsData) {
	@layout.Base(data.BasePage, "Notifications") {
		<div class="max-w-3xl mx-auto space-y-6">

			<section class="flex flex-wrap items-start justify-between gap-4" aria-labelledby="notif-title">
				<div class="min-w-0">
					<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">
						Cloudzilla · Inbox
						if data.UnreadCount > 0 {
							<span class="ml-1">· { strconv.Itoa(data.UnreadCount) } unread</span>
						}
					</p>
					<h1 id="notif-title" class="text-2xl font-semibold tracking-tight">Notifications</h1>
				</div>
				if data.UnreadCount > 0 {
					@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{
						"hx-post":   "/api/notifications/read-all",
						"hx-target": "#notifications-list",
						"hx-swap":   "outerHTML",
						"type":      "button",
					}) {
						Mark all as read
					}
				}
			</section>

			<div id="notifications-list">
				if len(data.Notifications) > 0 {
					<section class="rounded-md border border-border bg-card overflow-hidden" aria-labelledby="notif-list">
						<h2 id="notif-list" class="sr-only">Notifications</h2>
						<ol class="divide-y divide-border">
							for _, n := range data.Notifications {
								<li class={ "flex items-start gap-3 px-4 py-3 hover:bg-muted/50", templ.KV("bg-primary/5", !n.Read) }>
									<span class={ "mt-2 h-2 w-2 rounded-full shrink-0", templ.KV("bg-primary", !n.Read), templ.KV("bg-transparent", n.Read) } aria-hidden="true"></span>
									<div class="min-w-0 flex-1">
										<a href={ templ.SafeURL(n.SubjectURL) } class="block text-[13px] hover:underline">
											<span class="font-medium">{ n.ActorName }</span>
											<span class="text-muted-foreground">&nbsp;{ notifVerb(string(n.Type)) } in&nbsp;</span>
											<span class="font-medium">{ n.OwnerName }/{ n.RepoName }</span>
										</a>
										<p class="mt-0.5 font-mono text-[11px] text-muted-foreground">
											<time datetime={ n.CreatedAt.UTC().Format(time.RFC3339) }>{ n.CreatedAt.Format("Jan 2, 2006 15:04") }</time>
										</p>
									</div>
									if !n.Read {
										@components.Button(components.ButtonGhost, components.ButtonSizeSM, templ.Attributes{
											"hx-patch":  "/api/notifications/" + strconv.FormatInt(n.ID, 10),
											"hx-target": "#notifications-list",
											"hx-swap":   "outerHTML",
											"type":      "button",
											"class":     "shrink-0",
										}) {
											Mark read
										}
									}
								</li>
							}
						</ol>
					</section>
				} else {
					@components.EmptyState("No notifications yet.")
				}
			</div>
		</div>
	}
}
