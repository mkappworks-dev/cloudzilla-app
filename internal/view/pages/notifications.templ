package pages

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/model"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

func notifIcon(t model.NotificationType) string {
	switch t {
	case model.NotifPRReview:
		return "review"
	case model.NotifMention:
		return "mention"
	case model.NotifPRMerged:
		return "merged"
	case model.NotifDiscussionReply:
		return "discussion"
	case model.NotifIssueClosed, model.NotifIssueReopened:
		return "issue"
	default:
		return "comment"
	}
}

func notifTitle(n model.Notification) string {
	switch n.Type {
	case model.NotifPRReview:
		return "@" + n.ActorName + " requested your review on PR #" + strconv.FormatInt(n.SubjectID, 10)
	case model.NotifMention:
		return "@" + n.ActorName + " mentioned you"
	case model.NotifPRMerged:
		return "@" + n.ActorName + " merged PR #" + strconv.FormatInt(n.SubjectID, 10)
	case model.NotifPROpened:
		return "@" + n.ActorName + " opened PR #" + strconv.FormatInt(n.SubjectID, 10)
	case model.NotifPRClosed:
		return "@" + n.ActorName + " closed PR #" + strconv.FormatInt(n.SubjectID, 10)
	case model.NotifPRComment:
		return "@" + n.ActorName + " commented on PR #" + strconv.FormatInt(n.SubjectID, 10)
	case model.NotifIssueComment:
		return "@" + n.ActorName + " commented on issue #" + strconv.FormatInt(n.SubjectID, 10)
	case model.NotifIssueClosed:
		return "@" + n.ActorName + " closed issue #" + strconv.FormatInt(n.SubjectID, 10)
	case model.NotifIssueReopened:
		return "@" + n.ActorName + " reopened issue #" + strconv.FormatInt(n.SubjectID, 10)
	case model.NotifDiscussionReply:
		return "@" + n.ActorName + " replied in a discussion"
	default:
		return "@" + n.ActorName + " in " + n.OwnerName + "/" + n.RepoName
	}
}

func notifRelTime(t time.Time) string {
	d := time.Since(t)
	switch {
	case d < time.Minute:
		return "just now"
	case d < time.Hour:
		return strconv.Itoa(int(d.Minutes())) + "m ago"
	case d < 24*time.Hour:
		return strconv.Itoa(int(d.Hours())) + "h ago"
	case d < 48*time.Hour:
		return "yesterday"
	default:
		return t.Format("Jan 2")
	}
}

templ notifTypeIcon(t model.NotificationType) {
	switch t {
	case model.NotifPRReview:
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
	case model.NotifMention:
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 006 0v-1a10 10 0 10-3.92 7.94"/></svg>
	case model.NotifPRMerged:
		<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M5 3.254V3.25v.005a.75.75 0 110-.005v.004zm.45 1.9a2.25 2.25 0 10-1.95.218v5.256a2.25 2.25 0 101.5 0V7.123A5.735 5.735 0 009.25 9h1.378a2.251 2.251 0 100-1.5H9.25a4.25 4.25 0 01-3.8-2.346zM12.75 9a.75.75 0 100-1.5.75.75 0 000 1.5zm-8.5 4.5a.75.75 0 100-1.5.75.75 0 000 1.5z"/></svg>
	case model.NotifDiscussionReply:
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
	case model.NotifIssueClosed:
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9 9l6 6M15 9l-6 6"/></svg>
	default:
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
	}
}

templ notifIconClass(t model.NotificationType, read bool) {
	if read {
		<span class="flex-shrink-0 w-7 h-7 rounded-[6px] grid place-items-center bg-accent border border-border opacity-65">
			@notifTypeIcon(t)
		</span>
	} else {
		switch t {
		case model.NotifPRReview:
			<span class="flex-shrink-0 w-7 h-7 rounded-[6px] grid place-items-center bg-accent border border-border text-primary">
				@notifTypeIcon(t)
			</span>
		case model.NotifMention:
			<span class="flex-shrink-0 w-7 h-7 rounded-[6px] grid place-items-center bg-accent border border-border text-warning">
				@notifTypeIcon(t)
			</span>
		case model.NotifPRMerged:
			<span class="flex-shrink-0 w-7 h-7 rounded-[6px] grid place-items-center bg-accent border border-border text-[hsl(270_70%_70%)]">
				@notifTypeIcon(t)
			</span>
		case model.NotifDiscussionReply:
			<span class="flex-shrink-0 w-7 h-7 rounded-[6px] grid place-items-center bg-accent border border-border text-primary">
				@notifTypeIcon(t)
			</span>
		case model.NotifIssueClosed:
			<span class="flex-shrink-0 w-7 h-7 rounded-[6px] grid place-items-center bg-accent border border-border text-destructive">
				@notifTypeIcon(t)
			</span>
		default:
			<span class="flex-shrink-0 w-7 h-7 rounded-[6px] grid place-items-center bg-accent border border-border text-muted-foreground">
				@notifTypeIcon(t)
			</span>
		}
	}
}

templ Notifications(data view.NotificationsData) {
	@layout.Base(data.BasePage, "Notifications") {
		<section class="mb-6 flex items-end justify-between gap-4" aria-labelledby="notif-title">
			<div>
				<h1 id="notif-title" class="text-2xl font-semibold tracking-tight">Notifications</h1>
				<p class="mt-1 text-[13px] text-muted-foreground">
					<span class="font-mono">{ strconv.Itoa(data.UnreadCount) }</span> unread
				</p>
			</div>
			<div class="flex items-center gap-1.5">
				if data.UnreadCount > 0 {
					<button
						type="button"
						class="h-8 px-3 text-[13px] border border-border rounded-md hover:bg-accent inline-flex items-center gap-1.5"
						hx-post="/api/notifications/read-all"
						hx-target="#notifications-list"
						hx-swap="outerHTML"
					>
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
						Mark all as read
					</button>
				}
				<a
					href="/settings#notifications"
					class="h-8 px-3 text-[13px] border border-border rounded-md hover:bg-accent inline-flex items-center gap-1.5"
				>
					<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 01-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
					Notification settings
				</a>
			</div>
		</section>

		<div id="notifications-list">
			if len(data.Notifications) > 0 {
				<section class="border border-border rounded-md bg-card overflow-hidden" aria-labelledby="inbox-heading">
					<h2 id="inbox-heading" class="sr-only">Inbox</h2>

					<!-- Toolbar -->
					<div class="flex items-center justify-between gap-3 px-3 py-2 border-b border-border">
						<span class="text-[12px] text-muted-foreground px-2">
							<span class="font-mono">{ strconv.Itoa(len(data.Notifications)) }</span> notifications
						</span>
					</div>

					<ol>
						for _, n := range data.Notifications {
							<li class="border-b border-border last:border-b-0">
								<div class={ "flex items-start gap-3 px-4 py-3 hover:bg-accent transition-colors", templ.KV("bg-primary/[0.03]", !n.Read) }>
									<!-- Unread dot -->
									if !n.Read {
										<span class="flex-shrink-0 w-[7px] h-[7px] rounded-full bg-primary mt-[9px]" aria-label="Unread"></span>
									} else {
										<span class="flex-shrink-0 w-[7px] h-[7px] rounded-full border border-border mt-[9px]" aria-hidden="true"></span>
									}

									<!-- Type icon -->
									@notifIconClass(n.Type, n.Read)

									<!-- Content -->
									<div class="min-w-0 flex-1">
										<a href={ templ.SafeURL(n.SubjectURL) } class="block">
											<p class={ "text-[13.5px] leading-snug", templ.KV("text-muted-foreground", n.Read) }>
												{ notifTitle(n) }
											</p>
											<p class="text-[11.5px] text-muted-foreground/70 mt-0.5 font-mono">
												{ n.OwnerName }/{ n.RepoName }
												<span aria-hidden="true"> · </span>
												<time datetime={ n.CreatedAt.UTC().Format(time.RFC3339) }>{ notifRelTime(n.CreatedAt) }</time>
											</p>
										</a>
									</div>

									<!-- Actions -->
									<div class="flex items-center gap-1 shrink-0">
										if !n.Read {
											<button
												type="button"
												class="h-7 w-7 grid place-items-center text-muted-foreground/70 hover:text-foreground rounded-md"
												aria-label="Mark as read"
												hx-patch={ "/api/notifications/" + strconv.FormatInt(n.ID, 10) }
												hx-target="#notifications-list"
												hx-swap="outerHTML"
											>
												<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
											</button>
										}
									</div>
								</div>
							</li>
						}
					</ol>
				</section>
			} else {
				<section class="border border-border rounded-md bg-card overflow-hidden">
					<div class="px-4 py-16 text-center">
						<p class="text-[13px] text-muted-foreground">You&#39;re all caught up.</p>
					</div>
				</section>
			}
		</div>
	}
}
