package pages

import (
	"strconv"
	"github.com/mkappworks/cloudzilla/internal/view"
	"github.com/mkappworks/cloudzilla/internal/view/layout"
)

templ Releases(data view.ReleasesData) {
	@layout.Base(data.BasePage, "Releases · "+data.Owner+"/"+data.RepoName) {
		<div class="space-y-6">
			<div class="flex items-center justify-between">
				<div>
					<h1 class="text-2xl font-bold">
						<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="text-blue-600 hover:underline">{ data.Owner }/{ data.RepoName }</a>
						<span class="text-gray-400 font-normal mx-1">/</span>
						<span>Releases</span>
					</h1>
				</div>
				if data.CanWrite {
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/refs") } class="inline-flex items-center gap-2 px-4 py-2 bg-green-600 text-white rounded-md text-sm font-medium hover:bg-green-700 transition-colors">
						+ New Release
					</a>
				}
			</div>
			if data.CanWrite {
				<div class="bg-white border border-gray-200 rounded-lg p-6">
					<h2 class="text-lg font-semibold mb-4">Create Release</h2>
					<form hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/releases" } hx-target="body" class="space-y-4">
						<div class="grid grid-cols-2 gap-4">
							<div>
								<label class="block text-sm font-medium text-gray-700 mb-1">Tag Name <span class="text-red-500">*</span></label>
								<input type="text" name="tag_name" required placeholder="v1.0.0" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
							</div>
							<div>
								<label class="block text-sm font-medium text-gray-700 mb-1">Release Title</label>
								<input type="text" name="name" placeholder="Release v1.0.0" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
							</div>
						</div>
						<div>
							<label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
							<textarea name="body" rows="6" placeholder="Describe this release..." class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
						</div>
						<div class="flex items-center gap-6">
							<label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
								<input type="checkbox" name="is_prerelease" value="true" class="rounded"/>
								Pre-release
							</label>
							<label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
								<input type="checkbox" name="is_draft" value="true" class="rounded"/>
								Draft
							</label>
						</div>
						<div class="flex justify-end">
							<button type="submit" class="px-4 py-2 bg-green-600 text-white rounded-md text-sm font-medium hover:bg-green-700 transition-colors">
								Publish Release
							</button>
						</div>
					</form>
				</div>
			}
			if len(data.Releases) > 0 {
				<div class="space-y-4">
					for _, release := range data.Releases {
						<div class="bg-white border border-gray-200 rounded-lg p-6">
							<div class="flex items-start justify-between gap-4">
								<div class="flex-1 min-w-0">
									<div class="flex items-center gap-2 flex-wrap mb-1">
										<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/releases/tag/" + release.TagName) } class="text-xl font-semibold text-blue-600 hover:underline">
											if release.Name != "" {
												{ release.Name }
											} else {
												{ release.TagName }
											}
										</a>
										<code class="px-2 py-0.5 bg-blue-50 text-blue-700 border border-blue-200 rounded text-sm font-mono">{ release.TagName }</code>
										if release.IsPrerelease {
											<span class="px-2 py-0.5 bg-yellow-100 text-yellow-700 border border-yellow-300 rounded text-xs font-medium">Pre-release</span>
										}
										if release.IsDraft {
											<span class="px-2 py-0.5 bg-gray-100 text-gray-600 border border-gray-300 rounded text-xs font-medium">Draft</span>
										}
									</div>
									<p class="text-xs text-gray-500">
										if release.PublishedAt != nil {
											Published { release.PublishedAt.Format("Jan 2, 2006") }
										} else {
											Not yet published
										}
									</p>
								</div>
								if data.CanWrite {
									<div class="flex items-center gap-2 shrink-0">
										<button hx-delete={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/releases/" + strconv.FormatInt(release.ID, 10) } hx-confirm="Delete this release?" class="px-3 py-1.5 text-red-600 border border-red-300 rounded text-xs font-medium hover:bg-red-50 transition-colors">
											Delete
										</button>
									</div>
								}
							</div>
						</div>
					}
				</div>
			} else {
				<div class="bg-white border border-gray-200 rounded-lg p-12 text-center text-gray-500">
					<p class="text-lg font-medium">No releases yet</p>
					if data.CanWrite {
						<p class="text-sm mt-1">Create a release to package and distribute your software.</p>
					}
				</div>
			}
		</div>
	}
}
