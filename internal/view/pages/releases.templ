package pages

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Releases(data view.ReleasesData) {
	@layout.Base(data.BasePage, "Releases · "+data.Owner+"/"+data.RepoName) {
		<div class="max-w-5xl mx-auto space-y-6">

			<section class="flex flex-wrap items-start justify-between gap-4" aria-labelledby="rel-title">
				<div class="min-w-0">
					<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">
						<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="hover:underline">{ data.RepoName }</a>
						<span aria-hidden="true">·</span>
						Releases
					</p>
					<h1 id="rel-title" class="text-2xl font-semibold tracking-tight">Releases</h1>
					<p class="mt-1 text-[13px] text-muted-foreground">Tag, package, and ship — releases are the cuttable points in your project's history.</p>
				</div>
				if data.CanWrite {
					@components.LinkButton("#draft", components.ButtonSuccess, components.ButtonSizeDefault, nil) {
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" focusable="false">
							<path d="M12 5v14M5 12h14"></path>
						</svg>
						Draft release
					}
				}
			</section>

			if data.CanWrite {
				<section id="draft" class="rounded-md border border-border bg-card overflow-hidden" aria-labelledby="draft-heading">
					<header class="px-5 py-3 border-b border-border bg-muted/50 flex items-center gap-2">
						<h2 id="draft-heading" class="text-[13px] font-medium">New release</h2>
						<span class="ml-auto font-mono text-[11px] text-muted-foreground">draft</span>
					</header>
					<form hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/releases" } hx-target="body" class="p-5 space-y-4">
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div class="space-y-1.5">
								<label for="release-tag-name" class="block text-sm font-medium">
									Tag <span class="text-destructive" aria-hidden="true">*</span>
								</label>
								@components.Input(templ.Attributes{
									"id":          "release-tag-name",
									"type":        "text",
									"name":        "tag_name",
									"required":    "required",
									"placeholder": "v1.0.0",
									"class":       "font-mono",
								})
							</div>
							<div class="space-y-1.5">
								<label for="release-name" class="block text-sm font-medium">Release title</label>
								@components.Input(templ.Attributes{
									"id":          "release-name",
									"type":        "text",
									"name":        "name",
									"placeholder": "Phase 16 — performance",
								})
							</div>
						</div>
						<div class="space-y-1.5">
							<label for="release-body" class="block text-sm font-medium">Description</label>
							@components.Textarea(templ.Attributes{
								"id":          "release-body",
								"name":        "body",
								"rows":        "6",
								"placeholder": "What changed, why it matters, upgrade notes…",
								"class":       "font-mono min-h-[140px]",
							})
						</div>
						<div class="flex flex-wrap items-center gap-6">
							<label class="flex items-center gap-2 text-sm cursor-pointer">
								@components.Checkbox(templ.Attributes{"name": "is_prerelease", "value": "true"})
								<span>Pre-release</span>
							</label>
							<label class="flex items-center gap-2 text-sm cursor-pointer">
								@components.Checkbox(templ.Attributes{"name": "is_draft", "value": "true"})
								<span>Save as draft</span>
							</label>
						</div>
						<div class="flex justify-end pt-1">
							@components.Button(components.ButtonSuccess, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
								Publish release
							}
						</div>
					</form>
				</section>
			}

			if len(data.Releases) > 0 {
				<section class="space-y-4" aria-labelledby="rel-list">
					<h2 id="rel-list" class="sr-only">Published releases</h2>
					for _, release := range data.Releases {
						<article class="rounded-md border border-border bg-card overflow-hidden">
							<div class="grid sm:grid-cols-[180px_1fr] gap-0">
								<aside class="border-b sm:border-b-0 sm:border-r border-border p-5 bg-muted/30">
									if release.PublishedAt != nil {
										<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider">Published</p>
										<p class="mt-1 text-[13px] text-muted-foreground">
											<time datetime={ release.PublishedAt.UTC().Format(time.RFC3339) }>{ release.PublishedAt.Format("Jan 2, 2006") }</time>
										</p>
									} else {
										<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider">Status</p>
										<p class="mt-1 text-[13px] text-muted-foreground">Not yet published</p>
									}
								</aside>
								<div class="p-5">
									<div class="flex flex-wrap items-center gap-2">
										<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/releases/tag/" + release.TagName) } class="text-lg font-semibold tracking-tight hover:underline">
											if release.Name != "" {
												{ release.Name }
											} else {
												{ release.TagName }
											}
										</a>
										<code class="font-mono px-2 py-0.5 bg-muted text-foreground border border-border rounded text-[12px]">{ release.TagName }</code>
										if release.IsPrerelease {
											@components.Badge(components.BadgeWarning) {
												Pre-release
											}
										}
										if release.IsDraft {
											@components.Badge(components.BadgeDraft) {
												Draft
											}
										}
									</div>
									if data.CanWrite {
										<div class="mt-3 flex items-center gap-2">
											@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{
												"hx-delete":  "/api/repos/" + data.Owner + "/" + data.RepoName + "/releases/" + strconv.FormatInt(release.ID, 10),
												"hx-confirm": "Delete this release?",
												"class":      "ml-auto text-destructive border-destructive/40 hover:bg-destructive/10",
											}) {
												Delete
											}
										</div>
									}
								</div>
							</div>
						</article>
					}
				</section>
			} else {
				<div class="rounded-md border border-border bg-card p-12 text-center">
					<p class="text-lg font-medium">No releases yet</p>
					if data.CanWrite {
						<p class="mt-1 text-sm text-muted-foreground">Create a release to package and distribute your software.</p>
					}
				</div>
			}
		</div>
	}
}
