package pages

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Releases(data view.ReleasesData) {
	@layout.Base(data.BasePage, "Releases · "+data.Owner+"/"+data.RepoName) {
		<div class="space-y-6">
			<div class="flex items-center justify-between">
				<div>
					<h1 class="text-2xl font-bold">
						<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="text-foreground hover:underline">{ data.Owner }/{ data.RepoName }</a>
						<span class="text-muted-foreground font-normal mx-1" aria-hidden="true">/</span>
						<span>Releases</span>
					</h1>
				</div>
				if data.CanWrite {
					@components.LinkButton("/"+data.Owner+"/"+data.RepoName+"/refs", components.ButtonSuccess, components.ButtonSizeDefault, nil) {
						+ New Release
					}
				}
			</div>
			if data.CanWrite {
				@components.Card(nil) {
					@components.CardHeader() {
						@components.CardTitle(2) {
							Create Release
						}
					}
					@components.CardContent() {
						<form hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/releases" } hx-target="body" class="space-y-4">
							<div class="grid grid-cols-2 gap-4">
								<div>
									<label for="release-tag-name" class="block text-sm font-medium text-foreground mb-1">Tag Name <span class="text-destructive" aria-hidden="true">*</span></label>
									@components.Input(templ.Attributes{
										"id":          "release-tag-name",
										"type":        "text",
										"name":        "tag_name",
										"required":    "required",
										"placeholder": "v1.0.0",
									})
								</div>
								<div>
									<label for="release-name" class="block text-sm font-medium text-foreground mb-1">Release Title</label>
									@components.Input(templ.Attributes{
										"id":          "release-name",
										"type":        "text",
										"name":        "name",
										"placeholder": "Release v1.0.0",
									})
								</div>
							</div>
							<div>
								<label for="release-body" class="block text-sm font-medium text-foreground mb-1">Description</label>
								@components.Textarea(templ.Attributes{
									"id":          "release-body",
									"name":        "body",
									"rows":        "6",
									"placeholder": "Describe this release...",
									"class":       "font-mono",
								})
							</div>
							<div class="flex items-center gap-6">
								<label class="flex items-center gap-2 text-sm text-foreground cursor-pointer">
									<input type="checkbox" name="is_prerelease" value="true" class="rounded"/>
									Pre-release
								</label>
								<label class="flex items-center gap-2 text-sm text-foreground cursor-pointer">
									<input type="checkbox" name="is_draft" value="true" class="rounded"/>
									Draft
								</label>
							</div>
							<div class="flex justify-end">
								@components.Button(components.ButtonSuccess, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
									Publish Release
								}
							</div>
						</form>
					}
				}
			}
			if len(data.Releases) > 0 {
				<div class="space-y-4">
					for _, release := range data.Releases {
						@components.Card(nil) {
							@components.CardContent() {
								<div class="flex items-start justify-between gap-4">
									<div class="flex-1 min-w-0">
										<div class="flex items-center gap-2 flex-wrap mb-1">
											<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/releases/tag/" + release.TagName) } class="text-xl font-semibold text-foreground hover:underline">
												if release.Name != "" {
													{ release.Name }
												} else {
													{ release.TagName }
												}
											</a>
											<code class="px-2 py-0.5 bg-muted text-foreground border border-border rounded text-sm font-mono">{ release.TagName }</code>
											if release.IsPrerelease {
												@components.Badge(components.BadgeWarning) {
													Pre-release
												}
											}
											if release.IsDraft {
												@components.Badge(components.BadgeDraft) {
													Draft
												}
											}
										</div>
										<p class="text-xs text-muted-foreground">
											if release.PublishedAt != nil {
												Published <time datetime={ release.PublishedAt.UTC().Format(time.RFC3339) }>{ release.PublishedAt.Format("Jan 2, 2006") }</time>
											} else {
												Not yet published
											}
										</p>
									</div>
									if data.CanWrite {
										<div class="flex items-center gap-2 shrink-0">
											@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{
												"hx-delete":  "/api/repos/" + data.Owner + "/" + data.RepoName + "/releases/" + strconv.FormatInt(release.ID, 10),
												"hx-confirm": "Delete this release?",
												"class":      "text-destructive border-destructive/40 hover:bg-destructive/10",
											}) {
												Delete
											}
										</div>
									}
								</div>
							}
						}
					}
				</div>
			} else {
				<div class="rounded-md border border-border bg-card p-12 text-center text-muted-foreground">
					<p class="text-lg font-medium">No releases yet</p>
					if data.CanWrite {
						<p class="text-sm mt-1">Create a release to package and distribute your software.</p>
					}
				</div>
			}
		</div>
	}
}
