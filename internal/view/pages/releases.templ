package pages

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Releases(data view.ReleasesData) {
	@layout.Base(data.BasePage, "Releases · "+data.Owner+"/"+data.RepoName) {
		<div class="space-y-6">

			<section class="flex flex-wrap items-start justify-between gap-4" aria-labelledby="rel-title">
				<div class="min-w-0">
					<h1 id="rel-title" class="text-2xl font-semibold tracking-tight">Releases</h1>
					<p class="mt-1 text-[13px] text-muted-foreground">Tag, package, and ship — releases are the cuttable points in your project's history.</p>
				</div>
				if data.CanWrite {
					@components.LinkButton("/"+data.Owner+"/"+data.RepoName+"/releases/new", components.ButtonSuccess, components.ButtonSizeDefault, nil) {
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" focusable="false">
							<path d="M12 5v14M5 12h14"></path>
						</svg>
						Draft release
					}
				}
			</section>

			if len(data.Releases) > 0 {
				<section class="space-y-4" aria-labelledby="rel-list">
					<h2 id="rel-list" class="sr-only">Releases</h2>
					for _, release := range data.Releases {
						<article class="rounded-md border border-border bg-card overflow-hidden relative hover:bg-muted/20 cursor-pointer transition-[padding-left] duration-150 hover:pl-1.5 before:content-[''] before:absolute before:left-0 before:top-2 before:bottom-2 before:w-[2px] before:bg-foreground before:rounded-sm before:opacity-0 hover:before:opacity-100 before:transition-opacity">
							<div class="grid sm:grid-cols-[180px_1fr] gap-0">
								<aside class="border-b sm:border-b-0 sm:border-r border-border p-5 bg-card">
									if release.PublishedAt != nil {
										<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider">Published</p>
										<p class="mt-1 text-[13px] text-muted-foreground">
											<time datetime={ release.PublishedAt.UTC().Format(time.RFC3339) }>{ release.PublishedAt.Format("Jan 2, 2006") }</time>
										</p>
									} else {
										<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider">Status</p>
										<p class="mt-1 text-[13px] text-muted-foreground">Not yet published</p>
									}
								</aside>
								<div class="p-5">
									<div class="flex flex-wrap items-center gap-2">
										<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/releases/tag/" + release.TagName) } class="relative z-10 text-lg font-semibold tracking-tight hover:underline">
											if release.Name != "" {
												{ release.Name }
											} else {
												{ release.TagName }
											}
										</a>
										<code class="font-mono px-2 py-0.5 bg-muted text-foreground border border-border rounded text-[12px]">{ release.TagName }</code>
										if release.IsLatest {
											@components.Badge(components.BadgeSuccess) {
												Latest
											}
										} else if release.IsPrerelease {
											@components.Badge(components.BadgeWarning) {
												Pre-release
											}
										} else if release.IsDraft {
											@components.Badge(components.BadgeDraft) {
												Draft
											}
										}
									</div>
									if release.Body != "" {
										<p class="mt-2 text-[13px] text-muted-foreground leading-relaxed">{ release.Body }</p>
									}
									<div class="mt-3 flex items-center gap-2 text-[12px]">
										<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/releases/tag/" + release.TagName) } class="relative z-10 h-7 px-2.5 border border-border rounded-md hover:bg-muted text-muted-foreground inline-flex items-center gap-1.5">Notes</a>
										if release.DiffURL != "" {
											<a href={ templ.SafeURL(release.DiffURL) } class="relative z-10 h-7 px-2.5 border border-border rounded-md hover:bg-muted text-muted-foreground inline-flex items-center gap-1.5">Diff</a>
										}
										if data.CanWrite {
											@components.Button(components.ButtonDestructiveOutline, components.ButtonSizeSM, templ.Attributes{
												"hx-delete":  "/api/repos/" + data.Owner + "/" + data.RepoName + "/releases/" + strconv.FormatInt(release.ID, 10),
												"hx-confirm": "Delete this release?",
												"class":      "relative z-10 ml-auto",
											}) {
												Delete
											}
										}
									</div>
								</div>
							</div>
						</article>
					}
				</section>
			} else {
				<div class="rounded-md border border-border bg-card p-12 text-center">
					<p class="text-lg font-medium">No releases yet</p>
					if data.CanWrite {
						<p class="mt-1 text-sm text-muted-foreground">Create a release to package and distribute your software.</p>
					}
				</div>
			}
		</div>
	}
}
