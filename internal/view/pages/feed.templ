package pages

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/model"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

func eventToActivityRow(e model.Event) components.ActivityRowData {
	kind := e.EventType
	switch kind {
	case model.EventReleasePublished:
		kind = "release"
	}
	return components.ActivityRowData{
		Kind:       kind,
		Actor:      e.ActorName,
		RepoName:   e.OwnerName + "/" + e.RepoName,
		Subject:    e.OwnerName + "/" + e.RepoName,
		SubjectURL: "/" + e.OwnerName + "/" + e.RepoName,
		When:       activityRelativeTime(e.CreatedAt),
	}
}

func activityRelativeTime(t time.Time) string {
	d := time.Since(t)
	switch {
	case d < time.Minute:
		return "just now"
	case d < time.Hour:
		m := int(d / time.Minute)
		if m == 1 {
			return "1 minute ago"
		}
		return strconv.Itoa(m) + " minutes ago"
	case d < 24*time.Hour:
		h := int(d / time.Hour)
		if h == 1 {
			return "1 hour ago"
		}
		return strconv.Itoa(h) + " hours ago"
	case d < 48*time.Hour:
		return "yesterday"
	case d < 7*24*time.Hour:
		return strconv.Itoa(int(d/(24*time.Hour))) + " days ago"
	default:
		return t.Format("Jan 2, 2006")
	}
}

func activityDateLabel(t time.Time) string {
	now := time.Now()
	y, m, d := t.Date()
	ny, nm, nd := now.Date()
	if y == ny && m == nm && d == nd {
		return "Today"
	}
	yest := now.AddDate(0, 0, -1)
	yy, ym, yd := yest.Date()
	if y == yy && m == ym && d == yd {
		return "Yesterday"
	}
	return t.Format("January 2, 2006")
}

func activityDateKey(t time.Time) string {
	return t.UTC().Format("2006-01-02")
}

templ Activity(data view.ActivityData) {
	@layout.Base(data.BasePage, "Activity") {
		<div class="max-w-3xl mx-auto">
			<section class="mb-6">
				<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">Cloudzilla · Activity</p>
				<h1 class="text-2xl font-semibold tracking-tight">Activity</h1>
				<p class="mt-1 text-[13px] text-muted-foreground">Events from the people and repositories you watch.</p>
			</section>
			if len(data.Events) == 0 {
				@components.EmptyStateWithHint("No activity yet.", "Watch some repositories to see events here.")
			} else {
				{{ seenDates := map[string]bool{} }}
				<ol>
					for _, e := range data.Events {
						{{ dk := activityDateKey(e.CreatedAt) }}
						if !seenDates[dk] {
							{{ seenDates[dk] = true }}
							<li class="mt-6 mb-2">
								<h2 class="text-sm font-medium text-muted-foreground">{ activityDateLabel(e.CreatedAt) }</h2>
							</li>
						}
						@components.ActivityRow(eventToActivityRow(e))
					}
				</ol>
				{{ prevURL := "" }}
				if data.Page > 1 {
					{{ prevURL = "/activity?page=" + strconv.Itoa(data.Page-1) }}
				}
				{{ nextURL := "" }}
				if data.HasMore {
					{{ nextURL = "/activity?page=" + strconv.Itoa(data.Page+1) }}
				}
				<div class="mt-6">
					@components.Pagination(prevURL, nextURL)
				</div>
			}
		</div>
	}
}
