package pages

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

// feedEventVerb returns the action phrase that follows the actor name for a given event type.
func feedEventVerb(eventType string) string {
	switch eventType {
	case "push":
		return "pushed to"
	case "issue_opened":
		return "opened an issue in"
	case "issue_closed":
		return "closed an issue in"
	case "pr_opened":
		return "opened a pull request in"
	case "pr_merged":
		return "merged a pull request in"
	case "pr_closed":
		return "closed a pull request in"
	case "fork":
		return "forked"
	case "star":
		return "starred"
	case "release_published":
		return "published a release in"
	case "member_added":
		return "added a member to"
	default:
		return ""
	}
}

templ Feed(data view.FeedData) {
	@layout.Base(data.BasePage, "Activity Feed") {
		<div class="max-w-3xl mx-auto space-y-6">

			<section aria-labelledby="feed-title">
				<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">Cloudzilla · Feed</p>
				<h1 id="feed-title" class="text-2xl font-semibold tracking-tight">Activity</h1>
				<p class="mt-1 text-[13px] text-muted-foreground">Events from the people and repositories you watch.</p>
			</section>

			if len(data.Events) == 0 {
				@components.EmptyStateWithHint("No activity yet.", "Watch some repositories to see events here.")
			} else {
				<section class="rounded-md border border-border bg-card overflow-hidden" aria-labelledby="feed-list">
					<h2 id="feed-list" class="sr-only">Feed events</h2>
					<ol class="divide-y divide-border">
						for _, e := range data.Events {
							<li class="px-4 py-3 hover:bg-muted/50 flex items-start gap-3">
								@components.Avatar(e.ActorName, components.AvatarSizeDefault, "")
								<div class="min-w-0 flex-1">
									<div class="text-[13px]">
										<a href={ templ.SafeURL("/" + e.ActorName) } class="font-medium hover:underline">{ e.ActorName }</a>
										{{ verb := feedEventVerb(e.EventType) }}
										if verb != "" {
											<span class="text-muted-foreground">&nbsp;{ verb }&nbsp;</span>
										} else {
											<span class="text-muted-foreground">&nbsp;performed&nbsp;</span>
											<span class="font-mono text-[11px] bg-muted px-1.5 py-0.5 rounded border border-border">{ e.EventType }</span>
											<span class="text-muted-foreground">&nbsp;in&nbsp;</span>
										}
										<a href={ templ.SafeURL("/" + e.OwnerName + "/" + e.RepoName) } class="font-medium hover:underline">{ e.OwnerName }/{ e.RepoName }</a>
									</div>
									<p class="mt-0.5 font-mono text-[11px] text-muted-foreground">
										<time datetime={ e.CreatedAt.UTC().Format(time.RFC3339) }>{ e.CreatedAt.Format("Jan 2, 2006 at 15:04") }</time>
									</p>
								</div>
							</li>
						}
					</ol>
				</section>

				{{ prevURL := "" }}
				if data.Page > 1 {
					{{ prevURL = "/feed?page=" + strconv.Itoa(data.Page-1) }}
				}
				{{ nextURL := "" }}
				if data.HasNextPage {
					{{ nextURL = "/feed?page=" + strconv.Itoa(data.Page+1) }}
				}
				@components.Pagination(prevURL, nextURL)
			}
		</div>
	}
}
