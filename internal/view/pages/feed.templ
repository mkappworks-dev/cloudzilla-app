package pages

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Feed(data view.FeedData) {
	@layout.Base(data.BasePage, "Activity Feed") {
		<div class="max-w-3xl mx-auto space-y-4">
			<h1 class="text-2xl font-bold text-foreground">Your Activity Feed</h1>
			if len(data.Events) == 0 {
				@components.EmptyStateWithHint("No activity yet.", "Watch some repositories to see events here.")
			} else {
				<div class="space-y-3">
					for _, e := range data.Events {
						<div class="rounded-md border border-border bg-card px-5 py-4 flex items-start gap-4">
							<div class="flex-1 min-w-0">
								<div class="text-sm text-foreground">
									<a href={ templ.SafeURL("/" + e.ActorName) } class="text-foreground hover:underline font-medium">{ e.ActorName }</a>
									if e.EventType == "push" {
										pushed to <a href={ templ.SafeURL("/" + e.OwnerName + "/" + e.RepoName) } class="text-foreground hover:underline font-medium">{ e.OwnerName }/{ e.RepoName }</a>
									} else if e.EventType == "issue_opened" {
										opened an issue in <a href={ templ.SafeURL("/" + e.OwnerName + "/" + e.RepoName + "/issues") } class="text-foreground hover:underline font-medium">{ e.OwnerName }/{ e.RepoName }</a>
									} else if e.EventType == "issue_closed" {
										closed an issue in <a href={ templ.SafeURL("/" + e.OwnerName + "/" + e.RepoName + "/issues") } class="text-foreground hover:underline font-medium">{ e.OwnerName }/{ e.RepoName }</a>
									} else if e.EventType == "pr_opened" {
										opened a pull request in <a href={ templ.SafeURL("/" + e.OwnerName + "/" + e.RepoName + "/pulls") } class="text-foreground hover:underline font-medium">{ e.OwnerName }/{ e.RepoName }</a>
									} else if e.EventType == "pr_merged" {
										merged a pull request in <a href={ templ.SafeURL("/" + e.OwnerName + "/" + e.RepoName + "/pulls") } class="text-foreground hover:underline font-medium">{ e.OwnerName }/{ e.RepoName }</a>
									} else if e.EventType == "pr_closed" {
										closed a pull request in <a href={ templ.SafeURL("/" + e.OwnerName + "/" + e.RepoName + "/pulls") } class="text-foreground hover:underline font-medium">{ e.OwnerName }/{ e.RepoName }</a>
									} else if e.EventType == "fork" {
										forked <a href={ templ.SafeURL("/" + e.OwnerName + "/" + e.RepoName) } class="text-foreground hover:underline font-medium">{ e.OwnerName }/{ e.RepoName }</a>
									} else if e.EventType == "star" {
										starred <a href={ templ.SafeURL("/" + e.OwnerName + "/" + e.RepoName) } class="text-foreground hover:underline font-medium">{ e.OwnerName }/{ e.RepoName }</a>
									} else if e.EventType == "release_published" {
										published a release in <a href={ templ.SafeURL("/" + e.OwnerName + "/" + e.RepoName + "/releases") } class="text-foreground hover:underline font-medium">{ e.OwnerName }/{ e.RepoName }</a>
									} else if e.EventType == "member_added" {
										added a member to <a href={ templ.SafeURL("/" + e.OwnerName + "/" + e.RepoName) } class="text-foreground hover:underline font-medium">{ e.OwnerName }/{ e.RepoName }</a>
									} else {
										performed action <span class="font-mono text-xs bg-muted px-1 rounded">{ e.EventType }</span> in <a href={ templ.SafeURL("/" + e.OwnerName + "/" + e.RepoName) } class="text-foreground hover:underline font-medium">{ e.OwnerName }/{ e.RepoName }</a>
									}
								</div>
								<div class="text-xs text-muted-foreground mt-1">
									<time datetime={ e.CreatedAt.UTC().Format(time.RFC3339) }>{ e.CreatedAt.Format("Jan 2, 2006 at 15:04") }</time>
								</div>
							</div>
						</div>
					}
				</div>
				{{ prevURL := "" }}
				if data.Page > 1 {
					{{ prevURL = "/feed?page=" + strconv.Itoa(data.Page-1) }}
				}
				{{ nextURL := "" }}
				if data.HasNextPage {
					{{ nextURL = "/feed?page=" + strconv.Itoa(data.Page+1) }}
				}
				@components.Pagination(prevURL, nextURL)
			}
		</div>
	}
}
