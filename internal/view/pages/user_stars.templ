package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ UserStars(data view.UserStarsData) {
	@layout.Base(data.BasePage, "Stars · "+data.ProfileUser.Username) {
		<div class="space-y-6">
			<div class="flex items-center gap-4">
				<h1 class="text-2xl font-bold">
					<a href={ templ.SafeURL("/" + data.ProfileUser.Username) } class="text-foreground hover:underline">{ data.ProfileUser.Username }</a>
				</h1>
				<span class="text-muted-foreground">Starred repositories</span>
			</div>
			if len(data.Repos) > 0 {
				<div class="space-y-3">
					for _, repo := range data.Repos {
						<a href={ templ.SafeURL("/" + repo.OwnerName + "/" + repo.Name) } class="block rounded-md border border-border bg-card p-4 hover:border-foreground/30 hover:shadow-md transition-all">
							<h3 class="text-lg font-semibold text-foreground">
								<span class="text-muted-foreground">{ repo.OwnerName }</span>/{ repo.Name }
							</h3>
							if repo.Description != "" {
								<p class="text-muted-foreground mt-1 text-sm">{ repo.Description }</p>
							}
							<div class="mt-2 text-xs text-muted-foreground">
								if repo.Private {
									Private
								} else {
									Public
								}
							</div>
						</a>
					}
				</div>
			} else {
				@components.EmptyState(data.ProfileUser.Username + " hasn't starred any repositories yet.")
			}
		</div>
	}
}
