package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ UserStars(data view.UserStarsData) {
	@layout.Base(data.BasePage, "Stars · "+data.ProfileUser.Username) {
		<div class="max-w-4xl mx-auto space-y-6">

			<section aria-labelledby="us-title">
				<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">
					<a href={ templ.SafeURL("/" + data.ProfileUser.Username) } class="hover:underline">{ data.ProfileUser.Username }</a>
					<span aria-hidden="true">·</span>
					Stars
				</p>
				<h1 id="us-title" class="text-2xl font-semibold tracking-tight">Starred repositories</h1>
				<p class="mt-1 text-[13px] text-muted-foreground">Repos { data.ProfileUser.Username } has bookmarked.</p>
			</section>

			if len(data.Repos) > 0 {
				<section class="rounded-md border border-border bg-card overflow-hidden" aria-labelledby="us-list">
					<h2 id="us-list" class="sr-only">Starred repositories</h2>
					<ol class="divide-y divide-border">
						for _, repo := range data.Repos {
							<li>
								<a href={ templ.SafeURL("/" + repo.OwnerName + "/" + repo.Name) } class="block px-4 py-4 hover:bg-muted/50">
									<div class="flex items-center gap-2 flex-wrap">
										<span class="text-[14px] font-medium hover:underline">
											<span class="text-muted-foreground">{ repo.OwnerName }/</span>{ repo.Name }
										</span>
										if repo.Private {
											@components.Badge(components.BadgeWarning) {
												Private
											}
										}
									</div>
									if repo.Description != "" {
										<p class="mt-1 text-[13px] text-muted-foreground">{ repo.Description }</p>
									}
								</a>
							</li>
						}
					</ol>
				</section>
			} else {
				@components.EmptyState(data.ProfileUser.Username + " hasn't starred any repositories yet.")
			}
		</div>
	}
}
