package pages

import (
	"github.com/mkappworks/cloudzilla/internal/view"
	"github.com/mkappworks/cloudzilla/internal/view/components"
	"github.com/mkappworks/cloudzilla/internal/view/layout"
)

templ UserStars(data view.UserStarsData) {
	@layout.Base(data.BasePage, "Stars · "+data.ProfileUser.Username) {
		<div class="space-y-6">
			<div class="flex items-center gap-4">
				<h1 class="text-2xl font-bold">
					<a href={ templ.SafeURL("/" + data.ProfileUser.Username) } class="text-blue-600 hover:underline">{ data.ProfileUser.Username }</a>
				</h1>
				<span class="text-gray-500">Starred repositories</span>
			</div>
			if len(data.Repos) > 0 {
				<div class="space-y-3">
					for _, repo := range data.Repos {
						<a href={ templ.SafeURL("/" + repo.OwnerName + "/" + repo.Name) } class="block bg-white border border-gray-200 rounded-lg p-4 hover:border-blue-300 hover:shadow-md transition-all">
							<h3 class="text-lg font-semibold text-blue-600">
								<span class="text-gray-700">{ repo.OwnerName }</span>/{ repo.Name }
							</h3>
							if repo.Description != "" {
								<p class="text-gray-600 mt-1 text-sm">{ repo.Description }</p>
							}
							<div class="mt-2 text-xs text-gray-500">
								if repo.Private {
									Private
								} else {
									Public
								}
							</div>
						</a>
					}
				</div>
			} else {
				@components.EmptyState("{ data.ProfileUser.Username } hasn&#39;t starred any repositories yet.")
			}
		</div>
	}
}
