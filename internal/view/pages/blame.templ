package pages

import (
	"strconv"

	"github.com/mkappworks/cloudzilla/internal/view"
	"github.com/mkappworks/cloudzilla/internal/view/layout"
)

templ Blame(data view.BlameData) {
	@layout.Base(data.BasePage, "blame · "+data.Path+" · "+data.Owner+"/"+data.RepoName) {
		<div class="space-y-4">
			<div class="bg-white border border-gray-200 rounded-lg p-4">
				<div class="flex items-center justify-between flex-wrap gap-2">
					<div class="flex items-center text-sm text-gray-600 flex-wrap gap-1">
						for i, b := range data.Breadcrumbs {
							if i > 0 {
								<span class="text-gray-400">/</span>
							}
							<a href={ templ.SafeURL(b.URL) } class="hover:text-blue-600 hover:underline font-medium">{ b.Name }</a>
						}
						<span class="ml-2 px-2 py-0.5 bg-blue-100 text-blue-700 rounded text-xs font-mono">{ data.Ref }</span>
					</div>
					<a href={ templ.SafeURL(data.BlobURL) } class="text-sm text-blue-600 hover:underline">View File</a>
				</div>
			</div>
			<div class="overflow-x-auto rounded-lg border border-gray-200">
				<table class="w-full text-sm font-mono">
					<tbody class="divide-y divide-gray-100">
						for _, line := range data.Lines {
							<tr class="hover:bg-gray-50">
								<td class="w-56 px-3 py-1 align-top text-xs bg-white border-r border-gray-200">
									if line.ShowMeta {
										<div class="text-gray-700 font-mono font-medium">{ line.Hash }</div>
										<div class="text-gray-500 truncate max-w-xs">{ line.Author }</div>
										<div class="text-gray-400">{ line.AuthorTime.Format("2006-01-02") }</div>
									} else {
										<div class="text-gray-200 select-none">·</div>
									}
								</td>
								<td class="select-none text-gray-400 pr-3 pl-3 py-1 text-right w-12 align-top border-r border-gray-200 bg-gray-50">
									<a id={ "L"+strconv.Itoa(line.LineNum) } href={ templ.SafeURL("#L"+strconv.Itoa(line.LineNum)) } class="hover:text-blue-600">{ strconv.Itoa(line.LineNum) }</a>
								</td>
								<td class="pl-4 pr-4 py-1 whitespace-pre text-gray-800">{ line.Text }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}
