package pages

import (
	"encoding/json"
	"regexp"
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/assets"
	"github.com/mkappworks-dev/cloudzilla-app/internal/model"
	"github.com/mkappworks-dev/cloudzilla-app/internal/service"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

type cardEditorLabel struct {
	ID    int64  `json:"id"`
	Name  string `json:"name"`
	Color string `json:"color"`
}

type cardEditorState struct {
	ID          int64             `json:"id"`
	Column      string            `json:"column"`
	Title       string            `json:"title"`
	Description string            `json:"description"`
	DueDate     string            `json:"due_date"`
	Assignees   []model.CardUser  `json:"assignees"`
	Labels      []cardEditorLabel `json:"labels"`
	LinkKind    string            `json:"link_kind"`
	LinkID      int64             `json:"link_id"`
	LinkNumber  int               `json:"link_number"`
	LinkTitle   string            `json:"link_title"`
	LinkState   string            `json:"link_state"`
}

// cardEditorJSON is the card's editable state, read by kanban.js when the card dialog opens.
func cardEditorJSON(card service.KanbanCardView, column string) string {
	s := cardEditorState{
		ID:          card.ID,
		Column:      column,
		Title:       card.Title,
		Description: card.Description,
		DueDate:     card.DueDate,
		Assignees:   []model.CardUser{},
		Labels:      []cardEditorLabel{},
		LinkKind:    card.LinkKind,
		LinkID:      card.LinkID,
		LinkNumber:  card.LinkNumber,
		LinkTitle:   card.LinkTitle,
		LinkState:   card.LinkState,
	}
	s.Assignees = append(s.Assignees, card.Assignees...)
	for _, l := range card.Labels {
		color := ""
		if hexColor.MatchString(l.Color) {
			color = l.Color
		}
		s.Labels = append(s.Labels, cardEditorLabel{ID: l.ID, Name: l.Name, Color: color})
	}
	b, err := json.Marshal(s)
	if err != nil {
		return "{}"
	}
	return string(b)
}

// opensEditor: a card without its own title is a plain link to an issue or PR and navigates there.
func opensEditor(card service.KanbanCardView) bool {
	return card.Kind == "note"
}

var hexColor = regexp.MustCompile(`^#[0-9a-fA-F]{6}$`)

// labelChipStyle fills the chip with the label colour and picks dark or light text by luminance.
func labelChipStyle(color string) string {
	if !hexColor.MatchString(color) {
		return ""
	}
	r, _ := strconv.ParseUint(color[1:3], 16, 8)
	g, _ := strconv.ParseUint(color[3:5], 16, 8)
	b, _ := strconv.ParseUint(color[5:7], 16, 8)
	fg := "#ffffff"
	if (0.299*float64(r)+0.587*float64(g)+0.114*float64(b))/255 > 0.6 {
		fg = "#1f2328"
	}
	return "background-color: " + color + "; color: " + fg
}

func cardDueLabel(due string) string {
	t, err := time.Parse("2006-01-02", due)
	if err != nil {
		return due
	}
	return t.Format("Jan 2, 2006")
}

templ ProjectDetail(data view.ProjectDetailData) {
	@layout.Base(data.BasePage, data.Project.Name+" · "+data.Owner+"/"+data.RepoName) {
		<div
			class="space-y-6 pt-2"
			data-owner={ data.Owner }
			data-repo-name={ data.RepoName }
			data-project-id={ strconv.FormatInt(data.Project.ID, 10) }
			data-can-write={ strconv.FormatBool(data.CanWrite) }
			x-data="kanbanBoard"
			@dragstart="onDragStart($event)"
			@dragover="onDragOver($event)"
			@drop="onDrop($event)"
			@click="onCardClick($event)"
			@keydown="onCardKey($event)"
		>
			@cardDialog(data)
			if data.CanWrite {
				@addColumnDialog()
			}
			<section class="flex flex-wrap items-start justify-between gap-4" aria-labelledby="project-title">
				<div class="min-w-0">
					<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">
						<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="hover:underline">{ data.RepoName }</a>
						<span aria-hidden="true">·</span>
						<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/projects") } class="hover:underline">Projects</a>
						<span aria-hidden="true">·</span>
						{ data.Project.Name }
					</p>
					<div class="flex items-center gap-2">
						<h1 id="project-title" class="text-2xl font-semibold tracking-tight">{ data.Project.Name }</h1>
						if data.Project.ClosedAt != nil {
							@components.Badge(components.BadgeDraft) {
								Closed
							}
						}
					</div>
					if data.Project.Description != "" {
						<p class="mt-1 text-[13px] text-muted-foreground max-w-2xl">{ data.Project.Description }</p>
					}
				</div>
				if data.CanWrite {
					<button
						type="button"
						class="inline-flex items-center justify-center gap-1.5 rounded-md font-medium transition-colors border border-input bg-transparent hover:bg-accent hover:text-accent-foreground h-9 px-4 text-sm"
						onclick={ setProjectClosedJS(data.Owner, data.RepoName, data.Project.ID, data.Project.ClosedAt == nil) }
					>
						if data.Project.ClosedAt != nil {
							Reopen
						} else {
							Close project
						}
					</button>
				}
			</section>
			<div class="flex items-start gap-4 overflow-x-auto pb-6">
				for _, col := range data.Columns {
					<section
						class="flex-none w-72 rounded-md border border-border bg-muted/30"
						data-column-id={ strconv.FormatInt(col.ID, 10) }
						data-drop="kanban-column"
						aria-labelledby={ "col-" + strconv.FormatInt(col.ID, 10) }
					>
						<header class="px-3 py-2.5 flex items-center justify-between gap-2">
							<h2 id={ "col-" + strconv.FormatInt(col.ID, 10) } class="flex items-center gap-2 min-w-0 text-[13px] font-semibold">
								<span class="truncate">{ col.Name }</span>
								<span class="shrink-0 rounded-full bg-muted px-1.5 font-mono text-[11px] font-normal text-muted-foreground">{ strconv.Itoa(len(col.Cards)) }</span>
							</h2>
							if data.CanWrite {
								<div class="relative" x-data="{ open: false }" @click.outside="open = false" @keydown.escape="open = false">
									<button
										type="button"
										aria-label={ "Actions for column " + col.Name }
										aria-haspopup="menu"
										x-bind:aria-expanded="open.toString()"
										@click="open = !open"
										class="rounded px-1.5 text-muted-foreground hover:bg-muted hover:text-foreground"
									>⋯</button>
									<div x-show="open" x-cloak role="menu" class="absolute right-0 top-full z-20 mt-1 w-40 rounded-md border border-border bg-popover p-1 shadow-md">
										<button
											type="button"
											role="menuitem"
											onclick={ deleteColumnJS(data.Owner, data.RepoName, data.Project.ID, col.ID) }
											class="w-full rounded px-2 py-1.5 text-left text-[13px] text-destructive hover:bg-muted"
										>Delete column</button>
									</div>
								</div>
							}
						</header>
						<ul class="space-y-2 px-2 pb-2 min-h-2" data-cards>
							for _, card := range col.Cards {
								@kanbanCard(data, card, col.Name)
							}
						</ul>
						if data.CanWrite {
							<div class="px-2 pb-2">
								<button
									type="button"
									data-add-card={ strconv.FormatInt(col.ID, 10) }
									data-column-name={ col.Name }
									@click="openCreate($el)"
									class="w-full rounded-md px-2 py-1.5 text-left text-[13px] text-muted-foreground hover:bg-muted hover:text-foreground"
								>+ Add item</button>
							</div>
						}
					</section>
				}
				if data.CanWrite {
					<div class="flex-none w-72">
						<button
							type="button"
							onclick="document.getElementById('add-column-dialog').showModal()"
							class="flex h-11 w-full items-center justify-center rounded-md border border-dashed border-border text-[13px] text-muted-foreground hover:border-ring hover:text-foreground"
						>+ Add column</button>
					</div>
				}
			</div>
		</div>
		<script src={ assets.URL("/static/datepicker.js") } defer></script>
		<script src={ assets.URL("/static/kanban.js") } defer></script>
	}
}

templ addColumnDialog() {
	@components.Dialog("add-column-dialog") {
		<form x-data="columnDialog" @submit.prevent="submit()">
			@components.DialogHeader() {
				@components.DialogTitle("add-column-dialog") {
					Add column
				}
				@components.DialogDescription() {
					Columns group the cards on this board.
				}
			}
			@components.DialogBody() {
				<div class="space-y-3">
					<div>
						<label for="add-column-name" class="block text-[12px] font-medium text-foreground mb-1">Name</label>
						@components.Input(templ.Attributes{
							"id":           "add-column-name",
							"type":         "text",
							"x-model":      "name",
							"required":     "required",
							"autofocus":    "autofocus",
							"autocomplete": "off",
							"placeholder":  "To do",
						})
					</div>
					<p x-show="error" x-cloak x-text="error" class="text-[12px] text-destructive" role="alert"></p>
				</div>
			}
			@components.DialogFooter() {
				@components.Button(components.ButtonOutline, components.ButtonSizeDefault, templ.Attributes{
					"type":    "button",
					"onclick": "this.closest('dialog').close()",
				}) {
					Cancel
				}
				@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit", "x-bind:disabled": "busy || blank"}) {
					Add column
				}
			}
		</form>
	}
}

templ kanbanCard(data view.ProjectDetailData, card service.KanbanCardView, column string) {
	<li
		class="group relative rounded-md border border-border bg-card p-3 shadow-xs hover:border-ring/60 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring"
		data-card-id={ strconv.FormatInt(card.ID, 10) }
		data-card-kind={ card.Kind }
		data-drag="kanban-card"
		if data.CanWrite {
			draggable="true"
		}
		if opensEditor(card) {
			data-card-open
			data-card-json={ cardEditorJSON(card, column) }
			tabindex="0"
			role="button"
			aria-label={ "Open card: " + card.Title }
		}
	>
		if opensEditor(card) && card.DescriptionHTML != "" {
			<template id={ "desc-" + strconv.FormatInt(card.ID, 10) }>
				@templ.Raw(card.DescriptionHTML)
			</template>
		}
		if opensEditor(card) {
			<p class="text-[13px] font-medium line-clamp-3 break-words">{ card.Title }</p>
		} else if card.Kind == "hidden" {
			<p class="text-[13px] italic text-muted-foreground">Private issue</p>
			<p class="mt-1.5 font-mono text-[11px] text-muted-foreground">Hidden</p>
		} else {
			<div class="flex items-start gap-2">
				@linkKindIcon(card.LinkKind)
				<a
					href={ templ.SafeURL(linkedItemURL(data, card)) }
					draggable="false"
					class="min-w-0 text-[13px] font-medium after:absolute after:inset-0 after:rounded-md focus-visible:outline-hidden focus-visible:after:ring-2 focus-visible:after:ring-ring"
				>{ card.Title }</a>
			</div>
		}
		if card.Description != "" {
			<p class="mt-1 text-[12px] text-muted-foreground line-clamp-1 break-all">{ card.Description }</p>
		}
		if len(card.Labels) > 0 {
			<div class="mt-2 flex flex-wrap gap-1">
				for _, l := range card.Labels {
					<span class="inline-flex max-w-full items-center truncate rounded-full bg-muted px-2 py-0.5 text-[11px] font-medium" style={ labelChipStyle(l.Color) } data-card-label>{ l.Name }</span>
				}
			</div>
		}
		if card.LinkKind != "" {
			<div class="mt-2 flex items-center gap-2" data-card-link>
				if opensEditor(card) {
					@linkKindIcon(card.LinkKind)
				}
				<span class="font-mono text-[11px] text-muted-foreground">#{ strconv.Itoa(card.LinkNumber) }</span>
				if card.LinkKind == "pull" {
					@components.PullStateBadge(model.PRState(card.LinkState), false)
				} else {
					@components.IssueStateBadge(card.LinkState)
				}
			</div>
		}
		if card.DueDate != "" || len(card.Assignees) > 0 {
			<div class="mt-2 flex items-center justify-between gap-2">
				if card.DueDate != "" {
					<span class={ "inline-flex items-center gap-1 text-[11px]", templ.KV("text-destructive font-medium", card.Overdue), templ.KV("text-muted-foreground", !card.Overdue) } data-card-due>
						<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
							<rect x="3" y="5" width="18" height="16" rx="2"></rect>
							<path d="M3 10h18M8 3v4M16 3v4"></path>
						</svg>
						<time datetime={ card.DueDate }>{ cardDueLabel(card.DueDate) }</time>
						if card.Overdue {
							<span class="sr-only">(overdue)</span>
						}
					</span>
				} else {
					<span></span>
				}
				if len(card.Assignees) > 0 {
					<div class="flex -space-x-1.5" data-card-assignees>
						for _, a := range card.Assignees {
							<span class="rounded-full ring-2 ring-card" title={ a.Username }>
								@components.Avatar(a.Username, components.AvatarSizeXS, a.Username)
							</span>
						}
					</div>
				}
			</div>
		}
		if data.CanWrite && !opensEditor(card) {
			<button
				type="button"
				aria-label="Remove from board"
				onclick={ deleteCardJS(data.Owner, data.RepoName, data.Project.ID, card.ID) }
				class="absolute right-1.5 top-1.5 z-10 rounded px-1 text-xs text-muted-foreground opacity-0 hover:bg-muted hover:text-destructive focus:opacity-100 group-hover:opacity-100"
			>✕</button>
		}
	</li>
}

func linkedItemURL(data view.ProjectDetailData, card service.KanbanCardView) string {
	kind := "issues"
	if card.LinkKind == "pull" {
		kind = "pulls"
	}
	return "/" + data.Owner + "/" + data.RepoName + "/" + kind + "/" + strconv.Itoa(card.LinkNumber)
}

templ linkKindIcon(kind string) {
	if kind == "pull" {
		<svg class="mt-0.5 shrink-0 text-muted-foreground" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
			<circle cx="6" cy="6" r="2.5"></circle>
			<circle cx="6" cy="18" r="2.5"></circle>
			<circle cx="18" cy="18" r="2.5"></circle>
			<path d="M6 8.5v7M18 15.5V10a3 3 0 0 0-3-3h-3"></path>
		</svg>
	} else {
		<svg class="mt-0.5 shrink-0 text-muted-foreground" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
			<circle cx="12" cy="12" r="9"></circle>
			<circle cx="12" cy="12" r="1" fill="currentColor"></circle>
		</svg>
	}
}

// targetResults is the picker dropdown; it is position:fixed because the dialog body's
// overflow-y-auto would clip an absolutely positioned list.
templ targetResults() {
	<div
		x-show="showList"
		x-cloak
		x-bind:style="listStyle"
		class="z-50 max-h-72 overflow-y-auto rounded-md border border-border bg-popover p-1 text-popover-foreground shadow-md"
		data-picker-list
	>
		<p x-show="pending && !results.length" class="px-2 py-1.5 text-[12px] text-muted-foreground">Searching…</p>
		<p x-show="error" x-text="error" class="px-2 py-1.5 text-[12px] text-destructive" role="alert"></p>
		<p x-show="searched && !pending && !error && !results.length" class="px-2 py-1.5 text-[12px] text-muted-foreground">No matching issues or pull requests</p>
		<ul role="listbox" aria-label="Issues and pull requests" class="flex flex-col">
			<template x-for="(t, i) in results" x-bind:key="t.kind + t.id">
				<li role="option" x-bind:aria-selected="(i === active).toString()">
					<button
						type="button"
						tabindex="-1"
						@mousedown.prevent="pick(t)"
						x-bind:class="i === active ? 'bg-muted' : ''"
						class="flex w-full items-baseline gap-2 rounded px-2 py-1.5 text-left text-[13px] hover:bg-muted"
					>
						<span class="shrink-0 font-mono text-[11px] text-muted-foreground" x-text="(t.kind === 'pull' ? 'PR #' : '#') + t.number"></span>
						<span class="min-w-0 flex-1 truncate" x-text="t.title"></span>
						<span class="shrink-0 text-[11px] text-muted-foreground" x-text="t.state"></span>
					</button>
				</li>
			</template>
		</ul>
	</div>
}

// cardDialog creates a card in a column or edits a note card; read-only viewers get the edit
// view with every field disabled.
templ cardDialog(data view.ProjectDetailData) {
	<dialog
		id="card-dialog"
		x-ref="cardDialog"
		class="rounded-lg border border-border bg-popover text-popover-foreground p-0 m-auto w-[960px] max-w-[calc(100vw-2rem)] backdrop:bg-black/60 backdrop:backdrop-blur-xs"
		aria-labelledby="card-dialog-title"
		@close="onDialogClosed()"
		if data.CanWrite {
			@keydown.escape="onEscape($event)"
			@cancel="onEscape($event)"
		}
		@card-link-picked="pickLink($event.detail)"
	>
		<form class="flex max-h-[calc(100dvh-4rem)] flex-col" @submit.prevent="submit()">
			@components.DialogHeader() {
				@components.DialogTitle("card-dialog") {
					<span x-text="heading"></span>
				}
			}
			<div class="min-h-0 flex-1 overflow-y-auto p-5 text-sm">
				<div class="flex flex-col gap-5">
					<div>
						<label for="card-title-input" class="mb-1 block text-[12px] font-medium text-muted-foreground">Title</label>
						<input
							id="card-title-input"
							type="text"
							x-ref="cardTitle"
							x-model="editor.title"
							maxlength="256"
							autocomplete="off"
							disabled?={ !data.CanWrite }
							class="h-9 w-full rounded-md border border-input bg-card px-2.5 text-[13px] focus:outline-hidden focus:ring-2 focus:ring-ring disabled:opacity-70"
						/>
						if data.CanWrite {
							<p x-show="editor.mode === 'create'" x-text="titleHint" class="mt-1 text-[11px] text-muted-foreground"></p>
						}
					</div>
					<div class="grid gap-5 md:grid-cols-[minmax(0,1fr)_13rem]">
						<div class="flex min-w-0 flex-col gap-5">
							<div>
								<div class="mb-1 flex items-center justify-between gap-2">
									<span id="card-desc-label" class="text-[12px] font-medium text-muted-foreground">Description</span>
									if data.CanWrite {
										<div class="flex items-center gap-0.5 rounded-md bg-muted p-0.5 text-[12px]">
											<button
												type="button"
												@click="editor.tab = 'write'"
												x-bind:aria-pressed="(editor.tab === 'write').toString()"
												x-bind:class="editor.tab === 'write' ? 'bg-background shadow-xs text-foreground' : 'text-muted-foreground'"
												class="rounded px-2 py-0.5"
											>Write</button>
											<button
												type="button"
												@click="editor.tab = 'preview'"
												x-bind:aria-pressed="(editor.tab === 'preview').toString()"
												x-bind:class="editor.tab === 'preview' ? 'bg-background shadow-xs text-foreground' : 'text-muted-foreground'"
												class="rounded px-2 py-0.5"
											>Preview</button>
										</div>
									}
								</div>
								if data.CanWrite {
									<textarea
										x-show="editor.tab === 'write'"
										x-model="editor.description"
										@input="editor.descDirty = true"
										rows="14"
										aria-labelledby="card-desc-label"
										placeholder="Markdown supported. Reference #123 to link an issue or pull request."
										class="block w-full resize-y rounded-md border border-input bg-card px-2.5 py-2 text-[13px] placeholder:text-muted-foreground focus:outline-hidden focus:ring-2 focus:ring-ring"
									></textarea>
								}
								<div x-show="editor.tab === 'preview'" class="flex min-h-24 flex-col gap-2 rounded-md border border-border bg-card px-3 py-2" aria-labelledby="card-desc-label" role="region">
									if data.CanWrite {
										<p x-show="editor.mode === 'create'" class="text-[12px] text-muted-foreground">Nothing saved to preview yet: the description is rendered once the card is created.</p>
										<p x-show="editor.mode === 'edit' && editor.descDirty" class="text-[11px] text-muted-foreground">Save to refresh the preview</p>
									}
									<div x-show="editor.mode === 'edit' && editor.previewHTML" x-html="editor.previewHTML" class="prose prose-sm dark:prose-invert max-w-none break-words" data-card-preview></div>
									<p x-show="editor.mode === 'edit' && !editor.previewHTML" class="text-[12px] text-muted-foreground">No description</p>
								</div>
							</div>
							<div>
								<span class="mb-1 block text-[12px] font-medium text-muted-foreground">Linked item</span>
								<div x-show="editor.link" class="flex items-center gap-2 rounded-md border border-border bg-card px-2.5 py-1.5 text-[13px]" data-card-link-chip>
									<a
										x-ref="linkAnchor"
										x-bind:href="linkURL"
										class="flex min-w-0 flex-1 items-baseline gap-2 rounded hover:underline focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring"
									>
										<span class="shrink-0 font-mono text-[11px] text-muted-foreground" x-text="editor.link ? (editor.link.kind === 'pull' ? 'PR #' : '#') + editor.link.number : ''"></span>
										<span class="min-w-0 flex-1 truncate" x-text="editor.link ? editor.link.title : ''"></span>
										<span class="shrink-0 text-[11px] text-muted-foreground" x-text="editor.link ? editor.link.state : ''"></span>
									</a>
									if data.CanWrite {
										<button
											type="button"
											x-ref="linkClear"
											aria-label="Remove link"
											@click="clearLink()"
											class="rounded px-1 text-xs text-muted-foreground hover:bg-muted hover:text-destructive"
										>✕</button>
									}
								</div>
								if data.CanWrite {
									<div x-show="!editor.link" x-data="linkPicker" @click.outside="reset()" @focusout="onFocusOut($event)">
										<label for="card-link-input" class="sr-only">Find an issue or pull request</label>
										<input
											id="card-link-input"
											type="text"
											x-ref="input"
											x-model="text"
											placeholder="Search issues and pull requests by title or #number"
											autocomplete="off"
											class="h-9 w-full rounded-md border border-input bg-card px-2.5 text-[13px] placeholder:text-muted-foreground focus:outline-hidden focus:ring-2 focus:ring-ring"
											@input="search()"
											@keydown.enter.prevent="enterPick()"
											@keydown.escape="showList && ($event.preventDefault(), $event.stopPropagation(), reset())"
											@keydown.arrow-down.prevent="move(1)"
											@keydown.arrow-up.prevent="move(-1)"
										/>
										@targetResults()
									</div>
								} else {
									<p x-show="!editor.link" class="text-[12px] text-muted-foreground">None</p>
								}
							</div>
							<div>
								<label for="card-due-input" class="mb-1 block text-[12px] font-medium text-muted-foreground">Due date</label>
								@components.DatePicker(components.DatePickerProps{
									ID:          "card-due-input",
									Name:        "due_date",
									Label:       "Due date",
									Disabled:    !data.CanWrite,
									Placeholder: "No due date",
									Attrs:       templ.Attributes{"x-model": "editor.dueDate"},
								})
							</div>
						</div>
						<div class="flex min-w-0 flex-col gap-5">
							<div>
								<span id="card-assignees-label" class="mb-1 block text-[12px] font-medium text-muted-foreground">Assignees</span>
								if data.CanWrite {
									if len(data.People) == 0 {
										<p class="text-[12px] text-muted-foreground">No collaborators</p>
									} else {
										<div role="group" aria-labelledby="card-assignees-label" class="flex max-h-48 flex-col gap-0.5 overflow-y-auto" data-card-people>
											for _, p := range data.People {
												<label class="flex items-center gap-2 rounded px-1 py-1 text-[13px] hover:bg-muted">
													<input type="checkbox" data-person x-model="editor.assignees" value={ strconv.FormatInt(p.ID, 10) } class="accent-primary"/>
													@components.Avatar(p.Username, components.AvatarSizeXS, "")
													<span class="truncate">{ p.Username }</span>
												</label>
											}
										</div>
									}
									<div class="mt-1 flex flex-col gap-0.5">
										<template x-for="a in staleAssignees" x-bind:key="a.id">
											<label class="flex items-center gap-2 rounded px-1 py-1 text-[13px] hover:bg-muted">
												<input type="checkbox" x-model="editor.assignees" x-bind:value="String(a.id)" class="accent-primary"/>
												<span class="truncate" x-text="a.username"></span>
												<span class="shrink-0 text-[11px] text-muted-foreground">not a collaborator</span>
											</label>
										</template>
									</div>
								} else {
									<p x-show="!editor.card.assignees.length" class="text-[12px] text-muted-foreground">None</p>
									<ul class="flex flex-col gap-1 text-[13px]">
										<template x-for="a in editor.card.assignees" x-bind:key="a.id">
											<li x-text="a.username"></li>
										</template>
									</ul>
								}
							</div>
							<div>
								<span id="card-labels-label" class="mb-1 block text-[12px] font-medium text-muted-foreground">Labels</span>
								if data.CanWrite {
									if len(data.Labels) == 0 {
										<p class="text-[12px] text-muted-foreground">No labels in this repository</p>
									} else {
										<div role="group" aria-labelledby="card-labels-label" class="flex max-h-48 flex-col gap-0.5 overflow-y-auto" data-card-labels>
											for _, l := range data.Labels {
												<label class="flex items-center gap-2 rounded px-1 py-1 text-[13px] hover:bg-muted">
													<input type="checkbox" x-model="editor.labels" value={ strconv.FormatInt(l.ID, 10) } class="accent-primary"/>
													<span class="inline-block h-2.5 w-2.5 shrink-0 rounded-full bg-muted" style={ labelChipStyle(l.Color) }></span>
													<span class="truncate">{ l.Name }</span>
												</label>
											}
										</div>
									}
								} else {
									<p x-show="!editor.card.labels.length" class="text-[12px] text-muted-foreground">None</p>
									<ul class="flex flex-col gap-1 text-[13px]">
										<template x-for="l in editor.card.labels" x-bind:key="l.id">
											<li class="flex items-center gap-2">
												<span class="inline-block h-2.5 w-2.5 shrink-0 rounded-full bg-muted" x-bind:style="l.color ? { backgroundColor: l.color } : {}"></span>
												<span x-text="l.name"></span>
											</li>
										</template>
									</ul>
								}
							</div>
						</div>
					</div>
				</div>
			</div>
			<p x-show="editor.error" x-cloak x-text="editor.error" class="px-5 pb-3 text-[12px] text-destructive" role="alert"></p>
			if data.CanWrite {
				<div role="status" aria-live="polite">
					<p x-show="editor.notice" x-cloak x-text="editor.notice" class="px-5 pb-3 text-[12px] text-muted-foreground" data-card-notice></p>
				</div>
			}
			<div class="flex flex-wrap items-center gap-2 border-t border-border px-5 py-4">
				if data.CanWrite {
					<div x-show="!editor.confirm" class="flex w-full flex-wrap items-center gap-2">
						@components.Button(components.ButtonDestructiveOutline, components.ButtonSizeDefault, templ.Attributes{
							"type":            "button",
							"x-ref":           "deleteButton",
							"x-show":          "editor.mode === 'edit'",
							"x-bind:disabled": "editor.busy",
							"@click":          "ask('delete')",
						}) {
							Delete
						}
						@components.Button(components.ButtonOutline, components.ButtonSizeDefault, templ.Attributes{
							"type":            "button",
							"x-ref":           "convertButton",
							"x-show":          "editor.mode === 'edit' && !editor.link && editor.title.trim()",
							"x-bind:disabled": "editor.busy",
							"@click":          "ask('convert')",
						}) {
							Convert to issue
						}
						<div class="ml-auto flex items-center gap-2">
							@components.Button(components.ButtonOutline, components.ButtonSizeDefault, templ.Attributes{"type": "button", "x-bind:disabled": "editor.busy", "@click": "close()"}) {
								Cancel
							}
							@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit", "x-bind:disabled": "!canSubmit"}) {
								<span x-show="editor.mode === 'create'">Create card</span>
								<span x-show="editor.mode === 'edit'" x-cloak>Save</span>
							}
						</div>
					</div>
					<div x-show="editor.confirm" x-cloak class="flex w-full flex-wrap items-center justify-end gap-x-2 gap-y-3" role="group" aria-labelledby="card-confirm-text" data-card-confirm>
						<p id="card-confirm-text" class="basis-full text-[13px] font-medium">
							<span x-show="editor.confirm === 'convert'">Create an issue from this card? The card will link to the new issue.</span>
							<span x-show="editor.confirm === 'delete'">Delete this card?</span>
						</p>
						@components.Button(components.ButtonOutline, components.ButtonSizeDefault, templ.Attributes{"type": "button", "x-bind:disabled": "editor.busy", "@click": "cancelConfirm()"}) {
							Cancel
						}
						@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{
							"type":            "button",
							"x-ref":           "confirmConvert",
							"x-show":          "editor.confirm === 'convert'",
							"x-bind:disabled": "editor.busy",
							"@click":          "convertCard()",
						}) {
							Create issue
						}
						@components.Button(components.ButtonDestructive, components.ButtonSizeDefault, templ.Attributes{
							"type":            "button",
							"x-ref":           "confirmDelete",
							"x-show":          "editor.confirm === 'delete'",
							"x-bind:disabled": "editor.busy",
							"@click":          "deleteCard()",
						}) {
							Delete card
						}
					</div>
				} else {
					@components.Button(components.ButtonOutline, components.ButtonSizeDefault, templ.Attributes{"type": "button", "x-ref": "cardClose", "class": "ml-auto", "@click": "close()"}) {
						Close
					}
				}
			</div>
		</form>
	</dialog>
}

script setProjectClosedJS(owner, repoName string, projectID int64, closed bool) {
	var csrf = (document.cookie.match(/csrf_token=([^;]+)/) || [])[1] || '';
	fetch('/api/repos/' + owner + '/' + repoName + '/projects/' + projectID, {
		method: 'PATCH',
		headers: {'Content-Type': 'application/json', 'X-CSRF-Token': csrf},
		body: JSON.stringify({closed: closed})
	}).then(function(r){ if(r.ok) window.location.reload(); });
}

script deleteColumnJS(owner, repoName string, projectID, columnID int64) {
	if(!confirm('Delete column and all its cards?')) return;
	var csrf = (document.cookie.match(/csrf_token=([^;]+)/) || [])[1] || '';
	fetch('/api/repos/' + owner + '/' + repoName + '/projects/' + projectID + '/columns/' + columnID, {method:'DELETE', headers: {'X-CSRF-Token': csrf}})
		.then(function(r){ if(r.ok) window.location.reload(); });
}

script deleteCardJS(owner, repoName string, projectID, cardID int64) {
	var csrf = (document.cookie.match(/csrf_token=([^;]+)/) || [])[1] || '';
	fetch('/api/repos/' + owner + '/' + repoName + '/projects/' + projectID + '/cards/' + cardID, {method:'DELETE', headers: {'X-CSRF-Token': csrf}})
		.then(function(r){ if(r.ok) window.location.reload(); });
}
