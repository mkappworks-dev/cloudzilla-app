package pages

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/codeurl"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/fragments"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/timefmt"
)

templ Commit(data view.CommitData) {
	@layout.Base(data.BasePage, data.Commit.Hash+" · "+data.Owner+"/"+data.RepoName) {
		<div class="space-y-6">

			<section aria-labelledby="commit-title">
				<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="hover:underline">{ data.RepoName }</a>
					<span aria-hidden="true">·</span>
					<a href={ templ.SafeURL(codeurl.Path(data.Owner, data.RepoName, "commits", data.Repo.DefaultBranch, "")) } class="hover:underline">Commits</a>
					<span aria-hidden="true">·</span>
					<span class="font-mono">{ data.Commit.Hash }</span>
				</p>
				<h1 id="commit-title" class="text-xl font-semibold tracking-tight">{ data.Commit.Message }</h1>
				if data.Commit.Body != "" {
					<pre class="mt-3 text-sm text-muted-foreground whitespace-pre-wrap font-sans">{ data.Commit.Body }</pre>
				}
				<div class="mt-4 flex flex-wrap items-center gap-3 text-[13px] text-muted-foreground">
					if data.AuthorUsername != "" {
						@components.Avatar(data.AuthorUsername, components.AvatarSizeSM, "")
						<a href={ templ.SafeURL("/" + data.AuthorUsername) } title={ data.Commit.AuthorEmail } class="font-medium text-foreground hover:underline">{ data.AuthorUsername }</a>
					} else {
						@components.Initials(data.Commit.Author, components.AvatarSizeSM, "")
						<span title={ data.Commit.AuthorEmail } class="font-medium text-foreground">{ data.Commit.Author }</span>
					}
					<span aria-hidden="true">·</span>
					<time datetime={ data.Commit.AuthorTime.UTC().Format(time.RFC3339) }>{ timefmt.DateTime(data.Commit.AuthorTime) }</time>
					<span aria-hidden="true">·</span>
					<code class="font-mono px-2 py-0.5 rounded-sm text-[12px] bg-muted text-foreground border border-border break-all">{ data.Commit.FullHash }</code>
					@components.SignatureBadge(data.Commit.Signature)
				</div>
				if len(data.Commit.ParentHashes) > 0 {
					<div class="mt-2 text-[12px] text-muted-foreground">
						Parents:
						for _, ph := range data.Commit.ParentHashes {
							<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/commit/" + ph) } class="font-mono ml-1 hover:text-foreground hover:underline">{ components.RefLabel(ph) }</a>
						}
					</div>
				}
			</section>

			if len(data.Statuses) > 0 {
				<section class="rounded-md border border-border bg-card" aria-labelledby="checks-heading">
					<header class="px-4 py-3 border-b border-border">
						<h2 id="checks-heading" class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider">Checks</h2>
					</header>
					<div class="p-4 space-y-2">
						for _, s := range data.Statuses {
							@components.StatusRow(s)
						}
					</div>
				</section>
			}

			<section class="rounded-md border border-border bg-card px-4 py-3 text-[13px] text-muted-foreground" aria-label="Diff stats">
				<span class="font-mono">{ strconv.Itoa(len(data.Commit.Files)) }</span>
				if len(data.Commit.Files) == 1 {
					file changed,
				} else {
					files changed,
				}
				<span class="font-mono text-success font-medium">
					+{ strconv.Itoa(data.Commit.TotalAdded) }
				</span>
				<span class="font-mono text-destructive font-medium">
					−{ strconv.Itoa(data.Commit.TotalDeleted) }
				</span>
			</section>

			for _, f := range data.Commit.Files {
				@fragments.FileDiff(f)
			}
		</div>
	}
}
