package pages

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/timefmt"
)

templ SecurityAlerts(data view.SecretAlertsData) {
	@layout.Base(data.BasePage, "Security · "+data.Owner+"/"+data.RepoName) {
		<div class="flex flex-col gap-6">
			<section aria-labelledby="security-title">
				<h1 id="security-title" class="text-2xl font-semibold tracking-tight">Security</h1>
				<p class="mt-1 text-[13px] text-muted-foreground">Secrets found in pushes to this repository. Every push is scanned; pushes that add a known secret type are rejected. Only people with write access see this page.</p>
			</section>
			<div class="flex flex-col gap-4">
				<form method="GET" action={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/security/secrets") }>
					<input type="hidden" name="state" value={ data.State }/>
					<nav class="flex flex-wrap items-center gap-1 border-b border-border text-sm" aria-label="Alert state">
						@securityStateTab(data.OpenTabURL, "Open", data.OpenCount, data.State == "open")
						@securityStateTab(data.ClosedTabURL, "Closed", data.ClosedCount, data.State == "closed")
						<div class="ml-auto flex items-center gap-1.5 pb-1.5">
							<div class="relative">
								<select name="type" aria-label="Filter by secret type" onchange="this.form.requestSubmit()" class="h-8 pl-3 pr-7 text-[13px] bg-card border border-border rounded-md text-muted-foreground focus:outline-hidden focus:ring-2 focus:ring-ring appearance-none">
									<option value="">All secret types</option>
									for _, o := range data.TypeOptions {
										<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
									}
								</select>
								<svg class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 text-muted-foreground" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M7 10l5 5 5-5"></path></svg>
							</div>
						</div>
					</nav>
				</form>
				if len(data.Rows) == 0 && data.NewerURL == "" {
					if data.Type != "" || data.State == "closed" {
						@components.EmptyState("No " + data.State + " alerts" + securityFilterSuffix(data.Type) + ".")
					} else {
						@components.EmptyStateWithHint("No secrets found.", "Pushes are scanned for AWS keys, private keys, Cloudzilla access tokens, JWT signing secrets and generic API key patterns.")
					}
				} else {
					<section class="rounded-md border border-border bg-card overflow-hidden" aria-label={ "Secret scanning alerts, " + data.State }>
						<ul class="divide-y divide-border">
							for _, row := range data.Rows {
								@securityAlertRow(row)
							}
						</ul>
					</section>
					@components.PaginationLabeled(data.NewerURL, data.OlderURL)
				}
			</div>
		</div>
	}
}

func securityFilterSuffix(typeID string) string {
	if typeID == "" {
		return ""
	}
	return " of type " + view.SecretTypeLabel(typeID)
}

templ securityStateTab(href, label string, count int, active bool) {
	if active {
		<a href={ templ.SafeURL(href) } aria-current="page" class="px-3 py-2.5 border-b -mb-px inline-flex items-center gap-1.5 border-foreground text-foreground font-medium">
			{ label }
			<span class="ml-0.5 text-[11px] text-muted-foreground font-mono" aria-label={ strconv.Itoa(count) + " items" }>{ strconv.Itoa(count) }</span>
		</a>
	} else {
		<a href={ templ.SafeURL(href) } class="px-3 py-2.5 border-b -mb-px inline-flex items-center gap-1.5 border-transparent text-muted-foreground hover:text-foreground">
			{ label }
			<span class="ml-0.5 text-[11px] text-muted-foreground font-mono" aria-label={ strconv.Itoa(count) + " items" }>{ strconv.Itoa(count) }</span>
		</a>
	}
}

templ securityAlertRow(row view.SecretAlertRow) {
	<li class="relative px-4 py-3 flex items-start gap-3 hover:bg-muted/40">
		if row.Closed {
			<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="shrink-0 mt-0.5 text-muted-foreground" aria-label="Closed"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg>
		} else {
			<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="shrink-0 mt-0.5 text-destructive" aria-label="Open"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg>
		}
		<div class="min-w-0 flex-1">
			<div class="flex flex-wrap items-center gap-2">
				<a href={ templ.SafeURL(row.URL) } class="text-[13.5px] font-medium hover:underline after:absolute after:inset-0">{ row.TypeLabel }</a>
				<code class="font-mono px-1.5 py-0.5 bg-muted border border-border rounded-sm text-[12px]">{ row.Hint }</code>
				if row.AutoRevoked {
					@components.Badge(components.BadgeOutline) {
						Auto-revoked
					}
				}
				if row.Blocked {
					@components.Badge(components.BadgeWarning) {
						Blocked push
					}
				}
				if row.Closed && row.ResolutionLabel != "" {
					@components.Badge(components.BadgeSecondary) {
						{ row.ResolutionLabel }
					}
				}
				if row.Incomplete {
					@components.Badge(components.BadgeOutline) {
						Scan incomplete
					}
				}
			</div>
			<p class="mt-0.5 text-[12px] text-muted-foreground flex flex-wrap items-center gap-x-1.5 gap-y-1">
				<span class="font-mono">#{ strconv.Itoa(row.Number) }</span><span aria-hidden="true">·</span>
				if row.Location != "" {
					<span class="font-mono break-all">{ row.Location }</span><span aria-hidden="true">·</span>
				}
				if row.CommitShort != "" {
					<span>
						commit <a href={ templ.SafeURL(row.CommitURL) } class="relative z-10 font-mono hover:text-foreground hover:underline">{ row.CommitShort }</a>
						if row.Pusher != "" {
							by { row.Pusher }
						}
					</span><span aria-hidden="true">·</span>
				}
				if row.Closed {
					<span>
						if row.ClosedBy != "" {
							closed by { row.ClosedBy }
						} else {
							closed automatically
						}
						<time datetime={ row.ClosedAt.UTC().Format("2006-01-02T15:04:05Z") }>{ timefmt.Relative(row.ClosedAt) }</time>
					</span>
				} else {
					<span>detected <time datetime={ row.DetectedAt.UTC().Format("2006-01-02T15:04:05Z") }>{ timefmt.Relative(row.DetectedAt) }</time></span>
				}
			</p>
		</div>
	</li>
}
