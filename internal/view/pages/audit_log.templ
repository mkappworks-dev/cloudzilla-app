package pages

import (
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/timefmt"
)

templ AuditLog(data view.AuditLogData) {
	@layout.Base(data.BasePage, "Audit log") {
		<div class="space-y-6">
			@adminTabs("/admin/audit-log")
			<div class="flex justify-between items-center">
				<h1 class="text-2xl font-semibold tracking-tight">Audit log</h1>
				<span class="text-sm text-muted-foreground">{ components.Count(data.TotalCount, "entry", "entries") }</span>
			</div>
			<!-- Filter bar -->
			<div class="rounded-md border border-border bg-card p-4">
				<form method="GET" action="/admin/audit-log" class="flex flex-wrap gap-4 items-end">
					<div class="space-y-1.5">
						<label for="filter-action" class="block text-xs font-medium text-muted-foreground">Action</label>
						@components.Input(templ.Attributes{
							"id":          "filter-action",
							"type":        "text",
							"name":        "action",
							"value":       data.Filter.Action,
							"placeholder": "e.g. login, repo.create",
							"class":       "w-48",
						})
					</div>
					<div class="space-y-1.5">
						<label for="filter-target-type" class="block text-xs font-medium text-muted-foreground">Target type</label>
						@components.Input(templ.Attributes{
							"id":          "filter-target-type",
							"type":        "text",
							"name":        "target_type",
							"value":       data.Filter.TargetType,
							"placeholder": "e.g. repo, user",
							"class":       "w-40",
						})
					</div>
					<div class="flex gap-2">
						@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
							Filter
						}
						@components.LinkButton("/admin/audit-log", components.ButtonSecondary, components.ButtonSizeDefault, nil) {
							Reset
						}
					</div>
				</form>
			</div>
			<!-- Entries table -->
			<div class="rounded-md border border-border bg-card overflow-hidden">
				if len(data.Entries) > 0 {
					<table class="w-full text-sm">
						<thead>
							<tr class="text-left text-muted-foreground border-b border-border bg-muted">
								@components.SortHeader("Time", auditSortURL(data.Filter, "time"), auditAriaSort(data.Filter, "time"))
								@components.SortHeader("Actor", auditSortURL(data.Filter, "actor"), auditAriaSort(data.Filter, "actor"))
								@components.SortHeader("Action", auditSortURL(data.Filter, "action"), auditAriaSort(data.Filter, "action"))
								@components.SortHeader("Target", auditSortURL(data.Filter, "target"), auditAriaSort(data.Filter, "target"))
								<th scope="col" class="px-4 py-3 font-medium">Details</th>
								<th scope="col" class="px-4 py-3 font-medium">IP address</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-border">
							for _, e := range data.Entries {
								<tr class="hover:bg-muted/40">
									<td class="px-4 py-3 text-muted-foreground whitespace-nowrap">
										<time datetime={ e.CreatedAt.UTC().Format(time.RFC3339) }>{ timefmt.DateTime(e.CreatedAt) }</time>
									</td>
									<td class="px-4 py-3 font-medium text-foreground">{ e.ActorName }</td>
									<td class="px-4 py-3">
										<code class="text-xs bg-muted border border-border rounded-sm px-1.5 py-0.5 font-mono text-foreground">{ e.Action }</code>
									</td>
									<td class="px-4 py-3 text-foreground">
										if e.TargetType != "" {
											<span class="text-xs text-muted-foreground mr-1">{ e.TargetType }</span>
										}
										{ e.TargetName }
									</td>
									<td class="px-4 py-3 text-xs">
										if details := auditDetails(e.Metadata); len(details) > 0 {
											<dl class="space-y-0.5">
												for _, d := range details {
													<div class="flex gap-1.5">
														<dt class="text-muted-foreground shrink-0">{ d.Key }</dt>
														<dd class="font-mono text-foreground break-all">{ d.Value }</dd>
													</div>
												}
											</dl>
										} else {
											<span class="text-muted-foreground">—</span>
										}
									</td>
									<td class="px-4 py-3 text-muted-foreground font-mono text-xs">{ e.IPAddress }</td>
								</tr>
							}
						</tbody>
					</table>
				} else {
					<div class="text-center py-12 text-muted-foreground">
						<p>No audit log entries found.</p>
					</div>
				}
			</div>
			{{ totalPages := (data.TotalCount + data.PerPage - 1) / data.PerPage }}
			{{ auditPrevURL := "" }}
			if data.Page > 1 {
				{{ auditPrevURL = auditPageURL(data.Filter, data.Page-1) }}
			}
			{{ auditNextURL := "" }}
			if data.Page*data.PerPage < data.TotalCount {
				{{ auditNextURL = auditPageURL(data.Filter, data.Page+1) }}
			}
			@components.PaginationWithCount(auditPrevURL, auditNextURL, data.Page, totalPages)
		</div>
	}
}
