package pages

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ UserGists(data view.UserGistsData) {
	@layout.Base(data.BasePage, data.ProfileUser.Username+"'s Gists") {
		<div class="max-w-4xl mx-auto py-8 px-4">
			<div class="flex items-center justify-between mb-6">
				<h1 class="text-2xl font-bold">{ data.ProfileUser.Username }&#39;s Gists</h1>
				if data.BasePage.CurrentUser != nil && data.BasePage.CurrentUser.UserID == data.ProfileUser.ID {
					@components.LinkButton("/gists/new", components.ButtonDefault, components.ButtonSizeSM, nil) {
						+ New gist
					}
				}
			</div>
			if len(data.Gists) > 0 {
				<ul class="space-y-4">
					for _, g := range data.Gists {
						<li class="rounded-md border border-border bg-card p-4">
							<div class="flex items-center justify-between mb-1">
								<a href={ templ.SafeURL("/gists/" + g.ID) } class="text-foreground hover:underline font-medium">
									if g.Description != "" {
										{ g.Description }
									} else {
										<span class="text-muted-foreground italic">No description</span>
									}
								</a>
								<span class="text-xs text-muted-foreground">
									if g.Public {
										Public
									} else {
										Secret
									}
								</span>
							</div>
							<div class="text-sm text-muted-foreground">
								<time datetime={ g.CreatedAt.UTC().Format(time.RFC3339) }>{ g.CreatedAt.Format("Jan 2, 2006") }</time>
							</div>
						</li>
					}
				</ul>
				<div class="mt-6 flex gap-2">
					if data.Page > 1 {
						@components.LinkButton("?page="+strconv.Itoa(data.Page-1), components.ButtonOutline, components.ButtonSizeSM, nil) {
							Previous
						}
					}
					@components.LinkButton("?page="+strconv.Itoa(data.Page+1), components.ButtonOutline, components.ButtonSizeSM, nil) {
						Next
					}
				</div>
			} else {
				<p class="text-muted-foreground">No gists yet.</p>
			}
		</div>
	}
}
