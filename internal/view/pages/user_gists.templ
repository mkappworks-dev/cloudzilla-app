package pages

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ UserGists(data view.UserGistsData) {
	@layout.Base(data.BasePage, data.ProfileUser.Username+"'s Gists") {
		<div class="max-w-4xl mx-auto py-8 px-4">
			<div class="flex items-center justify-between mb-6">
				<h1 class="text-2xl font-bold">{ data.ProfileUser.Username }&#39;s Gists</h1>
				if data.BasePage.CurrentUser != nil && data.BasePage.CurrentUser.UserID == data.ProfileUser.ID {
					<a href="/gists/new" class="px-3 py-1.5 bg-blue-600 text-white text-sm rounded hover:bg-blue-700 transition-colors">+ New gist</a>
				}
			</div>
			if len(data.Gists) > 0 {
				<ul class="space-y-4">
					for _, g := range data.Gists {
						<li class="border border-gray-200 rounded p-4">
							<div class="flex items-center justify-between mb-1">
								<a href={ templ.SafeURL("/gists/" + g.ID) } class="text-blue-600 hover:underline font-medium">
									if g.Description != "" {
										{ g.Description }
									} else {
										<span class="text-gray-400 italic">No description</span>
									}
								</a>
								<span class="text-xs text-gray-400">
									if g.Public {
										Public
									} else {
										Secret
									}
								</span>
							</div>
							<div class="text-sm text-gray-500">{ g.CreatedAt.Format("Jan 2, 2006") }</div>
						</li>
					}
				</ul>
				<div class="mt-6 flex gap-2">
					if data.Page > 1 {
						<a href={ templ.SafeURL("?page=" + strconv.Itoa(data.Page-1)) } class="px-3 py-1 border rounded text-sm">Previous</a>
					}
					<a href={ templ.SafeURL("?page=" + strconv.Itoa(data.Page+1)) } class="px-3 py-1 border rounded text-sm">Next</a>
				</div>
			} else {
				<p class="text-gray-500">No gists yet.</p>
			}
		</div>
	}
}
