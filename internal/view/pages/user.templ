package pages

import (
	"net/url"
	"strconv"
	"strings"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/model"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ User(data view.UserData) {
	@layout.Base(data.BasePage, data.User.Username) {
		<div class="space-y-8">

			<!-- Profile header -->
			<!-- Follow / Share intentionally omitted: Cloudzilla has no follow system. -->
			<section class="flex flex-wrap items-start gap-5 pb-6 border-b border-border" aria-labelledby="profile-name">
				@components.Avatar(data.User.Username, components.AvatarSizeLG, data.User.Username)
				<div class="min-w-0 flex-1">
					<h1 id="profile-name" class="text-2xl font-semibold tracking-tight">{ data.User.Username }</h1>
					if data.User.Bio != "" {
						<p class="mt-1.5 text-sm text-muted-foreground max-w-2xl">{ data.User.Bio }</p>
					}
					<dl class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted-foreground">
						if data.User.Company != "" {
							<div class="inline-flex items-center gap-1.5">
								<dt class="sr-only">Company</dt>
								<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><path d="M3 21h18M3 7h18M5 21V7l7-4 7 4v14"></path></svg>
								<dd>{ data.User.Company }</dd>
							</div>
						}
						if data.User.Location != "" {
							<div class="inline-flex items-center gap-1.5">
								<dt class="sr-only">Location</dt>
								<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
								<dd>{ data.User.Location }</dd>
							</div>
						}
						if data.IsOwnProfile && data.User.Email != "" {
							<div class="inline-flex items-center gap-1.5">
								<dt class="sr-only">Email</dt>
								<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><path d="M4 4h16a2 2 0 012 2v12a2 2 0 01-2 2H4a2 2 0 01-2-2V6a2 2 0 012-2z"></path><polyline points="22 6 12 13 2 6"></polyline></svg>
								<dd>{ data.User.Email }</dd>
							</div>
						}
						<div class="inline-flex items-center gap-1.5">
							<dt class="sr-only">Joined</dt>
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
							<dd>Joined <time datetime={ data.User.CreatedAt.UTC().Format(time.RFC3339) }>{ data.User.CreatedAt.Format("Jan 2006") }</time></dd>
						</div>
						if data.User.IsSuperadmin {
							<div>
								@components.Badge(components.BadgeOutline) {
									Superadmin
								}
							</div>
						}
					</dl>
				</div>
				if data.IsOwnProfile {
					<div class="flex-shrink-0 flex items-center gap-2">
						@components.LinkButton("/settings#profile", components.ButtonOutline, components.ButtonSizeSM, nil) {
							Edit profile
						}
						@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{
							"x-data":     "{ copied: false }",
							"@click":     "navigator.clipboard.writeText(window.location.origin + " + strconv.Quote("/"+data.User.Username) + "); copied = true; setTimeout(() => copied = false, 1500)",
							"aria-label": "Copy profile URL to clipboard",
						}) {
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><path d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8M16 6l-4-4-4 4M12 2v13"></path></svg>
							<span x-text="copied ? 'Copied' : 'Share'">Share</span>
						}
					</div>
				}
			</section>

			<nav aria-label="Profile sections" class="flex flex-wrap items-center gap-1 text-sm -mt-2">
				@profileTab(data.Tab == "overview", "/"+data.User.Username, "Overview")
				@profileTab(data.Tab == "repositories", "/"+data.User.Username+"?tab=repositories", "Repositories", data.ReposTotal)
				@profileTab(data.Tab == "stars", "/"+data.User.Username+"?tab=stars", "Stars", data.StarsTotal)
				@profileTab(data.Tab == "gists", "/"+data.User.Username+"?tab=gists", "Gists", data.GistsTotal)
			</nav>

			if data.Tab == "overview" {
				<div class="grid gap-8 lg:grid-cols-[1fr_240px]">
					<div class="min-w-0 space-y-8">

						if data.ProfileReadme != "" {
							<article class="rounded-md border border-border bg-card overflow-hidden" aria-labelledby="profile-readme-heading" x-data="{ editing: false }">
								<header class="px-5 py-3 border-b border-border bg-muted flex items-center gap-2">
									<svg class="text-muted-foreground" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
									<h2 id="profile-readme-heading" class="text-[13px] font-medium">{ data.User.Username }/README.md</h2>
									if data.IsOwnProfile && data.HasProfileRepo {
										<span class="ml-auto" x-show="!editing">
											@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{
												"type":    "button",
												"@click":  "editing = true",
												"x-cloak": "",
											}) {
												<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4z"></path></svg>
												Edit
											}
										</span>
									}
								</header>
								if data.IsOwnProfile && data.ReadmeError != "" {
									<div class="px-5 py-2.5 border-b border-border bg-destructive/10 text-[12.5px] text-destructive">
										{ readmeErrorMessage(data.ReadmeError) }
									</div>
								}
								<div x-show="!editing" class="prose prose-sm max-w-none dark:prose-invert px-7 py-6">
									@templ.Raw(string(data.ProfileReadme))
								</div>
								if data.IsOwnProfile && data.HasProfileRepo {
									<form x-show="editing" x-cloak method="POST" action="/settings/profile-readme" class="p-5 space-y-3">
										<textarea name="content" required class="w-full min-h-[320px] font-mono text-[13px] bg-card border border-border rounded p-3 focus:outline-none focus:ring-2 focus:ring-ring">{ data.ProfileReadmeRaw }</textarea>
										<input type="text" name="message" placeholder="Update profile README" class="w-full text-[13px] bg-card border border-border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-ring"/>
										<div class="flex items-center justify-end gap-2">
											@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{
												"type":   "button",
												"@click": "editing = false",
											}) {
												Cancel
											}
											@components.Button(components.ButtonDefault, components.ButtonSizeSM, templ.Attributes{
												"type": "submit",
											}) {
												Save
											}
										</div>
									</form>
								}
							</article>
						} else if data.IsOwnProfile {
							<article class="rounded-md border border-border bg-card overflow-hidden" aria-labelledby="profile-readme-cta-heading">
								<div class="px-7 py-6 flex flex-col items-start gap-3">
									<h2 id="profile-readme-cta-heading" class="text-base font-semibold tracking-tight">Add a profile README</h2>
									<p class="text-[13px] text-muted-foreground max-w-prose">
										Tell visitors about yourself. We'll create a public repo named <span class="font-mono text-foreground">{ data.User.Username }</span> with a README.md you can edit anytime.
									</p>
									@components.LinkButton("/repos/new?name="+data.User.Username+"&visibility=public&init_readme=1", components.ButtonDefault, components.ButtonSizeDefault, nil) {
										<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"></path></svg>
										Create README repo
									}
								</div>
							</article>
						}

						if data.IsOwnProfile || len(data.PinnedRepos) > 0 {
							<section aria-labelledby="pinned-heading">
								<div class="mb-3 flex items-center justify-between gap-3">
									<h2 id="pinned-heading" class="text-sm font-semibold tracking-tight">Pinned</h2>
									if data.IsOwnProfile {
										@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{
											"type":    "button",
											"onclick": "document.getElementById('pin-modal').showModal()",
										}) {
											if len(data.PinnedRepos) == 0 {
												Pin a repository
											} else {
												Manage pins
											}
										}
									}
								</div>
								if len(data.PinnedRepos) > 0 {
									<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-3">
										for _, p := range data.PinnedRepos {
											@components.PinnedRepo(p)
										}
									</div>
								} else if data.IsOwnProfile {
									<div class="rounded-md border border-dashed border-border bg-card px-5 py-8 text-center text-[13px] text-muted-foreground">
										No pinned repositories yet. Pin up to 6 to feature them here.
									</div>
								}
							</section>
							if data.IsOwnProfile {
								@pinReposModal(data)
							}
						}

						<section aria-labelledby="contrib-heading">
							<h2 id="contrib-heading" class="text-sm font-semibold tracking-tight mb-3">
								{ strconv.Itoa(totalContributions(data.Heatmap)) } contributions in the last year
							</h2>
							<div class="rounded-md border border-border bg-card p-5 overflow-x-auto">
								@components.HeatmapLarge(data.Heatmap, time.Now(), 52)
							</div>
						</section>

						if len(data.RecentActivity) > 0 {
							<section aria-labelledby="activity-heading">
								<h2 id="activity-heading" class="text-sm font-semibold tracking-tight mb-3">Recent activity</h2>
								<ul class="divide-y divide-border rounded-md border border-border bg-card overflow-hidden">
									for _, ev := range data.RecentActivity {
										@components.ActivityRow(eventToActivityRow(ev))
									}
								</ul>
							</section>
						}

					</div>

					<aside class="space-y-6 text-[12.5px]">
						if len(data.Orgs) > 0 {
							<section aria-labelledby="orgs-heading">
								<h2 id="orgs-heading" class="font-mono uppercase tracking-wider text-[10px] text-muted-foreground mb-2">Organizations</h2>
								<div class="flex flex-wrap gap-1.5">
									for _, m := range data.Orgs {
										<a href={ templ.SafeURL("/" + m.Org.Name) } title={ m.Org.Name } class="hover:opacity-80">
											@components.Avatar(m.Org.Name, components.AvatarSizeDefault, m.Org.Name)
										</a>
									}
								</div>
							</section>
						}
						if len(data.TopLangs) > 0 {
							<section aria-labelledby="langs-heading">
								<h2 id="langs-heading" class="font-mono uppercase tracking-wider text-[10px] text-muted-foreground mb-2">Top languages</h2>
								@components.LanguagesBar(data.TopLangs)
							</section>
						}
					</aside>
				</div>
			}

			if data.Tab == "repositories" {
				@userReposTab(data)
			}

			if data.Tab == "stars" {
				@userStarsTab(data)
			}

			if data.Tab == "gists" {
				@userGistsTab(data)
			}

		</div>
	}
}

templ profileTab(active bool, href, label string, counts ...int) {
	if active {
		<a href={ templ.SafeURL(href) } aria-current="page" class="px-3 py-1.5 rounded-md bg-accent font-medium text-foreground inline-flex items-center gap-1.5">
			{ label }
			for _, c := range counts {
				if c > 0 {
					<span class="font-mono text-[11px] text-muted-foreground/70 ml-0.5">{ strconv.Itoa(c) }</span>
				}
			}
		</a>
	} else {
		<a href={ templ.SafeURL(href) } class="px-3 py-1.5 rounded-md text-muted-foreground hover:text-foreground hover:bg-accent inline-flex items-center gap-1.5">
			{ label }
			for _, c := range counts {
				if c > 0 {
					<span class="font-mono text-[11px] text-muted-foreground/70 ml-0.5">{ strconv.Itoa(c) }</span>
				}
			}
		</a>
	}
}

func totalContributions(counts map[time.Time]int) int {
	total := 0
	for _, n := range counts {
		total += n
	}
	return total
}

templ userReposTab(data view.UserData) {
	<section aria-labelledby="repos-tab-heading">
		<!-- Section header -->
		<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
			<div class="min-w-0">
				<h2 id="repos-tab-heading" class="text-2xl font-semibold tracking-tight">Repositories</h2>
				<p class="mt-1 text-[13px] text-muted-foreground">
					if data.IsOwnProfile {
						{ strconv.Itoa(data.ReposTotal) } { pluralRepo(data.ReposTotal) } you own or collaborate on.
					} else {
						{ strconv.Itoa(data.ReposTotal) } { pluralRepo(data.ReposTotal) } by { data.User.Username }.
					}
				</p>
			</div>
			if data.BasePage.CurrentUser != nil && data.BasePage.CurrentUser.UserID == data.User.ID {
				<a href="/repos/new" class="h-9 px-4 rounded-md font-medium text-sm inline-flex items-center gap-1.5 bg-foreground text-background hover:bg-foreground/90 shrink-0">
					<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"></path></svg>
					New repository
				</a>
			}
		</div>

		<!-- Filter bar -->
		<form method="GET" action={ templ.SafeURL("/" + data.User.Username) } class="flex items-center gap-2 mb-4 flex-wrap">
			<input type="hidden" name="tab" value="repositories"/>
			<div class="relative flex-1 min-w-[240px]">
				<label for="repo-search" class="sr-only">Filter repositories</label>
				<input
					id="repo-search"
					type="search"
					name="q"
					value={ data.RepoTabActiveQuery }
					placeholder="Filter by name…"
					class="w-full h-9 pl-8 pr-3 text-[13px] bg-card border border-border rounded-md placeholder:text-muted-foreground focus:outline-none focus:border-border-strong"
				/>
				<svg class="absolute left-2.5 top-2.5 text-muted-foreground" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
			</div>
			<select
				name="type"
				onchange="this.form.submit()"
				class="h-9 bg-card border border-border rounded-md px-3 text-[13px] text-foreground focus:outline-none focus:border-border-strong"
				aria-label="Filter by type"
				style="width:auto"
			>
				<option value="" selected?={ data.RepoTabActiveType == "" }>All types</option>
				<option value="sources" selected?={ data.RepoTabActiveType == "sources" }>Sources</option>
				<option value="forks" selected?={ data.RepoTabActiveType == "forks" }>Forks</option>
				<option value="templates" selected?={ data.RepoTabActiveType == "templates" }>Templates</option>
			</select>
			<select
				name="status"
				onchange="this.form.submit()"
				class="h-9 bg-card border border-border rounded-md px-3 text-[13px] text-foreground focus:outline-none focus:border-border-strong"
				aria-label="Filter by visibility"
				style="width:auto"
			>
				<option value="" selected?={ data.RepoTabActiveStatus == "" }>All visibility</option>
				<option value="public" selected?={ data.RepoTabActiveStatus == "public" }>Public</option>
				<option value="private" selected?={ data.RepoTabActiveStatus == "private" }>Private</option>
			</select>
		</form>

		<!-- Language chips -->
		if len(data.RepoTabLanguages) > 0 {
			<div class="flex flex-wrap gap-1.5 mb-4" role="group" aria-label="Filter by language">
				<a
					href={ templ.SafeURL(repoTabURL(data, "language", "")) }
					class={ "inline-flex items-center h-7 px-2.5 rounded-full text-xs font-medium border transition-colors", templ.KV("bg-foreground text-background border-transparent", data.RepoTabActiveLanguage == ""), templ.KV("border-border text-muted-foreground hover:text-foreground hover:border-foreground/40", data.RepoTabActiveLanguage != "") }
				>
					All
				</a>
				for _, lang := range data.RepoTabLanguages {
					<a
						href={ templ.SafeURL(repoTabURL(data, "language", lang)) }
						class={ "inline-flex items-center h-7 px-2.5 rounded-full text-xs font-medium border transition-colors", templ.KV("bg-foreground text-background border-transparent", data.RepoTabActiveLanguage == lang), templ.KV("border-border text-muted-foreground hover:text-foreground hover:border-foreground/40", data.RepoTabActiveLanguage != lang) }
					>
						{ lang }
					</a>
				}
			</div>
		}

		if len(data.RepoTabRepos) > 0 {
			<section class="border border-border rounded-md bg-card overflow-hidden" aria-label="Repository list">
				<ol class="divide-y divide-border">
					for _, repo := range data.RepoTabRepos {
						<li>
							@userRepoRow(data, repo)
						</li>
					}
				</ol>
			</section>
			@profilePagination(data.RepoTabPage, data.RepoTabTotalPages, repoTabPageURL(data))
		} else {
			<div class="border border-border rounded-md bg-card px-5 py-12 text-center text-[13px] text-muted-foreground">
				No repositories match your filters.
			</div>
		}
	</section>
}

templ userStarsTab(data view.UserData) {
	<section aria-labelledby="stars-tab-heading">
		<div class="mb-6 min-w-0">
			<h2 id="stars-tab-heading" class="text-2xl font-semibold tracking-tight">Stars</h2>
			<p class="mt-1 text-[13px] text-muted-foreground">
				{ strconv.Itoa(data.StarsTotal) } { pluralRepo(data.StarsTotal) } { data.User.Username } has starred.
			</p>
		</div>
		if len(data.StarredRepos) > 0 {
			<section class="border border-border rounded-md bg-card overflow-hidden" aria-label="Starred repositories">
				<ol class="divide-y divide-border">
					for _, repo := range data.StarredRepos {
						<li>
							@userStarRow(data, repo)
						</li>
					}
				</ol>
			</section>
			@profilePagination(data.StarsTabPage, data.StarsTabTotalPages, "/"+data.User.Username+"?tab=stars")
		} else {
			<div class="border border-border rounded-md bg-card px-5 py-12 text-center text-[13px] text-muted-foreground">
				{ data.User.Username } hasn't starred any repositories yet.
			</div>
		}
	</section>
}

const rowCardClass = "group relative block px-4 py-3 hover:bg-accent hover:pl-[18px] transition-[padding-left] duration-[120ms] before:absolute before:left-0 before:inset-y-2 before:w-0.5 before:rounded-[2px] before:bg-foreground before:opacity-0 before:transition-opacity before:duration-[120ms] hover:before:opacity-100 motion-reduce:transition-none motion-reduce:hover:pl-4 motion-reduce:before:transition-none"

templ userStarRow(data view.UserData, repo model.Repository) {
	{{ stars := data.RepoTabStars[repo.ID] }}
	<a href={ templ.SafeURL("/" + repo.OwnerName + "/" + repo.Name) } class={ rowCardClass }>
		<div class="flex items-start gap-3 mb-1.5">
			<span class="shrink-0 mt-0.5 text-muted-foreground" aria-hidden="true">
				@repoIcon(repo.Private)
			</span>
			<div class="min-w-0 flex-1 flex items-center gap-2 flex-wrap">
				<p class="text-[13.5px] font-medium leading-snug group-hover:underline">
					{ repo.OwnerName }/{ repo.Name }
				</p>
				if repo.Private {
					<span class="inline-flex items-center h-[20px] px-2 rounded-full border text-[10px] font-medium bg-warning/15 text-warning border-warning/30 shrink-0">Private</span>
				} else {
					<span class="inline-flex items-center h-[20px] px-2 rounded-full border text-[10px] font-medium bg-success/15 text-success border-success/30 shrink-0">Public</span>
				}
			</div>
		</div>
		if repo.Description != "" {
			<p class="pl-[27px] text-[12.5px] text-muted-foreground line-clamp-2">{ repo.Description }</p>
		}
		<div class="pl-[27px] mt-1.5 flex items-center justify-between gap-3">
			<div class="flex items-center gap-1.5 text-[12px] text-muted-foreground flex-wrap min-w-0">
				if repo.PrimaryLanguage != nil && *repo.PrimaryLanguage != "" {
					<span class="inline-flex items-center gap-1">
						<span class="w-2 h-2 rounded-full" style={ "background:" + components.LangColor(*repo.PrimaryLanguage) } aria-hidden="true"></span>
						{ *repo.PrimaryLanguage }
					</span>
					<span class="opacity-50" aria-hidden="true">·</span>
				}
				<span>Updated <time datetime={ repo.UpdatedAt.UTC().Format(time.RFC3339) }>{ formatRelative(repo.UpdatedAt) }</time></span>
			</div>
			if stars > 0 {
				<div class="flex items-center gap-3 text-[12px] text-muted-foreground shrink-0">
					<span class="inline-flex items-center gap-1" title={ strconv.Itoa(stars) + " stars" }>
						<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
						{ strconv.Itoa(stars) }
					</span>
				</div>
			}
		</div>
	</a>
}

templ userGistsTab(data view.UserData) {
	<section aria-labelledby="gists-tab-heading">
		<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
			<div class="min-w-0">
				<h2 id="gists-tab-heading" class="text-2xl font-semibold tracking-tight">Gists</h2>
				<p class="mt-1 text-[13px] text-muted-foreground">
					{ strconv.Itoa(data.GistsTotal) } { pluralGist(data.GistsTotal) } by { data.User.Username }.
				</p>
			</div>
			if data.IsOwnProfile {
				<a href="/gists/new" class="h-9 px-4 rounded-md font-medium text-sm inline-flex items-center gap-1.5 bg-foreground text-background hover:bg-foreground/90 shrink-0">
					<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"></path></svg>
					New gist
				</a>
			}
		</div>
		if len(data.GistsTabItems) > 0 {
			<section class="border border-border rounded-md bg-card overflow-hidden" aria-label="Gist list">
				<ol class="divide-y divide-border">
					for _, g := range data.GistsTabItems {
						<li>
							@userGistRow(g)
						</li>
					}
				</ol>
			</section>
			@profilePagination(data.GistsTabPage, data.GistsTabTotalPages, "/"+data.User.Username+"?tab=gists")
		} else {
			<div class="border border-border rounded-md bg-card px-5 py-12 text-center text-[13px] text-muted-foreground">
				No gists yet.
			</div>
		}
	</section>
}

templ userGistRow(g view.GistTabItem) {
	<a href={ templ.SafeURL("/gists/" + g.ID) } class={ rowCardClass }>
		<div class="flex items-start gap-3 mb-1.5">
			<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="shrink-0 mt-0.5 text-muted-foreground" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="9" y1="13" x2="15" y2="13"></line><line x1="9" y1="17" x2="13" y2="17"></line></svg>
			<div class="min-w-0 flex-1 flex items-center gap-2 flex-wrap">
				<p class="text-[13.5px] font-medium leading-snug group-hover:underline font-mono">
					if g.Description != "" {
						{ g.Description }
					} else {
						<span class="italic text-muted-foreground">No description</span>
					}
				</p>
				if g.Public {
					<span class="inline-flex items-center h-[20px] px-2 rounded-full border text-[10px] font-medium bg-success/15 text-success border-success/30 shrink-0">Public</span>
				} else {
					<span class="inline-flex items-center h-[20px] px-2 rounded-full border text-[10px] font-medium bg-warning/15 text-warning border-warning/30 shrink-0">Secret</span>
				}
			</div>
		</div>
		<div class="pl-[27px] flex items-center justify-between gap-3">
			<div class="flex items-center gap-1.5 text-[12px] text-muted-foreground min-w-0 flex-wrap">
				<span class="font-mono">{ g.ID[:min(12, len(g.ID))] }</span>
				<span class="opacity-50" aria-hidden="true">·</span>
				<time datetime={ g.UpdatedAt.UTC().Format(time.RFC3339) }>{ formatRelative(g.UpdatedAt) }</time>
				if g.LanguageLabel != "" {
					<span class="opacity-50 mx-0.5" aria-hidden="true">·</span>
					<span class={ g.LanguageClass }>{ g.LanguageLabel }</span>
				}
			</div>
			<div class="flex items-center gap-3 text-[12px] text-muted-foreground shrink-0">
				<span class="inline-flex items-center gap-1" title={ strconv.Itoa(g.FileCount) + " files" }>
					<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
					{ strconv.Itoa(g.FileCount) }
				</span>
			</div>
		</div>
	</a>
}

templ profilePagination(page, totalPages int, baseURL string) {
	if totalPages > 1 {
		<nav class="mt-6 flex items-center justify-between text-[12px]" aria-label="Pagination">
			if page > 1 {
				<a href={ templ.SafeURL(paginationPageURL(baseURL, page-1)) } class="h-8 px-3 border border-border rounded-md hover:bg-accent text-muted-foreground inline-flex items-center gap-1.5">← Newer</a>
			} else {
				<span class="h-8 px-3 border border-border rounded-md text-muted-foreground inline-flex items-center gap-1.5 opacity-50 pointer-events-none" aria-disabled="true">← Newer</span>
			}
			<span class="text-muted-foreground font-mono">page { strconv.Itoa(page) } of { strconv.Itoa(totalPages) }</span>
			if page < totalPages {
				<a href={ templ.SafeURL(paginationPageURL(baseURL, page+1)) } class="h-8 px-3 border border-border rounded-md hover:bg-accent text-muted-foreground inline-flex items-center gap-1.5">Older →</a>
			} else {
				<span class="h-8 px-3 border border-border rounded-md text-muted-foreground inline-flex items-center gap-1.5 opacity-50 pointer-events-none" aria-disabled="true">Older →</span>
			}
		</nav>
	}
}

templ userRepoRow(data view.UserData, repo model.Repository) {
	{{ role := data.RepoTabRoles[repo.ID] }}
	{{ stars := data.RepoTabStars[repo.ID] }}
	<a href={ templ.SafeURL("/" + repo.OwnerName + "/" + repo.Name) } class={ rowCardClass }>
		<div class="flex items-start gap-3 mb-1.5">
			<span class="shrink-0 mt-0.5 text-muted-foreground" aria-hidden="true">
				@repoIcon(repo.Private)
			</span>
			<div class="min-w-0 flex-1 flex items-center gap-2 flex-wrap">
				<p class="text-[13.5px] font-medium leading-snug group-hover:underline">
					{ repo.OwnerName }/{ repo.Name }
				</p>
				if repo.Private {
					<span class="inline-flex items-center h-[20px] px-2 rounded-full border text-[10px] font-medium bg-warning/15 text-warning border-warning/30 shrink-0">Private</span>
				} else {
					<span class="inline-flex items-center h-[20px] px-2 rounded-full border text-[10px] font-medium bg-success/15 text-success border-success/30 shrink-0">Public</span>
				}
				if repo.IsArchived {
					<span class="inline-flex items-center text-[10px] px-1.5 py-0.5 rounded-full border border-border bg-accent text-muted-foreground">Archived</span>
				}
				if repo.IsTemplate {
					<span class="inline-flex items-center text-[10px] px-1.5 py-0.5 rounded-full border bg-warning/15 text-warning border-warning/30">Template</span>
				}
				if repo.IsFork {
					<span class="inline-flex items-center text-[10px] px-1.5 py-0.5 rounded-full border border-border bg-accent text-muted-foreground">Fork</span>
				}
				if role == "owner" {
					<span class="inline-flex items-center text-[10px] px-1.5 py-0.5 rounded-full border bg-blue-500/15 text-blue-400 border-blue-500/30">Owner</span>
				} else if role == "admin" || role == "writer" {
					<span class="inline-flex items-center text-[10px] px-1.5 py-0.5 rounded-full border bg-blue-500/15 text-blue-400 border-blue-500/30">Maintainer</span>
				} else if role == "reader" {
					<span class="inline-flex items-center text-[10px] px-1.5 py-0.5 rounded-full border bg-[hsl(270_70%_70%)]/15 text-[hsl(270_70%_70%)] border-[hsl(270_70%_70%)]/30">Contributor</span>
				}
			</div>
		</div>
		<div class="pl-[27px] flex items-center justify-between gap-3">
			<div class="flex items-center gap-1.5 text-[12px] text-muted-foreground flex-wrap min-w-0">
				if repo.PrimaryLanguage != nil && *repo.PrimaryLanguage != "" {
					<span class="inline-flex items-center gap-1">
						<span class="w-2 h-2 rounded-full" style={ "background:" + components.LangColor(*repo.PrimaryLanguage) } aria-hidden="true"></span>
						{ *repo.PrimaryLanguage }
					</span>
					<span class="opacity-50" aria-hidden="true">·</span>
				}
				<span>Updated <time datetime={ repo.UpdatedAt.UTC().Format(time.RFC3339) }>{ formatRelative(repo.UpdatedAt) }</time></span>
			</div>
			<div class="flex items-center gap-3 text-[12px] text-muted-foreground shrink-0">
				<span class="inline-flex items-center gap-1" title={ strconv.Itoa(stars) + " stars" }>
					<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
					{ strconv.Itoa(stars) }
				</span>
				<span class="inline-flex items-center gap-1" title={ strconv.Itoa(repo.ForkCount) + " forks" }>
					<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="6" cy="3" r="3"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="21" r="3"/><path d="M6 6v9a6 6 0 006 6v0M9 6h6a3 3 0 003-3"/></svg>
					{ strconv.Itoa(repo.ForkCount) }
				</span>
			</div>
		</div>
	</a>
}

func pluralRepo(n int) string {
	if n == 1 {
		return "repository"
	}
	return "repositories"
}

func pluralGist(n int) string {
	if n == 1 {
		return "gist"
	}
	return "gists"
}

func readmeErrorMessage(code string) string {
	switch code {
	case "too_large":
		return "README is too large — keep it under 200 KB."
	case "profile_repo_private":
		return "Your profile repository is private. Make it public to publish a README."
	case "save_failed":
		return "Could not save the README. Please try again."
	default:
		return "Could not save the README."
	}
}

func repoTabURL(data view.UserData, key, val string) string {
	values := url.Values{"tab": []string{"repositories"}}
	params := map[string]string{
		"q":        data.RepoTabActiveQuery,
		"type":     data.RepoTabActiveType,
		"language": data.RepoTabActiveLanguage,
		"status":   data.RepoTabActiveStatus,
	}
	params[key] = val
	for _, k := range []string{"q", "type", "language", "status"} {
		if v := params[k]; v != "" {
			values.Set(k, v)
		}
	}
	return "/" + data.User.Username + "?" + values.Encode()
}

func repoTabPageURL(data view.UserData) string {
	values := url.Values{"tab": []string{"repositories"}}
	for k, v := range map[string]string{
		"q":        data.RepoTabActiveQuery,
		"type":     data.RepoTabActiveType,
		"language": data.RepoTabActiveLanguage,
		"status":   data.RepoTabActiveStatus,
	} {
		if v != "" {
			values.Set(k, v)
		}
	}
	return "/" + data.User.Username + "?" + values.Encode()
}

func paginationPageURL(baseURL string, page int) string {
	sep := "?"
	if strings.Contains(baseURL, "?") {
		sep = "&"
	}
	return baseURL + sep + "page=" + strconv.Itoa(page)
}

func ownedReposForPinning(data view.UserData) []model.Repository {
	out := make([]model.Repository, 0, len(data.Repos))
	for _, r := range data.Repos {
		if r.OwnerID == data.User.ID {
			out = append(out, r)
		}
	}
	return out
}

templ pinReposModal(data view.UserData) {
	{{ owned := ownedReposForPinning(data) }}
	{{ pinnedCount := len(data.PinnedRepos) }}
	{{ atLimit := pinnedCount >= 6 }}
	{{ userIDStr := strconv.FormatInt(data.User.ID, 10) }}
	@components.Dialog("pin-modal") {
		@components.DialogHeader() {
			@components.DialogTitle("pin-modal") {
				Pin repositories
			}
			@components.DialogDescription() {
				Choose up to 6 repositories to feature on your profile. Pinned <span data-pin-count>{ strconv.Itoa(pinnedCount) }</span> / 6.
			}
		}
		@components.DialogBody() {
			if len(owned) == 0 {
				<p class="text-[13px] text-muted-foreground">You don't own any repositories yet.</p>
			} else {
				<ul class="divide-y divide-border max-h-[400px] overflow-y-auto -mx-5" data-pin-list data-pin-initial-count={ strconv.Itoa(pinnedCount) }>
					for _, repo := range owned {
						{{ checked := data.PinnedRepoIDs[repo.ID] }}
						{{ disabled := atLimit && !checked }}
						{{ pinURL := "/api/users/" + userIDStr + "/pinned-repos/" + strconv.FormatInt(repo.ID, 10) }}
						<li class="px-5 py-2.5 flex items-center gap-3">
							<span class="shrink-0 text-muted-foreground" aria-hidden="true">
								@repoIcon(repo.Private)
							</span>
							<div class="min-w-0 flex-1">
								<p class="text-[13px] font-medium leading-snug">{ repo.Name }</p>
								if repo.Description != "" {
									<p class="text-[12px] text-muted-foreground line-clamp-1">{ repo.Description }</p>
								}
							</div>
							<label class="shrink-0 inline-flex items-center cursor-pointer">
								<input
									type="checkbox"
									class="h-4 w-4 cursor-pointer accent-blue-500 disabled:cursor-not-allowed disabled:opacity-50"
									data-pin-toggle
									data-pin-url={ pinURL }
									if checked {
										checked
									}
									if disabled {
										disabled
									}
									aria-label={ "Pin " + repo.Name }
								/>
							</label>
						</li>
					}
				</ul>
				<p data-pin-warn class="mt-3 text-[12px] text-warning" hidden?={ !atLimit }>You've reached the 6-pin limit. Unpin one to add another.</p>
			}
		}
		@components.DialogFooter() {
			<span class="mr-auto text-[12px] text-muted-foreground font-mono">Pinned <span data-pin-count>{ strconv.Itoa(pinnedCount) }</span> / 6</span>
			<form method="dialog" class="contents">
				<button
					type="submit"
					data-pin-close
					class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors border border-input bg-transparent hover:bg-accent hover:text-accent-foreground h-9 px-4"
				>
					Close
				</button>
			</form>
		}
	}
	<script>
		(function() {
			var modal = document.getElementById('pin-modal');
			if (!modal || modal.dataset.pinInit) return;
			modal.dataset.pinInit = '1';
			var MAX = 6;
			var list = modal.querySelector('[data-pin-list]');
			var counter = list ? (parseInt(list.dataset.pinInitialCount, 10) || 0) : 0;
			var dirty = false;
			function csrfToken() {
				return (document.cookie.match(/csrf_token=([^;]+)/) || [])[1] || '';
			}
			function syncLimits() {
				modal.querySelectorAll('[data-pin-toggle]').forEach(function(t) {
					if (!t.checked) { t.disabled = counter >= MAX; }
					else { t.disabled = false; }
				});
				modal.querySelectorAll('[data-pin-count]').forEach(function(el) {
					el.textContent = counter;
				});
				var warn = modal.querySelector('[data-pin-warn]');
				if (warn) warn.hidden = counter < MAX;
			}
			modal.addEventListener('change', function(e) {
				var cb = e.target.closest('[data-pin-toggle]');
				if (!cb) return;
				var delta = cb.checked ? 1 : -1;
				counter += delta;
				syncLimits();
				fetch(cb.dataset.pinUrl, {
					method: cb.checked ? 'POST' : 'DELETE',
					credentials: 'same-origin',
					headers: { 'X-CSRF-Token': csrfToken() }
				})
					.then(function(res) {
						if (!res.ok) {
							cb.checked = !cb.checked;
							counter -= delta;
							syncLimits();
							return;
						}
						dirty = true;
					})
					.catch(function() {
						cb.checked = !cb.checked;
						counter -= delta;
						syncLimits();
					});
			});
			modal.addEventListener('close', function() {
				if (dirty) window.location.reload();
			});
		})();
	</script>
}
