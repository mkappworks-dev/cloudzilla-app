package pages

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ User(data view.UserData) {
	@layout.Base(data.BasePage, data.User.Username) {
		<div class="space-y-8">

			<!-- Profile header -->
			<section class="flex flex-wrap items-start gap-5 pb-6 border-b border-border" aria-labelledby="profile-name">
				@components.Avatar(data.User.Username, components.AvatarSizeLG, data.User.Username)
				<div class="min-w-0 flex-1">
					<h1 id="profile-name" class="text-2xl font-semibold tracking-tight">{ data.User.Username }</h1>
					if data.User.Bio != "" {
						<p class="mt-1.5 text-sm text-muted-foreground max-w-2xl">{ data.User.Bio }</p>
					}
					<dl class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted-foreground">
						if data.User.Email != "" {
							<div class="inline-flex items-center gap-1.5">
								<dt class="sr-only">Email</dt>
								<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><path d="M4 4h16a2 2 0 012 2v12a2 2 0 01-2 2H4a2 2 0 01-2-2V6a2 2 0 012-2z"></path><polyline points="22 6 12 13 2 6"></polyline></svg>
								<dd>{ data.User.Email }</dd>
							</div>
						}
						<div class="inline-flex items-center gap-1.5">
							<dt class="sr-only">Joined</dt>
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
							<dd>Joined <time datetime={ data.User.CreatedAt.UTC().Format(time.RFC3339) }>{ data.User.CreatedAt.Format("Jan 2006") }</time></dd>
						</div>
						if data.User.IsSuperadmin {
							<div>
								@components.Badge(components.BadgeOutline) {
									Superadmin
								}
							</div>
						}
					</dl>
					<nav aria-label="Profile sections" class="mt-4 flex flex-wrap gap-1.5">
						@components.LinkButton("/"+data.User.Username+"/stars", components.ButtonOutline, components.ButtonSizeSM, nil) {
							Starred repos
						}
						@components.LinkButton("/"+data.User.Username+"/gists", components.ButtonOutline, components.ButtonSizeSM, nil) {
							Gists
						}
					</nav>
				</div>
				if data.BasePage.CurrentUser != nil && data.BasePage.CurrentUser.UserID == data.User.ID {
					<div class="flex-shrink-0">
						@components.LinkButton("/new", components.ButtonDefault, components.ButtonSizeSM, nil) {
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"></path></svg>
							New repository
						}
					</div>
				}
			</section>

			if data.ProfileReadme != "" {
				<article class="rounded-md border border-border bg-card overflow-hidden" aria-labelledby="profile-readme-heading">
					<header class="px-5 py-3 border-b border-border bg-muted flex items-center gap-2">
						<svg class="text-muted-foreground" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
						<h2 id="profile-readme-heading" class="text-[13px] font-medium">{ data.User.Username }/README.md</h2>
					</header>
					<div class="prose prose-sm max-w-none dark:prose-invert px-7 py-6">
						@templ.Raw(string(data.ProfileReadme))
					</div>
				</article>
			}

			<section aria-labelledby="repos-heading">
				<h2 id="repos-heading" class="text-xs font-medium text-muted-foreground mb-3 uppercase tracking-wider font-mono">
					Repositories
					<span class="ml-1 text-foreground/80" aria-label={ "Total: " + strconv.Itoa(len(data.Repos)) }>{ strconv.Itoa(len(data.Repos)) }</span>
				</h2>

				if len(data.Repos) > 0 {
					<div class="rounded-md border border-border bg-card overflow-hidden">
						@components.Table(nil) {
							@components.TableCaption(templ.Attributes{"class": "sr-only"}) {
								Repositories owned by { data.User.Username }
							}
							@components.TableHeader() {
								@components.TableRow(false) {
									@components.TableHead(templ.Attributes{"scope": "col", "class": "w-10"}) {
										<span class="sr-only">Visibility</span>
									}
									@components.TableHead(templ.Attributes{"scope": "col"}) {
										Name
									}
									@components.TableHead(templ.Attributes{"scope": "col", "class": "text-right"}) {
										Updated
									}
								}
							}
							@components.TableBody() {
								for _, repo := range data.Repos {
									@components.TableRow(true) {
										@components.TableCell(templ.Attributes{"class": "w-10"}) {
											@repoIcon(repo.Private)
										}
										@components.TableRowHead(nil) {
											<a href={ templ.SafeURL("/" + repo.OwnerName + "/" + repo.Name) } class="text-sm hover:underline font-medium">
												{ repo.Name }
											</a>
											if repo.Private {
												<span class="ml-2 align-middle">
													@components.Badge(components.BadgeOutline) {
														Private
													}
												</span>
											}
											if repo.IsArchived {
												<span class="ml-2 align-middle">
													@components.Badge(components.BadgeDraft) {
														Archived
													}
												</span>
											}
											if repo.IsFork {
												<span class="ml-2 align-middle">
													@components.Badge(components.BadgeOutline) {
														Fork
													}
												</span>
											}
											if repo.Description != "" {
												<p class="text-[12px] text-muted-foreground mt-0.5 font-normal">{ repo.Description }</p>
											}
										}
										@components.TableCell(templ.Attributes{"class": "text-right text-xs text-muted-foreground font-mono whitespace-nowrap"}) {
											<time datetime={ repo.UpdatedAt.UTC().Format(time.RFC3339) }>
												{ repo.UpdatedAt.Format("Jan 2, 2006") }
											</time>
										}
									}
								}
							}
						}
					</div>
				} else {
					@components.EmptyState("No repositories.")
				}
			</section>
		</div>
	}
}
