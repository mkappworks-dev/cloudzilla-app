package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/model"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ backToSignIn() {
	<p class="mt-5 text-center text-[12px] text-muted-foreground">
		<a href="/login" class="text-foreground hover:underline">Back to sign in</a>
	</p>
}

templ authError(msg string) {
	if msg != "" {
		<div class="mb-4 p-3 rounded-md border border-destructive/40 bg-destructive/10 text-destructive text-sm" role="alert">{ msg }</div>
	}
}

templ ForgotPassword(data view.ForgotPasswordData) {
	@layout.Base(data.BasePage, "Reset your password") {
		<div class="max-w-md mx-auto mt-12 rounded-md border border-border bg-card p-6">
			if !data.Available {
				@authCardHero("Cloudzilla", "Reset your password", "This instance can't send email. Ask an administrator for a reset link.")
			} else if data.Sent {
				@authCardHero("Cloudzilla", "Check your inbox", "If an account uses that address, we've emailed it a link to reset its password. If nothing arrives, check your spam folder or try again in a few minutes.")
			} else {
				@authCardHero("Cloudzilla", "Reset your password", "Enter your account's email address and we'll send you a link to choose a new password.")
				@authError(data.Error)
				<form method="POST" action="/auth/password/forgot" class="space-y-4">
					<div class="space-y-1.5">
						<label for="forgot-email" class="block text-sm font-medium">Email</label>
						@components.Input(templ.Attributes{
							"type":         "email",
							"id":           "forgot-email",
							"name":         "email",
							"required":     "required",
							"autofocus":    "autofocus",
							"autocomplete": "email",
							"value":        data.Email,
						})
					</div>
					@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit", "class": "w-full"}) {
						Send reset link
					}
				</form>
			}
			@backToSignIn()
		</div>
	}
}

templ ResetPassword(data view.ResetPasswordData) {
	@layout.Base(data.BasePage, "Choose a new password") {
		<div class="max-w-md mx-auto mt-12 rounded-md border border-border bg-card p-6">
			switch data.Link.State {
				case model.PasswordResetPending:
					@authCardHero("Cloudzilla", "Choose a new password", "")
					<p class="-mt-4 mb-6 text-center text-[13px] text-muted-foreground">
						{ "for " }<span class="font-medium text-foreground">{ "@" + data.Link.Username }</span>
						<span class="font-mono">{ "(" + data.Link.Email + ")" }</span>
					</p>
					@authError(data.Error)
					<form method="POST" class="space-y-4">
						<input type="text" name="username" value={ data.Link.Email } autocomplete="username" class="hidden" aria-hidden="true" tabindex="-1" readonly="readonly"/>
						<div class="space-y-1.5">
							<label for="reset-password" class="block text-sm font-medium">New password</label>
							@components.PasswordInput(templ.Attributes{
								"id":           "reset-password",
								"name":         "password",
								"required":     "required",
								"minlength":    "8",
								"autofocus":    "autofocus",
								"autocomplete": "new-password",
								"class":        authPasswordClass,
							})
						</div>
						<div class="space-y-1.5">
							<label for="reset-confirm" class="block text-sm font-medium">Confirm new password</label>
							@components.PasswordInput(templ.Attributes{
								"id":           "reset-confirm",
								"name":         "confirm",
								"required":     "required",
								"minlength":    "8",
								"autocomplete": "new-password",
								"class":        authPasswordClass,
							})
						</div>
						if data.Link.TOTPEnabled {
							<div class="space-y-1.5">
								<label for="reset-code" class="block text-sm font-medium">Two-factor code</label>
								@components.Input(templ.Attributes{
									"type":         "text",
									"id":           "reset-code",
									"name":         "code",
									"required":     "required",
									"autocomplete": "one-time-code",
									"spellcheck":   "false",
								})
								<p class="text-[12px] text-muted-foreground">A code from your authenticator app, or a backup code.</p>
							</div>
						}
						@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit", "class": "w-full"}) {
							Change password
						}
					</form>
				case model.PasswordResetExpired:
					@authCardHero("Cloudzilla", "This link has expired", "Request a new password reset link.")
					@components.LinkButton("/auth/password/forgot", components.ButtonOutline, components.ButtonSizeDefault, templ.Attributes{"class": "w-full"}) {
						Request a new link
					}
				default:
					@authCardHero("Cloudzilla", "This link isn't valid", "It may have been used already or replaced by a newer link, or the account's password or email changed since it was sent.")
					@components.LinkButton("/auth/password/forgot", components.ButtonOutline, components.ButtonSizeDefault, templ.Attributes{"class": "w-full"}) {
						Request a new link
					}
			}
			@backToSignIn()
		</div>
	}
}
