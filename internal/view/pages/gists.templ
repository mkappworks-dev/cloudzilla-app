package pages

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Gists(data view.GistsData) {
	@layout.Base(data.BasePage, "Explore Gists") {
		<div class="max-w-4xl mx-auto py-8 px-4">
			<div class="flex items-center justify-between mb-6">
				<h1 class="text-2xl font-bold">Explore Gists</h1>
				if data.CurrentUser != nil {
					@components.LinkButton("/gists/new", components.ButtonSuccess, components.ButtonSizeDefault, nil) {
						New Gist
					}
				}
			</div>
			if len(data.Gists) > 0 {
				<ul class="space-y-4">
					for _, g := range data.Gists {
						<li class="rounded-md border border-border bg-card p-4">
							<div class="flex items-center justify-between mb-1">
								<a href={ templ.SafeURL("/gists/" + g.ID) } class="text-foreground hover:underline font-medium">
									if g.Description != "" {
										{ g.Description }
									} else {
										<span class="text-muted-foreground italic">No description</span>
									}
								</a>
								<span class="text-xs text-muted-foreground">
									if g.Public {
										Public
									} else {
										Secret
									}
								</span>
							</div>
							<div class="text-sm text-muted-foreground">
								by <a href={ templ.SafeURL("/" + g.OwnerName) } class="hover:underline">{ g.OwnerName }</a>
								&middot; <time datetime={ g.CreatedAt.UTC().Format(time.RFC3339) }>{ g.CreatedAt.Format("Jan 2, 2006") }</time>
							</div>
						</li>
					}
				</ul>
				{{ gistPrev := "" }}
				if data.Page > 1 {
					{{ gistPrev = "?page=" + strconv.Itoa(data.Page-1) }}
				}
				@components.Pagination(gistPrev, "?page=" + strconv.Itoa(data.Page+1))
			} else {
				@components.EmptyState("No public gists yet.")
			}
		</div>
	}
}
