package pages

import (
	"fmt"
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Gists(data view.GistsData) {
	@layout.Base(data.BasePage, "Explore Gists") {
		<div class="space-y-5">

			<section class="flex flex-wrap items-start justify-between gap-4" aria-labelledby="gists-title">
				<div class="min-w-0">
					<h1 id="gists-title" class="text-2xl font-semibold tracking-tight">Explore gists</h1>
					<p class="mt-0.5 text-[13px] text-muted-foreground">Snippets, scratch notes, and standalone files — public and discoverable.</p>
				</div>
				if data.CurrentUser != nil {
					@components.LinkButton("/gists/new", components.ButtonSuccess, components.ButtonSizeDefault, nil) {
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" focusable="false">
							<path d="M12 5v14M5 12h14"></path>
						</svg>
						New gist
					}
				}
			</section>

			if data.PrivateTabAvailable {
				@components.TabBar([]components.Tab{
					{Label: "Public", URL: "/gists?tab=public", IsActive: data.Tab == "public", Count: -1},
					{Label: "Private", URL: "/gists?tab=private", IsActive: data.Tab == "private", Count: -1},
				})
			}

			if len(data.Gists) > 0 {
				<section class="rounded-md border border-border bg-card overflow-hidden" aria-labelledby="gist-list">
					<h2 id="gist-list" class="sr-only">
						if data.Tab == "private" {
							Private gists
						} else {
							Public gists
						}
					</h2>
					<ol class="divide-y divide-border">
						for _, g := range data.Gists {
							<li>
								<a href={ templ.SafeURL("/gists/" + g.ID) } class="relative block px-4 py-3 hover:bg-accent group transition-[padding] hover:pl-[18px] before:content-[''] before:absolute before:left-0 before:top-2 before:bottom-2 before:w-[2px] before:bg-foreground before:opacity-0 hover:before:opacity-100 before:transition-opacity before:rounded-sm">
									<div class="flex items-start gap-3 mb-1.5">
										if g.Public {
											<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="shrink-0 mt-0.5 text-muted-foreground" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>
										} else {
											<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="shrink-0 mt-0.5 text-warning" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
										}
										<div class="min-w-0 flex-1 flex items-center gap-2 flex-wrap">
											<p class="text-[13.5px] font-medium leading-snug group-hover:underline">
												if g.Description != "" {
													{ g.Description }
												} else {
													<span class="italic text-muted-foreground">No description</span>
												}
											</p>
											<span class="shrink-0">
												if g.Public {
													@components.Badge(components.BadgeSuccess) {
														Public
													}
												} else {
													@components.Badge(components.BadgeWarning) {
														Private
													}
												}
											</span>
										</div>
									</div>
									<div class="flex items-center justify-between gap-3 pl-[27px]">
										<div class="flex items-center gap-1.5 text-[12px] text-muted-foreground/70 min-w-0 flex-wrap">
											<span class="font-mono">{ g.ID[:min(12, len(g.ID))] }</span>
											<span class="opacity-50" aria-hidden="true">·</span>
											@components.Avatar(g.OwnerName, components.AvatarSizeXS, "")
											<span class="hover:text-foreground">{ g.OwnerName }</span>
											<span class="opacity-50" aria-hidden="true">·</span>
											<time datetime={ g.UpdatedAt.UTC().Format(time.RFC3339) }>{ g.UpdatedAt.Format("Jan 2, 2006") }</time>
											if g.LanguageLabel != "" {
												<span class="opacity-50 mx-0.5" aria-hidden="true">·</span>
												<span class={ g.LanguageClass }>{ g.LanguageLabel }</span>
											}
										</div>
										<div class="flex items-center gap-3 text-[12px] shrink-0">
											<span class="text-muted-foreground/70 inline-flex items-center gap-1" title={ fmt.Sprintf("%d files", g.FileCount) }>
												<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
												{ strconv.FormatInt(g.FileCount, 10) }
											</span>
											if g.Public {
												<span class="text-muted-foreground/70 inline-flex items-center gap-1" title={ fmt.Sprintf("%d stars", g.StarCount) }>
													<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
													{ strconv.FormatInt(g.StarCount, 10) }
												</span>
												<span class="text-muted-foreground/70 inline-flex items-center gap-1" title={ fmt.Sprintf("%d forks", g.ForkCount) }>
													<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="6" cy="3" r="3"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="21" r="3"/><path d="M6 6v9a6 6 0 006 6v0M9 6h6a3 3 0 003-3"/></svg>
													{ strconv.FormatInt(g.ForkCount, 10) }
												</span>
											} else {
												<span class="text-muted-foreground/70 inline-flex items-center gap-1 opacity-50" title="Private — no stars">
													<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
													—
												</span>
												<span class="text-muted-foreground/70 inline-flex items-center gap-1 opacity-50" title="Private — no forks">
													<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="6" cy="3" r="3"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="21" r="3"/><path d="M6 6v9a6 6 0 006 6v0M9 6h6a3 3 0 003-3"/></svg>
													—
												</span>
											}
										</div>
									</div>
								</a>
							</li>
						}
					</ol>
				</section>

				{{ gistPrev := "" }}
				if data.Page > 1 {
					{{ gistPrev = "?tab=" + data.Tab + "&page=" + strconv.Itoa(data.Page-1) }}
				}
				{{ gistNext := "" }}
				if data.HasNext {
					{{ gistNext = "?tab=" + data.Tab + "&page=" + strconv.Itoa(data.Page+1) }}
				}
				@components.Pagination(gistPrev, gistNext)
			} else {
				@components.EmptyState("No gists yet.")
			}
		</div>
	}
}
