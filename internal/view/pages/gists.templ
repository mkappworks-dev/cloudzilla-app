package pages

import (
	"strconv"

	"github.com/mkappworks/cloudzilla/internal/view"
	"github.com/mkappworks/cloudzilla/internal/view/components"
	"github.com/mkappworks/cloudzilla/internal/view/layout"
)

templ Gists(data view.GistsData) {
	@layout.Base(data.BasePage, "Explore Gists") {
		<div class="max-w-4xl mx-auto py-8 px-4">
			<div class="flex items-center justify-between mb-6">
				<h1 class="text-2xl font-bold">Explore Gists</h1>
				if data.CurrentUser != nil {
					<a href="/gists/new" class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 text-sm font-medium">New Gist</a>
				}
			</div>
			if len(data.Gists) > 0 {
				<ul class="space-y-4">
					for _, g := range data.Gists {
						<li class="border border-gray-200 rounded p-4">
							<div class="flex items-center justify-between mb-1">
								<a href={ templ.SafeURL("/gists/" + g.ID) } class="text-blue-600 hover:underline font-medium">
									if g.Description != "" {
										{ g.Description }
									} else {
										<span class="text-gray-400 italic">No description</span>
									}
								</a>
								<span class="text-xs text-gray-400">
									if g.Public {
										Public
									} else {
										Secret
									}
								</span>
							</div>
							<div class="text-sm text-gray-500">
								by <a href={ templ.SafeURL("/" + g.OwnerName) } class="hover:underline">{ g.OwnerName }</a>
								&middot; { g.CreatedAt.Format("Jan 2, 2006") }
							</div>
						</li>
					}
				</ul>
				{{ gistPrev := "" }}
				if data.Page > 1 {
					{{ gistPrev = "?page=" + strconv.Itoa(data.Page-1) }}
				}
				@components.Pagination(gistPrev, "?page=" + strconv.Itoa(data.Page+1))
			} else {
				@components.EmptyState("No public gists yet.")
			}
		</div>
	}
}
