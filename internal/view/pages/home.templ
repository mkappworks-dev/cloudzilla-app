package pages

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Home(data view.HomeData) {
	@layout.Base(data.BasePage, "Repositories") {
		<div class="space-y-8">

			<div>
				<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-1.5">Overview</p>
				<h1 class="text-2xl font-semibold tracking-tight">Repositories</h1>
			</div>

			<nav aria-label="Quick links" class="flex flex-wrap gap-1.5">
				@components.LinkButton("/explore", components.ButtonOutline, components.ButtonSizeSM, nil) {
					Explore
				}
				@components.LinkButton("/gists", components.ButtonOutline, components.ButtonSizeSM, nil) {
					Gists
				}
				if data.BasePage.CurrentUser != nil {
					@components.LinkButton("/feed", components.ButtonOutline, components.ButtonSizeSM, nil) {
						Activity feed
					}
					@components.LinkButton("/notifications", components.ButtonOutline, components.ButtonSizeSM, nil) {
						Notifications
					}
					@components.LinkButton("/"+data.BasePage.CurrentUser.Username, components.ButtonOutline, components.ButtonSizeSM, nil) {
						Your profile
					}
					@components.LinkButton("/settings", components.ButtonOutline, components.ButtonSizeSM, nil) {
						Settings
					}
				}
			</nav>

			if len(data.Repos) > 0 {
				<section aria-labelledby="repos-heading">
					<h2 id="repos-heading" class="sr-only">Your repositories</h2>
					<div class="rounded-md border border-border bg-card overflow-hidden">
						@components.Table(nil) {
							@components.TableCaption(templ.Attributes{"class": "sr-only"}) {
								Your repositories, sorted by most recently updated
							}
							@components.TableHeader() {
								@components.TableRow(false) {
									@components.TableHead(templ.Attributes{"scope": "col", "class": "w-10"}) {
										<span class="sr-only">Visibility</span>
									}
									@components.TableHead(templ.Attributes{"scope": "col"}) {
										Name
									}
									@components.TableHead(templ.Attributes{"scope": "col", "class": "text-right"}) {
										Updated
									}
								}
							}
							@components.TableBody() {
								for _, repo := range data.Repos {
									@components.TableRow(true) {
										@components.TableCell(templ.Attributes{"class": "w-10"}) {
											@repoIcon(repo.Private)
										}
										@components.TableRowHead(nil) {
											<a href={ templ.SafeURL("/" + repo.OwnerName + "/" + repo.Name) } class="text-sm hover:underline">
												{ repo.OwnerName }<span class="text-muted-foreground mx-1" aria-hidden="true">/</span>{ repo.Name }
											</a>
											if repo.Private {
												<span class="ml-2 align-middle">
													@components.Badge(components.BadgeOutline) {
														Private
													}
												</span>
											}
											if repo.IsArchived {
												<span class="ml-2 align-middle">
													@components.Badge(components.BadgeDraft) {
														Archived
													}
												</span>
											}
											if repo.IsTemplate {
												<span class="ml-2 align-middle">
													@components.Badge(components.BadgeOutline) {
														Template
													}
												</span>
											}
											if repo.Description != "" {
												<p class="text-[12px] text-muted-foreground mt-0.5 font-normal">{ repo.Description }</p>
											}
										}
										@components.TableCell(templ.Attributes{"class": "text-right text-xs text-muted-foreground font-mono whitespace-nowrap"}) {
											<time datetime={ repo.UpdatedAt.UTC().Format(time.RFC3339) }>
												{ repo.UpdatedAt.Format("Jan 2, 2006") }
											</time>
										}
									}
								}
							}
						}
					</div>
				</section>
			} else {
				@components.EmptyState("No repositories yet.")
			}

			if len(data.Templates) > 0 {
				<section aria-labelledby="templates-heading">
					<h2 id="templates-heading" class="text-[13px] font-medium mb-3">Start from a template</h2>
					<div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
						for _, tmpl := range data.Templates {
							@components.Card(nil) {
								@components.CardContent() {
									<p class="text-sm font-medium">
										{ tmpl.OwnerName }<span class="text-muted-foreground mx-1" aria-hidden="true">/</span>{ tmpl.Name }
									</p>
									if tmpl.Description != "" {
										<p class="text-xs text-muted-foreground mt-1">{ tmpl.Description }</p>
									}
									if data.BasePage.CurrentUser != nil {
										<form method="POST" action="/api/repos/from-template" class="mt-3 space-y-2">
											<input type="hidden" name="template_repo_id" value={ strconv.FormatInt(tmpl.ID, 10) }/>
											<label for={ "tmpl-name-" + strconv.FormatInt(tmpl.ID, 10) } class="sr-only">
												New repository name from { tmpl.Name }
											</label>
											@components.Input(templ.Attributes{
												"id":          "tmpl-name-" + strconv.FormatInt(tmpl.ID, 10),
												"type":        "text",
												"name":        "name",
												"placeholder": "New repo name",
												"required":    "required",
											})
											@components.Button(components.ButtonDefault, components.ButtonSizeSM, templ.Attributes{"type": "submit", "class": "w-full"}) {
												Use this template
											}
										</form>
									}
								}
							}
						}
					</div>
				</section>
			}
		</div>
	}
}

// repoIcon renders a small visibility icon for a repo row.
// `role="img"` + <title> announces "Public/Private repository" to screen readers.
templ repoIcon(private bool) {
	if private {
		<svg class="text-muted-foreground" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" role="img" focusable="false">
			<title>Private repository</title>
			<rect x="3" y="11" width="18" height="11" rx="2"></rect>
			<path d="M7 11V7a5 5 0 0110 0v4"></path>
		</svg>
	} else {
		<svg class="text-muted-foreground" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" role="img" focusable="false">
			<title>Public repository</title>
			<rect x="3" y="3" width="18" height="18" rx="2"></rect>
		</svg>
	}
}
