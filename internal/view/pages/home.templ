package pages

import (
	"fmt"
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/model"
	"github.com/mkappworks-dev/cloudzilla-app/internal/service"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Home(data view.HomeData) {
	@layout.Base(data.BasePage, "Overview") {
		<div class="space-y-10">

			<div class="flex items-end justify-between">
				<div>
					<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-1.5">Overview</p>
					if data.BasePage.CurrentUser != nil {
						<h1 class="text-2xl font-semibold tracking-tight">{ data.BasePage.CurrentUser.Username }</h1>
					} else {
						<h1 class="text-2xl font-semibold tracking-tight">Repositories</h1>
					}
				</div>
				if data.BasePage.CurrentUser != nil {
					<div class="flex items-center gap-1.5">
						@components.LinkButton("/repos/new", components.ButtonDefault, components.ButtonSizeSM, nil) {
							New repository
						}
					</div>
				}
			</div>

			if len(data.Stats) > 0 {
				<section aria-labelledby="stats-heading">
					<h2 id="stats-heading" class="sr-only">Workspace statistics</h2>
					@components.StatStrip(data.Stats)
				</section>
			}

			<div class="grid lg:grid-cols-[1fr_320px] gap-8">
				<div class="space-y-10">

					if len(data.Repos) > 0 {
						<section aria-labelledby="repos-heading">
							<div class="flex items-center justify-between mb-4">
								<h2 id="repos-heading" class="text-[13px] font-medium">Repositories</h2>
								@components.LinkButton("/explore", components.ButtonOutline, components.ButtonSizeSM, nil) {
									Explore
								}
							</div>
							<div class="rounded-md border border-border bg-card overflow-hidden">
								@components.Table(nil) {
									@components.TableCaption(templ.Attributes{"class": "sr-only"}) {
										Your repositories, sorted by most recently updated
									}
									@components.TableHeader() {
										@components.TableRow(false) {
											@components.TableHead(templ.Attributes{"scope": "col", "class": "w-10"}) {
												<span class="sr-only">Visibility</span>
											}
											@components.TableHead(templ.Attributes{"scope": "col"}) {
												Name
											}
											@components.TableHead(templ.Attributes{"scope": "col", "class": "text-right"}) {
												Updated
											}
										}
									}
									@components.TableBody() {
										for _, repo := range data.Repos {
											@components.TableRow(true) {
												@components.TableCell(templ.Attributes{"class": "w-10"}) {
													@repoIcon(repo.Private)
												}
												@components.TableRowHead(nil) {
													<a href={ templ.SafeURL("/" + repo.OwnerName + "/" + repo.Name) } class="text-sm hover:underline">
														{ repo.OwnerName }<span class="text-muted-foreground mx-1" aria-hidden="true">/</span>{ repo.Name }
													</a>
													if repo.Private {
														<span class="ml-2 align-middle">
															@components.Badge(components.BadgeOutline) {
																Private
															}
														</span>
													}
													if repo.IsArchived {
														<span class="ml-2 align-middle">
															@components.Badge(components.BadgeDraft) {
																Archived
															}
														</span>
													}
													if repo.IsTemplate {
														<span class="ml-2 align-middle">
															@components.Badge(components.BadgeOutline) {
																Template
															}
														</span>
													}
													if repo.Description != "" {
														<p class="text-[12px] text-muted-foreground mt-0.5 font-normal">{ repo.Description }</p>
													}
												}
												@components.TableCell(templ.Attributes{"class": "text-right text-xs text-muted-foreground font-mono whitespace-nowrap"}) {
													<time datetime={ repo.UpdatedAt.UTC().Format(time.RFC3339) }>
														{ repo.UpdatedAt.Format("Jan 2, 2006") }
													</time>
												}
											}
										}
									}
								}
							</div>
						</section>
					} else {
						@components.EmptyState("No repositories yet.")
					}

					if len(data.Attention) > 0 {
						<section aria-labelledby="attention-heading">
							<div class="flex items-center justify-between mb-4">
								<h2 id="attention-heading" class="text-[13px] font-medium">Needs your attention</h2>
							</div>
							<ul class="rounded-md border border-border bg-card divide-y divide-border">
								for _, item := range data.Attention {
									<li>
										<a href={ templ.SafeURL(attentionItemURL(item)) } class="flex items-center gap-3 px-4 py-3 hover:bg-muted/40 transition">
											<span class="flex-shrink-0 text-muted-foreground" aria-hidden="true">
												@attentionKindIcon(item.Kind)
											</span>
											<div class="min-w-0 flex-1">
												<p class="text-[13px] truncate">{ item.Title }</p>
												<p class="text-[11px] text-muted-foreground mt-0.5">
													<a href={ templ.SafeURL(attentionRepoURL(item)) } class="font-mono hover:underline">{ item.RepoName }</a>
													<span aria-hidden="true">{ " · " }</span>
													<span class="font-mono">{ "#" + strconv.Itoa(item.Number) }</span>
													<span aria-hidden="true">{ " · " }</span>
													<time datetime={ item.UpdatedAt.UTC().Format(time.RFC3339) }>{ formatRelative(item.UpdatedAt) }</time>
												</p>
											</div>
										</a>
									</li>
								}
							</ul>
						</section>
					}

					if data.Heatmap != nil {
						<section aria-labelledby="commits-heading">
							<div class="flex items-center justify-between mb-4">
								<h2 id="commits-heading" class="text-[13px] font-medium">Contribution activity</h2>
								<span class="text-[12px] text-muted-foreground">Last 52 weeks</span>
							</div>
							<div class="rounded-md border border-border bg-card p-5 overflow-x-auto">
								@components.Heatmap(data.Heatmap, time.Now(), 52)
							</div>
						</section>
					}
				</div>

				<aside class="space-y-8" aria-label="Sidebar">

					if len(data.Activity) > 0 {
						<section aria-labelledby="activity-heading">
							<div class="flex items-center justify-between mb-3">
								<h3 id="activity-heading" class="text-[13px] font-medium">Recent activity</h3>
								<a href="/feed" class="text-[12px] text-muted-foreground hover:text-foreground">All<span aria-hidden="true"> →</span><span class="sr-only"> activity</span></a>
							</div>
							@components.Timeline("Recent activity") {
								for _, ev := range data.Activity {
									@components.TimelineEntry(eventTimelineKind(ev.EventType), ev.ActorName, formatRelative(ev.CreatedAt)) {
										<p class="text-xs text-muted-foreground mt-0.5">
											{ eventTimelineDetail(ev) }
										</p>
									}
								}
							}
						</section>
					}

					if len(data.Templates) > 0 {
						<section aria-labelledby="templates-heading">
							<div class="flex items-center justify-between mb-3">
								<h3 id="templates-heading" class="text-[13px] font-medium">Start from a template</h3>
							</div>
							<ul class="rounded-md border border-border bg-card divide-y divide-border">
								for _, tmpl := range data.Templates {
									<li>
										<div class="px-3 py-2.5">
											<p class="text-[12px] truncate">
												{ tmpl.OwnerName }<span class="text-muted-foreground mx-1" aria-hidden="true">/</span>{ tmpl.Name }
											</p>
											if tmpl.Description != "" {
												<p class="text-[11px] text-muted-foreground truncate mt-0.5">{ tmpl.Description }</p>
											}
											if data.BasePage.CurrentUser != nil {
												<form method="POST" action="/api/repos/from-template" class="mt-2 space-y-2">
													<input type="hidden" name="template_repo_id" value={ strconv.FormatInt(tmpl.ID, 10) }/>
													<label for={ "tmpl-name-" + strconv.FormatInt(tmpl.ID, 10) } class="sr-only">
														New repository name from { tmpl.Name }
													</label>
													@components.Input(templ.Attributes{
														"id":          "tmpl-name-" + strconv.FormatInt(tmpl.ID, 10),
														"type":        "text",
														"name":        "name",
														"placeholder": "New repo name",
														"required":    "required",
													})
													@components.Button(components.ButtonDefault, components.ButtonSizeSM, templ.Attributes{"type": "submit", "class": "w-full"}) {
														Use this template
													}
												</form>
											}
										</div>
									</li>
								}
							</ul>
						</section>
					}
				</aside>
			</div>
		</div>
	}
}

// repoIcon renders a small visibility icon for a repo row.
// `role="img"` + <title> announces "Public/Private repository" to screen readers.
templ repoIcon(private bool) {
	if private {
		<svg class="text-muted-foreground" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" role="img" focusable="false">
			<title>Private repository</title>
			<rect x="3" y="11" width="18" height="11" rx="2"></rect>
			<path d="M7 11V7a5 5 0 0110 0v4"></path>
		</svg>
	} else {
		<svg class="text-muted-foreground" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" role="img" focusable="false">
			<title>Public repository</title>
			<rect x="3" y="3" width="18" height="18" rx="2"></rect>
		</svg>
	}
}

// attentionKindIcon renders a small SVG for an attention list row.
// Phase 1 only emits AttentionIssueAssigned, but the switch is here so
// later phases can add review-requested and mention rows without
// reworking the template structure.
templ attentionKindIcon(kind service.AttentionKind) {
	switch kind {
		case service.AttentionIssueAssigned:
			<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
				<circle cx="12" cy="12" r="9"></circle>
				<path d="M12 7v5l3 2"></path>
			</svg>
		default:
			<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
				<circle cx="12" cy="12" r="9"></circle>
			</svg>
	}
}

// formatRelative renders a coarse "5 minutes ago" / "2 hours ago" /
// "3 days ago" string. Buckets are deliberately rough — anything beyond
// a week falls back to an absolute date.
func formatRelative(t time.Time) string {
	d := time.Since(t)
	switch {
	case d < time.Minute:
		return "just now"
	case d < time.Hour:
		m := int(d / time.Minute)
		if m == 1 {
			return "1 minute ago"
		}
		return strconv.Itoa(m) + " minutes ago"
	case d < 24*time.Hour:
		h := int(d / time.Hour)
		if h == 1 {
			return "1 hour ago"
		}
		return strconv.Itoa(h) + " hours ago"
	case d < 7*24*time.Hour:
		days := int(d / (24 * time.Hour))
		if days == 1 {
			return "1 day ago"
		}
		return strconv.Itoa(days) + " days ago"
	default:
		return t.Format("Jan 2, 2006")
	}
}

// attentionRepoURL returns the canonical URL for the repository
// hosting an attention item (e.g. "/alice/cloudzilla").
func attentionRepoURL(item service.AttentionItem) string {
	return "/" + item.RepoName
}

// attentionItemURL returns the canonical URL for the underlying
// issue/PR of an attention item. Phase 1 only emits issue rows.
func attentionItemURL(item service.AttentionItem) string {
	return "/" + item.RepoName + "/issues/" + strconv.Itoa(item.Number)
}

// eventTimelineKind maps a model.Event.EventType string onto a
// TimelineEntryKind for icon/variant selection.
//
// This is intentionally lossy — many event types (push, fork, star,
// release_published, member_added, …) do not map cleanly to a
// TimelineEntryKind. They fall through to TimelineEntryComment so the
// row still renders. A follow-up phase will refine the mapping (likely
// by extending the kind enum rather than expanding this switch).
func eventTimelineKind(eventType string) components.TimelineEntryKind {
	switch eventType {
	case model.EventIssueClosed, model.EventPRClosed:
		return components.TimelineEntryClosed
	case model.EventPRMerged:
		return components.TimelineEntryMerged
	case model.EventIssueOpened, model.EventPROpened:
		return components.TimelineEntryReopened
	default:
		return components.TimelineEntryComment
	}
}

// eventTimelineDetail renders the short repo/scope hint shown below
// the actor + verb line in the activity sidebar (e.g. "cloudzilla").
func eventTimelineDetail(ev model.Event) string {
	if ev.RepoName == "" {
		return ""
	}
	if ev.OwnerName == "" {
		return ev.RepoName
	}
	return fmt.Sprintf("%s/%s", ev.OwnerName, ev.RepoName)
}
