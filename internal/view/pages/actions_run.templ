package pages

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/assets"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

const (
	runBtnOutline     = "inline-flex items-center justify-center gap-1.5 rounded-md font-medium transition-colors border border-input bg-transparent hover:bg-accent hover:text-accent-foreground h-8 px-3 text-[13px]"
	runBtnDanger      = "inline-flex items-center justify-center gap-1.5 rounded-md font-medium transition-colors border border-destructive/40 text-destructive bg-transparent hover:bg-destructive/10 hover:border-destructive h-8 px-3 text-[13px]"
	runMenuItem       = "flex w-full items-center gap-2 px-2 py-1.5 rounded-xs text-left hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground focus:outline-hidden"
	runDownloadButton = "h-8 px-3 text-[13px] border border-border rounded-md hover:bg-accent inline-flex items-center gap-1.5"
)

func runBadgeClass(status string) string {
	base := "inline-flex items-center gap-1.5 h-[22px] px-2 rounded-full border text-[11px] font-medium "
	switch status {
	case "waiting", "running":
		return base + "bg-warning/15 text-warning border-warning/30"
	case "failure":
		return base + "bg-destructive/15 text-destructive border-destructive/30"
	case "success":
		return base + "bg-success/15 text-success border-success/30"
	}
	return base + "bg-muted text-muted-foreground border-transparent"
}

templ ActionsRun(d view.ActionsRunData) {
	@layout.Base(d.BasePage, d.WorkflowName+" #"+strconv.Itoa(d.Number)+" · Actions · "+d.Owner+"/"+d.RepoName) {
		<div class="flex flex-col gap-6">
			<section aria-labelledby="run-title">
				<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">
					<a href={ templ.SafeURL("/" + d.Owner + "/" + d.RepoName) } class="hover:underline">{ d.RepoName }</a>
					<span aria-hidden="true">›</span>
					<a href={ templ.SafeURL(d.ListURL) } class="hover:underline">Actions</a>
					<span aria-hidden="true">›</span>
					<a href={ templ.SafeURL(d.ListURL + "?workflow=" + d.WorkflowPath) } class="hover:underline">{ d.WorkflowName }</a>
					<span aria-hidden="true">›</span>
					<span aria-current="page">#{ strconv.Itoa(d.Number) }</span>
				</p>
				<div class="flex flex-wrap items-start justify-between gap-3">
					<div class="flex flex-wrap items-center gap-2 min-w-0">
						<h1 id="run-title" class="text-2xl font-semibold tracking-tight min-w-0">{ d.Title }</h1>
						<span class={ runBadgeClass(d.Status) }>{ d.StatusLabel }</span>
					</div>
					@runControls(d)
				</div>
				<p class="mt-2 text-[13px] text-muted-foreground flex flex-wrap items-center gap-x-1.5 gap-y-1">
					<span class="font-medium text-foreground">{ d.WorkflowName }</span>
					<a href={ templ.SafeURL(d.WorkflowURL) } class="font-mono hover:text-foreground hover:underline">{ d.WorkflowPath }</a>
					<span aria-hidden="true">·</span>
					if d.PullNumber > 0 {
						<span>Pull request <a href={ templ.SafeURL(d.PullURL) } class="hover:text-foreground hover:underline">#{ strconv.Itoa(d.PullNumber) }</a> by { d.PullBy }</span>
					} else {
						<span>{ d.Trigger }</span>
					}
					<span aria-hidden="true">·</span>
					<span class="font-mono px-1.5 py-0.5 bg-muted border border-border rounded-sm text-[12px]">{ d.Ref }</span>
					<a href={ templ.SafeURL(d.SHAURL) } class="font-mono hover:text-foreground hover:underline">{ d.SHA }</a>
					<span aria-hidden="true">·</span>
					<span>{ d.Timing }</span>
				</p>
			</section>
			if d.Flash != "" {
				<div role="alert" class="relative w-full rounded-md border p-4 border-destructive/40 bg-destructive/10 text-destructive text-sm">{ d.Flash }</div>
			}
			<div class="grid lg:grid-cols-[260px_1fr] gap-6 items-start">
				<aside class="order-last lg:order-first flex flex-col gap-6 min-w-0 lg:sticky lg:top-4" aria-label="Run">
					if len(d.Jobs) > 0 {
						<nav aria-label="Jobs" class="hidden lg:flex flex-col gap-0.5 text-[13px] lg:pb-5 lg:border-b lg:border-border">
							<p class="font-mono text-[10px] uppercase tracking-wider mb-1 px-2.5 text-muted-foreground">Jobs</p>
							for _, j := range d.Jobs {
								<a href={ templ.SafeURL(j.URL) } aria-current?={ j.Selected } class={ jobNavClass(j.Selected) }>
									@components.RunStatusIcon(j.Status)
									<span class="font-mono truncate">{ j.Name }</span>
									if j.Duration != "" {
										<span class="ml-auto font-mono text-[11px] text-muted-foreground">{ j.Duration }</span>
									}
								</a>
							}
						</nav>
					}
					<dl class="flex flex-col gap-3 text-[12.5px]">
						<div>
							<dt class="text-[12px] font-medium text-muted-foreground mb-1">Runner</dt>
							<dd class="font-mono">{ d.Runner }</dd>
						</div>
						<div>
							<dt class="text-[12px] font-medium text-muted-foreground mb-1">Attempt</dt>
							<dd>{ strconv.Itoa(d.Attempt) }</dd>
						</div>
						<div>
							<dt class="text-[12px] font-medium text-muted-foreground mb-1">Reported as</dt>
							<dd>Commit statuses <span class="font-mono">ci/&lt;job&gt;</span> on <a href={ templ.SafeURL(d.SHAURL) } class="font-mono hover:underline">{ d.SHA }</a></dd>
						</div>
					</dl>
				</aside>
				<div class="flex flex-col gap-6 min-w-0">
					if d.CanApprove {
						<div role="alert" class="relative w-full rounded-md border p-4 border-warning/40 bg-warning/10 text-card-foreground">
							<div class="flex flex-wrap items-start justify-between gap-4">
								<div class="min-w-0">
									<h5 class="mb-1 font-medium leading-none tracking-tight text-warning">Approval required</h5>
									<p class="text-sm leading-relaxed">This run is from a fork. It gets no secrets and a read-only token.</p>
									<p class="text-[13px] text-muted-foreground mt-2">Read the workflow before approving: <a href={ templ.SafeURL(d.WorkflowURL) } class="font-mono text-foreground underline underline-offset-2">{ d.SHA }:{ d.WorkflowPath }</a>. A new push to the pull request needs approval again.</p>
								</div>
								<form method="post" action={ templ.SafeURL(d.ApproveURL) } class="shrink-0">
									<button type="submit" class={ actionsBtnPrimary + " h-8 px-3 text-[13px]" }>Approve and run</button>
								</form>
							</div>
						</div>
					} else if d.Status == "waiting" {
						<div role="status" class="relative w-full rounded-md border p-4 border-warning/40 bg-warning/10 text-card-foreground">
							<h5 class="mb-1 font-medium leading-none tracking-tight text-warning">Approval required</h5>
							<p class="text-sm leading-relaxed">This run is from a fork. A writer has to approve it before it runs; it gets no secrets and a read-only token.</p>
						</div>
					}
					if d.CancelledNote != "" {
						<div role="alert" class="relative w-full rounded-md border p-4 border-border bg-card text-card-foreground">
							<h5 class="mb-1 font-medium leading-none tracking-tight">{ d.CancelledNote }</h5>
							<div class="text-sm [&_p]:leading-relaxed opacity-90"><p>Running jobs were stopped and their logs so far are kept. Jobs that hadn't started are skipped.</p></div>
						</div>
					}
					if len(d.Stages) > 0 {
						<section class="rounded-md border border-border bg-card overflow-hidden" aria-labelledby="graph-heading">
							<header class="px-4 py-3 border-b border-border bg-muted/30 flex items-center gap-2">
								<h2 id="graph-heading" class="text-[13px] font-medium">Jobs</h2>
							</header>
							<div class="p-4 overflow-x-auto">
								<ol class="flex items-center gap-3 w-max" aria-label="Job graph">
									for i, stage := range d.Stages {
										<li class="flex flex-col gap-2">
											for _, j := range stage {
												<a href={ templ.SafeURL(j.URL) } aria-current?={ j.Selected } class={ jobGraphClass(j.Selected) }>
													@components.RunStatusIcon(j.Status)
													<span class="font-mono truncate">{ j.Name }</span>
													if j.Duration != "" {
														<span class="ml-auto font-mono text-[11px] text-muted-foreground">{ j.Duration }</span>
													}
												</a>
											}
										</li>
										if i < len(d.Stages)-1 {
											<li aria-hidden="true" class="text-muted-foreground"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></li>
										}
									}
								</ol>
							</div>
						</section>
					}
					if d.Selected != nil {
						@runJob(d)
					}
					if len(d.Artifacts) > 0 {
						@runArtifacts(d)
					}
					if d.ParseError {
						@runParseError(d)
					}
					if d.Selected != nil && d.Selected.TailURL != "" {
						<div id="job-tail" hidden hx-get={ d.Selected.TailURL } hx-trigger="every 2s" hx-swap="outerHTML"></div>
					}
				</div>
			</div>
		</div>
		if d.CanCancel {
			<dialog id="cancel-run-dialog" aria-labelledby="cancel-run-title" class="rounded-lg border border-border bg-popover text-popover-foreground p-0 w-[420px] max-w-[calc(100vw-2rem)] mt-[28vh] mb-auto backdrop:bg-black/60 backdrop:backdrop-blur-xs">
				<form method="post" action={ templ.SafeURL(d.CancelURL) } class="p-5">
					<h2 id="cancel-run-title" class="text-base font-semibold tracking-tight mb-1">Cancel this run?</h2>
					<p class="text-[13px] text-muted-foreground leading-relaxed mb-5">Running jobs are stopped and keep the log they have so far. Jobs that haven't started are skipped. The commit status for each job becomes an error.</p>
					<div class="flex justify-end gap-2">
						<button type="button" onclick="this.closest('dialog').close()" class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-transparent hover:bg-accent hover:text-accent-foreground h-9 px-4">Keep running</button>
						<button type="submit" class="inline-flex items-center justify-center rounded-md text-sm font-medium h-9 px-4 bg-destructive-fill text-destructive-fill-foreground hover:bg-destructive-fill/90">Cancel run</button>
					</div>
				</form>
			</dialog>
		}
		<script src={ assets.URL("/static/actions_run.js") } defer></script>
	}
}

func jobNavClass(on bool) string {
	if on {
		return "flex items-center gap-2 px-3 py-1.5 rounded-sm bg-accent text-foreground font-medium"
	}
	return "flex items-center gap-2 px-3 py-1.5 rounded-sm text-muted-foreground hover:text-foreground hover:bg-accent"
}

func jobGraphClass(on bool) string {
	base := "flex items-center gap-2 h-8 w-44 px-2.5 rounded-md border border-border text-[12.5px] "
	if on {
		return base + "bg-accent font-medium text-foreground"
	}
	return base + "bg-background text-muted-foreground hover:text-foreground hover:bg-accent"
}

templ runControls(d view.ActionsRunData) {
	<div class="flex items-center gap-1.5 shrink-0">
		if d.CanCancel {
			<button type="button" onclick="document.getElementById('cancel-run-dialog').showModal()" class={ runBtnDanger }>
				<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><rect x="6" y="6" width="12" height="12" rx="1"></rect></svg>
				Cancel run
			</button>
		}
		if d.CanRerun && !d.ParseError {
			<div class="inline-flex" x-data="{ open: false }" @click.outside="open = false" @keydown.escape.window="open = false">
				<form method="post" action={ templ.SafeURL(d.RerunURL) }>
					if d.RerunFailed {
						<input type="hidden" name="failed" value="1"/>
					}
					<button type="submit" class={ "inline-flex items-center justify-center gap-1.5 rounded-l-md rounded-r-none font-medium transition-colors border border-input bg-transparent hover:bg-accent hover:text-accent-foreground h-8 px-3 text-[13px]" }>
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"></path></svg>
						if d.RerunFailed {
							Re-run failed jobs
						} else {
							Re-run all jobs
						}
					</button>
				</form>
				<div class="relative inline-block">
					<button type="button" @click="open = !open" :aria-expanded="open" class="inline-flex items-center justify-center rounded-r-md rounded-l-none font-medium transition-colors border border-l-0 border-input bg-transparent hover:bg-accent hover:text-accent-foreground h-8 px-2" aria-haspopup="menu" aria-label="More re-run options">
						<svg class="text-muted-foreground" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M7 10l5 5 5-5"></path></svg>
					</button>
					<div x-cloak x-show="open" role="menu" class="absolute right-0 top-full mt-1.5 z-50 min-w-[12rem] rounded-md border border-border bg-popover text-popover-foreground shadow-md p-1 text-sm">
						if d.RerunFailed {
							<form method="post" action={ templ.SafeURL(d.RerunURL) }>
								<input type="hidden" name="failed" value="1"/>
								<button type="submit" role="menuitem" class={ runMenuItem }>Re-run failed jobs</button>
							</form>
						}
						<form method="post" action={ templ.SafeURL(d.RerunURL) }>
							<button type="submit" role="menuitem" class={ runMenuItem }>Re-run all jobs</button>
						</form>
					</div>
				</div>
			</div>
		}
	</div>
}

templ runJob(d view.ActionsRunData) {
	{{ j := d.Selected }}
	<section id="job" class="rounded-md border border-border bg-card divide-y divide-border overflow-hidden" aria-labelledby="job-title">
		<header class="px-4 py-3 bg-muted/30 flex flex-wrap items-center gap-3">
			@components.RunStatusIconSized(j.Status, 16)
			<div class="min-w-0">
				<h2 id="job-title" class="text-[13.5px] font-medium font-mono">{ j.Name }</h2>
				<p class="text-[12px] text-muted-foreground mt-0.5">{ j.Subtitle }</p>
			</div>
			if j.Live {
				<span class="inline-flex items-center gap-1.5 text-[12px] text-warning"><span class="h-2 w-2 rounded-full bg-warning motion-safe:animate-pulse" aria-hidden="true"></span>Live</span>
			}
			if len(j.Steps) > 0 {
				<div class="ml-auto flex flex-wrap items-center gap-1.5">
					<label for="log-search" class="sr-only">Search this job's log</label>
					<div class="relative">
						<svg class="absolute left-2.5 top-1/2 -translate-y-1/2 text-muted-foreground" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
						<input id="log-search" type="search" placeholder="Search log" autocomplete="off" class="w-44 h-8 pl-8 pr-3 text-[13px] bg-card border border-border rounded-md placeholder:text-muted-foreground focus:outline-hidden focus:ring-2 focus:ring-ring"/>
					</div>
					<span data-match-count role="status" class="text-[12px] text-muted-foreground font-mono empty:hidden"></span>
					<button type="button" data-ts-toggle aria-pressed="false" class="h-8 px-3 text-[13px] border border-border rounded-md hover:bg-accent aria-pressed:bg-accent aria-pressed:text-foreground inline-flex items-center gap-1.5">
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"></circle><path d="M12 7v5l3 2"></path></svg>
						Timestamps
					</button>
					<a href={ templ.SafeURL(j.DownloadURL) } class={ runDownloadButton }>
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
						Download log
					</a>
				</div>
			}
		</header>
		if j.NoRunner != "" {
			<div class="p-6">
				<div role="status" class="rounded-md border border-warning/40 bg-warning/10 p-4 text-[13px]">
					<p class="font-semibold text-warning">No runner with label { j.NoRunner }</p>
					<p class="text-muted-foreground mt-1">
						This job asks for <span class="font-mono text-foreground">runs-on: { j.NoRunner }</span> and no online runner has that label, so it stays queued.
						if d.CanWrite {
							Register one in <a href={ templ.SafeURL(j.SettingsURL) } class="text-foreground underline underline-offset-2">Settings → CI/CD</a>.
						}
					</p>
				</div>
			</div>
		} else if j.Placeholder != "" {
			<div class="p-8 text-center">
				<p class="text-muted-foreground">{ j.Placeholder }</p>
				if j.PlaceholderDetail != "" {
					<p class="text-sm text-muted-foreground mt-2">{ j.PlaceholderDetail }</p>
				}
			</div>
		} else {
			<div id="job-steps" class="divide-y divide-border">
				for _, st := range j.Steps {
					@runStep(st)
				}
			</div>
			if j.TruncatedMsg != "" {
				<p class="px-4 py-3 text-[12px] text-warning">{ j.TruncatedMsg }</p>
			}
			if j.More {
				<p class="px-4 py-3 text-[12px] text-muted-foreground">This page shows the first lines of a long log. <a href={ templ.SafeURL(j.DownloadURL) } class="text-foreground underline underline-offset-2">Download the full log</a>.</p>
			}
		}
	</section>
}

templ runStep(st view.StepView) {
	<details class="group" data-step={ strconv.Itoa(st.Position) } open?={ st.Open }>
		<summary class="flex w-full items-center justify-between px-4 py-3 text-sm font-medium cursor-pointer hover:bg-muted/50 transition-colors list-none [&::-webkit-details-marker]:hidden focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-ring">
			<span class="flex items-center gap-2 min-w-0">
				@stepIcon(st)
				<span class="truncate">{ st.Name }</span>
			</span>
			<span class="flex items-center gap-3 shrink-0">
				if st.Started != "" {
					<span data-ts hidden class="font-mono text-[11px] text-muted-foreground">{ st.Started }</span>
				}
				@stepDuration(st)
				<svg class="h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180 motion-reduce:transition-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><polyline points="6 9 12 15 18 9"></polyline></svg>
			</span>
		</summary>
		<div class="overflow-x-auto bg-background">
			<div id={ "step-" + strconv.Itoa(st.Position) + "-log" } class="min-w-max border-t border-border empty:hidden font-mono text-[12px] leading-[1.6]">
				@runLogRows(st.Lines)
			</div>
		</div>
		if len(st.Lines) == 0 && (st.Status == "success" || st.Status == "failure" || st.Status == "cancelled" || st.Status == "skipped") {
			<p class="px-4 pb-3 text-[12px] text-muted-foreground">No output.</p>
		}
	</details>
}

templ stepIcon(st view.StepView) {
	<span id={ "step-" + strconv.Itoa(st.Position) + "-icon" } class="inline-flex">
		@components.RunStatusIcon(st.Status)
	</span>
}

templ stepDuration(st view.StepView) {
	<span id={ "step-" + strconv.Itoa(st.Position) + "-dur" } class="font-mono text-[11px] text-muted-foreground">{ st.Duration }</span>
}

templ runLogRows(lines []view.LogLine) {
	for _, l := range lines {
		<div id={ "L" + strconv.Itoa(l.No) } class={ logRowClass(l.Error) }>
			<a href={ templ.SafeURL("#L" + strconv.Itoa(l.No)) } class="select-none text-muted-foreground pr-4 pl-4 w-16 box-border text-right shrink-0 border-r border-border hover:text-foreground">{ strconv.Itoa(l.No) }</a>
			<span data-line class="pl-4 pr-4 whitespace-pre">
				for _, sp := range l.Spans {
					if sp.Class != "" {
						<span class={ sp.Class }>{ sp.Text }</span>
					} else {
						{ sp.Text }
					}
				}
			</span>
		</div>
	}
}

func logRowClass(isErr bool) string {
	if isErr {
		return "flex target:bg-accent/30 bg-destructive/10"
	}
	return "flex target:bg-accent/30 hover:bg-muted/50"
}

templ runArtifacts(d view.ActionsRunData) {
	<section class="rounded-md border border-border bg-card overflow-hidden" aria-labelledby="artifacts-heading">
		<header class="px-5 py-3 border-b border-border bg-muted/50 flex items-center gap-2">
			<h2 id="artifacts-heading" class="text-[13px] font-medium">Artifacts</h2>
			<span class="text-[12px] text-muted-foreground">expire 30 days after the run</span>
		</header>
		<ul class="divide-y divide-border">
			<li class="hidden md:grid grid-cols-[1fr_90px_130px_130px_100px] gap-4 px-5 py-2 text-[11px] font-mono uppercase tracking-wider text-muted-foreground bg-muted/20"><span>Name</span><span class="text-right">Size</span><span>SHA-256</span><span>Expires</span><span></span></li>
			for _, a := range d.Artifacts {
				<li class="grid md:grid-cols-[1fr_90px_130px_130px_100px] items-center gap-x-4 gap-y-1 px-5 py-3">
					<span class="flex items-center gap-2 min-w-0">
						<svg class="text-muted-foreground shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><polyline points="21 8 21 21 3 21 3 8"></polyline><rect x="1" y="3" width="22" height="5"></rect><line x1="10" y1="12" x2="14" y2="12"></line></svg>
						<span class="font-mono text-[13px] min-w-0 truncate">{ a.Name }</span>
					</span>
					<span class="font-mono text-[12px] text-muted-foreground md:text-right">{ a.Size }</span>
					<span class="font-mono text-[12px] text-muted-foreground" title={ "SHA-256 " + a.SHA }>{ a.SHAShort }</span>
					<span class="text-[12px] text-muted-foreground"><time>{ a.Expires }</time></span>
					<a href={ templ.SafeURL(a.URL) } class="h-7 px-2.5 border border-border rounded-md hover:bg-accent text-muted-foreground inline-flex items-center justify-center gap-1.5 text-[12px] shrink-0">
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
						Download
					</a>
				</li>
			}
		</ul>
	</section>
}

templ runParseError(d view.ActionsRunData) {
	<div class="flex flex-col gap-4">
		<div role="alert" class="relative w-full rounded-md border p-4 [&>svg]:absolute [&>svg]:left-4 [&>svg]:top-4 [&>svg+div]:pl-7 [&>svg~*]:pl-7 border-destructive/40 bg-destructive/10 text-destructive">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
			<h5 class="mb-1 font-medium leading-none tracking-tight">Invalid workflow file</h5>
			<div class="text-sm [&_p]:leading-relaxed opacity-90">
				<p>No jobs ran. <span class="font-mono">{ d.ErrorSummary }</span></p>
			</div>
		</div>
		<article class="rounded-md border border-border bg-card overflow-hidden">
			<div class="bg-muted/40 border-b border-border px-4 py-2 flex items-center justify-between gap-3">
				<code class="text-sm font-mono text-foreground truncate">{ d.WorkflowPath }</code>
				<a href={ templ.SafeURL(d.FileURL) } class="text-xs text-muted-foreground hover:text-foreground shrink-0">View file at { d.SHA }</a>
			</div>
			<div class="overflow-x-auto bg-card">
				<table class="w-full font-mono text-[12.5px] leading-[1.6]">
					<caption class="sr-only">{ d.WorkflowPath }</caption>
					<tbody>
						for _, l := range d.File {
							<tr class={ fileRowClass(l.Error != "") }>
								<td class={ fileNoClass(l.Error != "") }>{ strconv.Itoa(l.No) }</td>
								<td class="pl-4 pr-4 py-0 whitespace-pre">{ l.Text }</td>
							</tr>
							if l.Error != "" {
								<tr class="bg-destructive/10"><td class="select-none pr-4 pl-4 py-0 w-12 border-r border-border"></td><td class="pl-4 pr-4 py-1 font-sans text-[12px] text-destructive">{ l.Error }</td></tr>
							}
						}
					</tbody>
				</table>
			</div>
		</article>
	</div>
}

func fileRowClass(isErr bool) string {
	if isErr {
		return "bg-destructive/10"
	}
	return "hover:bg-muted/50"
}

func fileNoClass(isErr bool) string {
	c := "select-none pr-4 pl-4 py-0 text-right w-12 align-top border-r border-border "
	if isErr {
		return c + "text-destructive"
	}
	return c + "text-muted-foreground"
}

// ActionsTail is one poll of a running Job's log: the next poll in place of the last, then each Step's icon and
// duration replaced and its new lines appended, as out-of-band swaps.
templ ActionsTail(t view.TailData) {
	<div id="job-tail" hidden hx-get={ t.NextURL } hx-trigger="every 2s" hx-swap="outerHTML"></div>
	for _, st := range t.Steps {
		<span id={ "step-" + strconv.Itoa(st.Position) + "-icon" } class="inline-flex" hx-swap-oob="true">
			@components.RunStatusIcon(st.Status)
		</span>
		<span id={ "step-" + strconv.Itoa(st.Position) + "-dur" } class="font-mono text-[11px] text-muted-foreground" hx-swap-oob="true">{ st.Duration }</span>
		if len(st.Lines) > 0 {
			<div hx-swap-oob={ "beforeend:#step-" + strconv.Itoa(st.Position) + "-log" }>
				@runLogRows(st.Lines)
			</div>
		}
	}
}
