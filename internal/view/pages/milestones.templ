package pages

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ Milestones(data view.MilestonesData) {
	@layout.Base(data.BasePage, "Milestones · "+data.Owner+"/"+data.RepoName) {
		<div class="space-y-6">
			<div class="flex items-center justify-between">
				<div>
					<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName) } class="text-foreground hover:underline text-sm font-medium">{ data.Owner }/{ data.RepoName }</a>
					<span class="text-muted-foreground mx-1" aria-hidden="true">/</span>
					<span class="text-sm font-medium text-foreground">Milestones</span>
				</div>
				if data.CanWrite {
					<details class="relative">
						<summary class="inline-flex items-center justify-center gap-1.5 rounded-md font-medium transition-colors h-9 px-4 text-sm bg-success text-success-foreground hover:bg-success/90 cursor-pointer list-none">
							New milestone
						</summary>
						<div class="absolute right-0 mt-2 w-96 rounded-md border border-border bg-popover text-foreground shadow-lg p-4 z-10">
							<h3 class="font-semibold text-foreground mb-3">Create milestone</h3>
							<form hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/milestones" } hx-target="#milestones-list" hx-swap="outerHTML" class="space-y-3">
								<div>
									<label for="milestone-title" class="block text-xs font-medium text-foreground mb-1">Title <span class="text-destructive" aria-hidden="true">*</span></label>
									@components.Input(templ.Attributes{
										"id":       "milestone-title",
										"type":     "text",
										"name":     "title",
										"required": "required",
									})
								</div>
								<div>
									<label for="milestone-description" class="block text-xs font-medium text-foreground mb-1">Description</label>
									@components.Textarea(templ.Attributes{
										"id":   "milestone-description",
										"name": "description",
										"rows": "2",
									})
								</div>
								<div>
									<label for="milestone-due-date" class="block text-xs font-medium text-foreground mb-1">Due date</label>
									@components.Input(templ.Attributes{
										"id":   "milestone-due-date",
										"type": "date",
										"name": "due_date",
									})
								</div>
								<div class="flex justify-end gap-2">
									@components.Button(components.ButtonDefault, components.ButtonSizeSM, templ.Attributes{"type": "submit"}) {
										Create milestone
									}
								</div>
							</form>
						</div>
					</details>
				}
			</div>
			<div id="milestones-list" class="space-y-4">
				if len(data.OpenMilestones) == 0 && len(data.ClosedMilestones) == 0 {
					<div class="text-center py-12 text-muted-foreground">
						<p class="text-sm">No milestones yet.</p>
						if data.CanWrite {
							<p class="text-xs mt-1">Create one to start tracking progress.</p>
						}
					</div>
				} else {
					if len(data.OpenMilestones) > 0 {
						<div>
							<h2 class="text-sm font-semibold text-foreground mb-2">Open ({ strconv.Itoa(len(data.OpenMilestones)) })</h2>
							<div class="space-y-3">
								for _, m := range data.OpenMilestones {
									<div class="rounded-md border border-border bg-card p-4">
										<div class="flex items-start justify-between gap-2">
											<div class="flex-1 min-w-0">
												<h3 class="font-semibold text-foreground">{ m.Title }</h3>
												if m.Description != "" {
													<p class="text-sm text-muted-foreground mt-0.5 truncate">{ m.Description }</p>
												}
												if m.DueDate != nil {
													<p class="text-xs text-muted-foreground mt-1">Due <time datetime={ m.DueDate.UTC().Format(time.RFC3339) }>{ m.DueDate.Format("Jan 2, 2006") }</time></p>
												}
												if m.OpenCount+m.ClosedCount > 0 {
													@components.ProgressBar(m.ClosedCount, m.OpenCount+m.ClosedCount)
												} else {
													<p class="text-xs text-muted-foreground mt-1">No issues assigned</p>
												}
											</div>
											if data.CanWrite {
												<div class="flex gap-2 shrink-0">
													@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{
														"hx-patch":  "/api/repos/" + data.Owner + "/" + data.RepoName + "/milestones/" + strconv.Itoa(m.Number),
														"hx-vals":   `{"state":"closed"}`,
														"hx-target": "#milestones-list",
														"hx-swap":   "outerHTML",
														"type":      "button",
													}) {
														Close
													}
													@components.Button(components.ButtonDestructive, components.ButtonSizeSM, templ.Attributes{
														"hx-delete":  "/api/repos/" + data.Owner + "/" + data.RepoName + "/milestones/" + strconv.Itoa(m.Number),
														"hx-target":  "#milestones-list",
														"hx-swap":    "outerHTML",
														"hx-confirm": "Delete this milestone?",
														"type":       "button",
													}) {
														Delete
													}
												</div>
											}
										</div>
									</div>
								}
							</div>
						</div>
					}
					if len(data.ClosedMilestones) > 0 {
						<div>
							<h2 class="text-sm font-semibold text-foreground mb-2">Closed ({ strconv.Itoa(len(data.ClosedMilestones)) })</h2>
							<div class="space-y-3">
								for _, m := range data.ClosedMilestones {
									<div class="rounded-md border border-border bg-card p-4 opacity-70">
										<div class="flex items-start justify-between gap-2">
											<div class="flex-1 min-w-0">
												<h3 class="font-semibold text-foreground line-through">{ m.Title }</h3>
												if m.Description != "" {
													<p class="text-sm text-muted-foreground mt-0.5 truncate">{ m.Description }</p>
												}
												if m.ClosedAt != nil {
													<p class="text-xs text-muted-foreground mt-1">Closed <time datetime={ m.ClosedAt.UTC().Format(time.RFC3339) }>{ m.ClosedAt.Format("Jan 2, 2006") }</time></p>
												}
												if m.OpenCount+m.ClosedCount > 0 {
													@components.ProgressBar(m.ClosedCount, m.OpenCount+m.ClosedCount)
												}
											</div>
											if data.CanWrite {
												<div class="flex gap-2 shrink-0">
													@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{
														"hx-patch":  "/api/repos/" + data.Owner + "/" + data.RepoName + "/milestones/" + strconv.Itoa(m.Number),
														"hx-vals":   `{"state":"open"}`,
														"hx-target": "#milestones-list",
														"hx-swap":   "outerHTML",
														"type":      "button",
													}) {
														Reopen
													}
													@components.Button(components.ButtonDestructive, components.ButtonSizeSM, templ.Attributes{
														"hx-delete":  "/api/repos/" + data.Owner + "/" + data.RepoName + "/milestones/" + strconv.Itoa(m.Number),
														"hx-target":  "#milestones-list",
														"hx-swap":    "outerHTML",
														"hx-confirm": "Delete this milestone?",
														"type":       "button",
													}) {
														Delete
													}
												</div>
											}
										</div>
									</div>
								}
							</div>
						</div>
					}
				}
			</div>
		</div>
	}
}
