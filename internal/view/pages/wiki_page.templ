package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

script deleteWikiPageJS(owner, repoName, slug string) {
	if (!confirm('Delete this wiki page?')) return;
	var csrf = (document.cookie.match(/csrf_token=([^;]+)/) || [])[1] || '';
	fetch('/api/repos/' + owner + '/' + repoName + '/wiki/' + slug, {method: 'DELETE', headers: {'X-CSRF-Token': csrf}})
		.then(function(r) { if (r.ok || r.redirected) window.location.href = '/' + owner + '/' + repoName + '/wiki'; });
}

script newWikiPageJS(owner, repoName string) {
	var name = prompt('Page name (letters, numbers, hyphens, underscores):');
	if (!name) return;
	if (!/^[A-Za-z0-9_-]{1,100}$/.test(name)) { alert('Invalid page name. Use letters, numbers, hyphens, and underscores only.'); return; }
	window.location.href = '/' + owner + '/' + repoName + '/wiki/' + name + '/edit';
}

templ WikiPage(data view.WikiPageData) {
	@layout.Base(data.BasePage, data.Slug+" — Wiki — "+data.RepoName+" — Cloudzilla") {
		<div class="max-w-6xl mx-auto px-4 py-8 flex gap-8">
			<!-- Sidebar: page list -->
			<aside class="w-48 flex-none" aria-label="Wiki pages">
				<h2 class="text-xs font-semibold uppercase text-muted-foreground mb-2 tracking-wide">Pages</h2>
				<ul class="space-y-1">
					for _, pg := range data.PageList {
						<li>
							if pg == data.Slug {
								<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/wiki/" + pg) } class="block text-sm px-2 py-1 rounded-md font-semibold text-foreground bg-accent" aria-current="page">{ pg }</a>
							} else {
								<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/wiki/" + pg) } class="block text-sm px-2 py-1 rounded-md hover:bg-muted text-muted-foreground hover:text-foreground">{ pg }</a>
							}
						</li>
					}
				</ul>
				if data.CanWrite {
					<div class="mt-4">
						<button onclick={ newWikiPageJS(data.Owner, data.RepoName) } class="text-sm text-foreground hover:underline px-2" type="button">+ New page</button>
					</div>
				}
			</aside>
			<!-- Main content -->
			<main class="flex-1 min-w-0">
				<div class="flex items-center justify-between mb-4">
					<h1 class="text-2xl font-bold">{ data.Slug }</h1>
					<div class="flex gap-2">
						if data.CanWrite {
							@components.LinkButton("/"+data.Owner+"/"+data.RepoName+"/wiki/"+data.Slug+"/edit", components.ButtonOutline, components.ButtonSizeSM, nil) {
								Edit
							}
						}
						if data.CanManage && data.Exists {
							<button
								type="button"
								onclick={ deleteWikiPageJS(data.Owner, data.RepoName, data.Slug) }
								class="inline-flex items-center justify-center gap-1.5 rounded-md font-medium transition-colors h-8 px-3 text-[13px] bg-destructive text-destructive-foreground hover:bg-destructive/90"
							>Delete</button>
						}
					</div>
				</div>
				if data.Exists {
					@components.MarkdownBody(data.ContentHTML)
				} else {
					<div class="text-muted-foreground">
						<p class="mb-4">This page does not exist yet.</p>
						if data.CanWrite {
							@components.LinkButton("/"+data.Owner+"/"+data.RepoName+"/wiki/"+data.Slug+"/edit", components.ButtonDefault, components.ButtonSizeDefault, nil) {
								Create this page
							}
						}
					</div>
				}
			</main>
		</div>
	}
}
