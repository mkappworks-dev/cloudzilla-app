package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

script deleteWikiPageJS(owner, repoName, slug string) {
	if (!confirm('Delete this wiki page?')) return;
	var csrf = (document.cookie.match(/csrf_token=([^;]+)/) || [])[1] || '';
	fetch('/api/repos/' + owner + '/' + repoName + '/wiki/' + slug, {method: 'DELETE', headers: {'X-CSRF-Token': csrf}})
		.then(function(r) { if (r.ok || r.redirected) window.location.href = '/' + owner + '/' + repoName + '/wiki'; });
}

templ WikiPage(data view.WikiPageData) {
	@layout.Base(data.BasePage, data.Slug+" — Wiki — "+data.RepoName+" — Cloudzilla") {
		<div class="space-y-6">

			<section class="flex flex-wrap items-start justify-between gap-4" aria-labelledby="wiki-title">
				<div class="min-w-0">
					<h1 id="wiki-title" class="text-2xl font-semibold tracking-tight">{ data.Slug }</h1>
				</div>
				<div class="flex items-center gap-2 shrink-0">
					if data.CanWrite {
						@components.LinkButton("/"+data.Owner+"/"+data.RepoName+"/wiki/"+data.Slug+"/edit", components.ButtonOutline, components.ButtonSizeSM, nil) {
							Edit
						}
					}
					if data.CanManage && data.Exists {
						@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{
							"type":    "button",
							"onclick": deleteWikiPageJS(data.Owner, data.RepoName, data.Slug),
							"class":   "text-destructive border-destructive/40 hover:bg-destructive/10",
						}) {
							Delete
						}
					}
				</div>
			</section>

			<div class="grid lg:grid-cols-[220px_1fr] gap-8">
				<aside aria-label="Wiki pages">
					<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">Pages</p>
					<ul class="space-y-0.5 text-[13px]">
						for _, pg := range data.PageList {
							<li>
								if pg == data.Slug {
									<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/wiki/" + pg) } class="block px-2 py-1.5 rounded-md font-medium bg-muted text-foreground" aria-current="page">{ pg }</a>
								} else {
									<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/wiki/" + pg) } class="block px-2 py-1.5 rounded-md text-muted-foreground hover:text-foreground hover:bg-muted/50">{ pg }</a>
								}
							</li>
						}
					</ul>
					if data.CanWrite {
						<button
							type="button"
							onclick="document.getElementById('wiki-new-page').showModal()"
							class="mt-3 text-[12px] text-muted-foreground hover:text-foreground px-2 py-1.5"
						>+ New page</button>
					}
				</aside>

				<article class="rounded-md border border-border bg-card p-6">
					if data.Exists {
						@components.MarkdownBody(data.ContentHTML)
					} else {
						<div class="text-muted-foreground">
							<p class="mb-4">This page does not exist yet.</p>
							if data.CanWrite {
								@components.LinkButton("/"+data.Owner+"/"+data.RepoName+"/wiki/"+data.Slug+"/edit", components.ButtonDefault, components.ButtonSizeDefault, nil) {
									Create this page
								}
							}
						</div>
					}
				</article>
			</div>

			if data.CanWrite {
				@components.Dialog("wiki-new-page") {
					@components.DialogHeader() {
						@components.DialogTitle("wiki-new-page") {
							New wiki page
						}
						@components.DialogDescription() {
							Choose a page name. Use letters, numbers, hyphens, and underscores only.
						}
					}
					<form
						method="dialog"
						onsubmit={ wikiNewPageSubmit(data.Owner, data.RepoName) }
						class="p-5 space-y-4"
					>
						<div class="space-y-1.5">
							<label for="wiki-new-page-name" class="block text-sm font-medium">Page name</label>
							@components.Input(templ.Attributes{
								"id":          "wiki-new-page-name",
								"name":        "name",
								"type":        "text",
								"required":    "required",
								"pattern":     "[A-Za-z0-9_-]{1,100}",
								"placeholder": "Getting-Started",
								"autofocus":   "autofocus",
								"class":       "font-mono",
							})
							<p id="wiki-new-page-error" class="hidden text-[12px] text-destructive" role="alert"></p>
						</div>
					</form>
					@components.DialogFooter() {
						@components.DialogClose(templ.Attributes{
							"class": "inline-flex items-center justify-center gap-1.5 rounded-md font-medium transition-colors hover:bg-accent hover:text-accent-foreground h-8 px-3 text-[13px]",
						}) {
							Cancel
						}
						@components.Button(components.ButtonDefault, components.ButtonSizeSM, templ.Attributes{
							"type":    "button",
							"onclick": wikiNewPageGo(data.Owner, data.RepoName),
						}) {
							Create page
						}
					}
				}
			}
		</div>
	}
}

// wikiNewPageGo reads the input value, validates against the regex, and either
// navigates to the editor URL or surfaces an inline error.
script wikiNewPageGo(owner, repoName string) {
	var input = document.getElementById('wiki-new-page-name');
	var err = document.getElementById('wiki-new-page-error');
	var name = (input.value || '').trim();
	if (!/^[A-Za-z0-9_-]{1,100}$/.test(name)) {
		err.textContent = 'Use letters, numbers, hyphens, and underscores (1–100 chars).';
		err.classList.remove('hidden');
		input.focus();
		return;
	}
	window.location.href = '/' + owner + '/' + repoName + '/wiki/' + name + '/edit';
}

// wikiNewPageSubmit blocks the implicit Enter-key submit on the inline form
// and routes through wikiNewPageGo so the same validation/redirect path runs.
script wikiNewPageSubmit(owner, repoName string) {
	event.preventDefault();
	var input = document.getElementById('wiki-new-page-name');
	var err = document.getElementById('wiki-new-page-error');
	var name = (input.value || '').trim();
	if (!/^[A-Za-z0-9_-]{1,100}$/.test(name)) {
		err.textContent = 'Use letters, numbers, hyphens, and underscores (1–100 chars).';
		err.classList.remove('hidden');
		input.focus();
		return false;
	}
	window.location.href = '/' + owner + '/' + repoName + '/wiki/' + name + '/edit';
	return false;
}
