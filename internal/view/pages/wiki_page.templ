package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

script deleteWikiPageJS(owner, repoName, slug string) {
	if (!confirm('Delete this wiki page?')) return;
	fetch('/api/repos/' + owner + '/' + repoName + '/wiki/' + slug, {method: 'DELETE'})
		.then(function(r) { if (r.ok || r.redirected) window.location.href = '/' + owner + '/' + repoName + '/wiki'; });
}

script newWikiPageJS(owner, repoName string) {
	var name = prompt('Page name (letters, numbers, hyphens, underscores):');
	if (!name) return;
	if (!/^[A-Za-z0-9_-]{1,100}$/.test(name)) { alert('Invalid page name. Use letters, numbers, hyphens, and underscores only.'); return; }
	window.location.href = '/' + owner + '/' + repoName + '/wiki/' + name + '/edit';
}

templ WikiPage(data view.WikiPageData) {
	@layout.Base(data.BasePage, data.Slug+" — Wiki — "+data.RepoName+" — Cloudzilla") {
		<div class="max-w-6xl mx-auto px-4 py-8 flex gap-8">
			<!-- Sidebar: page list -->
			<aside class="w-48 flex-none">
				<h2 class="text-xs font-semibold uppercase text-gray-500 mb-2 tracking-wide">Pages</h2>
				<ul class="space-y-1">
					for _, pg := range data.PageList {
						<li>
							if pg == data.Slug {
								<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/wiki/" + pg) } class="block text-sm px-2 py-1 rounded hover:bg-gray-100 font-semibold text-gray-900 bg-gray-100">{ pg }</a>
							} else {
								<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/wiki/" + pg) } class="block text-sm px-2 py-1 rounded hover:bg-gray-100 text-gray-700">{ pg }</a>
							}
						</li>
					}
				</ul>
				if data.CanWrite {
					<div class="mt-4">
						<button onclick={ newWikiPageJS(data.Owner, data.RepoName) } class="block text-sm text-blue-600 hover:underline px-2">+ New page</button>
					</div>
				}
			</aside>
			<!-- Main content -->
			<main class="flex-1 min-w-0">
				<div class="flex items-center justify-between mb-4">
					<h1 class="text-2xl font-bold">{ data.Slug }</h1>
					<div class="flex gap-2">
						if data.CanWrite {
							<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/wiki/" + data.Slug + "/edit") } class="px-3 py-1.5 text-sm border border-gray-300 rounded hover:bg-gray-100">Edit</a>
						}
						if data.CanManage && data.Exists {
							<button
								onclick={ deleteWikiPageJS(data.Owner, data.RepoName, data.Slug) }
								class="px-3 py-1.5 text-sm border border-red-300 text-red-600 rounded hover:bg-red-50">Delete</button>
						}
					</div>
				</div>
				if data.Exists {
					<div class="prose prose-sm max-w-none">
						@templ.Raw(data.ContentHTML)
					</div>
				} else {
					<div class="text-gray-500">
						<p class="mb-4">This page does not exist yet.</p>
						if data.CanWrite {
							<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/wiki/" + data.Slug + "/edit") } class="inline-block px-4 py-2 bg-blue-600 text-white rounded text-sm hover:bg-blue-700">Create this page</a>
						}
					</div>
				}
			</main>
		</div>
	}
}
