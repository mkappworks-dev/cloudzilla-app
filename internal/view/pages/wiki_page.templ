package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ WikiPage(data view.WikiPageData) {
	@layout.Base(data.BasePage, data.Slug+" — Wiki — "+data.RepoName+" — Cloudzilla") {
		<div class="space-y-6">

			<section class="mb-6 flex flex-wrap items-start justify-between gap-4" aria-labelledby="wiki-title">
				<div class="min-w-0">
					<h1 id="wiki-title" class="text-2xl font-semibold tracking-tight">{ data.Slug }</h1>
				</div>
				<div class="flex items-center gap-2 shrink-0">
					if data.CanWrite {
						@components.LinkButton("/"+data.Owner+"/"+data.RepoName+"/wiki/"+data.Slug+"/edit", components.ButtonOutline, components.ButtonSizeSM, nil) {
							Edit
						}
					}
					if data.CanManage && data.Exists {
						@components.Button(components.ButtonDestructiveOutline, components.ButtonSizeSM, templ.Attributes{
							"type":    "button",
							"onclick": "document.getElementById('wiki-delete-dialog').showModal()",
						}) {
							Delete
						}
					}
				</div>
			</section>

			<div class="grid lg:grid-cols-[220px_1fr] gap-8">
				@wikiSidebar(data.Owner, data.RepoName, data.Slug, data.PageList, data.CanWrite, data.CanWrite)

				<article class="rounded-md border border-border bg-card p-6">
					if data.Exists {
						<div class="prose prose-sm dark:prose-invert max-w-none">
							@templ.Raw(data.ContentHTML)
						</div>
					} else {
						<div class="text-muted-foreground">
							<p class="mb-4">This page does not exist yet.</p>
							if data.CanWrite {
								@components.LinkButton("/"+data.Owner+"/"+data.RepoName+"/wiki/"+data.Slug+"/edit", components.ButtonDefault, components.ButtonSizeDefault, nil) {
									Create this page
								}
							}
						</div>
					}
				</article>
			</div>

		</div>

		if data.CanManage && data.Exists {
			@components.Dialog("wiki-delete-dialog") {
				@components.DialogHeader() {
					@components.DialogTitle("wiki-delete-dialog") {
						Delete this page?
					}
					@components.DialogDescription() {
						This permanently removes the "{ data.Slug }" page from the wiki. This cannot be undone.
					}
				}
				@components.DialogFooter() {
					@components.DialogClose() {
						Cancel
					}
					@components.Button(components.ButtonDestructive, components.ButtonSizeSM, templ.Attributes{
						"type":                "button",
						"hx-delete":           "/api/repos/" + data.Owner + "/" + data.RepoName + "/wiki/" + data.Slug,
						"hx-on--after-request": "if(event.detail.successful){sessionStorage.setItem('cz-toast',JSON.stringify({type:'success',message:'Wiki page deleted'}));location.href='/" + data.Owner + "/" + data.RepoName + "/wiki';}",
					}) {
						Delete page
					}
				}
			}
		}
	}
}
