package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/fragments"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ AdminSettings(data view.AdminSettingsData) {
	@layout.Base(data.BasePage, "Admin settings") {
		<div class="space-y-6">
			if data.Confirm.Any() {
				@components.ConfirmIdentityDialog(data.Confirm)
			}
			@adminTabs("/admin/settings")
			<div class="flex justify-between items-center">
				<h1 class="text-2xl font-semibold tracking-tight">Admin settings</h1>
			</div>
			<!-- Instance Settings -->
			@components.Card(nil) {
				@components.CardHeader() {
					@components.CardTitle(2) {
						Instance settings
					}
					@components.CardDescription() {
						Toggle site-wide feature flags.
					}
				}
				@components.CardContent() {
					@fragments.AdminSettings(view.AdminSettingsFragData{Settings: data.Settings})
				}
			}
			<!-- Invitations -->
			@components.Card(nil) {
				@components.CardHeader() {
					@components.CardTitle(2) {
						Invitations
					}
					@components.CardDescription() {
						Invite users to join this instance by email.
					}
				}
				@components.CardContent() {
					<form hx-post="/api/admin/invitations" hx-target="#admin-invitations-list" hx-swap="outerHTML" data-toast="Invitation sent" data-confirm-identity="Send invite" class="flex items-end gap-3 mb-6">
						<div class="flex-1 space-y-1.5">
							<label for="invite-email" class="block text-xs font-medium text-muted-foreground">Invitee email</label>
							@components.Input(templ.Attributes{
								"id":          "invite-email",
								"type":        "email",
								"name":        "email",
								"placeholder": "user@example.com",
								"required":    "required",
							})
						</div>
						@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
							Send invite
						}
					</form>
					@fragments.AdminInvitations(view.AdminInvitationsFragData{Invitations: data.Invitations})
				}
			}
			@components.Card(nil) {
				@components.CardHeader() {
					@components.CardTitle(2) {
						Email verification
					}
					@components.CardDescription() {
						Mark a user's email address verified by hand, for instances that can't send the verification link. A verified address lets the Google account with that address sign in to the user's account, so only vouch for addresses you know are theirs.
					}
				}
				@components.CardContent() {
					<form
						method="POST"
						action="/api/admin/users/verify-email"
						hx-post="/api/admin/users/verify-email"
						hx-swap="none"
						hx-on::after:request="if(ctx.response.status<400){this.reset();}"
						data-toast="Email marked verified"
						data-confirm-identity="Mark verified"
						class="flex flex-col sm:flex-row sm:items-end gap-3"
					>
						<div class="flex-1 space-y-1.5">
							<label for="verify-username" class="block text-xs font-medium text-muted-foreground">Username</label>
							@components.Input(templ.Attributes{
								"id":           "verify-username",
								"type":         "text",
								"name":         "username",
								"placeholder":  "username",
								"required":     "required",
								"autocomplete": "off",
							})
						</div>
						<div class="flex-1 space-y-1.5">
							<label for="verify-email" class="block text-xs font-medium text-muted-foreground">Email</label>
							@components.Input(templ.Attributes{
								"id":           "verify-email",
								"type":         "email",
								"name":         "email",
								"placeholder":  "user@example.com",
								"required":     "required",
								"autocomplete": "off",
							})
						</div>
						@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
							Mark verified
						}
					</form>
				}
			}
		</div>
	}
}
