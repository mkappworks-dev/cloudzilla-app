package pages

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ GistEdit(data view.GistEditData) {
	@layout.Base(data.BasePage, "Edit Gist") {
		<div class="max-w-4xl mx-auto py-8 px-4">
			<h1 class="text-2xl font-bold mb-6">Edit Gist</h1>
			<form id="gist-edit-form" data-gist-id={ data.Gist.ID }>
				<div class="mb-4">
					<label for="gist-edit-description" class="block text-sm font-medium text-foreground mb-1">Description</label>
					@components.Input(templ.Attributes{
						"id":    "gist-edit-description",
						"type":  "text",
						"name":  "description",
						"value": data.Gist.Description,
					})
				</div>
				<div class="mb-4 flex items-center gap-2">
					if data.Gist.Public {
						<input type="checkbox" id="public" name="public" checked/>
					} else {
						<input type="checkbox" id="public" name="public"/>
					}
					<label for="public" class="text-sm text-foreground">Public gist</label>
				</div>
				<div id="file-rows" class="space-y-4">
					for i, f := range data.Files {
						<div class="rounded-md border border-border bg-card p-4">
							<label for={ "gist-edit-filename-" + strconv.Itoa(i) } class="sr-only">Filename</label>
							<input id={ "gist-edit-filename-" + strconv.Itoa(i) } type="text" name="filename[]" value={ f.Filename } class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors placeholder:text-muted-foreground mb-2" required/>
							<label for={ "gist-edit-content-" + strconv.Itoa(i) } class="sr-only">File contents</label>
							<textarea id={ "gist-edit-content-" + strconv.Itoa(i) } name="content[]" rows="8" class="flex min-h-[80px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm placeholder:text-muted-foreground font-mono">{ f.Content }</textarea>
						</div>
					}
				</div>
				<div class="mt-3">
					@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{
						"type":      "button",
						"hx-get":    "/api/gists/file-row",
						"hx-target": "#file-rows",
						"hx-swap":   "beforeend",
					}) {
						Add file
					}
				</div>
				<div class="mt-6 flex gap-3">
					@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
						Save Changes
					}
					@components.LinkButton("/gists/"+data.Gist.ID, components.ButtonOutline, components.ButtonSizeDefault, nil) {
						Cancel
					}
				</div>
			</form>
			<script>
				document.getElementById('gist-edit-form').addEventListener('submit', async function(e) {
					e.preventDefault();
					const desc = this.querySelector('[name=description]').value;
					const pub = this.querySelector('[name=public]').checked;
					const filenames = [...this.querySelectorAll('[name="filename[]"]')].map(el => el.value);
					const contents = [...this.querySelectorAll('[name="content[]"]')].map(el => el.value);
					const files = filenames.map((fn, i) => ({ filename: fn, content: contents[i] }));
					const gistID = this.dataset.gistId;
					const csrf = (document.cookie.match(/csrf_token=([^;]+)/) || [])[1] || '';
					const res = await fetch('/api/gists/' + gistID, {
						method: 'PATCH',
						headers: {'Content-Type': 'application/json', 'X-CSRF-Token': csrf},
						body: JSON.stringify({ description: desc, public: pub, files })
					});
					if (res.ok) {
						window.location.href = '/gists/' + gistID;
					} else {
						const text = await res.text();
						let msg = text;
						try { msg = JSON.parse(text).error || text; } catch (_) {}
						alert(msg || ('Failed to update gist (HTTP ' + res.status + ')'));
					}
				});
			</script>
		</div>
	}
}
