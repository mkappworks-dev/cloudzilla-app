package pages

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ GistEdit(data view.GistEditData) {
	@layout.Base(data.BasePage, "Edit Gist") {
		<div class="max-w-4xl mx-auto space-y-6">

			<section aria-labelledby="edit-title">
				<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">
					<a href="/gists" class="hover:underline">Gists</a>
					<span aria-hidden="true">·</span>
					<a href={ templ.SafeURL("/gists/" + data.Gist.ID) } class="hover:underline">{ data.Gist.ID }</a>
					<span aria-hidden="true">·</span>
					Edit
				</p>
				<h1 id="edit-title" class="text-2xl font-semibold tracking-tight">Edit gist</h1>
			</section>

			<form id="gist-edit-form" data-gist-id={ data.Gist.ID } class="space-y-5 rounded-md border border-border bg-card p-6">
				<div class="space-y-1.5">
					<label for="gist-edit-description" class="block text-sm font-medium">Description</label>
					@components.Input(templ.Attributes{
						"id":    "gist-edit-description",
						"type":  "text",
						"name":  "description",
						"value": data.Gist.Description,
					})
				</div>

				<label class="flex items-center gap-2 text-sm cursor-pointer">
					if data.Gist.Public {
						@components.Checkbox(templ.Attributes{"id": "public", "name": "public", "checked": "checked"})
					} else {
						@components.Checkbox(templ.Attributes{"id": "public", "name": "public"})
					}
					<span>Public gist</span>
				</label>

				<div id="file-rows" class="space-y-4">
					for i, f := range data.Files {
						<div class="rounded-md border border-border bg-muted/30 p-4 space-y-2">
							<label for={ "gist-edit-filename-" + strconv.Itoa(i) } class="sr-only">Filename</label>
							<input id={ "gist-edit-filename-" + strconv.Itoa(i) } type="text" name="filename[]" value={ f.Filename } class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm font-mono shadow-sm placeholder:text-muted-foreground" required/>
							<label for={ "gist-edit-content-" + strconv.Itoa(i) } class="sr-only">File contents</label>
							<textarea id={ "gist-edit-content-" + strconv.Itoa(i) } name="content[]" rows="10" class="flex min-h-[160px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm font-mono shadow-sm placeholder:text-muted-foreground resize-vertical">{ f.Content }</textarea>
						</div>
					}
				</div>

				@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{
					"type":      "button",
					"hx-get":    "/api/gists/file-row",
					"hx-target": "#file-rows",
					"hx-swap":   "beforeend",
					"hx-vals":   "js:{index: document.querySelectorAll('#file-rows > *').length}",
				}) {
					+ Add file
				}

				<div class="flex items-center gap-3 pt-2">
					@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
						Save changes
					}
					@components.LinkButton("/gists/"+data.Gist.ID, components.ButtonGhost, components.ButtonSizeDefault, nil) {
						Cancel
					}
				</div>
			</form>

			<script>
				document.getElementById('gist-edit-form').addEventListener('submit', async function(e) {
					e.preventDefault();
					const desc = this.querySelector('[name=description]').value;
					const pub = this.querySelector('[name=public]').checked;
					const filenames = [...this.querySelectorAll('[name="filename[]"]')].map(el => el.value);
					const contents = [...this.querySelectorAll('[name="content[]"]')].map(el => el.value);
					const files = filenames.map((fn, i) => ({ filename: fn, content: contents[i] }));
					const gistID = this.dataset.gistId;
					const csrf = (document.cookie.match(/csrf_token=([^;]+)/) || [])[1] || '';
					const res = await fetch('/api/gists/' + gistID, {
						method: 'PATCH',
						headers: {'Content-Type': 'application/json', 'X-CSRF-Token': csrf},
						body: JSON.stringify({ description: desc, public: pub, files })
					});
					if (res.ok) {
						window.location.href = '/gists/' + gistID;
					} else {
						const text = await res.text();
						let msg = text;
						try { msg = JSON.parse(text).error || text; } catch (_) {}
						alert(msg || ('Failed to update gist (HTTP ' + res.status + ')'));
					}
				});
			</script>
		</div>
	}
}
