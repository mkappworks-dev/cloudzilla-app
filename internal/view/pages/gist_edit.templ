package pages

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ GistEdit(data view.GistEditData) {
	@layout.Base(data.BasePage, "Edit Gist") {
		<div class="space-y-5">

			<section aria-labelledby="edit-title">
				<p class="font-mono text-[11px] text-muted-foreground uppercase tracking-wider mb-2">
					<a href="/gists" class="hover:underline">Gists</a>
					<span aria-hidden="true">·</span>
					<a href={ templ.SafeURL("/gists/" + data.Gist.ID) } class="hover:underline">{ data.Gist.ID }</a>
					<span aria-hidden="true">·</span>
					Edit
				</p>
				<h1 id="edit-title" class="text-2xl font-semibold tracking-tight">Edit gist</h1>
			</section>

			<div class="grid lg:grid-cols-[1fr_280px] gap-8">
				<div class="min-w-0">

					<form id="gist-edit-form" data-gist-id={ data.Gist.ID } class="space-y-5">
						<div class="space-y-1.5">
							<label for="gist-edit-description" class="block text-sm font-medium">
								Gist description <span class="text-muted-foreground font-normal">(optional)</span>
							</label>
							@components.Input(templ.Attributes{
								"id":    "gist-edit-description",
								"type":  "text",
								"name":  "description",
								"value": data.Gist.Description,
							})
						</div>

						<div id="file-rows" class="space-y-4">
							for i, f := range data.Files {
								<section class="rounded-md border border-border bg-card overflow-hidden">
									<header class="px-3 py-2 border-b border-border bg-accent flex items-center gap-2">
										<label for={ "gist-edit-filename-" + strconv.Itoa(i) } class="sr-only">Filename</label>
										<input
											id={ "gist-edit-filename-" + strconv.Itoa(i) }
											class="font-mono text-[13px] flex-1 bg-transparent focus:outline-none placeholder:text-muted-foreground"
											type="text"
											name="filename[]"
											value={ f.Filename }
											required
										/>
									</header>
									@components.MarkdownEditor("gist-edit-content-"+strconv.Itoa(i), "content[]", f.Content, "File contents…", 8)
								</section>
							}
						</div>

						@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{
							"type":      "button",
							"hx-get":    "/api/gists/file-row",
							"hx-target": "#file-rows",
							"hx-swap":   "beforeend",
							"hx-vals":   "js:{index: document.querySelectorAll('#file-rows > *').length}",
						}) {
							+ Add file
						}

						<div class="border-t border-border pt-5 flex items-center justify-between flex-wrap gap-3">
							<fieldset class="flex items-center gap-3">
								<legend class="sr-only">Visibility</legend>
								if data.Gist.Public {
									<label class="flex items-center gap-1.5 text-[13px]">
										<input type="radio" name="visibility" value="public" checked/> Public
									</label>
									<label class="flex items-center gap-1.5 text-[13px]">
										<input type="radio" name="visibility" value="secret"/> Secret
									</label>
								} else {
									<label class="flex items-center gap-1.5 text-[13px]">
										<input type="radio" name="visibility" value="public"/> Public
									</label>
									<label class="flex items-center gap-1.5 text-[13px]">
										<input type="radio" name="visibility" value="secret" checked/> Secret
									</label>
								}
							</fieldset>
							<div class="flex items-center gap-2">
								@components.LinkButton("/gists/"+data.Gist.ID, components.ButtonOutline, components.ButtonSizeDefault, nil) {
									Cancel
								}
								@components.Button(components.ButtonDestructiveOutline, components.ButtonSizeDefault, templ.Attributes{
									"type":                 "button",
									"hx-delete":            "/api/gists/" + data.Gist.ID,
									"hx-confirm":           "Delete this gist? This action cannot be undone.",
									"hx-on::after-request": "if(event.detail.successful){window.location.href='/gists'}",
								}) {
									Delete gist
								}
								@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
									Save changes
								}
							</div>
						</div>
					</form>
				</div>

				<aside class="space-y-6" aria-label="About this gist">
					<section aria-labelledby="edit-tips-heading">
						<h2 id="edit-tips-heading" class="text-[12px] font-medium text-muted-foreground mb-2">Editing tips</h2>
						<ul class="space-y-2 text-[13px] text-muted-foreground leading-relaxed">
							<li>Renaming a file keeps its content; saving creates a new revision.</li>
							<li>Switching to Secret hides the gist from the Explore listing.</li>
							<li>Use the file extension to pick syntax highlighting (e.g. <span class="font-mono">.go</span>, <span class="font-mono">.sql</span>).</li>
						</ul>
					</section>
					<section aria-labelledby="danger-heading" class="border-t border-border pt-5">
						<h2 id="danger-heading" class="text-[12px] font-medium text-destructive mb-2">Danger zone</h2>
						<p class="text-[13px] text-muted-foreground leading-relaxed">Deleting a gist removes all files and revisions permanently.</p>
					</section>
				</aside>
			</div>

			<script>
				document.getElementById('gist-edit-form').addEventListener('submit', async function(e) {
					e.preventDefault();
					const desc = this.querySelector('[name=description]').value;
					const visEl = this.querySelector('[name="visibility"]:checked');
					const pub = !visEl || visEl.value === 'public';
					const filenames = [...this.querySelectorAll('[name="filename[]"]')].map(el => el.value);
					const contents = [...this.querySelectorAll('[name="content[]"]')].map(el => el.value);
					const files = filenames.map((fn, i) => ({ filename: fn, content: contents[i] }));
					const gistID = this.dataset.gistId;
					const csrf = (document.cookie.match(/csrf_token=([^;]+)/) || [])[1] || '';
					try {
						const res = await fetch('/api/gists/' + gistID, {
							method: 'PATCH',
							headers: {'Content-Type': 'application/json', 'X-CSRF-Token': csrf},
							body: JSON.stringify({ description: desc, public: pub, files })
						});
						if (res.ok) {
							window.location.href = '/gists/' + gistID;
						} else {
							const text = await res.text();
							let msg = text;
							try { msg = JSON.parse(text).error || text; } catch (_) {}
							alert(msg || ('Failed to update gist (HTTP ' + res.status + ')'));
						}
					} catch (err) {
						alert('Could not reach the server. Check your connection and try again.');
					}
				});
			</script>
		</div>
	}
}
