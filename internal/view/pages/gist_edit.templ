package pages

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/layout"
)

templ GistEdit(data view.GistEditData) {
	@layout.Base(data.BasePage, "Edit Gist") {
		<div class="max-w-4xl mx-auto py-8 px-4">
			<h1 class="text-2xl font-bold mb-6">Edit Gist</h1>
			<form id="gist-edit-form" data-gist-id={ data.Gist.ID }>
				<div class="mb-4">
					<label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
					<input type="text" name="description" value={ data.Gist.Description } class="w-full border border-gray-300 rounded px-3 py-2 text-sm"/>
				</div>
				<div class="mb-4 flex items-center gap-2">
					if data.Gist.Public {
						<input type="checkbox" id="public" name="public" checked/>
					} else {
						<input type="checkbox" id="public" name="public"/>
					}
					<label for="public" class="text-sm text-gray-700">Public gist</label>
				</div>
				<div id="file-rows" class="space-y-4">
					for _, f := range data.Files {
						<div class="border border-gray-200 rounded p-4">
							<input type="text" name="filename[]" value={ f.Filename } class="w-full border border-gray-300 rounded px-3 py-1 text-sm mb-2" required/>
							<textarea name="content[]" rows="8" class="w-full border border-gray-300 rounded px-3 py-1 text-sm font-mono">{ f.Content }</textarea>
						</div>
					}
				</div>
				<div class="mt-3">
					<button
						type="button"
						hx-get="/api/gists/file-row"
						hx-target="#file-rows"
						hx-swap="beforeend"
						class="px-3 py-1 border border-gray-300 rounded text-sm hover:bg-gray-50"
					>
						Add file
					</button>
				</div>
				<div class="mt-6 flex gap-3">
					<button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 text-sm font-medium">Save Changes</button>
					<a href={ templ.SafeURL("/gists/" + data.Gist.ID) } class="px-4 py-2 border rounded text-sm hover:bg-gray-50">Cancel</a>
				</div>
			</form>
			<script>
				document.getElementById('gist-edit-form').addEventListener('submit', async function(e) {
					e.preventDefault();
					const desc = this.querySelector('[name=description]').value;
					const pub = this.querySelector('[name=public]').checked;
					const filenames = [...this.querySelectorAll('[name="filename[]"]')].map(el => el.value);
					const contents = [...this.querySelectorAll('[name="content[]"]')].map(el => el.value);
					const files = filenames.map((fn, i) => ({ filename: fn, content: contents[i] }));
					const gistID = this.dataset.gistId;
					const res = await fetch('/api/gists/' + gistID, {
						method: 'PATCH',
						headers: {'Content-Type': 'application/json'},
						body: JSON.stringify({ description: desc, public: pub, files })
					});
					if (res.ok) {
						window.location.href = '/gists/' + gistID;
					} else {
						const err = await res.json();
						alert(err.error || 'Failed to update gist');
					}
				});
			</script>
		</div>
	}
}
