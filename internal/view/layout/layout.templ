package layout

import (
	"strconv"
	"github.com/mkappworks-dev/cloudzilla-app/internal/assets"
	"github.com/mkappworks-dev/cloudzilla-app/internal/model"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/fragments"
)

// htmxConfig keeps htmx 2's handling: handlers answer errors with JSON for the
// error toast, so 4xx and 5xx responses must not swap, and long requests such as
// a merge get no client-side timeout.
const htmxConfig = `{"noSwap":[204,304,"4xx","5xx"],"defaultTimeout":0}`

// An instance serves no docs of its own, so help links go to the upstream repo.
const (
	docsURL      = "https://github.com/mkappworks-dev/cloudzilla-app/tree/main/docs"
	apiDocsURL   = "https://github.com/mkappworks-dev/cloudzilla-app/blob/main/docs/api-reference.md"
	changelogURL = "https://github.com/mkappworks-dev/cloudzilla-app/blob/main/CHANGELOG.md"
)

var externalLink = templ.Attributes{"target": "_blank", "rel": "noopener"}

templ Base(base view.BasePage, title string) {
	<!DOCTYPE html>
	<html lang="en" class="dark" data-code-light={ base.CodeThemeLight() } data-code-dark={ base.CodeThemeDark() }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="htmx-config" content={ htmxConfig }/>
			<title>{ title } — Cloudzilla</title>
			<link rel="icon" type="image/svg+xml" href={ assets.URL("/static/favicon.svg") }/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&family=Geist:wght@400;500;600&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href={ assets.URL("/static/main.css") }/>
			<link rel="stylesheet" href={ assets.URL("/static/code-themes.css") }/>
			<script>
				// Theme bootstrap: applied before paint so there's no flash of wrong theme.
				(function() {
					var saved = localStorage.getItem('cz-theme');
					var systemLight = window.matchMedia('(prefers-color-scheme: light)').matches;
					if (saved === 'light' || (!saved && systemLight)) {
						document.documentElement.classList.remove('dark');
						document.documentElement.classList.add('light');
					}
				})();
				// error doesn't bubble, so capture it: an avatar whose object is gone
				// hides itself and leaves the initials beneath it showing.
				document.addEventListener('error', function(e) {
					if (e.target instanceof HTMLImageElement && e.target.hasAttribute('data-avatar')) e.target.hidden = true;
				}, true);
			</script>
		</head>
		<body class="min-h-screen flex flex-col antialiased font-sans" if url := attachmentsURL(base); url != "" { data-attachments-url={ url } }>
			<a href="#main-content" class="skip-link">Skip to main content</a>

			<header role="banner" class="border-b border-border">
				<div class="max-w-[1400px] mx-auto px-6 h-12 flex items-center gap-3">
					<a href="/" class="flex items-center" aria-label="Cloudzilla, home">
						<svg width="22" height="22" viewBox="0 0 64 64" fill="currentColor" aria-hidden="true" focusable="false">
							<circle cx="22" cy="36" r="9"/>
							<circle cx="32" cy="28" r="11"/>
							<circle cx="44" cy="36" r="9"/>
							<rect x="22" y="36" width="22" height="9" rx="4.5"/>
						</svg>
					</a>

					if base.CurrentUser != nil {
						{{ workspaceName := workspaceContextName(base) }}
						<svg class="text-muted-foreground" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true" focusable="false"><path d="M16 4L8 20"/></svg>

						@components.DropdownMenu() {
							@components.DropdownMenuTrigger(templ.Attributes{
								"class":      "flex items-center gap-2 -ml-1 px-2 h-7 rounded-md hover:bg-accent text-sm font-medium",
								"aria-label": "Switch account or organization, current: " + workspaceName,
							}) {
								@workspaceChip(workspaceName, workspaceAvatarKey(base, workspaceName))
								<span class="font-medium">{ workspaceName }</span>
								<svg class="text-muted-foreground" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M7 10l5 5 5-5"/></svg>
							}
							@components.DropdownMenuContent(components.DropdownAlignStart) {
								@components.DropdownMenuLabel() {
									{ "Account / orgs" }
								}
								@components.DropdownMenuLink("/"+base.CurrentUser.Username, nil) {
									@workspaceChip(base.CurrentUser.Username, base.AvatarKey)
									<span class="flex-1">{ base.CurrentUser.Username }</span>
									<span class="text-[10px] text-muted-foreground">Personal</span>
								}
								for _, entry := range base.UserOrgs {
									@components.DropdownMenuLink("/"+entry.Org.Name, nil) {
										@workspaceChip(entry.Org.Name, entry.Org.AvatarKey)
										<span class="flex-1">{ entry.Org.Name }</span>
										<span class="text-[10px] text-muted-foreground">{ orgRoleLabel(entry.Role) }</span>
									}
								}
								@components.DropdownMenuSeparator()
								@components.DropdownMenuLink("/organizations/new", nil) {
									<svg class="text-muted-foreground" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
									{ "New organization" }
								}
								@components.DropdownMenuLink("/organizations", nil) {
									<svg class="text-muted-foreground" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M3 21h18M3 7h18M5 21V7l7-4 7 4v14"/></svg>
									{ "Your organizations" }
								}
							}
						}
						if base.RepoSubnav != nil {
							<svg class="text-muted-foreground" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true" focusable="false"><path d="M16 4L8 20"></path></svg>
							@components.DropdownMenu() {
								@components.DropdownMenuTrigger(templ.Attributes{
									"class":      "flex items-center gap-2 -ml-1 px-2 h-7 rounded-md hover:bg-accent text-sm",
									"aria-label": "Switch repository, current: " + base.RepoSubnav.OwnerName + "/" + base.RepoSubnav.RepoName,
								}) {
									<span class="font-medium">{ base.RepoSubnav.RepoName }</span>
									<svg class="text-muted-foreground" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6"></path></svg>
								}
								@components.DropdownMenuContent(components.DropdownAlignStart) {
									@components.DropdownMenuLabel() {
										{ base.RepoSubnav.OwnerName + " repositories" }
									}
									for _, ref := range base.RepoSwitcher {
										@components.DropdownMenuLink(ref.Path, nil) {
											{ ref.Name }
										}
									}
									@components.DropdownMenuSeparator()
									@components.DropdownMenuLink("/repos", nil) {
										{ "All repositories" }
									}
								}
							}
							<span class="inline-flex items-center text-[10px] px-1.5 py-0.5 bg-muted border border-border rounded-sm text-muted-foreground">
								if base.RepoSubnav.Private {
									Private
								} else {
									Public
								}
							</span>
						}
					}

					<nav aria-label="Account" class="ml-auto flex items-center gap-1">
						if !base.SetupPending {
							<form action="/search" method="GET" class="hidden md:block" x-data="topnavSearch" x-on:click.outside="close()">
								<label for="topnav-search" class="sr-only">Search Cloudzilla</label>
								<div class="relative" x-data="{ q: '' }">
									<input
										id="topnav-search"
										name="q"
										type="search"
										x-ref="q"
										x-model="q"
										placeholder="Search…"
										autocomplete="off"
										role="combobox"
										aria-autocomplete="list"
										aria-haspopup="listbox"
										aria-controls="topnav-suggest"
										x-bind:aria-expanded="open"
										x-bind:aria-activedescendant="active >= 0 ? optionId(active) : null"
										hx-get="/search/suggest?list=topnav-suggest"
										hx-trigger="input changed delay:200ms"
										hx-target="#topnav-suggest"
										hx-sync="this:replace"
										x-on:keydown.arrow-down.prevent="move(1)"
										x-on:keydown.arrow-up.prevent="move(-1)"
										x-on:keydown.enter="follow($event)"
										x-on:keydown.escape="escape($event)"
										x-on:focus="reopen()"
										class="w-72 focus:w-96 transition-[width] duration-150 h-7 pl-7 pr-14 text-[13px] bg-muted border border-transparent hover:border-border focus:bg-background focus:border-border rounded-md placeholder:text-muted-foreground"
									/>
									<svg class="absolute left-2 top-1.5 text-muted-foreground" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
									<button type="button" x-cloak x-show="q" x-on:click="q = ''; clear(); $refs.q.focus()" class="absolute right-1.5 top-1 h-5 w-5 grid place-items-center rounded-full text-muted-foreground hover:text-foreground hover:bg-accent" aria-label="Clear search">
										<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M18 6L6 18M6 6l12 12"/></svg>
									</button>
									<kbd x-show="!q" class="absolute right-1.5 top-1 h-5 min-w-5 px-1 grid place-items-center text-[11px] font-sans leading-none text-muted-foreground border border-border rounded" aria-hidden="true">/</kbd>
									<div id="topnav-suggest" x-show="open" x-cloak class="absolute inset-x-0 top-full mt-1 z-50 overflow-hidden rounded-md border border-border bg-popover text-popover-foreground shadow-lg"></div>
								</div>
							</form>
						}

						if base.CurrentUser != nil {
							<a href="/notifications" class="relative h-7 w-7 grid place-items-center text-muted-foreground hover:text-foreground rounded-md hover:bg-accent" aria-label={ notificationsAriaLabel(base.UnreadNotifCount) }>
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><path d="M6 8a6 6 0 0112 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 003.4 0"/></svg>
								if base.UnreadNotifCount > 0 {
									<span class="absolute top-1 right-1 min-w-[14px] h-[14px] px-1 grid place-items-center bg-destructive text-destructive-foreground text-[9px] font-medium rounded-full leading-none ring-2 ring-background">{ strconv.Itoa(base.UnreadNotifCount) }</span>
								}
							</a>
						}

						<button type="button" id="theme-toggle" class="text-muted-foreground hover:text-foreground h-7 w-7 grid place-items-center rounded-md border border-border hover:bg-accent" aria-pressed="false" aria-label="Switch to light theme">
							<svg class="dark-only" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
							<svg class="light-only hidden" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
						</button>

						if base.CurrentUser != nil {
							<div class="ml-1">
								@components.DropdownMenu() {
									@components.DropdownMenuTrigger(templ.Attributes{
										"class":      "relative h-7 w-7 rounded-full overflow-hidden bg-muted border border-border grid place-items-center text-xs font-medium hover:bg-accent",
										"aria-label": "User menu for " + base.CurrentUser.Username,
									}) {
										{ avatarInitials(base.CurrentUser.Username) }
										if base.AvatarKey != "" {
											<img data-avatar src={ components.AvatarURL(base.AvatarKey) } alt="" width="28" height="28" decoding="async" class="absolute inset-0 h-full w-full object-cover"/>
										}
									}
									@components.DropdownMenuContent(components.DropdownAlignEnd) {
										<div class="px-2.5 py-2">
											<p class="text-[12px] text-muted-foreground">Signed in as</p>
											<p class="text-[13px] font-medium">{ base.CurrentUser.Username }</p>
										</div>
										@components.DropdownMenuSeparator()
										@components.DropdownMenuLink("/"+base.CurrentUser.Username, nil) {
											<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="text-muted-foreground" aria-hidden="true"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
											{ "Your profile" }
										}
										@components.DropdownMenuLink("/"+base.CurrentUser.Username+"?tab=stars", nil) {
											<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="text-muted-foreground" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
											{ "Your stars" }
										}
										@components.DropdownMenuSeparator()
										@components.DropdownMenuLink("/settings", nil) {
											<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="text-muted-foreground" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 01-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"></path></svg>
											{ "Settings" }
										}
										if base.CurrentUser.IsSuperadmin {
											@components.DropdownMenuLink("/admin/settings", nil) {
												<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="text-muted-foreground" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
												{ "Admin" }
											}
										}
										@components.DropdownMenuLink(docsURL, externalLink) {
											<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="text-muted-foreground" aria-hidden="true"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"></path></svg>
											{ "Docs" }
										}
										@components.DropdownMenuLink(changelogURL, externalLink) {
											<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="text-muted-foreground" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg>
											{ "Changelog" }
										}
										@components.DropdownMenuSeparator()
										<form method="POST" action="/api/auth/logout" class="contents">
											@components.DropdownMenuItem(templ.Attributes{"type": "submit"}) {
												<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="text-destructive" aria-hidden="true"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
												<span class="text-destructive">Sign out</span>
											}
										</form>
									}
								}
							</div>
						} else {
							if base.AllowLogin {
								<a href="/login" class="text-sm text-muted-foreground hover:text-foreground px-2.5 h-7 inline-flex items-center">Sign in</a>
							}
							if base.AllowRegistration {
								<a href="/register" class="text-sm font-medium h-7 px-3 inline-flex items-center bg-primary text-primary-foreground rounded-md hover:bg-primary/90">Register</a>
							}
						}
					</nav>
				</div>
				if base.RepoSubnav != nil {
					@fragments.RepoSubnav(*base.RepoSubnav)
				} else if base.AccountSubnav != nil {
					@fragments.AccountSubnav(*base.AccountSubnav)
				}
			</header>

			<main id="main-content" tabindex="-1" class="max-w-[1400px] mx-auto px-6 pt-6 pb-20 flex-1 w-full">
				{ children... }
			</main>

			<footer role="contentinfo" class="mt-20 w-full max-w-[1400px] mx-auto px-6 text-[11px] text-muted-foreground">
				<div class="border-t border-border py-6 flex items-center justify-between">
					<p class="font-mono">
						cloudzilla / { view.Version() } <span aria-hidden="true">·</span>
						<span role="status">
							<span aria-hidden="true" class="text-success">●</span> all systems normal
						</span>
					</p>
					if !base.SetupPending {
						<nav aria-label="Footer">
							<ul class="flex gap-4 list-none">
								<li><a href={ templ.SafeURL(docsURL) } { externalLink... } class="hover:text-foreground">Docs</a></li>
								<li><a href={ templ.SafeURL(apiDocsURL) } { externalLink... } class="hover:text-foreground">API</a></li>
								<li><a href={ templ.SafeURL(changelogURL) } { externalLink... } class="hover:text-foreground">Changelog</a></li>
							</ul>
						</nav>
					}
				</div>
			</footer>

			if !base.SetupPending {
				@components.CommandPalette("global-cmd") {
					@components.CommandGroup("Navigation") {
						@components.CommandItem("/", nil) {
							{ "Home" }
						}
						@components.CommandItem("/explore", nil) {
							{ "Explore" }
						}
						if base.CurrentUser != nil {
							@components.CommandItem("/repos/new", nil) {
								{ "New repository" }
							}
							@components.CommandItem("/notifications", nil) {
								{ "Notifications" }
							}
						}
					}
					if base.CurrentUser != nil {
						@components.CommandGroup("Account") {
							@components.CommandItem("/"+base.CurrentUser.Username, nil) {
								{ "Your profile" }
							}
							@components.CommandItem("/pulls", nil) {
								{ "Your pull requests" }
							}
							@components.CommandItem("/issues", nil) {
								{ "Your issues" }
							}
							@components.CommandItem("/"+base.CurrentUser.Username+"?tab=gists", nil) {
								{ "Your gists" }
							}
							@components.CommandItem("/"+base.CurrentUser.Username+"?tab=stars", nil) {
								{ "Your stars" }
							}
							@components.CommandItem("/settings", nil) {
								{ "Settings" }
							}
						}
						if base.CurrentUser.IsSuperadmin {
							@components.CommandGroup("Admin") {
								@components.CommandItem("/admin/settings", nil) {
									{ "Admin settings" }
								}
								@components.CommandItem("/admin/audit-log", nil) {
									{ "Audit log" }
								}
								@components.CommandItem("/admin/sso", nil) {
									{ "Single sign-on" }
								}
							}
						}
					}
					@components.CommandGroup("Preferences") {
						@components.CommandItem("", templ.Attributes{"onclick": "document.getElementById('theme-toggle').click(); this.closest('dialog').close()"}) {
							{ "Toggle theme" }
							@components.CommandShortcut() {
								{ "⌘⇧L" }
							}
						}
					}
				}
				@components.CommandKHook()
			}
			@components.ToastContainer()
			@components.ConfirmDialog()

			<script>
				(function() {
					var token = (document.cookie.match(/csrf_token=([^;]+)/) || [])[1] || '';
					// htmx 4 passes an attribute down to descendants only when it is marked :inherited.
					document.body.setAttribute('hx-headers:inherited', JSON.stringify({'X-CSRF-Token': token}));
					function injectCSRF(form) {
						if (form.method && form.method.toUpperCase() !== 'GET' && !form.querySelector('input[name="csrf_token"]')) {
							var input = document.createElement('input');
							input.type = 'hidden'; input.name = 'csrf_token'; input.value = token;
							// First child: as the last one it would take the space-y/divide-y gap below the form's last row.
							form.prepend(input);
						}
					}
					document.querySelectorAll('form').forEach(injectCSRF);
					new MutationObserver(function(mutations) {
						mutations.forEach(function(m) {
							m.addedNodes.forEach(function(n) {
								if (n.tagName === 'FORM') injectCSRF(n);
								else if (n.querySelectorAll) n.querySelectorAll('form').forEach(injectCSRF);
							});
						});
					}).observe(document.body, {childList: true, subtree: true});
				})();

				// Theme toggle — persists to localStorage, syncs aria-pressed + icon.
				(function() {
					var html = document.documentElement;
					var STORAGE_KEY = 'cz-theme';
					function syncThemeUI() {
						var isLight = html.classList.contains('light');
						document.querySelectorAll('.dark-only').forEach(function(el) { el.classList.toggle('hidden', isLight); });
						document.querySelectorAll('.light-only').forEach(function(el) { el.classList.toggle('hidden', !isLight); });
						var toggle = document.getElementById('theme-toggle');
						if (toggle) {
							toggle.setAttribute('aria-pressed', String(isLight));
							toggle.setAttribute('aria-label', isLight ? 'Switch to dark theme' : 'Switch to light theme');
						}
					}
					document.addEventListener('click', function(e) {
						if (e.target.closest('#theme-toggle')) {
							html.classList.toggle('light');
							html.classList.toggle('dark', !html.classList.contains('light'));
							localStorage.setItem(STORAGE_KEY, html.classList.contains('light') ? 'light' : 'dark');
							syncThemeUI();
						}
					});
					document.addEventListener('keydown', function(e) {
						if ((e.metaKey || e.ctrlKey) && e.shiftKey && e.key.toLowerCase() === 'l') {
							e.preventDefault();
							document.getElementById('theme-toggle').click();
						}
					});
					syncThemeUI();
				})();
			</script>
			<script>
				(function() {
					function setMode(ed, mode) {
						ed.querySelectorAll('[data-md-tab]').forEach(function(t) {
							var on = t.dataset.mdTab === mode;
							t.classList.toggle('border-foreground', on);
							t.classList.toggle('text-foreground', on);
							t.classList.toggle('font-medium', on);
							t.classList.toggle('border-transparent', !on);
							t.classList.toggle('text-muted-foreground', !on);
							t.setAttribute('aria-selected', on ? 'true' : 'false');
						});
						ed.querySelector('[data-md-pane="write"]').classList.toggle('hidden', mode !== 'write');
						ed.querySelector('[data-md-pane="preview"]').classList.toggle('hidden', mode !== 'preview');
					}
					function wrap(ta, action) {
						var s = ta.selectionStart, e = ta.selectionEnd, sel = ta.value.slice(s, e);
						var pairs = { bold: ['**', '**'], italic: ['_', '_'], code: ['`', '`'] };
						var out = action === 'link' ? '[' + (sel || 'text') + '](url)'
							: (pairs[action] || ['', ''])[0] + (sel || 'text') + (pairs[action] || ['', ''])[1];
						ta.setRangeText(out, s, e, 'end');
						ta.focus();
					}
					document.addEventListener('click', function(e) {
						var tab = e.target.closest('[data-md-tab]');
						if (tab) { setMode(tab.closest('[data-md-editor]'), tab.dataset.mdTab); return; }
						var act = e.target.closest('[data-md-action]');
						if (act) {
							var ta = act.closest('[data-md-editor]').querySelector('textarea');
							if (ta) wrap(ta, act.dataset.mdAction);
						}
					});
				})();
			</script>
			<script>
				(function() {
					// Pasting or dropping an image into a markdown editor uploads it and inserts its markdown.
					var url = document.body.dataset.attachmentsUrl;
					if (!url) return;
					function csrf() { return (document.cookie.match(/csrf_token=([^;]+)/) || [])[1] || ''; }
					function images(dt) {
						return Array.prototype.filter.call((dt && dt.files) || [], function(f) { return /^image\//.test(f.type); });
					}
					function editorTextarea(e) {
						var ed = e.target.closest && e.target.closest('[data-md-editor]');
						return ed && e.target.tagName === 'TEXTAREA' ? e.target : null;
					}
					function setStatus(ta, msg) {
						var ed = ta.closest('[data-md-editor]');
						var el = ed.querySelector('[data-md-status]');
						if (!el && msg) {
							el = document.createElement('p');
							el.setAttribute('data-md-status', '');
							el.setAttribute('role', 'status');
							el.className = 'px-3 pb-2 text-xs text-destructive';
							ed.appendChild(el);
						}
						if (el) el.textContent = msg;
					}
					function replace(ta, from, to) {
						ta.value = ta.value.replace(from, function() { return to; });
						ta.dispatchEvent(new Event('input', { bubbles: true }));
					}
					function upload(ta, file) {
						var label = (file.name || 'image').replace(/[\[\]()\n]/g, '');
						var placeholder = '![Uploading ' + label + '\u2026]()';
						ta.setRangeText(placeholder + '\n', ta.selectionStart, ta.selectionEnd, 'end');
						var body = new FormData();
						body.append('file', file, file.name || 'image');
						setStatus(ta, '');
						fetch(url, { method: 'POST', body: body, headers: { 'X-CSRF-Token': csrf() }, credentials: 'same-origin' })
							.then(function(res) {
								return res.json().catch(function() { return {}; }).then(function(j) {
									if (!res.ok) throw new Error(j.error || 'Upload failed.');
									replace(ta, placeholder, j.markdown);
								});
							})
							.catch(function(err) {
								replace(ta, placeholder + '\n', '');
								setStatus(ta, err.message || 'Upload failed.');
							});
					}
					document.addEventListener('paste', function(e) {
						var ta = editorTextarea(e), files = images(e.clipboardData);
						if (!ta || !files.length) return;
						e.preventDefault();
						files.forEach(function(f) { upload(ta, f); });
					});
					document.addEventListener('dragover', function(e) {
						if (editorTextarea(e) && e.dataTransfer && Array.prototype.indexOf.call(e.dataTransfer.types, 'Files') >= 0) e.preventDefault();
					});
					document.addEventListener('drop', function(e) {
						var ta = editorTextarea(e), files = images(e.dataTransfer);
						if (!ta || !files.length) return;
						e.preventDefault();
						files.forEach(function(f) { upload(ta, f); });
					});
				})();
			</script>
			<script src={ assets.URL("/htmx.min.js") } defer></script>
			<!-- Before Alpine: it registers its component on alpine:init. -->
			<script src={ assets.URL("/static/select-menu.js") } defer></script>
			<script src={ assets.URL("/static/topnav-search.js") } defer></script>
			<script src={ assets.URL("/alpine.min.js") } defer></script>
			<script data-mermaid-src={ assets.URL("/static/mermaid.min.js") }>
				// Mermaid is megabytes of JS, so only a page holding a diagram loads it.
				(function() {
					var src = document.currentScript.dataset.mermaidSrc;
					var loaded;
					function load() {
						if (!loaded) {
							loaded = new Promise(function(resolve) {
								var script = document.createElement('script');
								script.src = src;
								script.onload = resolve;
								document.head.appendChild(script);
							}).then(function() {
								// Mermaid 12 defaults to the neo look, ELK layout and wider, earlier-wrapping nodes; pin 11's rendering.
								mermaid.initialize({
									startOnLoad: false,
									theme: 'default',
									look: 'classic',
									layout: 'dagre',
									flowchart: { wrappingWidth: 200, minNodeWidth: 0 },
									state: { wrappingWidth: 200, minNodeWidth: 0 },
									// A site-wide layout would replace these diagrams' own layout engines.
									mindmap: { layout: 'cose-bilkent' },
									swimlane: { layout: 'swimlane' },
								});
							});
						}
						return loaded;
					}
					function render() {
						if (document.querySelector('.mermaid:not([data-processed])')) {
							load().then(function() { mermaid.run(); });
						}
					}
					document.addEventListener('DOMContentLoaded', render);
					document.addEventListener('htmx:after:swap', render);
				})();
			</script>
		</body>
	</html>
}

// workspaceContextName labels the topbar's workspace switcher trigger.
// attachmentsURL is where the page's markdown editors upload pasted images, or
// "" when they can't: signed out, outside a repo, or on the wiki, whose pages
// live in git where the attachment sweep can't see what they reference.
func attachmentsURL(base view.BasePage) string {
	if base.CurrentUser == nil || base.RepoSubnav == nil || base.RepoSubnav.Active == "wiki" {
		return ""
	}
	return "/" + base.RepoSubnav.OwnerName + "/" + base.RepoSubnav.RepoName + "/attachments"
}

func workspaceContextName(base view.BasePage) string {
	if base.OwnerContext != "" {
		return base.OwnerContext
	}
	if base.RepoSubnav != nil && base.RepoSubnav.OwnerName != "" {
		return base.RepoSubnav.OwnerName
	}
	if base.CurrentUser != nil {
		return base.CurrentUser.Username
	}
	return ""
}

// firstInitial returns the single-letter avatar fallback used by the workspace
// switcher (a 5×5 px square — one letter is all that fits).
func firstInitial(name string) string {
	if name == "" {
		return "?"
	}
	return upperASCII(name[:1])
}

// orgRoleLabel maps the stored role enum to the human label shown as a small
// badge in the workspace switcher dropdown.
func orgRoleLabel(role model.OrgRole) string {
	switch role {
	case model.OrgRoleOwner:
		return "Owner"
	case model.OrgRoleMember:
		return "Member"
	}
	return string(role)
}

templ workspaceChip(name, avatarKey string) {
	<span class="relative inline-grid place-items-center h-5 w-5 shrink-0 overflow-hidden rounded-sm bg-accent border border-border text-[10px] font-medium" aria-hidden="true">
		{ firstInitial(name) }
		if avatarKey != "" {
			<img data-avatar src={ components.AvatarURL(avatarKey) } alt="" width="20" height="20" decoding="async" class="absolute inset-0 h-full w-full object-cover"/>
		}
	</span>
}

// workspaceAvatarKey finds name among the viewer's own workspaces; any other
// owner being viewed keeps its initial.
func workspaceAvatarKey(base view.BasePage, name string) string {
	if base.CurrentUser != nil && name == base.CurrentUser.Username {
		return base.AvatarKey
	}
	for _, e := range base.UserOrgs {
		if e.Org.Name == name {
			return e.Org.AvatarKey
		}
	}
	return ""
}

// avatarInitials returns 1–2 letters from a username for the avatar fallback.
func avatarInitials(name string) string {
	if name == "" {
		return "?"
	}
	if len(name) == 1 {
		return upperASCII(name)
	}
	return upperASCII(name[:2])
}

// upperASCII uppercases ASCII letters without bringing in unicode/strings.ToUpper —
// keeps the Templ-generated package small.
func upperASCII(s string) string {
	out := make([]byte, len(s))
	for i := 0; i < len(s); i++ {
		c := s[i]
		if c >= 'a' && c <= 'z' {
			c -= 32
		}
		out[i] = c
	}
	return string(out)
}

// notificationsAriaLabel produces a descriptive label for the bell button.
func notificationsAriaLabel(count int) string {
	if count == 0 {
		return "Notifications, none unread"
	}
	if count == 1 {
		return "Notifications, 1 unread"
	}
	return "Notifications, " + strconv.Itoa(count) + " unread"
}
