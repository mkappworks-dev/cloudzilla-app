package layout

import (
	"strconv"
	"strings"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/fragments"
)

templ Base(base view.BasePage, title string) {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } — Cloudzilla</title>
			<link rel="icon" type="image/svg+xml" href="/static/favicon.svg"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&family=Geist:wght@400;500;600&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/static/main.css"/>
			<script>
				// Theme bootstrap: applied before paint so there's no flash of wrong theme.
				(function() {
					var saved = localStorage.getItem('cz-theme');
					var systemLight = window.matchMedia('(prefers-color-scheme: light)').matches;
					if (saved === 'light' || (!saved && systemLight)) {
						document.documentElement.classList.remove('dark');
						document.documentElement.classList.add('light');
					}
				})();
			</script>
		</head>
		<body class="min-h-screen flex flex-col antialiased font-sans">
			<a href="#main-content" class="skip-link">Skip to main content</a>

			<header role="banner" class="border-b border-border">
				<div class="max-w-[1400px] mx-auto px-6 h-12 flex items-center gap-3">
					<a href="/" class="flex items-center" aria-label="Cloudzilla, home">
						<svg width="22" height="22" viewBox="0 0 64 64" fill="currentColor" aria-hidden="true" focusable="false">
							<circle cx="22" cy="36" r="9"/>
							<circle cx="32" cy="28" r="11"/>
							<circle cx="44" cy="36" r="9"/>
							<rect x="22" y="36" width="22" height="9" rx="4.5"/>
						</svg>
					</a>

					if base.CurrentUser != nil {
						<svg class="text-muted-foreground" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true" focusable="false"><path d="M16 4L8 20"/></svg>

						@components.DropdownMenu() {
							@components.DropdownMenuTrigger(templ.Attributes{
								"class":      "flex items-center gap-2 -ml-1 px-2 h-7 rounded-md hover:bg-accent text-sm font-medium",
								"aria-label": "Switch account or owned organization, current: " + base.CurrentUser.Username,
							}) {
								<span class="inline-grid place-items-center h-5 w-5 rounded bg-accent text-[10px] font-medium" aria-hidden="true">
									if len(base.CurrentUser.Username) > 0 {
										{ strings.ToUpper(base.CurrentUser.Username[:1]) }
									}
								</span>
								<span class="font-medium">{ base.CurrentUser.Username }</span>
								<svg class="text-muted-foreground" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6"/></svg>
							}
							@components.DropdownMenuContent(components.DropdownAlignStart) {
								@components.DropdownMenuLabel() {
									{ "Account" }
								}
								@components.DropdownMenuLink("/"+base.CurrentUser.Username, nil) {
									{ base.CurrentUser.Username + " (personal)" }
								}
								if len(base.UserOrgs) > 0 {
									@components.DropdownMenuSeparator()
									@components.DropdownMenuLabel() {
										{ "Owned organizations" }
									}
									for _, org := range base.UserOrgs {
										@components.DropdownMenuLink("/"+org.Name, nil) {
											{ org.Name }
										}
									}
								}
								@components.DropdownMenuSeparator()
								@components.DropdownMenuLink("/organizations/new", nil) {
									{ "New organization" }
								}
							}
						}
					}

					<nav aria-label="Account" class="ml-auto flex items-center gap-1">
						<form action="/search" method="GET" class="hidden md:block">
							<label for="topnav-search" class="sr-only">Search Cloudzilla</label>
							<div class="relative">
								<input id="topnav-search" name="q" type="search" placeholder="Search…" class="w-56 h-7 pl-7 pr-10 text-[13px] bg-muted border border-transparent hover:border-border focus:bg-background focus:border-border rounded-md placeholder:text-muted-foreground"/>
								<svg class="absolute left-2 top-1.5 text-muted-foreground" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
								<kbd class="absolute right-1.5 top-1 text-[10px] px-1.5 py-0.5 bg-background border border-border rounded text-muted-foreground font-mono" aria-hidden="true">⌘K</kbd>
							</div>
						</form>

						<a href="/explore" class="text-sm text-muted-foreground hover:text-foreground px-2.5 h-7 inline-flex items-center">Explore</a>

						if base.CurrentUser != nil {
							<a href="/new" class="text-sm text-muted-foreground hover:text-foreground px-2.5 h-7 inline-flex items-center gap-1.5" title="Create new repository">
								<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"/></svg>
								New
							</a>
							if base.CurrentUser.IsSuperadmin {
								<a href="/admin/settings" class="text-sm text-warning hover:opacity-90 px-2.5 h-7 inline-flex items-center" title="Admin">Admin</a>
							}
							<a href="/notifications" class="relative h-7 w-7 grid place-items-center text-muted-foreground hover:text-foreground rounded-md hover:bg-accent" aria-label={ notificationsAriaLabel(base.UnreadNotifCount) }>
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><path d="M6 8a6 6 0 0112 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 003.4 0"/></svg>
								if base.UnreadNotifCount > 0 {
									<span class="absolute top-1 right-1 min-w-[14px] h-[14px] px-1 grid place-items-center bg-destructive text-destructive-foreground text-[9px] font-medium rounded-full leading-none ring-2 ring-background">{ strconv.Itoa(base.UnreadNotifCount) }</span>
								}
							</a>
						}

						<button type="button" id="theme-toggle" class="text-muted-foreground hover:text-foreground h-7 w-7 grid place-items-center rounded-md border border-border hover:bg-accent" aria-pressed="false" aria-label="Switch to light theme">
							<svg class="dark-only" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
							<svg class="light-only hidden" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
						</button>

						if base.CurrentUser != nil {
							<div class="ml-1">
								@components.DropdownMenu() {
									@components.DropdownMenuTrigger(templ.Attributes{
										"class":      "h-7 w-7 rounded-full bg-muted border border-border grid place-items-center text-xs font-medium hover:bg-accent",
										"aria-label": "User menu for " + base.CurrentUser.Username,
									}) {
										{ avatarInitials(base.CurrentUser.Username) }
									}
									@components.DropdownMenuContent(components.DropdownAlignEnd) {
										@components.DropdownMenuLabel() {
											{ base.CurrentUser.Username }
										}
										@components.DropdownMenuSeparator()
										@components.DropdownMenuLink("/"+base.CurrentUser.Username, nil) {
											{ "Your profile" }
										}
										@components.DropdownMenuLink("/"+base.CurrentUser.Username+"/gists", nil) {
											{ "Your gists" }
										}
										@components.DropdownMenuLink("/"+base.CurrentUser.Username+"/stars", nil) {
											{ "Your stars" }
										}
										@components.DropdownMenuLink("/settings", nil) {
											{ "Settings" }
										}
										@components.DropdownMenuSeparator()
										<form method="POST" action="/api/auth/logout" class="contents">
											@components.DropdownMenuItem(templ.Attributes{"type": "submit"}) {
												{ "Sign out" }
											}
										</form>
									}
								}
							</div>
						} else {
							if base.AllowLogin {
								<a href="/login" class="text-sm text-muted-foreground hover:text-foreground px-2.5 h-7 inline-flex items-center">Sign in</a>
							}
							if base.AllowRegistration {
								<a href="/register" class="text-sm font-medium h-7 px-3 inline-flex items-center bg-primary text-primary-foreground rounded-md hover:bg-primary/90">Register</a>
							}
						}
					</nav>
				</div>
				if base.RepoSubnav != nil {
					@fragments.RepoSubnav(*base.RepoSubnav)
				}
			</header>

			<main id="main-content" tabindex="-1" class="max-w-[1400px] mx-auto px-6 pt-6 pb-20 flex-1 w-full">
				{ children... }
			</main>

			<footer role="contentinfo" class="mt-20 pt-6 border-t border-border flex items-center justify-between text-[11px] text-muted-foreground max-w-[1400px] mx-auto px-6 pb-6">
				<p class="font-mono">
					cloudzilla / v0.2.0 <span aria-hidden="true">·</span>
					<span role="status">
						<span aria-hidden="true" class="text-success">●</span> all systems normal
					</span>
				</p>
				<nav aria-label="Footer">
					<ul class="flex gap-4 list-none">
						<li><a href="/docs" class="hover:text-foreground">Docs</a></li>
						<li><a href="/api" class="hover:text-foreground">API</a></li>
						<li><a href="/changelog" class="hover:text-foreground">Changelog</a></li>
						<li><a href="/status" class="hover:text-foreground">Status</a></li>
					</ul>
				</nav>
			</footer>

			@components.CommandPalette("global-cmd") {
				@components.CommandGroup("Navigation") {
					@components.CommandItem("/", nil) {
						{ "Home" }
					}
					@components.CommandItem("/explore", nil) {
						{ "Explore" }
					}
					if base.CurrentUser != nil {
						@components.CommandItem("/new", nil) {
							{ "New repository" }
						}
						@components.CommandItem("/notifications", nil) {
							{ "Notifications" }
						}
					}
				}
				if base.CurrentUser != nil {
					@components.CommandGroup("Account") {
						@components.CommandItem("/"+base.CurrentUser.Username, nil) {
							{ "Your profile" }
						}
						@components.CommandItem("/"+base.CurrentUser.Username+"/gists", nil) {
							{ "Your gists" }
						}
						@components.CommandItem("/"+base.CurrentUser.Username+"/stars", nil) {
							{ "Your stars" }
						}
						@components.CommandItem("/settings", nil) {
							{ "Settings" }
						}
					}
					if base.CurrentUser.IsSuperadmin {
						@components.CommandGroup("Admin") {
							@components.CommandItem("/admin/settings", nil) {
								{ "Admin settings" }
							}
						}
					}
				}
			}
			@components.CommandKHook()
			@components.ToastContainer()

			<script>
				// CSRF token plumbing — unchanged.
				(function() {
					var token = (document.cookie.match(/csrf_token=([^;]+)/) || [])[1] || '';
					document.body.setAttribute('hx-headers', JSON.stringify({'X-CSRF-Token': token}));
					function injectCSRF(form) {
						if (form.method && form.method.toUpperCase() !== 'GET' && !form.querySelector('input[name="csrf_token"]')) {
							var input = document.createElement('input');
							input.type = 'hidden'; input.name = 'csrf_token'; input.value = token;
							form.appendChild(input);
						}
					}
					document.querySelectorAll('form').forEach(injectCSRF);
					new MutationObserver(function(mutations) {
						mutations.forEach(function(m) {
							m.addedNodes.forEach(function(n) {
								if (n.tagName === 'FORM') injectCSRF(n);
								else if (n.querySelectorAll) n.querySelectorAll('form').forEach(injectCSRF);
							});
						});
					}).observe(document.body, {childList: true, subtree: true});
				})();

				// Theme toggle — persists to localStorage, syncs aria-pressed + icon.
				(function() {
					var html = document.documentElement;
					var STORAGE_KEY = 'cz-theme';
					function syncThemeUI() {
						var isLight = html.classList.contains('light');
						document.querySelectorAll('.dark-only').forEach(function(el) { el.classList.toggle('hidden', isLight); });
						document.querySelectorAll('.light-only').forEach(function(el) { el.classList.toggle('hidden', !isLight); });
						var toggle = document.getElementById('theme-toggle');
						if (toggle) {
							toggle.setAttribute('aria-pressed', String(isLight));
							toggle.setAttribute('aria-label', isLight ? 'Switch to dark theme' : 'Switch to light theme');
						}
					}
					document.addEventListener('click', function(e) {
						if (e.target.closest('#theme-toggle')) {
							html.classList.toggle('light');
							html.classList.toggle('dark', !html.classList.contains('light'));
							localStorage.setItem(STORAGE_KEY, html.classList.contains('light') ? 'light' : 'dark');
							syncThemeUI();
						}
					});
					document.addEventListener('keydown', function(e) {
						if ((e.metaKey || e.ctrlKey) && e.shiftKey && e.key.toLowerCase() === 'l') {
							e.preventDefault();
							document.getElementById('theme-toggle').click();
						}
					});
					syncThemeUI();
				})();
			</script>
			<script>
				// Markdown editor: Write/Preview tab toggle + formatting toolbar.
				(function() {
					function setMode(ed, mode) {
						ed.querySelectorAll('[data-md-tab]').forEach(function(t) {
							var on = t.dataset.mdTab === mode;
							t.classList.toggle('bg-background', on);
							t.classList.toggle('text-foreground', on);
							t.classList.toggle('shadow-sm', on);
							t.classList.toggle('text-muted-foreground', !on);
							t.setAttribute('aria-selected', on ? 'true' : 'false');
						});
						ed.querySelector('[data-md-pane="write"]').classList.toggle('hidden', mode !== 'write');
						ed.querySelector('[data-md-pane="preview"]').classList.toggle('hidden', mode !== 'preview');
					}
					function wrap(ta, action) {
						var s = ta.selectionStart, e = ta.selectionEnd, sel = ta.value.slice(s, e);
						var pairs = { bold: ['**', '**'], italic: ['_', '_'], code: ['`', '`'] };
						var out = action === 'link' ? '[' + (sel || 'text') + '](url)'
							: (pairs[action] || ['', ''])[0] + (sel || 'text') + (pairs[action] || ['', ''])[1];
						ta.setRangeText(out, s, e, 'end');
						ta.focus();
					}
					document.addEventListener('click', function(e) {
						var tab = e.target.closest('[data-md-tab]');
						if (tab) { setMode(tab.closest('[data-md-editor]'), tab.dataset.mdTab); return; }
						var act = e.target.closest('[data-md-action]');
						if (act) {
							var ta = act.closest('[data-md-editor]').querySelector('textarea');
							if (ta) wrap(ta, act.dataset.mdAction);
						}
					});
				})();
			</script>
			<script src="/htmx.min.js" defer></script>
			<script src="/alpine.min.js" defer></script>
			<script src="/static/mermaid.min.js"></script>
			<script>
				mermaid.initialize({ startOnLoad: false, theme: 'default' });
				document.addEventListener('DOMContentLoaded', function () { mermaid.run(); });
				document.addEventListener('htmx:afterSwap', function () { mermaid.run(); });
			</script>
		</body>
	</html>
}

// avatarInitials returns 1–2 letters from a username for the avatar fallback.
func avatarInitials(name string) string {
	if name == "" {
		return "?"
	}
	if len(name) == 1 {
		return upperASCII(name)
	}
	return upperASCII(name[:2])
}

// upperASCII uppercases ASCII letters without bringing in unicode/strings.ToUpper —
// keeps the Templ-generated package small.
func upperASCII(s string) string {
	out := make([]byte, len(s))
	for i := 0; i < len(s); i++ {
		c := s[i]
		if c >= 'a' && c <= 'z' {
			c -= 32
		}
		out[i] = c
	}
	return string(out)
}

// notificationsAriaLabel produces a descriptive label for the bell button.
func notificationsAriaLabel(count int) string {
	if count == 0 {
		return "Notifications, none unread"
	}
	if count == 1 {
		return "Notifications, 1 unread"
	}
	return "Notifications, " + strconv.Itoa(count) + " unread"
}
