package components

// Skeleton has no default size: pass height/width via the class in attrs, or it
// renders zero-height.
templ Skeleton(attrs templ.Attributes) {
	<div
		aria-hidden="true"
		{ withClass(attrs, "animate-pulse rounded-md bg-muted motion-reduce:animate-none")... }
	></div>
}

templ SkeletonText(lines int) {
	<div class="space-y-2" aria-hidden="true">
		for i := 0; i < lines; i++ {
			if i == lines-1 && lines > 1 {
				<div class="animate-pulse rounded-md bg-muted motion-reduce:animate-none h-3 w-2/3"></div>
			} else {
				<div class="animate-pulse rounded-md bg-muted motion-reduce:animate-none h-3 w-full"></div>
			}
		}
	</div>
}
