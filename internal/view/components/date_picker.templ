package components

import (
	"strconv"
	"strings"
	"time"
)

type DatePickerProps struct {
	ID          string
	Name        string
	Label       string // what the date is, e.g. "Due date"; names the calendar popover
	Value       string // YYYY-MM-DD, or empty
	Disabled    bool
	Placeholder string
	Attrs       templ.Attributes // spread on the root, e.g. an x-model binding
}

// datePickerLabel formats a valid YYYY-MM-DD for the trigger before Alpine starts. The year is
// unpadded, like CzDate.formatShort, so the label does not change when Alpine takes over.
func datePickerLabel(value string) string {
	t, err := time.Parse("2006-01-02", value)
	if err != nil || t.Year() < 1 {
		return ""
	}
	return t.Format("Jan 2, ") + strconv.Itoa(t.Year())
}

var datePickerWeekdays = []struct{ Short, Long string }{
	{"Mo", "Monday"}, {"Tu", "Tuesday"}, {"We", "Wednesday"}, {"Th", "Thursday"},
	{"Fr", "Friday"}, {"Sa", "Saturday"}, {"Su", "Sunday"},
}

// DatePicker is a calendar date field driven by datePicker in static/datepicker.js, which
// the page must load. The value is a local YYYY-MM-DD in the hidden input and in `value`
// (x-modelable), so an x-model in Attrs binds it. Picking a day, Today or Clear dispatches
// date-picked with the new value in detail.value.
templ DatePicker(p DatePickerProps) {
	<div
		class="relative"
		x-data="datePicker"
		x-modelable="value"
		data-value={ p.Value }
		data-placeholder={ p.Placeholder }
		if !p.Disabled {
			@click.outside="close(false)"
		}
		{ p.Attrs... }
	>
		<input type="hidden" name={ p.Name } value={ p.Value } x-bind:value="value"/>
		<button
			type="button"
			id={ p.ID }
			x-ref="trigger"
			aria-haspopup="dialog"
			x-bind:aria-expanded="open.toString()"
			disabled?={ p.Disabled }
			if !p.Disabled {
				@click="toggle()"
				@keydown.arrow-down.prevent="show()"
			}
			class="flex h-9 w-full items-center justify-between gap-2 rounded-md border border-input bg-card px-2.5 text-left text-[13px] focus:outline-hidden focus:ring-2 focus:ring-ring disabled:cursor-default disabled:opacity-70"
		>
			if datePickerLabel(p.Value) != "" {
				<span x-text="label || placeholder" x-bind:class="value ? '' : 'text-muted-foreground'">{ datePickerLabel(p.Value) }</span>
			} else {
				<span x-text="label || placeholder" x-bind:class="value ? '' : 'text-muted-foreground'" class="text-muted-foreground">{ p.Placeholder }</span>
			}
			<svg class="shrink-0 text-muted-foreground" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
				<rect x="3" y="5" width="18" height="16" rx="2"></rect>
				<path d="M3 10h18M8 3v4M16 3v4"></path>
			</svg>
		</button>
		if !p.Disabled {
			<div
				x-show="open"
				x-cloak
				x-ref="popover"
				x-bind:style="popStyle"
				role="dialog"
				aria-label={ "Choose " + strings.ToLower(p.Label) }
				class="z-50 w-72 rounded-md border border-border bg-popover p-3 text-popover-foreground shadow-md"
				@keydown.escape.prevent.stop="close()"
				@keydown.tab="close(false)"
			>
				<div class="mb-2 flex items-center justify-between gap-2">
					<button type="button" aria-label="Previous month" @click="shiftMonth(-1)" class="flex h-7 w-7 items-center justify-center rounded text-muted-foreground hover:bg-accent hover:text-accent-foreground">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M15 18l-6-6 6-6"></path></svg>
					</button>
					<p class="text-[13px] font-semibold" x-text="heading" aria-live="polite"></p>
					<button type="button" aria-label="Next month" @click="shiftMonth(1)" class="flex h-7 w-7 items-center justify-center rounded text-muted-foreground hover:bg-accent hover:text-accent-foreground">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M9 18l6-6-6-6"></path></svg>
					</button>
				</div>
				<div role="grid" x-bind:aria-label="heading" @keydown="onGridKey($event)" class="flex flex-col gap-0.5">
					<div role="row" class="grid grid-cols-7">
						for _, w := range datePickerWeekdays {
							<span role="columnheader" title={ w.Long } class="py-1 text-center text-[11px] font-medium text-muted-foreground">{ w.Short }</span>
						}
					</div>
					<template x-for="(week, wi) in weeks" x-bind:key="wi">
						<div role="row" class="grid grid-cols-7 gap-0.5">
							<template x-for="cell in week" x-bind:key="cell.key">
								<button
									type="button"
									role="gridcell"
									x-bind:disabled="cell.blank"
									x-bind:tabindex="cell.focus ? 0 : -1"
									x-bind:data-date="cell.iso"
									x-bind:aria-label="cell.full"
									x-bind:aria-selected="cell.selected.toString()"
									x-bind:aria-current="cell.today ? 'date' : null"
									x-bind:class="cell.selected ? 'bg-primary text-primary-foreground hover:bg-primary/90' : (cell.inMonth ? 'hover:bg-accent hover:text-accent-foreground' : 'text-muted-foreground/60 hover:bg-accent') + (cell.today ? ' font-semibold ring-1 ring-inset ring-ring' : '')"
									class="h-8 rounded text-[13px] tabular-nums focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring disabled:invisible"
									@click="select(cell)"
									x-text="cell.blank ? '' : cell.d"
								></button>
							</template>
						</div>
					</template>
				</div>
				<div class="mt-2 flex items-center justify-between border-t border-border pt-2">
					<button type="button" @click="pickToday()" class="rounded px-2 py-1 text-[12px] font-medium hover:bg-accent hover:text-accent-foreground">Today</button>
					<button type="button" @click="clear()" class="rounded px-2 py-1 text-[12px] text-muted-foreground hover:bg-accent hover:text-accent-foreground">Clear</button>
				</div>
			</div>
		}
	</div>
}
