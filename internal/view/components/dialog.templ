package components

// Dialog wraps the native HTML <dialog> element — the browser handles
// backdrop, ESC-to-close, focus trap, and inert background for us.
//
// Open via JS: document.getElementById("id").showModal()
// Close via a <form method="dialog"> button (see DialogClose) or .close().
//
// Compose with DialogHeader, DialogTitle, DialogDescription, DialogBody, DialogFooter, DialogClose.
//
// The dialog itself scrolls under a sticky header and footer: Chrome would give a
// scrolling body showModal's initial focus, ahead of the first field. A dialog too
// tall for the space below its 28vh margin moves up until its bottom is 1rem from
// the viewport's; translate's 100% is the dialog's own height.
templ Dialog(id string) {
	<dialog
		id={ id }
		class="rounded-lg border border-border bg-popover text-popover-foreground p-0 w-[480px] max-w-[calc(100vw-2rem)] max-h-[calc(100dvh-2rem)] overflow-y-auto mt-[28vh] mb-auto translate-y-[min(0px,calc(100dvh-28vh-1rem-100%))] backdrop:bg-black/60 backdrop:backdrop-blur-xs open:animate-in"
		aria-labelledby={ id + "-title" }
	>
		{ children... }
	</dialog>
}

// DialogHeader is the top section — typically holds DialogTitle + DialogDescription.
templ DialogHeader() {
	<div class="sticky top-0 z-10 bg-popover flex flex-col gap-1 p-5 border-b border-border">
		{ children... }
	</div>
}

// DialogTitle is the primary heading. dialogId must match Dialog's id (for aria-labelledby).
templ DialogTitle(dialogId string) {
	<h2 id={ dialogId + "-title" } class="text-base font-semibold leading-tight">{ children... }</h2>
}

// DialogDescription is the supporting text under a DialogTitle.
templ DialogDescription() {
	<p class="text-[13px] text-muted-foreground leading-snug">{ children... }</p>
}

// DialogBody is the main content region.
templ DialogBody() {
	<div class="p-5 text-sm">
		{ children... }
	</div>
}

// DialogFooter is the bottom action row — right-aligned by default.
templ DialogFooter() {
	<div class="sticky bottom-0 z-10 bg-popover flex items-center justify-end gap-2 p-5 border-t border-border">
		{ children... }
	</div>
}

templ DialogClose() {
	<form method="dialog" class="contents">
		<button type="submit" class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors border border-input bg-transparent hover:bg-accent hover:text-accent-foreground h-9 px-4">
			{ children... }
		</button>
	</form>
}
