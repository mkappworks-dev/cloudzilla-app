package components

type ButtonVariant string

const (
	// The one primary-action style: every create, save and submit button.
	ButtonDefault     ButtonVariant = "default"
	ButtonOutline     ButtonVariant = "outline"
	ButtonGhost       ButtonVariant = "ghost"
	ButtonSecondary   ButtonVariant = "secondary"
	ButtonDestructive ButtonVariant = "destructive"
	// Keeps a destructive action visually secondary next to a primary button.
	ButtonDestructiveOutline ButtonVariant = "destructive-outline"
	// An icon-only row action: muted until hovered, so a list of them doesn't shout.
	ButtonDestructiveGhost ButtonVariant = "destructive-ghost"
	// Approve, reopen and restore only; a create or save button is ButtonDefault.
	ButtonSuccess            ButtonVariant = "success"
	ButtonLink               ButtonVariant = "link"
)

type ButtonSize string

const (
	ButtonSizeSM      ButtonSize = "sm"
	ButtonSizeDefault ButtonSize = "default"
	ButtonSizeLG      ButtonSize = "lg"
	ButtonSizeIcon    ButtonSize = "icon"
)

func buttonVariantClass(v ButtonVariant) string {
	switch v {
	case ButtonOutline:
		return "border border-input bg-transparent hover:bg-accent hover:text-accent-foreground"
	case ButtonGhost:
		return "hover:bg-accent hover:text-accent-foreground"
	case ButtonSecondary:
		return "bg-secondary text-secondary-foreground hover:bg-secondary/80"
	case ButtonDestructive:
		return "bg-destructive text-destructive-foreground hover:bg-destructive/90"
	case ButtonDestructiveOutline:
		return "border border-destructive/40 text-destructive bg-transparent hover:bg-destructive/10 hover:border-destructive"
	case ButtonDestructiveGhost:
		return "text-muted-foreground hover:text-destructive hover:bg-destructive/10"
	case ButtonSuccess:
		return "bg-success text-success-foreground hover:bg-success/90"
	case ButtonLink:
		return "text-foreground underline-offset-4 hover:underline"
	default:
		return "bg-primary text-primary-foreground hover:bg-primary/90"
	}
}

func buttonSizeClass(s ButtonSize) string {
	switch s {
	case ButtonSizeSM:
		return "h-8 px-3 text-[13px]"
	case ButtonSizeLG:
		return "h-10 px-6 text-sm"
	case ButtonSizeIcon:
		return "h-8 w-8"
	default:
		return "h-9 px-4 text-sm"
	}
}

templ Button(variant ButtonVariant, size ButtonSize, attrs templ.Attributes) {
	<button
		{ withClass(attrs, "inline-flex items-center justify-center gap-1.5 rounded-md font-medium transition-colors disabled:opacity-50 disabled:pointer-events-none", buttonVariantClass(variant), buttonSizeClass(size))... }
	>
		{ children... }
	</button>
}

templ LinkButton(href string, variant ButtonVariant, size ButtonSize, attrs templ.Attributes) {
	<a
		href={ templ.SafeURL(href) }
		{ withClass(attrs, "inline-flex items-center justify-center gap-1.5 rounded-md font-medium transition-colors", buttonVariantClass(variant), buttonSizeClass(size))... }
	>
		{ children... }
	</a>
}

templ TrashIcon() {
	<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
		<path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2M19 6l-1 14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1L5 6M10 11v6M14 11v6"></path>
	</svg>
}
