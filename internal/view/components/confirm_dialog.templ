package components

// ConfirmDialog renders a single, page-global confirmation modal that any button
// can trigger. Mounted once near </body> via layout.Base so every page reuses it.
//
// Two triggers are supported:
//
//  1. HTMX requests with `hx-confirm="..."` — htmx fires `htmx:confirm` and this
//     dialog intercepts it, showing a styled prompt instead of the browser default.
//     Add `data-confirm-title` / `data-confirm-label` / `data-confirm-danger` on the
//     same element to customise heading, button label, and destructive styling.
//
//  2. Non-htmx buttons with `data-confirm-action` — the dialog opens with
//     `data-confirm-title` / `data-confirm-msg` / `data-confirm-label` /
//     `data-confirm-danger`. On confirm, if the button is inside a <form>, the
//     form is submitted; otherwise the click is replayed with a bypass flag.
//
// Toast sugar (paired here because the same script wires it):
//   - Any element with `data-toast="msg"` fires a success toast on htmx success.
//   - Any `<form data-toast="msg">` stashes the toast in sessionStorage on submit
//     so it appears after the form's redirect lands on the next page.
templ ConfirmDialog() {
	<dialog
		id="cz-confirm-dialog"
		aria-labelledby="cz-confirm-title"
		class="rounded-lg border border-border bg-popover text-popover-foreground p-0 w-[420px] max-w-[calc(100vw-2rem)] mt-[28vh] mb-auto backdrop:bg-black/60 backdrop:backdrop-blur-sm"
	>
		<div class="p-5">
			<h2 id="cz-confirm-title" class="text-base font-semibold tracking-tight mb-1"></h2>
			<p id="cz-confirm-msg" class="text-[13px] text-muted-foreground leading-relaxed mb-5"></p>
			<div class="flex justify-end gap-2">
				<button type="button" id="cz-confirm-cancel" class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-transparent hover:bg-accent hover:text-accent-foreground h-9 px-4">Cancel</button>
				<button type="button" id="cz-confirm-ok" class="inline-flex items-center justify-center rounded-md text-sm font-medium h-9 px-4 bg-primary text-primary-foreground hover:bg-primary/90">Confirm</button>
			</div>
		</div>
	</dialog>
	<script>
		(function () {
			var dlg       = document.getElementById('cz-confirm-dialog');
			var titleEl   = document.getElementById('cz-confirm-title');
			var msgEl     = document.getElementById('cz-confirm-msg');
			var okBtn     = document.getElementById('cz-confirm-ok');
			var cancelBtn = document.getElementById('cz-confirm-cancel');
			if (!dlg || typeof dlg.showModal !== 'function') return;

			var OK_BASE   = 'inline-flex items-center justify-center rounded-md text-sm font-medium h-9 px-4';
			var OK_PRIMARY = OK_BASE + ' bg-primary text-primary-foreground hover:bg-primary/90';
			var OK_DANGER  = OK_BASE + ' bg-destructive text-destructive-foreground hover:bg-destructive/90';

			var resolver = null;

			function open(opts) {
				titleEl.textContent = opts.title   || 'Are you sure?';
				msgEl.textContent   = opts.message || '';
				okBtn.textContent   = opts.label   || 'Confirm';
				okBtn.className     = opts.danger ? OK_DANGER : OK_PRIMARY;
				dlg.returnValue = '';
				dlg.showModal();
				return new Promise(function (resolve) { resolver = resolve; });
			}

			okBtn.addEventListener('click',     function () { dlg.close('confirm'); });
			cancelBtn.addEventListener('click', function () { dlg.close('cancel'); });
			dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close('cancel'); });
			dlg.addEventListener('close', function () {
				var ok = dlg.returnValue === 'confirm';
				if (resolver) { var r = resolver; resolver = null; r(ok); }
			});

			// (1) htmx:confirm — replace browser confirm() for hx-confirm buttons.
			document.body.addEventListener('htmx:confirm', function (e) {
				var elt = e.detail.elt;
				if (!elt || !elt.hasAttribute('hx-confirm')) return;
				e.preventDefault();
				open({
					title:   elt.getAttribute('data-confirm-title') || 'Are you sure?',
					message: e.detail.question || '',
					label:   elt.getAttribute('data-confirm-label') || 'Confirm',
					danger:  elt.hasAttribute('data-confirm-danger'),
				}).then(function (ok) { if (ok) e.detail.issueRequest(true); });
			});

			// (2) Non-htmx triggers — buttons with data-confirm-action.
			document.body.addEventListener('click', function (e) {
				var trigger = e.target.closest('[data-confirm-action]');
				if (!trigger) return;
				if (trigger.dataset.confirmBypass === '1') { delete trigger.dataset.confirmBypass; return; }
				e.preventDefault();
				open({
					title:   trigger.getAttribute('data-confirm-title') || 'Are you sure?',
					message: trigger.getAttribute('data-confirm-msg')   || '',
					label:   trigger.getAttribute('data-confirm-label') || 'Confirm',
					danger:  trigger.hasAttribute('data-confirm-danger'),
				}).then(function (ok) {
					if (!ok) return;
					var form = trigger.closest('form');
					if (form) {
						stashToastFromForm(form);
						if (form.requestSubmit) form.requestSubmit(trigger);
						else form.submit();
					} else {
						trigger.dataset.confirmBypass = '1';
						trigger.click();
					}
				});
			}, true);

			// (3) Toast sugar — htmx success + data-toast → fire success toast.
			document.body.addEventListener('htmx:afterRequest', function (e) {
				if (!e.detail.successful) return;
				var elt = e.detail.elt;
				if (!elt) return;
				var msg = elt.getAttribute('data-toast');
				if (!msg) return;
				document.dispatchEvent(new CustomEvent('toast', { detail: { type: 'success', message: msg } }));
			});

			// (4) Toast sugar — stash toast across redirecting form submits.
			function stashToastFromForm(form) {
				var msg = form.getAttribute('data-toast');
				if (!msg) return;
				try { sessionStorage.setItem('cz-toast', JSON.stringify({ type: 'success', message: msg })); } catch (e) {}
			}
			document.body.addEventListener('submit', function (e) {
				var form = e.target;
				if (form && form.matches && form.matches('form[data-toast]')) stashToastFromForm(form);
			});
		})();
	</script>
}
