package components

import (
	"strconv"
	"strings"

	"github.com/mkappworks/cloudzilla/internal/model"
)

// idPrefix converts a kind string ("issues" or "pulls") to the singular prefix ("issue" or "pull").
func idPrefix(kind string) string {
	return strings.TrimSuffix(kind, "s")
}

// LabelSidebar renders the labels sidebar panel for an issue or pull request.
// kind must be "issues" or "pulls" — it determines the HTMX target ID and API URL path.
// The outer div ID is "issue-labels" or "pull-labels" to satisfy stable HTMX swap targets.
templ LabelSidebar(owner, repoName string, itemNumber int, kind string, labels []model.Label, allLabels []model.Label, canWrite bool) {
	{{ prefix := idPrefix(kind) }}
	{{ divID := prefix + "-labels" }}
	<div id={ divID } class="space-y-2">
		<h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Labels</h3>
		<div class="flex flex-wrap gap-1">
			if len(labels) == 0 {
				<span class="text-xs text-gray-400">None yet</span>
			} else {
				for _, lbl := range labels {
					<span
						class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium"
						style={ "background-color: " + lbl.Color + "; color: #000" }
					>
						{ lbl.Name }
						if canWrite {
							<button
								hx-delete={ "/api/repos/" + owner + "/" + repoName + "/" + kind + "/" + strconv.Itoa(itemNumber) + "/labels/" + strconv.FormatInt(lbl.ID, 10) }
								hx-target={ "#" + divID }
								hx-swap="outerHTML"
								class="ml-0.5 hover:opacity-70 font-bold leading-none"
								title="Remove label"
							>&times;</button>
						}
					</span>
				}
			}
		</div>
		if canWrite && len(allLabels) > 0 {
			<details class="mt-2">
				<summary class="text-xs text-blue-600 cursor-pointer hover:underline">Add label</summary>
				<div class="mt-1 space-y-1 max-h-40 overflow-y-auto">
					for _, lbl := range allLabels {
						<button
							hx-post={ "/api/repos/" + owner + "/" + repoName + "/" + kind + "/" + strconv.Itoa(itemNumber) + "/labels/" + strconv.FormatInt(lbl.ID, 10) }
							hx-target={ "#" + divID }
							hx-swap="outerHTML"
							class="w-full text-left flex items-center gap-2 px-2 py-1 hover:bg-gray-50 rounded text-xs"
						>
							<span class="w-3 h-3 rounded-full inline-block shrink-0" style={ "background-color: " + lbl.Color }></span>
							{ lbl.Name }
						</button>
					}
				</div>
			</details>
		}
	</div>
}

// AssigneeSidebar renders the assignees sidebar panel for an issue or pull request.
// kind must be "issues" or "pulls" — it determines the HTMX target ID and API URL path.
// The outer div ID is "issue-assignees" or "pull-assignees" to satisfy stable HTMX swap targets.
templ AssigneeSidebar(owner, repoName string, itemNumber int, kind string, assignees []model.User, canWrite bool) {
	{{ prefix := idPrefix(kind) }}
	{{ divID := prefix + "-assignees" }}
	<div id={ divID } class="space-y-2">
		<h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Assignees</h3>
		<div class="space-y-1">
			if len(assignees) == 0 {
				<span class="text-xs text-gray-400">No one assigned</span>
			} else {
				for _, a := range assignees {
					<div class="flex items-center justify-between">
						<span class="text-xs font-medium">{ a.Username }</span>
						if canWrite {
							<button
								hx-delete={ "/api/repos/" + owner + "/" + repoName + "/" + kind + "/" + strconv.Itoa(itemNumber) + "/assignees?username=" + a.Username }
								hx-target={ "#" + divID }
								hx-swap="outerHTML"
								class="text-xs text-red-500 hover:underline ml-2"
								title="Remove assignee"
							>&times;</button>
						}
					</div>
				}
			}
		</div>
		if canWrite {
			<form
				hx-post={ "/api/repos/" + owner + "/" + repoName + "/" + kind + "/" + strconv.Itoa(itemNumber) + "/assignees" }
				hx-target={ "#" + divID }
				hx-swap="outerHTML"
				class="mt-2 flex gap-1"
			>
				<input type="text" name="username" placeholder="Username" required class="flex-1 border border-gray-300 rounded px-2 py-1 text-xs focus:outline-none focus:ring-1 focus:ring-blue-400"/>
				<button type="submit" class="px-2 py-1 bg-blue-600 text-white rounded text-xs hover:bg-blue-700">+</button>
			</form>
		}
	</div>
}
