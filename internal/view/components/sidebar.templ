package components

import (
	"strconv"
	"strings"

	"github.com/mkappworks-dev/cloudzilla-app/internal/model"
)

// idPrefix converts a kind string ("issues" or "pulls") to the singular prefix ("issue" or "pull").
func idPrefix(kind string) string {
	return strings.TrimSuffix(kind, "s")
}

// validKind reports whether kind is a recognised sidebar kind.
func validKind(kind string) bool {
	return kind == "issues" || kind == "pulls"
}

// LabelSidebar renders the labels sidebar panel for an issue or pull request.
// kind must be "issues" or "pulls" — it determines the HTMX target ID and API URL path.
// The outer div ID is "issue-labels" or "pull-labels" to satisfy stable HTMX swap targets.
templ LabelSidebar(owner, repoName string, itemNumber int, kind string, labels []model.Label, allLabels []model.Label, canWrite bool) {
	if validKind(kind) {
	{{ prefix := idPrefix(kind) }}
	{{ divID := prefix + "-labels" }}
	<div id={ divID } class="space-y-2">
		<h3 class="text-[12px] font-medium text-muted-foreground">Labels</h3>
		<div class="flex flex-wrap gap-1">
			if len(labels) == 0 {
				<span class="text-xs text-muted-foreground">None yet</span>
			} else {
				for _, lbl := range labels {
					<span
						class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium border"
						style={ "background-color: " + lbl.Color + "33; color: " + lbl.Color + "; border-color: " + lbl.Color + "55" }
					>
						{ lbl.Name }
						if canWrite {
							<button
								hx-delete={ "/api/repos/" + owner + "/" + repoName + "/" + kind + "/" + strconv.Itoa(itemNumber) + "/labels/" + strconv.FormatInt(lbl.ID, 10) }
								hx-target={ "#" + divID }
								hx-swap="outerHTML"
								class="ml-0.5 hover:opacity-70 font-bold leading-none"
								title="Remove label"
							>&times;</button>
						}
					</span>
				}
			}
		</div>
		if canWrite && len(allLabels) > 0 {
			<details class="mt-2">
				<summary class="text-xs text-muted-foreground cursor-pointer hover:text-foreground">Add label</summary>
				<div class="mt-1 space-y-1 max-h-40 overflow-y-auto rounded-md border border-border bg-card p-1">
					for _, lbl := range allLabels {
						<button
							hx-post={ "/api/repos/" + owner + "/" + repoName + "/" + kind + "/" + strconv.Itoa(itemNumber) + "/labels/" + strconv.FormatInt(lbl.ID, 10) }
							hx-target={ "#" + divID }
							hx-swap="outerHTML"
							class="w-full text-left flex items-center gap-2 px-2 py-1 hover:bg-muted/50 rounded text-xs"
						>
							<span class="w-3 h-3 rounded-full inline-block shrink-0" style={ "background-color: " + lbl.Color }></span>
							{ lbl.Name }
						</button>
					}
				</div>
			</details>
		}
	</div>
	}
}

// AssigneeSidebar renders the assignees sidebar panel for an issue or pull request.
// kind must be "issues" or "pulls" — it determines the HTMX target ID and API URL path.
// The outer div ID is "issue-assignees" or "pull-assignees" to satisfy stable HTMX swap targets.
templ AssigneeSidebar(owner, repoName string, itemNumber int, kind string, assignees []model.User, collaborators []string, canWrite bool) {
	if validKind(kind) {
	{{ prefix := idPrefix(kind) }}
	{{ divID := prefix + "-assignees" }}
	{{ listID := divID + "-collaborators" }}
	<div id={ divID } class="space-y-2">
		<h3 class="text-[12px] font-medium text-muted-foreground">Assignees</h3>
		<div class="space-y-1">
			if len(assignees) == 0 {
				<span class="text-xs text-muted-foreground">No one assigned</span>
			} else {
				for _, a := range assignees {
					<div class="flex items-center gap-2 text-[13px]">
						@Avatar(a.Username, AvatarSizeSM, a.Username)
						<a href={ templ.SafeURL("/" + a.Username) } class="font-medium hover:underline truncate flex-1">{ a.Username }</a>
						if canWrite {
							<button
								hx-delete={ "/api/repos/" + owner + "/" + repoName + "/" + kind + "/" + strconv.Itoa(itemNumber) + "/assignees?username=" + a.Username }
								hx-target={ "#" + divID }
								hx-swap="outerHTML"
								class="text-muted-foreground/60 hover:text-destructive shrink-0"
								title="Remove assignee"
								aria-label={ "Remove " + a.Username }
							>&times;</button>
						}
					</div>
				}
			}
		</div>
		if canWrite {
			<form
				hx-post={ "/api/repos/" + owner + "/" + repoName + "/" + kind + "/" + strconv.Itoa(itemNumber) + "/assignees" }
				hx-target={ "#" + divID }
				hx-swap="outerHTML"
				class="mt-2 flex gap-1"
			>
				<input
					type="text"
					name="username"
					placeholder="Username"
					list={ listID }
					autocomplete="off"
					required
					class="flex-1 h-8 rounded-md border border-input bg-transparent px-2 text-xs text-foreground placeholder:text-muted-foreground shadow-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
				/>
				<datalist id={ listID }>
					for _, c := range collaborators {
						<option value={ c }></option>
					}
				</datalist>
				<button
					type="submit"
					class="inline-flex items-center justify-center h-8 px-2.5 rounded-md text-xs font-medium bg-primary text-primary-foreground hover:bg-primary/90"
				>+</button>
			</form>
		}
	</div>
	}
}
