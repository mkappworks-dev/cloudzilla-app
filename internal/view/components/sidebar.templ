package components

import (
	"strconv"
	"strings"

	"github.com/mkappworks-dev/cloudzilla-app/internal/model"
)

func idPrefix(kind string) string {
	return strings.TrimSuffix(kind, "s")
}

func validKind(kind string) bool {
	return kind == "issues" || kind == "pulls" || kind == "discussions"
}

func labelApplied(applied []model.Label, id int64) bool {
	for _, l := range applied {
		if l.ID == id {
			return true
		}
	}
	return false
}

func userAssigned(assignees []model.User, username string) bool {
	for _, a := range assignees {
		if a.Username == username {
			return true
		}
	}
	return false
}

templ sidebarEditIcon() {
	<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 113 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
}

templ sidebarCheckIcon() {
	<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="shrink-0 text-success" aria-hidden="true" focusable="false"><polyline points="20 6 9 17 4 12"></polyline></svg>
}

templ sidebarTagIcon() {
	<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="shrink-0" aria-hidden="true" focusable="false"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
}

templ sidebarInviteIcon() {
	<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="shrink-0" aria-hidden="true" focusable="false"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"></path><circle cx="11" cy="7" r="4"></circle><line x1="19" y1="8" x2="19" y2="14"></line><line x1="22" y1="11" x2="16" y2="11"></line></svg>
}

// The picker is an Alpine dropdown driven by an "open" variable that MUST be
// provided by an ancestor x-data scope, so the menu survives HTMX re-renders.
templ LabelSidebar(owner, repoName string, itemNumber int, kind string, labels []model.Label, allLabels []model.Label, canWrite bool) {
	if validKind(kind) {
		{{ divID := idPrefix(kind) + "-labels" }}
		{{ base := "/api/repos/" + owner + "/" + repoName + "/" + kind + "/" + strconv.Itoa(itemNumber) + "/labels/" }}
		<div id={ divID } class="space-y-2">
			<div class="flex items-center justify-between">
				<h3 class="text-[12px] font-medium text-muted-foreground">Labels</h3>
				if canWrite && len(allLabels) > 0 {
					<div class="relative" x-on:click.outside="open === 'labels' && (open = null)">
						<button
							type="button"
							x-on:click="open = (open === 'labels' ? null : 'labels')"
							:aria-expanded="open === 'labels' ? 'true' : 'false'"
							aria-haspopup="menu"
							aria-label="Edit labels"
							class="text-muted-foreground hover:text-foreground"
						>
							@sidebarEditIcon()
						</button>
						<div
							x-show="open === 'labels'"
							x-cloak
							x-transition.opacity.duration.100ms
							role="menu"
							aria-label="Apply labels"
							class="absolute right-0 top-full mt-1.5 z-50 w-56 rounded-md border border-border bg-popover text-popover-foreground shadow-md p-1 max-h-72 overflow-y-auto"
						>
							<div class="px-2 pt-1 pb-0.5 text-[10px] font-medium uppercase tracking-wider text-muted-foreground">Apply labels</div>
							for _, lbl := range allLabels {
								{{ applied := labelApplied(labels, lbl.ID) }}
								<button
									type="button"
									if applied {
										hx-delete={ base + strconv.FormatInt(lbl.ID, 10) }
									} else {
										hx-post={ base + strconv.FormatInt(lbl.ID, 10) }
									}
									hx-target={ "#" + divID }
									hx-swap="outerHTML"
									role="menuitemcheckbox"
									aria-checked={ strconv.FormatBool(applied) }
									class="flex w-full items-center gap-2 px-2.5 py-1.5 rounded-md text-left text-[13px] text-muted-foreground hover:bg-accent hover:text-foreground"
								>
									<span class="h-2.5 w-2.5 rounded-full inline-block shrink-0" style={ "background-color: " + lbl.Color }></span>
									<span class="flex-1 truncate">{ lbl.Name }</span>
									if applied {
										@sidebarCheckIcon()
									}
								</button>
							}
							<div role="separator" class="my-1 h-px bg-border"></div>
							<a
								href={ templ.SafeURL("/" + owner + "/" + repoName + "/settings#labels") }
								role="menuitem"
								class="flex w-full items-center gap-2 px-2.5 py-1.5 rounded-md text-left text-[13px] text-muted-foreground hover:bg-accent hover:text-foreground"
							>
								@sidebarTagIcon()
								Create a new label
							</a>
						</div>
					</div>
				}
			</div>
			<div class="flex flex-wrap gap-1">
				if len(labels) == 0 {
					<span class="text-xs text-muted-foreground">None yet</span>
				} else {
					for _, lbl := range labels {
						<span
							class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium border"
							style={ "background-color: " + lbl.Color + "33; color: " + lbl.Color + "; border-color: " + lbl.Color + "55" }
						>
							{ lbl.Name }
						</span>
					}
				}
			</div>
		</div>
	}
}

// See LabelSidebar for the Alpine open-scope contract.
templ AssigneeSidebar(owner, repoName string, itemNumber int, kind string, assignees []model.User, collaborators []string, canWrite bool) {
	if validKind(kind) {
		{{ divID := idPrefix(kind) + "-assignees" }}
		{{ base := "/api/repos/" + owner + "/" + repoName + "/" + kind + "/" + strconv.Itoa(itemNumber) + "/assignees" }}
		<div id={ divID } class="space-y-2">
			<div class="flex items-center justify-between">
				<h3 class="text-[12px] font-medium text-muted-foreground">Assignees</h3>
				if canWrite && len(collaborators) > 0 {
					<div class="relative" x-on:click.outside="open === 'assignees' && (open = null)">
						<button
							type="button"
							x-on:click="open = (open === 'assignees' ? null : 'assignees')"
							:aria-expanded="open === 'assignees' ? 'true' : 'false'"
							aria-haspopup="menu"
							aria-label="Edit assignees"
							class="text-muted-foreground hover:text-foreground"
						>
							@sidebarEditIcon()
						</button>
						<div
							x-show="open === 'assignees'"
							x-cloak
							x-transition.opacity.duration.100ms
							role="menu"
							aria-label="Assign people"
							class="absolute right-0 top-full mt-1.5 z-50 w-56 rounded-md border border-border bg-popover text-popover-foreground shadow-md p-1 max-h-72 overflow-y-auto"
						>
							<div class="px-2 pt-1 pb-0.5 text-[10px] font-medium uppercase tracking-wider text-muted-foreground">Assign people</div>
							for _, c := range collaborators {
								{{ assigned := userAssigned(assignees, c) }}
								<button
									type="button"
									if assigned {
										hx-delete={ base + "?username=" + c }
									} else {
										hx-post={ base }
										hx-vals={ `{"username":"` + c + `"}` }
									}
									hx-target={ "#" + divID }
									hx-swap="outerHTML"
									role="menuitemcheckbox"
									aria-checked={ strconv.FormatBool(assigned) }
									class="flex w-full items-center gap-2 px-2.5 py-1.5 rounded-md text-left text-[13px] text-muted-foreground hover:bg-accent hover:text-foreground"
								>
									@Avatar(c, AvatarSizeSM, c)
									<span class="flex-1 truncate">{ c }</span>
									if assigned {
										@sidebarCheckIcon()
									}
								</button>
							}
							<div role="separator" class="my-1 h-px bg-border"></div>
							<a
								href={ templ.SafeURL("/" + owner + "/" + repoName + "/settings#collaborators") }
								role="menuitem"
								class="flex w-full items-center gap-2 px-2.5 py-1.5 rounded-md text-left text-[13px] text-muted-foreground hover:bg-accent hover:text-foreground"
							>
								@sidebarInviteIcon()
								Invite a collaborator
							</a>
						</div>
					</div>
				}
			</div>
			<div class="space-y-1">
				if len(assignees) == 0 {
					<span class="text-xs text-muted-foreground">No one assigned</span>
				} else {
					for _, a := range assignees {
						<div class="flex items-center gap-2 text-[13px]">
							@Avatar(a.Username, AvatarSizeSM, a.Username)
							<a href={ templ.SafeURL("/" + a.Username) } class="font-medium hover:underline truncate">{ a.Username }</a>
						</div>
					}
				}
			</div>
		</div>
	}
}
