package components

import "strconv"

// CommitLine is one commit shown in a push activity row.
type CommitLine struct {
	SHA     string
	Message string
}

type ActivityRowData struct {
	Kind        string // "pr_opened", "pr_merged", "pr_closed", "issue_opened", "issue_closed", "comment", "push", "star", "release", "fork", "member_added"
	Actor       string
	RepoName    string // "owner/repo"
	Ref         string // "#341" — inline on line 1; empty for star/fork/member/push
	RefURL      string // link target for Ref
	Title       string // line-2 subject text; empty when unavailable
	When        string // pre-formatted relative
	Branch      string       // push: branch name
	Commits     []CommitLine // push: up to 3 commit summaries
	CommitTotal int          // push: total commits in the push
	Quote       string       // comment: body snippet
}

templ ActivityRow(a ActivityRowData) {
	<li class="px-4 py-3 flex items-start gap-3 hover:bg-accent">
		<span class="h-8 w-8 rounded-full bg-accent border border-border grid place-items-center text-[11px] font-medium shrink-0 mt-0.5 select-none" aria-hidden="true">{ actorInitials(a.Actor) }</span>
		<div class="min-w-0 flex-1">
			<p class="text-[13px]">
				<a href={ templ.SafeURL("/" + a.Actor) } class="font-medium hover:underline">{ a.Actor }</a>
				if a.Kind == "push" {
					<span class="text-muted-foreground">{ " pushed " }</span><span class="font-mono">{ commitCountLabel(a.CommitTotal) }</span><span class="text-muted-foreground">{ " to " }</span><span class="font-mono text-muted-foreground">{ a.Branch }</span>
				} else {
					<span class="text-muted-foreground">{ " " + activityVerb(a.Kind) }</span>
					if a.Ref != "" {
						<span class="text-muted-foreground">{ " " }</span><a href={ templ.SafeURL(a.RefURL) } class="font-mono hover:underline text-primary">{ a.Ref }</a>
					}
				}
				if a.RepoName != "" {
					<span class="text-muted-foreground">{ " in " }</span><a href={ templ.SafeURL("/" + a.RepoName) } class="font-mono text-muted-foreground hover:underline">{ a.RepoName }</a>
				}
			</p>
			if a.Kind == "push" && len(a.Commits) > 0 {
				<ul class="mt-1 text-[12.5px] text-muted-foreground space-y-0.5">
					for _, c := range a.Commits {
						<li class="truncate"><span class="font-mono text-[11px] text-muted-foreground/70 mr-1">{ c.SHA }</span>{ c.Message }</li>
					}
					if a.CommitTotal > len(a.Commits) {
						<li class="text-[11px] text-muted-foreground/70">{ moreCommitsLabel(a.CommitTotal - len(a.Commits)) }</li>
					}
				</ul>
			} else if a.Kind == "comment" && a.Quote != "" {
				<blockquote class="mt-1 pl-3 border-l border-border text-[12.5px] text-muted-foreground italic">{ "“" + a.Quote + "”" }</blockquote>
			} else if a.Title != "" {
				<p class="mt-0.5 text-[12.5px] text-muted-foreground truncate">{ a.Title }</p>
			}
			<p class="mt-1 text-[11px] text-muted-foreground/70"><time>{ a.When }</time></p>
		</div>
		@activityIcon(a.Kind)
	</li>
}

func commitCountLabel(n int) string {
	if n == 1 {
		return "1 commit"
	}
	return strconv.Itoa(n) + " commits"
}

func moreCommitsLabel(n int) string {
	if n == 1 {
		return "and 1 more commit"
	}
	return "and " + strconv.Itoa(n) + " more commits"
}

func actorInitials(name string) string {
	r := []rune(name)
	switch {
	case len(r) == 0:
		return "?"
	case len(r) == 1:
		return string(r[:1])
	default:
		return string(r[:2])
	}
}

func activityVerb(kind string) string {
	switch kind {
	case "push":
		return "pushed"
	case "pr_opened":
		return "opened"
	case "pr_merged":
		return "merged"
	case "pr_closed":
		return "closed"
	case "issue_opened":
		return "opened"
	case "issue_closed":
		return "closed"
	case "comment":
		return "commented on"
	case "star":
		return "starred"
	case "release", "release_published":
		return "released"
	case "fork":
		return "forked"
	case "member_added":
		return "added member"
	}
	return "updated"
}

templ activityIcon(kind string) {
	switch kind {
	case "pr_opened":
		<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" class="shrink-0 mt-1 text-success" aria-hidden="true">
			<path d="M1.5 3.25a2.25 2.25 0 113 2.122v5.256a2.251 2.251 0 11-1.5 0V5.372A2.25 2.25 0 011.5 3.25zm5.677-.177L9.573.677A.25.25 0 0110 .854V2.5h1A2.5 2.5 0 0113.5 5v5.628a2.251 2.251 0 11-1.5 0V5a1 1 0 00-1-1h-1v1.646a.25.25 0 01-.427.177L7.177 3.427a.25.25 0 010-.354zM3.75 2.5a.75.75 0 100 1.5.75.75 0 000-1.5zm0 9.5a.75.75 0 100 1.5.75.75 0 000-1.5zm8.25.75a.75.75 0 101.5 0 .75.75 0 00-1.5 0z"></path>
		</svg>
	case "pr_merged":
		<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" class="shrink-0 mt-1 text-[hsl(270_70%_70%)]" aria-hidden="true">
			<path d="M5 3.254V3.25v.005a.75.75 0 110-.005v.004zm.45 1.9a2.25 2.25 0 10-1.95.218v5.256a2.25 2.25 0 101.5 0V7.123A5.735 5.735 0 009.25 9h1.378a2.251 2.251 0 100-1.5H9.25a4.25 4.25 0 01-3.8-2.346zM12.75 9a.75.75 0 100-1.5.75.75 0 000 1.5zm-8.5 4.5a.75.75 0 100-1.5.75.75 0 000 1.5z"></path>
		</svg>
	case "pr_closed":
		<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" class="shrink-0 mt-1 text-destructive" aria-hidden="true">
			<path d="M1.5 3.25a2.25 2.25 0 113 2.122v5.256a2.251 2.251 0 11-1.5 0V5.372A2.25 2.25 0 011.5 3.25zm5.677-.177L9.573.677A.25.25 0 0110 .854V2.5h1A2.5 2.5 0 0113.5 5v5.628a2.251 2.251 0 11-1.5 0V5a1 1 0 00-1-1h-1v1.646a.25.25 0 01-.427.177L7.177 3.427a.25.25 0 010-.354zM3.75 2.5a.75.75 0 100 1.5.75.75 0 000-1.5zm0 9.5a.75.75 0 100 1.5.75.75 0 000-1.5zm8.25.75a.75.75 0 101.5 0 .75.75 0 00-1.5 0z"></path>
		</svg>
	case "issue_opened":
		<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" class="shrink-0 mt-1 text-success" aria-hidden="true">
			<path d="M8 9.5a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"></path><path fill-rule="evenodd" d="M8 0a8 8 0 100 16A8 8 0 008 0zM1.5 8a6.5 6.5 0 1113 0 6.5 6.5 0 01-13 0z"></path>
		</svg>
	case "issue_closed":
		<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" class="shrink-0 mt-1 text-destructive" aria-hidden="true">
			<path d="M11.28 6.78a.75.75 0 00-1.06-1.06L7.25 8.69 5.78 7.22a.75.75 0 00-1.06 1.06l2 2a.75.75 0 001.06 0l3.5-3.5z"></path><path fill-rule="evenodd" d="M16 8A8 8 0 110 8a8 8 0 0116 0zm-1.5 0a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z"></path>
		</svg>
	case "comment":
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="shrink-0 mt-1 text-muted-foreground" aria-hidden="true">
			<path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"></path>
		</svg>
	case "star":
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="shrink-0 mt-1 text-warning" aria-hidden="true">
			<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
		</svg>
	case "release", "release_published":
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="shrink-0 mt-1 text-muted-foreground" aria-hidden="true">
			<path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line>
		</svg>
	case "push":
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 mt-1 text-muted-foreground" aria-hidden="true">
			<circle cx="12" cy="12" r="3"></circle><line x1="3" y1="12" x2="9" y2="12"></line><line x1="15" y1="12" x2="21" y2="12"></line>
		</svg>
	default:
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="shrink-0 mt-1 text-muted-foreground" aria-hidden="true">
			<circle cx="12" cy="12" r="3"></circle><line x1="3" y1="12" x2="9" y2="12"></line><line x1="15" y1="12" x2="21" y2="12"></line>
		</svg>
	}
}
