package components

import "strings"

// AvatarSize controls the diameter of the avatar.
type AvatarSize string

const (
	AvatarSizeXS      AvatarSize = "xs"      // 20px — inline with text
	AvatarSizeSM      AvatarSize = "sm"      // 24px — list rows
	AvatarSizeDefault AvatarSize = "default" // 28px — nav bar
	AvatarSizeLG      AvatarSize = "lg"      // 40px — profile chrome
	AvatarSizeXL      AvatarSize = "xl"      // 64px — settings
)

func avatarSizeClass(s AvatarSize) string {
	switch s {
	case AvatarSizeXS:
		return "h-5 w-5 text-[10px]"
	case AvatarSizeSM:
		return "h-6 w-6 text-[10px]"
	case AvatarSizeLG:
		return "h-10 w-10 text-sm"
	case AvatarSizeXL:
		return "h-16 w-16 text-base"
	default:
		return "h-7 w-7 text-xs"
	}
}

func avatarSizePx(s AvatarSize) string {
	switch s {
	case AvatarSizeXS:
		return "20"
	case AvatarSizeSM:
		return "24"
	case AvatarSizeLG:
		return "40"
	case AvatarSizeXL:
		return "64"
	default:
		return "28"
	}
}

// initials returns 1–2 letters from a name, e.g. "Malith Kuruppu" → "MK", "daisy" → "D".
func initials(name string) string {
	name = strings.TrimSpace(name)
	if name == "" {
		return "?"
	}
	parts := strings.Fields(name)
	if len(parts) == 1 {
		return strings.ToUpper(parts[0][:1])
	}
	return strings.ToUpper(parts[0][:1] + parts[len(parts)-1][:1])
}

// Avatar renders the uploaded avatar of the user or org called name, looked up
// in the keys the handler put on ctx with WithAvatarKeys, or initials when
// there is none. `alt` is what screen readers announce; pass "" for purely
// decorative avatars to keep them out of the a11y tree.
templ Avatar(name string, size AvatarSize, alt string) {
	@AvatarImage(name, AvatarURL(avatarKeyFor(ctx, name)), size, alt)
}

// AvatarImage renders the image at url, or initials from name when url is "".
templ AvatarImage(name, url string, size AvatarSize, alt string) {
	if url != "" {
		<img
			src={ url }
			alt={ alt }
			width={ avatarSizePx(size) }
			height={ avatarSizePx(size) }
			loading="lazy"
			decoding="async"
			class={ "inline-block shrink-0 rounded-full bg-muted border border-border object-cover", avatarSizeClass(size) }
		/>
	} else {
		@Initials(name, size, alt)
	}
}

// Initials never shows an image: it is for names that aren't accounts, such
// as git commit authors, which could match an unrelated username.
templ Initials(name string, size AvatarSize, alt string) {
	if alt == "" {
		<span
			class={ "inline-grid place-items-center rounded-full bg-muted border border-border font-medium text-muted-foreground", avatarSizeClass(size) }
			aria-hidden="true"
		>{ initials(name) }</span>
	} else {
		<span
			class={ "inline-grid place-items-center rounded-full bg-muted border border-border font-medium text-muted-foreground", avatarSizeClass(size) }
			role="img"
			aria-label={ alt }
		>{ initials(name) }</span>
	}
}
