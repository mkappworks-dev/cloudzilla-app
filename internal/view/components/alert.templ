package components

// AlertVariant controls the visual treatment of an Alert banner.
type AlertVariant string

const (
	AlertDefault     AlertVariant = "default"     // neutral, card-toned
	AlertInfo        AlertVariant = "info"        // accent/primary tint, for informational notes
	AlertSuccess     AlertVariant = "success"     // green tint
	AlertWarning     AlertVariant = "warning"     // amber tint
	AlertDestructive AlertVariant = "destructive" // red tint, for errors
)

func alertVariantClass(v AlertVariant) string {
	switch v {
	case AlertInfo:
		return "border-primary/30 bg-primary/5 text-foreground"
	case AlertSuccess:
		return "border-success/40 bg-success/10 text-success"
	case AlertWarning:
		return "border-warning/40 bg-warning/10 text-warning"
	case AlertDestructive:
		return "border-destructive/40 bg-destructive/10 text-destructive"
	default:
		return "border-border bg-card text-card-foreground"
	}
}

// Alert renders a banner with a colored border + tinted background, used for
// inline status messages (errors, warnings, success confirmations, tips).
//
// Compose with AlertTitle and AlertDescription, plus an optional leading icon.
// The leading icon should be the first child and is automatically positioned
// via the `[&>svg]:absolute` selector on the wrapper.
//
// Example:
//
//	@components.Alert(components.AlertDestructive) {
//	  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
//	       stroke-width="2" aria-hidden="true" focusable="false">
//	    <circle cx="12" cy="12" r="10"></circle>
//	    <line x1="12" y1="8" x2="12" y2="12"></line>
//	    <line x1="12" y1="16" x2="12.01" y2="16"></line>
//	  </svg>
//	  @components.AlertTitle() { "Merge blocked" }
//	  @components.AlertDescription() { "There are conflicts in 3 files." }
//	}
templ Alert(variant AlertVariant) {
	<div
		role="alert"
		class={ "relative w-full rounded-md border p-4 [&>svg]:absolute [&>svg]:left-4 [&>svg]:top-4 [&>svg+div]:pl-7 [&>svg~*]:pl-7", alertVariantClass(variant) }
	>
		{ children... }
	</div>
}

// AlertTitle is the bold heading line of an Alert.
templ AlertTitle() {
	<h5 class="mb-1 font-medium leading-none tracking-tight">
		{ children... }
	</h5>
}

// AlertDescription is the body text of an Alert. Renders at small size with
// relaxed line height so multi-line content is readable.
templ AlertDescription() {
	<div class="text-sm [&_p]:leading-relaxed opacity-90">
		{ children... }
	</div>
}
