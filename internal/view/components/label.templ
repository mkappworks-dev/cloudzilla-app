package components

// The asterisk is aria-hidden: also set `required` on the control so assistive tech announces it.
templ Label(forID string, required bool, attrs templ.Attributes) {
	<label
		for={ forID }
		{ withClass(attrs, "text-[13px] font-medium leading-none text-foreground")... }
	>
		{ children... }
		if required {
			<span class="text-destructive ml-0.5" aria-hidden="true">*</span>
		}
	</label>
}
