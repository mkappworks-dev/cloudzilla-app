package components

import "github.com/mkappworks-dev/cloudzilla-app/internal/model"

// StatusIcon renders a colored symbol for a commit status state:
// success=green ✓, failure=red ✗, error=red ⚠, pending=yellow ●
templ StatusIcon(state model.CommitStatusState) {
	if state == model.CommitStatusSuccess {
		<span class="text-success">&#10003;</span>
	} else if state == model.CommitStatusFailure {
		<span class="text-destructive">&#10007;</span>
	} else if state == model.CommitStatusError {
		<span class="text-destructive">&#9888;</span>
	} else {
		<span class="text-warning">&#9679;</span>
	}
}

// StatusRow renders a single commit status check row with icon, context name, description, and details link.
templ StatusRow(s model.CommitStatus) {
	<div class="flex items-center gap-3 text-sm">
		@StatusIcon(s.State)
		<span class="font-medium text-foreground">{ s.Context }</span>
		if s.Description != "" {
			<span class="text-muted-foreground">— { s.Description }</span>
		}
		if s.TargetURL != "" {
			<a href={ templ.SafeURL(s.TargetURL) } class="text-foreground hover:underline ml-auto text-xs">Details</a>
		}
	</div>
}
