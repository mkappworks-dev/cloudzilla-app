package components

import "strconv"

type StatItem struct {
	Label    string
	Value    int
	Subtitle string // qualifier shown next to the value (e.g. "open")
	Detail   string // smaller detail line shown below (e.g. "3 private, 11 public")
}

templ StatStrip(items []StatItem) {
	<dl class="grid grid-cols-2 md:grid-cols-4 gap-3">
		for _, it := range items {
			<div class="rounded-md border border-border bg-card p-3">
				<dt class="text-[11px] font-mono text-muted-foreground uppercase tracking-wider">{ it.Label }</dt>
				<dd class="text-2xl font-semibold tracking-tight mt-1">
					{ strconv.Itoa(it.Value) }
					if it.Subtitle != "" {
						<span class="text-muted-foreground text-lg font-normal">{ " " + it.Subtitle }</span>
					}
				</dd>
				if it.Detail != "" {
					<dd class="text-[11px] text-muted-foreground/70 mt-1">{ it.Detail }</dd>
				}
			</div>
		}
	</dl>
}
