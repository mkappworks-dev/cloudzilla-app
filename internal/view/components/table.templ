package components

// Never fake tables with grid/flex: screen readers need the native row/column semantics.

// Adds no horizontal scroll; wrap tables wider than the viewport in an overflow-x container.
templ Table(attrs templ.Attributes) {
	<table { withClass(attrs, "w-full caption-bottom text-sm")... }>
		{ children... }
	</table>
}

templ TableHeader() {
	<thead class="[&_tr]:border-b [&_tr]:border-border">
		{ children... }
	</thead>
}

templ TableBody() {
	<tbody class="[&_tr:last-child]:border-0">
		{ children... }
	</tbody>
}

templ TableFooter() {
	<tfoot class="border-t border-border bg-muted/50 font-medium [&>tr]:last:border-b-0">
		{ children... }
	</tfoot>
}

templ TableRow(hoverable bool) {
	if hoverable {
		<tr class="border-b border-border transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted">
			{ children... }
		</tr>
	} else {
		<tr class="border-b border-border">
			{ children... }
		</tr>
	}
}

// scope is not defaulted; pass {"scope": "col"} via attrs. Icon-only columns
// still need a text label in a <span class="sr-only">.
templ TableHead(attrs templ.Attributes) {
	<th { withClass(attrs, "h-10 px-4 text-left align-middle text-[11px] font-medium text-muted-foreground font-mono uppercase tracking-wider [&:has([role=checkbox])]:pr-0")... }>
		{ children... }
	</th>
}

templ TableCell(attrs templ.Attributes) {
	<td { withClass(attrs, "p-4 align-middle [&:has([role=checkbox])]:pr-0")... }>
		{ children... }
	</td>
}

// Use instead of TableCell for each row's identifying cell (repo name, PR title):
// screen readers announce it as the row's label.
templ TableRowHead(attrs templ.Attributes) {
	<th scope="row" { withClass(attrs, "p-4 align-middle font-normal text-left")... }>
		{ children... }
	</th>
}

// Give non-trivial tables a caption so screen readers can name them; pass
// class "sr-only" via attrs to hide it visually.
templ TableCaption(attrs templ.Attributes) {
	<caption { withClass(attrs, "mt-4 text-sm text-muted-foreground")... }>
		{ children... }
	</caption>
}
