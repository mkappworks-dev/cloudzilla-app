package components

// ConfirmIdentityDialog asks for the factors in f when a form marked
// data-confirm-identity="<confirm button label>" is submitted, then submits the
// form again with them. Render it once per page, outside any form, and only when
// f.Any(): without it those forms submit directly. A form also marked
// data-confirm-reset is reset when the dialog is dismissed, so a switch that
// submitted it flips back.
templ ConfirmIdentityDialog(f ConfirmFactors) {
	@Dialog("cz-identity-dialog") {
		<form method="dialog" data-validate>
			@DialogHeader() {
				@DialogTitle("cz-identity-dialog") {
					Confirm it's you
				}
				@DialogDescription() {
					{ "This change needs " + f.Needs() + "." }
				}
			}
			@DialogBody() {
				<div class="flex flex-wrap items-end gap-3">
					@confirmFields("cz-identity", f, true, true)
				</div>
			}
			@DialogFooter() {
				@Button(ButtonOutline, ButtonSizeDefault, templ.Attributes{"type": "button", "data-identity-cancel": true}) {
					Cancel
				}
				@Button(ButtonDefault, ButtonSizeDefault, templ.Attributes{"type": "submit", "data-identity-ok": true, "disabled": f.Unavailable}) {
					Confirm
				}
			}
		</form>
	}
	<script>
		(function () {
			var dlg = document.getElementById('cz-identity-dialog');
			if (!dlg || typeof dlg.showModal !== 'function') return;
			var box = dlg.querySelector('form');
			var okBtn = dlg.querySelector('[data-identity-ok]');
			var pending = null;
			var resubmitting = null;
			var waitingForError = null;

			// Capture at the document runs before htmx's own submit listener on the form.
			document.addEventListener('submit', function (e) {
				var form = e.target;
				if (!form.matches || !form.matches('form[data-confirm-identity]')) return;
				if (form === resubmitting) return;
				e.preventDefault();
				e.stopPropagation();
				pending = { form: form, submitter: e.submitter };
				okBtn.textContent = form.getAttribute('data-confirm-identity') || 'Confirm';
				box.reset();
				CzFields.clearAll(box);
				box.querySelectorAll('[data-password-reveal][aria-pressed="true"]').forEach(function (b) { b.click(); });
				dlg.returnValue = '';
				dlg.showModal();
			}, true);

			dlg.querySelector('[data-identity-cancel]').addEventListener('click', function () { dlg.close(); });

			box.addEventListener('submit', function (e) {
				e.preventDefault();
				var target = pending;
				if (!target) return;
				var factors = new FormData(box);
				// htmx builds its request body with new FormData(form) too, so this reaches htmx and native posts alike.
				target.form.addEventListener('formdata', function (fe) {
					factors.forEach(function (v, k) { fe.formData.set(k, v); });
				}, { once: true });
				// An htmx form answers a wrong factor in place, so the dialog stays open until the request is accepted.
				if (target.form.matches('[hx-post],[hx-put],[hx-patch],[hx-delete]')) {
					waitingForError = target.form;
					okBtn.disabled = true;
				} else {
					pending = null;
					dlg.close('confirmed');
				}
				resubmitting = target.form;
				try { target.form.requestSubmit(target.submitter); } finally { resubmitting = null; }
			});

			// renderFormError retargets a refusal to the form's own error slot, behind the backdrop; move it into the dialog.
			// finally:request, not after:request: htmx skips after:request when the fetch itself throws.
			document.addEventListener('htmx:finally:request', function (e) {
				var ctx = e.detail.ctx;
				if (!waitingForError || ctx.sourceElement !== waitingForError) return;
				okBtn.disabled = false;
				if (ctx.hx && ctx.hx.retarget) return;
				finish();
			});
			document.addEventListener('htmx:after:swap', function (e) {
				var ctx = e.detail.ctx;
				if (!waitingForError || ctx.sourceElement !== waitingForError || !(ctx.hx && ctx.hx.retarget)) return;
				var slot = waitingForError.querySelector(ctx.hx.retarget) || document.querySelector(ctx.hx.retarget);
				var msg = slot ? slot.textContent.trim() : '';
				if (slot) slot.textContent = '';
				var field = box.querySelector('input:not([type=hidden])');
				if (field) {
					CzFields.show(field, msg || "That didn't confirm it's you.");
					field.focus();
					if (field.select) field.select();
				}
			});

			function finish() {
				var target = pending;
				pending = null;
				waitingForError = null;
				if (target) dlg.close('confirmed');
			}

			dlg.addEventListener('close', function () {
				if (dlg.returnValue === 'confirmed') return;
				var target = pending;
				pending = null;
				waitingForError = null;
				if (target && target.form.hasAttribute('data-confirm-reset')) target.form.reset();
			});
		})();
	</script>
}
