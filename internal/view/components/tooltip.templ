package components

// TooltipSide picks which edge of the trigger the tooltip pops out from.
type TooltipSide string

const (
	TooltipTop    TooltipSide = "top"
	TooltipBottom TooltipSide = "bottom"
	TooltipLeft   TooltipSide = "left"
	TooltipRight  TooltipSide = "right"
)

func tooltipSideClass(s TooltipSide) string {
	switch s {
	case TooltipBottom:
		return "left-1/2 top-full mt-1.5 -translate-x-1/2"
	case TooltipLeft:
		return "right-full top-1/2 mr-1.5 -translate-y-1/2"
	case TooltipRight:
		return "left-full top-1/2 ml-1.5 -translate-y-1/2"
	default: // TooltipTop
		return "left-1/2 bottom-full mb-1.5 -translate-x-1/2"
	}
}

// Tooltip wraps any element and shows a small label on hover / focus.
// The wrapped child is the trigger; the tooltip text is shown via a portal-less
// absolutely-positioned span.
//
// Example:
//
//	@components.Tooltip("Copy SHA", components.TooltipTop) {
//	  @components.Button(components.ButtonGhost, components.ButtonSizeIcon, nil) { … }
//	}
//
// Accessibility: the text is rendered with role="tooltip" and the trigger gets
// aria-describedby wired up via a generated id, so screen readers announce it.
templ Tooltip(text string, side TooltipSide) {
	<span
		x-data="{ open: false }"
		x-on:mouseenter="open = true"
		x-on:mouseleave="open = false"
		x-on:focusin="open = true"
		x-on:focusout="open = false"
		class="relative inline-flex"
	>
		{ children... }
		<span
			x-show="open"
			x-cloak
			x-transition.opacity.duration.100ms
			role="tooltip"
			class={ "pointer-events-none absolute z-50 whitespace-nowrap rounded-md bg-foreground px-2 py-1 text-[11px] font-medium text-background shadow-md", tooltipSideClass(side) }
		>
			{ text }
		</span>
	</span>
}
