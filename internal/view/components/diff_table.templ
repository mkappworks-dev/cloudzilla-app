package components

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/service"
)

// DiffFileHeader renders the header bar of a diff block showing file path and +/- stats.
templ DiffFileHeader(f service.FileDiff) {
	<div class="bg-muted/40 border-b border-border px-4 py-2 flex items-center justify-between">
		<code class="text-sm font-mono text-foreground">
			if f.IsNew {
				{ f.NewPath }
			} else if f.IsDelete {
				{ f.OldPath }
			} else if f.OldPath != f.NewPath {
				{ f.OldPath } &rarr; { f.NewPath }
			} else {
				{ f.NewPath }
			}
		</code>
		if !f.IsBinary {
			<div class="text-xs text-muted-foreground ml-4 shrink-0">
				<span class="text-success">+{ strconv.Itoa(f.Added) }</span>
				<span class="text-destructive ml-1">-{ strconv.Itoa(f.Deleted) }</span>
			</div>
		}
	</div>
}

// DiffHunkTable renders a read-only unified diff table for a set of hunks.
// For PR diff tables with inline comments, use the pull_detail template directly.
templ DiffHunkTable(hunks []service.DiffHunk) {
	<div class="overflow-x-auto">
		<table class="w-full text-xs font-mono border-collapse">
			<tbody>
				for _, hunk := range hunks {
					<tr>
						<td colspan="4" class="bg-primary/10 text-foreground px-4 py-1 select-none">{ hunk.Header }</td>
					</tr>
					for _, line := range hunk.Lines {
						<tr class={ templ.KV("bg-success/10", line.Type == "add"), templ.KV("bg-destructive/10", line.Type == "del") }>
							<td class="select-none text-muted-foreground text-right pr-2 pl-4 py-0.5 w-10 align-top border-r border-border">
								if line.OldNum != 0 {
									{ strconv.Itoa(line.OldNum) }
								}
							</td>
							<td class="select-none text-muted-foreground text-right pr-2 pl-2 py-0.5 w-10 align-top border-r border-border">
								if line.NewNum != 0 {
									{ strconv.Itoa(line.NewNum) }
								}
							</td>
							<td class={ "select-none px-2 py-0.5 w-4 align-top", templ.KV("text-success", line.Type == "add"), templ.KV("text-destructive", line.Type == "del"), templ.KV("text-muted-foreground", line.Type != "add" && line.Type != "del") }>
								if line.Type == "add" {
									+
								} else if line.Type == "del" {
									-
								} else {
									{ " " }
								}
							</td>
							<td class="pl-2 pr-4 py-0.5 whitespace-pre align-top">{ line.Content }</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
}
