package components

// Caller supplies the accessible name: a <label for=> matching attrs["id"], or an aria-label in attrs.
templ Input(attrs templ.Attributes) {
	<input
		{ withClass(attrs, "flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground disabled:cursor-not-allowed disabled:opacity-50")... }
	/>
}

// Caller supplies the <label>, as with Input, and omits "type": the component owns it.
// Any submit re-masks the field, so browsers don't save the password to a text input's autofill history.
templ PasswordInput(attrs templ.Attributes) {
	<div
		x-data="{ shown: false }"
		x-on:submit.window="shown = false"
		class="relative"
	>
		<input
			type="password"
			x-bind:type="shown ? 'text' : 'password'"
			{ withClass(attrs, "flex h-9 w-full rounded-md border border-input bg-transparent pl-3 pr-9 py-1 text-sm shadow-xs transition-colors placeholder:text-muted-foreground disabled:cursor-not-allowed disabled:opacity-50")... }
		/>
		<button
			type="button"
			x-on:click="shown = !shown"
			aria-label="Show password"
			aria-pressed="false"
			x-bind:aria-pressed="shown"
			if id, ok := attrs["id"].(string); ok {
				aria-controls={ id }
			}
			class="absolute inset-y-0 right-0 grid w-9 place-items-center rounded-r-md text-muted-foreground hover:text-foreground focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-ring"
		>
			<svg x-show="!shown" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg>
			<svg x-show="shown" x-cloak width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"></path><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path><path d="m2 2 20 20"></path></svg>
		</button>
	</div>
}

// Always pair with a <label> (class="sr-only" to hide it visually).
templ SearchInput(attrs templ.Attributes, kbdHint string) {
	<div class="relative">
		<svg class="absolute left-2.5 top-1/2 -translate-y-1/2 text-muted-foreground" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
		<input
			type="search"
			{ withClass(attrs, "flex h-9 w-full rounded-md border border-input bg-transparent pl-8 py-1 text-sm shadow-xs transition-colors placeholder:text-muted-foreground disabled:cursor-not-allowed disabled:opacity-50", templ.KV("pr-12", kbdHint != ""), templ.KV("pr-3", kbdHint == ""))... }
		/>
		if kbdHint != "" {
			<kbd class="absolute right-2 top-1/2 -translate-y-1/2 text-[10px] px-1.5 py-0.5 bg-muted border border-border rounded-sm text-muted-foreground font-mono" aria-hidden="true">{ kbdHint }</kbd>
		}
	</div>
}

// Caller provides the <label>, as with Input.
templ Textarea(attrs templ.Attributes) {
	<textarea
		{ withClass(attrs, "flex min-h-[80px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-xs placeholder:text-muted-foreground disabled:cursor-not-allowed disabled:opacity-50")... }
	></textarea>
}
