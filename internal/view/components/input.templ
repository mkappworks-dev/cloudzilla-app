package components

// Caller supplies the accessible name: a <label for=> matching attrs["id"], or an aria-label in attrs.
templ Input(attrs templ.Attributes) {
	<input
		{ withClass(attrs, "flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground disabled:cursor-not-allowed disabled:opacity-50")... }
	/>
}

// Always pair with a <label> (class="sr-only" to hide it visually).
templ SearchInput(attrs templ.Attributes, kbdHint string) {
	<div class="relative">
		<svg class="absolute left-2.5 top-1/2 -translate-y-1/2 text-muted-foreground" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
		<input
			type="search"
			{ withClass(attrs, "flex h-9 w-full rounded-md border border-input bg-transparent pl-8 py-1 text-sm shadow-sm transition-colors placeholder:text-muted-foreground disabled:cursor-not-allowed disabled:opacity-50", templ.KV("pr-12", kbdHint != ""), templ.KV("pr-3", kbdHint == ""))... }
		/>
		if kbdHint != "" {
			<kbd class="absolute right-2 top-1/2 -translate-y-1/2 text-[10px] px-1.5 py-0.5 bg-muted border border-border rounded text-muted-foreground font-mono" aria-hidden="true">{ kbdHint }</kbd>
		}
	</div>
}

// Caller provides the <label>, as with Input.
templ Textarea(attrs templ.Attributes) {
	<textarea
		{ withClass(attrs, "flex min-h-[80px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm placeholder:text-muted-foreground disabled:cursor-not-allowed disabled:opacity-50")... }
	></textarea>
}
