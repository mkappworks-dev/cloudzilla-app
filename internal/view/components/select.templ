package components

// Always pair with a <label for="..."> (visible or class="sr-only").
templ Select(attrs templ.Attributes) {
	<div class="relative">
		<select
			{ withClass(attrs, "appearance-none flex h-9 w-full rounded-md border border-input bg-transparent pl-3 pr-8 py-1 text-sm shadow-sm disabled:cursor-not-allowed disabled:opacity-50")... }
		>
			{ children... }
		</select>
		<svg
			class="absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none text-muted-foreground"
			width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
			aria-hidden="true" focusable="false"
		>
			<path d="M7 10l5 5 5-5"></path>
		</svg>
	</div>
}
