package components

type DropdownMenuAlign string

const (
	DropdownAlignStart DropdownMenuAlign = "start"
	DropdownAlignEnd   DropdownMenuAlign = "end"
)

// Trigger, Content, Item and Link read or write the Alpine `open` scope
// declared here, so they only work nested inside it.
templ DropdownMenu() {
	<div x-data="{ open: false }" class="relative inline-block">
		{ children... }
	</div>
}

// Has no base classes, unlike its siblings: callers style it entirely via attrs.
templ DropdownMenuTrigger(attrs templ.Attributes) {
	<button
		type="button"
		x-on:click="open = !open"
		x-on:click.outside="open = false"
		x-on:keydown.escape.window="open = false"
		:aria-expanded="open ? 'true' : 'false'"
		aria-haspopup="menu"
		{ attrs... }
	>
		{ children... }
	</button>
}

templ DropdownMenuContent(align DropdownMenuAlign) {
	if align == DropdownAlignEnd {
		<div
			x-show="open"
			x-cloak
			x-transition.opacity.duration.100ms
			role="menu"
			class="absolute right-0 top-full mt-1.5 z-50 min-w-[12rem] rounded-md border border-border bg-popover text-popover-foreground shadow-md p-1 text-sm"
		>
			{ children... }
		</div>
	} else {
		<div
			x-show="open"
			x-cloak
			x-transition.opacity.duration.100ms
			role="menu"
			class="absolute left-0 top-full mt-1.5 z-50 min-w-[12rem] rounded-md border border-border bg-popover text-popover-foreground shadow-md p-1 text-sm"
		>
			{ children... }
		</div>
	}
}

templ DropdownMenuItem(attrs templ.Attributes) {
	<button
		type="button"
		role="menuitem"
		x-on:click="open = false"
		{ withClass(attrs, "flex w-full items-center gap-2 px-2 py-1.5 rounded-sm text-left hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground focus:outline-none disabled:opacity-50 disabled:pointer-events-none")... }
	>
		{ children... }
	</button>
}

templ DropdownMenuLink(href string, attrs templ.Attributes) {
	<a
		href={ templ.SafeURL(href) }
		role="menuitem"
		x-on:click="open = false"
		{ withClass(attrs, "flex items-center gap-2 px-2 py-1.5 rounded-sm hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground focus:outline-none")... }
	>
		{ children... }
	</a>
}

templ DropdownMenuLabel() {
	<div class="px-2 py-1.5 text-[11px] uppercase tracking-wider text-muted-foreground">
		{ children... }
	</div>
}

templ DropdownMenuSeparator() {
	<div role="separator" class="my-1 h-px bg-border"></div>
}

templ DropdownMenuShortcut() {
	<span class="ml-auto text-[11px] tracking-wider text-muted-foreground">{ children... }</span>
}
