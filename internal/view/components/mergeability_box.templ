package components

import (
	"encoding/json"
	"fmt"
	"strconv"
	"strings"

	"github.com/mkappworks-dev/cloudzilla-app/internal/service"
)

// BlockingReview is a standing request for changes that holds the merge back.
type BlockingReview struct {
	ID       int64
	Reviewer string
}

type MergeabilityBoxData struct {
	PatchURL string
	BaseBranch string
	CanWrite bool
	// Unavailable renders an explicit message instead of zero values when mergeability couldn't be computed.
	Unavailable bool
	// UpToDate distinguishes head == base from "conflict-free with a non-empty diff" (Mergeable).
	UpToDate         bool
	Mergeable        bool
	Ahead            int
	Behind           int
	HasConflicts     bool
	RequiredChecks   int
	PassingChecks    int
	RequiredReviews  int
	ApprovedReviews  int
	CanFastForward   bool
	CanThreeWayMerge bool
	CanSquash        bool

	// The merge dialog prefills the commit title with the default message for the chosen strategy.
	HeadBranch string

	// Draft swaps the merge actions for Ready for review.
	Draft bool

	// FailingChecks counts required checks that failed or errored with no passing status.
	FailingChecks    int
	ChangesRequested bool
	ChecksURL        string

	// Blockers names who requested changes; CanManage lets the viewer dismiss them (repo admins and owners).
	Blockers  []BlockingReview
	CanManage bool
	// CanUpdateBranch offers merging base into head: the viewer can write and base has commits head lacks.
	CanUpdateBranch bool
	// UpdateFromFork says the head is behind base but lives in another repository, which only its owner can update.
	UpdateFromFork bool

	AutoMergeEnabled  bool
	AutoMergeStrategy string
	// AutoMergeByName is empty when the arming user is unknown or deleted.
	AutoMergeByName string
}

type mergeState int

const (
	mergeUnavailable mergeState = iota
	mergeConflicts
	mergeUpToDate
	mergeReady
	mergeChecking
	mergeChangesRequested
	mergeChecksFailing
	mergeNeedsReview
	mergeChecksPending
	mergeDraft
	mergeWaitingMaintainer
)

func mergeStateOf(d MergeabilityBoxData) mergeState {
	switch {
	case d.Unavailable:
		return mergeUnavailable
	case d.Draft:
		return mergeDraft
	case d.HasConflicts:
		return mergeConflicts
	case d.UpToDate:
		return mergeUpToDate
	case d.ChangesRequested:
		return mergeChangesRequested
	case d.FailingChecks > 0:
		return mergeChecksFailing
	case d.RequiredReviews > d.ApprovedReviews:
		return mergeNeedsReview
	case d.RequiredChecks > d.PassingChecks:
		return mergeChecksPending
	case d.Mergeable && !d.CanWrite:
		return mergeWaitingMaintainer
	case d.Mergeable:
		return mergeReady
	default:
		return mergeChecking
	}
}

templ MergeabilityBox(d MergeabilityBoxData) {
	{{ st := mergeStateOf(d) }}
	<section aria-label="Mergeability" class="border border-border rounded-md">
		<header class={ "px-5 py-4 border-b border-border rounded-t-md flex items-center gap-3", mergeHeaderClass(st) }>
			<span class={ "h-8 w-8 rounded-full grid place-items-center shrink-0", mergeIconClass(st) }>
				@mergeStateIcon(st)
			</span>
			<div class="min-w-0">
				<h3 class={ "text-[14px] font-semibold", mergeTitleClass(st) }>{ mergeTitle(st) }</h3>
				<p class="text-[12px] text-muted-foreground mt-0.5">{ mergeSubtitle(d, st) }</p>
			</div>
		</header>
		if !d.Unavailable {
			<ul class="divide-y divide-border text-[13px]">
				<li class="px-5 py-3 flex items-center gap-3">
					@mergeRowIcon(true)
					<span class="flex-1">{ aheadBehindDescription(d.Ahead, d.Behind) }</span>
				</li>
				if d.RequiredChecks > 0 {
					<li class="px-5 py-3 flex items-center gap-3">
						@mergeRowIcon(d.PassingChecks >= d.RequiredChecks)
						<span class="flex-1">{ checksDescription(d.PassingChecks, d.RequiredChecks) }</span>
					</li>
				}
				if d.RequiredReviews > 0 {
					<li class="px-5 py-3 flex items-center gap-3">
						@mergeRowIcon(d.ApprovedReviews >= d.RequiredReviews)
						<span class="flex-1">{ reviewsDescription(d.ApprovedReviews, d.RequiredReviews) }</span>
					</li>
				}
				if d.ChangesRequested && len(d.Blockers) == 0 {
					<li class="px-5 py-3 flex items-center gap-3">
						@mergeRowIcon(false)
						<span class="flex-1">A reviewer requested changes</span>
					</li>
				}
				for _, b := range d.Blockers {
					<li class="px-5 py-3 flex items-center gap-3">
						@mergeRowIcon(false)
						<span class="flex-1">Changes requested by <a href={ templ.SafeURL("/" + b.Reviewer) } class="font-medium hover:underline">{ b.Reviewer }</a></span>
						if d.CanManage {
							<button type="button" onclick="document.getElementById(this.dataset.dialog).showModal()" data-dialog={ dismissDialogID(b) } class="h-7 px-2.5 text-[12px] rounded-md border border-border hover:bg-accent">Dismiss review</button>
						}
					</li>
				}
				<li class="px-5 py-3 flex items-center gap-3">
					@mergeRowIcon(!d.HasConflicts)
					if d.HasConflicts {
						<span class="flex-1">This branch has conflicts with <span class="font-mono">{ mergeBase(d) }</span></span>
					} else {
						<span class="flex-1">This branch has no conflicts with <span class="font-mono">{ mergeBase(d) }</span></span>
					}
				</li>
			</ul>
		}
		if st == mergeConflicts {
			@conflictGuidance(d)
		}
		if d.CanWrite {
			<footer class="px-5 py-4 border-t border-border flex flex-wrap items-center gap-2">
				switch {
					case d.Draft:
						<button
							type="button"
							hx-patch={ d.PatchURL }
							hx-vals={ `{"is_draft":"false"}` }
							hx-swap="none"
							hx-on::after:request="if(event.target===this&&ctx.response&&ctx.response.status<400){sessionStorage.setItem('cz-toast',JSON.stringify({type:'success',message:'Marked ready for review'}));location.reload();}"
							class="h-9 px-4 text-[13px] font-medium rounded-md bg-success-fill text-success-fill-foreground hover:bg-success-fill/90"
						>
							Ready for review
						</button>
					case d.AutoMergeEnabled:
						<p class="text-[13px] text-muted-foreground inline-flex items-center gap-2">
							<svg class="text-success shrink-0" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
							{ autoMergeSummary(d) }
						</p>
						<button
							type="button"
							hx-patch={ d.PatchURL }
							hx-vals={ `{"auto_merge":"disable"}` }
							hx-swap="none"
							hx-on::after:request="if(event.target===this&&ctx.response&&ctx.response.status<400){sessionStorage.setItem('cz-toast',JSON.stringify({type:'success',message:'Auto-merge disabled'}));location.reload();}"
							class="h-9 px-3 text-[13px] rounded-md border border-border text-muted-foreground hover:bg-accent"
						>
							Disable auto-merge
						</button>
					case st == mergeReady:
						@mergeSplitButton(d, false)
					case st == mergeNeedsReview || st == mergeChecksPending:
						if !d.HasConflicts {
							@mergeSplitButton(d, true)
						}
					case st == mergeChecksFailing:
						<button type="button" disabled class="h-9 px-4 text-[13px] font-medium rounded-md bg-muted text-muted-foreground cursor-not-allowed">Merge</button>
						if d.ChecksURL != "" {
							<a href={ templ.SafeURL(d.ChecksURL) } class="text-[13px] text-foreground underline underline-offset-2 decoration-muted-foreground/50 hover:decoration-foreground">View checks →</a>
						}
				}
				if d.UpdateFromFork {
					<span class="text-[12px] text-muted-foreground">The head branch is behind and lives in another repository: update it there.</span>
				}
				if d.CanUpdateBranch {
					<button
						type="button"
						hx-post={ d.PatchURL + "/update-branch" }
						hx-swap="none"
						hx-on::after:request="if(event.target===this&&ctx.response&&ctx.response.status<400){sessionStorage.setItem('cz-toast',JSON.stringify({type:'success',message:'Branch updated'}));location.reload();}"
						class="h-9 px-3 text-[13px] rounded-md border border-border hover:bg-accent"
					>
						Update branch
					</button>
				}
				<button type="button" onclick="document.getElementById('close-pull-dialog').showModal()" class="ml-auto h-9 px-3 text-[13px] rounded-md border border-destructive/40 text-destructive bg-transparent hover:bg-destructive/10 hover:border-destructive">Close pull request</button>
			</footer>
		} else {
			<footer class="px-5 py-4 border-t border-border">
				<p class="text-[12px] text-muted-foreground inline-flex items-center gap-1.5">
					<svg class="shrink-0" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0110 0v4"></path></svg>
					Only collaborators with write access can merge or close this pull request.
				</p>
			</footer>
		}
		for _, b := range d.Blockers {
			if d.CanManage {
				@dismissReviewDialog(d, b)
			}
		}
	</section>
}

// The command line is the only way to resolve conflicts: there is no in-browser conflict editor.
templ conflictGuidance(d MergeabilityBoxData) {
	<div class="px-5 py-4 border-t border-border flex flex-col gap-2.5">
		<h4 class="text-[13px] font-medium">Resolve the conflicts on your machine</h4>
		<p class="text-[12px] text-muted-foreground">
			Merge <span class="font-mono text-foreground">{ mergeBase(d) }</span> into <span class="font-mono text-foreground">{ d.HeadBranch }</span> locally, fix the conflicted files and push. If this page doesn't update, check again.
		</p>
		<pre class="rounded-md border border-border bg-muted/40 px-3 py-2.5 text-[12px] font-mono leading-relaxed overflow-x-auto"><code>{ conflictCommands(d) }</code></pre>
		<div>
			<button type="button" onclick="location.reload()" class="h-8 px-3 text-[13px] rounded-md border border-border hover:bg-accent">Check again</button>
		</div>
	</div>
}

func conflictCommands(d MergeabilityBoxData) string {
	return strings.Join([]string{
		"git fetch origin",
		"git switch " + d.HeadBranch,
		"git merge origin/" + d.BaseBranch,
		"# fix the conflicted files, then",
		"git add <files>",
		"git commit",
		"git push origin " + d.HeadBranch,
	}, "\n")
}

func dismissDialogID(b BlockingReview) string {
	return "dismiss-review-" + strconv.FormatInt(b.ID, 10)
}

templ dismissReviewDialog(d MergeabilityBoxData, b BlockingReview) {
	{{ id := dismissDialogID(b) }}
	@Dialog(id) {
		@DialogHeader() {
			@DialogTitle(id) {
				Dismiss review
			}
			@DialogDescription() {
				Clears the request for changes from <strong class="text-foreground">{ b.Reviewer }</strong> so it no longer blocks the merge. Your name and reason show on the review and in the audit log.
			}
		}
		<form
			id={ id + "-form" }
			hx-post={ d.PatchURL + "/reviews/" + strconv.FormatInt(b.ID, 10) + "/dismiss" }
			hx-swap="none"
			hx-on::after:request="if(event.target===this&&ctx.response&&ctx.response.status<400){sessionStorage.setItem('cz-toast',JSON.stringify({type:'success',message:'Review dismissed'}));location.reload();}"
		>
			@DialogBody() {
				<label for={ id + "-reason" } class="text-[12px] font-medium">Reason</label>
				<textarea
					id={ id + "-reason" }
					name="reason"
					rows="3"
					required
					maxlength="500"
					placeholder="Why is this review no longer needed?"
					class="mt-1.5 w-full rounded-md border border-input bg-transparent px-3 py-2 text-[13px] resize-none focus:outline-hidden focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-ring placeholder:text-muted-foreground"
				></textarea>
			}
		</form>
		@DialogFooter() {
			@DialogClose() {
				Cancel
			}
			@Button(ButtonDefault, ButtonSizeDefault, templ.Attributes{"type": "submit", "form": id + "-form"}) {
				Dismiss review
			}
		}
	}
}

// The selected strategy lives in Alpine scope and is fed to the action via :hx-vals.
templ mergeSplitButton(d MergeabilityBoxData, auto bool) {
	{{ defKey, defLabel := defaultMergeStrategy(d) }}
	if mergeStrategyCount(d) == 1 {
		<div x-data={ mergeScope(d, defKey, defLabel) } class="inline-flex">
			@mergePrimaryButton(d, auto, defKey, defLabel, "rounded-md")
			if !auto {
				@mergeConfirmDialog(d)
			}
		</div>
	} else if mergeStrategyCount(d) > 1 {
		<div x-data={ mergeScope(d, defKey, defLabel) } class="relative inline-flex">
			<div class="inline-flex rounded-md overflow-hidden">
				@mergePrimaryButton(d, auto, defKey, defLabel, "")
				<button
					type="button"
					x-on:click="open = !open"
					x-on:click.outside="open = false"
					x-on:keydown.escape.window="open = false"
					:aria-expanded="open ? 'true' : 'false'"
					aria-haspopup="menu"
					aria-label="Choose merge strategy"
					class="h-9 px-2.5 grid place-items-center bg-success-fill text-success-fill-foreground hover:opacity-90 border-l border-success-fill-foreground/25"
				>
					<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M7 10l5 5 5-5"></path></svg>
				</button>
			</div>
			<div
				x-show="open"
				x-cloak
				x-transition.opacity.duration.100ms
				role="menu"
				aria-label="Merge strategy"
				class="absolute left-0 top-full mt-1.5 z-50 min-w-[18rem] rounded-md border border-border bg-popover text-popover-foreground shadow-md p-1 text-sm"
			>
				<div class="px-2 py-1.5 text-[11px] uppercase tracking-wider text-muted-foreground">Merge strategy</div>
				if d.CanSquash {
					@mergeStrategyMenuItem("squash", "Squash and merge", "Collapse the commits into one new commit")
				}
				if d.CanThreeWayMerge {
					@mergeStrategyMenuItem("merge", "Create merge commit", "Keep every commit under a two-parent merge commit")
				}
				if d.CanFastForward {
					@mergeStrategyMenuItem("ff", "Fast-forward", "Advance the base branch — no new commit")
				}
			</div>
			if !auto {
				@mergeConfirmDialog(d)
			}
		</div>
	}
}

// Merging opens the confirm dialog; enabling auto-merge patches at once, since that merge's message isn't known yet.
templ mergePrimaryButton(d MergeabilityBoxData, auto bool, defKey, defLabel, rounded string) {
	<button
		type="button"
		if auto {
			hx-patch={ d.PatchURL }
			hx-vals={ autoMergeVals(defKey) }
			:hx-vals={ autoMergeValsExpr }
			hx-swap="none"
			hx-on::after:request={ templ.JSUnsafeFuncCall(mergeAfter(auto)) }
		} else {
			x-on:click="begin()"
		}
		class={ "h-9 px-4 text-[13px] font-medium bg-success-fill text-success-fill-foreground hover:opacity-90 inline-flex items-center gap-1.5", rounded }
	>
		@mergeStrategyIcon(defKey)
		if auto {
			<span>Enable auto-merge · </span>
		}
		<span x-text="label">{ defLabel }</span>
	</button>
}

templ mergeConfirmDialog(d MergeabilityBoxData) {
	@Dialog("merge-confirm-dialog") {
		@DialogHeader() {
			@DialogTitle("merge-confirm-dialog") {
				Confirm merge
			}
			@DialogDescription() {
				<span x-text="strategyNote()"></span>
			}
		}
		@DialogBody() {
			<div x-show="strategy !== 'ff'" class="grid gap-3">
				<div class="grid gap-1.5">
					<label for="merge-title" class="text-[12px] font-medium">Commit title</label>
					<input id="merge-title" type="text" x-model="title" maxlength="200" class="h-9 w-full rounded-md border border-input bg-transparent px-3 text-[13px] focus:outline-hidden focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-ring"/>
				</div>
				<div class="grid gap-1.5">
					<label for="merge-message" class="text-[12px] font-medium">Commit message <span class="font-normal text-muted-foreground">(optional)</span></label>
					<textarea id="merge-message" x-model="message" rows="4" class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-[13px] font-mono leading-relaxed resize-none focus:outline-hidden focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-ring"></textarea>
				</div>
			</div>
			<p x-show="strategy === 'ff'" class="text-[13px] text-muted-foreground">
				Fast-forward moves <span class="font-mono text-foreground">{ mergeBase(d) }</span> to the head commit. It creates no new commit, so there is no message to edit.
			</p>
		}
		@DialogFooter() {
			@DialogClose() {
				Cancel
			}
			<button
				type="button"
				hx-patch={ d.PatchURL }
				hx-vals={ `{"state":"merged"}` }
				:hx-vals="JSON.stringify({ state: 'merged', merge_strategy: strategy, merge_title: title, merge_message: message })"
				hx-swap="none"
				hx-on::after:request={ templ.JSUnsafeFuncCall(mergeAfter(false)) }
				class="inline-flex items-center justify-center gap-1.5 rounded-md text-sm font-medium h-9 px-4 bg-success-fill text-success-fill-foreground hover:bg-success-fill/90"
			>
				Confirm merge
			</button>
		}
	}
}

// Clicking both records the chosen strategy and updates the primary button.
templ mergeStrategyMenuItem(key, label, desc string) {
	<button
		type="button"
		role="menuitemradio"
		x-bind:aria-checked={ "strategy === '" + key + "' ? 'true' : 'false'" }
		x-on:click={ "strategy = '" + key + "'; label = '" + label + "'; open = false" }
		class="flex w-full items-start gap-2 px-2 py-1.5 rounded-xs text-left hover:bg-accent hover:text-accent-foreground focus:bg-accent focus:text-accent-foreground focus:outline-hidden"
	>
		<span class="mt-px shrink-0 text-muted-foreground">
			@mergeStrategyIcon(key)
		</span>
		<span class="flex-1 min-w-0">
			<span class="block">{ label }</span>
			<span class="block text-[11px] text-muted-foreground">{ desc }</span>
		</span>
		<svg x-show={ "strategy === '" + key + "'" } x-cloak class="mt-px shrink-0" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
	</button>
}

templ mergeStrategyIcon(key string) {
	switch key {
		case "squash":
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="6" cy="6" r="2"></circle><circle cx="6" cy="18" r="2"></circle><circle cx="18" cy="18" r="2"></circle><path d="M6 8v8M6 18h6a6 6 0 006-6V8"></path></svg>
		case "merge":
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="18" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><path d="M6 9v3a9 9 0 009 9"></path></svg>
		default:
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><line x1="3" y1="12" x2="16" y2="12"></line><polyline points="12 6 18 12 12 18"></polyline></svg>
	}
}

// Preference order: squash → merge → fast-forward.
func defaultMergeStrategy(d MergeabilityBoxData) (key, label string) {
	switch {
	case d.CanSquash:
		return "squash", "Squash and merge"
	case d.CanThreeWayMerge:
		return "merge", "Create merge commit"
	case d.CanFastForward:
		return "ff", "Fast-forward"
	default:
		return "", ""
	}
}

func mergeStrategyCount(d MergeabilityBoxData) int {
	n := 0
	if d.CanSquash {
		n++
	}
	if d.CanThreeWayMerge {
		n++
	}
	if d.CanFastForward {
		n++
	}
	return n
}

templ mergeStateIcon(st mergeState) {
	switch st {
	case mergeDraft:
		<svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M1.5 3.25a2.25 2.25 0 113 2.122v5.256a2.251 2.251 0 11-1.5 0V5.372A2.25 2.25 0 011.5 3.25zM3.75 2.5a.75.75 0 100 1.5.75.75 0 000-1.5zm0 9.5a.75.75 0 100 1.5.75.75 0 000-1.5zm6.5-9.25a2.25 2.25 0 113 2.122V10.5a2.25 2.25 0 11-1.5 0V4.622a2.25 2.25 0 01-1.5-2.122zm2.25-.75a.75.75 0 100 1.5.75.75 0 000-1.5zm0 9.5a.75.75 0 100 1.5.75.75 0 000-1.5z"></path></svg>
	case mergeWaitingMaintainer:
		<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
	case mergeReady:
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
	case mergeConflicts:
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
	default:
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v4M12 16h.01"></path></svg>
	}
}

templ mergeRowIcon(ok bool) {
	if ok {
		<svg class="text-success shrink-0" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
	} else {
		<svg class="text-warning shrink-0" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v4M12 16h.01"></path></svg>
	}
}

func mergeBase(d MergeabilityBoxData) string {
	if d.BaseBranch == "" {
		return "the base branch"
	}
	return d.BaseBranch
}

func mergeHeaderClass(st mergeState) string {
	switch st {
	case mergeReady:
		return "bg-success/10"
	case mergeConflicts, mergeChangesRequested, mergeChecksFailing:
		return "bg-destructive/10"
	case mergeChecking, mergeNeedsReview, mergeChecksPending:
		return "bg-warning/10"
	default:
		return "bg-muted/40"
	}
}

func mergeIconClass(st mergeState) string {
	switch st {
	case mergeReady:
		return "bg-success-fill text-success-fill-foreground"
	case mergeConflicts, mergeChangesRequested, mergeChecksFailing:
		return "bg-destructive-fill text-destructive-fill-foreground"
	case mergeChecking, mergeNeedsReview, mergeChecksPending:
		return "bg-warning text-warning-foreground"
	default:
		return "bg-muted text-muted-foreground"
	}
}

func mergeTitleClass(st mergeState) string {
	switch st {
	case mergeReady:
		return "text-success"
	case mergeConflicts, mergeChangesRequested, mergeChecksFailing:
		return "text-destructive"
	case mergeChecking, mergeNeedsReview, mergeChecksPending:
		return "text-warning"
	default:
		return "text-muted-foreground"
	}
}

func mergeTitle(st mergeState) string {
	switch st {
	case mergeReady:
		return "Ready to merge"
	case mergeConflicts:
		return "Merge conflicts"
	case mergeUpToDate:
		return "Nothing to merge"
	case mergeDraft:
		return "Draft"
	case mergeWaitingMaintainer:
		return "Ready, waiting for a maintainer"
	case mergeChangesRequested:
		return "Changes requested"
	case mergeChecksFailing:
		return "Checks failing"
	case mergeNeedsReview:
		return "Review required"
	case mergeChecksPending:
		return "Waiting on checks"
	case mergeChecking:
		return "Checking mergeability…"
	default:
		return "Merge status unavailable"
	}
}

func mergeSubtitle(d MergeabilityBoxData, st mergeState) string {
	switch st {
	case mergeReady:
		return "This branch has no conflicts with the base and can be merged."
	case mergeConflicts:
		return "Resolve the conflicts on the head branch before this can merge."
	case mergeUpToDate:
		return "This branch is already up to date with the base."
	case mergeWaitingMaintainer:
		return "Nothing blocks this pull request. Someone with write access can merge it."
	case mergeDraft:
		return "Mark this ready for review to notify reviewers and allow merging."
	case mergeChangesRequested:
		return "A reviewer asked for changes. Merging is blocked until they approve or the review is dismissed."
	case mergeChecksFailing:
		return fmt.Sprintf("%s failed. Fix them and push before this can merge.", Count(d.FailingChecks, "required check", "required checks"))
	case mergeNeedsReview:
		return reviewsDescription(d.ApprovedReviews, d.RequiredReviews) + "."
	case mergeChecksPending:
		return checksDescription(d.PassingChecks, d.RequiredChecks) + "."
	case mergeChecking:
		return "Mergeability is still being computed — refresh in a moment."
	default:
		return "Refresh the page to try computing merge status again."
	}
}

func aheadBehindDescription(ahead, behind int) string {
	return fmt.Sprintf("%s ahead, %s behind the base branch", Count(ahead, "commit", "commits"), strconv.Itoa(behind))
}

func checksDescription(passing, required int) string {
	if passing >= required {
		return fmt.Sprintf("All %s passed", Count(required, "required check", "required checks"))
	}
	return fmt.Sprintf("%d of %s passed", passing, Count(required, "required check", "required checks"))
}

func reviewsDescription(approved, required int) string {
	if approved >= required {
		return fmt.Sprintf("All %s approved", Count(required, "required review", "required reviews"))
	}
	return fmt.Sprintf("%d of %s approved", approved, Count(required, "required review", "required reviews"))
}


func autoMergeVals(strategy string) string {
	return fmt.Sprintf(`{"auto_merge":"enable","auto_merge_strategy":%q}`, strategy)
}

const autoMergeValsExpr = "JSON.stringify({ auto_merge: 'enable', auto_merge_strategy: strategy })"

func autoMergeSummary(d MergeabilityBoxData) string {
	s := "Auto-merge is on (" + strategyName(d.AutoMergeStrategy) + ")"
	if d.AutoMergeByName != "" {
		s += ", armed by @" + d.AutoMergeByName
	}
	return s + ". It merges once the requirements are met."
}

func strategyName(key string) string {
	switch key {
	case "squash":
		return "squash and merge"
	case "merge":
		return "merge commit"
	default:
		return "fast-forward"
	}
}

// The page reloads after the request so the merge box, badge and timeline are rendered fresh.
func mergeAfter(auto bool) string {
	msg := "Pull request merged"
	if auto {
		msg = "Auto-merge enabled"
	}
	return "if(event.target===this&&ctx.response&&ctx.response.status<400){sessionStorage.setItem('cz-toast',JSON.stringify({type:'success',message:'" + msg + "'}));location.reload();}"
}

// mergeScope is the Alpine state the merge button, strategy menu and confirm dialog share.
func mergeScope(d MergeabilityBoxData, defKey, defLabel string) string {
	scope, _ := json.Marshal(map[string]any{
		"strategy": defKey,
		"label":    defLabel,
		"base":     mergeBase(d),
		"defaults": map[string]string{
			"merge":  service.DefaultMergeMessage(d.HeadBranch, d.BaseBranch),
			"squash": service.DefaultSquashMessage(d.HeadBranch, d.BaseBranch),
		},
	})
	// json.Marshal output is a JS object literal; its closing brace takes the methods.
	return string(scope[:len(scope)-1]) + `, open: false, title: '', message: '', ` +
		`begin() { this.title = this.defaults[this.strategy] || ''; this.message = ''; document.getElementById('merge-confirm-dialog').showModal(); }, ` +
		`strategyNote() { return this.strategy === 'ff' ? 'Fast-forward the base branch.' : (this.label + ' into ' + this.base + '.'); } }`
}
