package components

import "strconv"

type IssueListRowData struct {
	Href     string
	Repo     string // "owner/name"; set where the list spans repos
	Number   int
	Title    string
	Author   string
	State    string // "open" or "closed"
	Private  bool
	Time     string // pre-formatted relative
	Labels   []LabelChip
	Priority string
	Comments int
	Query    string // highlights matching words in the title
	LiAttrs  templ.Attributes
}

templ IssueListRow(d IssueListRowData) {
	<li { d.LiAttrs... }>
		<a href={ templ.SafeURL(d.Href) } class="group relative block px-4 py-3 transition-[padding] hover:bg-accent hover:pl-[18px] before:content-[''] before:absolute before:left-0 before:top-2 before:bottom-2 before:w-0.5 before:rounded-full before:bg-foreground before:opacity-0 before:transition-opacity hover:before:opacity-100">
			<div class="flex items-start gap-3 mb-1.5">
				@issueStateIcon(d.State)
				<div class="min-w-0 flex-1 flex items-center gap-2 flex-wrap">
					if d.Repo != "" {
						<span class="font-mono text-[12px] text-muted-foreground">{ d.Repo }</span>
						<span class="opacity-50" aria-hidden="true">·</span>
					}
					if d.Private {
						<span class="inline-flex items-center text-warning" title="Private" aria-label="Private">🔒</span>
					}
					<p class="text-[13.5px] font-medium leading-snug group-hover:underline">@Highlight(d.Title, d.Query)</p>
					@issueStateBadge(d.State)
				</div>
			</div>
			<div class="flex items-center justify-between gap-3 pl-[27px]">
				<div class="flex items-center gap-1.5 text-[12px] text-muted-foreground min-w-0 flex-wrap">
					<span class="font-mono">#{ strconv.Itoa(d.Number) }</span>
					<span class="opacity-50" aria-hidden="true">·</span>
					<span class="inline-flex items-center justify-center h-4 w-4 rounded-full border border-border bg-muted text-[8px] font-medium uppercase text-muted-foreground select-none" aria-hidden="true">{ initials(d.Author) }</span>
					<span>{ d.Author }</span>
					if d.Time != "" {
						<span class="opacity-50" aria-hidden="true">·</span>
						<time>{ d.Time }</time>
					}
					if len(d.Labels) > 0 {
						<span class="opacity-50 mx-0.5" aria-hidden="true">·</span>
						for _, l := range d.Labels {
							<span class="text-[10px] px-[7px] py-px rounded-full border font-medium whitespace-nowrap" style={ labelChipStyle(l.Color) }>{ l.Name }</span>
						}
					}
				</div>
				<div class="flex items-center gap-3 text-[12px] text-muted-foreground shrink-0">
					if d.Priority != "" {
						@issuePriorityPill(d.Priority)
					}
					if d.Comments > 0 {
						<span class="inline-flex items-center gap-1" title={ strconv.Itoa(d.Comments) + " comments" }>
							<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"></path></svg>
							{ strconv.Itoa(d.Comments) }
						</span>
					}
				</div>
			</div>
		</a>
	</li>
}

templ issueStateIcon(state string) {
	if state == "closed" {
		<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 mt-0.5 text-destructive" aria-hidden="true">
			<circle cx="12" cy="12" r="9"></circle>
			<path d="M9 9l6 6M15 9l-6 6"></path>
		</svg>
	} else {
		<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 mt-0.5 text-success" aria-hidden="true">
			<circle cx="12" cy="12" r="9"></circle>
			<circle cx="12" cy="12" r="3"></circle>
		</svg>
	}
}

templ issueStateBadge(state string) {
	if state == "closed" {
		@Badge(BadgeDestructive) {
			Closed
		}
	} else {
		@Badge(BadgeSuccess) {
			Open
		}
	}
}

templ issuePriorityPill(p string) {
	switch p {
		case "P0":
			<span class="inline-flex items-center text-[10px] px-1.5 py-0.5 rounded-full border bg-destructive/10 text-destructive border-destructive/30 whitespace-nowrap">P0</span>
		case "P1":
			<span class="inline-flex items-center text-[10px] px-1.5 py-0.5 rounded-full border bg-blue-500/10 text-blue-500 border-blue-500/30 whitespace-nowrap">P1</span>
		default:
			<span class="inline-flex items-center text-[10px] px-1.5 py-0.5 rounded-full border border-border bg-accent text-muted-foreground whitespace-nowrap">{ p }</span>
	}
}
