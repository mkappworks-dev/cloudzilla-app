package components

// EmptyState renders a centered empty-state card with a single message.
templ EmptyState(message string) {
	<div class="bg-white border border-gray-200 rounded-lg p-8 text-center">
		<p class="text-gray-500">{ message }</p>
	</div>
}

// EmptyStateWithHint renders an empty-state card with a message and a secondary hint line.
templ EmptyStateWithHint(message, hint string) {
	<div class="bg-white border border-gray-200 rounded-lg p-8 text-center">
		<p class="text-gray-500">{ message }</p>
		<p class="text-sm text-gray-400 mt-2">{ hint }</p>
	</div>
}
