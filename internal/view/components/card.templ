package components

templ Card(attrs templ.Attributes) {
	<div { withClass(attrs, "rounded-lg border border-border bg-card text-card-foreground")... }>
		{ children... }
	</div>
}

templ CardHeader() {
	<div class="flex flex-col space-y-1.5 p-5 border-b border-border">
		{ children... }
	</div>
}

// Only level 3 (nested cards) renders <h3>; every other value renders <h2>.
templ CardTitle(level int) {
	if level == 3 {
		<h3 class="text-[13px] font-semibold leading-none tracking-tight">{ children... }</h3>
	} else {
		<h2 class="text-[13px] font-semibold leading-none tracking-tight">{ children... }</h2>
	}
}

templ CardDescription() {
	<p class="text-[12px] text-muted-foreground">{ children... }</p>
}

templ CardContent() {
	<div class="p-5">
		{ children... }
	</div>
}

templ CardFooter() {
	<div class="flex items-center p-5 border-t border-border">
		{ children... }
	</div>
}
