package components

import (
	"strconv"
	"time"
)

type RepoListRowData struct {
	Owner, Name string
	Description string
	Private     bool
	CreatedAt   time.Time // zero omits the line
	ShowStats   bool
	Stars       int
	Forks       int
	Query       string // highlights matching words in the name
}

templ RepoListRow(d RepoListRowData) {
	<li class="px-6 py-4">
		<div class="flex items-start justify-between gap-4">
			<div class="min-w-0">
				<a href={ templ.SafeURL("/" + d.Owner + "/" + d.Name) } class="text-foreground font-semibold hover:underline">@Highlight(d.Owner+"/"+d.Name, d.Query)</a>
				if d.Description != "" {
					<p class="text-sm text-muted-foreground mt-0.5 truncate">{ d.Description }</p>
				}
				if !d.CreatedAt.IsZero() {
					<p class="text-xs text-muted-foreground mt-1">
						Created <time datetime={ d.CreatedAt.UTC().Format(time.RFC3339) }>{ d.CreatedAt.Format("Jan 2, 2006") }</time>
					</p>
				}
			</div>
			if d.Private || d.ShowStats {
				<div class="shrink-0 flex items-center gap-3 text-xs text-muted-foreground">
					if d.Private {
						@Badge(BadgeWarning) {
							Private
						}
					}
					if d.ShowStats {
						<span title="Stars"><span aria-hidden="true">&#9733;</span> { strconv.Itoa(d.Stars) }</span>
						<span title="Forks"><span aria-hidden="true">&#8921;</span> { strconv.Itoa(d.Forks) }</span>
					}
				</div>
			}
		</div>
	</li>
}
