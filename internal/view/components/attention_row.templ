package components

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/service"
)

templ AttentionRow(item service.AttentionItem) {
	<a href={ templ.SafeURL(item.URL) } class="group flex items-center gap-3 border-l-2 border-l-transparent px-4 py-3 transition-all hover:border-l-foreground hover:bg-accent hover:pl-[18px]">
		<span class={ "flex-shrink-0 h-4 w-4 rounded-full grid place-items-center", attentionRowColorClass(item.Kind) } aria-hidden="true">
			@attentionRowIcon(item.Kind)
		</span>
		<div class="min-w-0 flex-1">
			<p class="text-[13px] truncate">{ attentionRowKindLabel(item.Kind) + ": " + item.Title }</p>
			<p class="text-[11px] text-muted-foreground mt-0.5">
				<span class="font-mono">{ item.RepoName }</span>
				<span aria-hidden="true"> · </span>
				<span class="font-mono">{ "#" + strconv.Itoa(item.Number) }</span>
				<span aria-hidden="true"> · </span>
				<time datetime={ item.WaitingSince.UTC().Format(time.RFC3339) }>{ attentionWaitingLabel(item.Kind, item.WaitingSince) }</time>
			</p>
		</div>
	</a>
}

func attentionRowColorClass(kind service.AttentionKind) string {
	switch kind {
	case service.AttentionPRReviewRequested:
		return "text-success"
	case service.AttentionMention:
		return "text-warning"
	case service.AttentionIssueAssigned, service.AttentionPRAssigned:
		return "text-ring"
	default:
		return "text-muted-foreground"
	}
}

templ attentionRowIcon(kind service.AttentionKind) {
	switch kind {
	case service.AttentionPRReviewRequested:
		<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
			<path d="M5 12h14M12 5l7 7-7 7"></path>
		</svg>
	case service.AttentionMention:
		<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
			<path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"></path>
		</svg>
	default:
		<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
			<circle cx="12" cy="12" r="9"></circle>
			<path d="M12 7v5l3 2"></path>
		</svg>
	}
}

func attentionRowKindLabel(kind service.AttentionKind) string {
	switch kind {
	case service.AttentionPRReviewRequested:
		return "Review"
	case service.AttentionPRAssigned:
		return "Assigned"
	case service.AttentionIssueAssigned:
		return "Assigned"
	case service.AttentionMention:
		return "Mention"
	default:
		return "Item"
	}
}

func attentionWaitingLabel(kind service.AttentionKind, since time.Time) string {
	rel := attentionRelativeShort(since)
	switch kind {
	case service.AttentionPRReviewRequested:
		return "review requested " + rel
	case service.AttentionMention:
		return "mentioned " + rel
	default:
		return "assigned " + rel
	}
}

func attentionRelativeShort(t time.Time) string {
	if t.IsZero() {
		return ""
	}
	d := time.Since(t)
	switch {
	case d < time.Minute:
		return "just now"
	case d < time.Hour:
		m := int(d / time.Minute)
		return strconv.Itoa(m) + "m ago"
	case d < 24*time.Hour:
		return strconv.Itoa(int(d/time.Hour)) + "h ago"
	case d < 30*24*time.Hour:
		return strconv.Itoa(int(d/(24*time.Hour))) + "d ago"
	default:
		return t.Format("Jan 2, 2006")
	}
}
