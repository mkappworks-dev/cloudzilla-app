package components

import "strconv"

type TreeNode struct {
	Name        string
	IsDir       bool
	Href        string
	ChildrenURL string
	Children    []TreeNode
	IsOpen      bool
	IsActive    bool
}

templ FileTreeSidebar(nodes []TreeNode) {
	<aside
		x-data="{ filter: '' }"
		class="rounded-md border border-border bg-card sticky top-4 self-start max-h-[calc(100vh-5rem)] overflow-hidden flex flex-col"
		aria-label="Repository file tree"
	>
		<header class="px-3 py-2 border-b border-border flex items-center gap-2 bg-muted/40 shrink-0">
			<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="text-muted-foreground" aria-hidden="true" focusable="false">
				<path d="M3 6h18M3 12h18M3 18h18"></path>
			</svg>
			<span class="text-[12px] font-medium">Files</span>
			<div class="ml-auto flex items-center gap-0.5">
				<button
					type="button"
					x-on:click="filter = ''"
					title="Clear filter"
					aria-label="Clear filter"
					class="h-6 w-6 grid place-items-center rounded-sm hover:bg-muted text-muted-foreground"
				>
					<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
						<path d="M19 9l-7 7-7-7"></path>
					</svg>
				</button>
			</div>
		</header>
		<div class="px-2 py-1.5 border-b border-border shrink-0">
			<input
				x-model="filter"
				type="search"
				placeholder="Filter files…"
				class="w-full h-7 px-2 text-[12px] bg-transparent border border-border rounded-xs placeholder:text-muted-foreground/60 focus:outline-hidden focus:border-foreground/30"
				aria-label="Filter files"
			/>
		</div>
		<div class="overflow-y-auto flex-1 flex flex-col">
			<ol class="overflow-y-auto py-1 flex-1 text-[12.5px]" role="tree">
				@FileTreeItems(nodes, 0)
			</ol>
		</div>
	</aside>
}

templ FileTreeItems(nodes []TreeNode, depth int) {
	for _, n := range nodes {
		@treeItem(n, depth)
	}
}

templ treeItem(n TreeNode, depth int) {
	<li
		data-name={ n.Name }
		x-show="!filter || $el.dataset.name.toLowerCase().includes(filter.toLowerCase())"
		role="treeitem"
		if n.IsDir {
			aria-expanded?={ n.IsOpen }
		}
	>
		if n.IsDir {
			<div x-data={ "{ open: " + boolStr(n.IsOpen) + " }" }>
				<div class="flex items-center gap-0.5 rounded-sm hover:bg-muted/50" style={ "padding-left: " + depthPx(depth) + "px" }>
					<button
						type="button"
						x-on:click="open = !open"
						if !n.IsOpen {
							hx-get={ n.ChildrenURL }
							hx-trigger="click once"
							hx-target="next ol"
							hx-swap="innerHTML"
						}
						class="shrink-0 h-5 w-5 flex items-center justify-center text-muted-foreground/50"
						aria-label="Toggle folder"
					>
						<svg class="transition-transform" :class="open ? 'rotate-90' : ''" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" focusable="false">
							<path d="M9 6l6 6-6 6"></path>
						</svg>
					</button>
					<a
						href={ templ.SafeURL(n.Href) }
						class="flex items-center gap-1 py-[3px] flex-1 min-w-0 text-muted-foreground hover:text-foreground text-[12.5px]"
					>
						<svg style="color:#6ea8fe" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
							<path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"></path>
						</svg>
						<span class="truncate">{ n.Name }</span>
					</a>
				</div>
				<ol x-show="open" role="group">
					@FileTreeItems(n.Children, depth+1)
				</ol>
			</div>
		} else {
			<a
				href={ templ.SafeURL(n.Href) }
				if n.IsActive {
					aria-current="page"
				}
				class={ "flex items-center gap-1 py-[3px] rounded-sm text-[12.5px] " + fileItemClass(n.IsActive) }
				style={ "padding-left: " + depthPx(depth) + "px" }
			>
				<span class="shrink-0 w-5 flex items-center justify-center"></span>
				<svg class="shrink-0 text-muted-foreground/50" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
					<path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"></path>
					<polyline points="14 2 14 8 20 8"></polyline>
				</svg>
				<span class="truncate font-mono">{ n.Name }</span>
			</a>
		}
	</li>
}

func boolStr(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

func depthPx(depth int) string {
	return strconv.Itoa(8 + depth*12)
}

func fileItemClass(active bool) string {
	if active {
		return "bg-accent text-foreground"
	}
	return "text-muted-foreground hover:text-foreground hover:bg-muted/50"
}
