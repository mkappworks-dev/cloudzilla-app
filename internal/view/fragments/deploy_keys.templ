package fragments

import (
	"strconv"
	"time"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
)

templ DeployKeys(data view.DeployKeysFragData) {
	<div id="deploy-keys-list">
		if len(data.DeployKeys) > 0 {
			<table class="w-full text-sm">
				<thead>
					<tr class="text-left text-muted-foreground border-b border-border">
						<th class="pb-2 font-medium">Title</th>
						<th class="pb-2 font-medium">Fingerprint</th>
						<th class="pb-2 font-medium">Access</th>
						<th class="pb-2 font-medium">Last used</th>
						<th class="pb-2"></th>
					</tr>
				</thead>
				<tbody class="divide-y divide-border">
					for _, dk := range data.DeployKeys {
						<tr>
							<td class="py-3 font-medium text-foreground">{ dk.Title }</td>
							<td class="py-3 font-mono text-muted-foreground text-xs">{ dk.Fingerprint }</td>
							<td class="py-3">
								if dk.ReadOnly {
									@components.Badge(components.BadgeWarning) {
										Read-only
									}
								} else {
									@components.Badge(components.BadgeSuccess) {
										Read-write
									}
								}
							</td>
							<td class="py-3 text-muted-foreground text-xs">
								if dk.LastUsedAt != nil {
									<time datetime={ dk.LastUsedAt.UTC().Format(time.RFC3339) }>{ dk.LastUsedAt.Format("Jan 2, 2006") }</time>
								} else {
									Never
								}
							</td>
							<td class="py-3 text-right">
								if data.CanManage {
									@components.Button(components.ButtonDestructiveOutline, components.ButtonSizeSM, templ.Attributes{
										"hx-delete":           "/api/repos/" + data.Owner + "/" + data.RepoName + "/keys/" + strconv.FormatInt(dk.ID, 10),
										"hx-target":           "#deploy-keys-list",
										"hx-swap":             "outerHTML",
										"hx-confirm":          "The " + dk.Title + " key will immediately lose access. Any pipeline using it will stop working.",
										"data-confirm-title":  "Revoke this deploy key?",
										"data-confirm-label":  "Revoke",
										"data-confirm-danger": "true",
										"data-toast":          "Deploy key revoked",
										"type":                "button",
									}) {
										Revoke
									}
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		} else {
			<div class="text-center py-6 border border-dashed border-border rounded-md bg-muted/30">
				<p class="text-sm text-muted-foreground">No deploy keys yet.</p>
			</div>
		}
	</div>
}
