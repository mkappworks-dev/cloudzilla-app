package fragments

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
)

templ DeployKeys(data view.DeployKeysFragData) {
	<div id="deploy-keys">
		if len(data.DeployKeys) > 0 {
			<table class="w-full text-sm">
				<thead>
					<tr class="text-left text-muted-foreground border-b border-border">
						<th class="pb-2 font-medium">Title</th>
						<th class="pb-2 font-medium">Fingerprint</th>
						<th class="pb-2 font-medium">Access</th>
						<th class="pb-2 font-medium">Last used</th>
						<th class="pb-2"></th>
					</tr>
				</thead>
				<tbody class="divide-y divide-border">
					for _, dk := range data.DeployKeys {
						<tr>
							<td class="py-3 font-medium text-foreground">{ dk.Title }</td>
							<td class="py-3 font-mono text-muted-foreground text-xs">{ dk.Fingerprint }</td>
							<td class="py-3">
								if dk.ReadOnly {
									<span class="inline-block bg-warning/10 text-warning text-xs px-2 py-0.5 rounded">Read-only</span>
								} else {
									<span class="inline-block bg-success/10 text-success text-xs px-2 py-0.5 rounded">Read-write</span>
								}
							</td>
							<td class="py-3 text-muted-foreground text-xs">
								if dk.LastUsedAt != nil {
									{ dk.LastUsedAt.Format("Jan 2, 2006") }
								} else {
									Never
								}
							</td>
							<td class="py-3">
								if data.CanManage {
									<button
										hx-delete={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/keys/" + strconv.FormatInt(dk.ID, 10) }
										hx-target="#deploy-keys"
										hx-swap="outerHTML"
										hx-confirm="Revoke this deploy key?"
										class="px-3 py-1 text-destructive border border-destructive/40 rounded hover:bg-destructive/10 transition-colors text-xs"
									>
										Revoke
									</button>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		} else {
			<div class="text-center py-6 border border-border border-dashed rounded-lg bg-muted/40">
				<p class="text-muted-foreground text-sm">No deploy keys yet.</p>
			</div>
		}
	</div>
}
