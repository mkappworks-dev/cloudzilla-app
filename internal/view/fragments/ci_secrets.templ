package fragments

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/timefmt"
)

// CISecretsCard lists a repo's secrets. Values are write-only: nothing here, or anywhere, renders one back.
templ CISecretsCard(d view.CISettings) {
	<div id="secrets-card">
		@components.Card(nil) {
			@components.CardHeader() {
				<div class="flex items-start justify-between gap-4">
					<div class="min-w-0">
						@components.CardTitle(2) {
							Secrets
						}
						@components.CardDescription() {
							Available to workflows as <span class="font-mono">{ "${{ secrets.NAME }}" }</span>. Values are write-only: nobody can read one back here.
						}
					</div>
					@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{"type": "button", "data-secret-open": "add", "disabled": !d.HasKey, "class": "shrink-0"}) {
						Add secret
					}
				</div>
			}
			@components.CardContent() {
				<div class="flex flex-col gap-4">
					if !d.HasKey {
						<div role="status" class="rounded-md border border-warning/40 bg-warning/10 p-4 text-[13px]">
							<p class="font-semibold text-warning">Set security.secret_key to store secrets</p>
							<p class="text-muted-foreground mt-1">Secrets are sealed with <code class="font-mono text-foreground">security.secret_key</code> (<code class="font-mono text-foreground">CZ_SECURITY_SECRET_KEY</code>), which isn't set on this Instance. Ask an administrator to set it and restart the server.</p>
						</div>
					}
					if len(d.Secrets) == 0 {
						<p class="py-4 text-center text-sm text-muted-foreground">No secrets yet.</p>
					} else {
						<div class="overflow-x-auto">
							@components.Table(nil) {
								@components.TableHeader() {
									@components.TableRow(false) {
										@components.TableHead(templ.Attributes{"scope": "col"}) {
											Name
										}
										@components.TableHead(templ.Attributes{"scope": "col"}) {
											Created by
										}
										@components.TableHead(templ.Attributes{"scope": "col"}) {
											Updated
										}
										@components.TableHead(templ.Attributes{"scope": "col"}) {
											<span class="sr-only">Actions</span>
										}
									}
								}
								@components.TableBody() {
									for _, s := range d.Secrets {
										@components.TableRow(false) {
											@components.TableRowHead(templ.Attributes{"class": "font-mono font-medium text-foreground"}) {
												{ s.Name }
											}
											@components.TableCell(templ.Attributes{"class": "text-muted-foreground"}) {
												{ s.CreatedByName }
											}
											@components.TableCell(templ.Attributes{"class": "text-muted-foreground text-xs"}) {
												{ timefmt.Date(s.UpdatedAt) }
											}
											@components.TableCell(templ.Attributes{"class": "text-right whitespace-nowrap"}) {
												@components.Button(components.ButtonOutline, components.ButtonSizeSM, templ.Attributes{"type": "button", "data-secret-open": "replace", "data-name": s.Name, "disabled": !d.HasKey}) {
													Replace
												}
												@components.Button(components.ButtonDestructiveOutline, components.ButtonSizeSM, templ.Attributes{
													"hx-post":             d.Base + "/secrets/" + s.Name + "/delete",
													"hx-target":           "#secrets-card",
													"hx-swap":             "outerHTML",
													"hx-confirm":          "Workflows that read it get an empty value from the next Run.",
													"data-confirm-title":  "Delete " + s.Name + "?",
													"data-confirm-label":  "Delete",
													"data-confirm-danger": "true",
													"data-toast":          "Secret deleted",
													"type":                "button",
													"class":               "ml-1",
												}) {
													Delete
												}
											}
										}
									}
								}
							}
						</div>
					}
					<p class="text-[12px] text-muted-foreground">A writer can read a secret by pushing a workflow that prints it. Secrets are withheld from fork pull requests.</p>
				</div>
			}
		}
	</div>
}
