package fragments

import "github.com/mkappworks/cloudzilla/internal/view"

templ OrgMembers(data view.OrgMembersFragData) {
	<div id="org-members-list" class="divide-y divide-gray-100 border border-gray-200 rounded-lg">
		if len(data.Members) > 0 {
			for _, member := range data.Members {
				<div class="px-4 py-3 flex justify-between items-center">
					<div>
						<a href={ templ.SafeURL("/" + member.Username) } class="text-blue-600 hover:underline font-medium">{ member.Username }</a>
						<span class="ml-2 text-xs text-gray-500 capitalize">{ string(member.Role) }</span>
					</div>
					if data.CanManage {
						<button
							hx-delete={ "/api/orgs/" + data.OrgName + "/members/" + member.Username }
							hx-target="#org-members-list"
							hx-swap="outerHTML"
							hx-confirm={ "Remove " + member.Username + " from this organization?" }
							class="text-xs text-red-600 hover:underline"
						>
							Remove
						</button>
					}
				</div>
			}
		} else {
			<div class="px-4 py-3 text-gray-500 text-sm">No members yet.</div>
		}
	</div>
}
