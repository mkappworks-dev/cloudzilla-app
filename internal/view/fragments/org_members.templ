package fragments

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/model"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
)

templ OrgMembers(data view.OrgMembersFragData) {
	<div id="org-members-list" class="divide-y divide-border border border-border rounded-md">
		if len(data.Members) > 0 {
			for _, m := range data.Members {
				@orgMemberRow(data.OrgName, m, data.ViewerID, data.CanManage, data.Confirm)
			}
		} else {
			<div class="px-4 py-3 text-muted-foreground text-sm">No members yet.</div>
		}
	</div>
}

templ orgMemberRow(orgName string, m model.OrgMember, viewerID int64, canManage bool, confirm components.ConfirmFactors) {
	{{ isSelf := m.UserID == viewerID }}
	{{ roleURL := "/api/orgs/" + orgName + "/members/" + m.Username + "/role" }}
	{{ promoteID := "org-promote-" + strconv.FormatInt(m.UserID, 10) }}
	<div class="px-4 py-3 flex items-center gap-3" data-org-member-row data-username={ m.Username } data-role={ string(m.Role) }>
		@components.Avatar(m.Username, components.AvatarSizeDefault, m.Username)
		<div class="min-w-0 flex-1">
			<div class="flex items-center gap-2">
				<a href={ templ.SafeURL("/" + m.Username) } class="text-[13.5px] font-medium hover:underline">{ m.Username }</a>
				if isSelf {
					@components.Badge(components.BadgeOutline) {
						You
					}
				}
			</div>
			<p class="text-[11.5px] text-muted-foreground font-mono">
				{ "@" + m.Username }
			</p>
		</div>
		if canManage && !isSelf {
			<select
				name="role"
				aria-label={ "Role of " + m.Username }
				hx-post={ roleURL }
				hx-trigger="demote"
				hx-target="#org-members-list"
				hx-swap="outerHTML"
				hx-include="this"
				x-data
				x-on:change={ "if ($el.value === 'owner') { $el.value = 'member'; document.getElementById(" + components.JSLiteral(promoteID) + ").showModal() } else { htmx.trigger($el, 'demote') }" }
				class="flex h-8 rounded-md border border-input bg-transparent px-2 text-[12px] shadow-xs w-[110px]"
			>
				<option value="owner" selected?={ m.Role == model.OrgRoleOwner }>Owner</option>
				<option value="member" selected?={ m.Role == model.OrgRoleMember }>Member</option>
			</select>
			if m.Role == model.OrgRoleMember {
				@orgPromoteDialog(promoteID, roleURL, m, confirm)
			}
			<button
				type="button"
				hx-delete={ "/api/orgs/" + orgName + "/members/" + m.Username }
				hx-target="#org-members-list"
				hx-swap="outerHTML"
				hx-confirm={ m.Username + " will lose access to all repos in " + orgName + ". You can invite them back later." }
				data-confirm-title={ "Remove " + m.Username + " from this organization?" }
				data-confirm-label="Remove"
				data-confirm-danger="true"
				data-toast="Member removed"
				class="h-8 px-2.5 text-[12px] rounded-md border border-border hover:bg-accent text-destructive shrink-0"
			>
				Remove
			</button>
		} else {
			<span class="text-[12px] text-muted-foreground capitalize w-[110px] text-center">{ string(m.Role) }</span>
			if isSelf {
				<button type="button" disabled title="You can't remove yourself" class="h-8 px-2.5 text-[12px] rounded-md border border-border text-muted-foreground opacity-60 shrink-0 cursor-not-allowed">
					Remove
				</button>
			}
		}
	</div>
}

// Owners get every repository in the org, so promoting one is confirmed like
// adding a collaborator.
templ orgPromoteDialog(id, roleURL string, m model.OrgMember, confirm components.ConfirmFactors) {
	@components.Dialog(id) {
		<form hx-post={ roleURL } hx-target="#org-members-list" hx-swap="outerHTML">
			<input type="hidden" name="role" value="owner"/>
			@components.DialogHeader() {
				@components.DialogTitle(id) {
					{ "Make " + m.Username + " an owner?" }
				}
				@components.DialogDescription() {
					Owners can use every repository in the organization and manage its settings, members, and ownership.
				}
			}
			@components.DialogBody() {
				<div class="space-y-4">
					<div id={ "org-promote-error-" + strconv.FormatInt(m.UserID, 10) }></div>
					@components.ConfirmFields(id, confirm, true)
				</div>
			}
			@components.DialogFooter() {
				<button type="button" onclick="this.closest('dialog').close()" class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-transparent hover:bg-accent hover:text-accent-foreground h-9 px-4">Cancel</button>
				<button type="submit" class="inline-flex items-center justify-center rounded-md text-sm font-medium h-9 px-4 bg-primary text-primary-foreground hover:bg-primary/90">Make owner</button>
			}
		</form>
	}
}
