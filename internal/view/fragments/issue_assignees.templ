package fragments

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
)

templ IssueAssignees(data view.IssueAssigneeSidebarData) {
	@components.AssigneeSidebar(data.Owner, data.RepoName, data.IssueNumber, "issues", data.Assignees, data.CanWrite)
}
