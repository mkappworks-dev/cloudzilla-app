package fragments

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"strconv"
)

templ SavedRepliesList(data view.SavedRepliesFragData) {
	<div id="saved-replies-list" class="space-y-2">
		if len(data.Replies) > 0 {
			for _, reply := range data.Replies {
				<div class="border border-border rounded-md p-3" data-reply-id={ strconv.FormatInt(reply.ID, 10) }>
					<div class="flex items-start gap-3">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="text-muted-foreground shrink-0 mt-0.5" aria-hidden="true"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"></path></svg>
						<div class="min-w-0 flex-1">
							<p class="text-[13.5px] font-medium">{ reply.Title }</p>
							<p class="mt-0.5 text-[12px] text-muted-foreground whitespace-pre-wrap break-words">{ reply.Body }</p>
						</div>
						<div class="flex gap-2 shrink-0">
							<button
								type="button"
								onclick="this.closest('[data-reply-id]').querySelector('form').classList.toggle('hidden')"
								class="h-8 px-3 text-[13px] rounded-md border border-border hover:bg-muted text-foreground"
							>Edit</button>
							<button
								type="button"
								hx-delete={ "/api/user/replies/" + strconv.FormatInt(reply.ID, 10) }
								hx-target="#saved-replies-list"
								hx-swap="outerHTML"
								hx-confirm={ "The " + reply.Title + " reply will be removed from your saved replies." }
								data-confirm-title="Delete this saved reply?"
								data-confirm-label="Delete"
								data-confirm-danger="true"
								data-toast="Saved reply deleted"
								class="h-8 px-3 text-[13px] rounded-md border border-border hover:bg-muted text-destructive"
							>Delete</button>
						</div>
					</div>
					<form
						hx-patch={ "/api/user/replies/" + strconv.FormatInt(reply.ID, 10) }
						hx-target="#saved-replies-list"
						hx-swap="outerHTML"
						data-toast="Saved reply updated"
						class="hidden mt-3 pt-3 border-t border-border space-y-3"
					>
						<div>
							<label for={ "reply-title-" + strconv.FormatInt(reply.ID, 10) } class="block text-[12px] font-medium text-muted-foreground mb-1.5">Title</label>
							<input id={ "reply-title-" + strconv.FormatInt(reply.ID, 10) } name="title" type="text" value={ reply.Title } required class="w-full bg-background border border-border rounded-md px-3 py-2 text-[13px] text-foreground focus:outline-none focus:border-ring"/>
						</div>
						<div>
							<label for={ "reply-body-" + strconv.FormatInt(reply.ID, 10) } class="block text-[12px] font-medium text-muted-foreground mb-1.5">Content</label>
							<textarea id={ "reply-body-" + strconv.FormatInt(reply.ID, 10) } name="body" rows="4" required class="w-full bg-background border border-border rounded-md px-3 py-2 text-[13px] text-foreground focus:outline-none focus:border-ring">{ reply.Body }</textarea>
						</div>
						<div class="flex justify-end gap-2">
							<button type="button" onclick="this.form.reset(); this.form.classList.add('hidden')" class="h-8 px-3 text-[13px] rounded-md border border-border hover:bg-muted text-foreground">Cancel</button>
							<button type="submit" class="h-8 px-3 text-[13px] rounded-md font-medium bg-primary text-primary-foreground hover:bg-primary/90">Save</button>
						</div>
					</form>
				</div>
			}
		} else {
			<div class="text-center py-6 border border-dashed border-border rounded-md text-[13px] text-muted-foreground">No saved replies yet.</div>
		}
	</div>
}

templ SavedRepliesPicker(data view.SavedRepliesPickerFragData) {
	<div id="saved-replies-picker-container" class="relative">
		<div id="saved-replies-picker" class="absolute z-50 right-0 mt-1 w-72 bg-background border border-border rounded-lg shadow-lg max-h-64 overflow-y-auto">
			if len(data.Replies) > 0 {
				<ul class="py-1">
					for _, reply := range data.Replies {
						<li>
							<button
								type="button"
								class="w-full text-left px-4 py-2 hover:bg-muted/40 text-sm"
								data-saved-reply-body={ reply.Body }
							>
								<span class="font-medium text-foreground">{ reply.Title }</span>
								<span class="block text-xs text-muted-foreground truncate mt-0.5">{ reply.Body }</span>
							</button>
						</li>
					}
				</ul>
			} else {
				<p class="px-4 py-3 text-sm text-muted-foreground">No saved replies. <a href="/settings#saved-replies" class="text-foreground hover:underline">Create one</a>.</p>
			}
		</div>
	</div>
}
