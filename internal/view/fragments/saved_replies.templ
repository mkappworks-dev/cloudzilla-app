package fragments

import (
	"strconv"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
)

templ SavedRepliesList(data view.SavedRepliesFragData) {
	<div id="saved-replies-list">
		if len(data.Replies) > 0 {
			<div class="space-y-3">
				for _, reply := range data.Replies {
					<div class="bg-background border border-border rounded-lg p-4" id={ "reply-" + strconv.FormatInt(reply.ID, 10) }>
						<div class="flex justify-between items-start gap-4">
							<div class="min-w-0 flex-1">
								<p class="font-semibold text-sm text-foreground">{ reply.Title }</p>
								<p class="text-sm text-muted-foreground mt-1 whitespace-pre-wrap">{ reply.Body }</p>
							</div>
							<div class="flex gap-2 shrink-0">
								<button
									x-data
									x-on:click={ "$el.closest('[id^=reply-]').querySelector('[id^=edit-form-]').classList.toggle('hidden')" }
									class="text-xs text-foreground hover:underline">
									Edit
								</button>
								<button
									hx-delete={ "/api/user/replies/" + strconv.FormatInt(reply.ID, 10) }
									hx-target="#saved-replies-list"
									hx-swap="outerHTML"
									hx-confirm="Delete this saved reply?"
									class="text-xs text-destructive hover:underline">
									Delete
								</button>
							</div>
						</div>
						<div id={ "edit-form-" + strconv.FormatInt(reply.ID, 10) } class="hidden mt-4 space-y-3 border-t border-border pt-4">
							<form
								hx-patch={ "/api/user/replies/" + strconv.FormatInt(reply.ID, 10) }
								hx-target="#saved-replies-list"
								hx-swap="outerHTML"
								class="space-y-3">
								<input type="text" name="title" value={ reply.Title }
									class="w-full px-3 py-2 border border-border rounded-md text-sm focus:outline-none focus:ring-2 focus-visible:outline-ring"
									required/>
								<textarea name="body" rows="3"
									class="w-full px-3 py-2 border border-border rounded-md text-sm focus:outline-none focus:ring-2 focus-visible:outline-ring"
									required>{ reply.Body }</textarea>
								<div class="flex gap-2">
									<button type="submit" class="px-3 py-1.5 bg-primary text-background rounded text-sm hover:bg-primary">Save</button>
									<button type="button"
										x-data
										x-on:click={ "$el.closest('[id^=reply-]').querySelector('[id^=edit-form-]').classList.add('hidden')" }
										class="px-3 py-1.5 bg-muted text-foreground rounded text-sm hover:bg-muted">Cancel</button>
								</div>
							</form>
						</div>
					</div>
				}
			</div>
		} else {
			<div class="text-center py-8 border border-border border-dashed rounded-lg bg-muted/40">
				<p class="text-muted-foreground">No saved replies yet. Create one above.</p>
			</div>
		}
	</div>
}

templ SavedRepliesPicker(data view.SavedRepliesPickerFragData) {
	<div id="saved-replies-picker-container" class="relative">
		<div id="saved-replies-picker" class="absolute z-50 right-0 mt-1 w-72 bg-background border border-border rounded-lg shadow-lg max-h-64 overflow-y-auto">
			if len(data.Replies) > 0 {
				<ul class="py-1">
					for _, reply := range data.Replies {
						<li>
							<button
								type="button"
								class="w-full text-left px-4 py-2 hover:bg-muted/40 text-sm"
								data-saved-reply-body={ reply.Body }>
								<span class="font-medium text-foreground">{ reply.Title }</span>
								<span class="block text-xs text-muted-foreground truncate mt-0.5">{ reply.Body }</span>
							</button>
						</li>
					}
				</ul>
			} else {
				<p class="px-4 py-3 text-sm text-muted-foreground">No saved replies. <a href="/settings/replies" class="text-foreground hover:underline">Create one</a>.</p>
			}
		</div>
	</div>
}
