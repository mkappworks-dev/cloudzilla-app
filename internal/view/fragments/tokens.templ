package fragments

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
)

templ TokensList(data view.TokensListFragData) {
	<div id="tokens-list">
		if len(data.Tokens) > 0 {
			<table class="w-full text-sm">
				<thead>
					<tr class="text-left text-muted-foreground border-b border-border">
						<th class="pb-2 font-medium">Name</th>
						<th class="pb-2 font-medium">Scopes</th>
						<th class="pb-2 font-medium">Last used</th>
						<th class="pb-2 font-medium">Expires</th>
						<th class="pb-2 font-medium">Suffix</th>
						<th class="pb-2"></th>
					</tr>
				</thead>
				<tbody class="divide-y divide-border">
					for _, tok := range data.Tokens {
						<tr class="py-2">
							<td class="py-3 font-medium text-foreground">{ tok.Name }</td>
							<td class="py-3 text-muted-foreground">
								if len(tok.Scopes) > 0 {
									for _, scope := range tok.Scopes {
										<span class="inline-block bg-muted text-foreground text-xs px-2 py-0.5 rounded mr-1">{ scope }</span>
									}
								} else {
									<span class="text-muted-foreground">none</span>
								}
							</td>
							<td class="py-3 text-muted-foreground">
								if tok.LastUsedAt != nil {
									{ tok.LastUsedAt.Format("Jan 2, 2006") }
								} else {
									Never
								}
							</td>
							<td class="py-3 text-muted-foreground">
								if tok.ExpiresAt != nil {
									{ tok.ExpiresAt.Format("Jan 2, 2006") }
								} else {
									Never
								}
							</td>
							<td class="py-3 font-mono text-muted-foreground text-xs">...{ tok.LastEight }</td>
							<td class="py-3">
								<button
									hx-delete={ "/api/user/tokens/" + strconv.FormatInt(tok.ID, 10) }
									hx-target="#tokens-list"
									hx-swap="outerHTML"
									hx-confirm="Revoke this token?"
									class="px-3 py-1 text-destructive border border-destructive/40 rounded hover:bg-destructive/10 transition-colors text-xs"
								>
									Revoke
								</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		} else {
			<div class="text-center py-8 border border-border border-dashed rounded-lg bg-muted/40">
				<p class="text-muted-foreground">No active tokens. Create one above.</p>
			</div>
		}
	</div>
}
