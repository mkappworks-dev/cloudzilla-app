package fragments

import (
	"github.com/mkappworks/cloudzilla/internal/view"
	"github.com/mkappworks/cloudzilla/internal/view/components"
)

templ PullAssignees(data view.PullAssigneeSidebarData) {
	@components.AssigneeSidebar(data.Owner, data.RepoName, data.PullNumber, "pulls", data.Assignees, data.CanWrite)
}
