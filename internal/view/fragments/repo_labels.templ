package fragments

import (
	"strconv"

	"github.com/mkappworks/cloudzilla/internal/view"
)

templ RepoLabels(data view.RepoLabelsFragData) {
	<div id="repo-labels" class="space-y-3">
		if data.CanWrite {
			<form
				hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/labels" }
				hx-target="#repo-labels"
				hx-swap="outerHTML"
				class="flex gap-2 flex-wrap items-end border border-gray-200 rounded-lg p-3 bg-gray-50"
			>
				<div>
					<label class="block text-xs font-medium text-gray-500 mb-1">Name</label>
					<input
						type="text"
						name="name"
						placeholder="bug, enhancement…"
						required
						class="border border-gray-300 rounded px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400"
					/>
				</div>
				<div>
					<label class="block text-xs font-medium text-gray-500 mb-1">Color</label>
					<input
						type="color"
						name="color"
						value="#e5e5e5"
						class="w-12 h-8 border border-gray-300 rounded cursor-pointer"
					/>
				</div>
				<div class="flex-1">
					<label class="block text-xs font-medium text-gray-500 mb-1">Description (optional)</label>
					<input
						type="text"
						name="description"
						placeholder="Short description"
						class="w-full border border-gray-300 rounded px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400"
					/>
				</div>
				<button type="submit" class="px-3 py-1.5 bg-blue-600 text-white rounded text-sm hover:bg-blue-700 shrink-0">
					Create label
				</button>
			</form>
		}
		if len(data.Labels) > 0 {
			for _, lbl := range data.Labels {
				<div class="flex items-center justify-between border border-gray-200 rounded-lg p-3">
					<div class="flex items-center gap-2">
						<span
							class="w-4 h-4 rounded-full inline-block border border-gray-200 shrink-0"
							style={ "background-color: " + lbl.Color }
						></span>
						<div>
							<span class="text-sm font-medium">{ lbl.Name }</span>
							if lbl.Description != "" {
								<span class="text-xs text-gray-500 ml-2">{ lbl.Description }</span>
							}
						</div>
					</div>
					if data.CanWrite {
						<button
							hx-delete={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/labels/" + strconv.FormatInt(lbl.ID, 10) }
							hx-target="#repo-labels"
							hx-swap="outerHTML"
							hx-confirm="Delete this label?"
							class="text-xs text-red-600 hover:underline ml-4"
						>
							Delete
						</button>
					}
				</div>
			}
		} else {
			<p class="text-sm text-gray-500">No labels defined yet.</p>
		}
	</div>
}
