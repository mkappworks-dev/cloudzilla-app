package fragments

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
)

templ RepoLabels(data view.RepoLabelsFragData) {
	<div id="repo-labels" class="space-y-2">
		if len(data.Labels) > 0 {
			for _, lbl := range data.Labels {
				<div class="flex items-center justify-between rounded-md border border-border p-3">
					<div class="flex items-center gap-2 min-w-0">
						<span class="w-4 h-4 rounded-full inline-block border border-border shrink-0" style={ "background-color: " + lbl.Color } aria-hidden="true"></span>
						<span class="text-sm font-medium text-foreground">{ lbl.Name }</span>
						if lbl.Description != "" {
							<span class="text-xs text-muted-foreground ml-2 truncate">{ lbl.Description }</span>
						}
					</div>
					if data.CanWrite {
						@components.Button(components.ButtonDestructiveOutline, components.ButtonSizeSM, templ.Attributes{
							"hx-delete":           "/api/repos/" + data.Owner + "/" + data.RepoName + "/labels/" + strconv.FormatInt(lbl.ID, 10),
							"hx-target":           "#repo-labels",
							"hx-swap":             "outerHTML",
							"hx-confirm":          "The " + lbl.Name + " label will be removed from every issue and pull request that uses it.",
							"data-confirm-title":  "Delete this label?",
							"data-confirm-label":  "Delete",
							"data-confirm-danger": "true",
							"data-toast":          "Label deleted",
							"type":                "button",
						}) {
							Delete
						}
					}
				</div>
			}
		} else {
			<p class="text-sm text-muted-foreground">No labels defined yet.</p>
		}
	</div>
}
