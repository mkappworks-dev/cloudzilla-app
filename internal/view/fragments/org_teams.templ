package fragments

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
)

templ OrgTeams(data view.OrgTeamsFragData) {
	<div id="org-teams-list">
		if len(data.Teams) > 0 {
			<ul class="divide-y divide-border border border-border rounded-md">
				for _, t := range data.Teams {
					<li class="px-4 py-3 flex items-center gap-3">
						<div class="min-w-0 flex-1">
							<a href={ templ.SafeURL("/orgs/" + data.OrgName + "/teams/" + t.Slug) } class="text-[13.5px] font-medium hover:underline">{ t.Name }</a>
							if t.Description != "" {
								<p class="text-[12px] text-muted-foreground truncate">{ t.Description }</p>
							}
						</div>
						<span class="font-mono text-[11.5px] text-muted-foreground shrink-0">
							{ strconv.Itoa(t.MemberCount) }
							if t.MemberCount == 1 {
								member
							} else {
								members
							}
						</span>
					</li>
				}
			</ul>
		} else {
			@components.EmptyStateWithHint("No teams yet.", "A team groups members of "+data.OrgName+" under one name and gives them a role on chosen repositories.")
		}
	</div>
}
