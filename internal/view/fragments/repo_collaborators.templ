package fragments

import (
	"strconv"
	"strings"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
)

func collabInitial(name string) string {
	if name == "" {
		return "?"
	}
	return strings.ToUpper(name[:1])
}

templ RepoCollaborators(data view.RepoCollaboratorsFragData) {
	<div id="repo-collaborators" class="space-y-2">
		if data.CanManage {
			<form
				hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/collaborators" }
				hx-target="#repo-collaborators"
				hx-swap="outerHTML"
				data-toast="Collaborator added"
				class="flex gap-3 mb-4"
			>
				<label for="collab-username" class="sr-only">Username</label>
				@components.Input(templ.Attributes{
					"id":          "collab-username",
					"type":        "text",
					"name":        "username",
					"placeholder": "Username",
					"required":    "required",
					"class":       "flex-1",
				})
				<label for="collab-role" class="sr-only">Role</label>
				<select id="collab-role" name="role" class="flex h-9 rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm">
					<option value="reader">Reader</option>
					<option value="writer">Writer</option>
					<option value="admin">Admin</option>
				</select>
				@components.Button(components.ButtonDefault, components.ButtonSizeDefault, templ.Attributes{"type": "submit"}) {
					Add
				}
			</form>
		}
		<ul class="divide-y divide-border rounded-md border border-border">
			<li class="px-4 py-3 flex items-center gap-3">
				<span class="inline-grid place-items-center h-7 w-7 rounded-full bg-muted border border-border text-xs font-medium" aria-hidden="true">
					{ collabInitial(data.Owner) }
				</span>
				<div class="min-w-0 flex-1">
					<p class="text-sm font-medium text-foreground">{ data.Owner }</p>
					<p class="text-xs text-muted-foreground">Owner</p>
				</div>
			</li>
			for _, collab := range data.Collabs {
				<li class="px-4 py-3 flex items-center gap-3">
					<span class="inline-grid place-items-center h-7 w-7 rounded-full bg-muted border border-border text-xs font-medium" aria-hidden="true">
						{ collabInitial(collab.Username) }
					</span>
					<div class="min-w-0 flex-1">
						<p class="text-sm font-medium text-foreground">{ collab.Username }</p>
						<p class="text-xs text-muted-foreground capitalize">{ string(collab.Role) }</p>
					</div>
					if data.CanManage {
						@components.Button(components.ButtonDestructiveOutline, components.ButtonSizeSM, templ.Attributes{
							"hx-delete":           "/api/repos/" + data.Owner + "/" + data.RepoName + "/collaborators?user_id=" + strconv.FormatInt(collab.UserID, 10),
							"hx-target":           "#repo-collaborators",
							"hx-swap":             "outerHTML",
							"hx-confirm":          collab.Username + " will lose access to " + data.RepoName + ". You can add them back later.",
							"data-confirm-title":  "Remove " + collab.Username + " from this repository?",
							"data-confirm-label":  "Remove",
							"data-confirm-danger": "true",
							"data-toast":          "Collaborator removed",
							"type":                "button",
						}) {
							Remove
						}
					}
				</li>
			}
		</ul>
	</div>
}
