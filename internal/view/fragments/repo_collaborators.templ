package fragments

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
)

templ RepoCollaborators(data view.RepoCollaboratorsFragData) {
	<div id="repo-collaborators" class="space-y-2">
		if data.CanManage {
			<form
				hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/collaborators" }
				hx-target="#repo-collaborators"
				hx-swap="outerHTML"
				class="flex gap-3 mb-4"
			>
				<input
					type="text"
					name="username"
					placeholder="Username"
					required
					class="flex-1 border border-border rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus-visible:outline-ring"
				/>
				<select
					name="role"
					class="border border-border rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus-visible:outline-ring"
				>
					<option value="reader">Reader</option>
					<option value="writer">Writer</option>
					<option value="admin">Admin</option>
				</select>
				<button type="submit" class="px-4 py-2 bg-primary text-background rounded text-sm hover:bg-primary">
					Add
				</button>
			</form>
		}
		if len(data.Collabs) > 0 {
			for _, collab := range data.Collabs {
				<div class="border border-border rounded-lg p-4 flex justify-between items-center">
					<div>
						<p class="text-sm font-medium">{ collab.Username }</p>
						<p class="text-xs text-muted-foreground capitalize">{ string(collab.Role) }</p>
					</div>
					if data.CanManage {
						<button
							hx-delete={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/collaborators?user_id=" + strconv.FormatInt(collab.UserID, 10) }
							hx-target="#repo-collaborators"
							hx-swap="outerHTML"
							hx-confirm="Remove this collaborator?"
							class="text-xs text-destructive hover:underline ml-4"
						>
							Remove
						</button>
					}
				</div>
			}
		} else {
			<p class="text-muted-foreground text-sm">No collaborators yet.</p>
		}
	</div>
}
