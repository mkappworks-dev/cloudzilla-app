package fragments

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/timefmt"
)

templ Comments(data view.CommentsFragData) {
	for _, c := range data.Comments {
		<div class="bg-background border border-border rounded-lg p-4">
			<div class="font-semibold text-sm text-foreground">{ c.AuthorName }</div>
			<div class="text-xs text-muted-foreground mb-2">{ timefmt.DateTime(c.CreatedAt) }</div>
			<div class="prose prose-sm max-w-none text-foreground">@templ.Raw(c.BodyHTML)</div>
		</div>
	}
}
