package fragments

import (
	"strconv"
	"strings"

	"github.com/mkappworks/cloudzilla/internal/view"
)

templ BranchProtections(data view.BranchProtectionsFragData) {
	<div id="branch-protections">
		if len(data.Rules) > 0 {
			<table class="w-full text-sm">
				<thead>
					<tr class="text-left text-gray-500 border-b border-gray-200">
						<th class="pb-2 font-medium">Pattern</th>
						<th class="pb-2 font-medium">Required Reviews</th>
						<th class="pb-2 font-medium">Status Checks</th>
						<th class="pb-2 font-medium">Block Force Push</th>
						<th class="pb-2"></th>
					</tr>
				</thead>
				<tbody class="divide-y divide-gray-100">
					for _, rule := range data.Rules {
						<tr>
							<td class="py-3 font-mono text-sm text-gray-900">{ rule.Pattern }</td>
							<td class="py-3 text-gray-700">{ strconv.Itoa(rule.RequireReviewCount) }</td>
							<td class="py-3 text-gray-500 text-xs">
								if len(rule.RequireStatusChecks) > 0 {
									{ strings.Join(rule.RequireStatusChecks, ", ") }
								} else {
									—
								}
							</td>
							<td class="py-3">
								if rule.BlockForcePush {
									<span class="inline-block bg-red-100 text-red-700 text-xs px-2 py-0.5 rounded">Blocked</span>
								} else {
									<span class="inline-block bg-gray-100 text-gray-500 text-xs px-2 py-0.5 rounded">Allowed</span>
								}
							</td>
							<td class="py-3">
								if data.CanManage {
									<button
										hx-delete={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/branches/protections/" + strconv.FormatInt(rule.ID, 10) }
										hx-target="#branch-protections"
										hx-swap="outerHTML"
										hx-confirm="Delete this branch protection rule?"
										class="px-3 py-1 text-red-600 border border-red-200 rounded hover:bg-red-50 transition-colors text-xs"
									>
										Delete
									</button>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		} else {
			<div class="text-center py-6 border border-gray-200 border-dashed rounded-lg bg-gray-50">
				<p class="text-gray-500 text-sm">No branch protection rules yet.</p>
			</div>
		}
	</div>
}
