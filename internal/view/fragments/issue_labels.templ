package fragments

import (
	"strconv"

	"github.com/mkappworks/cloudzilla/internal/view"
)

templ IssueLabels(data view.IssueLabelSidebarData) {
	<div id="issue-labels" class="space-y-2">
		<h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Labels</h3>
		<div class="flex flex-wrap gap-1">
			if len(data.Labels) == 0 {
				<span class="text-xs text-gray-400">None yet</span>
			} else {
				for _, lbl := range data.Labels {
					<span
						class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium"
						style={ "background-color: " + lbl.Color + "; color: #000" }
					>
						{ lbl.Name }
						if data.CanWrite {
							<button
								hx-delete={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.IssueNumber) + "/labels/" + strconv.FormatInt(lbl.ID, 10) }
								hx-target="#issue-labels"
								hx-swap="outerHTML"
								class="ml-0.5 hover:opacity-70 font-bold leading-none"
								title="Remove label"
							>&times;</button>
						}
					</span>
				}
			}
		</div>
		if data.CanWrite && len(data.AllLabels) > 0 {
			<details class="mt-2">
				<summary class="text-xs text-blue-600 cursor-pointer hover:underline">Add label</summary>
				<div class="mt-1 space-y-1 max-h-40 overflow-y-auto">
					for _, lbl := range data.AllLabels {
						<button
							hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.IssueNumber) + "/labels/" + strconv.FormatInt(lbl.ID, 10) }
							hx-target="#issue-labels"
							hx-swap="outerHTML"
							class="w-full text-left flex items-center gap-2 px-2 py-1 hover:bg-gray-50 rounded text-xs"
						>
							<span class="w-3 h-3 rounded-full inline-block shrink-0" style={ "background-color: " + lbl.Color }></span>
							{ lbl.Name }
						</button>
					}
				</div>
			</details>
		}
	</div>
}
