package fragments

import "github.com/mkappworks-dev/cloudzilla-app/internal/view"

templ BranchesList(data view.BranchesFragData) {
	<div id="branches-list">
		if len(data.Branches) > 0 {
			for _, branch := range data.Branches {
				<div class="flex items-center justify-between px-4 py-3 hover:bg-muted/40 border-b border-border last:border-b-0">
					<div class="flex items-center gap-2 min-w-0">
						<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/tree/" + branch.Name) } class="font-mono text-sm text-foreground hover:underline truncate">{ branch.Name }</a>
						if branch.IsDefault {
							<span class="text-xs bg-success/10 text-success px-2 py-0.5 rounded shrink-0">default</span>
						}
						<span class="text-xs text-muted-foreground font-mono shrink-0">{ branch.Hash }</span>
					</div>
					<div class="flex items-center gap-3 ml-4 shrink-0">
						<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/commits/" + branch.Name) } class="text-xs text-muted-foreground hover:text-foreground">commits</a>
						if data.CanWrite && !branch.IsDefault {
							<button
								hx-delete={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/branches?name=" + branch.Name }
								hx-target="#branches-list"
								hx-swap="outerHTML"
								hx-confirm={ "Delete branch '" + branch.Name + "'?" }
								class="text-xs text-destructive hover:text-destructive border border-destructive/40 px-2 py-1 rounded hover:bg-destructive/10"
							>Delete</button>
						}
					</div>
				</div>
			}
		} else {
			<div class="px-4 py-8 text-center text-muted-foreground text-sm">No branches yet.</div>
		}
	</div>
}

templ TagsList(data view.TagsFragData) {
	<div id="tags-list">
		if len(data.Tags) > 0 {
			for _, tag := range data.Tags {
				<div class="flex items-center justify-between px-4 py-3 hover:bg-muted/40 border-b border-border last:border-b-0">
					<div class="flex items-center gap-2 min-w-0">
						<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/tree/" + tag.Name) } class="font-mono text-sm text-foreground hover:underline truncate">{ tag.Name }</a>
						<span class="text-xs text-muted-foreground font-mono shrink-0">{ tag.Hash }</span>
					</div>
					<div class="flex items-center gap-3 ml-4 shrink-0">
						<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/commits/" + tag.Name) } class="text-xs text-muted-foreground hover:text-foreground">commits</a>
						if data.CanWrite {
							<button
								hx-delete={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/tags?name=" + tag.Name }
								hx-target="#tags-list"
								hx-swap="outerHTML"
								hx-confirm={ "Delete tag '" + tag.Name + "'?" }
								class="text-xs text-destructive hover:text-destructive border border-destructive/40 px-2 py-1 rounded hover:bg-destructive/10"
							>Delete</button>
						}
					</div>
				</div>
			}
		} else {
			<div class="px-4 py-8 text-center text-muted-foreground text-sm">No tags yet.</div>
		}
	</div>
}
