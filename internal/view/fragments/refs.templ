package fragments

import (
	"net/url"

	"github.com/mkappworks-dev/cloudzilla-app/internal/codeurl"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
)

templ BranchesList(data view.BranchesFragData) {
	<div id="branches-list">
		if len(data.Branches) > 0 {
			for _, b := range data.Branches {
				<div class="flex items-center justify-between px-4 py-3 hover:bg-muted/50 border-b border-border last:border-b-0">
					<div class="flex items-center gap-2 min-w-0">
						<a href={ templ.SafeURL(codeurl.Path(data.Owner, data.RepoName, "tree", b.Name, "")) } class="font-mono text-sm text-foreground hover:underline truncate">{ b.Name }</a>
						if b.IsDefault {
							<span class="shrink-0">
								@components.Badge(components.BadgeSuccess) {
									default
								}
							</span>
						}
						<span class="text-xs text-muted-foreground font-mono shrink-0">{ b.Hash }</span>
					</div>
					<div class="flex items-center gap-3 ml-4 shrink-0">
						<a href={ templ.SafeURL(codeurl.Path(data.Owner, data.RepoName, "commits", b.Name, "")) } class="text-xs text-muted-foreground hover:text-foreground">commits</a>
						if data.CanWrite && !b.IsDefault {
							@components.Button(components.ButtonDestructiveGhost, components.ButtonSizeIcon, templ.Attributes{
								"hx-delete":           "/api/repos/" + data.Owner + "/" + data.RepoName + "/branches?name=" + url.QueryEscape(b.Name),
								"hx-target":           "#branches-list",
								"hx-swap":             "outerHTML",
								"hx-confirm":          "The " + b.Name + " branch will be deleted.",
								"data-confirm-title":  "Delete this branch?",
								"data-confirm-label":  "Delete",
								"data-confirm-danger": "true",
								"data-toast":          "Branch deleted",
								"type":                "button",
								"aria-label":          "Delete branch " + b.Name,
								"title":               "Delete branch",
							}) {
								@components.TrashIcon()
							}
						}
					</div>
				</div>
			}
		} else {
			<div class="px-4 py-8 text-center text-muted-foreground text-sm">No branches yet.</div>
		}
	</div>
}

templ TagsList(data view.TagsFragData) {
	<div id="tags-list">
		if len(data.Tags) > 0 {
			for _, t := range data.Tags {
				<div class="flex items-center justify-between px-4 py-3 hover:bg-muted/50 border-b border-border last:border-b-0">
					<div class="flex items-center gap-2 min-w-0">
						<a href={ templ.SafeURL(codeurl.Path(data.Owner, data.RepoName, "tree", t.Name, "")) } class="font-mono text-sm text-foreground hover:underline truncate">{ t.Name }</a>
						<span class="text-xs text-muted-foreground font-mono shrink-0">{ t.Hash }</span>
					</div>
					<div class="flex items-center gap-3 ml-4 shrink-0">
						<a href={ templ.SafeURL(codeurl.Path(data.Owner, data.RepoName, "commits", t.Name, "")) } class="text-xs text-muted-foreground hover:text-foreground">commits</a>
						if data.CanWrite {
							@components.Button(components.ButtonDestructiveGhost, components.ButtonSizeIcon, templ.Attributes{
								"hx-delete":           "/api/repos/" + data.Owner + "/" + data.RepoName + "/tags?name=" + url.QueryEscape(t.Name),
								"hx-target":           "#tags-list",
								"hx-swap":             "outerHTML",
								"hx-confirm":          "The " + t.Name + " tag will be deleted.",
								"data-confirm-title":  "Delete this tag?",
								"data-confirm-label":  "Delete",
								"data-confirm-danger": "true",
								"data-toast":          "Tag deleted",
								"type":                "button",
								"aria-label":          "Delete tag " + t.Name,
								"title":               "Delete tag",
							}) {
								@components.TrashIcon()
							}
						}
					</div>
				</div>
			}
		} else {
			<div class="px-4 py-8 text-center text-muted-foreground text-sm">No tags yet.</div>
		}
	</div>
}
