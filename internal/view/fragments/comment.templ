package fragments

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
)

templ Comment(data view.CommentFragData) {
	@components.TimelineEntry(components.TimelineEntryComment, data.Comment.AuthorName, data.Comment.CreatedAt.Format("Jan 2, 2006 at 3:04 PM")) {
		<div class="rounded-md border border-border bg-card overflow-hidden">
			<header class="px-4 py-2 border-b border-border bg-muted/40 flex items-center gap-2 text-xs text-muted-foreground">
				<time>{ data.Comment.CreatedAt.Format("Jan 2, 2006 at 3:04 PM") }</time>
			</header>
			<div class="px-4 py-3">
				@templ.Raw(data.Comment.BodyHTML)
			</div>
		</div>
	}
}
