package fragments

import "github.com/mkappworks-dev/cloudzilla-app/internal/view"

templ Comment(data view.CommentFragData) {
	<div class="bg-background border border-border rounded-lg p-4">
		<div class="font-semibold text-sm text-foreground">{ data.Comment.AuthorName }</div>
		<div class="text-xs text-muted-foreground mb-2">{ data.Comment.CreatedAt.Format("Jan 2, 2006 at 3:04 PM") }</div>
		<div class="prose prose-sm max-w-none text-foreground">@templ.Raw(data.Comment.BodyHTML)</div>
	</div>
}
