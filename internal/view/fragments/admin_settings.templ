package fragments

import (
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
)

templ AdminSettings(data view.AdminSettingsFragData) {
	<div id="admin-settings-list" class="space-y-3">
		if len(data.Settings) > 0 {
			for _, setting := range data.Settings {
				<form
					hx-post="/api/admin/settings"
					hx-target="#admin-settings-list"
					hx-swap="outerHTML"
					hx-on::after:request="if(event.target===this&&ctx.response.status>=400){this.reset();}"
					data-toast="Setting updated"
					data-confirm-identity={ settingToggleLabel(setting.Value) }
					data-confirm-reset
					class="flex items-center justify-between py-3 border-b border-border last:border-0"
				>
					<input type="hidden" name="key" value={ setting.Key }/>
					<input type="hidden" name="value" value={ settingNextValue(setting.Value) }/>
					<label class="flex flex-1 items-center justify-between gap-4 cursor-pointer">
						<span class="text-sm font-medium text-foreground">{ setting.Key }</span>
						@components.Switch(templ.Attributes{
							"id":       "setting-" + setting.Key,
							"checked":  setting.Value == "true",
							"onchange": "this.form.requestSubmit()",
						})
					</label>
				</form>
			}
		} else {
			<p class="text-sm text-muted-foreground">No settings found.</p>
		}
	</div>
}

func settingNextValue(current string) string {
	if current == "true" {
		return "false"
	}
	return "true"
}

func settingToggleLabel(current string) string {
	if current == "true" {
		return "Turn off"
	}
	return "Turn on"
}
