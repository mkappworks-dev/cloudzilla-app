package fragments

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
)

// milestoneKindPath maps the IsPull flag to the API path segment.
func milestoneKindPath(isPull bool) string {
	if isPull {
		return "pulls"
	}
	return "issues"
}

// milestoneEditIcon is the pencil affordance in the Milestone section header.
templ milestoneEditIcon() {
	<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 113 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
}

// milestoneCheckIcon marks the currently-set milestone in the picker.
templ milestoneCheckIcon() {
	<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="shrink-0 text-success" aria-hidden="true" focusable="false"><polyline points="20 6 9 17 4 12"></polyline></svg>
}

// milestoneFlagIcon leads the "new milestone" footer action.
templ milestoneFlagIcon() {
	<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="shrink-0" aria-hidden="true" focusable="false"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path><line x1="4" y1="22" x2="4" y2="15"></line></svg>
}

// MilestoneSidebar renders the milestone metadata panel for an issue or pull
// request. The picker is an Alpine dropdown driven by an `open` variable that
// MUST be provided by an ancestor x-data scope (the detail page's <aside>) so
// the menu survives the HTMX re-render after a selection.
templ MilestoneSidebar(data view.MilestoneSidebarFragData) {
	{{ postURL := "/api/repos/" + data.Owner + "/" + data.RepoName + "/" + milestoneKindPath(data.IsPull) + "/" + strconv.Itoa(data.ItemNumber) + "/milestone" }}
	<div id="issue-milestone" class="space-y-2">
		<div class="flex items-center justify-between">
			<h3 class="text-[12px] font-medium text-muted-foreground">Milestone</h3>
			if data.CanWrite && len(data.AllMilestones) > 0 {
				<div class="relative" x-on:click.outside="open === 'milestone' && (open = null)">
					<button
						type="button"
						x-on:click="open = (open === 'milestone' ? null : 'milestone')"
						:aria-expanded="open === 'milestone' ? 'true' : 'false'"
						aria-haspopup="menu"
						aria-label="Set milestone"
						class="text-muted-foreground hover:text-foreground"
					>
						@milestoneEditIcon()
					</button>
					<div
						x-show="open === 'milestone'"
						x-cloak
						x-transition.opacity.duration.100ms
						role="menu"
						aria-label="Set milestone"
						class="absolute right-0 top-full mt-1.5 z-50 w-56 rounded-md border border-border bg-popover text-popover-foreground shadow-md p-1 max-h-72 overflow-y-auto"
					>
						<div class="px-2 pt-1 pb-0.5 text-[10px] font-medium uppercase tracking-wider text-muted-foreground">Set milestone</div>
						for _, m := range data.AllMilestones {
							{{ current := data.Current != nil && data.Current.ID == m.ID }}
							<form hx-post={ postURL } hx-target="#issue-milestone" hx-swap="outerHTML">
								<button
									type="submit"
									name="milestone_id"
									value={ strconv.FormatInt(m.ID, 10) }
									role="menuitemradio"
									aria-checked={ strconv.FormatBool(current) }
									class="flex w-full items-center gap-2 px-2.5 py-1.5 rounded-md text-left text-[13px] text-muted-foreground hover:bg-accent hover:text-foreground"
								>
									<span class={ "h-2 w-2 rounded-full inline-block shrink-0", templ.KV("bg-muted-foreground", m.State == "closed"), templ.KV("bg-success", m.State != "closed") }></span>
									<span class="flex-1 truncate">{ m.Title }</span>
									if current {
										@milestoneCheckIcon()
									}
								</button>
							</form>
						}
						<div role="separator" class="my-1 h-px bg-border"></div>
						<form hx-post={ postURL } hx-target="#issue-milestone" hx-swap="outerHTML">
							<button
								type="submit"
								name="milestone_id"
								value=""
								role="menuitem"
								class="flex w-full items-center px-2.5 py-1.5 rounded-md text-left text-[13px] text-muted-foreground hover:bg-accent hover:text-foreground"
							>
								Clear milestone
							</button>
						</form>
						<a
							href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/milestones/new") }
							role="menuitem"
							class="flex w-full items-center gap-2 px-2.5 py-1.5 rounded-md text-left text-[13px] text-muted-foreground hover:bg-accent hover:text-foreground"
						>
							@milestoneFlagIcon()
							New milestone
						</a>
					</div>
				</div>
			}
		</div>
		if data.Current != nil {
			<div class="text-sm">
				<a href={ templ.SafeURL("/" + data.Owner + "/" + data.RepoName + "/milestones") } class="font-medium text-foreground hover:underline">{ data.Current.Title }</a>
				if data.Current.OpenCount+data.Current.ClosedCount > 0 {
					@components.ProgressBarSmall(data.Current.ClosedCount, data.Current.OpenCount+data.Current.ClosedCount)
				}
			</div>
		} else {
			<span class="text-xs text-muted-foreground">No milestone</span>
		}
	</div>
}
