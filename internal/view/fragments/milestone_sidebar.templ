package fragments

import (
	"strconv"

	"github.com/mkappworks/cloudzilla/internal/view"
)

templ MilestonesList(data view.MilestonesListFragData) {
	<div id="milestones-list" class="space-y-4">
		if len(data.OpenMilestones) == 0 && len(data.ClosedMilestones) == 0 {
			<div class="text-center py-12 text-gray-400">
				<p class="text-sm">No milestones yet.</p>
				if data.CanWrite {
					<p class="text-xs mt-1">Create one to start tracking progress.</p>
				}
			</div>
		} else {
			if len(data.OpenMilestones) > 0 {
				<div>
					<h2 class="text-sm font-semibold text-gray-700 mb-2">Open ({ strconv.Itoa(len(data.OpenMilestones)) })</h2>
					<div class="space-y-3">
						for _, m := range data.OpenMilestones {
							<div class="bg-white border border-gray-200 rounded-lg p-4">
								<div class="flex items-start justify-between gap-2">
									<div class="flex-1 min-w-0">
										<h3 class="font-semibold text-gray-900">{ m.Title }</h3>
										if m.Description != "" {
											<p class="text-sm text-gray-500 mt-0.5 truncate">{ m.Description }</p>
										}
										if m.DueDate != nil {
											<p class="text-xs text-gray-400 mt-1">Due { m.DueDate.Format("Jan 2, 2006") }</p>
										}
										if m.OpenCount+m.ClosedCount > 0 {
											<div class="mt-2">
												<div class="flex items-center gap-2 text-xs text-gray-500 mb-1">
													<span>{ strconv.Itoa(m.ClosedCount) } / { strconv.Itoa(m.OpenCount + m.ClosedCount) } issues closed</span>
												</div>
												<div class="w-full bg-gray-200 rounded-full h-1.5">
													<div class="bg-green-500 h-1.5 rounded-full" style={ "width: " + strconv.Itoa(view.Percent(m.ClosedCount, m.OpenCount+m.ClosedCount)) + "%" }></div>
												</div>
											</div>
										} else {
											<p class="text-xs text-gray-400 mt-1">No issues assigned</p>
										}
									</div>
									if data.CanWrite {
										<div class="flex gap-2 shrink-0">
											<button hx-patch={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/milestones/" + strconv.Itoa(m.Number) } hx-vals={ `{"state":"closed"}` } hx-target="#milestones-list" hx-swap="outerHTML" class="text-xs text-gray-500 hover:text-gray-700">
												Close
											</button>
											<button hx-delete={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/milestones/" + strconv.Itoa(m.Number) } hx-target="#milestones-list" hx-swap="outerHTML" hx-confirm="Delete this milestone?" class="text-xs text-red-500 hover:text-red-700">
												Delete
											</button>
										</div>
									}
								</div>
							</div>
						}
					</div>
				</div>
			}
			if len(data.ClosedMilestones) > 0 {
				<div>
					<h2 class="text-sm font-semibold text-gray-700 mb-2">Closed ({ strconv.Itoa(len(data.ClosedMilestones)) })</h2>
					<div class="space-y-3">
						for _, m := range data.ClosedMilestones {
							<div class="bg-white border border-gray-200 rounded-lg p-4 opacity-70">
								<div class="flex items-start justify-between gap-2">
									<div class="flex-1 min-w-0">
										<h3 class="font-semibold text-gray-900 line-through">{ m.Title }</h3>
										if m.Description != "" {
											<p class="text-sm text-gray-500 mt-0.5 truncate">{ m.Description }</p>
										}
										if m.ClosedAt != nil {
											<p class="text-xs text-gray-400 mt-1">Closed { m.ClosedAt.Format("Jan 2, 2006") }</p>
										}
										if m.OpenCount+m.ClosedCount > 0 {
											<div class="mt-2">
												<div class="w-full bg-gray-200 rounded-full h-1.5">
													<div class="bg-green-500 h-1.5 rounded-full" style={ "width: " + strconv.Itoa(view.Percent(m.ClosedCount, m.OpenCount+m.ClosedCount)) + "%" }></div>
												</div>
											</div>
										}
									</div>
									if data.CanWrite {
										<div class="flex gap-2 shrink-0">
											<button hx-patch={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/milestones/" + strconv.Itoa(m.Number) } hx-vals={ `{"state":"open"}` } hx-target="#milestones-list" hx-swap="outerHTML" class="text-xs text-blue-500 hover:text-blue-700">
												Reopen
											</button>
											<button hx-delete={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/milestones/" + strconv.Itoa(m.Number) } hx-target="#milestones-list" hx-swap="outerHTML" hx-confirm="Delete this milestone?" class="text-xs text-red-500 hover:text-red-700">
												Delete
											</button>
										</div>
									}
								</div>
							</div>
						}
					</div>
				</div>
			}
		}
	</div>
}

templ MilestoneSidebar(data view.MilestoneSidebarFragData) {
	<div id="issue-milestone" class="bg-white border border-gray-200 rounded-lg p-4">
		<h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Milestone</h3>
		if data.Current != nil {
			<div class="text-sm">
				<span class="font-medium text-gray-800">{ data.Current.Title }</span>
				if data.Current.OpenCount+data.Current.ClosedCount > 0 {
					<div class="mt-1">
						<div class="w-full bg-gray-200 rounded-full h-1">
							<div class="bg-green-500 h-1 rounded-full" style={ "width: " + strconv.Itoa(view.Percent(data.Current.ClosedCount, data.Current.OpenCount+data.Current.ClosedCount)) + "%" }></div>
						</div>
						<p class="text-xs text-gray-400 mt-0.5">{ strconv.Itoa(data.Current.ClosedCount) }/{ strconv.Itoa(data.Current.OpenCount + data.Current.ClosedCount) } closed</p>
					</div>
				}
			</div>
		} else {
			<span class="text-xs text-gray-400">No milestone</span>
		}
		if data.CanWrite && len(data.AllMilestones) > 0 {
			<details class="mt-2">
				<summary class="text-xs text-blue-600 cursor-pointer hover:underline">
					if data.Current != nil {
						Change
					} else {
						Set milestone
					}
				</summary>
				<div class="mt-1 space-y-1 max-h-40 overflow-y-auto border border-gray-100 rounded">
					if data.IsPull {
						<form hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/pulls/" + strconv.Itoa(data.ItemNumber) + "/milestone" } hx-target="#issue-milestone" hx-swap="outerHTML" class="p-1">
							<button type="submit" name="milestone_id" value="" class="w-full text-left px-2 py-1 hover:bg-gray-50 text-xs text-gray-500">
								No milestone
							</button>
							for _, m := range data.AllMilestones {
								<button type="submit" name="milestone_id" value={ strconv.FormatInt(m.ID, 10) } class={ "w-full text-left flex items-center gap-2 px-2 py-1 hover:bg-gray-50 text-xs", templ.KV("font-semibold text-blue-600", data.Current != nil && data.Current.ID == m.ID) }>
									<span class={ "w-2 h-2 rounded-full inline-block shrink-0", templ.KV("bg-gray-400", m.State == "closed"), templ.KV("bg-green-500", m.State != "closed") }></span>
									{ m.Title }
								</button>
							}
						</form>
					} else {
						<form hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.ItemNumber) + "/milestone" } hx-target="#issue-milestone" hx-swap="outerHTML" class="p-1">
							<button type="submit" name="milestone_id" value="" class="w-full text-left px-2 py-1 hover:bg-gray-50 text-xs text-gray-500">
								No milestone
							</button>
							for _, m := range data.AllMilestones {
								<button type="submit" name="milestone_id" value={ strconv.FormatInt(m.ID, 10) } class={ "w-full text-left flex items-center gap-2 px-2 py-1 hover:bg-gray-50 text-xs", templ.KV("font-semibold text-blue-600", data.Current != nil && data.Current.ID == m.ID) }>
									<span class={ "w-2 h-2 rounded-full inline-block shrink-0", templ.KV("bg-gray-400", m.State == "closed"), templ.KV("bg-green-500", m.State != "closed") }></span>
									{ m.Title }
								</button>
							}
						</form>
					}
				</div>
			</details>
		}
	</div>
}
