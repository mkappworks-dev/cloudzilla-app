package fragments

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
)

templ MilestonesList(data view.MilestonesListFragData) {
	<div id="milestones-list" class="space-y-4">
		if len(data.OpenMilestones) == 0 && len(data.ClosedMilestones) == 0 {
			<div class="text-center py-12 text-muted-foreground">
				<p class="text-sm">No milestones yet.</p>
				if data.CanWrite {
					<p class="text-xs mt-1">Create one to start tracking progress.</p>
				}
			</div>
		} else {
			if len(data.OpenMilestones) > 0 {
				<div>
					<h2 class="text-sm font-semibold text-foreground mb-2">Open ({ strconv.Itoa(len(data.OpenMilestones)) })</h2>
					<div class="space-y-3">
						for _, m := range data.OpenMilestones {
							<div class="bg-background border border-border rounded-lg p-4">
								<div class="flex items-start justify-between gap-2">
									<div class="flex-1 min-w-0">
										<h3 class="font-semibold text-foreground">{ m.Title }</h3>
										if m.Description != "" {
											<p class="text-sm text-muted-foreground mt-0.5 truncate">{ m.Description }</p>
										}
										if m.DueDate != nil {
											<p class="text-xs text-muted-foreground mt-1">Due { m.DueDate.Format("Jan 2, 2006") }</p>
										}
										if m.OpenCount+m.ClosedCount > 0 {
											@components.ProgressBar(m.ClosedCount, m.OpenCount+m.ClosedCount)
										} else {
											<p class="text-xs text-muted-foreground mt-1">No issues assigned</p>
										}
									</div>
									if data.CanWrite {
										<div class="flex gap-2 shrink-0">
											<button hx-patch={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/milestones/" + strconv.Itoa(m.Number) } hx-vals={ `{"state":"closed"}` } hx-target="#milestones-list" hx-swap="outerHTML" class="text-xs text-muted-foreground hover:text-foreground">
												Close
											</button>
											<button hx-delete={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/milestones/" + strconv.Itoa(m.Number) } hx-target="#milestones-list" hx-swap="outerHTML" hx-confirm="Delete this milestone?" class="text-xs text-destructive hover:text-destructive">
												Delete
											</button>
										</div>
									}
								</div>
							</div>
						}
					</div>
				</div>
			}
			if len(data.ClosedMilestones) > 0 {
				<div>
					<h2 class="text-sm font-semibold text-foreground mb-2">Closed ({ strconv.Itoa(len(data.ClosedMilestones)) })</h2>
					<div class="space-y-3">
						for _, m := range data.ClosedMilestones {
							<div class="bg-background border border-border rounded-lg p-4 opacity-70">
								<div class="flex items-start justify-between gap-2">
									<div class="flex-1 min-w-0">
										<h3 class="font-semibold text-foreground line-through">{ m.Title }</h3>
										if m.Description != "" {
											<p class="text-sm text-muted-foreground mt-0.5 truncate">{ m.Description }</p>
										}
										if m.ClosedAt != nil {
											<p class="text-xs text-muted-foreground mt-1">Closed { m.ClosedAt.Format("Jan 2, 2006") }</p>
										}
										if m.OpenCount+m.ClosedCount > 0 {
											@components.ProgressBar(m.ClosedCount, m.OpenCount+m.ClosedCount)
										}
									</div>
									if data.CanWrite {
										<div class="flex gap-2 shrink-0">
											<button hx-patch={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/milestones/" + strconv.Itoa(m.Number) } hx-vals={ `{"state":"open"}` } hx-target="#milestones-list" hx-swap="outerHTML" class="text-xs text-foreground hover:text-foreground">
												Reopen
											</button>
											<button hx-delete={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/milestones/" + strconv.Itoa(m.Number) } hx-target="#milestones-list" hx-swap="outerHTML" hx-confirm="Delete this milestone?" class="text-xs text-destructive hover:text-destructive">
												Delete
											</button>
										</div>
									}
								</div>
							</div>
						}
					</div>
				</div>
			}
		}
	</div>
}

templ MilestoneSidebar(data view.MilestoneSidebarFragData) {
	<div id="issue-milestone" class="bg-background border border-border rounded-lg p-4">
		<h3 class="text-xs font-semibold text-muted-foreground uppercase tracking-wide mb-2">Milestone</h3>
		if data.Current != nil {
			<div class="text-sm">
				<span class="font-medium text-foreground">{ data.Current.Title }</span>
				if data.Current.OpenCount+data.Current.ClosedCount > 0 {
					@components.ProgressBarSmall(data.Current.ClosedCount, data.Current.OpenCount+data.Current.ClosedCount)
				}
			</div>
		} else {
			<span class="text-xs text-muted-foreground">No milestone</span>
		}
		if data.CanWrite && len(data.AllMilestones) > 0 {
			<details class="mt-2">
				<summary class="text-xs text-foreground cursor-pointer hover:underline">
					if data.Current != nil {
						Change
					} else {
						Set milestone
					}
				</summary>
				<div class="mt-1 space-y-1 max-h-40 overflow-y-auto border border-border rounded">
					if data.IsPull {
						<form hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/pulls/" + strconv.Itoa(data.ItemNumber) + "/milestone" } hx-target="#issue-milestone" hx-swap="outerHTML" class="p-1">
							<button type="submit" name="milestone_id" value="" class="w-full text-left px-2 py-1 hover:bg-muted/40 text-xs text-muted-foreground">
								No milestone
							</button>
							for _, m := range data.AllMilestones {
								<button type="submit" name="milestone_id" value={ strconv.FormatInt(m.ID, 10) } class={ "w-full text-left flex items-center gap-2 px-2 py-1 hover:bg-muted/40 text-xs", templ.KV("font-semibold text-foreground", data.Current != nil && data.Current.ID == m.ID) }>
									<span class={ "w-2 h-2 rounded-full inline-block shrink-0", templ.KV("bg-muted", m.State == "closed"), templ.KV("bg-success", m.State != "closed") }></span>
									{ m.Title }
								</button>
							}
						</form>
					} else {
						<form hx-post={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/issues/" + strconv.Itoa(data.ItemNumber) + "/milestone" } hx-target="#issue-milestone" hx-swap="outerHTML" class="p-1">
							<button type="submit" name="milestone_id" value="" class="w-full text-left px-2 py-1 hover:bg-muted/40 text-xs text-muted-foreground">
								No milestone
							</button>
							for _, m := range data.AllMilestones {
								<button type="submit" name="milestone_id" value={ strconv.FormatInt(m.ID, 10) } class={ "w-full text-left flex items-center gap-2 px-2 py-1 hover:bg-muted/40 text-xs", templ.KV("font-semibold text-foreground", data.Current != nil && data.Current.ID == m.ID) }>
									<span class={ "w-2 h-2 rounded-full inline-block shrink-0", templ.KV("bg-muted", m.State == "closed"), templ.KV("bg-success", m.State != "closed") }></span>
									{ m.Title }
								</button>
							}
						</form>
					}
				</div>
			</details>
		}
	</div>
}
