package fragments

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
)

templ ReleaseTitleSection(owner, repoName string, id int64, name, tagName, status string, canWrite, editing bool) {
	{{ base := "/api/repos/" + owner + "/" + repoName + "/releases/" + strconv.FormatInt(id, 10) + "/title" }}
	<div id="release-title-section" class="flex flex-wrap items-center gap-2">
		if editing {
			<form
				hx-patch={ base }
				hx-target="#release-title-section"
				hx-swap="outerHTML"
				class="flex flex-1 items-center gap-2 min-w-0"
			>
				<input
					type="text"
					name="name"
					value={ name }
					autofocus
					placeholder={ tagName }
					aria-label="Release title"
					class="flex-1 min-w-0 h-9 px-3 rounded-md border border-input bg-background text-lg font-medium focus:outline-none focus:ring-2 focus:ring-ring"
				/>
				<button type="submit" class="h-9 px-3 text-[13px] rounded-md font-medium bg-primary text-primary-foreground hover:bg-primary/90 shrink-0">Save</button>
				<button
					type="button"
					hx-get={ base }
					hx-target="#release-title-section"
					hx-swap="outerHTML"
					class="h-9 px-3 text-[13px] rounded-md border border-border hover:bg-muted shrink-0"
				>Cancel</button>
			</form>
		} else {
			<h1 class="text-2xl font-semibold tracking-tight">
				if name != "" {
					{ name }
				} else {
					{ tagName }
				}
			</h1>
			<code class="font-mono px-2 py-0.5 border border-border bg-muted rounded text-[12px]">{ tagName }</code>
			switch status {
				case "latest":
					@components.Badge(components.BadgeSuccess) {
						Latest
					}
				case "prerelease":
					@components.Badge(components.BadgeWarning) {
						Pre-release
					}
				case "draft":
					@components.Badge(components.BadgeDraft) {
						Draft
					}
			}
			if canWrite {
				<button
					type="button"
					hx-get={ base + "?mode=edit" }
					hx-target="#release-title-section"
					hx-swap="outerHTML"
					class="ml-auto h-8 px-3 text-[13px] rounded-md border border-border hover:bg-muted inline-flex items-center shrink-0"
				>Edit</button>
			}
		}
	</div>
}

templ ReleaseBodyCard(data view.ReleaseBodyCardData) {
	{{ base := "/api/repos/" + data.Owner + "/" + data.RepoName + "/releases/" + strconv.FormatInt(data.ReleaseID, 10) + "/body" }}
	<section id="release-body-card" class="rounded-md border border-border bg-card overflow-hidden" aria-labelledby="rel-notes-heading">
		<header class="px-5 py-3 border-b border-border bg-muted/50 flex items-center gap-2">
			<h2 id="rel-notes-heading" class="text-[13px] font-medium">Release notes</h2>
			if data.CanWrite && !data.Editing {
				<button
					type="button"
					hx-get={ base + "?mode=edit" }
					hx-target="#release-body-card"
					hx-swap="outerHTML"
					class="ml-auto inline-flex items-center gap-1 h-7 px-2 rounded-md border border-border hover:bg-muted text-[12px] text-muted-foreground"
				>
					@metaEditIcon()
					Edit
				</button>
			}
		</header>
		if data.Editing {
			<form hx-patch={ base } hx-target="#release-body-card" hx-swap="outerHTML" class="px-5 py-4" x-data="{ tab: 'write', wrap(b, a) { const t = $refs.body, s = t.selectionStart, e = t.selectionEnd; t.setRangeText(b + t.value.slice(s, e) + a, s, e, 'end'); t.focus(); } }">
				<label for="release-body-textarea" class="sr-only">Release notes</label>
				<div class="border border-border rounded-md bg-card overflow-hidden">
					<header class="px-3 border-b border-border bg-background flex items-center gap-3">
						<div role="tablist" aria-label="Release notes editor mode" class="flex">
							<button
								type="button"
								role="tab"
								x-on:click="tab = 'write'"
								:aria-selected="tab === 'write' ? 'true' : 'false'"
								class="px-3 py-2.5 border-b -mb-px text-[13px]"
								:class="tab === 'write' ? 'border-foreground text-foreground font-medium' : 'border-transparent text-muted-foreground hover:text-foreground'"
							>Write</button>
							<button
								type="button"
								role="tab"
								x-on:click="tab = 'preview'"
								:aria-selected="tab === 'preview' ? 'true' : 'false'"
								hx-post="/api/markdown/preview"
								hx-vals="js:{body: document.getElementById('release-body-textarea').value}"
								hx-target="#release-body-preview"
								hx-swap="innerHTML"
								class="px-3 py-2.5 border-b -mb-px text-[13px]"
								:class="tab === 'preview' ? 'border-foreground text-foreground font-medium' : 'border-transparent text-muted-foreground hover:text-foreground'"
							>Preview</button>
						</div>
						<div class="ml-auto flex items-center gap-1 text-muted-foreground" aria-label="Formatting toolbar">
							@mdToolbarButton("Bold", "wrap('**', '**')") {
								<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M6 4h8a4 4 0 014 4 4 4 0 01-4 4H6zM6 12h9a4 4 0 014 4 4 4 0 01-4 4H6z"></path></svg>
							}
							@mdToolbarButton("Italic", "wrap('*', '*')") {
								<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><line x1="19" y1="4" x2="10" y2="4"></line><line x1="14" y1="20" x2="5" y2="20"></line><line x1="15" y1="4" x2="9" y2="20"></line></svg>
							}
							@mdToolbarButton("Code", "wrap('`', '`')") {
								<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
							}
							@mdToolbarButton("Insert link", "wrap('[', '](url)')") {
								<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M10 13a5 5 0 007.07 0l3-3a5 5 0 00-7.07-7.07l-1 1"></path><path d="M14 11a5 5 0 00-7.07 0l-3 3a5 5 0 007.07 7.07l1-1"></path></svg>
							}
						</div>
					</header>
					<div role="tabpanel" x-show="tab === 'write'">
						<textarea
							id="release-body-textarea"
							x-ref="body"
							name="body"
							rows="14"
							placeholder="Release notes…"
							class="w-full p-3 h-[320px] text-sm font-mono bg-transparent resize-none placeholder:text-muted-foreground focus:outline-none"
						>{ data.Body }</textarea>
					</div>
					<div id="release-body-preview" role="tabpanel" x-show="tab === 'preview'" x-cloak class="prose prose-sm dark:prose-invert max-w-none p-4 h-[320px] overflow-y-auto">
						@templ.Raw(data.BodyHTML)
					</div>
				</div>
				<div class="flex justify-end gap-2 mt-3">
					<button
						type="button"
						hx-get={ base }
						hx-target="#release-body-card"
						hx-swap="outerHTML"
						class="h-8 px-3 text-[13px] rounded-md border border-border hover:bg-muted"
					>Cancel</button>
					<button type="submit" class="h-8 px-3 text-[13px] rounded-md font-medium bg-primary text-primary-foreground hover:bg-primary/90">Save</button>
				</div>
			</form>
		} else {
			if data.BodyHTML != "" {
				<div class="px-5 py-4 prose prose-sm dark:prose-invert max-w-none">
					@templ.Raw(data.BodyHTML)
				</div>
			} else {
				<p class="px-5 py-4 text-[13px] text-muted-foreground italic">No release notes.</p>
			}
		}
	</section>
}
