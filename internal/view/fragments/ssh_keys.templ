package fragments

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
)

templ SSHKeysList(data view.SSHKeysFragData) {
	<div id="ssh-keys-list" class="space-y-3">
		if len(data.SSHKeys) > 0 {
			for _, key := range data.SSHKeys {
				<div
					class="flex items-center justify-between p-4 border border-border rounded-lg hover:bg-muted/40 transition-colors"
					data-key-id={ strconv.FormatInt(key.ID, 10) }
				>
					<div class="flex-1">
						<h4 class="font-semibold text-foreground">{ key.Title }</h4>
						<p class="text-muted-foreground text-sm mt-1">{ key.Fingerprint }</p>
						<p class="text-muted-foreground text-xs mt-2">Added { key.CreatedAt.Format("Jan 2, 2006") }</p>
					</div>
					<button
						hx-delete={ "/api/user/keys/" + strconv.FormatInt(key.ID, 10) }
						hx-target="#ssh-keys-list"
						hx-swap="outerHTML"
						class="ml-4 px-3 py-2 text-destructive border border-destructive/40 rounded hover:bg-destructive/10 transition-colors text-sm"
					>
						Delete
					</button>
				</div>
			}
		} else {
			<div class="text-center py-8 border border-border border-dashed rounded-lg bg-muted/40">
				<p class="text-muted-foreground">No SSH keys yet. Add one above to get started.</p>
			</div>
		}
	</div>
}
