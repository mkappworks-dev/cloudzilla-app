package fragments

templ GistFileRow() {
	<div class="border border-border rounded p-4">
		<input type="text" name="filename[]" placeholder="Filename including extension" class="w-full border border-border rounded px-3 py-1 text-sm mb-2" required/>
		<textarea name="content[]" rows="8" class="w-full border border-border rounded px-3 py-1 text-sm font-mono" placeholder="File contents..."></textarea>
	</div>
}
