package fragments

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
)

script toggleEventsForm(id string) {
	document.getElementById(id).classList.toggle('hidden');
}

templ WebhooksList(data view.WebhooksFragData) {
	<div id="webhooks-list" class="space-y-2">
		if len(data.Webhooks) > 0 {
			for _, wh := range data.Webhooks {
				<div>
					<div class="rounded-md border border-border p-4 flex justify-between items-start">
						<div class="min-w-0 flex-1">
							<p class="font-medium text-sm font-mono break-all text-foreground">{ wh.URL }</p>
							<p class="text-xs text-muted-foreground mt-1">
								Events:
								<button
									type="button"
									onclick={ toggleEventsForm("events-form-" + strconv.FormatInt(wh.ID, 10)) }
									class="text-foreground hover:underline ml-1"
								>
									{ wh.Events } (edit)
								</button>
							</p>
							<div id={ "events-form-" + strconv.FormatInt(wh.ID, 10) } class="hidden mt-2">
								<form
									hx-patch={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/hooks/" + strconv.FormatInt(wh.ID, 10) }
									hx-target="#webhooks-list"
									hx-swap="outerHTML"
									data-toast="Webhook updated"
									class="space-y-1"
								>
									<label class="flex items-center gap-2 text-xs text-foreground">
										if hasEvent(wh.Events, "push") {
											<input type="checkbox" name="push" value="1" checked class="rounded border-input accent-foreground"/>
										} else {
											<input type="checkbox" name="push" value="1" class="rounded border-input accent-foreground"/>
										}
										push
									</label>
									<label class="flex items-center gap-2 text-xs text-foreground">
										if hasEvent(wh.Events, "issues") {
											<input type="checkbox" name="issues" value="1" checked class="rounded border-input accent-foreground"/>
										} else {
											<input type="checkbox" name="issues" value="1" class="rounded border-input accent-foreground"/>
										}
										issues
									</label>
									<label class="flex items-center gap-2 text-xs text-foreground">
										if hasEvent(wh.Events, "pull_request") {
											<input type="checkbox" name="pull_request" value="1" checked class="rounded border-input accent-foreground"/>
										} else {
											<input type="checkbox" name="pull_request" value="1" class="rounded border-input accent-foreground"/>
										}
										pull_request
									</label>
									@components.Button(components.ButtonDefault, components.ButtonSizeSM, templ.Attributes{"type": "submit", "class": "mt-2"}) {
										Save
									}
								</form>
							</div>
							if wh.Active {
								<p class="text-xs mt-1 text-success">Active</p>
							} else {
								<p class="text-xs mt-1 text-muted-foreground">Inactive</p>
							}
						</div>
						if data.CanManage {
							<div class="flex gap-2 ml-4 shrink-0">
								@components.Button(components.ButtonGhost, components.ButtonSizeSM, templ.Attributes{
									"hx-get":    "/api/repos/" + data.Owner + "/" + data.RepoName + "/hooks/" + strconv.FormatInt(wh.ID, 10) + "/deliveries",
									"hx-target": "#webhook-deliveries-" + strconv.FormatInt(wh.ID, 10),
									"hx-swap":   "outerHTML",
									"type":      "button",
								}) {
									Deliveries
								}
								@components.Button(components.ButtonDestructiveOutline, components.ButtonSizeSM, templ.Attributes{
									"hx-delete":           "/api/repos/" + data.Owner + "/" + data.RepoName + "/hooks/" + strconv.FormatInt(wh.ID, 10),
									"hx-target":           "#webhooks-list",
									"hx-swap":             "outerHTML",
									"hx-confirm":          data.RepoName + " will stop sending events to " + wh.URL + ".",
									"data-confirm-title":  "Remove this webhook?",
									"data-confirm-label":  "Remove",
									"data-confirm-danger": "true",
									"data-toast":          "Webhook removed",
									"type":                "button",
								}) {
									Remove
								}
							</div>
						}
					</div>
					<div id={ "webhook-deliveries-" + strconv.FormatInt(wh.ID, 10) }></div>
				</div>
			}
		} else {
			<p class="text-sm text-muted-foreground">No webhooks configured.</p>
		}
	</div>
}
