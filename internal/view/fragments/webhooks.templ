package fragments

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
)

script toggleEventsForm(id string) {
	document.getElementById(id).classList.toggle('hidden');
}

templ WebhooksList(data view.WebhooksFragData) {
	<div id="webhooks-list" class="space-y-4">
		if len(data.Webhooks) > 0 {
			for _, wh := range data.Webhooks {
				<div>
					<div class="border border-border rounded-lg p-4 flex justify-between items-start">
						<div class="min-w-0 flex-1">
							<p class="font-medium text-sm font-mono break-all">{ wh.URL }</p>
							<p class="text-xs text-muted-foreground mt-1">
								Events:
								<button
									type="button"
									onclick={ toggleEventsForm("events-form-" + strconv.FormatInt(wh.ID, 10)) }
									class="text-foreground hover:underline ml-1"
								>
									{ wh.Events } (edit)
								</button>
							</p>
							<div id={ "events-form-" + strconv.FormatInt(wh.ID, 10) } class="hidden mt-2">
								<form
									hx-patch={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/hooks/" + strconv.FormatInt(wh.ID, 10) }
									hx-target="#webhooks-list"
									hx-swap="outerHTML"
									class="space-y-1"
								>
									<label class="flex items-center gap-2 text-xs">
										if hasEvent(wh.Events, "push") {
											<input type="checkbox" name="push" value="1" checked/>
										} else {
											<input type="checkbox" name="push" value="1"/>
										}
										push
									</label>
									<label class="flex items-center gap-2 text-xs">
										if hasEvent(wh.Events, "issues") {
											<input type="checkbox" name="issues" value="1" checked/>
										} else {
											<input type="checkbox" name="issues" value="1"/>
										}
										issues
									</label>
									<label class="flex items-center gap-2 text-xs">
										if hasEvent(wh.Events, "pull_request") {
											<input type="checkbox" name="pull_request" value="1" checked/>
										} else {
											<input type="checkbox" name="pull_request" value="1"/>
										}
										pull_request
									</label>
									<button type="submit" class="mt-2 px-2 py-1 bg-primary text-background rounded text-xs">Save</button>
								</form>
							</div>
							if wh.Active {
								<p class="text-xs mt-1 text-success">Active</p>
							} else {
								<p class="text-xs mt-1 text-muted-foreground">Inactive</p>
							}
						</div>
						if data.CanManage {
							<div class="flex gap-2 ml-4 shrink-0">
								<button
									hx-get={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/hooks/" + strconv.FormatInt(wh.ID, 10) + "/deliveries" }
									hx-target={ "#webhook-deliveries-" + strconv.FormatInt(wh.ID, 10) }
									hx-swap="outerHTML"
									class="text-xs text-foreground hover:underline"
								>
									Deliveries
								</button>
								<button
									hx-delete={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/hooks/" + strconv.FormatInt(wh.ID, 10) }
									hx-target="#webhooks-list"
									hx-swap="outerHTML"
									hx-confirm="Delete this webhook?"
									class="text-xs text-destructive hover:underline"
								>
									Delete
								</button>
							</div>
						}
					</div>
					<div id={ "webhook-deliveries-" + strconv.FormatInt(wh.ID, 10) }></div>
				</div>
			}
		} else {
			<p class="text-muted-foreground text-sm">No webhooks configured.</p>
		}
	</div>
}
