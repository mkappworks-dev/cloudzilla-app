package fragments

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
)

templ WatchButton(data view.WatchButtonData) {
	<div id="watch-button" class="flex border border-border rounded-md overflow-hidden">
		if data.LoggedIn {
			if data.Level != "" {
				<button
					hx-delete={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/watch" }
					hx-target="#watch-button"
					hx-swap="outerHTML"
					type="button"
					aria-pressed="true"
					class="h-8 px-3 text-[13px] inline-flex items-center gap-1.5 bg-accent text-foreground hover:bg-accent/70"
				>
					<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
					Watching
				</button>
			} else {
				<button
					hx-put={ "/api/repos/" + data.Owner + "/" + data.RepoName + "/watch" }
					hx-vals={ `{"level":"watching"}` }
					hx-target="#watch-button"
					hx-swap="outerHTML"
					type="button"
					aria-pressed="false"
					class="h-8 px-3 text-[13px] inline-flex items-center gap-1.5 hover:bg-accent"
				>
					<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
					Watch
				</button>
			}
		} else {
			<a href="/login" class="h-8 px-3 text-[13px] inline-flex items-center gap-1.5 hover:bg-accent">
				<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
				Watch
			</a>
		}
		<span class="h-8 inline-flex items-center px-3 text-[13px] font-mono border-l border-border text-muted-foreground">{ strconv.Itoa(data.Count) }</span>
	</div>
}
