package fragments

import (
	"strconv"

	"github.com/mkappworks-dev/cloudzilla-app/internal/view/components"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view"
	"github.com/mkappworks-dev/cloudzilla-app/internal/view/timefmt"
)

templ IssueDetail(data view.IssueDetailFragData) {
	<div id="issue-detail" class="bg-background border border-border rounded-lg p-6">
		<div class="flex justify-between items-start mb-4">
			<div>
				<h1 class="text-3xl font-bold">{ data.Issue.Title }</h1>
				<p class="text-muted-foreground text-sm mt-2">#{ strconv.Itoa(data.Issue.Number) } opened by { data.Issue.AuthorName } on { timefmt.Date(data.Issue.CreatedAt) }</p>
			</div>
			<span class={ "px-3 py-1 rounded-full text-sm font-medium", templ.KV("bg-success/10 text-success", data.Issue.State == "open"), templ.KV("bg-destructive/10 text-destructive", data.Issue.State != "open") }>
				{ string(data.Issue.State) }
			</span>
		</div>
		@components.MarkdownBody(data.BodyHTML)
		if data.Issue.State == "open" {
			<button
				hx-patch={ "/api/repos/" + data.Owner + "/" + data.Repo + "/issues/" + strconv.Itoa(data.Issue.Number) }
				hx-vals={ `{"state":"closed"}` }
				hx-target="#issue-detail"
				hx-swap="outerHTML"
				class="px-4 py-2 bg-destructive-fill text-destructive-fill-foreground rounded-sm font-medium hover:bg-destructive-fill/90 transition-colors"
			>
				Close issue
			</button>
		} else {
			<button
				hx-patch={ "/api/repos/" + data.Owner + "/" + data.Repo + "/issues/" + strconv.Itoa(data.Issue.Number) }
				hx-vals={ `{"state":"open"}` }
				hx-target="#issue-detail"
				hx-swap="outerHTML"
				class="px-4 py-2 bg-success-fill text-success-fill-foreground rounded-sm font-medium hover:bg-success-fill/90 transition-colors"
			>
				Re-open Issue
			</button>
		}
	</div>
}
